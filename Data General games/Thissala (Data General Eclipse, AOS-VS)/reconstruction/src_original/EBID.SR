	;SPECIAL PROGRAM FLOW CONTROL INSTRUCTIONS

.DUSR	NOP=	MOVZ#	0,0,SNC		;NO-OP
;THIS IS DEFINED AS A MACRO SO "Q" ERRORS WILL SHOW
.MACRO	SKIP
**	MOVZ#	0,0,SZC			;SKIP ALWAYS
%

	;UNSIGNED INTEGER COMPARISONS

.DISS	USEQ=	SUBZ#	0,0,SZR		;SKIP IF ACS =  ACD
.DISS	USNE=	SUBZ#	0,0,SNR		;SKIP IF ACS <> ACD
.DISS	USLE=	SUBZ# 	0,0,SNC		;SKIP IF ACS <= ACD
.DISS	USGT=	SUBZ#	0,0,SZC		;SKIP IF ACS >  ACD
.DISS	USLT=	SUBZ#	0,0,SBN		;SKIP IF ACS <  ACD
.DISS 	USGE=	SUBZ#	0,0,SEZ		;SKIP IF ACS >= ACD


	;SIGNED INTEGER COMPARISONS TO ZERO

	;NOTE: NEGL# IS NOT USED FOR SGTZ AND SLEZ AS IT FAILS FOR 100000.

.MACRO	SEQZ
**		MOV#	^1,^1,SZR	;SKIP IF AC =  0
%
.MACRO	SNEZ
**		MOV#	^1,^1,SNR	;SKIP IF AC <> 0
%
.MACRO	SLEZ
**		ADDO#	^1,^1,SEZ	;SKIP IF AC <= 0
%
.MACRO	SGTZ
**		ADDO#	^1,^1,SBN	;SKIP IF AC >  0
%
.MACRO	SLTZ
**		MOVL#	^1,^1,SNC	;SKIP IF AC <  0
%
.MACRO	SGEZ
**		MOVL#	^1,^1,SZC	;SKIP IF AC >= 0
%

	;SPECIAL UNSIGNED INTEGER COMPARISONS

.MACRO	USLE1
**		MOVZR#	^1,^1,SZR	;SKIP IF AC = 0 OR 1
%

.MACRO	USGT1
**		MOVZR#	^1,^1,SNR	;SKIP IF AC > 1
%
