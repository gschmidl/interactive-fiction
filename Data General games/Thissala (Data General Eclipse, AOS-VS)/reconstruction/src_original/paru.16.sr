.DUSR   ?ZRTZ   = 471           ;  RESTART Function
.DUSR   ?ZRTX   = (?ZRT*400)+0  ;  Low pkt id
.DUSR   ?ZTRZ   = 471           ;  TRAILERS Function
.DUSR   ?ZTRX   = (?ZTR*400)+0  ;  Low pkt id
.DUSR   ?ZSPZ   = 471           ;  SPOOLSTATUS Function
.DUSR   ?ZSPX   = (?ZSP*400)+0  ;  Low pkt id
.DUSR   ?ZS1Z   = 471           ;  SPOOLSTATUS Function, rev 1
.DUSR   ?ZS1X   = (?ZSP*400)+1  ;  Low pkt id, rev 1
.DUSR   ?ZSKZ   = 471           ;  STACK Function
.DUSR   ?ZSKX   = (?ZSK*400)+0  ;  Low pkt id
.DUSR   ?ZBLZ   = 471           ;  BATCH_LIST Function
.DUSR   ?ZBLX   = (?ZBL*400)+0  ;  Low pkt id
.DUSR   ?ZBOZ   = 471           ;  BATCH_OUTPUT Function
.DUSR   ?ZBOX   = (?ZBO*400)+0  ;  Low pkt id
.DUSR   ?ZBRZ   = 471           ;  BRIEF Function
.DUSR   ?ZBRX   = (?ZBR*400)+0  ;  Low pkt id
.DUSR   ?ZCAZ   = 471           ;  CANCEL Function
.DUSR   ?ZCAX   = (?ZCA*400)+0  ;  Low pkt id
.DUSR   ?ZCOZ   = 471           ;  CONTINUE Function
.DUSR   ?ZCOX   = (?ZCO*400)+0  ;  Low pkt id
.DUSR   ?ZCRZ   = 471           ;  CREATE Function
.DUSR   ?ZCRX   = (?ZCR*400)+0  ;  Low pkt id
.DUSR   ?ZFLZ   = 471           ;  FLUSH Function
.DUSR   ?ZFLX   = (?ZFL*400)+0  ;  Low pkt id
.DUSR   ?ZHOZ   = 471           ;  HOLD Function
.DUSR   ?ZHOX   = (?ZHO*400)+0  ;  Low pkt id
.DUSR   ?ZLIZ   = 471           ;  LIMIT Function
.DUSR   ?ZLIX   = (?ZLI*400)+0  ;  Low pkt id
.DUSR   ?ZPAZ   = 471           ;  PAUSE Function
.DUSR   ?ZPAX   = (?ZPA*400)+0  ;  Low pkt id
.DUSR   ?ZPIZ   = 471           ;  PRIORITY Function
.DUSR   ?ZPIX   = (?ZPI*400)+0  ;  Low pkt id
.DUSR   ?ZQPZ   = 471           ;  QPRIORITY Function
.DUSR   ?ZQP1   = (?ZQP*400)+0  ;  Low pkt id
.DUSR   ?ZSIZ   = 471           ;  SILENCE Function
.DUSR   ?ZSIX   = (?ZSI*400)+0  ;  Low pkt id
.DUSR   ?ZSRZ   = 471           ;  START Function
.DUSR   ?ZSR1   = (?ZSR*400)+0  ;  Low pkt id
.DUSR   ?ZQSS   = 471           ;  STATUS Function
.DUSR   ?ZQSX   = (?ZSS*400)+0  ;  Low pkt id
.DUSR   ?ZSTZ   = 471           ;  STOP Function
.DUSR   ?ZSTX   = (?ZST*400)+0  ;  Low pkt id
.DUSR   ?ZUHZ   = 471           ;  UNHOLD Function
.DUSR   ?ZUHX   = (?ZUH*400)+0  ;  Low pkt id
.DUSR   ?ZULZ   = 471           ;  UNLIMIT Function
.DUSR   ?ZULX   = (?ZUL*400)+0  ;  Low pkt id
.DUSR   ?ZUNZ   = 471           ;  UNSILENCE Function
.DUSR   ?ZUNX   = (?ZUN*400)+0  ;  Low pkt id
.DUSR   ?ZVEZ   = 471           ;  VERBOSE Function
.DUSR   ?ZVEX   = (?ZVE*400)+0  ;  Low pkt id
.DUSR   ?ZXBZ   = 471           ;  XBIAS Function
.DUSR   ?ZXBX   = (?ZXB*400)+0  ;  Low pkt id
.DUSR   ?ZDSZ   = 471           ;  DISMOUNTED Function
.DUSR   ?ZDSX   = (?ZDS*400)+0  ;  Low pkt id
.DUSR   ?ZMOZ   = 471           ;  MOUNTED Function
.DUSR   ?ZMOX   = (?ZMO*400)+0  ;  Low pkt id
.DUSR   ?ZMSQ   = 471           ;  MOUNTSTATUS Function
.DUSR   ?ZMSB   = (?ZMS*400)+0  ;  Low pkt id
.DUSR   ?ZOPZ   = 471           ;  OPERATOR Function
.DUSR   ?ZOPX   = (?ZOP*400)+0  ;  Low pkt id
.DUSR   ?ZPEZ   = 471           ;  PREMOUNT Function
.DUSR   ?ZPEX   = (?ZPE*400)+0  ;  Low pkt id
.DUSR   ?ZRFZ   = 471           ;  REFUSED Function
.DUSR   ?ZRFX   = (?ZRF*400)+0  ;  Low pkt id
.DUSR   ?ZREZ   = 471           ;  RELEASE Function
.DUSR   ?ZREX   = (?ZRE*400)+0  ;  Low pkt id
.DUSR   ?ZUSZ   = 471           ;  UNITSTATUS Function
.DUSR   ?ZUSX   = (?ZUS*400)+0  ;  Low pkt id
.DUSR   ?ZHAZ   = 471           ;  HALT Function
.DUSR   ?ZHAX   = (?ZHA*400)+0  ;  Low pkt id
.DUSR   ?ZLOZ   = 471           ;  LOGGING Function
.DUSR   ?ZLOX   = (?ZLO*400)+0  ;  Low pkt id
.DUSR   ?ZPRZ   = 471           ;  PROMPTS Function
.DUSR   ?ZPRX   = (?ZPR*400)+0  ;  Low pkt id
.DUSR   ?ZACZ   = 471           ;  ACCESS Function
.DUSR   ?ZACX   = (?ZAC*400)+0  ;  Low pkt id
.DUSR   ?ZAKZ   = 471           ;  AUTOKEY Function
.DUSR   ?ZAKX   = (?ZAK*400)+0  ;  LOW PKT ID
.DUSR   ?ZRGZ   = 471           ;  REGISTER Function
.DUSR   ?ZRGX   = (?ZRG*400)+0  ;  LOW PKT ID
.DUSR   ?ZRSZ   = 471           ;  REGISTERSTATUS Function
.DUSR   ?ZRSX   = (?ZRS*400)+0  ;  LOW PKT ID



;-----------------------------------------------------------------------
;                       ?OPEX Subpacket Definitions
;-----------------------------------------------------------------------

;-----------------------------------------------------------------------
;             ?OPEX,  Consolestatus,  function code = ?ZCS
;-----------------------------------------------------------------------

.DUSR   ?ZCSI   = 0             ; Subpacket Id, high
.DUSR   ?ZCS2   = ?ZCSI+1       ; Subpacket Id, low
.DUSR   ?ZCSF   = ?ZCS2+1       ; Flags
.DUSR   ?ZCSR   = ?ZCSF+1       ; Reserved
.DUSR   ?ZCSK   = ?ZCSR+1       ; Next key, high, word 1
.DUSR   ?ZCS1   = ?ZCSK+1       ; Next key, low, word 1
.DUSR   ?ZCS3   = ?ZCS1+1       ; Next key, high, word 2
.DUSR   ?ZCS4   = ?ZCS3+1       ; Next key, low, word 2
.DUSR   ?ZCSU   = ?ZCS4+1       ; B( Username )
.DUSR   ?ZCSA   = ?ZCSU+2       ; Username buf size
.DUSR   ?ZCSB   = ?ZCSA+1       ; Username ret str len
.DUSR   ?ZCSN   = ?ZCSB+1       ; Number of tries
.DUSR   ?ZCSP   = ?ZCSN+1       ; PID

.DUSR   ?ZCSL   = ?ZCSP+1       ; Length of Consolestatus subpkt

;-----------------------------------------------------------------------
;    Bit and Bit Mask definitions, ?ZCSF flags word, Consolestatus
;-----------------------------------------------------------------------

.DUSR   ?ZZB0   =  0.          ; (input bit)
.DUSR   ?ZYB0   =  1B(?ZZB0)   ; Bit mask
;  This is the default. User wants status on all consoles.

.DUSR   ?ZZB1   =  1.         ; (output bit)
.DUSR   ?ZYB1   =  1B(?ZZB1)  ; Bit mask
;  Console is enabled.

.DUSR   ?ZZB2   =  2.          ; (output bit)
.DUSR   ?ZYB2   =  1B(?ZZB2)   ; Bit mask
;   Continue.

.DUSR   ?ZZB3   =  3.          ; (output bit)
.DUSR   ?ZYB3   =  1B(?ZZB3)   ; Bit mask
;   Stop.

.DUSR   ?ZZB4   =  4.          ; (output bit)
.DUSR   ?ZJB4   =  1B(?ZZB4)   ; Bit mask
;   Console is logged on.

.DUSR   ?ZZB5   =  5.          ; (output bit)
.DUSR   ?ZYB5   =  1B(?ZZB5)  ; Bit mask
;   Console will be disabled.

.DUSR   ?ZZB6   =  6.          ; (output bit)
.DUSR   ?ZYB6   =  1B(?ZZB6)   ; Bit mask
;   Log on/off is in progress.

.DUSR   ?ZZB7   =  7.          ; (output bit)
.DUSR   ?ZYB7   =  1B(?ZZB7)   ; Bit mask
;   Console is in server died state.

.DUSR   ?ZZB8   =  8.          ; (output bit)
.DUSR   ?ZYB8   =  1B(?ZZB8)   ; Bit mask
;   Console is in error state.

.DUSR   ?ZZB9   =  9.          ; (output bit)
.DUSR   ?ZYB9   =  1B(?ZZB9)   ; Bit mask
;   Console is not logged on.

;-----------------------------------------------------------------------
;             ?OPEX,  Disable,  function code = ?ZDI
;-----------------------------------------------------------------------

.DUSR   ?ZDII   = 0             ; Subpkt Id, high
.DUSR   ?ZDI2   = ?ZDII+1       ; Subpkt Id, low
.DUSR   ?ZDIF   = ?ZDI2+1       ; Flags
.DUSR   ?ZDIN   = ?ZDIF+1       ; Number of consoles

.DUSR   ?ZDIL   = ?ZDIN+1       ; Disable subpkt length

;-----------------------------------------------------------------------
;    Bit and bit mask definitions for ?ZDIF word in Disble function
;-----------------------------------------------------------------------

.DUSR   ?ZZC0   =  0.           ; (input bit)
.DUSR   ?ZYC0   =  1B(?ZZC0)
;   This is the default. User wants to disable all consoles.


.DUSR   ?ZZC1   =  1.           ; (output bit)
.DUSR   ?ZYC1   =  1B(?ZZC1)
;   Console will be disabled.

.DUSR   ?ZZC2   =  2.           ; (output bit)
.DUSR   ?ZYC2   =  1B(?ZZC2)
;   All consoles will be disabled.

;-----------------------------------------------------------------------
;             ?OPEX,  Enable,  function code = ?ZEN
;-----------------------------------------------------------------------

.DUSR   ?ZENI   = 0                     ; Subpkt Id, high
.DUSR   ?ZEN2   = ?ZENI+1               ; Subpkt Id, low
.DUSR   ?ZENF   = ?ZEN2+1               ; Flags
.DUSR   ?ZENT   = ?ZENF+1               ; Number of tries
.DUSR   ?ZENK   = ?ZENT+1               ; Next key, high, word 1
.DUSR   ?ZEN1   = ?ZENK+1               ; Next key, low, word 1
.DUSR   ?ZEN3   = ?ZEN1+1               ; Next key, high, word 2
.DUSR   ?ZEN4   = ?ZEN3+1               ; Next key, low, word 2
.DUSR   ?ZENC   = ?ZEN4+1               ; Number of consoles
.DUSR   ?ZENR   = ?ZENC+1               ; Reserved

.DUSR  ?ZENL   = ?ZENR+1               ; Enable subpkt length

;-----------------------------------------------------------------------
;      Bit abd Bit mask definitions for ?ZENF, enable flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZD0   =  0.          ; (input bit)
.DUSR   ?ZYD0   =  1B(?ZZD0)
;   This is the default. User wants to enable all consoles.

.DUSR   ?ZZD1   =  1.          ; (input bit)
.DUSR   ?ZYD1   =  1B(?ZZD1)
;   Tries switch.

.DUSR   ?ZZD2   =  2.          ; (input bit)
.DUSR   ?ZYD2   =  1B(?ZZD2)
;   Stop switch.

.DUSR   ?ZZD3   =  3.           ; (input bit)
.DUSR   ?ZYD3   =  1B(?ZZD3)
;   Continue switch.

.DUSR   ?ZZD4   =  4.          ; (input bit)
.DUSR   ?ZYD4   =  1B(?ZZD4)
;   Force switch.

.DUSR   ?ZZD5   =  5.          ; (output bit)
.DUSR   ?ZYD5   =  1B(?ZZD5)
;   Console already enabled.

.DUSR   ?ZZD6   =  6.          ; (output bit)
.DUSR   ?ZYD6   =  1B(?ZZD6)
;   Cancelling disable, previous values in effect.

.DUSR   ?ZZD7   =  7.          ; (output bit)
.DUSR   ?ZYD7   =  1B(?ZZD7)
;   Cancelling disable, new logon values in effect.

.DUSR   ?ZZD8   =  8.          ; (output bit)
.DUSR   ?ZYD8   =  1B(?ZZD8)
;   New logon values in effect.

.DUSR   ?ZZD9   =  9.          ; (output bit)
.DUSR   ?ZYD9   =  1B(?ZZD9)
;   Console enabled.

.DUSR   ?ZZDA   =  10.         ; (output bit)
.DUSR   ?ZYDA   =  1B(?ZZDA)
;   Could not enable console.

.DUSR   ?ZZDB   =  11.         ; (output bit)
.DUSR   ?ZYDB   =  1B(?ZZDB)
;   Device already in use.

;-----------------------------------------------------------------------
;             ?OPEX,  ALIGN,  function code = ?ZAG
;-----------------------------------------------------------------------

.DUSR   ?ZAGI   = 0             ; Subpkt Id, high
.DUSR   ?ZAG2   = ?ZAGI+1       ; Subpkt Id, low
.DUSR   ?ZAGF   = ?ZAG2+1       ; Flags
.DUSR   ?ZAGN   = ?ZAGF+1       ; # of pages

.DUSR   ?ZAGL   = ?ZAGN+1         ; ALIGN subpkt length

;-----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZAGF word, Align function
;-----------------------------------------------------------------------

.DUSR   ?ZZE0   =  0.         ; (input bit)
.DUSR   ?ZYE0   =  1B(?ZZE0)
;   Continue.

;-----------------------------------------------------------------------
;             ?OPEX,  BINARY,  function code = ?ZBI
;-----------------------------------------------------------------------

.DUSR   ?ZBII   = 0                     ; Subpkt Id, high
.DUSR   ?ZBI2   = ?ZBII+1               ; Subpkt Id, low
.DUSR   ?ZBIF   = ?ZBI2+1               ; Flags
.DUSR   ?ZBIA   = ?ZBIF+1               ; Filename buffer size
.DUSR   ?ZBIB   = ?ZBIA+1               ; B(filename)

.DUSR   ?ZBIL   = ?ZBIB+2               ; Binary subpkt length

;-----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZBIF word, Binary function
;-----------------------------------------------------------------------

.DUSR   ?ZZF0   =  0.           ; (input bit)
.DUSR   ?ZYF0   =  1B(?ZZF0)    ; bit mask
;   if set, bytepointer to filename
;   buffer is passed in the field .DUSR   ?ZBIB.

.DUSR   ?ZZF1   =  1.           ; (input bit)
.DUSR   ?ZYF1   =  1B(?ZZF1)    ; bit mask
;   Binary mode is off.

.DUSR   ?ZJF1   =  0B(?ZZF1)    ; bit mask
;   Binary mode is off.


.DUSR   ?ZZF2   =  2.           ; (output bit)
.DUSR   ?ZYF2   =  1B(?ZZF2)    ; bit mask
;   Binary mode is enabled.

.DUSR   ?ZYJ2   =  0B(?ZZF2)    ; bit mask
;   Binary mode is disabled.

;-----------------------------------------------------------------------
;             ?OPEX,  CPL,  function code = ?ZCP
;-----------------------------------------------------------------------

.DUSR   ?ZCPI   = 0             ; Subpkt Id, high
.DUSR   ?ZCP2   = ?ZCPI+1       ; Subpkt Id, low
.DUSR   ?ZCPN   = ?ZCP2+1       ; # of characters
.DUSR   ?ZCPR   = ?ZCPN+1       ; Reserved

.DUSR   ?ZCPL = ?ZCPR+1         ; CPL subpkt length

;-----------------------------------------------------------------------
;             ?OPEX,  DEFAULTFORMS,  function code = ?ZDF
;-----------------------------------------------------------------------

.DUSR   ?ZDFI   = 0             ; Subpkt Id, high
.DUSR   ?ZDF2   = ?ZDFI+1       ; Subpkt Id, low
.DUSR   ?ZDFF   = ?ZDF2+1       ; Flags
.DUSR   ?ZDFA   = ?ZDFF+1       ; filename buffer size
.DUSR   ?ZDFB   = ?ZDFA+1       ; B(filename)

.DUSR   ?ZDFL = ?ZDFB+2         ; defaultforms subpkt length

;-----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZDFF defaultforms function
;-----------------------------------------------------------------------

.DUSR   ?ZZG0   =  0.           ;(input bit)
.DUSR   ?ZYG0   =  1B(?ZZG0)    ; bit mask
;   if set, bytepointer to filename buffer is passed in the field ?XDFB.
;   If not, the implicit default forms are used.


;-----------------------------------------------------------------------
;             ?OPEX,  ELONGATE,  function code = ?ZEL
;-----------------------------------------------------------------------

.DUSR   ?ZELI   = 0             ; Subpkt Id, high
.DUSR   ?ZEL2   = ?ZELI+1       ; Subpkt Id, low
.DUSR   ?ZELF   = ?ZEL2+1       ; Flags
.DUSR   ?ZELR   = ?ZELF+1       ; Reserved

.DUSR   ?ZELN = ?ZELR+1         ; Elongate subpkt length

;-----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZELF elongate function
;-----------------------------------------------------------------------

.DUSR   ?ZZH0   =  0.           ; (input bit)
.DUSR   ?ZYH0   =  1B(?ZZH0)    ; bit mask
;   Elongate is turned on.

.DUSR   ?ZJH0   =  0B(?ZZH0)    ; bit mask
;    Elongate is turned off.


;-----------------------------------------------------------------------
;             ?OPEX,  EVEN,  function code = ?ZEV
;-----------------------------------------------------------------------

.DUSR   ?ZEVI   = 0                     ; Subpkt Id, high
.DUSR   ?ZEV2   = ?ZEVI+1               ; Subpkt Id, low
.DUSR   ?ZEVF   = ?ZEV2+1               ; Flags
.DUSR   ?ZEVR   = ?ZEVF+1               ; Reserved

.DUSR   ?ZEVL   = ?ZEVR+1               ; Even subpkt length

;-----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZEVF even function
;-----------------------------------------------------------------------

.DUSR   ?ZZI0   =  0.           ; (input bit)
.DUSR   ?ZYI0   =  1B(?ZZI0)    ; bit mask
;   Even is turned on.

.DUSR   ?ZJI0   =  0B(?ZZI0)    ; bit mask
;   Even is turned off.

;-----------------------------------------------------------------------
;             ?OPEX,  FORMS,  function code = ?ZFO
;-----------------------------------------------------------------------

.DUSR   ?ZFOI   = 0                     ; Subpkt Id, high
.DUSR   ?ZFO2   = ?ZFOI+1               ; Subpkt Id, low
.DUSR   ?ZFOF   = ?ZFO2+1               ; Flags
.DUSR   ?ZFOA   = ?ZFOF+1               ; filename buffer size
.DUSR   ?ZFOB   = ?ZFOA+1               ; B(filename)

.DUSR   ?ZFOL   = ?ZFOB+2               ; Forms subpkt length

;-----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZFOF forms function
;-----------------------------------------------------------------------

.DUSR   ?ZZJ0   =  0.           ; (input bit)
.DUSR   ?ZYJ0   =  1B(?ZZJ0)    ; bit mask
;   if set, bytepointer to filename buffer is passed in the field
;   ?ZFOB. If not set, the implicit default forms are used.


;-----------------------------------------------------------------------
;             ?OPEX,  HEADERS,  function code = ?ZHE
;-----------------------------------------------------------------------

.DUSR   ?ZHEI   = 0                     ; Subpkt Id, high
.DUSR   ?ZHE2   = ?ZHEI+1               ; Subpkt Id, low
.DUSR   ?ZHEH   = ?ZHE2+1               ; # of sheets
.DUSR   ?ZHER   = ?ZHEH+1               ; Reserved

.DUSR   ?ZHEL   = ?ZHER+1               ; Headers subpkt length

;-----------------------------------------------------------------------
;             ?OPEX,  LPP,  function code = ?ZLP
;-----------------------------------------------------------------------

.DUSR   ?ZLPI   = 0                     ; Subpkt Id, high
.DUSR   ?ZLP2   = ?ZLPI+1               ; Subpkt Id, low
.DUSR   ?ZLPN   = ?ZLP2+1               ; # of lines
.DUSR   ?ZLPR   = ?ZLPN+1               ; Reserved

.DUSR   ?ZLPL   = ?ZLPR+1               ; LPP subpkt length

;-----------------------------------------------------------------------
;             ?OPEX, MAPPER, function code = ?ZMP
;-----------------------------------------------------------------------


.DUSR ?ZMPI=    0                       ; subpacket identifier
.DUSR ?ZMP2=    ?ZMPI+1                 ; subpacket identifier (low)
.DUSR ?ZMPF=    ?ZMP2+1                 ; flags
.DUSR ?ZMPA=    ?ZMPF+1                 ; file name buffer size
.DUSR ?ZMPB=    ?ZMPA+1                 ; byte address of file name

.DUSR ?ZMPL=    ?ZMPB+2                 ; mapper subpacket length

; Bit and bit mask definitions

.DUSR   ?ZZMF   =  0.                    ; (input bit)
.DUSR   ?ZYMF   =  1B(?ZZMF)             ; bit mask
; If set, bytepointer to filename buffer is passed in the field ?ZMPB.


;-----------------------------------------------------------------------
;             ?OPEX,  RESTART,  function code = ?ZRT
;-----------------------------------------------------------------------

.DUSR   ?ZRTI   = 0                     ; Subpkt Id, high
.DUSR   ?ZRT2   = ?ZRTI+1               ; Subpkt Id. low
.DUSR   ?ZRTA   = ?ZRT2+1               ; Argument 1
.DUSR   ?ZRTB   = ?ZRTA+1               ; Argument 2

.DUSR   ?ZRTL   = ?ZRTB+1               ; Restart subpkt length

