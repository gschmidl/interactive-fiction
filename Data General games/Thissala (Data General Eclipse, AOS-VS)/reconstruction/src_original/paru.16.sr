.DUSR   ?ZXIZ   = 471           ;  ?OPEX main packet
.DUSR   ?ZXIX   = (0*400)+0     ;  Low pkt id
.DUSR   ?ZCSZ   = 471           ;  CONSOLESTATUS Function
.DUSR   ?ZCSX   = (?ZCS*400)+0  ;  Low pkt id
.DUSR   ?ZDIZ   = 471           ;  DISABLE Function
.DUSR   ?ZDIX   = (?ZDI*400)+0  ;  Low pkt id
.DUSR   ?ZENZ   = 471           ;  ENABLE Function
.DUSR   ?ZENX   = (?ZEN*400)+0  ;  Low pkt id
.DUSR   ?ZAGZ   = 471           ;  ALIGN Function
.DUSR   ?ZAGX   = (?ZAG*400)+0  ;  Low pkt id
.DUSR   ?ZBIZ   = 471           ;  BINARY Function
