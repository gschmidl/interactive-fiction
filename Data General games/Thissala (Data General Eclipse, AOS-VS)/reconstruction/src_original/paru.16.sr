.DUSR   ?ZSRL   = ?ZSRR+1               ; Start subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Start function, ?ZSRF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZU0   =  0.           ; (input bit)
.DUSR   ?ZYU0   =  1B(?ZZU0)    ; bit mask
;   New line switch.

.DUSR   ?ZZU1   =  1.           ; (input bit)
.DUSR   ?ZYU1   =  1B(?ZZU1)    ; bit mask
;   8 bit switch.

.DUSR   ?ZZU2   =  2.           ; (input bit)
.DUSR   ?ZYU2   =  1B(?ZZU2)    ; bit mask
;   Proc switch.

.DUSR   ?ZZU3   =  3.           ; (input bit)
.DUSR   ?ZYU3   =  1B(?ZZU3)    ; bit mask
;   Streams switch.

.DUSR   ?ZZU4   =  4.           ; (input bit)
.DUSR   ?ZYU4   =  1B(?ZZU4)    ; bit mask
;   name switch.

.DUSR   ?ZZU5   =  5.           ; (input bit)
.DUSR   ?ZYU5   =  1B(?ZZU5)    ; bit mask
;   Upper argument specified.

.DUSR   ?ZZU6   =  6.           ; (input bit)
.DUSR   ?ZYU6   =  1B(?ZZU6)    ; bit mask
;   Reserved switch.

.DUSR   ?ZZU7   =  7.           ; (input bit)
.DUSR   ?ZYU7   =  1B(?ZZU7)    ; bit mask
;   IPC switch.

.DUSR   ?ZZU8   =  8.           ; (input bit)
.DUSR   ?ZYU8   =  1B(?ZZU8)    ; bit mask
;   7-bit mode is enabled.

;-----------------------------------------------------------------------
;             ?OPEX,  STATUS,  function code = ?ZSS
;-----------------------------------------------------------------------

.DUSR   ?ZSSI   = 0                     ; Subpkt Id, high
.DUSR   ?ZSS2   = ?ZSSI+1               ; Subpkt Id, low
.DUSR   ?ZSSF   = ?ZSS2+1               ; Flags
.DUSR   ?ZSSR   = ?ZSSF+1               ; Reserved
.DUSR   ?ZSSS   = ?ZSSR+1               ; # of streams
.DUSR   ?ZSSB   = ?ZSSS+1               ; Bias factor
.DUSR   ?ZSSO   = ?ZSSB+1               ; Queue priority
.DUSR   ?ZSSN   = ?ZSSO+1               ; sequence #
.DUSR   ?ZSSK   = ?ZSSN+1               ; Get next key, high, word 1
.DUSR   ?ZSS1   = ?ZSSK+1               ; Get next key, low, word 1
.DUSR   ?ZSX0   = ?ZSS1+1               ; Next key, high, word 2
.DUSR   ?ZSX1   = ?ZSX0+1               ; Next key, low, word 2
.DUSR   ?ZSSV   = ?ZSX1+1               ; CPU limit value
.DUSR   ?ZSSE   = ?ZSSV+1               ; User CPU limit
.DUSR   ?ZSSG   = ?ZSSE+1               ; current page
.DUSR   ?ZSSY   = ?ZSSG+1               ; # of copies left
.DUSR   ?ZSSX   = ?ZSSY+1               ; Priority
.DUSR   ?ZSSD   = ?ZSSX+1               ; PID number
.DUSR   ?ZSSU   = ?ZSSD+1               ; B(Username)
.DUSR   ?ZSS5   = ?ZSSU+2               ; Username buf size
.DUSR   ?ZSS6   = ?ZSS5+1               ; Username string length
.DUSR   ?ZSSP   = ?ZSS6+1               ; B(pathname)
.DUSR   ?ZSS7   = ?ZSSP+2               ; pathname buf size
.DUSR   ?ZSS8   = ?ZSS7+1               ; pathname string length
.DUSR   ?ZSSC   = ?ZSS8+1               ; B(cleanup filename)
.DUSR   ?ZSS9   = ?ZSSC+2               ; cleanup buf size
.DUSR   ?ZSS0   = ?ZSS9+1               ; claenup string length
.DUSR   ?ZSST   = ?ZSS0+1               ; B(font filename)
.DUSR   ?ZSSA   = ?ZSST+2               ; Font filename buf size
.DUSR   ?ZSSH   = ?ZSSA+1               ; Font filename string length
.DUSR   ?ZSSM   = ?ZSSH+1               ; B(mapper filename)
.DUSR   ?ZSSJ   = ?ZSSM+2               ; Mapper buf size
.DUSR   ?ZSSZ   = ?ZSSJ+1               ; Mapper string length

.DUSR   ?ZSSL   = ?ZSSZ+1               ; Status subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Status function, ?ZSSF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZV0   =  0.           ; (input bit)
.DUSR   ?ZYV0   =  1B(?ZZV0)    ; bit mask
;   Want status on all default batch input streams.

.DUSR   ?ZZV1   =  1.           ; (output bit)
.DUSR   ?ZYV1   =  1B(?ZZV1)    ; bit mask
;   Stream/device is active.
.DUSR   ?ZJV1   =  0B(?ZZV1)    ; bit mask
;   Stream/device is idle.

.DUSR   ?ZZV2   =  2.           ; (output bit)
.DUSR   ?ZYV2   =  1B(?ZZV2)    ; bit mask
;   Process type is swappable.

.DUSR   ?ZZV3   =  3.           ; (output bit)
.DUSR   ?ZYV3   =  1B(?ZZV3)    ; bit mask
;   Process type is preemptable.

.DUSR   ?ZZV4   =  4.           ; (output bit)
.DUSR   ?ZYV4   =  1B(?ZZV4)    ; bit mask
;   Process type is resident.

.DUSR   ?ZZV5   =  5.           ; (output bit)
.DUSR   ?ZYV5   =  1B(?ZZV5)    ; bit mask
;   8-bit print mode.
.DUSR   ?ZJV5   =  0B(?ZZV5)    ; bit mask
;   7-bit print mode.

.DUSR   ?ZZV6   =  6.           ; (output bit)
.DUSR   ?ZYV6   =  1B(?ZZV6)    ; bit mask
;   Stream/device is ready.

.DUSR   ?ZJV6   =  0B(?ZZV6)    ; bit mask
 ;  Stream/device is not ready.

.DUSR   ?ZZV7   =  7.           ; (output bit)
.DUSR   ?ZYV7   =  1B(?ZZV7)    ; bit mask
;   Stream/device is paused. (note: if active bit is also set then
;   stream/device will be paused).

.DUSR   ?ZZV8   =  8.           ; (output bit)
.DUSR   ?ZYV8   =  1B(?ZZV8)    ; bit mask
;   Limiting is enabled.

.DUSR   ?ZZV9   =  9.           ; (output bit)
.DUSR   ?ZYV9   =  1B(?ZZV9)    ; bit mask
;   Device is being aligned.

.DUSR   ?ZZVA   =  10.          ; (output bit)
.DUSR   ?ZYVA   =  1B(?ZZVA)    ; bit mask
;   Batch job.

.DUSR   ?ZZVB   =  11.          ; (output bit)
.DUSR   ?ZYVB   =  1B(?ZZVB)    ; bit mask
;   Print or Plot device.

.DUSR   ?ZZVC   =  12.          ; (output bit)
.DUSR   ?ZYVC   =  1B(?ZZVC)    ; bit mask
;   Net coop.

.DUSR   ?ZZVD   =  13.          ; (output bit)
.DUSR   ?ZYVD   =  1B(?ZZVD)    ; bit mask
;   Net coop is ready.
.DUSR   ?ZJVD   =  0B(?ZZVD)    ; bit mask
;   Net coop is not ready.

.DUSR   ?ZZVE   =  14.          ; (output bit)
.DUSR   ?ZYVE   =  1B(?ZZVE)    ; bit mask
;   Net coop is active.
.DUSR   ?ZJVE   =  0B(?ZZVE)    ; bit mask
;   Net coop is idle.

;-----------------------------------------------------------------------
;             ?OPEX,  STOP,  function code = ?ZST
;-----------------------------------------------------------------------

.DUSR   ?ZSTI   = 0             ; Subpkt Id, high
.DUSR   ?ZST2   = ?ZSTI+1       ; Subpkt Id, low
.DUSR   ?ZSTF   = ?ZST2+1       ; Flags
.DUSR   ?ZSTA   = ?ZSTF+1       ; Queuename buf size
.DUSR   ?ZSTB   = ?ZSTA+1       ; B(queuename)

.DUSR   ?ZSTL   = ?ZSTB+2       ; Stop subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Stop function, ?ZSTF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZW0   =  0.           ; (input bit)
.DUSR   ?ZYW0   =  1B(?ZZW0)    ; Bit mask
;    Queuename specified.

;-----------------------------------------------------------------------
;             ?OPEX,  UNHOLD,  function code = ?ZUH
;-----------------------------------------------------------------------

.DUSR   ?ZUHI   = 0             ; Subpkt Id, high
.DUSR   ?ZUH2   = ?ZUHI+1       ; Subpkt Id, low
.DUSR   ?ZUHS   = ?ZUH2+1       ; Sequence #
.DUSR   ?ZUHR   = ?ZUHS+1       ; Reserved

.DUSR   ?ZUHL   = ?ZUHR+1       ; Unhold subpkt length

;-----------------------------------------------------------------------
;             ?OPEX,  UNLIMIT,  function code = ?ZUL
;-----------------------------------------------------------------------

.DUSR   ?ZULI   = 0             ; Subpkt Id, high
.DUSR   ?ZUL2   = ?ZUHI+1       ; Subpkt Id, low
.DUSR   ?ZULF   = ?ZUH2+1       ; Flags
.DUSR   ?ZULS   = ?ZULF+1       ; Stream #

.DUSR   ?ZULL   = ?ZULS+1       ; Unlimit subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Unlimit function, ?ZULF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZX0   =  0.           ; (input bit)
.DUSR   ?ZYX0   =  1B(?ZZX0)    ; bit mask
;    Unlimit all default batch input streams.

;-----------------------------------------------------------------------
;             ?OPEX,  UNSILENCE,  function code = ?ZUN
;-----------------------------------------------------------------------

.DUSR   ?ZUNI   = 0             ; Subpkt Id, high
.DUSR   ?ZUN2   = ?ZUNI+1       ; Subpkt Id, low
.DUSR   ?ZUNF   = ?ZUN2+1       ; Flags
.DUSR   ?ZUNS   = ?ZUNF+1       ; Stream #

.DUSR   ?ZUNL   = ?ZUNS+1       ; Unsilence subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Unsilence function, ?ZUNF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZY0   =  0.           ; (input bit)
.DUSR   ?ZYY0   =  1B(?ZZY0)    ; bit mask
;   Unsilence all default batch input streams.

;-----------------------------------------------------------------------
;             ?OPEX,  VERBOSE,  function code = ?ZVE
;-----------------------------------------------------------------------

.DUSR   ?ZVEI   = 0             ; Subpkt Id, high
.DUSR   ?ZVE2   = ?ZVEI+1       ; Subpkt Id, low
.DUSR   ?ZVEF   = ?ZVE2+1       ; Flags
.DUSR   ?ZVES   = ?ZVEF+1       ; Stream #

.DUSR   ?ZVEL   = ?ZVES+1       ; Verbose subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Verbose function, ?ZVEF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZZ0   =  0.           ; (input bit)
.DUSR   ?ZYZ0   =  1B(?ZZZ0)    ; bit mask
;   Verbose on all default batch input streams.

;-----------------------------------------------------------------------
;             ?OPEX,  XBIAS,  function code = ?ZXB
;-----------------------------------------------------------------------

.DUSR   ?ZXBI   = 0             ; Subpkt Id, high
.DUSR   ?ZXB2   = ?ZXBI+1       ; Subpkt Id, low
.DUSR   ?ZXBA   = ?ZXB2+1       ; Argument 1
.DUSR   ?ZXBB   = ?ZXBA+1       ; Argument 2

.DUSR   ?ZXBL   = ?ZXBB+1       ; Xbias subpkt length

;-----------------------------------------------------------------------
;             ?OPEX,  DISMOUNTED,  function code = ?ZDS
;-----------------------------------------------------------------------

.DUSR   ?ZDSI   = 0             ; Subpkt Id, high
.DUSR   ?ZDS2   = ?ZDSI+1       ; Subpkt Id, low
.DUSR   ?ZDSF   = ?ZDS2+1       ; Flags
.DUSR   ?ZDSM   = ?ZDSF+1       ; Mount Id

.DUSR   ?ZDSL   = ?ZDSM+1       ; Dismounted subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, DISMOUNTED function, ?ZDSF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ00   =  0.           ; (input bit)
.DUSR   ?ZY00   =  1B(?ZZ00)    ; bit mask
;    Default mount request.

;-----------------------------------------------------------------------
;             ?OPEX,  MOUNTED,  function code = ?ZMO
;-----------------------------------------------------------------------

.DUSR   ?ZMOI = 0               ; Subpkt Id, high
.DUSR   ?ZMO2 = ?ZMOI+1         ; Subpkt Id, low
.DUSR   ?ZMOF = ?ZMO2+1         ; Flags
.DUSR   ?ZMOM = ?ZMOF+1         ; Mount Id
.DUSR   ?ZMOB = ?ZMOM+1         ; B(volid)
.DUSR   ?ZMOA = ?ZMOB+2         ; Volid buf size
.DUSR   ?ZMOR = ?ZMOA+1         ; Reserved

.DUSR   ?ZMOL = ?ZMOR+1         ; Mounted subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Mounted function, ?ZMOF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ10   =  0.           ; (input bit)
.DUSR   ?ZY10   =  1B(?ZZ10)    ; bit mask
;    Default Mount ID

;-----------------------------------------------------------------------
;             ?OPEX,  MOUNTSTATUS,  function code = ?ZMS
;-----------------------------------------------------------------------

.DUSR   ?ZMSI   = 0             ; Subpkt Id, high
.DUSR   ?ZMS2   = ?ZMSI+1       ; Subpkt Id, low
.DUSR   ?ZMSF   = ?ZMS2+1       ; Flags1
.DUSR   ?ZMSG   = ?ZMSF+1       ; Flags2
.DUSR   ?ZMSP   = ?ZMSG+1       ; Requester PID
.DUSR   ?ZMSE   = ?ZMSP+1       ; EXEC son PID
.DUSR   ?ZMSK   = ?ZMSE+1       ; Get next key, high, word 1
.DUSR   ?ZMS1   = ?ZMSK+1       ; Get next key, low, word 1
.DUSR   ?ZMSX   = ?ZMS1+1       ; Get next key, high, word 2
.DUSR   ?ZMSJ   = ?ZMSX+1       ; Get next key, low, word 2
.DUSR   ?ZMSU   = ?ZMSJ+1       ; B(username)
.DUSR   ?ZMS3   = ?ZMSU+2       ; Username buf size
.DUSR   ?ZMS4   = ?ZMS3+1       ; Username string length
.DUSR   ?ZMST   = ?ZMS4+1       ; B(text name buffer)
.DUSR   ?ZMS5   = ?ZMST+2       ; Text name buf size
.DUSR   ?ZMS6   = ?ZMS5+1       ; Text name string length
.DUSR   ?ZMSV   = ?ZMS6+1       ; B(volid)
.DUSR   ?ZMS7   = ?ZMSV+2       ; Volid buf size
.DUSR   ?ZMS8   = ?ZMS7+1       ; Volid string length
.DUSR   ?ZMSD   = ?ZMS8+1       ; B(devicename)
.DUSR   ?ZMS9   = ?ZMSD+2       ; Devicename buf size
.DUSR   ?ZMS0   = ?ZMS9+1       ; Devicename string length
.DUSR   ?ZMSS   = ?ZMS0+1       ; B(volid list)
.DUSR   ?ZMSA   = ?ZMSS+2       ; Volid list buf size
.DUSR   ?ZMSZ   = ?ZMSA+1       ; Volid list string length
.DUSR   ?ZMSM   = ?ZMSZ+1       ; Mount Id
.DUSR   ?ZMSR   = ?ZMSM+1       ; Mount error

.DUSR   ?ZMSL   = ?ZMSR+1       ; Mountstatus subpkt length

;-----------------------------------------------------------------------
;  Bit and Bit mask definitions, Mountstatus function, ?ZMSF flags word 1
;-----------------------------------------------------------------------

.DUSR   ?ZZ20   =  0.           ; (input bit)
.DUSR   ?ZY20   =  1B(?ZZ20)    ; bit mask
;   Want status of all  requests, inactive and active.

.DUSR   ?ZZ21   =  1.           ; (input bit)
.DUSR   ?ZY21   =  1B(?ZZ21)    ; bit mask
;   Want status by mount ID.

.DUSR   ?ZZ22   =  2.           ; (output bit)
.DUSR   ?ZJ22   =  0B(?ZZ22)    ; bit mask
;   Explicit labeled mount request.

.DUSR   ?ZY22   =  1B(?ZZ22)    ; bit mask
;   Implicit labeled mount request.

.DUSR   ?ZZ23   =  3.           ; (output bit)
.DUSR   ?ZY23   =  1B(?ZZ23)    ; bit mask
;   Unit mount request.

.DUSR   ?ZZ24   =  4.           ; (output bit)
.DUSR   ?ZY24   =  1B(?ZZ24)    ; bit mask
;   Waiting to be dismounted.

.DUSR   ?ZZ25   =  5.           ; (output bit)
.DUSR   ?ZY25   =  1B(?ZZ25)    ; bit mask
;   Next volume.

.DUSR   ?ZZ26   =  6.           ; (output bit)
.DUSR   ?ZY26   =  1B(?ZZ26)    ; bit mask
;   Mount error.

.DUSR   ?ZZ27   =  7.           ; (output bit)
.DUSR   ?ZY27   =  1B(?ZZ27)    ; bit mask
;   Specific volume.

.DUSR   ?ZZ28   =  8.           ; (output bit)
.DUSR   ?ZY28   =  1B(?ZZ28)    ; bit mask
;    Extend volid list.

.DUSR   ?ZZ29   =  9.           ; (output bit)
.DUSR   ?ZY29   =  1B(?ZZ29)    ; bit mask
;   Read only.

.DUSR   ?ZZ2A   =  10.          ; (output bit)
.DUSR   ?ZY2A   =  1B(?ZZ2A)    ; bit mask
;   IBM format.

;-----------------------------------------------------------------------
; Bit and Bit mask definitions, Mountstatus function, ?ZMSG flags word 2
;-----------------------------------------------------------------------

.DUSR   ?ZZ2G   = 0.         ; (output bit)
.DUSR   ?ZY2G   =  1B(?ZZ2G) ; bit mask
;   Density is 800 bpi.

.DUSR   ?ZZ2H   = 1.         ; (output bit)
.DUSR   ?ZY2H   =  1B(?ZZ2H) ; bit mask
;   Density is 1600 bpi.

.DUSR   ?ZZ2I   = 2.         ; (output bit)
.DUSR   ?ZY2I   =  1B(?ZZ2I) ; bit mask
;   Density is 6250 bpi.

.DUSR   ?ZZ2J   = 3.           ; (output bit)
.DUSR   ?ZY2J   =  1B(?ZZ2J) ; bit mask
;   Automatic density matching.

;-----------------------------------------------------------------------
;             ?OPEX,  OPERATOR,  function code = ?ZOP
;-----------------------------------------------------------------------

.DUSR   ?ZOPI   = 0             ; Subpkt Id, high
.DUSR   ?ZOP2   = ?ZOPI+1       ; Subpkt Id, low
.DUSR   ?ZOPF   = ?ZOP2+1       ; Flags
.DUSR   ?ZOPR   = ?ZOPF+1       ; Reserved

.DUSR   ?ZOPL   = ?ZOPR+1       ; Operator subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Operator function, ?ZOPF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ30 =  0.             ; (input bit)
.DUSR   ?ZJ30 =  0B(?ZZ30)      ; bit mask
;   There is no operator.

.DUSR   ?ZY30 =  1B(?ZZ30)      ; bit mask
;    There is an operator on duty.

;-----------------------------------------------------------------------
;             ?OPEX,  Premount,  function code = ?ZPE
;-----------------------------------------------------------------------

.DUSR   ?ZPEI = 0               ; Subpkt Id, high
.DUSR   ?ZPE2 = ?ZPEI+1         ; Subpkt Id, low
.DUSR   ?ZPEF = ?ZPE2+1         ; Flags
.DUSR   ?ZPER = ?ZPEF+1         ; Reserved
.DUSR   ?ZPEU = ?ZPER+1         ; B(username)
.DUSR   ?ZPE3 = ?ZPEU+2         ; Username buf size
.DUSR   ?ZPE4 = ?ZPE3+1         ; Volid vuf size
.DUSR   ?ZPEV = ?ZPE4+1         ; B(volid)

.DUSR   ?ZPEL = ?ZPEV+2         ; Premount subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Premount function, ?ZPEF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ40   = 0.            ; (input bit)
.DUSR   ?ZY40   =  1B(?ZZ40)    ; bit mask
;    IBM switch.


;-----------------------------------------------------------------------
;             ?OPEX,  REFUSED,  function code = ?ZRF
;-----------------------------------------------------------------------

.DUSR   ?ZRFI   = 0             ; Subpkt Id, high
.DUSR   ?ZRF2   = ?ZRFI+1       ; Subpkt Id, low
.DUSR   ?ZRFF   = ?ZRF2+1       ; Flags
.DUSR   ?ZRFM   = ?ZRFF+1       ; Mount Id

.DUSR   ?ZRFL   = ?ZRFM+1       ; Refused subpkt length


;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Refused function, ?ZRFF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ50   =  0.           ; (input bit)
.DUSR   ?ZY50   =  1B(?ZZ50)    ; bit mask
;    Default mount request.

;-----------------------------------------------------------------------
;             ?OPEX,  RELEASE,  function code = ?ZRE
;-----------------------------------------------------------------------

.DUSR   ?ZREI   = 0             ; Subpkt Id, high
.DUSR   ?ZRE2   = ?ZREI+1       ; Subpkt Id, low
.DUSR   ?ZREF   = ?ZRE2+1       ; Flags
.DUSR   ?ZRER   = ?ZREF+1       ; Reserved

.DUSR   ?ZREL   = ?ZRER+1       ; Release subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Release function, ?ZREF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ60   =  0.           ; (input bit)
.DUSR   ?ZY60   =  1B(?ZZ60)    ; bit mask
;   All switch.

;-----------------------------------------------------------------------
;             ?OPEX,  UNITSTATUS,  function code = ?ZUS
;-----------------------------------------------------------------------

.DUSR   ?ZUSI = 0               ; Subpkt Id, high
.DUSR   ?ZUS2 = ?ZUSI+1         ; Subpkt Id, low
.DUSR   ?ZUSF = ?ZUS2+1         ; Flags
.DUSR   ?ZUSR = ?ZUSF+1         ; Reserved
.DUSR   ?ZUSK = ?ZUSR+1         ; Get next key, high, word 1
.DUSR   ?ZUS1 = ?ZUSK+1         ; Get next key, low, word 1
.DUSR   ?ZUS7 = ?ZUS1+1         ; Next key, high, word 2
.DUSR   ?ZUS8 = ?ZUS7+1         ; Next key, low, word 2
.DUSR   ?ZUSM = ?ZUS8+1         ; Mount Id
.DUSR   ?ZUSP = ?ZUSM+1         ; PID
.DUSR   ?ZUSU = ?ZUSP+1         ; B(username)
.DUSR   ?ZUS3 = ?ZUSU+2         ; Username buf size
.DUSR   ?ZUS4 = ?ZUS3+1         ; Username string length
.DUSR   ?ZUSV = ?ZUS4+1         ; B(volid)
.DUSR   ?ZUS5 = ?ZUSV+2         ; Volid buf size
.DUSR   ?ZUS6 = ?ZUS5+1         ; Volid string length

.DUSR   ?ZUSL = ?ZUS6+1         ; Unitstatus subpkt length

;-----------------------------------------------------------------------
;  Bit and Bit mask definitions, Unitstatus function, ?ZUSF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ70   =  0.           ; (input bit)
.DUSR   ?ZY70   =  1B(?ZZ70)    ; bit mask
;    All units.

.DUSR   ?ZZ71   =  1.           ; (output bit)
.DUSR   ?ZY71   =  1B(?ZZ71)    ; bit mask
;    Unit not mounted.

.DUSR   ?ZZ72   =  2.           ; (output bit)
.DUSR   ?ZY72   =  1B(?ZZ72)    ; bit mask
;    Unit is premounted.

.DUSR   ?ZZ73   =  3.           ; (output bit)
.DUSR   ?ZY73   =  1B(?ZZ73)    ; bit mask
;    Unit is waiting to be dismounted.

.DUSR   ?ZZ74   =  4.           ; (output bit)
.DUSR   ?ZY74   =  1B(?ZZ74)    ; bit mask
;    Unit is in IBM format.

;-----------------------------------------------------------------------
;             ?OPEX,  HALT,  function code = ?ZBHA
;-----------------------------------------------------------------------

.DUSR   ?ZHAI   = 0             ; Subpkt Id, high
.DUSR   ?ZHA2   = ?ZHAI+1       ; Subpkt Id, low
.DUSR   ?ZHAF   = ?ZHA2+1       ; Flags
.DUSR   ?ZHAR   = ?ZHAF+1       ; Reserved

.DUSR   ?ZHAL   = ?ZHAR+1       ; Halt subpkt length

;-----------------------------------------------------------------------
;             ?OPEX,  LOGGING,  function code = ?ZLO
;-----------------------------------------------------------------------

.DUSR   ?ZLOI   = 0             ; Subpkt Id, high
.DUSR   ?ZLO2   = ?ZLOI+1       ; Subpkt Id, low
.DUSR   ?ZLOF   = ?ZLO2+1       ; Flags
.DUSR   ?ZLOP   = ?ZLOF+1       ; Max # of pages
.DUSR   ?ZLOC   = ?ZLOP+1       ; B(consolename)
.DUSR   ?ZLO3   = ?ZLOC+2       ; Consolename buf size
.DUSR   ?ZLO4   = ?ZLO3+1       ; Consolename string size
.DUSR   ?ZLO5   = ?ZLO4+1       ; Console Error
.DUSR   ?ZLO6   = ?ZLO5+1       ; Logfile Error

.DUSR   ?ZLOL   = ?ZLO6+1       ; Logging subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Logging function, ?ZLOF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ80   =  0.           ; (input bit)
.DUSR   ?ZY80   =  1B(?ZZ80)    ; bit mask
;    Return status. This is the default.

.DUSR   ?ZZ81   =  1.           ; (input bit)
.DUSR   ?ZY81   =  1B(?ZZ81)    ; bit mask
;    Start switch.

.DUSR   ?ZZ82   =  2.           ; (input bit)
.DUSR   ?ZY82   =  1B(?ZZ82)    ; bit mask
;    Max switch.

.DUSR   ?ZZ83   =  3.           ; (input bit)
.DUSR   ?ZY83   =  1B(?ZZ83)    ; bit mask
;    Stop switch.

.DUSR   ?ZZ84   =  4.          ; (input bit)
.DUSR   ?ZY84   =  1B(?ZZ84)   ; bit mask
;    Console switch.

.DUSR   ?ZZ85   =  5.          ;(input Bit)
.DUSR   ?ZY85   =  1B(?ZZ85)   ; bit mask
;    No console switch.

.DUSR   ?ZZ86   =  6.           ; (output bit)
.DUSR   ?ZY86   =  1B(?ZZ86)    ; bit mask
;    Start logging.


.DUSR   ?ZZ87   =  7.           ; (output bit)
.DUSR   ?ZY87   =  1B(?ZZ87)    ; bit mask
;    Stop logging.

;-----------------------------------------------------------------------
;             ?OPEX,  PROMPTS,  function code = ?ZPR
;-----------------------------------------------------------------------

.DUSR   ?ZPRI   = 0             ; Subpkt Id, high
.DUSR   ?ZPR2   = ?ZPRI+1       ; Subpkt Id, low
.DUSR   ?ZPRF   = ?ZPR2+1       ; Flags
.DUSR   ?ZPRR   = ?ZPRF+1       ; Reserved

.DUSR   ?ZPRL   = ?ZPRR+1       ; Prompts subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Prompts function, ?ZPRF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ90   =  0.           ; (input bit)
.DUSR   ?ZJ90   =  0B(?ZZ90)    ; bit mask
;    Prompts off.

.DUSR   ?ZY90   =  1B(?ZZ90)    ; bit mask
;    Prompts on.

;-----------------------------------------------------------------------
;             ?OPEX,  ACCESS,  function code = ?ZAC
;-----------------------------------------------------------------------

.DUSR   ?ZACI   = 0             ; Subpkt Id, high
.DUSR   ?ZAC2   = ?ZACI+1       ; Subpkt Id, low
.DUSR   ?ZACF   = ?ZAC2+1       ; Flags
.DUSR   ?ZACR   = ?ZACF+1       ; Reserved
.DUSR   ?ZACA   = ?ZACR+1       ; B(access list)
.DUSR   ?ZAC3   = ?ZACA+2       ; Access list buf size
.DUSR   ?ZAC4   = ?ZAC3+1       ; Access list string length

.DUSR   ?ZACL   = ?ZAC4+1       ; Access subpkt length

;-----------------------------------------------------------------------
;    Bit and Bit mask definitions, Access function, ?ZACF flags word
;-----------------------------------------------------------------------

.DUSR   ?ZZ9G   =  0.           ; (input bit)
.DUSR   ?ZY9G   =  1B(?ZZ9G)    ; bit mask
;    Default specified.

.DUSR   ?ZZ9H   =  1.           ; (input bit)
.DUSR   ?ZY9H   =  1B(?ZZ9H)    ; bit mask
;    Kill option specified.

.DUSR   ?ZZ9I   =  2.           ; (input bit)
.DUSR   ?ZY9I   =  1B(?ZZ9I)    ; bit mask
;    Op specified  ACL.

;----------------------------------------------------------------------
;             ?OPEX,  AUTOKEY,  function code = ?ZAK
;----------------------------------------------------------------------

.DUSR   ?ZAKI   = 0             ; Subpkt Id, high
.DUSR   ?ZAK2   = ?ZAKI+1       ; Subpkt Id, low
.DUSR   ?ZAKF   = ?ZAK2+1       ; Flags
.DUSR   ?ZAKA   = ?ZAKF+1       ; Argument one
.DUSR   ?ZAKB   = ?ZAKA+1       ; Argument two
.DUSR   ?ZAKR   = ?ZAKB+1       ; Reserved

.DUSR   ?ZAKL   = ?ZAKR+1       ; Autokey subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Autokey function, ?ZAKF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZAF =  0.             ; (input bit)
.DUSR   ?ZYAF =  1B(?ZZAF)      ; bit mask
;     User wants status on current autokey setting.
.DUSR   ?ZJAF =  0B(?ZZAF)      ; bit mask
;    User wants to set the autokey sequence

.DUSR   ?ZZAG =  1.             ; (input bit)
.DUSR   ?ZYAG =  1B(?ZZAG)      ; bit mask
;     User wants a 2 char autokey sequence.
.DUSR   ?ZJAG =  0B(?ZZAG)      ; bit mask
;    User wants a single char autokey sequence.

.DUSR   ?ZZAH =  2.             ; (input bit)
.DUSR   ?ZYAH =  1B(?ZZAH)      ; bit mask
;     Current autokey status is two characters.
.DUSR   ?ZJAH =  0B(?ZZAH)      ; bit mask
;    Current autokey status is single character.

;----------------------------------------------------------------------
;             ?OPEX,  REGISTER,  function code = ?ZRG
;----------------------------------------------------------------------

.DUSR   ?ZRGI   = 0             ; Subpkt Id, high
.DUSR   ?ZRG2   = ?ZRGI+1       ; Subpkt Id, low
.DUSR   ?ZRGF   = ?ZRG2+1       ; Flags
.DUSR   ?ZRG3   = ?ZRGF+1       ; Queuename buffer size
.DUSR   ?ZRGQ   = ?ZRG3+1       ; BP(Queuename)

.DUSR   ?ZRGL   = ?ZRGQ+2       ; Autokey subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Register Function, ?ZRGF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZBF =  0.             ; (input bit)
.DUSR   ?ZYBF =  1B(?ZZBF)      ; bit mask
;     If set, bp(queuename) buffer is passed in ?ZRGQ.

;----------------------------------------------------------------------
;             ?OPEX,  REGISTERSTATUS,  function code = ?ZRS
;----------------------------------------------------------------------

.DUSR   ?ZRSI   = 0             ; Subpkt Id, high
.DUSR   ?ZRS2   = ?ZRSI+1       ; Subpkt Id, low
.DUSR   ?ZRSF   = ?ZRS2+1       ; Flags
.DUSR   ?ZRSR   = ?ZRSF+1       ; Error code
.DUSR   ?ZRSK   = ?ZRSR+1       ; Get next key, high
.DUSR   ?ZRS1   = ?ZRSK+1       ; Get next key, low
.DUSR   ?ZRS3   = ?ZRS1+1       ; Get next key2, high
.DUSR   ?ZRS4   = ?ZRS3+1       ; Get next key2, low
.DUSR   ?ZRSQ   = ?ZRS4+1       ; BP(queuename buffer)
.DUSR   ?ZRSA   = ?ZRSQ+2       ; Available RQB size
.DUSR   ?ZRSB   = ?ZRSA+1       ; Returned RQB size

.DUSR   ?ZRSL   = ?ZRSB+1       ; Registerstatus subpkt length

;----------------------------------------------------------------------
;Bit mask definitions, Registerstatus Function, ?ZRSF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZCF =  0.             ; (input bit)
.DUSR   ?ZYCF =  1B(?ZZCF)      ; bit mask
;     User wants status on all local queues.


; DEFINE PARAMETERS FOR MP SYSTEM CALLS ?JPINIT, ?JPREL AND ?LOCALITY
;
; DEFINE THE RANGE OF SOME PARAMETERS

.DUSR   ?LPMN   =       0       ; LOWEST LOGICAL PROCESSOR VALUE
.DUSR   ?LPMX   =       15.     ; HIGHEST LOGICAL PROCESSOR VALUE

.DUSR   ?JPMN   =       0       ; LOWEST JOB PROCESSOR VALUE
.DUSR   ?JPMX   =       15.     ; HIGHEST JOB PROCESSOR VALUE

.DUSR   ?LOMN   =       0       ; LOWEST USER LOCALITY VALUE
.DUSR   ?LOMX   =       15.     ; HIGHEST USER LOCALITY VALUE

; DEFINE PARAMETERS FOR THE ?JPINIT SYSTEM CALL

.DUSR   ?JIIH   =       0       ; PACKET ID, HIGH WORD
.DUSR   ?JIIL   =       ?JIIH+1 ; PACKET ID, LOW WORD
.DUSR   ?JIR1   =       ?JIIL+1 ; RESERVED
.DUSR   ?JIFL   =       ?JIR1+1 ; FLAGS WORD
.DUSR   ?JIPD   =       ?JIFL+1 ; JOB PROCESSOR
.DUSR   ?JILD   =       ?JIPD+1 ; LOGICAL PROCESSOR
.DUSR   ?JIUO   =       ?JILD+1 ; MICROCODE OPTIONS WORD
.DUSR   ?JIUN   =       ?JIUO+1 ; BYTE ADDRESS OF U-CODE PATHNAME
.DUSR   ?JIR2   =       ?JIUN+1 ; RESERVED
.DUSR   ?JIAS   =       ?JIR2+1 ; SIZE OF BUFFER HOLDING U-CODE NAME
.DUSR   ?JILN   =       ?JIAS+1 ; LENGTH OF ?JPINIT PACKET

;DEFINE FLAGS WORD ?JIFL

.DUSR   ?JIFS   =       1B0     ; USE MICROCODE FILE NAME SUPPLIED
.DUSR   ?JIFE   =       1B1     ; USE EXISTING MICROCODE FILE

;DEFINE PACKET ID FOR ?JPINIT CALL

.DUSR   ?JID1   =       553     ; HIGH PART OF PACKET ID
.DUSR   ?JID2   =       0       ; LOW PART OF PACKET ID


; DEFINE  PACKET PARAMETERS FOR ?JPREL SYSTEM CALL

.DUSR   ?JRIH   =       0       ; PACKET ID, HIGH WORD
.DUSR   ?JRIL   =       ?JRIH+1 ; PACKET ID, LOW WORD
.DUSR   ?JRR1   =       ?JRIL+1 ; RESERVED
.DUSR   ?JRFL   =       ?JRR1+1 ; FLAG WORD
.DUSR   ?JRPD   =       ?JRFL+1 ; JPID
.DUSR   ?JRLN   =       ?JRPD+1 ; LENGTH OF ?JPREL PACKET

;DEFINE FLAG WORD ?JRFL

.DUSR   ?JRFE   =       1B0     ; RETURN ERROR IF JP IS LAST ON AN LP

;DEFINE  PACKET ID

.DUSR   ?JRD1   =       554     ; HIGH PART OF PACKET ID
.DUSR   ?JRD2   =       0       ; LOW PART OF PACKET ID


; DEFINE PARAMETERS FOR ?LOCALITY PACKET

.DUSR   ?LOIH   =       0       ; PACKET ID, HIGH WORD
.DUSR   ?LOIL   =       ?LOIH+1 ; PACKET ID, LOW WORD
.DUSR   ?LOR1   =       ?LOIL+1 ; RESERVED
.DUSR   ?LOPC   =       ?LOR1+1 ; PID/PNAME CODE
.DUSR   ?LOPD   =       ?LOPC+1 ; PID OR -1 FOR SELF
.DUSR   ?LOBP   =       ?LOPD+1 ; BYTE ADDRESS OF PROCESSNAME AREA
.DUSR   ?LOR2   =       ?LOBP+1 ; RESERVED
.DUSR   ?LOAL   =       ?LOR2+1 ; LENGTH OF PROCESSNAME AREA
.DUSR   ?LONL   =       ?LOAL+1 ; NEW USER LOCALITY
.DUSR   ?LOLN   =       ?LONL+1 ; LENGTH OF ?LOCALITY PACKET

; DEFINE VALUES FOR PID/PNAME CODE (?LOPC)

.DUSR   ?LOUP   =       0       ; USE PID
.DUSR   ?LOUN   =       1       ; USE PROCESS NAME

;DEFINE PACKET ID

.DUSR   ?LOD1   =       567     ; HIGH PART OF PACKET ID
.DUSR   ?LOD2   =       0       ; LOW PART OF PACKET ID

;
; ?SYSPRV SYSTEM CALL
;

; ?SYSPRV PACKET DEFINITION

.DUSR   ?SPIH   =       0       ; PACKET ID, HIGH WORD
.DUSR   ?SPIL   =       ?SPIH+1 ; PACKET ID, LOW WORD
.DUSR   ?SPFU   =       ?SPIL+1 ; FUNCTION CODE
.DUSR   ?SPFW   =       ?SPFU+1 ; FLAGS WORD
.DUSR   ?SPMO   =       ?SPFW+1 ; MODE VALUE
.DUSR   ?SPR1   =       ?SPMO+1 ; RESERVED WORD
.DUSR   ?SPR2   =       ?SPR1+1 ; RESERVED WORD
.DUSR   ?SPLN   =       ?SPR2+1 ; LENGTH OF ?JPINIT PACKET

; ?SYSPRV FUNCTION CODES

.DUSR   ?SPFG   =       1       ; GET PRIVILEGE STATUS
.DUSR   ?SPFE   =       2       ; ENTER A PRIVILEGED MODE
.DUSR   ?SPFV   =       3       ; ENTER A PRIVILEGED MODE EXCLUSIVELY
.DUSR   ?SPFL   =       4       ; LEAVE A PRIVILEGED MODE

.DUSR   ?SPFN   =       ?SPFG   ; MINIMUM LEGAL FUNCTION CODE
.DUSR   ?SPFX   =       ?SPFL   ; MAXIMUM LEGAL FUNCTION CODE

; ?SYSPRV MODE VALUES

.DUSR   ?SPMU   =       1       ; SUPERUSER
.DUSR   ?SPMP   =       2       ; SUPERPROCESS
.DUSR   ?SPMS   =       3       ; SYSTERM MANAGER

.DUSR   ?SPMN   =       ?SPMU   ; MINIMUM LEGAL MODE
.DUSR   ?SPMX   =       ?SPMS   ; MAXIMUM LEGAL MODE

; ?SYSPRV FLAG BITS

.DUSR   ?SPBC   =       0       ; CALLER HAS PRIVILEGE ON
.DUSR   ?SPBE   =       1       ; CALLER HAS PRIVILEGE ON EXCLUSIVELY
.DUSR   ?SPBO   =       2       ; OTHERS HAVE PRIVILEGE ON
.DUSR   ?SPBX   =       3       ; OTHERS HAVE PRIVILEGE ON EXCLUSIVELY

; ?SYSPRV PACKET ID

.DUSR   ?SPI1   =       573     ; HIGH PART OF PACKET ID
.DUSR   ?SPI2   =       0       ; LOW PART OF PACKET ID



; DEFINE ?XINIT PARAMETERS

.DUSR   ?XIPHI  = 0             ; PACKET ID (HIGH)
.DUSR   ?XIPLO  = ?XIPHI+1      ; PACKET ID (LOW)
.DUSR   ?XIFUN  = ?XIPLO+1      ; FUNCTION CODE
.DUSR   ?XIRES  = ?XIFUN+1      ; RESERVED
.DUSR   ?XIR1   = ?XIRES+1      ; RESERVED
.DUSR   ?XIOP   = ?XIR1+1       ; OPTION BITS
.DUSR   ?XIR2   = ?XIOP+1       ; RESERVED
.DUSR   ?XIDIR  = ?XIR2+1       ; BP TO TARGET DIR
.DUSR   ?XIR3   = ?XIDIR+1      ; RESERVED
.DUSR   ?XILDN  = ?XIR3+1       ; BP TO RETURNED LD NAME
.DUSR   ?XIR4   = ?XILDN+1      ; RESERVED
.DUSR   ?XICNT  = ?XIR4+1       ; LDID/PUL COUNT
.DUSR   ?XIR5   = ?XICNT+1      ; RESERVED
.DUSR   ?XID1   = ?XIR5+1       ; RESERVED
.DUSR   ?XIR6   = ?XID1+1       ; RESERVED
.DUSR   ?XIP1   = ?XIR6+1       ; WORD POINTER TO 1ST PUL SUBPACKET
.DUSR   ?XIR7   = ?XIP1+1       ; RESERVED
.DUSR   ?XID2   = ?XIR7+1       ; RESERVED
.DUSR   ?XIR8   = ?XID2+1       ; RESERVED
.DUSR   ?XIP2   = ?XIR8+1       ; WORD POINTER TO 2ND PUL SUBPACKET
.DUSR   ?XIR9   = ?XIP2+1       ; RESERVED
.DUSR   ?XID3   = ?XIR9+1       ; RESERVED
.DUSR   ?XIRA   = ?XID3+1       ; RESERVED
.DUSR   ?XIP3   = ?XIRA+1       ; RESERVED

.DUSR   ?XILN   = ?XIP3+1       ; PACKET LENGTH

; DEFINE PACKET ID FOR ?XINIT CALL OFFSETS ?XIPHI AND ?XIPLO

.DUSR   ?XII1   = 571           ; PACKET ID (HIGH)
.DUSR   ?XII2   = 0             ; PACKET ID (LOW)

; FUNCTION CODES (FOR ?XINIT OFFSET ?XIFUN)

.DUSR   ?XFGWD  = 1             ; GRAFT LDU INTO WORKING DIR
.DUSR   ?XFGRT  = 2             ; GRAFT LDU INTO ROOT
.DUSR   ?XIGTD  = 3             ; GRAFT LDU INTO SPECIFIED DIRECTORY

; OPTION BITS (FOR ?XINIT OFFSET ?XIOP)

.DUSR   ?XBORD  = 1B0           ; OVERRIDE INCOMPLETE MIRROR ERROR
                                ; CONDITION
.DUSR   ?XBFXR  = 1B1           ; FIXUP RECOMMENDED
.DUSR   ?XBNHR  = 1B2           ;PREVENT HARDWARE MIRRORING, USE
                                ; SOFTWARE MIRRORING ONLY
.DUSR   ?XBIDS  = 1B3           ; LDU ID SPECIFIED
.DUSR   ?XBTRP  = 1B4           ; TRESPASS ON A DEVICE MARKED AS OWNED
                                ; BY ANOTHER SYSTEM


; MAX NUMBER OF IMAGES SUPPORTED (FOR ?XINIT OFFSET ?XICNT)

.DUSR   ?MAXIMAGES  =3                  ; 3 IMAGES MAX.



; DEFINE ?MIRROR PARAMETERS

.DUSR   ?MIPHI  = 0             ; PACKET ID (HIGH)
.DUSR   ?MIPLO  = ?MIPHI+1      ; PACKET ID (LOW)
.DUSR   ?MIFUN  = ?MIPLO+1      ; FUNCTION CODE
.DUSR   ?MIRES  = ?MIFUN+1      ; RESERVED
.DUSR   ?MIR1   = ?MIRES+1      ; RESERVED
.DUSR   ?MIOP   = ?MIR1+1       ; OPTION BITS
.DUSR   ?MIR2   = ?MIOP+1       ; RESERVED
.DUSR   ?MILD   = ?MIR2+1       ; BP TO LDU PATHNAME
.DUSR   ?MIR3   = ?MILD+1       ; RESERVED
.DUSR   ?MIID   = ?MIR3+1       ; RESERVED
.DUSR   ?MIR4   = ?MIID+1       ; RESERVED
.DUSR   ?MIPUL  = ?MIR4+1       ; WORD POINTER TO PHYS UNIT LIST SUBPACKET

.DUSR   ?MILN   = ?MIPUL+1      ; PACKET LENGTH


; DEFINE PACKET ID FOR ?MIRROR CALL OFFSETS ?MIPHI AND ?MIPLO

.DUSR   ?MII1   = 572           ; PACKET ID (HIGH)
.DUSR   ?MII2   = 0             ; PACKET ID (LOW)

; FUNCTION CODES (FOR ?MIRROR OFFSET ?MIFUN)

.DUSR   ?MFSYM  = 1             ;SYNCHRONIZE THE MIRROR
.DUSR   ?MFBRK  = 2             ;BREAK OFF A MIRROR IMAGE

; OPTION BITS (FOR ?MIRROR OFFSET ?MIOP)

.DUSR   ?MBOOP  = 1B0           ;OVERRIDE OUT OF PHASE ERROR
.DUSR   ?MBWAIT = 1B1           ;WAIT FOR SYNC TO COMPLETE
.DUSR   ?MBNHR  = 1B2           ;PREVENT HARDWARE MIRRORING, USE
.DUSR   ?MBNLD  = 1B3           ;LDIID's SPECIFIED
                                ; SOFTWARE MIRRORING ONLY
.DUSR   ?MBTRP  = 1B4           ; TRESPASS ON A DEVICE MARKED AS OWNED
                                ; BY ANOTHER SYSTEM



; DEFINE ?XINIT/?MIRROR PHYSICAL UNIT LIST SUBPACKET PARAMETERS

.DUSR   ?ULPHI  = 0             ; PACKET ID (HIGH)
.DUSR   ?ULPLO  = ?ULPHI+1      ; PACKET ID (LOW)
.DUSR   ?ULR0   = ?ULPLO+1      ; RESERVED
.DUSR   ?ULNC   = ?ULR0+1       ; UNIT NAME COUNT
.DUSR   ?ULR1   = ?ULNC+1       ; RESERVED
.DUSR   ?ULN1   = ?ULR1+1       ; BP TO 1ST UNIT NAME
.DUSR   ?ULR2   = ?ULN1+1       ; RESERVED
.DUSR   ?ULN2   = ?ULR2+1       ; BP TO 2ND UNIT NAME
.DUSR   ?ULR3   = ?ULN2+1       ; RESERVED
.DUSR   ?ULN3   = ?ULR3+1       ; BP TO 3RD UNIT NAME
.DUSR   ?ULR4   = ?ULN3+1       ; RESERVED
.DUSR   ?ULN4   = ?ULR4+1       ; BP TO 4TH UNIT NAME
.DUSR   ?ULR5   = ?ULN4+1       ; RESERVED
.DUSR   ?ULN5   = ?ULR5+1       ; BP TO 5TH UNIT NAME
.DUSR   ?ULR6   = ?ULN5+1       ; RESERVED
.DUSR   ?ULN6   = ?ULR6+1       ; BP TO 6TH UNIT NAME
.DUSR   ?ULR7   = ?ULN6+1       ; RESERVED
.DUSR   ?ULN7   = ?ULR7+1       ; BP TO 7TH UNIT NAME
.DUSR   ?ULR8   = ?ULN7+1       ; RESERVED
.DUSR   ?ULN8   = ?ULR8+1       ; BP TO 8TH UNIT NAME

.DUSR   ?ULLN   = ?ULN8+1       ; PACKET LENGTH

; DEFINE PACKET ID FOR SUBPACKET OFFSETS ?ULPHI AND ?ULPLO

.DUSR   ?ULI1   = 571           ; PACKET ID(HI) (WHEN USED WITH ?XINIT)
.DUSR   ?ULI2   = 572           ; PACKET ID(HI) (WHEN USED WITH ?MIRROR)
.DUSR   ?ULI3   = (1*400)+0     ; PACKET ID(LO) (SAME FOR ?XINIT/?MIRROR)

; MAX NUMBER OF UNIT NAMES SUPPORTED (FOR OFFSET ?ULNC)

.DUSR   ?MAXNAMES=8.            ;MAX # UNIT NAMES

        .EOF                    ; END OF PARU.16.SR