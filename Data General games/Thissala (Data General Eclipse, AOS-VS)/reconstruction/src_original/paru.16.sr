;-----------------------------------------------------------------------

.DUSR   ?ZZT0   =  0.                   ; (input bit)
.DUSR   ?ZYT0   =  1B(?ZZT0)            ; bit mask
;    Silence all default batch input streams.


;-----------------------------------------------------------------------
;             ?OPEX,  START,  function code = ?ZSR
;-----------------------------------------------------------------------

.DUSR   ?ZSRI   = 0                     ; Subpkt Id, high
.DUSR   ?ZSR2   = ?ZSRI+1               ; Subpkt Id, low
.DUSR   ?ZSRF   = ?ZSR2+1               ; Flags
.DUSR   ?ZSRS   = ?ZSRF+1               ; # of streams
