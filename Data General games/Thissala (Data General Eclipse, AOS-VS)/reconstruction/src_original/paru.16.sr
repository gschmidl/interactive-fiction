.DUSR   ?FIMG=  ?FVIF+1 ; FACSIMILE IMAGE
.DUSR   ?FPRF=  ?FIMG+1 ; PRINT READY FILE

; MORE DGC ENTRY TYPES

.DUSR   ?FPIP=  ?FPRF+1 ; PIPE FILE
.DUSR   ?FTTX=  ?FPIP+1 ; TELETEX FILE
.DUSR   ?FDXF=  ?FTTX+1 ; RESERVED FOR DXA
.DUSR   ?FDXR=  ?FDXF+1 ; RESERVED FOR DXA
