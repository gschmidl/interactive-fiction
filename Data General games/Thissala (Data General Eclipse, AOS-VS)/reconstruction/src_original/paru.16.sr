        .TITL   PARU16

;==============================================;
; AOS/VS 16-BIT USER PARAMETER DEFINITION FILE.
;==============================================;



; SYMBOL DEFINITION REQUIREMENTS ARE THE FOLLOWING:
; 1) ALL SYMBOLS OF THE FORM ?XXXX ARE RESERVED FOR
;    DEFINING PARAMETERS USED JOINTLY BY THE OPERATING
;    SYSTEM AND USER ASSEMBLED PROGRAMS.
; 2) ALL SYMBOLS OF THE FORM ERXXX ARE RESERVED FOR DEFINING
;    OPERATING SYSTEM ERROR CODES
; 3) ALL SYMBOLS OF THE FORM USTXX ARE RESERVED FOR DEFINING
;    THE USER STATUS TABLE.
; 4) DON'T ADD ANY SYMBOLS TO PARU UNLESS THEY CONFORM
;    TO THESE RULES.



;SYSTEM ERROR CODES

.DUSR ERICM=    1       ;ILLEGAL SYSTEM COMMAND
.DUSR ERFNO=    2       ;CHANNEL NOT OPEN
.DUSR EROPR=    3       ;CHANNEL ALREADY OPEN
.DUSR ERSAL=    4       ;SHARED I/O REQ NOT MAP SLOT ALIGNED
.DUSR ERMEM=    5       ;INSUFFICIENT MEMORY AVAILABLE
.DUSR ERADR=    6       ;ILLEGAL STARTING ADDRESS
.DUSR EROVN=    7       ;ILLEGAL OVERLAY NUMBER
.DUSR ERTIM=    10      ;ILLEGAL TIME ARGUMENT
.DUSR ERNOT=    11      ;NO TASK CONTROL BLOCK AVAILABLE
.DUSR ERXMT=    12      ;SIGNAL TO ADDRESS ALREADY IN USE
.DUSR ERQTS=    13      ;ERROR IN QTASK REQUEST
.DUSR ERTID=    14      ;TASK I.D. ERROR
.DUSR ERDCH=    15      ;DATA CHANNEL MAP FULL
.DUSR ERMPR=    16      ;SYSTEM CALL PARAMETER ADDRESS ERROR
.DUSR ERABT=    17      ;TASK NOT FOUND FOR ABORT
.DUSR ERIRB=    20      ;INSUFFICIENT ROOM IN BUFFER
.DUSR ERSPC=    21      ;FILE SPACE EXHAUSTED
.DUSR ERSFT=    22      ;USER STACK FAULT
.DUSR ERDDE=    23      ;DIRECTORY DOES NOT EXIST
.DUSR ERIFC=    24      ;ILLEGAL FILENAME CHARACTER
.DUSR ERFDE=    25      ;FILE DOES NOT EXIST
.DUSR ERNAE=    26      ;FILE NAME ALREADY EXISTS
.DUSR ERNAD=    27      ;NON-DIRECTORY ARGUMENT IN PATHNAME
.DUSR EREOF=    30      ;END OF FILE
.DUSR ERDID=    31      ;DIRECTORY DELETE ERROR
.DUSR ERWAD=    32      ;WRITE ACCESS DENIED
.DUSR ERRAD=    33      ;READ ACCESS DENIED
.DUSR ERAWD=    34      ;APPEND AND/OR WRITE ACCESS DENIED
.DUSR ERNMC=    35      ;NO CHANNELS AVAILABLE
.DUSR ERSRL=    36      ;RELEASE OF NON-ACTIVE SHARED SLOT
.DUSR ERPRP=    37      ;ILLEGAL PRIORITY
.DUSR ERBMX=    40      ;ILLEGAL MAX SIZE ON PROCESS CREATE
.DUSR ERPTY=    41      ;ILLEGAL PROCESS TYPE
.DUSR ERCON=    42      ;CONSOLE DEVICE SPECIFICATION ERROR
.DUSR ERNSW=    43      ;SWAP FILE SPACE EXHAUSTED
.DUSR ERIBS=    44      ;DEVICE ALREADY IN SYSTEM
.DUSR ERDNM=    45      ;ILLEGAL DEVICE CODE
.DUSR ERSHP=    46      ;ERROR ON SHARED PARTITION SET
.DUSR ERRMP=    47      ;ERROR ON REMAP CALL
.DUSR ERGSG=    50      ;ILLEGAL AGENT GATE CALL
.DUSR ERPRN=    51      ;NUMBER OF PROCESSES EXCEEDS MAX
.DUSR ERNEF=    52      ;IPC MESSAGE EXCEEDS BUFFER LENGTH
.DUSR ERIVP=    53      ;INVALID PORT NUMBER
.DUSR ERNMS=    54      ;NO MATCHING SEND
.DUSR ERNOR=    55      ;NO OUTSTANDING RECEIVE
.DUSR ERIOP=    56      ;ILLEGAL ORIGIN PORT
.DUSR ERIDP=    57      ;ILLEGAL DESTINATION PORT
.DUSR ERSEN=    60      ;INVALID SHARED LIBRARY REFERENCE
.DUSR ERIRL=    61      ;ILLEGAL RECORD LENGTH SPECIFIED(=0)
.DUSR ERARC=    62      ;ATTEMPT TO RELEASE CONSOLE DEVICE
.DUSR ERDAI=    63      ;DEVICE ALREADY IN USE
.DUSR ERARU=    64      ;ATTEMPT TO RELEASE UNASSIGNED DEVICE
.DUSR ERACU=    65      ;ATTEMPT TO CLOSE UNOPEN CHANNEL/DEVICE
.DUSR ERITC=    66      ;I/O TERMINATED BY CLOSE
.DUSR ERLTL=    67      ;LINE TOO LONG
.DUSR ERPAR=    70      ;PARITY ERROR
.DUSR EREXC=    71      ;RESDENT PROC TRIED TO PUSH (.EXEC)
.DUSR ERNDR=    72      ;NOT A DIRECTORY
.DUSR ERNSA=    73      ;SHARED I/O REQUEST NOT TO SHARED AREA
.DUSR ERSNM=    74      ;ATTEMPT TO CREATE > MAX # SONS
.DUSR ERFIL=    75      ;FILE READ ERROR
.DUSR ERDTO=    76      ;DEVICE TIMEOUT
.DUSR ERIOT=    77      ;WRONG TYPE I/O FOR OPEN TYPE
.DUSR ERFTL=    100     ;FILENAME TOO LONG
.DUSR ERBOF=    101     ;POSITIONING BEFORE BEGINNING OF FILE
.DUSR ERPRV=    102     ;CALLER NOT PRIVILEGED FOR THIS ACTION
.DUSR ERSIM=    103     ;SIMULTANEOUS REQUESTS ON SAME CHANNEL
.DUSR ERIFT=    104     ;ILLEGAL FILE TYPE
.DUSR ERNRD=    105     ;INSUFFICIENT ROOM IN DIRECTORY
.DUSR ERILO=    106     ;ILLEGAL OPEN
.DUSR ERPRH=    107     ;ATTEMPT TO ACCESS PROC NOT IN HIERARCHY
.DUSR ERBLR=    110     ;ATTEMPT TO BLOCK UNBLOCKABLE PROC
.DUSR ERPRE=    111     ;INVALID SYSTEM CALL PARAMETER
.DUSR ERGES=    112     ;ATTEMPT TO START MULTIPLE AGENTS
.DUSR ERCIU=    113     ;CHANNEL IN USE
.DUSR ERICB=    114     ;INSUFFICIENT CONTIGUOUS DISK BLOCKS
.DUSR ERSTO=    115     ;STACK OVERFLOW
.DUSR ERIBM=    116     ;INCONSISTENT BIT MAP DATA
.DUSR ERBSZ=    117     ;ILLEGAL BLOCK SIZE FOR DEVICE
.DUSR ERXMZ=    120     ;ATTEMPT TO XMT ILLEGAL MESSAGE
.DUSR ERPUF=    121     ;PHYSICAL UNIT FAILURE
.DUSR ERPWL=    122     ;PHYSICAL WRITE LOCK
.DUSR ERUOL=    123     ;PHYSICAL UNIT OFFLINE
.DUSR ERIOO=    124     ;ILLEGAL OPEN OPTION FOR FILE TYPE
.DUSR ERNDV=    125     ;TOO MANY OR TOO FEW DEVICE NAMES
.DUSR ERMIS=    126     ;DISK AND FILE SYS REV #'S DON'T MATCH
.DUSR ERIDD=    127     ;INCONSISTENT DIB DATA
.DUSR ERILD=    130     ;INCONSISTENT LD
.DUSR ERIDU=    131     ;INCOMPLETE LD
.DUSR ERIDT=    132     ;ILLEGAL DEVICE NAME TYPE
.DUSR ERPDF=    133     ;ERROR IN PROCESS UST DEFINITION
.DUSR ERVIU=    134     ;LD IN USE, CANNOT RELEASE
.DUSR ERSRE=    135     ;SEARCH LIST RESOLUTION ERROR
.DUSR ERCGF=    136     ;CAN'T GET IPC DATA FROM FATHER
.DUSR ERILB=    137     ;ILLEGAL LIBRARY NUMBER GIVEN
.DUSR ERRFM=    140     ;ILLEGAL RECORD FORMAT
.DUSR ERARG=    141     ;TOO MANY OR TOO FEW ARGUMENTS TO PMGR
.DUSR ERIGM=    142     ;ILLEGAL ?GTMES PARAMETERS
.DUSR ERICL=    143     ;ILLEGAL CLI MESSAGE
.DUSR ERMRD=    144     ;MESSAGE RECEIVE DISABLED
.DUSR ERNAC=    145     ;NOT A CONSOLE DEVICE
.DUSR ERMIL=    146     ;ATTEMPT TO EXCEED MAX INDEX LEVEL
.DUSR ERICN=    147     ;ILLEGAL CHANNEL
.DUSR ERNRR=    150     ;NO RECEIVER WAITING
.DUSR ERSRR=    151     ;SHORT RECEIVE REQUEST
.DUSR ERTIN=    152     ;TRANSMITTER INOPERATIVE
.DUSR ERUNM=    153     ;ILLEGAL USER NAME
.DUSR ERILN=    154     ;ILLEGAL LINK #
.DUSR ERDPE=    155     ;DISK POSITIONING ERROR
.DUSR ERTXT=    156     ;MSG TEXT LONGER THAN SPEC'D.
.DUSR ERSTR=    157     ;SHORT TRANSMISSION
.DUSR ERHIS=    160     ;ERROR ON HISTOGRAM INIT/DELETE
.DUSR ERIRV=    161     ;ILLEGAL RETRY VALUE
.DUSR ERASS=    162     ;ASSIGN ERROR - ALREADY YOUR DEVICE
.DUSR ERPET=    163     ;MAG TAPE REQ PAST LOGICAL END OF TAPE
.DUSR ERSTS=    164     ;STACK TOO SMALL (?TASK)
.DUSR ERTMT=    165     ;TOO MANY TASKS REQUESTED (?TASK)
.DUSR ERSOC=    166     ;SPOOLER OPEN RETRY COUNT EXCEEDED
.DUSR ERACL=    167     ;ILLEGAL ACL
.DUSR ERWPB=    170     ;?STMAP BUFFER INVALID OR WRITE PROTECTED
.DUSR ERINP=    171     ;IPC FILE NOT OPENED BY ANOTHER PROC
.DUSR ERFPU=    172     ;FPU HARDWARE NOT INSTALLED
.DUSR ERPNM=    173     ;ILLEGAL PROCESS NAME
.DUSR ERPNU=    174     ;PROCESS NAME ALREADY IN USE
.DUSR ERDCT=    175     ;DISCONNECT ERROR (MODEM CONTROLLED)
.DUSR ERIPR=    176     ;NONBLOCKING PROC REQUEST ERROR
.DUSR ERSNI=    177     ;SYSTEM NOT INSTALLED
.DUSR ERLVL=    200     ;MAX DIRECTORY TREE DEPTH EXCEEDED
.DUSR ERROO=    201     ;RELEASING OUT-OF-USE OVERLAY
.DUSR ERRDL=    202     ;RESOURCE DEADLOCK
.DUSR EREO1=    203     ;FILE IS OPEN, CAN'T EXCLUSIVE OPEN
.DUSR EREO2=    204     ;FILE IS EXCLUSIVE OPENED, CAN'T OPEN
.DUSR ERIPD=    205     ;INIT PRIVILEGE DENIED
.DUSR ERMIM=    206     ;MULTIPLE ?IMSG CALLS TO SAME DCT
.DUSR ERLNK=    207     ;ILLEGAL LINK
.DUSR ERIDF=    210     ;ILLEGAL DUMP FORMAT
.DUSR ERXNA=    211     ;EXEC NOT AVAILABLE (MOUNT, ETC.)
.DUSR ERXUF=    212     ;EXEC REQUEST FUNCTION UNKNOWN
.DUSR ERESO=    213     ;ONLY EXEC'S SONS CAN DO THAT
.DUSR ERRBO=    214     ;REFUSED BY OPERATOR
.DUSR ERWMT=    215     ;VOLUME NOT MOUNTED
.DUSR ERISV=    216     ;ILLEGAL SWITCH VALUE (>65K DECIMAL)

;THE NEXT FOUR ERROR CODES MUST BE CONTIGUOUSLY NUMBERED

.DUSR ERIFN=    217     ;INPUT FILE  DOES NOT EXIST
.DUSR EROFN=    220     ;OUTPUT FILE  DOES NOT EXIST
.DUSR ERLFN=    221     ;LIST FILE  DOES NOT EXIST
.DUSR ERDFN=    222     ;DATA FILE DOES NOT EXIST

.DUSR ERGFE=    223     ;RECURSIVE GENERIC FILE OPEN FAILURE
.DUSR ERNMW=    224     ;NO MESSAGE WAITING
.DUSR ERNUD=    225     ;USER DATA AREA DOES NOT EXIST
.DUSR ERDVC=    226     ;ILLEGAL DEVICE TYPE FROM VSGEN
.DUSR ERRST=    227     ;RESTART OF SYSTEM CALL
.DUSR ERFUR=    230     ;PROBABLY FATAL HARDWARE RUNTIME ERROR
.DUSR ERCFT=    231     ;USER COMMERCIAL STACK FAULT
.DUSR ERFFT=    232     ;USER FLOATING POINT STACK FAULT
.DUSR ERUAE=    233     ;USER DATA AREA ALREADY EXISTS
.DUSR ERISO=    234     ;ILLEGAL SCREEN_EDIT REQUEST (PMGR)
.DUSR ERDDH=    235     ;"?SEND" DESTINATION DEVICE HELD BY "^S"
.DUSR EROVR=    236     ;DATA OVERRUN ERROR
.DUSR ERCPD=    237     ;CONTROL POINT DIRECTORY MAX SIZE EXCEEDED
.DUSR ERNSD=    240     ;SYS OR BOOT DISK NOT PART OF MASTER LD
.DUSR ERUSY=    241     ;UNIVERSAL SYSTEM, YOU CAN'T DO THAT
.DUSR EREAD=    242     ;EXECUTE ACCESS DENIED
.DUSR ERFIX=    243     ;CAN'T INIT LD, RUN FIXUP ON IT
.DUSR ERFAD=    244     ;FILE ACCESS DENIED
.DUSR ERDAD=    245     ;DIRECTORY ACCESS DENIED
.DUSR ERIAD=    246     ;ATTEMPT TO DEFINE > 1 SPECIAL PROC
.DUSR ERIND=    247     ;NO SPECIAL PROCESS IS DEFINED
.DUSR ERPRO=    250     ;ATTEMPT TO ISSUE MCA REQUEST WITH
                        ;DIRECT I/O IN PROGRESS
.DUSR ERDIO=    251     ;ATTEMPT TO ISSUE MCA DIRECT I/O WITH
                        ;OUTSTANDING REQUESTS
.DUSR ERLTK=    252     ;LAST TASK WAS KILLED
.DUSR ERLRF=    253     ;RESOURCE LOAD OR RELEASE FAILURE
.DUSR ERNNL=    254     ;ZERO LENGTH FILENAME SPECIFIED

;SYNCHRONOUS LINE ERROR CODES
.DUSR ERBOV=    ERNNL+1 ;BUFFER OVERFLOW
.DUSR ERNAK=    ERBOV+1 ;TRANSMISSION FAILURE (NAK COUNT)
.DUSR ERTOF=    ERNAK+1 ;TRANSMISSION FAILURE (TIMEOUTS)
.DUSR ERDIS=    ERTOF+1 ;DISCONNECT OCCURRED ON SWITCHED LINE
.DUSR EREOT=    ERDIS+1 ;EOT CHARACTER RECEIVED
.DUSR EROTH=    EREOT+1 ;POSSIBLE LOST DATA ON HASP LINE
.DUSR ERDCU=    EROTH+1 ;DCU INOPERATIVE (CAN'T BE INITIALIZED)
.DUSR ERCNV=    ERDCU+1 ;CONVERSATIONAL REPLY RECEIVED
.DUSR EREPL=    ERCNV+1 ;END OF POLLING LIST REACHED
.DUSR ERIRT=    EREPL+1 ;ILLEGAL RELATIVE TERMINAL NUMBER
.DUSR ERRVI=    ERIRT+1 ;RVI RESPONSE RECEIVED
.DUSR ERLIN=    ERRVI+1 ;ILLEGAL LINE NUMBER
.DUSR ERPLS=    ERLIN+1 ;NOT ENOUGH SPACE FOR POLL LISTS
.DUSR ERCTN=    ERPLS+1 ;CONTENTION SITUATION WHILE BIDDING
.DUSR ERSEQ=    ERCTN+1 ;OUT-OF-SEQUENCE GEN ENTRY DURING SINIT
.DUSR ERNSL=    ERSEQ+1 ;ATTEMPT TO ENABLE NON-SYNC LINE
.DUSR ERIMM=    ERNSL+1 ;NOT ENOUGH MEMORY FOR POLL/SELECT LIST
.DUSR EREPE=    ERIMM+1 ;LINE ALREADY ENABLED ON ?SEBL CALL
.DUSR ERDSL=    EREPE+1 ;LINE ALREADY DISABLED ON ?SDBL CALL
.DUSR ERLNA=    ERDSL+1 ;I/O REQUEST FOR DISABLED LINE
.DUSR ERLIS=    ERLNA+1 ;LINE IN SESSION ON ?SSND INITIAL CALL
.DUSR ERSCS=    ERLIS+1 ;?SSND CONTINUE WITHOUT LINE IN SESSION
.DUSR ERBCT=    ERSCS+1 ;SEND BYTE COUNT EXCEEDS SYSTEM BUFFER
.DUSR ERBNK=    ERBCT+1 ;BID ERROR (TOO MANY NAKS)
.DUSR ERWAB=    ERBNK+1 ;WABT RECEIVED (HASP LINE ONLY)
.DUSR ERBPE=    ERWAB+1 ;USER BUFFER BYTE POINTER INVALID
.DUSR ERBRT=    ERBPE+1 ;RETRY COUNT EXCEEDED
.DUSR ERETX=    ERBRT+1 ; 'ETX' CODE RECEIVED
.DUSR ERISE=    ERETX+1 ;INPUT STATUS ERROR (FORMAT)
.DUSR ERFCT=    ERISE+1 ;FAILURE TO CONNECT
.DUSR ERUNI=    ERFCT+1 ;UNINTERPRETABLE RESPONSE RECEIVED
.DUSR ERENQ=    ERUNI+1 ;ENQ RECEIVED AFTER TIME-OUT
.DUSR ERCRC=    ERENQ+1 ;CRC CHECK
.DUSR ERINE=    ERCRC+1 ;INITIALIZATION PARAMETER ERROR
.DUSR ERTRF=    ERINE+1 ;TRANSMITTER FAILURE ERROR
.DUSR ERLNM=    ERTRF+1 ;LINE NOT MULTIPOINT
.DUSR ERNCS=    ERLNM+1 ;NOT A CONTROL STATION
.DUSR ERNPL=    ERNCS+1 ;POLLING LIST NOT DEFINED

.DUSR ERITF=    ERNPL+1 ;INCOMPATIBLE LPB TAB FORMAT
.DUSR ERPRM=    ERITF+1 ;CANNOT DELETE PERMANENT FILE
.DUSR ERSCA=    ERPRM+1 ;SYSTEM CALL ABORT
.DUSR ERCAD=    ERSCA+1 ;EXTENDED CONTEXT ALREADY DEFINED
.DUSR ERLAB=    ERCAD+1 ;UNREADABLE TAPE LABEL
.DUSR ERVOL=    ERLAB+1 ;INCORRECT LABELED TAPE VOLUME MOUNTED
.DUSR ERFSI=    ERVOL+1 ;INCORRECT LABELED TAPE FILE SET
.DUSR ERSEC=    ERFSI+1 ;INCORRECT LABELED TAPE FILE SECTION NUMBER
.DUSR ERGEN=    ERSEC+1 ;INCORRECT LABELED TAPE FILE GENERATION NUMBER
.DUSR ERVER=    ERGEN+1 ;INCORRECT LABELED TAPE FILE VERSION NUMBER
.DUSR ERNOA=    ERVER+1 ;NO OPERATOR AVAILABLE
.DUSR ERREV=    ERNOA+1 ;UNKNOWN LABELED TAPE LABEL REVISION
.DUSR ERCAI=    ERREV+1 ;EXTENDED CONTEXT ALREADY INITIALIZED
.DUSR ERCNI=    ERCAI+1 ;EXTENDED CONTEXT NOT INITIALIZED
.DUSR ERCND=    ERCNI+1 ;EXTENDED CONTEXT NOT DEFINED
.DUSR ERMRL=    ERCND+1 ;MEMORY RELEASE ERROR
.DUSR ERITP=    ERMRL+1 ;TRANSLATION (?READ/?WRITE) ERROR
.DUSR ERNAG=    ERITP+1 ;NO SUCH ARGUMENT - ?GTMES
.DUSR ERNCF=    ERNAG+1 ;NOT IN CLI FORMAT - ?GTMES
.DUSR ERBIF=    ERNCF+1 ;ILLEGAL BIAS FACTOR
.DUSR ERTLM=    ERBIF+1 ;CPU TIME LIMIT EXCEEDED
.DUSR ERSMX=    ERTLM+1 ;ERROR IN SETTING MAX CPU LIMIT
.DUSR ERNM4=    ERSMX+1 ;ELEMENT SIZE NOT A MULTIPLE OF 4
.DUSR ERWAK=    ERNM4+1 ;WACK RESPONSE RECEIVED (SYNC LINE)
.DUSR ERNAS=    ERWAK+1 ;PROCESS IS NOT A SERVER
.DUSR ERCDE=    ERNAS+1 ;CONNECTION DOESN'T EXIST
.DUSR ERCTF=    ERCDE+1 ;CONNECTION TABLE FULL
.DUSR ERDIU=    ERCTF+1 ;DIRECTORY IN USE- CANNOT DELETE
.DUSR ERSHG=    ERDIU+1 ;ATTEMPT TO GROW AGENT SHARED I/O FILE
.DUSR ERNIN=    ERSHG+1 ;ILLEGAL DIRECTORY SPECIFICATION
.DUSR ERNNA=    ERNIN+1 ;NETWORK NOT AVAILABLE
.DUSR ERHAE=    ERNNA+1 ;HOST ALREADY EXIST
.DUSR ERHID=    ERHAE+1 ;ILLEGAL HOST SPECIFICATION
.DUSR ERHNE=    ERHID+1 ;HOST DOES NOT EXIST
.DUSR ERCAH=    ERHNE+1 ;CAN'T RENAME HOST
.DUSR EREMB=    ERCAH+1 ;EMPTY MAILBOX ON ?RECNW
.DUSR ERRRR=    EREMB+1 ;REMOTE RESOURCE REFERENCE MADE
.DUSR ERCMH=    ERRRR+1 ;ATTEMPT TO CREATE MULTIPLE LOCAL HOST
.DUSR ERNAI=    ERCMH+1 ;NOT AWAITING ?IWKUP
.DUSR ERIRP=    ERNAI+1 ;ILLEGAL REMOTE ?PROC PARAMETER(S)
.DUSR ERIHN=    ERIRP+1 ;ILLEGAL HOST NAME
.DUSR ERNFC=    ERIHN+1 ;NOT PROPER FOR A VIRTUAL CIRCUIT
.DUSR ERWSZ=    ERNFC+1 ;HDLC - INVALID WINDOW SIZE
.DUSR ERFSZ=    ERWSZ+1 ;INVALID FRAME SIZE
.DUSR ERSDA=    ERFSZ+1 ;SEND ACTIVE
.DUSR ERCTY=    ERSDA+1 ;INVALID CALL TYPE
.DUSR ERDSC=    ERCTY+1 ;REMOTE IS DISCONNECTING
.DUSR ERRIE=    ERDSC+1 ;LOCAL RECEIVED INVALID RESPONSE
.DUSR ERRCE=    ERRIE+1 ;LOCAL RECEIVED CMDR
.DUSR ERCSE=    ERRCE+1 ;LOCAL IS IN "CAN'T SEND"
                        ;...CONDITION
.DUSR ERLDC=    ERCSE+1 ;LOCAL IS DISCONNECTING
.DUSR ERRES=    ERLDC+1 ;LOCAL WAS RESET
.DUSR ERBFO=    ERRES+1 ;BUFFER OVERFLOW
.DUSR ERRCA=    ERBFO+1 ;RECEIVE ACTIVE
.DUSR ERINF=    ERRCA+1 ;INITIALIZATION FAILED
.DUSR ERINC=    ERINF+1 ;LOCAL RECEIVED INVALID COMMAND
.DUSR ERNHL=    ERINC+1 ;NON-HDLC ENABLE ATTEMPTED
.DUSR ERKAD=    ERNHL+1 ;INTERRUPT WAIT TASK ALREADY DEFINED
.DUSR ERDSE=    ERKAD+1 ;MAP SLOT ERROR
.DUSR ERGBE=    ERDSE+1 ;GET BUFFER ERROR
.DUSR ERDIE=    ERGBE+1 ;SYNC DCU INOPERATIVE
.DUSR ERFOE=    ERDIE+1 ;ERROR OPENING SLDCU.PR
.DUSR ERFRE=    ERFOE+1 ;ERROR READING SLDCU.PR
.DUSR ERFCE=    ERFRE+1 ;ERROR CLOSING SLDCU.PR
.DUSR ERGME=    ERFCE+1 ;ERROR GETTING MEMORY
.DUSR ERUNK=    ERGME+1 ;UNKNOWN ERROR
.DUSR ERCBK=    ERUNK+1 ;CONNECTION HAS BEEN BROKEN
.DUSR ERNDC=    ERCBK+1 ;ATTEMPT HDLC CALL WITH NO DCU200
.DUSR ERCCS=    ERNDC+1 ;CANNOT CONNECT TO SELF
.DUSR ERVNC=    ERCCS+1 ;NO CONNECTION

;DENSITY SELECTION ERROR CODES.
.DUSR ERCDN=    ERVNC+1 ;CONTROLLER DOES NOT SUPPORT THIS DENSITY MODE.
.DUSR ERITD=    ERCDN+1 ;INDECIPHERABLE TAPE DENSITY.
.DUSR ERFTM=    ERITD+1 ;FILE/TAPE MISMATCH.

;MORE LABELLED TAPE ERROR CODES
.DUSR ERILL=    ERFTM+1 ;ILLEGAL LABELLED TAPE LEVEL
.DUSR ERILC=    ERILL+1 ;ILLEGAL LABELLED TAPE CHARACTER
.DUSR ERISQ=    ERILC+1 ;INCORRECT LABELLED TAPE SEQUENCE NUMBER
.DUSR ERIBC=    ERISQ+1 ;INCORRECT LABELLED TAPE BLOCK COUNT
.DUSR ERVTL=    ERIBC+1 ;VOLID TOO LONG OR NULL
.DUSR EROTL=    ERVTL+1 ;OWNER ID TOO LONG
.DUSR ERUTL=    EROTL+1 ;USER LABELS TOO LONG OR TOO MANY
.DUSR ERREB=    ERUTL+1 ;RECORD LENGTH EXCEEDS BLOCK LENGTH

;ARRAY PROCESSOR ERROR CODES
.DUSR ERAPB=    ERREB+1 ;AP ALREADY BUSY
.DUSR ERAPN=    ERAPB+1 ;AP DOES NOT EXIST
.DUSR ERAPL=    ERAPN+1 ;AP WCS IS NOT LOADED
.DUSR ERAPR=    ERAPL+1 ;ATTEMPT TO RELEASE A NON-AP PAGE
.DUSR ERAPP=    ERAPR+1 ;ATTEMPT TO RELEASE AN AP PAGE

;MORE LABELLED TAPE ERROR CODES
.DUSR EROOF=    ERAPP+1 ;ONLY ONE FILE ON ANSI1 TAPE
.DUSR ERCDU=    EROOF+1 ;CANNOT DELETE UNEXPIRED FILE

;MORE NON-LABELLED TAPE ERROR CODES
.DUSR ERNPC=    ERCDU+1 ;PROCESS CONSOLE DOES NOT EXIST
.DUSR ERHTT=    ERNPC+1 ;HISTOGRAM TARGET PROCESS TERMINATION
.DUSR ERHIP=    ERHTT+1 ;ERROR DETECTED WHILE HISTOGRAM IN PROGRESS
.DUSR ERIIP=    ERHIP+1 ;INVALID IPC MESSAGE
.DUSR ERMUS=    ERIIP+1 ;MULTIPLE USERS OF FILE, CAN'T TRUNCATE
.DUSR ERSHR=    ERMUS+1 ;SHARED FILE, CAN'T TRUNCATE
.DUSR ERTRC=    ERSHR+1 ;FILE BEING TRUNCATED; CANNOT OPEN
.DUSR ERFRM=    ERTRC+1 ;FRAMING ERROR
.DUSR ERIDI=    ERFRM+1 ;INTERNAL DIRECTORY INCONSISTENCY
.DUSR ERCOF=    ERIDI+1 ;COMMERCIAL FAULT
.DUSR ERFXF=    ERCOF+1 ;FIXED POINT FAULT
.DUSR ERFLF=    ERFXF+1 ;FLOATING POINT FAULT

.DUSR ER9TP=    ERFLF+1 ;INCLUDED FOR COMPATIBILITY WITH AOS
.DUSR ERTMR=    ER9TP+1
.DUSR ERNDS=    ERTMR+1 ;NO STATISTICS AVAILABLE FOR THIS DEVICE
.DUSR ERNUS=    ERNDS+1 ;NO STATISTICS AVAILABLE FOR THIS UNIT
.DUSR ERSEX=    ERNUS+1 ; EP SPACE EXCEEDED
.DUSR ERETL=    ERSEX+1 ; EP TOO LARGE
.DUSR EREVI=    ERETL+1 ; VERSION INCOMPATIBILITY
.DUSR EREDI=    EREVI+1 ; EDITREAD STATUS ERROR

.DUSR ERXSP=    EREDI+1 ;ILLEGAL EXEC STRING PARAMETER
.DUSR ERXII=    ERXSP+1 ;BAD INTERNAL EXEC IPC
.DUSR ERDUD=    ERXII+1 ;DEVICE CODE IS UNDEFINED
.DUSR ERTLK=    ERDUD+1 ;NO MATCHING ?TLOCK FOR THIS ?TUNLOCK
.DUSR ERNEK=    ERTLK+1 ;NOT ENOUGH OF THIS TYPE DISK IDENTIFIED TO VSGEN
.DUSR EROUC=    ERNEK+1 ;TASK HAS AN OUTSTANDING ?UIDCALL
.DUSR ERNUC=    EROUC+1 ;TASK HAS NOT BEEN ?UIDCALL'ED
.DUSR EROLF=    ERNUC+1 ; FILE HAS BAD FCB ADDRESS, NOT AVAILABLE UNTIL FIXUP
                        ; HAS BEEN RUN ON THIS LD
.DUSR ERRFX=    EROLF+1 ; LD WAS RELEASED, REQUIRES FIXUP
.DUSR ERBTC=    ERRFX+1 ;BAD TRANSFER COUNT FROM CONTROLLER
.DUSR ERIBR=    ERBTC+1 ;INVALID BAUD RATE FOR THIS DEVICE
.DUSR ERIOM=    ERIBR+1 ;ILLEGAL OPERATION FOR THIS MEDIA
.DUSR ERDNS=    ERIOM+1 ;DEVICE NOT SUPPORTED
.DUSR ERNBM=    ERDNS+1 ;NOT A BITMAP DEVICE
.DUSR ERCMC=    ERNBM+1 ;CONTROLLER MICROCODE NEEDS UPDATING
.DUSR ERILF=    ERCMC+1 ; ILLEGAL LABEL FORMAT
.DUSR ERBDK=    ERILF+1 ; BAD DISKETTE
.DUSR ERDAE=    ERBDK+1 ; OPERATOR ALREADY EXISTS
.DUSR ERDNE=    ERDAE+1 ; TASK IS NOT AN OPERATOR
.DUSR ERNRQ=    ERDNE+1 ; NO MATCHING OPERATOR REQUEST
.DUSR ERRVN=    ERNRQ+1 ;RESERVED VALUE NOT ZERO
.DUSR ERPVS=    ERRVN+1 ;PACKET VERSION NOT SUPPORTED
.DUSR ERCRR=    ERPVS+1 ;CAN'T RENAME THE ROOT
.DUSR ERCDR=    ERCRR+1 ;CAN'T DELETE THE ROOT
.DUSR ERIOD=    ERCDR+1 ;ILLEGAL OPEN OPTION FOR THIS DISK
.DUSR ERMNS=    ERIOD+1 ;MODIFIED SECTOR I/O NOT SUPPORTED BY THIS DEVICE
.DUSR ERCPO=    ERMNS+1 ;MODIFIED SECTOR I/O NOT SPECIFIED IN OPEN
.DUSR ERCPP=    ERCPO+1 ;MODIFIED SECTOR I/O REQUIRES PHYSICAL I/O
.DUSR ERINB=    ERCPP+1 ;INVALID NUMBER OF BLOCKS FOR MODIFIED SECTOR I/O
.DUSR ERNST=    ERINB+1 ;TAPE MOUNTED NOT SCRATCH TAPE
.DUSR ERFXR=    ERNST+1 ;DISK RELEASED, FIXUP RECOMMENDED ON IT
                        ;TO RECLAIM SPACE
.DUSR ERNSF=    ERFXR+1 ;NOT ALL SPACE FREED, FIXUP RECOMMENDED
                        ;ON THIS DISK
.DUSR ERXND=    ERNSF+1 ;OUTPUT NOT HELD BY XOFF - NO DATA TO OUTPUT
.DUSR ERXTC=    ERXND+1 ;OUTPUT NOT HELD BY XOFF - OUTPUT HELD BY CTS
.DUSR ERXNH=    ERXTC+1 ;OUTPUT NOT HELD BY XOFF
.DUSR ERIFD=    ERXNH+1 ;ILLEGAL FUNCTION FOR DEVICE
.DUSR ERPFD=    ERIFD+1 ;ERROR IN PROFILE FIELD DESCRIPTOR PACKET
.DUSR ERBTS=    ERPFD+1 ;DESTINATION FIELD TOO SMALL (READ)
.DUSR ERBTL=    ERBTS+1 ;SOURCE FIELD TOO LARGE (UPDATE)
.DUSR ERPAN=    ERBTL+1 ;PROFILE ACCESS HAS NOT BEEN INITIATED
.DUSR ERPAI=    ERPAN+1 ;PROFILE ACCESS ALREADY INITIATED
.DUSR EREDX=    ERPAI+1 ;PROFILE ENTRY NON-EXISTENT
.DUSR ERDRS=    EREDX+1 ;DEVICE RESERVED BY ANOTHER PORT
.DUSR ERPOO=    ERDRS+1 ;ILLEGAL PIPE OPEN OPTION
.DUSR ERIPS=    ERPOO+1 ;ILLEGAL PIPE SIZE
.DUSR ERPFL=    ERIPS+1 ;PIPE IS FULL
.DUSR ERMPQ=    ERPFL+1 ;TOO MANY REQUESTS ON PIPE
.DUSR ERCPA=    ERMPQ+1 ;C PROCESS TRIED TO PROC AN A
.DUSR ERRIP=    ERCPA+1 ;ILLEGAL RINGLOAD FROM B OR C TYPE PROCESS
.DUSR ERICH=    ERRIP+1 ;ILLEGAL CHAIN FROM B OR C TYPE PROCESS
.DUSR ERCCA=    ERICH+1 ;ILLEGAL CONNECTION ATTEMPT BETWEEN A & C TYPE PROCESS
.DUSR ERLCK=    ERCCA+1 ;LOCK ALREADY LOCKED - ?FLOCK
.DUSR ERNLK=    ERLCK+1 ;LOCK NOT LOCKED - ?FUNLOCK
.DUSR ERLLE=    ERNLK+1 ;LOCK LIMIT EXCEEDED
.DUSR ERLNG=    ERLLE+1 ;LOCK NOT GRANTED

.DUSR ERPKT=    ERLNG+1 ;ILLEGAL PACKET ID
.DUSR ERWNE=    ERPKT+1 ;WINDOW DOES NOT EXIST
.DUSR ERLDX=    ERWNE+1 ;LDU DOES NOT EXIST
.DUSR ERMSY=    ERLDX+1 ;MIRRORED LDU IS NOT SYNCHRONIZED
.DUSR ERLMM=    ERMSY+1 ;LDU NAME MISMATCH - NOT A VALID LDU MIRROR
.DUSR ERLSZ=    ERLMM+1 ;LDU SIZE MISMATCH - NOT A VALID LDU MIRROR
.DUSR ERRID=    ERLSZ+1 ;LDU IDS ARE NOT UNIQUE - NOT A VALID LDU MIRROR
.DUSR ERMOP=    ERRID+1 ;MIRRORED LDU IS OUT OF PHASE
.DUSR ERSFL=    ERMOP+1 ;MIRRORED LDU SYNCHRONIZATION FAILED
.DUSR ERNAM=    ERSFL+1 ;LDU IS NOT MIRRORED
.DUSR ERIML=    ERNAM+1 ;INCOMPLETE MIRRORED LDU SPECIFIED
.DUSR ERLFM=    ERIML+1 ;LDU FORMAT MISMATCH - NOT A VALID LDU MIRROR
.DUSR ERCNM=    ERLFM+1 ;CONTROLLER DOES NOT SUPPORT LDU MIRRORING
.DUSR ERTMM=    ERCNM+1 ;CONTROLLER CANNOT SUPPORT AN ADDITIONAL LDU MIRROR
.DUSR ERSIP=    ERTMM+1 ;CANNOT INIT AN LDU IMAGE THAT WAS PREVIOUSLY BEING SYNCED
.DUSR ERLDR=    ERSIP+1 ;LDU RELEASED DURING SYNCHRONIZATION
.DUSR EREMT=    ERLDR+1 ;MAX SIZE OF TRACE INFO ARAE IS EXCEEDED
.DUSR ERNTG=    EREMT+1 ;NO TEMPLATE GIVEN

;FOLLOWING ARE AOS/VS ONLY ERROR CODES
;THEY ARE IN A SEPARATE GROUP FROM THE AOS ERROR CODES
;THEY ARE IN GROUP 77, HENCE CODES ARE 77*1000+X

.DUSR ERXXX=    77*1000 ;FIRST CODE FOR AOS/VS
        ;HARDWARE POINTER VALIDATION ERRORS

.DUSR   ERVWP=  ERXXX   ;INVALID ADDRESS PASSED AS SYSTEM CALL ARGUMENT
.DUSR   ERVBP=  ERVWP+1 ;INVALID BYTE POINTER PASSED AS SYS CALL ARGUMENT
.DUSR   ERDPT=  ERVBP+1 ;DIFFERENT TYPE PROCESS(32/16 BIT) WITHOUT PRIVILEGE
.DUSR   ERRAL=  ERDPT+1 ;RING ALREADY LOADED
.DUSR   ERRNI=  ERRAL+1 ;RING NUMBER INVALID
.DUSR   ERRTB=  ERRNI+1 ;RING TOO BIG
.DUSR   ERWSM=  ERRTB+1 ;SET WKG SET MIN, NOT PRIVILEGED
.DUSR   ERTNE=  ERWSM+1 ;PMGR- TRACING NOT ENABLED
.DUSR   ERTAE=  ERTNE+1 ;PMGR- TRACING ALREADY ENABLED
.DUSR   ERNUF=  ERTAE+1 ;PMGR- TRACING FILE NOT A USER DATA FILE
.DUSR   ERRNA=  ERNUF+1 ;PMGR- REQUESTOR NOT TRACING AUTHORIZED
.DUSR   ERPNL=  ERRNA+1 ;PMGR- PATHNAME LENGTH AREA
.DUSR   ERSNF=  ERPNL+1 ;SYMBOL NOT FOUND IN .ST FILE
.DUSR   ERSNR=  ERSNF+1 ;SOURCE NOT RESIDENT ON ?LMAP
.DUSR   ERDNR=  ERSNR+1 ;DESTINATION NOT RESIDENT ON ?LMAP
.DUSR   ERIBP=  ERDNR+1 ;BKPT SEEN IN USER PROGRAM WHEN DEBUG NOT INIT'ED
.DUSR   ERBST=  ERIBP+1 ;BAD SYMBOL TABLE FORMAT SEEN (?GTNA CALL)
.DUSR   ERPDO=  ERBST+1 ;PAGE FILE DIRECTORY OVERFLOW
.DUSR   ERMWT=  ERPDO+1 ;MORE THAN ONE WS TRACE DEFINED ON TARGET
.DUSR   ERHWT=  ERMWT+1 ;BOTH TRACE AND HISTOGRAM CALLED, OR > 1 TRACE
.DUSR   ERDTC=  ERHWT+1 ;DIFFERENT TYPE CHAIN
.DUSR   ERWST=  ERDTC+1 ;NO WS TRACE DEFINED ON THIS TARGET
.DUSR   ERWSS=  ERWST+1 ;INVALID WKG SET MAX/MIN
.DUSR   ERWSB=  ERWSS+1 ;INVALID WORKING SET TRACE BUFFER
.DUSR   ERWSF=  ERWSB+1 ;WORKING SET NOT SWAPPABLE
.DUSR   ERAWM=  ERWSF+1 ;TRYING TO WIRE MORE PAGES THAN WS MAX
.DUSR   ERTPW=  ERAWM+1 ;TOO MANY PAGES WIRED
.DUSR   ERACC=  ERTPW+1 ;ACCESS DENIED ON ?VALAD
.DUSR   ERRNL=  ERACC+1 ;RING NOT LOADED
.DUSR   ERTAL=  ERRNL+1 ;TOO MANY ARGUMENTS ON LCALL
.DUSR   ERXBL=  ERTAL+1 ;?IXIT FROM BASE LEVEL
.DUSR   ERPPR=  ERXBL+1 ;PMGR PANIC REQUESTED BY NON-PMGR PROCESS
.DUSR   ERSCI=  ERPPR+1 ;SYSTEM CALL AT INTERRUPT LEVEL
.DUSR   ERNIP=  ERSCI+1 ;PMGR -- NOT AN IAC PMGR
.DUSR   ERNID=  ERNIP+1 ;PMGR -- NOT AN IAC-DRIVEN DEVICE
.DUSR   ERSGO=  ERNID+1 ;?SIGNL ALREADY OUTSTANDING
.DUSR   ERUFR=  ERSGO+1 ;UNKNOWN REQUEST FUNCTION
.DUSR   ERIFS=  ERUFR+1 ;ILLEGAL FED STRING
.DUSR   ERA1O=  ERIFS+1 ;ATTEMPT TO 1ST OPEN AN OPEN FILE
.DUSR   ERIFI=  ERA1O+1 ;INVALID PROTECTED FILE ID
.DUSR   ERAPU=  ERIFI+1 ;ATTEMPT TO PASS UNHELD ACCESS PRIVILEGES
.DUSR   ERNBK=  ERAPU+1 ;NO BREAKFILE ENABLED FOR THIS RING
.DUSR   ERCDS=  ERNBK+1 ;PMGR: MODEM DISCONNECT IN PROGRESS - CAN'T OPEN
.DUSR   ERTNF=  ERCDS+1 ;TASK IS NOT FAULTING
.DUSR   ERNMT=  ERTNF+1 ;MAP TARGET DOES NOT EXIST
.DUSR   ERMTE=  ERNMT+1 ;MAP TARGET (ALREADY) MAPPED ELSEWHERE
.DUSR   ERMSI=  ERMTE+1 ;MAP SPECIFICATION ILLEGAL FOR TARGET
.DUSR   ERRAU=  ERMSI+1 ;MAP REGION ALREADY IN USE
.DUSR   ERJAI=  ERRAU+1 ;JP ALREADY INITIALIZED
.DUSR   ERJNI=  ERJAI+1 ;JP NOT INITIALIZED
.DUSR   ERLNE=  ERJNI+1 ;LP DOES NOT EXIST
.DUSR   ERLAI=  ERLNE+1 ;LP ALREADY EXISTS
.DUSR   ERLJP=  ERLAI+1 ;ATTEMPT TO RELEASE LAST JP ATTACHED TO AN LP
.DUSR   ERIJP=  ERLJP+1 ;INVALID JPID
.DUSR   ERILP=  ERIJP+1 ;INVALID LPID
.DUSR   ERJST=  ERILP+1 ;JP RUNNING ONE OR MORE SYSTEM TASKS
.DUSR   ERJAA=  ERJST+1 ;JP ALREADY ATTACHED TO LP
.DUSR   ERJNA=  ERJAA+1 ;JP NOT ATTACHED TO LP
.DUSR   ERMLP=  ERJNA+1 ;ATTEMPT TO EXCEED MAXIMUM LP COUNT
.DUSR   ERJPA=  ERMLP+1 ;CANNOT DELETE LP WITH JP ATTACHED
.DUSR   ERITI=  ERJPA+1 ;INVALID TIME INTERVAL
.DUSR   ERICI=  ERITI+1 ;INVALID CLASS ID
.DUSR   ERCPC=  ERICI+1 ;INVALID CLASS PERCENTAGE
.DUSR   ERIHL=  ERCPC+1 ;INVALID HIERARCHICAL LEVEL
.DUSR   ERCLU=  ERIHL+1 ;CLASS IN USE
.DUSR   ERIMP=  ERCLU+1 ;ILLEGAL BIT MAP
.DUSR   ERILV=  ERIMP+1 ;ILLEGAL LOCALITY VALUE
.DUSR   ERLP0=  ERILV+1 ;CANNOT DELETE LP 0
.DUSR   ERNMP=  ERLP0+1 ;NOT A MULTI-PROCESSOR SYSTEM
.DUSR   ERCNE=  ERNMP+1 ;CLASS DOES NOT EXIST
.DUSR   ERHLP=  ERCNE+1 ;ILLEGAL HIERARCHY LEVEL / PERCENTAGE PAIR
.DUSR   ERICD=  ERHLP+1 ;ILLEGAL FUNCTION CODE
.DUSR   ERJPS=  ERICD+1 ;JP IS IN A BAD STATE
.DUSR   ERCMM=  ERJPS+1 ;MICROCODE IS INCOMPATIBLE WITH CURRENT SYSTEM
.DUSR   ERMCR=  ERCMM+1 ;INCORRECT MICROCODE REVISION
.DUSR   ERMFF=  ERMCR+1 ;MICROCODE FILE FORMAT ERROR
.DUSR   ERUCP=  ERMFF+1 ;INVALID CPU MODEL NUMBER
.DUSR   ERCSO=  ERUCP+1 ;CLASS SCHEDULING IS ENABLED
.DUSR   ERHLT=  ERCSO+1 ;NON-SEQUENTIAL HIERARCHY LEVELS DESIGNATED
.DUSR   ERPOR=  ERHLT+1 ;PID IS OUT OF RANGE FOR THIS PROCESS
.DUSR   ERPNO=  ERPOR+1 ;PROCESS NOT AN OPERATOR
.DUSR   ERBCE=  ERPNO+1 ;MAX BLOCK COUNT EXCEEDED
.DUSR   ERDEB=  ERBCE+1 ;DAEMON ERROR IN ERROR BUFFER
.DUSR   ERDRF=  ERDEB+1 ;DAEMON RESOURCE FAILURE
.DUSR   ERLAS=  ERDRF+1 ;LOG ALREADY STARTED
.DUSR   ERCL0=  ERLAS+1 ;CANNOT DELETE CLASS 0
.DUSR   ERPVM=  ERCL0+1 ;UNKNOWN PRIVILEGE MODE
.DUSR   ERPVX=  ERPVM+1 ;PRIVILEGE HELD EXCLUSIVELY BY OTHER PROCESS
.DUSR   ERPVO=  ERPVX+1 ;PRIVILEGE CANNOT BE HELD EXCLUSIVELY
.DUSR   ERPVP=  ERPVO+1 ;OTHER PROCESSES USING PRIVILEGE
.DUSR   ERWCP=  ERPVP+1 ;WORKING SET CHANGE ONLY PARTLY DONE
.DUSR   ERFRD=  ERWCP+1 ;FAULT RECURSION DEPTH EXCEEDED
.DUSR   ERALP=  ERFRD+1 ;PROCESS'S CLASS NOT SCHEDULABLE ON AN ACTIVE LP
.DUSR   ERCLL=  ERALP+1 ;INVALID CELL COUNT
.DUSR   ERNML=  ERCLL+1 ;NO MICROCODE LOADED IN THIS JP
.DUSR   EREGN=  ERNML+1 ;END OF GET NEXT SEQUENCE
.DUSR   ERCTD=  EREGN+1 ;CORRUPTED TASK CONTROL BLOCK DATA DETECTED

.DUSR   ERIWR=  ERCTD+1 ;INVALID WINDOW REFERENCE.
.DUSR   ERWNN=  ERIWR+1 ;MAXIMUM NUMBER OF WINDOWS EXCEEDED.
.DUSR   ERWMD=  ERWNN+1 ;WINDOW MARKED FOR DELETION.
.DUSR   ERIGP=  ERWMD+1 ;INVALID GRAPHICS PARAMETER.
.DUSR   ERIPP=  ERIGP+1 ;INVALID POINTER DEVICE PARAMETER.
.DUSR   ERIVS=  ERIPP+1 ;INVALID VIEW OR SCAN PORT.
.DUSR   ERIWO=  ERIVS+1 ;INVALID WINDOWING OPERATION.
.DUSR   ERIWP=  ERIWO+1 ;INVALID WINDOWING PARAMETER.
.DUSR   ERADE=  ERIWP+1 ;ASSOCIATION DOES NOT EXIST.

;The following errors are software versions of those returned by the
;the hardware (in AC1) if multiprocessor control instructions do not
;skip.  77201-77237 should be reserved for these hardware derived codes.

.DUSR   ERPNS= 77201    ;JP NOT STOPPED
.DUSR   ERNEX= 77202    ;NON-EXISTENT JP
.DUSR   ERLCS= 77203    ;LCS ERROR
.DUSR   ERFAI= 77204    ;JP FAILED
.DUSR   ERNSB= 77205    ;NO JP STATE BLOCK DEFINED
.DUSR   ERHOP= 77206    ;ILLEGAL OPTION REQUESTED
.DUSR   ERNRU= 77207    ;JP NOT RUNNING

.DUSR   ERSHC=  77240   ;PERFORMING UNSHARED OPERATION ON SHARED CHANNEL
.DUSR   ERUSH=  ERSHC+1 ;PERFORMING SHARED OPERATION ON UNSHARED CHANNEL

; KFS (KERNEL/FILE SYSTEM INTERFACE) SPECIFIC ERROR CODES

.DUSR   ERFID=  ERUSH+1 ;INVALID FILE ID (FID)
.DUSR   ERFSA=  ERFID+1 ;INVALID FS_AREA ADDRESS
.DUSR   ERKFS=  ERFSA+1 ;INVALID KFS PACKET REVISION
.DUSR   ERCID=  ERKFS+1 ;INVALID CHANNEL ID (CID)
.DUSR   ERMLD=  ERCID+1 ;MULTIPLE LDU'S IN ONE PHYSICAL DISK

.DUSR   ERDMO=  ERMLD+1 ;DISK MARKED AS OWNED BY ANOTHER SYSTEM



; SYSTEM CONSTANTS

; SYSTEM IMPLEMENTATION NUMBERS

.DUSR   ?SAOS=  1       ; AOS SYSTEM
.DUSR   ?SAVS=  2       ; AOS/VS SYSTEM
.DUSR   ?SMPS=  3       ; MP/OS SYSTEM
.DUSR   ?SR32=  4       ; RT/32 SYSTEM
.DUSR   ?SDVS=  5       ; AOS/DVS SYSTEM

.DUSR   ?SIN=   ?SAVS   ; THIS IS AOS/VS
                        ; 6-7 RESERVED

.DUSR   ?LHLT=  226     ;LENGTH OF LOGGING HEADER RECORD
.DUSR   ?LDLT=  20      ;LENGTH OF DETAIL RECORD
.DUSR   ?L32B=  0       ;32 BIT USER FLAG
.DUSR   ?L16B=  1       ;16 BIT USER FLAG

.DUSR   ?DFLL=  136.    ; DEFAULT MAXIMUM LINE LENGTH
.DUSR   ?MXPL=  256.    ; MAX PATHNAME LENGTH (BYTES)
.DUSR   ?MXPN=  16.     ; MAX SIMPLE PROCESS NAME LENGTH (BYTES)
.DUSR   ?MXUN=  16.     ; MAX USERNAME LENGTH (BYTES)
.DUSR   ?MXHN=  32.     ;RESERVED
                        ;
                        ;
.DUSR   ?MXFP=  ?MXHN+?MXUN+?MXPN  ; MAX FULL PROCESS NAME
.DUSR   ?MXFN=  32.     ; MAX FILENAME LENGTH (BYTES)
.DUSR   ?MXACL= 256.    ; MAX ACL LENGTH (BYTES)
                        ; ALL OF THE ABOVE INCLUDE THE
                        ; TRAILING NULL BYTE

.DUSR   ?LOWPID= 255.   ; HIGHEST AOS/VS LEGAL LOW PID
.DUSR   ?HIPID= 4095.   ; HIGHEST AOS/VS LEGAL PID
.DUSR   ?MXPID= 64.     ; HIGHEST LEGAL AOS PID(NOT USED FOR AOS/VS)
.DUSR   ?VSPIDS= 255.   ; HIGHEST AOS/VS LEGAL PID (FOR INFOS USE)
.DUSR   ?MXIPC= 1024.   ; MAX INTERHOST IPC LENGTH
.DUSR   ?MXIO=  1024.   ; MAX INTERHOST I/O XFER LENGTH
.DUSR   ?MXPSL= 8.      ; MAX # PATHNAMES IN A SEARCHLIST
.DUSR   ?HIDSC= -9.     ; RESERVED
.DUSR   ?HMSK=  177000  ; RESERVED

; ENTRY TYPE RANGES

.DUSR   ?SMIN=  0.      ; SYSTEM MINIMUM
.DUSR   ?SMAX=  63.     ; SYSTEM MAXIMUM

.DUSR   ?DMIN=  ?SMAX+1 ; DGC MINIMUM
.DUSR   ?DMAX=  127.    ; DGC MAXIMUM

.DUSR   ?UMIN=  ?DMAX+1 ; USER MINIMUM
.DUSR   ?UMAX=  255.    ; USER MAXIMUM


.DUSR   ?USP=   16      ; UNIQUE STORAGE POSITION



; SYSTEM ENTRY TYPES

; MISC

.DUSR   ?FLNK=  ?SMIN   ; LINK
.DUSR   ?FSDF=  ?FLNK+1 ; SYSTEM DATA FILE
.DUSR   ?FMTF=  ?FSDF+1 ; MAG TAPE FILE
.DUSR   ?FGFN=  ?FMTF+1 ; GENERIC FILE NAME

; DIRECTORIES (DO NOT CHANGE THEIR ORDER)

.DUSR   ?FDIR=  10.     ; DISK DIRECTORY
.DUSR   ?FLDU=  ?FDIR+1 ; LD ROOT DIRECTORY
.DUSR   ?FCPD=  ?FLDU+1 ; CONTROL POINT DIRECTORY
.DUSR   ?FMTV=  ?FCPD+1 ; MAG TAPE VOLUME
.DUSR   ?FMDR=  ?FMTV+1 ; RESERVED FOR RT32(MEM DIRS), NOT LEGAL FOR AOS
.DUSR   ?FGNR=  ?FMDR+1 ; RESERVED FOR RT32, NOT LEGAL FOR AOS

.DUSR   ?LDIR=  ?FDIR   ; LOW DIR TYPE
.DUSR   ?HDIR=  ?FGNR   ; HIGH DIR TYPE

.DUSR   ?LCPD=  ?FLDU   ; LOW CONTROL POINT DIR TYPE
.DUSR   ?HCPD=  ?FCPD   ; HIGH CONTROL POINT DIR TYPE

; UNITS

.DUSR   ?FDKU=  20.     ; DISK UNIT
.DUSR   ?FMCU=  ?FDKU+1 ; MULTIPROCESSOR COMMUNICATIONS UNIT
.DUSR   ?FMTU=  ?FMCU+1 ; MAG TAPE UNIT
.DUSR   ?FLPU=  ?FMTU+1 ; DATA CHANNEL LINE PRINTER
.DUSR   ?FLPD=  ?FLPU+1 ; DATA CHANNEL LP2 UNIT
.DUSR   ?FLPE=  ?FLPD+1 ; DATA CHANNEL LASER PRINTER
.DUSR   ?FPGN=  ?FLPE+1 ; RESERVED FOR RT32(PROCESS GROUPS)

.DUSR   ?FLTU=  ?FLPU+1 ; LABELLED MAG TAPE UNIT
                        ; ***** NO LONGER USED *****

.DUSR   ?LUNT=  ?FDKU   ; LOW UNIT TYPE
.DUSR   ?HUNT=  ?FPGN   ; HIGH UNIT TYPE

; IPC ENTRY TYPES

.DUSR   ?FIPC=  30.     ; IPC PORT ENTRY

.DUSR   ?FSPR=  ?FIPC+2 ; SPOOLABLE PERIPHERAL
.DUSR   ?FQUE=  ?FSPR+1 ; EXEC'S QUEUES
.DUSR   ?FGLT=  ?FQUE+1 ; LABELED TAPE
.DUSR   ?FGLM=  ?FGLT+1 ; LABELED MEDIA

.DUSR   ?FPLO=  ?FQUE+3 ;LOW RANGE OF PERIPHERAL TYPES
.DUSR   ?FPIL=  ?FPLO   ;  LOW RANGE OF INPUT ONLY TYPES
.DUSR   ?FTRA=  ?FPIL   ;    TAPE READER
.DUSR   ?FCRA=  ?FTRA+1 ;    CARD READER
.DUSR   ?FPIH=  ?FCRA+4 ;  HIGH RANGE OF INPUT ONLY TYPES
.DUSR   ?FPOL=  ?FPIH+1 ;  LOW RANGE OF OUTPUT ONLY TYPES
.DUSR   ?FTPA=  ?FPOL   ;    TAPE PUNCH
.DUSR   ?FPLA=  ?FTPA+1 ;    DIGITAL PLOTTER
.DUSR   ?FLPA=  ?FPLA+1 ;    PIO LINE PRINTER
.DUSR   ?FLPC=  ?FLPA+1 ;    LP2 LINE PRINTER(PLOTTER)
.DUSR   ?FPOH=  ?FLPC+3 ;  HIGH RANGE OF OUTPUT ONLY TYPES
.DUSR   ?FCON=  ?FPOH+1 ;  CONSOLE (HARDCOPY OR CRT)
.DUSR   ?FPHI=  ?FCON+1 ;HIGH RANGE OF PERIPHERAL TYPES

.DUSR   ?LIPC=  ?FIPC   ; LOW IPC TYPE
.DUSR   ?HIPC=  ?FPHI   ; HIGH IPC TYPE

;
.DUSR   ?FNLO=  ?HIPC+1 ; LOW NETWORK FILE TYPE ENTRY
.DUSR   ?FREM=  ?FNLO   ;  REMOTE HOST - REMA ACCESS
.DUSR   ?FHST=  ?FREM+1 ;  REMOTE HOST - X25 SVC ACCESS
.DUSR   ?FNPN=  ?FHST+1 ;  NETWORK PROCESS NAME
.DUSR   ?FPVC=  ?FNPN+1 ;  REMOTE HOST - X25 PVC ACCESS
.DUSR   ?FNHI=  ?FPVC+1 ; HIGH NETWORK FILE TYPE ENTRY

; SYNC LINE FILES TYPE
.DUSR   ?FSYN=  60.     ; SYNC LINE


; DGC ENTRY TYPES

.DUSR   ?FUDF=  ?DMIN   ; USER DATA FILE
.DUSR   ?FPRG=  ?FUDF+1 ; PROGRAM FILE
.DUSR   ?FUPF=  ?FPRG+1 ; USER PROFILE FILE
.DUSR   ?FSTF=  ?FUPF+1 ; SYMBOL TABLE FILE
.DUSR   ?FTXT=  ?FSTF+1 ; TEXT FILE
.DUSR   ?FLOG=  ?FTXT+1 ; SYSTEM LOG FILE (ACCOUNTING FILE)
.DUSR   ?FNCC=  ?FLOG+1 ; FORTRAN CARRIAGE CONTROL FILE
.DUSR   ?FLCC=  ?FNCC+1 ; FORTRAN CARRIAGE CONTROL FILE
.DUSR   ?FFCC=  ?FLCC+1 ; FORTRAN CARRIAGE CONTROL FILE
.DUSR   ?FOCC=  ?FFCC+1 ; FORTRAN CARRIAGE CONTROL FILE
.DUSR   ?FPRV=  ?FOCC+1 ; AOS/VS PROGRAM FILE
.DUSR   ?FWRD=  ?FPRV+1 ; WORD PROCESSING
.DUSR   ?FAFI=  ?FWRD+1 ; APL FILE
.DUSR   ?FAWS=  ?FAFI+1 ; APL WORKSPACE FILE
.DUSR   ?FBCI=  ?FAWS+1 ; BASIC CORE IMAGE FILE
.DUSR   ?FDCF=  ?FBCI+1 ; DEVICE CONFIGURATION FILE (NETWORKING)
.DUSR   ?FLCF=  ?FDCF+1 ; LINK CONFIGURATION FILE (NETWORKING)
.DUSR   ?FLUG=  ?FLCF+1 ; LOGICAL UNIT GROUP FILE (SNA)
.DUSR   ?FRTL=  ?FLUG+1 ; AOS/RT32 RESERVED FILE TYPE RANGE (LO)
.DUSR   ?FRTH=  ?FRTL+4 ; AOS/RT32 RESERVED FILE TYPE RANGE (HI)
.DUSR   ?FUNX=  ?FRTH+1 ; VS/UNIX FILE
.DUSR   ?FBBS=  ?FUNX+1 ; BUSINESS BASIC SYMBOL FILE
.DUSR   ?FVLF=  ?FBBS+1 ; BUSINESS BASIC VOLUME LABEL FILE
.DUSR   ?FDBF=  ?FVLF+1 ; BUSINESS BASIC DATA BASE FILE

; CEO FILE TYPES

.DUSR   ?FGKM=  ?FDBF+1 ; DG GRAPHICS KERNAL METAFILE
.DUSR   ?FVDM=  ?FGKM+1 ; VIRTUAL DEVICE METAFILE
.DUSR   ?FNAP=  ?FVDM+1 ; NAPLPS STANDARD GRAPH FILE
.DUSR   ?FTRV=  ?FNAP+1 ; TRENDVIEW COMMAND FILE
.DUSR   ?FSPD=  ?FTRV+1 ; SPREADSHEET FILE
.DUSR   ?FQRY=  ?FSPD+1 ; PRESENT QUERY MACRO
.DUSR   ?FDTB=  ?FQRY+1 ; PHD DATA TABLE
.DUSR   ?FFMT=  ?FDTB+1 ; PHD FORMAT FILE
.DUSR   ?FWPT=  ?FFMT+1 ; TEXT INTERCHANGE FORMAT
.DUSR   ?FDIF=  ?FWPT+1 ; DATA INTERCHANGE FORMAT
