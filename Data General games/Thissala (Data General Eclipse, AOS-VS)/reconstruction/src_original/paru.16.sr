.DUSR   ?ZCPZ   = 471           ;  CPL Function
.DUSR   ?ZCPX   = (?ZCP*400)+0  ;  Low pkt id
.DUSR   ?ZDFZ   = 471           ;  DEFAULTFORMS Function
