        ;==================================;
        ; AOS/VS - SYSTEM CALL DEFINITIONS  ;
        ;==================================;

        .TITL   SYSID.32
        .ENABLE DWORD                   ;32. BIT CONSTRUCTS

.DUSR   LOSYSCALL = 0
.DUSR   HISYSCALL = 614




        .MACRO  ?SYST
**      .PUSH   .NOMAC
**      .NOMAC  ?XCALL
        .PUSH   .RDX            ;RADIX PROTECTION FOR SYSTEM CALLS
        .RDX    8
        XJSR    @6              ;REPLACES OLD JSR @17
        .RDX    .POP
**      .NOMAC  .POP
%



;
; SYSTEM CALL DEFINITION MACROS
; IF A SYSTEM CALL HAS A PACKET WHICH MAY BE SPECIFIED AS AN ARGUMENT
; TO THE CALL, USE ?SCL2. THIS WILL MOVE THE ARGUMENT TO AC2 IF NECESSARY.
; IF THERE CAN BE NO ARGUMENT TO THE CALL, USE ?SCL1.
;

        .MACRO  ?SCL1
        ?=^2                    ;FOR PLN PARAMETERS
        .MACRO  ^1              ;DEFINE A SYSTEM CALL MACRO
**      .PUSH   .NOMAC
**      .NOMAC  ?XCALL
        .PUSH   .RDX            ;RADIX PROTECTION FOR SYSTEM CALLS
        .RDX    8
        ?SYST
        .WORD ^2
        .RDX    .POP
**      .NOMAC  .POP
_%
%
        .MACRO  ?SCL2
        ?=^2                    ;FOR PLN PARAMETERS
        .MACRO  ^1
**      .PUSH   .NOLOC
        .NOLOC  1
        .PUSH   .NOMAC
        .NOMAC  ?XCALL
        .DO     .ARGCT==1       ;ARG SPECIFIED?
        LLEF    2,_^1
        .ENDC
        .PUSH   .RDX            ;RADIX PROTECTION FOR SYSTEM CALLS
        .RDX    8
        ?SYST
        .WORD ^2
        .RDX    .POP
        .NOMAC  .POP
**      .NOLOC  .POP
_%
%



; SUPPRESS EXPANSION OF DEFINITION MACROS

        .PUSH   .NOMAC
        .NOMAC  1

; DEFAULT TO SUPPRESS EXPANSION OF CALL MACROS

.DUSR   ?XCALL= 1
;
; SYSTEM CALLS
;
;When you add a new system call, you must delcare a 4-letter unique
; version as well.  (i.e. ?CREATE and ?CREA)
;
;All new system calls require a "?." symbol and a 4-letter unique "?."
;symbol. (i.e. ?.CREATE and ?.CREA)
;
;If the system call is a kernal call, then a "?0" symbol and a 4-letter
; unique "?0" symbol must be declared as well.
; (i.e. ?0SYSPRV and ?0SYSP)




.ENABLE WORD                    ;16. BIT QUANTITIES

