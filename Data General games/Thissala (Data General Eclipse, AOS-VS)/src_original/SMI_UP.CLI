[!EQUAL,([!UNE,2,[!PID]]ERROR[!END]%/%%-%),()]
  SEARCHLIST :<,UTIL>
  SUPERUSER ON
  [!NEQUAL,[!PATH :UTIL:UP_DGVIEW.CLI],]
     :UTIL:UP_DGVIEW
  [!END]
  [!EQUAL,1,1]
    COMMENT CREATE A TRACE LOG IN CASE OF PROBLEMS
    DELETE/2=IGNORE :UP.LOG.BU
    RENAME/2=IGNORE UP.LOG<,.BU>
    LOGFILE :UP.LOG
    TRACE/COMMAND/MACRO/LOG
    WRITE [!DATE] [!TIME]
  [!END]
  PUSH
  [!EQUAL,[!PATHNAME @LPT],]
    CONTROL @EXEC CREATE PRINT LPT
    CONTROL @EXEC OPEN LPT
    CONTROL @EXEC OPEN BATCH_INPUT
    CONTROL @EXEC OPEN BATCH_OUTPUT
    CONTROL @EXEC OPEN BATCH_LIST
  [!END]
  [!NEQUAL,[!PATHNAME :UP_DPRINTER.CLI],]
    :UP_DPRINTER
  [!END]
  [!NEQUAL,[!PATHNAME :UP_PPRINTERS.CLI],]
    :UP_PPRINTERS
  [!END]
  [!NEQUAL,[!PATHNAME :UP_LINES.CLI],]
    :UP_LINES
  [!END]
  COMMENT INITIALIZE THE SECOND DISK
  [!EQUAL,1,2]
    INITIALIZE/S/1=IGNORE @DPJ1
    [!EQUAL,[!STRING],]
      COMMENT INIT FAILED
      DELETE/2=IGNORE :FIXUP.LOG :FIXUP.IN :FIXUP.OUT
      CREATE  :FIXUP.(IN OUT)
      PROCESS/DEFAULT/BLOCK/STRING/INPUT=:FIXUP.IN/OUTPUT=:FIXUP.OUT FIXUP/SCRIPT=DPJ1_FIXUP_SCRIPT
      DELETE/2=IGNORE :FIXUP.IN :FIXUP.OUT
      [!EQUAL,[!STRING],]
        INITIALIZE/S @DPJ1
        [!EQUAL,[!STRING],]
          COMMENT FAILED AGAIN
          WRITE CANNOT INITIALIZE @DPJ1
        [!END]
      [!ELSE]
        COMMENT FIXUP ABORTED
        WRITE CANNOT FIXUP @DPJ1
      [!END]
    [!END]
    COMMENT @DPJ1 INITIALIZED
  [!END]
  [!NEQUAL,[!PATHNAME :UP.NETWORK.CLI],]
    :UP.NETWORK
  [!ELSE]
    [!NEQUAL,[!PATHNAME :NET:UTIL:UP.NETWORK.CLI],]
      :NET:UTIL:UP.NETWORK
    [!END]
  [!END]
  [!NEQUAL,[!PATHNAME :INFOS:INFOS_UP.CLI],]
    :INFOS:INFOS_UP
  [!END]
[!nequal,[!pathname :util:up_teo.cli],]
	:util:up_teo
[!end]
  [!NEQUAL,[!PATHNAME :UTIL:CEO_DIR:UP.CEO.CLI],]
    :UTIL:CEO_DIR:UP.CEO
  [!ELSE]
    [!NEQUAL,[!PATHNAME :UTIL:UP_POA.CLI],]
      :UTIL:UP_POA
    [!END]
  [!END]
  PRIORITY  2  1
  ACL/2=IGNORE @DPJ10 +,WARE
  ACL/2=IGNORE @MT- +,WARE
  CONTROL @EXEC CONTINUE 1
  CONTROL @EXEC SILENCE @CONSOLE
  CONTROL/L=@NULL @EXEC ENABLE/ALL
  POP
  TRACE/K
  SUPERUSER OFF
[!ELSE]
  WRITE *ERROR*
  WRITE %0\% IS VALID WHEN INVOKED BY THE ROOT CLI
  WRITE REQUIRED ARGUMENTS: NONE
  WRITE OPTIONAL SWITCHES:,,NONE
[!END]
