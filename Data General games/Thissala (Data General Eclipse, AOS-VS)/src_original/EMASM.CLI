[!equal,%2%,]
   delete/2=ignore =%1\%.<ob ls er>
   xeq/s masm/o=%1\%.ob/l==%1\%.ls/e==%1\%.er%/% ermes/pass1 %1\%
   [!nequal,([!string]),()]
      string ** Error on %0-%. Error is: [!string] **
      write [!string]
      type %1\%.er
   [!else]
      delete/2=ignore %1\%.er
   [!end]
[!else]
   [!equal,%3%,]
      delete/2=ignore =%2\%.<ob ls er>
      xeq/s masm/o=%2\%.ob/l==%2\%.ls/e==%2\%.er%/% ermes/pass1 %1\%/pass1 %2\%
      [!nequal,([!string]),()]
         string ** Error on %0-%. Error is: [!string] **
         write [!string]
         type %2\%.er
      [!else]
         delete/2=ignore %2\%.er
      [!end]
   [!else]
      delete/2=ignore =%3\%.<ob ls er>
      xeq/s masm/o=%3\%.ob/l==%3\%.ls/e==%3\%.er%/% ermes/pass1 %1\%/pass1 %2\%/pass1 %3\%
      [!nequal,([!string]),()]
         string ** Error on %0-%. Error is: [!string] **
         write [!string]
         type %3\%.er
      [!else]
         delete/2=ignore %3\%.er
      [!end]
   [!end]
[!end]

