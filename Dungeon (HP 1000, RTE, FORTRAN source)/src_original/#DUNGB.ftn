     3 'SHI','T',97,'HUN','K',97,'BAL','LOO',98,113,
     4 'REC','EPT',99,'WIR','E',101,110,
     5 'HOO','K',102,103,'ZOR','KMI',104,'COI','N',104,
     6 'SAF','E',105,'CAR','D',106,'NOT','E',106,
     7 'SLO','T',107,'CRO','WN',108,'BRI','CK',109,
     8 'FUS','E',110,'GNO','ME',111,
     1 'STA','MP',118,
     2 'TOM','B',119,'CRY','PT',119,'GRA','VE',119,'HEA','DS',120,
     3 'POL','ES',120,'IMP','LEM',120/
C
        DATA OVOK6/'LOS','ERS',120,'COK','ES',121,
     1 'LIS','TIN',122,'STA','CK',122,
     2 'PRI','NTO',122,
     3 'SPH','ERE',126,'BAL','L',126,
     4 'ETC','HIN',130,131,
     5 'WAL','LS',150,130,131,'WAL','L',150,130,131,
     6 'FLA','SK',132,'POO','L',133,'SEW','AGE',133,
     7 'TIN',0,134,'SAF','FRO',134,'SPI','CES',134,'TAB','LE',135,
     8 'POS','T',136,'POS','TS',136,'BUC','KET',137,
     9 'CAK','E',138,139,140,141,'ICI','NG',139,140,141,
     1 'ROB','OT',142,'ROB','BY',142,
     2 'C3P','O',142,'R2D','2',142,
     3 'IT',0,144,'THA','T',144,'THI','S',144/
C
        DATA OVOK7/'ME',0,145,'MYS','ELF',145,'CRE','TIN',145,
     1 'ALL',0,146,'EVE','RYT',146,
     1 'TRE','ASU',147,'VAL','UAB',147,'SAI','LOR',148,'TEE','TH',149,
     2 'GRU','E',151,'HAN','D',152,'HAN','DS',152,
     3 'LUN','GS',153,'AIR',0,153,'BRE','ATH',153,'AVI','ATO',154,
     4 'FLY','ER',154/
C
        DATA OVOKND/-1/
        END
C PROTC-- CHECK FOR USER VIOLATION
C
C THIS ROUTINE SHOULD BE MODIFIED IF YOU WISH TO ADD SYSTEM
C DEPENDANT PROTECTION AGAINST ABUSE.
C
C AT THE MOMENT, PLAY IS PERMITTED UNDER ALL CIRCUMSTANCES.
C
        LOGICAL FUNCTION PROTC(X)
        IMPLICIT INTEGER(A-Z)
C
        PROTC=.TRUE.
100     RETURN
        END
C
C  SPECIAL ENTRY TO INIT RADIX-50 TEXT (CALLED FROM INIT)
C
        SUBROUTINE SPINT(EXTRA)
        IMPLICIT INTEGER(A-Z)
        COMMON/BUZVC/BVOC (20)
        COMMON/PRPVC/PVOC (47)
        COMMON/DIRVC/DVOC(90)
        COMMON/ADJVC/AVOC(264)
        COMMON/VRBVC/VVOC(818)
        COMMON/OBJVC/OVOC(797)
C
C INITIAL ASCII VOCABULARIES
C
        INTEGER*4 BVOK,PVOK,DVOK
        COMMON /BUZVK/ BVOK(20)
        COMMON /PRPVK/ PVOK(47)
        COMMON /DIRVK/ DVOK(90)
        INTEGER*4 AVOK(264),AVOK1,AVOK2,AVOKND
        COMMON /ADJVK/ AVOK1(158),AVOK2(105),AVOKND
        INTEGER*4 VVOK(818),VVOK1,VVOK1A,VVOK2,VVOK3,VVOK4,VVOK5,
     +            VVOK6,VVOK7,VVOKND
        COMMON /VRBVK/ VVOK1(94),VVOK1A(100),VVOK2(80),VVOK3(119),
     1          VVOK4(118),VVOK5(116),VVOK6(107),VVOK7(83),VVOKND
        INTEGER*4 OVOK(797),OVOK1,OVOK2,OVOK3,OVOK4,OVOK5,OVOK6,
     +            OVOK7,OVOKND
        COMMON /OBJVK/ OVOK1(150),OVOK2(135),OVOK3(140),OVOK4(117),
     1          OVOK5(106),OVOK6(97),OVOK7(51),OVOKND
C
        EQUIVALENCE (VVOK(1),VVOK1(1))
        EQUIVALENCE (AVOK(1),AVOK1(1))
        EQUIVALENCE (OVOK(1),OVOK1(1))
C
        CALL R50CV(BVOK,BVOC,20)
        CALL R50CV(PVOK,PVOC,47)
        CALL R50CV(DVOK,DVOC,90)
        CALL R50CV(AVOK,AVOC,264)
        CALL R50CV(VVOK,VVOC,818)
        CALL R50CV(OVOK,OVOC,797)
        RETURN
C
        END
      SUBROUTINE READJ(J,LINE)
C
         COMMON /DCBN/ IDCBN(144),IBUFF(40)
C
      INTEGER J,LINE(78)
      INTEGER IN(80)
      INTEGER BLANK,MINUS
      DATA BLANK /'  '/
      DATA MINUS /'- '/
      CALL READF (IDCBN,IERR,IBUFF,40)
      DECODE(80,99,IBUFF) IN
99    FORMAT(80A1)
      IF (IN(1).NE.MINUS) GO TO 10
      J=-1
      RETURN
10    I=1
      J=NUMBR(IN,I,10)
      DO 20 K=1,78
20    LINE(K)=BLANK
      IF (I.GT.80) RETURN
      K=0
      DO 30 I=I,80
      K=K+1
      IF (K.GT.78) RETURN
30    LINE(K)=IN(I)
      RETURN
      END
      SUBROUTINE RDRMN(RACT,RVAL,RFLG)  ! READ ROOM NUMERICS
C
         COMMON /DCBN/ IDCBN(144),IBUFF(40)
C
      INTEGER RACT,RVAL,RFLG
      INTEGER IN(80)
      INTEGER NUMBR ! FUNCTION
      CALL READF (IDCBN,IERR,IBUFF,40)
      DECODE (80,99,IBUFF) IN
99    FORMAT(80A1)
      I=1
      RACT=NUMBR(IN,I,10)
      RVAL=NUMBR(IN,I,10)
      RFLG=NUMBR(IN,I,8)
      RETURN
      END
      SUBROUTINE RDEXT(DIR,XTYPE,XROOM1)
C
         COMMON /DCBN/ IDCBN(144),IBUFF(40)
C
      INTEGER DIR,XTYPE,XROOM1
      INTEGER IN(80)
      INTEGER BLANK
      INTEGER NUMBR
      DATA BLANK /'  '/
      CALL READF (IDCBN,IERR,IBUFF,40)
      DECODE(80,99,IBUFF) DIR,(IN(I),I=1,78)
99    FORMAT(A2,78A1)
      IN(79)=BLANK
      IN(80)=BLANK
      I=1
      XTYPE =NUMBR(IN,I,10)
      XROOM1=NUMBR(IN,I,10)
      RETURN
      END
      SUBROUTINE RDOAL(XOBJ,XACTIO,LINE)
C
         COMMON /DCBN/ IDCBN(144),IBUFF(40)
C
      INTEGER XOBJ,XACTIO,LINE(78)
      INTEGER IN(80)
      INTEGER BLANK
      DATA BLANK /'  '/
      CALL READF (IDCBN,IERR,IBUFF,40)
      DECODE(80,99,IBUFF) IN
99    FORMAT(80A1)
      DO 10 I=1,78
10    LINE(I)=BLANK
      I=1
      XOBJ  =NUMBR(IN,I,10)
      XACTIO=NUMBR(IN,I,10)
      IF (I.GT.80) RETURN
      J=0
      DO 20 I=I,80
      J=J+1
20    LINE(J)=IN(I)
      RETURN
      END
      SUBROUTINE RDOBJ(A,B,C,D,O,P,V,W,X,Y,Z)
C
         COMMON /DCBN/ IDCBN(144),IBUFF(40)
C
      INTEGER A,B,C,D,O,P,V,W,X,Y,Z
      INTEGER IN(80)
      CALL READF (IDCBN,IERR,IBUFF,40)
      DECODE(80,99,IBUFF) IN
99    FORMAT(80A1)
      I=1
      A=NUMBR(IN,I,10)
      B=NUMBR(IN,I,10)
      C=NUMBR(IN,I,10)
      D=NUMBR(IN,I,10)
      O=NUMBR(IN,I,8)
      P=NUMBR(IN,I,8)
      V=NUMBR(IN,I,10)
      W=NUMBR(IN,I,10)
      X=NUMBR(IN,I,10)
      Y=NUMBR(IN,I,10)
      Z=NUMBR(IN,I,10)
      RETURN
      END
      SUBROUTINE RDCLK(CACTIO,CTICK,CFLAG)
C
         COMMON /DCBN/ IDCBN(144),IBUFF(40)
C
      INTEGER CACTIO,CTICK
      LOGICAL CFLAG
      INTEGER IN(80)
      INTEGER BLANK,TRUE
      DATA BLANK /'  '/
      DATA TRUE  /'T '/
      CALL READF (IDCBN,IERR,IBUFF,40)
      DECODE(80,99,IBUFF) IN
99    FORMAT(80A1)
      I=1
      CACTIO=NUMBR(IN,I,10)
      CTICK =NUMBR(IN,I,10)
      CFLAG=.FALSE.
      IF (I.GT.80) RETURN
      DO 10 I=I,80
10    IF (IN(I).NE.BLANK) GO TO 20
      RETURN
20    IF (IN(I).EQ.TRUE) CFLAG=.TRUE.
      RETURN
      END
      SUBROUTINE RDADV(AROOM,AOBJ,AACTIO,ASTREN)  ! ADVENTURER ATTRIB-S
C
         COMMON /DCBN/ IDCBN(144),IBUFF(40)
C
      INTEGER AROOM,AOBJ,AACTIO,ASTREN
      INTEGER IN(80)
      CALL READF (IDCBN,IERR,IBUFF,40)
      DECODE(80,99,IBUFF) IN
99    FORMAT(80A1)
      I=1
      AROOM =NUMBR(IN,I,10)
      AOBJ  =NUMBR(IN,I,10)
      AACTIO=NUMBR(IN,I,10)
      ASTREN=NUMBR(IN,I,10)
      RETURN
      END
C R50CV -- CONVERT STRINGS IN VOCABULARY ARRAYS TO RADIX 50
C
      SUBROUTINE R50CV(IA,IR,L)
      INTEGER IR(1),L,I,J,K,NEW,G50,ITEMP,C
      INTEGER*4 IA(1),OLD
      COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
      DO 30 I=1,L
      OLD=IA(I)
      IF (OLD .EQ. -1) GO TO 29
      ITEMP = 0
      CALL UMOVE (1, OLD, 0, ITEMP,0)
      IF (ITEMP .EQ. 0) GO TO 29
      NEW=0
      DO 20 J=0,2
      C=2H
      CALL UMOVE (1, OLD, J, C, 0)
      K=G50(C)
      IF(K.GT.0) GO TO 10
      IF(C.EQ.2H  .OR.C.EQ.2H$ ) GO TO 10
      WRITE (OUTCH,1)
1     FORMAT(" Initialization Error")
      CALL EXEC(6)
10    NEW=NEW*40+K
20    CONTINUE ! J
      IR(I)=NEW
      GO TO 30
C
29    IR(I) = OLD
30    CONTINUE ! I
      RETURN
      END
$
