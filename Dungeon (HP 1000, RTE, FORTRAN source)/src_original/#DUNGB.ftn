FTN4X,L
      PROGRAM DUNGB(5)
      IMPLICIT INTEGER(A-Z)
C
        LOGICAL INIT
C
C SEGMENTATION PARAMETERS & RESULT
C
      LOGICAL IZRESZ
      COMMON /SEG/ IZP1,IZP2,IZP3,IZRESZ
C
      IZRESZ = INIT (IZP1)
      CALL RETRN
      END
C INIT-- DUNGEON INITIALIZATION ROUTINE
C
C DECLARATIONS
C
        LOGICAL FUNCTION INIT(X)
        IMPLICIT INTEGER (A-Z)
        INTEGER LINE(78),SDIR(16),CDIR(16),IDCBI(144),IJK(3),ISIZE(2)
        INTEGER IBUFZ(79)
        EQUIVALENCE (IJK(1),I),(IJK(2),J),(IJK(3),K)
        LOGICAL PROTC
C
C DCB FOR ORIGINAL TEXT FILE, AND SCRATCH BUFFER
C
         COMMON /DCBN/ IDCBN(144),IBUFF(40)
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INLINE(78),INLNT
C
C PARSER STATE
C
        COMMON /ORPHS/ OFLAG,OACT,OSLOT,OPREP,ONAME
        COMMON /LAST/ LASTIT
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,
     1       LTSHFT,BLOC,MUNGRM,HS
C
C MESSAGE INDEX
C
        INTEGER MZZ(801)
        COMMON /RMSG/ MLNT,RTEXT(800)
        EQUIVALENCE (MZZ(1),MLNT)
C
C MISCELLANEOUS VARIABLES
C
        COMMON /STAR/ MBASE,STRBIT
        INTEGER VEZZ(3)
        COMMON /VERS/ VMAJ,VMIN,VEDIT
        EQUIVALENCE (VEZZ(1),VMAJ)
        COMMON /TIME/ PLTIME,SHOUR,SMIN,SSEC
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
        COMMON /DEBUG/ DBGFLG,PRSFLG
C
C ROOMS
C
        INTEGER RZZ (1051)
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
        EQUIVALENCE(RZZ(1),RLNT)
C
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA
C
C EXITS
C
        INTEGER XZZ(601)
        COMMON /EXITS/ XLNT,TRAVEL(600)
        EQUIVALENCE(XZZ(1),XLNT)
C
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ
        EQUIVALENCE (XFLAG,XOBJ)
C
        COMMON /XPARS/ XRMASK,XDMASK,XFMASK,XFSHFT,XASHFT,
     1       XELNT(4),XNORM,XNO,XCOND,XDOOR,XLFLAG
C
C OBJECTS
C
        INTEGER OZZ(2401)
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
        EQUIVALENCE(OZZ(1),OLNT)
C
        INTEGER R2ZZ(13)
        COMMON /OROM2/ R2LNT,O2(6),R2(6)
        EQUIVALENCE(R2ZZ(1),R2LNT)
C
        COMMON /OINDX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL
        COMMON /OINDX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG
        COMMON /OINDX/ LEAVE,TROLL,AXE
        COMMON /OINDX/ RKNIF,KEYS,ICE,BAR
        COMMON /OINDX/ COFFI,TORCH,TBASK,FBASK,IRBOX
        COMMON /OINDX/ GHOST,TRUNK,BELL,BOOK,CANDL
        COMMON /OINDX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI
        COMMON /OINDX/ THIEF,STILL,WINDO,GRATE,DOOR
        COMMON /OINDX/ HPOLE,LEAK,RBUTT,RAILI
        COMMON /OINDX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT
        COMMON /OINDX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO
        COMMON /OINDX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE
        COMMON /OINDX/ GNOME,BLABE,DBALL
        COMMON /OINDX/ LCASE,CAGE,RCAGE,SPHER,SQBUT
        COMMON /OINDX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE
        COMMON /OINDX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH
        COMMON /OINDX/ ITOBJ,EVERY,VALUA,OPLAY
C
C CLOCK INTERRUPTS
C
        LOGICAL CFLAG
        INTEGER CZZ(61)
        COMMON /CEVNT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)
        EQUIVALENCE (CZZ(1),CLNT)
C
C VILLAINS AND DEMONS
C
        LOGICAL THFFLG,SWDACT,THFACT
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA
        INTEGER VZZ(16)
        COMMON /VILL/ VLNT,VILLNS(5),VPROB(5),VOPPS(5)
        EQUIVALENCE(VZZ(1),VLNT)
C
C ADVENTURERS
C
        INTEGER AZZ(29)
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
        EQUIVALENCE (AZZ(1),ALNT)
C
        COMMON /AINDX/ PLAYER,AROBOT
C
C FLAGS
C
        LOGICAL FLAGS(33)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF
        LOGICAL GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,
     5       GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ BTIEF,BINFF
        EQUIVALENCE (FLAGS(1),TROLLF)
C
        DATA SDIR/'N ','S ','E ','W ','SE','SW','NE','NW',
     1'U ','D ','LA','LN','EN','EX','CR','CL'/
        DATA CDIR/2000B,4000B,6000B,10000B,12000B,14000B,16000B,
     1 20000B,
     2 22000B,24000B,26000B,30000B,32000B,34000B,36000B,40000B /
C
C
        INIT=.FALSE.                            !ASSUME INIT FAILS.
        IF(PROTC(X)) GO TO 101          !PROTECTION VIOLATION?
        WRITE (OUTCH,11)                !YES, THROW HIM OFF.
11      FORMAT(" There appears before you a threatening figure clad",
     1" all over"/" in heavy black armor.  His legs seem like the",
     2" massive trunk"/" of the oak tree.  His broad shoulders and",
     3" helmeted head loom"/" high over your own puny frame, and",
     4" you realize that his powerful"/" arms could easily crush the",
     5" very life from your body.  There"/" hangs from his belt a",
     6" veritable arsenal of deadly weapons:"/" sword, mace, ball",
     7" and chain, dagger, lance, and trident."/" He speaks with a",
     8" commanding voice:"//20X,"'You shall not pass.'"//" As",
     9" he grabs you by the neck all grows dim about you.")
      RETURN
C
101     MMAX=800                                !SET UP ARRAY LIMITS.
        OMAX=160
        RMAX=150
        VMAX=5
        AMAX=4
        CMAX=20
        FMAX=33
        XMAX=600
        R2MAX=6
        DIRMAX=16
C
        MLNT=0                                  !INIT ARRAY COUNTERS.
        OLNT=0
        RLNT=0
        VLNT=0
        ALNT=0
        CLNT=0
        XLNT=1
        R2LNT=0
C
        LTSHFT=10                               !SET UP STATE VARIABLES.
        MXSCOR=LTSHFT
        MXLOAD=100
        RWSCOR=0
        DEATHS=0
        MOVES=0
        PLTIME=0
        MUNGRM=0
        HS=0
        PRSA=0                                  !CLEAR PARSE VECTOR.
        PRSI=0
        PRSO=0
        PRSCON=0
        OFLAG=0                                 !CLEAR ORPHANS.
        OACT=0
        OSLOT=0
        OPREP=0
        ONAME=0
        THFFLG=.FALSE.                          !THIEF NOT INTRODUCED BU
        THFACT=.TRUE.                           !IS ACTIVE.
        SWDACT=.FALSE.                          !SWORD IS INACTIVE.
        SWDSTA=0                                !SWORD IS OFF.
C
        RECNO=1                                 !INIT DB FILE POINTER.
        MBASE=0                                 !INIT MELEE BASE.
C       INPCH=5                                 !TTY INPUT
C       OUTCH=5                                 !TTY OUTPUT.
C
C INIT ALL ARRAYS.
C
        DO 5 I=1,CMAX                           !CLEAR CLOCK EVENTS
          CFLAG(I)=.FALSE.
          CTICK(I)=0
          CACTIO(I)=0
5       CONTINUE
C
        DO 10 I=1,FMAX                          !CLEAR FLAGS.
          FLAGS(I)=.FALSE.
10      CONTINUE
        BUOYF=.TRUE.                            !SOME START AS TRUE.
        EGYPTF=.TRUE.
        CAGETF=.TRUE.
        BTIEF=0                                 !CLEAR INTEGER FLAGS.
        BINFF=0
C
        DO 15 I=1,R2MAX                         !CLEAR ROOM 2 ARRAY.
          R2(I)=0
          O2(I)=0
15      CONTINUE
C
        DO 20 I=1,XMAX                          !CLEAR TRAVEL ARRAY.
          TRAVEL(I)=0
20      CONTINUE
C
        DO 30 I=1,VMAX                          !CLEAR VILLAINS ARRAYS.
          VOPPS(I)=0
          VPROB(I)=0
          VILLNS(I)=0
30      CONTINUE
C
        DO 40 I=1,OMAX                          !CLEAR OBJECT ARRAYS.
          ODESC1(I)=0
          ODESC2(I)=0
          ODESCO(I)=0
          OREAD(I)=0
          OACTIO(I)=0
          OFLAG1(I)=0
          OFLAG2(I)=0
          OFVAL(I)=0
          OTVAL(I)=0
          OSIZE(I)=0
          OCAPAC(I)=0
          OCAN(I)=0
          OADV(I)=0
          OROOM(I)=0
          ORAND(I)=0
40      CONTINUE
C
        DO 50 I=1,RMAX                          !CLEAR ROOM ARRAYS.
          RDESC1(I)=0
          RDESC2(I)=0
          RACTIO(I)=0
          RFLAG(I)=0
          RVAL(I)=0
          RRAND(I)=0
          REXIT(I)=0
50      CONTINUE
C
        DO 60 I=1,MMAX                          !CLEAR MESSAGE DIRECTORY
          RTEXT(I)=0
60      CONTINUE
C
        DO 70 I=1,AMAX                          !CLEAR ADVENTURER'S ARRA
          AROOM(I)=0
          ASCORE(I)=0
          AVEHIC(I)=0
          AOBJ(I)=0
          AACTIO(I)=0
          ASTREN(I)=0
          AFLAG(I)=0
70      CONTINUE
C
        RVMNT=0                                 !CLEAR RV FLAGS.
        RVCLR=0
        RVCYC=0
        RVSND=0
        RVGUA=0
C
        DBGFLG=0
        PRSFLG=0
C
        CALL SPINT(EXTRA)                       !INIT R50 CONSTS
C
C NOW SEE IF WE CAN RESTORE FROM EXISTING INDEX FILE.
C (WE USE FMGR ROUTINES DIRECTLY, INSTEAD OF FTN4X FILE STATE-
C MENTS, TO AVOID HAVING TO USE LGBUF WITH 2500 WORD BUFFER!)
C
        CALL OPEN (IDCBI,IERR,6H@DUNGI,0,2HDD,-13)
        IF (IERR .LT. 0) GO TO 75
        CALL READF(IDCBI,IERR,IJK,3)              !GET VERSION.
        IF((I.NE.VMAJ).OR.(J.NE.VMIN))
     1       GO TO 170                          !MATCH TO OURS?
C
C       PRINT 150
C150    FORMAT(" RESTORING FROM '@DUNGI'")
        CALL READF(IDCBI,IERR,IJK,3)
        MBASE=I
        STRBIT=J
        MXSCOR=K
        CALL READF(IDCBI,IERR,RZZ,1051)
        CALL READF(IDCBI,IERR,XZZ,601)
        CALL READF(IDCBI,IERR,OZZ,2401)
        CALL READF(IDCBI,IERR,R2ZZ,13)
        CALL READF(IDCBI,IERR,CZZ,61)
        CALL READF (IDCBI,IERR,VZZ,16)
        CALL READF (IDCBI,IERR,AZZ,29)
        CALL READF (IDCBI,IERR,MZZ,801)
C
        CALL CLOSE (IDCBI)
        CALL OPEN (IDCBT,IERR,6H@DUNGT,1,2HDD,-13)
        IF(IERR.LT.0) GO TO 170
        GO TO 1025                              !INIT DONE.
C
C INDEX FILE IS OBSOLETE, OR
C DB FILE IS NOT AVAILABLE.
C KILL INDEX FILE AND START AGAIN.
C
170     CALL CLOSE(IDCBI)                        !KILL INDEX FILE.
        CALL PURGE(IDCBI,IERR,6H@DUNGI,2HDD,-13)
C
C NOW START DATA BASE FILE PROCESSING.
C
 75     CALL OPEN (IDCBN,IERR,6H@DUNGN,0,2HDD,-13)
        IF (IERR .LT. 0) GO TO 1900
        ISIZE(1)=1400
        ISIZE(2)=79
        CALL CREAT(IDCBT,IERR,6H@DUNGT,ISIZE,2,2HDD,-13)
C
C
        WRITE(OUTCH,185)
 185    FORMAT(" CREATING NEW '@DUNGT'")
C
C RETURN HERE TO READ NEXT SECTION HEADER.
C
80      CALL READJ(I,LINE)                      !READ SECTION HEADER.
C90     FORMAT(I3,1X,78A1)                      !OBSOLETED BY READJ
C
        IF(I.EQ.0) GO TO 80                     !IGNORE 0.
        IF(I.LT.0) GO TO 1000                   !-1 IS END FILE.
       WRITE (OUTCH,125) I
125    FORMAT(" INITIALIZING SECTION #",I4)
        IF(I.LE.8) GO TO 100                    !TEXT SECTION?
        IF((I-8).LT.1.OR.(I-8).GT.6) CALL BUG(12,I)  !INVALID SECTION NO
        GO TO (400,500,600,700,800,900),(I-8)   !NO, NUMERIC, GO PROCESS
C
C TEXT SECTION.  WRITE TEXT OUT TO DB FILE, NOTE INITIAL RECORD
C NUMBER IN APPROPRIATE ARRAY.
C
100     PREVJ=0                                 !FORCE START OF RECORD.
110     CALL READJ(J,LINE)                      !READ LINE.
        IF(J.EQ.0) GO TO 110                    !IGNORE 0.
        IF(J.LT.0) GO TO 80                     !-1 IS END SECTION.
        IF(J.EQ.PREVJ) GO TO 300                !IF CONT, WRITE OUT.
        IF(I.LT.1 .OR. I.GT.8) CALL BUG(12,I)
        GO TO (210,220,230,240,250,260,270,280),I
C
C SECTION 1-- RANDOM REMARKS.
C
210     IF(J.GT.MMAX) CALL BUG(13,J)            !TOO MANY REMARKS?
        IF(RTEXT(J).NE.0) CALL BUG(14,J)        !DUPLICATE REMARK?
        RTEXT(J)=-RECNO                         !RECORD START OF RECORD.
        MBASE=MAX0(MBASE,J)
        GO TO 300                               !GO OUTPUT LINE.
C
C SECTION 2-- MELEE MESSAGES
C
220     K=J+MBASE                               !OFFSET BY END OF RANDOM
        IF(K.GT.MMAX) CALL BUG(13,K)
        IF(RTEXT(K).NE.0) CALL BUG(14,K)
        RTEXT(K)=-RECNO
        MLNT=MAX0(MLNT,K)                       !UPDATE LENGTH COUNTER.
        GO TO 300
C
C SECTION 3-- LONG ROOM DESCRIPTIONS
C
230     IF(J.GT.RMAX) CALL BUG(15,J)            !TOO  MANY ROOMS?
        IF(RDESC1(J).NE.0) CALL BUG(16,J)       !DUPLICATE ROOM?
        RDESC1(J)=-RECNO
        GO TO 300
C
C SECTION 4-- SHORT ROOM DESCRIPTIONS
C
240     IF(J.GT.RMAX) CALL BUG(17,J)
        IF(RDESC2(J).NE.0) CALL BUG(18,J)
        RDESC2(J)=-RECNO
        GO TO 300
C
C SECTION 5-- LONG OBJECT DESCRIPTIONS
C
250     IF(J.GT.OMAX) CALL BUG(19,J)            !TOO MANY OBJECTS?
        IF(ODESC1(J).NE.0) CALL BUG(20,J)       !DUPLICATE OBJECTS?
        ODESC1(J)=-RECNO
        GO TO 300
C
C SECTION 6-- SHORT OBJECT DESCRIPTIONS
C
260     IF(J.GT.OMAX) CALL BUG(21,J)
        IF(ODESC2(J).NE.0) CALL BUG(22,J)
        ODESC2(J)=-RECNO
        GO TO 300
C
C SECTION 7-- UNTOUCHED OBJECT DESCRIPTIONS
C
270     IF(J.GT.OMAX) CALL BUG(23,J)
        IF(ODESCO(J).NE.0) CALL BUG(24,J)
        ODESCO(J)=-RECNO
        GO TO 300
C
C SECTION 8-- READING MATERIAL
C
280     IF(J.GT.OMAX) CALL BUG(25,J)
        IF(OREAD(J).NE.0) CALL BUG(26,J)
        OREAD(J)=-RECNO
        GO TO 300
C
C HERE TO WRITE OUT CURRENT LINE OF TEXT.
C
300     IBUFZ(1)=J
        DO 99871 IL=1,78
99871   IBUFZ(IL+1)=LINE(IL)
        CALL WRITF(IDCBT,IERR,IBUFZ,79,RECNO)
        RECNO=RECNO+1                           !ON TO NEXT RECORD
        PREVJ=J
        GO TO 110
C
C SECTION 9-- ROOM DATA
C
400     CALL READJ(J,LINE)                      !GET ROOM NO.
        IF(J.LT.0) GO TO 80                     !-1 IS END OF SECTION.
        IF(J.EQ.0) GO TO 400                    !0 IS IGNORED.
        IF(J.GT.RMAX) CALL BUG(28,J)            !TOO MANY ROOMS?
        RLNT=MAX0(RLNT,J)                       !COUNT ROOMS.
C
        CALL RDRMN(RACTIO(J),RVAL(J),RFLAG(J))  !READ ROOM NUMERICS.
C425    FORMAT(2(I3,1X),O5,1X,I3)               !OBSOLETED BY RDRMN
        MXSCOR=MXSCOR+RVAL(J)                   !UPDATE BEST SCORE.
        PREVX=0                                 !NO PREV ENTRY.
C
C HERE TO LOOP ON EXIT DESCRIPTIONS
C
405     CALL RDEXT(DIR,XTYPE,XROOM1)            !READ NEXT EXIT.
C415    FORMAT(A2,2(I3,1X))                     !OBSOLETED BY RDEXT
        IF(DIR.EQ.2H  ) GO TO 400               !BLANK LINE ENDS EXITS.
        DO 410 K=1,DIRMAX                       !LOOK UP DIR IN TABLE.
          IF(DIR.EQ.SDIR(K)) GO TO 420          !IF FOUND, OK.
410     CONTINUE
        CALL BUG(29,DIR)                        !INVALID DIRECTION.
C
C HAVE TRANSLATED DIRECTION, VALIDATE OTHER FIELDS.
C
420     IF((XTYPE.LE.0).OR.(XTYPE.GT.(XFMASK+1))) CALL BUG(30,XTYPE)
        IF(XROOM1.GT.RMAX) CALL BUG(31,XROOM1)
        IF(REXIT(J).EQ.0) REXIT(J)=XLNT         !RECORD FIRST.
        IF((XLNT+XELNT(XTYPE)).GT.XMAX) CALL BUG(32,XLNT)
        TRAVEL(XLNT)=CDIR(K)+((XTYPE-1)*XFSHFT)+XROOM1+XLFLAG
        IF(PREVX.NE.0) TRAVEL(PREVX)=TRAVEL(PREVX)-XLFLAG
        IF(XTYPE.LT.1 .OR. XTYPE.GT.4) CALL BUG(30,XTYPE)
        GO TO (480,470,460,450),XTYPE           !DO UNIQUE PROCESSING.
C
C DOOR ENTRY-- READ OBJECT,APPLICABLE,STRING
C
450     CALL RDOAL(XOBJ,XACTIO,LINE)
C455    FORMAT(2(I3,1X),78A1)                   !OBSOLETED BY RDOAL
        IF((XOBJ.LE.0).OR.(XOBJ.GT.OMAX)) CALL BUG(34,XOBJ)
        GO TO 468
C
C CONDITIONAL EXIT ENTRY-- READ FLAG,APPLICABLE,STRING
C
460     CALL RDOAL(XOBJ,XACTIO,LINE)
C465    FORMAT(2(I3,1X),78A1)                   !OBSOLETED BY RDOAL
        IF((XOBJ.LE.0).OR.(XOBJ.GT.FMAX)) CALL BUG(35,XOBJ)
468     TRAVEL(XLNT+2)=(XACTIO*XASHFT)+XOBJ
        GO TO 478
C
C NO EXIT ENTRY-- READ STRING
C
470     CALL READF (IDCBN,IERR,IBUFF,40)
        DECODE(80,475,IBUFF) LINE
475     FORMAT(78A1)
478     IF(LINE(1).EQ.2H  ) GO TO 480           !BLANK LINE?
        IBUFZ(1)=RECNO                              !NO, WRITE OUT
        DO 99872 IL=1,78
99872   IBUFZ(IL+1)=LINE(IL)
        CALL WRITF(IDCBT,IERR,IBUFZ,79,RECNO)
        TRAVEL(XLNT+1)=-RECNO
        RECNO=RECNO+1
C
C COMMON PROCESSING, ADVANCE OVER ENTRY.
C
480     PREVX=XLNT                              !RECORD PREV ENTRY.
        XLNT=XLNT+XELNT(XTYPE)
        GO TO 405
C SECTION 11-- GLOBAL OBJECTS
C SECTION 10-- NORMAL OBJECTS
C
600     STRBIT=OLNT                             !RECORD START OF STARS.
500     CALL READJ(J,LINE)                      !GET OBJ NUMBER.
        IF(J.LT.0) GO TO 80                     !-1 IS END SECTION.
        IF(J.EQ.0) GO TO 500                    !0 IS IGNORED.
        IF(J.GT.OMAX) CALL BUG(27,J)
        OLNT=MAX0(OLNT,J)
C
        CALL RDOBJ(OROOM(J),K,OCAN(J),OACTIO(J),OFLAG1(J),
     1       OFLAG2(J),OFVAL(J),OTVAL(J),OSIZE(J),OCAPAC(J),
     2       ORAND(J))
C560    FORMAT(4(I8,1X),2(O8,1X),5(I8,1X))      !OBSOLETED BY RDOBJ
C
        MXSCOR=MXSCOR+OFVAL(J)+OTVAL(J)         !UPDATE BEST SCORE.
C
        IF(K.EQ.0) GO TO 500                    !SECOND ROOM?
        R2LNT=R2LNT+1                           !YES, RECORD.
        IF(R2LNT.GT.R2MAX) CALL BUG(33,R2LNT)
        O2(R2LNT)=J
        R2(R2LNT)=K
        GO TO 500
C
C SECTION 12-- VILLAINS
C
700     CALL READJ(J,LINE)                      !READ VILLAIN NO.
        IF(J.LT.0) GO TO 80
        IF(J.EQ.0) GO TO 700
        VLNT=VLNT+1
        IF(VLNT.GT.VMAX) CALL BUG(36,VLNT)      !TOO MANY VILLAINS?
        VILLNS(VLNT)=J                          !NO, ADD TO LIST.
        GO TO 700
C
C SECTION 13-- CLOCK EVENTS
C
800     CALL READJ(J,LINE)                      !READ EVENT NO.
        IF(J.LT.0) GO TO 80
        IF(J.EQ.0) GO TO 800
        IF(J.GT.CMAX) CALL BUG(37,J)
        CLNT=MAX0(CLNT,J)
C
        CALL RDCLK(CACTIO(J),CTICK(J),CFLAG(J))
C890    FORMAT(2(I3,1X),L1)                     !OBSOLETED BY RDCLK
        GO TO 800
C
C SECTION 14-- ADVENTURERS
C
900     CALL READJ(J,LINE)                      !READ ADV NO.
        IF(J.LT.0) GO TO 80
        IF(J.EQ.0) GO TO 900
        IF(J.GT.AMAX) CALL BUG(38,J)
        ALNT=MAX0(ALNT,J)
C
        CALL RDADV(AROOM(J),AOBJ(J),AACTIO(J),ASTREN(J))
C990    FORMAT(4(I3,1X))                        !OBSOLETED BY RDADV
        GO TO 900
C
C INITIALIZATION IS COMPLETE.
C WRITE OUT NEW INDEX FILE FOR NEXT TIME AROUND.
C
 1000   CALL CLOSE(IDCBN)             !CLOSE TXT FILE.
       CALL CREAT(IDCBI,IERR,6H@DUNGI,50,4,2HDD,-13)
       WRITE(OUTCH,1005)
 1005   FORMAT(" CREATING NEW '@DUNGI'")
C
        CALL WRITF(IDCBI,IERR,VEZZ,3)             !STORE VERSION.
        I=MBASE
        J=STRBIT
        K=MXSCOR
        CALL WRITF(IDCBI,IERR,IJK,3)
        CALL WRITF(IDCBI,IERR,RZZ,1051)
        CALL WRITF(IDCBI,IERR,XZZ,601)
        CALL WRITF(IDCBI,IERR,OZZ,2401)
        CALL WRITF(IDCBI,IERR,R2ZZ,13)
        CALL WRITF(IDCBI,IERR,CZZ,61)
        CALL WRITF (IDCBI,IERR,VZZ,16)
        CALL WRITF (IDCBI,IERR,AZZ,29)
        CALL WRITF (IDCBI,IERR,MZZ,801)
C
        CALL CLOSE (IDCBI)
1025    CONTINUE
C
C THE INTERNAL DATA BASE IS NOW ESTABLISHED.
C SET UP TO PLAY THE GAME.
C
        CALL ITIME(SHOUR,SMIN,SSEC)             !GET TIME AND DATE.
        ISEED = AND(SHOUR*SMIN*SSEC,77777B)
        CALL SSEED (ISEED)                      !SET RANDOM NO. GEN'R.
C
        WINNER=PLAYER
        THFPOS=OROOM(THIEF)
        BLOC=OROOM(BALLO)
        HERE=AROOM(WINNER)
        LASTIT=AOBJ(PLAYER)
        INIT=.TRUE.
C
C       PRINT 1050,RLNT,RMAX,XLNT,XMAX,OLNT,OMAX,MLNT,MMAX,
C    1          VLNT,VMAX,ALNT,AMAX,CLNT,CMAX,R2LNT,R2MAX
C1050   FORMAT(" USED:"/1X,I5," OF",I5," ROOMS"/
C    1   1X,I5," OF",I5," EXITS"/
C    2   1X,I5," OF",I5," OBJECTS"/
C    3   1X,I5," OF",I5," MESSAGES"/
C    4   1X,I5," OF",I5," VILLAINS"/
C    5   1X,I5," OF",I5," ADVENTURERS"/
C    6   1X,I5," OF",I5," CLOCK EVENTS"/
C    7   1X,I5," OF",I5," ROOM2 SLOTS")
C       PRINT 1150,MXSCOR,RECNO,MBASE,STRBIT
C1150   FORMAT(" MAX SCORE=",I5/" MAX RECNO=",I5/
C    1   " MELEE START=",I5/" STAR MASK=",I7)
C       PAUSE 1
C
        RETURN
C
C ERRORS-- INIT FAILS.
C
1900    WRITE (OUTCH,910)                        !INPUT FILE ERROR
 910    FORMAT(" I can't open '@DUNGN::13'.")
        WRITE (OUTCH,911)
911     FORMAT(" Suddenly a sinister, wraithlike figure appears before",
     1" you"/" seeming to float in the air.  In a low, sorrowful voice",
     2" he says,"/" 'Alas, the very nature of the world has changed,",
     3" and the dungeon"/" cannot be found.  All must now pass away.'",
     4"  Raising his oaken staff"/" in farewell, he fades into the",
     5" spreading darkness.  In his place"/" appears a tastefully",
     6" lettered sign reading:"//23X,"INITIALIZATION FAILURE"//
     7" The darkness becomes all encompassing, and your vision fails.")
        RETURN
        END
         BLOCK DATA B
         IMPLICIT INTEGER (A-Z)
C
         COMMON /DCBN/ IDCBN(144),IBUFF(40)
C
C
C INITIAL ASCII VOCABULARIES
C
        INTEGER*4 BVOK,PVOK,DVOK
        COMMON /BUZVK/ BVOK(20)
        COMMON /PRPVK/ PVOK(47)
        COMMON /DIRVK/ DVOK(90)
        INTEGER*4 AVOK(264),AVOK1,AVOK2,AVOKND
        COMMON /ADJVK/ AVOK1(158),AVOK2(105),AVOKND
        INTEGER*4 VVOK(818),VVOK1,VVOK1A,VVOK2,VVOK3,VVOK4,VVOK5,
     +            VVOK6,VVOK7,VVOKND
        COMMON /VRBVK/ VVOK1(94),VVOK1A(100),VVOK2(80),VVOK3(119),
     1          VVOK4(118),VVOK5(116),VVOK6(107),VVOK7(83),VVOKND
        INTEGER*4 OVOK(797),OVOK1,OVOK2,OVOK3,OVOK4,OVOK5,OVOK6,
     +            OVOK7,OVOKND
        COMMON /OBJVK/ OVOK1(150),OVOK2(135),OVOK3(140),OVOK4(117),
     1          OVOK5(106),OVOK6(97),OVOK7(51),OVOKND
C
        EQUIVALENCE (VVOK(1),VVOK1(1))
        EQUIVALENCE (AVOK(1),AVOK1(1))
        EQUIVALENCE (OVOK(1),OVOK1(1))
C
C
C BUZZ WORDS--  IGNORED IN SYNTACTIC PROCESSING
C
        DATA BVOK/'AND',0,'BY',0,'IS',0,'ONE',0,'A',0,
     1            'AN',0,'THE',0,'RUN',0,'GO',0,'PRO','CEE'/
C
C PREPOSITIONS--        MAPS PREPOSITIONS TO INDICES
C
        DATA PVOK/'OVE','R',1,'WIT','H',2,'USI','NG',2,'THR','OUG',2,
     1          'AT',0,3,'TO',0,4,'IN',0,5,'INS','IDE',5,'INT','O',5,
     2          'DOW','N',6,'UP',0,7,'UND','ER',8,'OF',0,9,'ON',0,10,
     3          'OFF',0,11,0,0/
C
C DIRECTIONS--  MAPS DIRECTIONS TO INDICES
C
        DATA DVOK/'N',0,2000B,'NOR','TH',2000B,'S',0,4000B,
     1    'E',0,6000B,'EAS','T',6000B,'W',0,10000B,'WES','T',10000B,
     2    'SE',0,12000B,'SOU','THE',12000B,'SW',0,14000B,
     3    'NE',0,16000B,'NOR','THE',16000B,'NW',0,20000B,
     4    'U',0,22000B,'UP',0,22000B,'D',0,24000B,'DOW','N',24000B,
     5    'LAU','NCH',26000B,'LAN','D',30000B,'ENT','ER',32000B,
     6    'EXI','T',34000B,'OUT',0,34000B,'LEA','VE',34000B,
     7    'TRA','VEL',36000B,'CLI','MB',40000B,'SOU','TH',4000B,
     8    'SOU','THW',14000B,'NOR','THW',20000B,'IN',0,32000B,
     9    'CRO','SS',36000B/
C
C
C ADJECTIVES--  MAPS ADJECTIVES TO OBJECT NUMBERS
C
C EACH ENTRY IS VARIABLE LENGTH AND CONSISTS OF A TWO WORD
C ADJECTIVE IN RADIX-50 FOLLOWED BY ONE OR MORE OBJECT NUMBERS.
C NOTE THAT ADJECTIVES CAN BE DISTINGUISHED FROM OBJECTS AS
C FOLLOWS-- ALL ADJECTIVES ARE .GE. "A (1600)", WHILE ALL OBJECTS
C ARE .LE. OLNT (255 MAX).
C
       DATA AVOK1/'BRO','WN',1,81,'ELO','NGA',1,'HOT',0,3,'PEP','PER',3,
     1    'VIT','REO',4,'JAD','E',6,'HUG','E',8,'ENO','RMO',8,122,
     2    'TRO','PHY',9,'CLE','AR',10,'LAR','GE',12,26,47,95,96,123,
     2    133,135,'NAS','TY',13,'ELV','ISH',14,'BRA','SS',15,16,46,
     3    'BRO','KEN',16,92,113,'ORI','ENT',17,
     4    'BLO','ODY',20,'RUS','TY',21,'BUR','NED',22,
     5   'DEA','D',22,'BRO','KEN',22,'OLD',0,25,41,44,45,'LEA','THE',25,
     5    'PLA','TIN',26,'PEA','RL',27,
     6    'MOB','Y',31,'CRY','STA',32,126,'GOL','D',33,85,104,
     7    'IVO','RY',34,'SAP','PHI',37,'WOO','DEN',38,67,136,137,
     7    'IRO','N',39,125,
     8    'DEN','TED',39,'FAN','CY',40,'ANC','IEN',41,44,
     9    'SMA','LL',5,46,52,53,89,102,103,
     1    'BLA','CK',47,'TOU','R',49,
     2    'VIS','COU',55,'VIC','IOU',62,
     3    'GLA','SS',10,126,132,'TRA','P',66/
C
        DATA AVOK2/'FRO','NT',68,'STO','NE',69,'MAN','GLE',72,
     1    'RED',0,79,94,140,'YEL','LOW',80,'BLU','E',82,112,114,141,
     2    'VAM','PIR',83,'MAG','IC',90,
     3    'SEA','WOR',90,'TAN',0,91,'SHA','RP',92,
     4    'WIC','KER',98,'CLO','TH',100,
     5    'BRA','IDE',101,
     6    'GAU','DY',108,'SQU','ARE',109,127,'CLA','Y',109,
     7    'SHI','NY',110,'THI','N',110,
     8    'GRE','EN',115,143,'PUR','PLE',116,'WHI','TE',117,
     9    'MAR','BLE',119,'COK','E',121,
     1    'ROU','ND',128,'TRI','ANG',129,
     2    'RAR','E',134,'OBL','ONG',135,'EAT','$ME',138,
     3    'EAT','ME',138,'ORA','NGE',139,'ECC','H',141,-1,-1/
C
        DATA AVOKND/-1/
C
C VERBS--       MAPS VERBS TO SYNTAX SLOTS
C
C EACH ENTRY IS VARIABLE LENGTH AND CONSISTS OF ONE OR MORE
C TWO WORD VERBS IN RADIX-50 FOLLOWED BY A SYNTAX WORD COUNT
C FOLLOWED BY ONE OR MORE SYNTAXES.  NOTE THAT VERBS CAN BE
C DISTINGUISHED FROM WORD COUNTS AS FOLLOWS--
C ALL VERBS ARE .GE. "A (1600)", WHILE ALL SYNTAX WORD COUNTS
C ARE .LE. 255.
C
C SYNTAX ENTRIES CONSIST OF A FLAG WORD FOLLOWED BY 0, 1, OR 2
C OBJECT DESCRIPTIONS.  THE FLAG WORD HAS THE FOLLOWING FORMAT--
C
C BIT <14>      IF 1, SYNTAX INCLUDES DIRECT OBJECT
C BIT <13>      IF 1, SYNTAX INCLUDES INDIRECT OBJECT
C BIT <12>      IF 1, DIRECT OBJECT IS IMPLICIT (STANDARD FORM)
C BIT <11>      IF 1, DIRECT AND INDIRECT OBJECT MUST BE SWAPPED
C                       AFTER SYNTAX PROCESSING
C BIT <10>      IF 1, THIS IS DEFAULT SYNTAX FOR ORPHANERY
C BITS <8:0>    VERB NUMBER FOR VAPPL
C
C OBJECT DESCRIPTIONS CONSIST OF A FLAG WORD AND TWO FWIM WORDS.
C THE FLAG WORD HAS THE FOLLOWING FORMAT--
C
C BIT <14>      IF 1, SEARCH ADVENTURER FOR OBJECT
C BIT <13>      IF 1, SEARCH ROOM FOR OBJECT
C BIT <12>      IF 1, PARSER WILL TRY TO TAKE OBJECT
C BIT <11>      IF 1, ADVENTURER MUST HAVE OBJECT
C BIT <10>      IF 1, QUALIFYING BITS (NORMALLY -1,-1) ARE SAME
C                       AS FWIM BITS
C BITS <3:0>    PREPOSITION NUMBER (TWH)
C
C THE FWIM WORDS HAVE THE SAME FORMAT AS THE TWO OBJECT FLAG WORDS.
C
C NOTE THAT BITS 12 AND 11 OF OBJECT DESCRIPTIONS ACTUALLY HAVE
C FOUR DISTINCT STATES--
C
C       BIT 12  BIT 11  MDLDESC         INTERPRETATION
C       ------  ------  -------         ---------------
C
C         0       0      --             NO PARSER ACTION
C         0       1      HAVE           ADVENTURER MUST HAVE OBJECT
C         1       0      TRY            TRY TO TAKE, DONT CARE IF FAIL
C         1       1      TAKE           TRY TO TAKE, CARE IF FAIL
C
C
        DATA VVOK1/'BRI','EF',1,70,'UNB','RIE',1,71,
     1    'SUP','ERB',1,72,'UNS','UPE',1,73,'VER','SIO',1,74,
