FTN4X,L
      PROGRAM DUNGF(5)
      IMPLICIT INTEGER(A-Z)
C
        LOGICAL RINFO,VEHIC,VAPPL,RAPPL,FNDXT,AAPPL
C
C SEGMENTATION PARAMETERS & RESULT
C
      LOGICAL IZRESZ
      COMMON /SEG/ IZP1,IZP2,IZP3,IZRESZ
C
      IF (IZP1.EQ.2HRI) IZRESZ = RINFO(IZP2)
      IF (IZP1.EQ.2HVE) IZRESZ = VEHIC(IZP2)
      IF (IZP1.EQ.2HVA) IZRESZ = VAPPL(IZP2)
      IF (IZP1.EQ.2HRA) IZRESZ = RAPPL(IZP2)
      IF (IZP1.EQ.2HEN) CALL ENDMV(IZP2)
      IF (IZP1.EQ.2HFN) IZRESZ = FNDXT(IZP2,IZP3)
      IF (IZP1.EQ.2HAA) IZRESZ = AAPPL(IZP2)
      IF (IZP1.EQ.2HVC) CALL VALUC(IZP2)
      CALL RETRN
      END
C RINFO-- PRINT ROOM DESCRIPTION
C
C RINFO PRINTS A DESCRIPTION OF THE CURRENT ROOM.
C IT IS ALSO THE PROCESSOR FOR VERBS "LOOK" AND "EXAMINE".
C
        LOGICAL FUNCTION RINFO(FULL)
C
C DECLARATIONS
C
        IMPLICIT INTEGER (A-Z)
        LOGICAL FULL,PROB,LIT,RAPPL
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
C
C ROOMS
C
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
C
        COMMON /RFLAG/ RSEEN
C
        COMMON /XSRCH/ XMIN,XMAX,XDOWN
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
        COMMON /AINDX/ PLAYER,AROBOT
C
C VERBS
C
        COMMON /VINDX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW
        COMMON /VINDX/ WALKIW,FIGHTW,FOOW
        COMMON /VINDX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW
        COMMON /VINDX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW
        COMMON /VINDX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW
        COMMON /VINDX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW
        COMMON /VINDX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW
        COMMON /VINDX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW
        COMMON /VINDX/ MUNGW,KILLW,ATTACW,SWINGW
        COMMON /VINDX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW
        COMMON /VINDX/ DIGW,LEAPW
C
C FLAGS
C
        LOGICAL FLAGS(33)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF
        LOGICAL GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,
     5       GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ BTIEF,BINFF
        EQUIVALENCE (FLAGS(1),TROLLF)
        PROB(X)=(RND(100).LT.X)
C
        RINFO=.TRUE.                            !ASSUME WINS.
        TELFLG=.TRUE.                           !TURN OFF MESSAGE.
        IF(PRSO.GE.XMIN) PRSO=0                 !IF DIRECTION, WIPE.
        IF(HERE.EQ.AROOM(PLAYER)) GO TO 100     !PLAYER JUST MOVE?
        CALL RSPEK(2)                           !NO, JUST SAY DONE.
        PRSA=WALKIW                             !SET UP WALK IN ACTION.
        RETURN
C
100     IF(LIT(HERE)) GO TO 300                 !LIT?
        CALL RSPEK(430)                         !WARN OF GRUE.
        RINFO=.FALSE.
        RETURN
C
300     RA=RACTIO(HERE)                         !GET ROOM ACTION.
        I=RDESC2(HERE)                          !ASSUME SHORT DESC.
        IF(.NOT.FULL .AND. (SUPERF.OR.((AND(RFLAG(HERE),RSEEN).NE.0)
     1       .AND. (BRIEFF.OR.PROB(80))))) GO TO 400
        I=RDESC1(HERE)                          !USE LONG.
        IF((I.NE.0).OR.(RA.EQ.0)) GO TO 400     !IF GOT DESC, SKIP.
        PRSA=LOOKW                              !PRETEND LOOK AROUND.
        IF(.NOT.RAPPL(RA)) GO TO 100            !ROOM HANDLES, NEW DESC?
        PRSA=FOOW                               !NOP PARSER.
        GO TO 500
C
400     CALL RSPEK(I)                           !OUTPUT DESCRIPTION.
500     RFLAG(HERE)=OR(RFLAG(HERE),RSEEN)        !INDICATE ROOM SEEN.
        IF(AVEHIC(WINNER).NE.0) CALL RSPSB(431,ODESC2(AVEHIC(WINNER)))
        CALL PRICR(FULL,HERE)                   !PRINT CONTENTS OF ROOM.
        IF(FULL.OR.(RA.EQ.0)) RETURN            !ANYTHING MORE?
        PRSA=WALKIW                             !GIVE HIM A SURPISE.
        IF(.NOT.RAPPL(RA)) GO TO 100            !ROOM HANDLES, NEW DESC?
        PRSA=FOOW
        RETURN
C
        END
C RAPPL- SPECIAL PURPOSE ROOM ROUTINES
C
C DECLARATIONS
C
        LOGICAL FUNCTION RAPPL(RI)
        IMPLICIT INTEGER (A-Z)
        LOGICAL QOPEN,QON,QHERE,PROB,F
        LOGICAL MOVTO,LIT
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,
     1       LTSHFT,BLOC,MUNGRM,HS
C
C MISCELLANEOUS VARIABLES
C
        COMMON /BATS/ BATDRP(9)
C
C ROOMS
C
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
C
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA
C
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE
C
        COMMON /RINDX/ WHOUS,LROOM,CELLA
        COMMON /RINDX/ MTROL,MAZE1
        COMMON /RINDX/ MGRAT,MAZ15
        COMMON /RINDX/ FORE1,CLEAR,RESER
        COMMON /RINDX/ STREA,EGYPT,ECHOR
        COMMON /RINDX/ TSHAF
        COMMON /RINDX/ BSHAF,MMACH,DOME,MTORC
        COMMON /RINDX/ CAROU
        COMMON /RINDX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT
        COMMON /RINDX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL
        COMMON /RINDX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR
        COMMON /RINDX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4
        COMMON /RINDX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER
        COMMON /RINDX/ CAGED,TWELL,BWELL,ALICE,ALISM,ALITR
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
        COMMON /OINDX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL
        COMMON /OINDX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG
        COMMON /OINDX/ LEAVE,TROLL,AXE
        COMMON /OINDX/ RKNIF,KEYS,ICE,BAR
        COMMON /OINDX/ COFFI,TORCH,TBASK,FBASK,IRBOX
        COMMON /OINDX/ GHOST,TRUNK,BELL,BOOK,CANDL
        COMMON /OINDX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI
        COMMON /OINDX/ THIEF,STILL,WINDO,GRATE,DOOR
        COMMON /OINDX/ HPOLE,LEAK,RBUTT,RAILI
        COMMON /OINDX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT
        COMMON /OINDX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO
        COMMON /OINDX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE
        COMMON /OINDX/ GNOME,BLABE,DBALL
        COMMON /OINDX/ LCASE,CAGE,RCAGE,SPHER,SQBUT
        COMMON /OINDX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE
        COMMON /OINDX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH
        COMMON /OINDX/ ITOBJ,EVERY,VALUA,OPLAY
C
C CLOCK INTERRUPTS
C
        LOGICAL CFLAG
        COMMON /CEVNT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)
C
        COMMON /CINDX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH
C
        LOGICAL THFFLG,THFACT,SWDACT
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
        COMMON /AINDX/ PLAYER,AROBOT
C
C VERBS
C
        COMMON /VINDX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW
        COMMON /VINDX/ WALKIW,FIGHTW,FOOW
        COMMON /VINDX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW
        COMMON /VINDX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW
        COMMON /VINDX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW
        COMMON /VINDX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW
        COMMON /VINDX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW
        COMMON /VINDX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW
        COMMON /VINDX/ MUNGW,KILLW,ATTACW,SWINGW
        COMMON /VINDX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW
        COMMON /VINDX/ DIGW,LEAPW
C
C FLAGS
C
        LOGICAL FLAGS(33)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF
        LOGICAL GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,
     5       GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ BTIEF,BINFF
        EQUIVALENCE (FLAGS(1),TROLLF)
        QOPEN(R)=AND(OFLAG2(R),OPENBT).NE.0
        QON(R)=AND(OFLAG1(R),ONBT).NE.0
        PROB(R)=(RND(100).LT.R)
C
        RAPPL=.TRUE.                            !USUALLY IGNORED.
C                                               !SET TO FALSE FOR
C                                               !NEW DESC NEEDED.
        IF(RI.LT.1 .OR. RI.GT.37) CALL BUG(1,RI)
        GO TO (1000,2000,3000,4000,5000,6000,7000,8000,9000,10000,
     1 11000,12000,13000,14000,15000,16000,17000,18000,19000,20000,
     2 21000,22000,23000,24000,25000,26000,27000,28000,29000,30000,
     3 31000,32000,33000,34000,35000,36000,37000),RI
C
C R1--  EAST OF HOUSE.  DESCRIPTION DEPENDS ON STATE OF WINDOW
C
1000    IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        I=13                                    !ASSUME CLOSED.
        IF(QOPEN(WINDO)) I=12                   !IF OPEN, AJAR.
        CALL RSPSB(11,I)                        !DESCRIBE.
        RETURN
C
C R2--  KITCHEN.  SAME VIEW FROM INSIDE.
C
2000    IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        I=13                                    !ASSUME CLOSED.
        IF(QOPEN(WINDO)) I=12                   !IF OPEN, AJAR.
        CALL RSPSB(14,I)                        !DESCRIBE.
        RETURN
C
C R3--  LIVING ROOM.  DESCRIPTION DEPENDS ON MAGICF (STATE OF
C       DOOR TO CYCLOPS ROOM), RUG (MOVED OR NOT), DOOR (OPEN OR CLOSED)
C
3000    IF(PRSA.NE.LOOKW) GO TO 3500            !LOOK?
        I=15                                    !ASSUME NO HOLE.
        IF(MAGICF) I=16                         !IF MAGICF, CYCLOPS HOLE
        CALL RSPEK(I)                           !DESCRIBE.
        I=17+ORAND(RUG)                         !ASSUME INITIAL STATE.
        IF(QOPEN(DOOR)) I=I+2                   !DOOR OPEN?
        CALL RSPEK(I)                           !DESCRIBE.
        RETURN
C
C       NOT A LOOK WORD.  REEVALUATE TROPHY CASE.
C
3500    IF((PRSA.NE.TAKEW).AND.((PRSA.NE.PUTW).OR.(PRSI.NE.TCASE)))
     1       RETURN                          !IF NOT TAKE OR PUT.
        ASCORE(WINNER)=RWSCOR                   !SCORE TROPHY CASE.
        DO 3600 I=1,OLNT                        !RETAIN RAW SCORE AS WEL
          IF(OCAN(I).EQ.TCASE) ASCORE(WINNER)=ASCORE(WINNER)+OTVAL(I)
3600    CONTINUE
        RETURN
C
C R4--  CELLAR.  SHUT DOOR AND BAR IT IF HE JUST WALKED IN.
C
4000    IF(PRSA.NE.LOOKW) GO TO 4500            !LOOK?
        CALL RSPEK(21)                          !DESCRIBE CELLAR.
        RETURN
C
4500    IF(PRSA.NE.WALKIW) RETURN               !WALKIN?
        IF(AND(OFLAG2(DOOR),(OPENBT+TCHBT)).NE.OPENBT) RETURN
        OFLAG2(DOOR)=AND(OR(OFLAG2(DOOR),TCHBT),COMPL(OPENBT))
        CALL RSPEK(22)                          !SLAM AND BOLT DOOR.
        RETURN
C
C R5--  MAZE11.  DESCRIBE STATE OF GRATING.
C
5000    IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(23)                          !DESCRIBE.
        I=24                                    !ASSUME LOCKED.
        IF(GRUNLF) I=26                         !UNLOCKED?
        IF(QOPEN(GRATE)) I=25                   !OPEN?
        CALL RSPEK(I)                           !DESCRIBE GRATE.
        RETURN
C
C R6--  CLEARING.  DESCRIBE CLEARING, MOVE LEAVES.
C
6000    IF(PRSA.NE.LOOKW) GO TO 6500            !LOOK?
        CALL RSPEK(27)                          !DESCRIBE.
        IF(RVCLR.EQ.0) RETURN                   !LEAVES MOVED?
        I=28                                    !YES, ASSUME GRATE CLOSE
        IF(QOPEN(GRATE)) I=29                   !OPEN?
        CALL RSPEK(I)                           !DESCRIBE GRATE.
        RETURN
C
6500    IF((RVCLR.NE.0).OR.(QHERE(LEAVE,CLEAR).AND.
     1       ((PRSA.NE.MOVEW).OR.(PRSO.NE.LEAVE)))) RETURN
        CALL RSPEK(30)                          !MOVE LEAVES, REVEAL GRA
        RVCLR=1                                 !INDICATE LEAVES MOVED.
        RETURN
C
C R7--  RESERVOIR SOUTH.  DESCRIPTION DEPENDS ON LOW TIDE FLAG.
C
7000    IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        I=31                                    !ASSUME FULL.
        IF(LWTIDF) I=32                         !IF LOW TIDE, EMPTY.
        CALL RSPEK(I)                           !DESCRIBE.
        CALL RSPEK(33)                          !DESCRIBE EXITS.
        RETURN
C
C R8--  RESERVOIR.  STATE DEPENDS ON LOW TIDE FLAG.
C
8000    IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        I=34                                    !ASSUME FULL.
        IF(LWTIDF) I=35                         !IF LOW TIDE, EMTPY.
        CALL RSPEK(I)                           !DESCRIBE.
        RETURN
C
C R9--  RESERVOIR NORTH.  ALSO DEPENDS ON LOW TIDE FLAG.
C
9000    IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        I=36                                    !YOU GET THE IDEA.
        IF(LWTIDF) I=37
        CALL RSPEK(I)
        CALL RSPEK(38)
        RETURN
C
C R10-- GLACIER ROOM.  STATE DEPENDS ON MELTED, VANISHED FLAGS.
C
10000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(39)                          !BASIC DESCRIPTION.
        I=0                                     !ASSUME NO CHANGES.
        IF(GLACMF) I=40                         !PARTIAL MELT?
        IF(GLACRF) I=41                         !COMPLETE MELT?
        CALL RSPEK(I)                           !DESCRIBE.
        RETURN
C
C R11-- DECOMMITTED
C
11000   RETURN
C
C R12-- MIRROR ROOM.  STATE DEPENDS ON MIRROR INTACT.
C
12000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(42)                          !DESCRIBE.
        IF(MIRRMF) CALL RSPEK(43)               !IF BROKEN, NASTY REMARK
        RETURN
C
C R13-- CAVE2 ROOM.  BLOW OUT CANDLES WITH 50 PERCENT PROBABILITY.
C
13000   IF(PRSA.NE.WALKIW) RETURN               !WALKIN?
        IF(PROB(50).OR.(OADV(CANDL).NE.WINNER).OR.
     1       .NOT.QON(CANDL)) RETURN         !BLOW EM OUT?
        OFLAG1(CANDL)=AND(OFLAG1(CANDL),COMPL(ONBT))     !YES.
        CALL RSPEK(47)                          !TELL OF WINDS.
        CFLAG(CEVCND)=.FALSE.                   !HALT CANDLE COUNTDOWN.
        RETURN
C
C R14-- BOOM ROOM.  BLOW HIM UP IF CARRYING FLAMING OBJECT.
C
14000   J=ODESC2(CANDL)                         !ASSUME CANDLE.
        IF((OADV(CANDL).EQ.WINNER).AND.QON(CANDL)) GO TO 14100
        J=ODESC2(TORCH)                         !ASSUME TORCH.
        IF((OADV(TORCH).EQ.WINNER).AND.QON(TORCH)) GO TO 14100
        J=ODESC2(MATCH)
        IF((OADV(MATCH).EQ.WINNER).AND.QON(MATCH)) GO TO 14100
        RETURN                                  !SAFE
C
14100   IF(PRSA.NE.TRNONW) GO TO 14200          !TURN ON?
        CALL RSPSB(294,J)                       !BOOM!
        CALL JIGUP(44)
        RETURN
C
14200   IF(PRSA.NE.WALKIW) RETURN               !WALKIN?
        CALL RSPSB(295,J)                       !BOOM!
        CALL JIGUP(44)
        RETURN
C
C R15-- NO-OBJS.  SEE IF EMPTY HANDED, SCORE LIGHT SHAFT.
C
15000   EMPTHF=.TRUE.                           !ASSUME TRUE.
        DO 15100 I=1,OLNT                       !SEE IF CARRYING.
          IF(OADV(I).EQ.WINNER) EMPTHF=.FALSE.
15100   CONTINUE
C
        IF((HERE.NE.BSHAF).OR.(.NOT.LIT(HERE))) RETURN
        CALL SCUPD(LTSHFT)                      !SCORE LIGHT SHAFT.
        LTSHFT=0                                !NEVER AGAIN.
        RETURN
C
C R16-- MACHINE ROOM.  DESCRIBE MACHINE.
C
16000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        I=46                                    !ASSUME LID CLOSED.
        IF(QOPEN(MACHI)) I=12                   !IF OPEN, OPEN.
        CALL RSPSB(45,I)                        !DESCRIBE.
        RETURN
C
C R17-- BAT ROOM.  UNLESS CARRYING GARLIC, FLY AWAY WITH ME...
C
17000   IF(PRSA.NE.LOOKW) GO TO 17500           !LOOK?
        CALL RSPEK(48)                          !DESCRIBE ROOM.
        IF(OADV(GARLI).EQ.WINNER) CALL RSPEK(49)  !BAT HOLDS NOSE.
        RETURN
C
17500   IF((PRSA.NE.WALKIW).OR.(OADV(GARLI).EQ.WINNER)) RETURN
        CALL RSPEK(50)                          !TIME TO FLY, JACK.
        F=MOVTO(BATDRP(RND(9)+1))               !SELECT RANDOM DEST.
        RAPPL=.FALSE.                           !INDICATE NEW DESC NEEDE
        RETURN
C
C R18-- DOME ROOM.  STATE DEPENDS ON WHETHER ROPE TIED TO RAILING.
C
18000   IF(PRSA.NE.LOOKW) GO TO 18500           !LOOK?
        CALL RSPEK(51)                          !DESCRIBE.
        IF(DOMEF) CALL RSPEK(52)                !IF ROPE, DESCRIBE.
        RETURN
C
18500   IF(PRSA.EQ.LEAPW) CALL JIGUP(53)        !DID HE JUMP???
        RETURN
C
C R19-- TORCH ROOM.  ALSO DEPENDS ON WHETHER ROPE TIED TO RAILING.
C
19000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(54)                          !DESCRIBE.
        IF(DOMEF) CALL RSPEK(55)                !IF ROPE, DESCRIBE.
        RETURN
C
C R20-- CAROUSEL ROOM.  SPIN HIM OR KILL HIM.
C
20000   IF(PRSA.NE.LOOKW) GO TO 20500           !LOOK?
        CALL RSPEK(56)                          !DESCRIBE.
        IF(.NOT.CAROFF) CALL RSPEK(57)          !IF NOT FLIPPED, SPIN.
        RETURN
C
20500   IF((PRSA.EQ.WALKIW).AND.CAROZF) CALL JIGUP(58)  !WALKED IN.
        RETURN
C
C R21-- LLD ROOM.  HANDLE EXORCISE, DESCRIPTIONS.
C
21000   IF(PRSA.NE.LOOKW) GO TO 21500           !LOOK?
        CALL RSPEK(59)                          !DESCRIBE.
        IF(.NOT.LLDF) CALL RSPEK(60)            !IF NOT VANISHED, GHOSTS
        RETURN
C
21500   IF(PRSA.NE.EXORCW) RETURN               !EXORCISE?
        IF((OADV(BELL).EQ.WINNER).AND.(OADV(BOOK).EQ.WINNER).AND.
     1       (OADV(CANDL).EQ.WINNER)) GO TO 21600
        CALL RSPEK(62)                          !NOT EQUIPPED.
        RETURN
C
21600   IF(QHERE(GHOST,HERE)) GO TO 21700       !GHOST HERE?
        CALL JIGUP(61)                          !NOPE, EXORCISE YOU.
        RETURN
C
21700   CALL NEWST(GHOST,63,0,0,0)              !VANISH GHOST.
        LLDF=.TRUE.                             !OPEN GATE.
        RETURN
C
C R22-- LLD2-ROOM.  IS HIS HEAD ON A POLE?
C
22000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(64)                          !DESCRIBE.
        IF(ONPOLF) CALL RSPEK(65)               !ON POLE?
        RETURN
C
C R23-- DAM ROOM.  DESCRIBE RESERVOIR, PANEL.
C
23000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(66)                          !DESCRIBE.
        I=67
        IF(LWTIDF) I=68
        CALL RSPEK(I)                           !DESCRIBE RESERVOIR.
        CALL RSPEK(69)                          !DESCRIBE PANEL.
        IF(GATEF) CALL RSPEK(70)                !BUBBLE IS GLOWING.
        RETURN
C
C R24-- DECOMMITTED.
C
24000   RETURN
C
C R25-- CYCLOPS-ROOM.  DEPENDS ON CYCLOPS STATE, ASLEEP FLAG, MAGIC FLAG
C
25000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(606)                         !DESCRIBE.
        I=607                                   !ASSUME BASIC STATE.
        IF(RVCYC.GT.0) I=608                    !>0?  HUNGRY.
        IF(RVCYC.LT.0) I=609                    !<0?  THIRSTY.
        IF(CYCLOF) I=610                        !ASLEEP?
        IF(MAGICF) I=611                        !GONE?
        CALL RSPEK(I)                           !DESCRIBE.
        IF(.NOT.CYCLOF .AND.(RVCYC.NE.0))
     1       CALL RSPEK(193+IABS(RVCYC))     !CYCLOPS IS ANNOYED.
        RETURN
C
C R26-- DECOMMITTED.
C
26000   RETURN
C
C R27-- TREASURE ROOM.
C
27000   IF((PRSA.NE.WALKIW).OR. .NOT.THFACT)
     1       RETURN                          !WALKIN, THIEF ACTIVE?
        IF(OROOM(THIEF).NE.HERE)
     1       CALL NEWST(THIEF,82,HERE,0,0)   !NO, MATERIALIZE HIM.
        THFPOS=HERE                             !RESET SEARCH PATTERN.
        OFLAG2(THIEF)=OR(OFLAG2(THIEF),FITEBT)   !HE'S ANGRY.
        IF(OROOM(CHALI).EQ.HERE)
     1       OFLAG1(CHALI)=AND(OFLAG1(CHALI),COMPL(TAKEBT))
C
C       VANISH EVERYTHING IN ROOM
C
        J=0                                     !ASSUME NOTHING TO VANIS
        DO 27200 I=1,OLNT
          IF((I.EQ.CHALI).OR.(I.EQ.THIEF).OR..NOT.QHERE(I,HERE))
     1       GO TO 27200                     !HERE?
          J=83                                  !FLAG BYEBYE.
          OFLAG1(I)=AND(OFLAG1(I),COMPL(VISIBT))   !AWAY IT GOES.
27200   CONTINUE
        CALL RSPEK(J)                           !DESCRIBE.
        RETURN
C
C R28-- CLIFF FUNCTION.  SEE IF CARRYING INFLATED BOAT.
C
28000   DEFLAF=OADV(RBOAT).NE.WINNER            !TRUE IF NOT CARRYING.
        RETURN
C
C R29-- RIVR4 ROOM.  PLAY WITH BUOY.
C
29000   IF(.NOT.BUOYF.OR.(OADV(BUOY).NE.WINNER)) RETURN
        CALL RSPEK(84)                          !GIVE HINT,
        BUOYF=.FALSE.                           !THEN DISABLE.
        RETURN
C
C R30-- OVERFALLS.  DOOM.
C
30000   IF(PRSA.NE.LOOKW) CALL JIGUP(85)        !OVER YOU GO.
        RETURN
C
C R31-- BEACH ROOM.  DIG A HOLE.
C
31000   IF((PRSA.NE.DIGW).OR.(PRSO.NE.SHOVE)) RETURN
        RVSND=RVSND+1                           !INCREMENT DIG STATE.
        IF(RVSND.LT.1 .OR. RVSND.GT.5) CALL BUG(2,RVSND)
        GO TO (31100,31100,31100,31400,31500),RVSND !PROCESS STATE.
C
31100   CALL RSPEK(85+RVSND)                    !1-3... DISCOURAGE HIM.
        RETURN
C
31400   I=89                                    !ASSUME DISCOVERY.
        IF(AND(OFLAG1(STATU),VISIBT).NE.0) I=88 !ALREADY DONE.
        CALL RSPEK(I)
        OFLAG1(STATU)=OR(OFLAG1(STATU),VISIBT)   !MATERIALIZE STATUE.
        RETURN
C
31500   RVSND=0                                 !5... SAND COLLAPSES
        CALL JIGUP(90)                          !AND SO DOES HE.
        RETURN
C
C R32-- TCAVE ROOM.  DIG A HOLE IN GUANO.
C
32000   IF((PRSA.NE.DIGW).OR.(PRSO.NE.SHOVE)) RETURN
        I=91                                    !ASSUME NO GUANO.
        IF(.NOT. QHERE(GUANO,HERE)) GO TO 32100 !IS IT HERE?
        RVGUA=MIN0(4,RVGUA+1)           !YES, SET NEW STATE.
        I=91+RVGUA                              !GET NASTY REMARK.
32100   CALL RSPEK(I)                           !DESCRIBE.
        RETURN
C
C R33-- FALLS ROOM
C
33000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(96)                          !DESCRIBE.
        I=97                                    !ASSUME NO RAINBOW.
        IF(RAINBF) I=98                         !GOT ONE?
        CALL RSPEK(I)                           !DESCRIBE.
        RETURN
C
C R34-- LEDGE FUNCTION.  LEDGE CAN COLLAPSE.
C
34000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(100)                         !DESCRIBE.
        I=102                                   !ASSUME SAFE ROOM OK.
        IF(AND(RFLAG(MSAFE),RMUNG).NE.0) I=101 !IF MUNGED, ROOM GONE.
        CALL RSPEK(I)                           !DESCRIBE.
        RETURN
C
C R35-- SAFE ROOM.  STATE DEPENDS ON WHETHER SAFE BLOWN.
C
35000   IF(PRSA.NE.LOOKW) RETURN                !LOOK?
        CALL RSPEK(104)                         !DESCRIBE.
        I=105                                   !ASSUME OK.
        IF(SAFEF) I=106                         !BLOWN?
        CALL RSPEK(I)                           !DESCRIBE.
        RETURN
C
C R36-- MAGNET ROOM.  DESCRIBE, CHECK FOR SPINDIZZY DOOM.
C
36000   IF(PRSA.NE.LOOKW) GO TO 36500           !LOOK?
        CALL RSPEK(107)                         !DESCRIBE.
        RETURN
C
36500   IF((PRSA.NE.WALKIW).OR. .NOT.CAROFF) RETURN     !WALKIN ON FLIPP
        IF(CAROZF) GO TO 36600                  !ZOOM?
        CALL RSPEK(108)                         !NO, SPIN HIS COMPASS.
        RETURN
C
36600   CALL JIGUP(58)                          !YES, SPIN HIS INSIDES.
        RETURN
C
C R37-- CAGE ROOM.  IF SOLVED CAGE, MOVE TO OTHER CAGE ROOM.
C
37000   IF(CAGESF) F=MOVTO(CAGER)               !IF SOLVED, MOVE.
        RETURN
C
        END
C VEHIC- EXECUTE VEHICLE FUNCTION
C
C DECLARATIONS
C
        LOGICAL FUNCTION VEHIC(N)
        IMPLICIT INTEGER(A-Z)
        LOGICAL OAPPL
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
        VEHIC=.FALSE.                           !ASSUME LOSES.
        AV=AVEHIC(WINNER)                       !GET VEHICLE.
        IF(AV.EQ.0) RETURN
        AV=OACTIO(AV)                           !GET ACTION.
        IF(AV.NE.0) VEHIC=OAPPL(AV,N)           !IF THERE, EXECUTE.
        RETURN
        END
C VAPPL- MAIN VERB PROCESSING ROUTINE
C
C DECLARATIONS
C
        LOGICAL FUNCTION VAPPL(RI)
        IMPLICIT INTEGER (A-Z)
        LOGICAL LIT,OBJAC
        LOGICAL QEMTY,RINFO,CLOKD
        LOGICAL QOPEN,EDIBLE,DRKBLE
        LOGICAL TAKE,PUT,DROP,WALK
        LOGICAL QHERE,SVERB,F,OAPPL
C
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,
     1       LTSHFT,BLOC,MUNGRM,HS
C
C ROOMS
C
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
C
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
        COMMON /OINDX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL
        COMMON /OINDX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG
        COMMON /OINDX/ LEAVE,TROLL,AXE
        COMMON /OINDX/ RKNIF,KEYS,ICE,BAR
        COMMON /OINDX/ COFFI,TORCH,TBASK,FBASK,IRBOX
        COMMON /OINDX/ GHOST,TRUNK,BELL,BOOK,CANDL
        COMMON /OINDX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI
        COMMON /OINDX/ THIEF,STILL,WINDO,GRATE,DOOR
        COMMON /OINDX/ HPOLE,LEAK,RBUTT,RAILI
        COMMON /OINDX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT
        COMMON /OINDX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO
        COMMON /OINDX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE
        COMMON /OINDX/ GNOME,BLABE,DBALL
        COMMON /OINDX/ LCASE,CAGE,RCAGE,SPHER,SQBUT
        COMMON /OINDX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE
        COMMON /OINDX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH
        COMMON /OINDX/ ITOBJ,EVERY,VALUA,OPLAY
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
        COMMON /AINDX/ PLAYER,AROBOT
C
C VERBS
C
        COMMON /VINDX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW
        COMMON /VINDX/ WALKIW,FIGHTW,FOOW
        COMMON /VINDX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW
        COMMON /VINDX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW
        COMMON /VINDX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW
        COMMON /VINDX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW
        COMMON /VINDX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW
        COMMON /VINDX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW
        COMMON /VINDX/ MUNGW,KILLW,ATTACW,SWINGW
        COMMON /VINDX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW
        COMMON /VINDX/ DIGW,LEAPW
C
        QOPEN(R)=AND(OFLAG2(R),OPENBT).NE.0
        EDIBLE(R)=AND(OFLAG1(R),FOODBT).NE.0
        DRKBLE(R)=AND(OFLAG1(R),DRNKBT).NE.0
C
        DATA MXNOP/49/,MXSMP/99/
C
        VAPPL=.TRUE.                            !ASSUME WINS.
        IF(PRSA.EQ.WALKW)GO TO 1012
        IF(PRSO.GT.0) ODO2=ODESC2(PRSO)         !SET UP DESCRIPTORS.
        IF(PRSI.GT.0) ODI2=ODESC2(PRSI)
 1012   CONTINUE
        AV=AVEHIC(WINNER)
        RMK=372+RND(6)                          !REMARK FOR HACK-HACKS.
C
        IF(RI.EQ.0) CALL BUG(7,RI)              !ZERO IS VERBOTEN.
        IF(RI.LE.MXNOP) RETURN                  !NOP?
        IF(RI.LE.MXSMP) GO TO 100               !SIMPLE VERB?
        IF((RI-MXSMP).LT.1 .OR. (RI-MXSMP).GT.51) CALL BUG(7,RI)
        GO TO (18000,20000,
     2       22000,23000,24000,25000,26000,27000,28000,29000,30000,
     3 31000,32000,33000,34000,35000,36000,      38000,39000,40000,
     4 41000,42000,43000,44000,45000,46000,47000,48000,49000,50000,
     5 51000,52000,53000,      55000,56000,      58000,59000,60000,
     6             63000,64000,65000,66000,      68000,69000,70000,
     7 71000,72000,73000,74000,            77000,78000),
     8       (RI-MXSMP)
C
C ALL VERB PROCESSORS RETURN HERE TO DECLARE FAILURE.
C
10      VAPPL=.FALSE.                           !LOSE.
        RETURN
C
C SIMPLE VERBS ARE HANDLED EXTERNALLY.
C
100     VAPPL=SVERB(RI)
        RETURN
C
C
C V100--        READ.  OUR FIRST REAL VERB.
C
18000   IF(LIT(HERE)) GO TO 18100               !ROOM LIT?
        CALL RSPEK(356)                         !NO, CANT READ.
        RETURN
C
18100   IF(PRSI.EQ.0) GO TO 18200               !READ THROUGH OBJ?
        IF(AND(OFLAG1(PRSI),TRANBT).NE.0) GO TO 18200
        CALL RSPSB(357,ODI2)                    !NOT TRANSPARENT.
        RETURN
C
18200   IF(AND(OFLAG1(PRSO),READBT).NE.0) GO TO 18300
        CALL RSPSB(358,ODO2)                    !NOT READABLE.
        RETURN
C
18300   IF(.NOT.OBJAC(X)) CALL RSPEK(OREAD(PRSO))
        RETURN
C
C V101--        MELT.  UNLESS OBJECT HANDLES, JOKE.
C
20000   IF(.NOT.OBJAC(X)) CALL RSPSB(361,ODO2)
        RETURN
C
C V102--        INFLATE.  WORKS ONLY WITH BOATS.
C
22000   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        I=368                                   !JOKE.
        IF(PRSO.EQ.RBOAT) I=367                 !SPECIAL JOKE FOR BOAT.
        CALL RSPEK(I)
        RETURN
C
C V103--        DEFLATE.
C
23000   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        CALL RSPEK(369)                         !NO, JOKE.
        RETURN
C
C V104--        ALARM.  IF SLEEPING, WAKE HIM UP.
C
24000   IF(AND(OFLAG2(PRSO),SLEPBT).EQ.0) GO TO 24100
        VAPPL=OBJAC(X)                          !SLEEPING, LET OBJ DO.
        RETURN
C
24100   CALL RSPSB(370,ODO2)                    !JOKE.
        RETURN
C
C V105--        EXORCISE.  OBJECTS HANDLE.
C
25000   F=OBJAC(X)                              !OBJECTS HANDLE.
        RETURN
C
C V106--        PLUG.  LET OBJECTS HANDLE.
C
26000   IF(.NOT.OBJAC(X)) CALL RSPEK(371)
        RETURN
C
C V107--        KICK.  IF OBJECT IGNORES, JOKE.
C
27000   IF(.NOT.OBJAC(X)) CALL RSPS2(378,ODO2,RMK)
        RETURN
C
C V108--        WAVE.  SAME.
C
28000   IF(.NOT.OBJAC(X)) CALL RSPS2(379,ODO2,RMK)
        RETURN
C
C V109,V110--   RAISE, LOWER.  SAME.
C
29000   CONTINUE
30000   IF(.NOT.OBJAC(X)) CALL RSPS2(380,ODO2,RMK)
        RETURN
C
C V111--        RUB.  SAME.
C
31000   IF(.NOT.OBJAC(X)) CALL RSPS2(381,ODO2,RMK)
        RETURN
C
C V112--        PUSH.  SAME.
C
32000   IF(.NOT.OBJAC(X)) CALL RSPS2(382,ODO2,RMK)
        RETURN
C
C V113--        UNTIE.  IF OBJECT IGNORES, JOKE.
C
33000   IF(OBJAC(X)) RETURN                     !OBJECT HANDLE?
        I=383                                   !NO, NOT TIED.
        IF(AND(OFLAG2(PRSO),TIEBT).EQ.0) I=384 !NOT TIEABLE.
        CALL RSPEK(I)
        RETURN
C
C V114--        TIE.  NEVER REALLY WORKS.
C
34000   IF(AND(OFLAG2(PRSO),TIEBT).NE.0) GO TO 34100
        CALL RSPEK(385)                         !NOT TIEABLE.
        RETURN
C
34100   IF(.NOT.OBJAC(X)) CALL RSPSB(386,ODO2)   !JOKE.
        RETURN
C
C V115--        TIE UP.  NEVER REALLY WORKS.
C
35000   IF(AND(OFLAG2(PRSI),TIEBT).NE.0) GO TO 35100
        CALL RSPSB(387,ODO2)                    !NOT TIEABLE.
        RETURN
C
35100   I=388                                   !ASSUME VILLAIN.
        IF(AND(OFLAG2(PRSO),VILLBT).EQ.0) I=389
        CALL RSPSB(I,ODO2)                      !JOKE.
        RETURN
C
C V116--        TURN.  OBJECT MUST HANDLE.
C
36000   IF(AND(OFLAG1(PRSO),TURNBT).NE.0) GO TO 36100
        CALL RSPEK(390)                         !NOT TURNABLE.
        RETURN
C
36100   IF(AND(OFLAG1(PRSI),TOOLBT).NE.0) GO TO 36200
        CALL RSPSB(391,ODI2)                    !NOT A TOOL.
        RETURN
C
36200   VAPPL=OBJAC(X)                          !LET OBJECT HANDLE.
        RETURN
C
C V117--        BREATHE.  BECOMES INFLATE WITH LUNGS.
C
38000   PRSA=INFLAW
        PRSI=LUNGS
        GO TO 22000                             !HANDLE LIKE INFLATE.
C
C V118--        KNOCK.  MOSTLY JOKE.
C
39000   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        I=394                                   !JOKE FOR DOOR.
        IF(AND(OFLAG1(PRSO),DOORBT).EQ.0) I=395
        CALL RSPSB(I,ODO2)                      !JOKE FOR NONDOORS TOO.
        RETURN
C
C V119--        LOOK.
C
40000   IF(PRSO.NE.0) GO TO 41500               !SOMETHING TO LOOK AT?
        VAPPL=RINFO(.TRUE.)                     !HANDLED BY RINFO.
        RETURN
C
C V120--        EXAMINE.
C
41000   IF(PRSO.NE.0) GO TO 41500               !SOMETHING TO EXAMINE?
        VAPPL=RINFO(.FALSE.)                    !HANDLED BY RINFO.
        RETURN
C
41500   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        I=OREAD(PRSO)                           !GET READING MATERIAL.
        IF(I.EQ.0) I=429                        !DEFAULT IF NO READING.
        CALL RSPSB(I,ODO2)                      !PROCESS.
        PRSA=FOOW                               !DEFUSE ROOM PROCESSORS.
        RETURN
C
C V121--        SHAKE.  IF HOLLOW OBJECT, SOME ACTION.
C
42000   IF(OBJAC(X)) RETURN                     !OBJECT HANDLE?
        IF(QEMTY(PRSO)) GO TO 10                !EMPTY?  FAILS.
        IF(QOPEN(PRSO)) GO TO 42300             !OPEN?  SPILL.
        CALL RSPSB(396,ODO2)                    !NO, DESCRIBE NOISE.
        RETURN
C
42300   DO 42500 I=1,OLNT                       !SPILL CONTENTS.
          IF(OCAN(I).NE.PRSO) GO TO 42500       !INSIDE?
          CALL NEWST(I,0,HERE,0,0)              !ONTO FLOOR.
          IF(AV.NE.0) CALL NEWST(I,0,0,AV,0)    !OR INTO VEHICLE.
42500   CONTINUE
        CALL RSPSB(397,ODO2)                    !SPILL THE WORKS.
        RETURN
C
C V122--        MOVE.  MOSTLY JOKES.
C
43000   IF(PRSO.EQ.0) GO TO 10                  !NOTHING TO MOVE?
        IF(QHERE(PRSO,HERE)) GO TO 43100        !IN ROOM?
        CALL RSPEK(398)                         !NO, JOKE.
        RETURN
C
43100   IF(.NOT.OBJAC(X)) CALL RSPSB(399,ODO2)
        RETURN
C
C V123--        TURN ON.
C
44000   F=LIT(HERE)                             !RECORD IF LIT.
        IF(OBJAC(X)) GO TO 44300                !OBJ HANDLE?
        IF((AND(OFLAG1(PRSO),LITEBT).NE.0).AND.
     1       (OADV(PRSO).EQ.WINNER)) GO TO 44100
        CALL RSPEK(400)                         !CANT DO IT.
        RETURN
C
44100   IF(AND(OFLAG1(PRSO),ONBT).EQ.0) GO TO 44200
        CALL RSPEK(401)                         !ALREADY ON.
        RETURN
C
44200   OFLAG1(PRSO)=OR(OFLAG1(PRSO),ONBT)       !TURN IT ON.
        CALL RSPSB(404,ODO2)
44300   IF(.NOT.F .AND.LIT(HERE)) F=RINFO(.FALSE.)      !ROOM NEWLY LIT.
        RETURN
C
C V124--        TURN OFF.
C
45000   IF(OBJAC(X)) GO TO 45300                !OBJ HANDLE?
        IF((AND(OFLAG1(PRSO),LITEBT).NE.0).AND.
     1       (OADV(PRSO).EQ.WINNER)) GO TO 45100
        CALL RSPEK(402)                         !CANT DO IT.
        RETURN
C
45100   IF(AND(OFLAG1(PRSO),ONBT).NE.0) GO TO 45200
        CALL RSPEK(403)                         !ALREADY OFF.
        RETURN
C
45200   OFLAG1(PRSO)=AND(OFLAG1(PRSO),COMPL(ONBT))
        CALL RSPSB(405,ODO2)
45300   IF(.NOT.LIT(HERE)) CALL RSPEK(406)      !MAY BE DARK.
        RETURN
C
C V125--        OPEN.  A FINE MESS.
C
46000   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        IF(AND(OFLAG1(PRSO),CONTBT).NE.0) GO TO 46100
46050   CALL RSPSB(407,ODO2)                    !NOT OPENABLE.
        RETURN
C
46100   IF(OCAPAC(PRSO).NE.0) GO TO 46200
        CALL RSPSB(408,ODO2)                    !NOT OPENABLE.
        RETURN
C
46200   IF(.NOT.QOPEN(PRSO)) GO TO 46225
        CALL RSPEK(412)                         !ALREADY OPEN.
        RETURN
C
46225   OFLAG2(PRSO)=OR(OFLAG2(PRSO),OPENBT)     !OPEN IT.
        IF((AND(OFLAG1(PRSO),TRANBT).NE.0).OR.QEMTY(PRSO))
     1       GO TO 46300
        CALL RSPSB(410,ODO2)                    !CONTENTS VISIBLE.
        DO 46250 I=1,OLNT
          IF(OCAN(I).EQ.PRSO) CALL RSPSB(502,ODESC2(I))
46250   CONTINUE
        RETURN
C
46300   CALL RSPEK(409)                         !DONE
        RETURN
C
C V126--        CLOSE.
C
47000   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        IF(AND(OFLAG1(PRSO),CONTBT).EQ.0) GO TO 46050
        IF(OCAPAC(PRSO).NE.0) GO TO 47100
        CALL RSPSB(411,ODO2)                    !NOT CLOSABLE.
        RETURN
C
47100   IF(QOPEN(PRSO)) GO TO 47200             !OPEN?
        CALL RSPEK(413)                         !NO, JOKE.
        RETURN
C
47200   OFLAG2(PRSO)=AND(OFLAG2(PRSO),COMPL(OPENBT))
        CALL RSPEK(414)                         !DONE.
        RETURN
C
C V127--        FIND.  BIG MEGILLA.
C
48000   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        IF(PRSO.EQ.0) GO TO 10          !ANY OBJ?
        I=415                                   !DEFAULT CASE.
        IF(QHERE(PRSO,HERE)) GO TO 48300        !IN ROOM?
        IF(OADV(PRSO).EQ.WINNER) GO TO 48200    !ON WINNER?
        J=OCAN(PRSO)                            !DOWN ONE LEVEL.
        IF(J.EQ.0) GO TO 10
        IF(((AND(OFLAG1(J),TRANBT).EQ.0).AND.
     2 (.NOT.QOPEN(J).OR.(AND(OFLAG1(J),(DOORBT+CONTBT)).EQ.0))))
     3       GO TO 10                        !IF NOT VISIBLE, PUNT.
        I=417                                   !ASSUME IN ROOM.
        IF(QHERE(J,HERE)) GO TO 48100
        IF(OADV(J).NE.WINNER) GO TO 10          !NOT HERE OR ON PERSON.
        I=418
48100   CALL RSPSB(I,ODESC2(J))                 !DESCRIBE FINDINGS.
        RETURN
C
48200   I=416
48300   CALL RSPSB(I,ODO2)                      !DESCRIBE FINDINGS.
        RETURN
C
C V128--        WAIT.  RUN CLOCK DEMON.
C
49000   CALL RSPEK(419)                         !TIME PASSES.
        DO 49100 I=1,3
          IF(CLOKD(X)) RETURN
49100   CONTINUE
        RETURN
C
C V129--        SPIN.  NOT IMPLEMENTED.
C
50000   RETURN
C
C V130--        BOARD.  WORKS WITH VEHICLES.
C
51000   IF(QHERE(PRSO,HERE)) GO TO 51100        !HERE?
        CALL RSPSB(420,ODO2)                    !NO, JOKE.
        RETURN
C
51100   IF(AND(OFLAG2(PRSO),VEHBT).NE.0) GO TO 51200
        CALL RSPSB(421,ODO2)                    !NOT VEHICLE, JOKE.
        RETURN
C
51200   IF(AV.EQ.0) GO TO 51300                 !ALREADY GOT ONE?
        CALL RSPSB(422,ODO2)                    !YES, JOKE.
        RETURN
C
51300   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        CALL RSPSB(423,ODO2)                    !DESCRIBE.
        AVEHIC(WINNER)=PRSO
        IF(WINNER.NE.PLAYER) OCAN(AOBJ(WINNER))=PRSO
        RETURN
C
C V131--        DISEMBARK.
C
52000   IF(AV.EQ.PRSO) GO TO 52100              !FROM VEHICLE?
        CALL RSPEK(424)                         !NO, JOKE.
        RETURN
C
52100   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        IF(AND(RFLAG(HERE),RLAND).NE.0) GO TO 52200
        CALL RSPEK(425)                         !NOT ON LAND.
        RETURN
C
52200   AVEHIC(WINNER)=0
        CALL RSPEK(426)
        IF(WINNER.NE.PLAYER) CALL NEWST(AOBJ(WINNER),0,HERE,0,0)
        RETURN
C
C V132--        TAKE.  HANDLED EXTERNALLY.
C
53000   VAPPL=TAKE(.TRUE.)
        RETURN
C
C V133--        INVENTORY.  PROCESSED EXTERNALLY.
C
55000   CALL INVEN(WINNER)
        RETURN
C
C V134--        FILL.  STRANGE DOINGS WITH WATER.
C
56000   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        IF((PRSI.EQ.0).OR.(PRSI.EQ.WATER)) GO TO 56100
        CALL RSPS2(444,ODO2,ODI2)               !JOKE.
        RETURN
C
56100   IF((AND(RFLAG(HERE),(RFILL+RWATER)).NE.0).OR.
     1 ((OCAN(WATER).EQ.AV).AND.(AV.NE.0)).OR.
     2 QHERE(WATER,HERE)) GO TO 56200
        CALL RSPEK(446)                         !NO WATER HERE.
        RETURN
C
56200   PRSA=TAKEW                              !TAKE WATER.
        PRSI=PRSO
        PRSO=WATER
        VAPPL=OAPPL(OACTIO(WATER),0)
        RETURN
C
C V135,V136--   EAT/DRINK
C
58000   CONTINUE
59000   IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        IF(EDIBLE(PRSO).AND.(OADV(PRSO).EQ.WINNER))
     1       GO TO 59200                     !EDIBLE & HAS IT.
        IF(DRKBLE(PRSO).AND.(OCAN(PRSO).NE.0))
     1       GO TO 59400                     !DRKBLE & INSIDE.
59100   I=453                                   !ASSUME NOT FOOD.
        IF(EDIBLE(PRSO).OR.DRKBLE(PRSO)) I=454  !NOT ACCESSIBLE.
        CALL RSPSB(I,ODO2)
        RETURN
C
59200   IF(PRSA.EQ.DRINKW) GO TO 59300          !DRINK FOOD?
        CALL NEWST(PRSO,455,0,0,0)              !NO, IT DISAPPEARS.
        RETURN
C
59300   CALL RSPEK(456)                         !YES, JOKE.
        RETURN
C
59400   IF(OADV(OCAN(PRSO)).NE.WINNER) GO TO 59100
        IF(QOPEN(OCAN(PRSO))) GO TO 59500       !CONT OPEN?
        CALL RSPEK(457)                         !NO, JOKE.
        RETURN
C
59500   CALL NEWST(PRSO,458,0,0,0)              !GONE.
        RETURN
C
C V137--        BURN.  COMPLICATED.
C
60000   IF(AND(OFLAG1(PRSI),(FLAMBT+LITEBT+ONBT)).NE.
     1       (FLAMBT+LITEBT+ONBT)) GO TO 60400
        IF(OBJAC(X)) RETURN                     !OBJ HANDLE?
        IF(AV.NE.BALLO) GO TO 60050             !BALLOON?
        IF(OAPPL(OACTIO(BALLO),0)) RETURN       !DID IT HANDLE?
60050   IF(AND(OFLAG1(PRSO),BURNBT).EQ.0) GO TO 60300
        IF(OADV(PRSO).NE.WINNER) GO TO 60100    !CARRYING IT?
        CALL RSPSB(459,ODO2)
        CALL JIGUP(460)
        RETURN
C
60100   J=OCAN(PRSO)                            !GET CONTAINER.
        IF(QHERE(PRSO,HERE).OR. ((AV.NE.0).AND.(J.EQ.AV)))
     1       GO TO 60200                     !REACHABLE?
        IF(J.EQ.0) GO TO 60150                  !INSIDE?
        IF(.NOT.QOPEN(J)) GO TO 60150           !OPEN?
        IF(QHERE(J,HERE).OR.((AV.NE.0).AND.(OCAN(J).EQ.AV)))
     1       GO TO 60200                     !REACHABLE?
60150   CALL RSPEK(461)                         !CANT REACH IT.
        RETURN
C
60200   CALL RSPSB(462,ODO2)                    !BURN IT.
        CALL NEWST(PRSO,0,0,0,0)
        RETURN
C
60300   CALL RSPSB(463,ODO2)                    !CANT BURN IT.
        RETURN
C
60400   CALL RSPSB(301,ODI2)            !CANT BURN IT WITH THAT.
        RETURN
C
C V138--        MUNG.  GO TO COMMON ATTACK CODE.
C
63000   I=466                                   !CHOOSE PHRASE.
        IF(AND(OFLAG2(PRSO),VILLBT).NE.0) GO TO 66300
        IF(.NOT.OBJAC(X)) CALL RSPS2(466,ODO2,RMK)
        RETURN
C
C V139--        KILL.  GO TO COMMON ATTACK CODE.
C
64000   I=467                                   !CHOOSE PHRASE.
        GO TO 66100
C
C V140--        SWING.  INVERT OBJECTS, FALL THRU TO ATTACK.
C
65000   J=PRSO                                  !INVERT.
        PRSO=PRSI
        PRSI=J
        J=ODO2
        ODO2=ODI2
        ODI2=J
        PRSA=ATTACW                             !FOR OBJAC.
C
C V141--        ATTACK.  FALL THRU TO ATTACK CODE.
C
66000   I=468
C
C COMMON MUNG/ATTACK/SWING/KILL CODE.
C
66100   IF(PRSO.NE.0) GO TO 66200               !ANYTHING?
        CALL RSPEK(469)                         !NO, JOKE.
        RETURN
C
66200   IF(AND(OFLAG2(PRSO),VILLBT).NE.0) GO TO 66300
        CALL RSPSB(470,ODO2)                    !NOT A VILLAIN.
        RETURN
C
66300   J=471                                   !ASSUME NO WEAPON.
        IF(PRSI.EQ.0) GO TO 66500
        IF(AND(OFLAG2(PRSI),WEAPBT).EQ.0) GO TO 66400
        IF(.NOT.OBJAC(X))
     1 I=BLOW(PLAYER,PRSO,ORAND(PRSI),.TRUE.,0) !STRIKE BLOW.
        RETURN
C
66400   J=472                                   !NOT A WEAPON.
66500   CALL RSPS2(I,ODO2,J)                    !JOKE.
        RETURN
C
C V142--        WALK.  PROCESSED EXTERNALLY.
C
68000   VAPPL=WALK(X)
        RETURN
C
C V143--        TELL.  PROCESSED IN GAME.
C
69000   CALL RSPEK(603)
        RETURN
C
C V144--        PUT.  PROCESSED EXTERNALLY.
C
70000   VAPPL=PUT(.TRUE.)
        RETURN
C
C V145,V146,V147,V148-- DROP/GIVE/POUR/THROW
C
71000   CONTINUE
72000   CONTINUE
73000   CONTINUE
74000   VAPPL=DROP(.FALSE.)
        RETURN
C
C V149--        SAVE
C
C SAVGM
77000   CALL DLIN2(6HDUNGE ,2HSA,0,0)
C WE NEVER RETURN HERE.
C
C V150--        RESTORE
C
C RSTGM
78000   CALL DLIN2(6HDUNGE ,2HRS,0,0)
C OR HERE EITHER.
C
        END
C AAPPL- APPLICABLES FOR ADVENTURERS
C
C DECLARATIONS
C
        LOGICAL FUNCTION AAPPL(RI)
        IMPLICIT INTEGER (A-Z)
        LOGICAL F,MOVTO
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
C
C ROOMS
C
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
C
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE
C
        COMMON /RINDX/ WHOUS,LROOM,CELLA
        COMMON /RINDX/ MTROL,MAZE1
        COMMON /RINDX/ MGRAT,MAZ15
        COMMON /RINDX/ FORE1,CLEAR,RESER
        COMMON /RINDX/ STREA,EGYPT,ECHOR
        COMMON /RINDX/ TSHAF
        COMMON /RINDX/ BSHAF,MMACH,DOME,MTORC
        COMMON /RINDX/ CAROU
        COMMON /RINDX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT
        COMMON /RINDX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL
        COMMON /RINDX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR
        COMMON /RINDX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4
        COMMON /RINDX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER
        COMMON /RINDX/ CAGED,TWELL,BWELL,ALICE,ALISM,ALITR
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
        COMMON /OINDX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL
        COMMON /OINDX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG
        COMMON /OINDX/ LEAVE,TROLL,AXE
        COMMON /OINDX/ RKNIF,KEYS,ICE,BAR
        COMMON /OINDX/ COFFI,TORCH,TBASK,FBASK,IRBOX
        COMMON /OINDX/ GHOST,TRUNK,BELL,BOOK,CANDL
        COMMON /OINDX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI
        COMMON /OINDX/ THIEF,STILL,WINDO,GRATE,DOOR
        COMMON /OINDX/ HPOLE,LEAK,RBUTT,RAILI
        COMMON /OINDX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT
        COMMON /OINDX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO
        COMMON /OINDX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE
        COMMON /OINDX/ GNOME,BLABE,DBALL
        COMMON /OINDX/ LCASE,CAGE,RCAGE,SPHER,SQBUT
        COMMON /OINDX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE
        COMMON /OINDX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH
        COMMON /OINDX/ ITOBJ,EVERY,VALUA,OPLAY
C
C CLOCK INTERRUPTS
C
        LOGICAL CFLAG
        COMMON /CEVNT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)
C
        COMMON /CINDX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
        COMMON /AINDX/ PLAYER,AROBOT
C
C VERBS
C
        COMMON /VINDX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW
        COMMON /VINDX/ WALKIW,FIGHTW,FOOW
        COMMON /VINDX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW
        COMMON /VINDX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW
        COMMON /VINDX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW
        COMMON /VINDX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW
        COMMON /VINDX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW
        COMMON /VINDX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW
        COMMON /VINDX/ MUNGW,KILLW,ATTACW,SWINGW
        COMMON /VINDX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW
        COMMON /VINDX/ DIGW,LEAPW
C
C FLAGS
C
        LOGICAL FLAGS(33)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF
        LOGICAL GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,
     5       GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ BTIEF,BINFF
        EQUIVALENCE (FLAGS(1),TROLLF)
C
        AAPPL=.TRUE.                            !ASSUME WINS.
        IF(RI.NE.1) CALL BUG(11,RI)
        GO TO (1000),RI                         !BRANCH ON ADV.
C
C A1--  ROBOT.  PROCESS MOST COMMANDS GIVEN TO ROBOT.
C
1000    IF((PRSA.NE.RAISEW).OR.(PRSO.NE.CAGE)) GO TO 1200
        CFLAG(CEVSPH)=.FALSE.                   !ROBOT RAISED CAGE.
        WINNER=PLAYER                           !RESET FOR PLAYER.
        F=MOVTO(CAGER)                          !MOVE TO NEW ROOM.
        CALL NEWST(CAGE,567,CAGER,0,0)          !INSTALL CAGE IN ROOM.
        CALL NEWST(ROBOT,0,CAGER,0,0)           !INSTALL ROBOT IN ROOM.
        AROOM(AROBOT)=CAGER                     !ALSO MOVE ROBOT/ADV.
        CAGESF=.TRUE.                           !CAGE SOLVED.
        OFLAG1(CAGE)=AND(OR(OFLAG1(CAGE),TAKEBT) ,COMPL(NDSCBT))
        OFLAG1(ROBOT)=AND(OFLAG1(ROBOT),COMPL(NDSCBT))
        OFLAG1(SPHER)=OR(OFLAG1(SPHER),TAKEBT)   !RESET FLAGS.
        RETURN
C
1200    IF((PRSA.NE.DRINKW).AND.(PRSA.NE.EATW)) GO TO 1300
        CALL RSPEK(568)                         !EAT OR DRINK, JOKE.
        RETURN
C
1300    IF(PRSA.NE.READW) GO TO 1400            !READ,
        CALL RSPEK(569)                         !JOKE.
        RETURN
C
1400    AAPPL=.FALSE.                           !ASSUME LEGIT COMMAND.
        IF((PRSA.EQ.WALKW).OR.(PRSA.EQ.TAKEW).OR.(PRSA.EQ.DROPW)
     1 .OR.(PRSA.EQ.PUTW).OR.(PRSA.EQ.PUSHW).OR.(PRSA.EQ.THROWW)
     2 .OR.(PRSA.EQ.TURNW).OR.(PRSA.EQ.LEAPW)) RETURN
        AAPPL=.TRUE.                            !ROBOT CANT EXECUTE IT,
        CALL RSPEK(570)                         !JOKE.
        RETURN
C
        END
C ENDMV-      EXECUTE END OF MOVE FUNCTIONS.
C
C DECLARATIONS
C
        SUBROUTINE ENDMV(FLAG)
        IMPLICIT INTEGER(A-Z)
        LOGICAL F,CLOKD,FLAG,VEHIC
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C
C VILLAINS AND DEMONS
C
        LOGICAL THFFLG,SWDACT,THFACT
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA
C
        IF(.NOT.FLAG) CALL RSPEK(341)           !DEFAULT REMARK.
        IF(THFACT) CALL THEFD                   !THIEF DEMON.
        IF(PRSWON) CALL FIGHT                   !FIGHT DEMON.
        IF(SWDACT) CALL SORDD                   !SWORD DEMON.
        IF(PRSWON) F=CLOKD(X)                   !CLOCK DEMON.
        IF(PRSWON) F=VEHIC(2)                   !VEHICLE READOUT.
        RETURN
        END
C VALUC- HANDLES VALUABLES/EVERYTHING
C
C DECLARATIONS
C
        SUBROUTINE VALUC(V)
        IMPLICIT INTEGER (A-Z)
        LOGICAL LIT,F,F1,TAKE,PUT,DROP,NOTVAL,QHERE
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
C VERBS
C
        COMMON /VINDX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW
        COMMON /VINDX/ WALKIW,FIGHTW,FOOW
        COMMON /VINDX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW
        COMMON /VINDX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW
        COMMON /VINDX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW
        COMMON /VINDX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW
        COMMON /VINDX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW
        COMMON /VINDX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW
        COMMON /VINDX/ MUNGW,KILLW,ATTACW,SWINGW
        COMMON /VINDX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW
        COMMON /VINDX/ DIGW,LEAPW
        NOTVAL(R)=(SAVEP.EQ.V).AND.(OTVAL(R).LE.0)
C
        F=.TRUE.                                !ASSUME NO ACTIONS.
        SAVEP=PRSO                              !SAVE PRSO.
        SAVEH=HERE                              !SAVE HERE.
        IF(LIT(HERE)) GO TO 100                 !LIT?
        CALL RSPEK(579)                         !NO, LOSE.
        RETURN
C
100     IF(PRSA.NE.TAKEW) GO TO 1000            !TAKE EVERY/VALUA?
        DO 500 PRSO=1,OLNT                      !LOOP THRU OBJECTS.
          IF(.NOT.QHERE(PRSO,HERE).OR.
     1       (AND(OFLAG1(PRSO),VISIBT).EQ.0).OR.
     2       (AND(OFLAG2(PRSO),ACTRBT).NE.0).OR.
     3       NOTVAL(PRSO)) GO TO 500
          IF((AND(OFLAG1(PRSO),TAKEBT).EQ.0).AND.
     1       (AND(OFLAG2(PRSO),TRYBT).EQ.0)) GO TO 500
          F=.FALSE.
          CALL RSPSB(580,ODESC2(PRSO))
          F1=TAKE(.TRUE.)
          IF(SAVEH.NE.HERE) RETURN
500     CONTINUE
        GO TO 3000
C
1000    IF(PRSA.NE.DROPW) GO TO 2000            !DROP EVERY/VALUA?
        DO 1500 PRSO=1,OLNT                     !LOOP THRU OBJECTS.
          IF((OADV(PRSO).NE.WINNER).OR.NOTVAL(PRSO))
     1       GO TO 1500
          F=.FALSE.
          CALL RSPSB(580,ODESC2(PRSO))
          F1=DROP(.TRUE.)
          IF(SAVEH.NE.HERE) RETURN
1500    CONTINUE
        GO TO 3000
C
2000    IF(PRSA.NE.PUTW) RETURN                 !PUT EVERY/VALUA?
        DO 2500 PRSO=1,OLNT                     !LOOP THRU OBJECTS.
          IF((OADV(PRSO).NE.WINNER)
     1       .OR.(PRSO.EQ.PRSI).OR.NOTVAL(PRSO).OR.
     2       (AND(OFLAG1(PRSO),VISIBT).EQ.0)) GO TO 2500
          F=.FALSE.
          CALL RSPSB(580,ODESC2(PRSO))
          F1=PUT(.TRUE.)
          IF(SAVEH.NE.HERE) RETURN
2500    CONTINUE
C
3000    I=581
        IF(SAVEP.EQ.V) I=582                    !CHOOSE MESSAGE.
        IF(F) CALL RSPEK(I)                     !IF NOTHING, REPORT.
        RETURN
        END
C FNDXT- FIND EXIT FROM ROOM
C
C DECLARATIONS
C
        LOGICAL FUNCTION FNDXT(DIR,RM)
        IMPLICIT INTEGER (A-Z)
C
C ROOMS
C
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
C
C EXITS
C
        COMMON /EXITS/ XLNT,TRAVEL(600)
C
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ
        EQUIVALENCE (XFLAG,XOBJ)
C
        COMMON /XPARS/ XRMASK,XDMASK,XFMASK,XFSHFT,XASHFT,
     1       XELNT(4),XNORM,XNO,XCOND,XDOOR,XLFLAG
C
        FNDXT=.TRUE.                            !ASSUME WINS.
        XI=REXIT(RM)                            !FIND FIRST ENTRY.
        IF(XI.EQ.0) GO TO 1000                  !NO EXITS?
C
100     I=TRAVEL(XI)                            !GET ENTRY.
        XROOM1=AND(I,XRMASK)                     !ISOLATE ROOM.
        XTYPE=AND(INT(AND(I,COMPL(XLFLAG)))/XFSHFT,XFMASK)+1
        IF((XTYPE.LT.1).OR.(XTYPE.GT.4)) CALL BUG(10,XTYPE)
        GO TO (110,120,130,130),XTYPE           !BRANCH ON ENTRY.
C
130     XOBJ=AND(TRAVEL(XI+2),XRMASK)           !DOOR/CEXIT- GET OBJ/FLA
        XACTIO=TRAVEL(XI+2)/XASHFT
120     XSTRNG=TRAVEL(XI+1)                     !DOOR/CEXIT/NEXIT - STRI
110     XI=XI+XELNT(XTYPE)                      !ADVANCE TO NEXT ENTRY.
        IF(AND(I,XDMASK).EQ.DIR) RETURN        !MATCH?
        IF(AND(I,XLFLAG).EQ.0) GO TO 100       !LAST ENTRY?
1000    FNDXT=.FALSE.                           !YES, LOSE.
        RETURN
        END
$
