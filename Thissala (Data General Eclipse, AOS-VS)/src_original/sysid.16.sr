        ;==================================;
        ; AOS/VS - SYSTEM CALL DEFINITIONS ;
        ;==================================;

        .TITL   SYSID.16



; FIRST WORD OF ALL SYSTEM CALLS
.DUSR   ?SYST=  JSR     @17



;
; SYSTEM CALL DEFINITION MACROS
;

        .MACRO  ?SCL1
        ?=^2                    ;FOR PLN PARAMETERS
        .MACRO  ^1              ;DEFINE A SYSTEM CALL MACRO
**      .PUSH   .NOMAC
**      .NOMAC  ?XCALL
        .PUSH   .RDX            ;RADIX PROTECTION FOR SYSTEM CALLS
        .RDX    8
        ?SYST
        ^2
        .RDX    .POP
**      .NOMAC  .POP
_%
%
        .MACRO  ?SCL2
        ?=^2                    ;FOR PLN PARAMETERS
        .MACRO  ^1
**      .PUSH   .NOLOC
        .NOLOC  1
        .PUSH   .NOMAC
        .NOMAC  ?XCALL
        .DO     .ARGCT==1       ;ARG SPECIFIED?
        ELEF    2,_^1
        .ENDC
        .PUSH   .RDX            ;RADIX PROTECTION FOR SYSTEM CALLS
        .RDX    8
        ?SYST
        ^2
        .RDX    .POP
        .NOMAC  .POP
**      .NOLOC  .POP
_%
%

; RESOURCE CALL DEFINITION MACROS

        .MACRO  ?RCL1
        .MACRO  ?^1
**      .PUSH   .NOLOC
        .NOLOC  1
        .PUSH   .NOMAC
        .NOMAC  ?XCALL
        .DO     .ARGCT==0
        .^1
        0
        .ENDC
        .DO     .ARGCT==1
        _.EXTN  _^1
        .^1     _^1
        .TARG   ^2 _^1
        .ENDC
        .NOMAC  .POP
**      .NOLOC  .POP
_%
%

;   TASK CALL DEFINITION MACRO (FOR 16 BIT TASK CALLS
;                                IN THE USER RING AGENT WART)

        .MACRO  ?TCL1
        .MACRO  ^1
**      .PUSH   .NOMAC
**      .NOMAC  ?XCALL
        .EXTN   ^2
        EJSR    ^2,0
**      .NOMAC  .POP
_%
%


; SUPPRESS EXPANSION OF DEFINITION MACROS

        .PUSH   .NOMAC
        .NOMAC  1

; DEFAULT TO SUPPRESS EXPANSION OF CALL MACROS

.DUSR   ?XCALL= 1

