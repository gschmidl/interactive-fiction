;STACK DISPLACEMENTS FOR
;       USER RUNTIME RESOURCE MANAGEMENT


.DUSR   ?VRTN=  4       ; CALLER'S VIRTUAL RETURN
.DUSR   ?DESC=  2       ; CALLER'S RESOURCE DESCRIPTION
                        ;       0       NO RESOURCE
                        ;       >=?USTART ROOT
                        ;       1B0     SHARED LIBRARY
                        ;       0B0     OVERLAY
.DUSR   ?OAC0=  -8.     ; CALLER'S AC0
.DUSR   ?OAC1=  -6      ; CALLER'S AC1
.DUSR   ?OAC2=  -4      ; CALLER'S AC2
.DUSR   ?OFP=   -2      ; CALLER'S FRAME POINTER
.DUSR   ?ORTN=  0       ; CARRY+RETURN ADDRESS

; PERIPHERAL DEVICE CHARACTERISTICS

;       The following parameters are for the characteristic packet offsets

.DUSR   ?CH1=   0.      ;word 1 (offset 0)
.DUSR   ?CH2=   1.      ;word 2 (offset 1)
.DUSR   ?CH3=   2.      ;word 3 (offset 2)
.DUSR   ?CH4=   3.      ;word 4 (offset 3)
.DUSR   ?CH5=   4.      ;word 5 (offset 4)
.DUSR   ?CH6=   5.      ;word 6 (offset 5)
.DUSR   ?CH7=   6.      ;word 7 (offset 6)
.DUSR   ?CH8=   7.      ;word 8 (offset 7)
.DUSR   ?CH9=   8.      ;word 9 (offset 8)
.DUSR   ?CH10=  9.      ;word 10 (offset 9)
.DUSR   ?CH11=  10.     ;word 11 (offset 10)
.DUSR   ?CH12=  11.     ;word 12 (offset 11)
.DUSR   ?CH13=  12.     ;word 13 (offset 12)
.DUSR   ?CH14=  13.     ;word 14 (offset 13)
.DUSR   ?CH15=  14.     ;word 15 (offset 14)

;       Packet length parameters

.DUSR   ?CLMIN= 3.      ; MIN LENGTH OF CHARACTERISTICS PACKET
.DUSR   ?CLMAX= 15.     ; MAX LENGTH OF CHARACTERISTICS PACKET
.DUSR   ?BMLTH= 20.     ; LENGTH OF INQUIRE PACKET


;       ?CH1 - offset 0

.DUSR   ?CST=   0.      ;SIMULATE TABS
.DUSR   ?CSFF=  1.      ;SIMULATE FORM FEEDS
.DUSR   ?CEPI=  2.      ;REQUIRE EVEN PARITY ON INPUT
.DUSR   ?C8BT=  3.      ;ALLOW 8 DATA BITS/CHARACTER
.DUSR   ?CSPO=  4.      ;SET PARITY ON OUTPUT (EVEN ONLY)
.DUSR   ?CRAF=  5.      ;SEND RUBOUTS AFTER FORM FEEDS
.DUSR   ?CRAT=  6.      ;SEND RUBOUTS AFTER TABS
.DUSR   ?CRAC=  7.      ;SEND RUBOUTS AFTER CR AND NL
.DUSR   ?CNAS=  8.      ;NON ANSI STANDARD DEVICE
.DUSR   ?COTT=  9.      ;CONVERT ESC CHARACTER (FOR OLD TTY'S)
.DUSR   ?CEOL=  10.     ;DO NOT AUTO CR/LF AT END OF LINE
.DUSR   ?CUCO=  11.     ;OUTPUT UPPER CASE ONLY DEVICE
.DUSR   ?CMRI=  12.     ;MONITOR RING INDICATOR ON MODEM CONTROL LINE
.DUSR   ?CFF=   13.     ;FORM FEED ON OPEN
;       THE FOLLOWING TWO BITS MUST NOT BE MOVED :
.DUSR   ?CEB0=  14.     ;ECHO MODE BIT 0
.DUSR   ?CEB1=  15.     ;ECHO MODE BIT 1


;       ECHO MODES :
;       0=      NO ECHO
;       1=      STRAIGHT ECHO
;       2=      ECHO CONTROL CHARS AS ^B ^F (ETC.), ESC AS $
;       3=      (RESERVED FOR FUTURE USE)

.DUSR   ?CEOS=  1B(?CEB1)       ;STRAIGHT ECHO BIT MASK
.DUSR   ?CEOC=  1B(?CEB0)       ;CNTRL SPECIAL ECHO BIT MASK

;       ?CH2 - offset 1

.DUSR   ?CULC=  0.      ;INPUT UPPER/LOWER CASE DEVICE
.DUSR   ?CPM=   1.      ;DEVICE IS IN PAGE MODE
.DUSR   ?CNRM=  2.      ;DISABLE MESSAGE RECEPTION
.DUSR   ?CMOD=  3.      ;DEVICE ON MODEM INTERFACE

;       THE FOLLOWING FOUR BITS MUST NOT BE MOVED :
.DUSR   ?CDT0=  4.      ;DEVICE TYPE BIT 0
.DUSR   ?CDT1=  5.      ;DEVICE TYPE BIT 1
.DUSR   ?CDT2=  6.      ;DEVICE TYPE BIT 2
.DUSR   ?CDT3=  7.      ;DEVICE TYPE BIT 3

.DUSR   ?CTO=   8.      ;DEVICE TIME-OUTS ENABLED
.DUSR   ?CTSP=  9.      ;CRA- NO TRAILING BLANK SUPPRESSION
.DUSR   ?CPBN=  10.     ;CRA- PACKED FORMATE ON BINARY READ
.DUSR   ?CESC=  11.     ;ESC CHARACTER PRODUCES INTERRUPT
.DUSR   ?CWRP=  12.     ;HARDWARE WRAPS AROUND ON LINE TOO LONG
.DUSR   ?CFKT=  13.     ;FUNCTION KEYS ARE INPUT DELIMITERS
.DUSR   ?CNNL=  14.     ;CRA- NO NEW-LINE CHARACTERS APPENDED
;               15.     ;BIT 15 USED IN PARU.16.SR FOR TRA/TPA

;       DEFINE DEVICE TYPE MASK.

.DUSR   ?DTYPE= 1B(?CDT0)+1B(?CDT1)+1B(?CDT2)+1B(?CDT3)

.DUSR   ?TTY=   0                       ;4010A CONSOLE DEVICE TYPE
.DUSR   ?CRT1=  1B(?CDT3)               ;4010I CONSOLE DEVICE TYPE
.DUSR   ?CRT2=  1B(?CDT2)               ;6012  CONSOLE DEVICE TYPE
.DUSR   ?CRT3=  1B(?CDT2)+1B(?CDT3)     ;605X CONSOLE DEVICE TYPE
.DUSR   ?CRT4=  1B(?CDT1)               ;ANOTHER CONSOLE DEVICE TYPE
.DUSR   ?CRT5=  1B(?CDT1)+1B(?CDT3)     ;PSEUDO 6012 DEVICE
.DUSR   ?CRT6=  1B(?CDT1)+1B(?CDT2)     ;6130 CONSOLE DEVICE TYPE
.DUSR   ?CRT7=  1B(?CDT1)+1B(?CDT2)+1B(?CDT3)   ;USER DEFINED DEVICE
.DUSR   ?CRT8=  1B(?CDT0)                       ;USER DEFINED DEVICE
.DUSR   ?CRT9=  1B(?CDT0)+1B(?CDT3)             ;USER DEFINED DEVICE
.DUSR   ?CRT10= 1B(?CDT0)+1B(?CDT2)             ;USER DEFINED DEVICE
.DUSR   ?CRT11= 1B(?CDT0)+1B(?CDT2)+1B(?CDT3)   ;USER DEFINED DEVICE
.DUSR   ?CRT12= 1B(?CDT0)+1B(?CDT1)             ;USER DEFINED DEVICE
.DUSR   ?CRT13= 1B(?CDT0)+1B(?CDT1)+1B(?CDT3)   ;USER DEFINED DEVICE
.DUSR   ?CRT14= 1B(?CDT0)+1B(?CDT1)+1B(?CDT2)   ;USER DEFINED DEVICE
.DUSR   ?CRT15= 1B(?CDT0)+1B(?CDT1)+1B(?CDT2)+1B(?CDT3)


;       ?CH3 - offset 2
;
;       HIGH BYTE IS LPP (LINES PER PAGE)
;       LOW  BYTE IS CPL (CHARACTERS PER LINE)

.DUSR   ?CPGSZ= ?CH3            ;Page size



;       ?CH4 - offset 3

.DUSR   ?CVAL=  0.              ;INDICATES THAT THE CONTENTS OF THIS
                                ;OFFSET ARE VALID. (USED ON RETURN
                                ;FROM ?GECHR.)  IN GENERAL, ?CVAL= 1
                                ;FOR AN IAC SYSTEM, AND ?CVAL OTHERWISE.
.DUSR   ?BR0BIT=1.              ;BAUD RATE FIELD (BIT 0)
.DUSR   ?CTCK=  2.              ;INTERNAL TRANSMITER CLOCK
.DUSR   ?CRCK=  3.              ;INTERNAL RECIEVER CLOCK
.DUSR   ?BR1BIT=4.              ;BAUD RATE FIELD (BIT 1)
.DUSR   ?BR2BIT=5.              ;BAUD RATE FIELD (BIT 2)
.DUSR   ?BR3BIT=6.              ;BAUD RATE FIELD (BIT 3)
.DUSR   ?BR4BIT=7.              ;BAUD RATE FIELD (BIT 4)
.DUSR   ?CST0=  8.              ;STOP BIT 0
.DUSR   ?CST1=  9.              ;STOP BIT 1
.DUSR   ?CPTY=  10.             ;ODD/EVEN PARITY
.DUSR   ?CPEN=  11.             ;PARITY DISABLED/ENABLED
.DUSR   ?CLT0=  12.             ;DATA LENGTH BITS
.DUSR   ?CLT1=  13.             ;DATA LENGTH BITS
.DUSR   ?BRFCT= 14.             ;BAUD RATE FACTOR 16X
.DUSR   ?HRDFLC=15.             ;HARDWARE FLOW CONTROL (CTS)
.DUSR   ?CHOFC=?HRDFLC          ;HARDWARE OUTPUT FLOW CONTROL


;       SPLIT BAUD RATE VALUES:

.DUSR   ?CSBEN= 1B?CTCK+1B?BRFCT                ;ENABLE SPLIT BAUD
.DUSR   ?CSBDS= 1B?CTCK+1B?CRCK+1B?BRFCT        ;DISABLE SPLIT BAUD


;       STOP BIT FIELD VALUES ARE:

.DUSR   ?CSMSK= 1B?CST0+1B?CST1         ;STOP BIT FIELD MASK

.DUSR   ?CS10=  0B?CST0+1B?CST1         ;1 STOP BIT
.DUSR   ?CS15=  1B?CST0+0B?CST1         ;1.5 STOP BITS
.DUSR   ?CS20=  1B?CST0+1B?CST1         ;2 STOP BITS


;       PARITY BIT FIELD VALUES ARE:

.DUSR   ?CPMSK= 1B?CPEN+1B?CPTY         ;PARITY FIELD MASK

.DUSR   ?CPR0=  0B?CPEN                 ;DISABLE PARITY CHECKING
.DUSR   ?CPR1=  1B?CPEN+0B?CPTY         ;ENABLE ODD  PARITY
.DUSR   ?CPR2=  1B?CPEN+1B?CPTY         ;ENABLE EVEN PARITY


;       BAUD RATES ARE:

.DUSR   ?BRMSK= 1B(?BR0BIT)!17B(?BR4BIT)        ;BAUD RATE MASK

.DUSR   ?CR50=  0B(?BR0BIT)+0.B(?BR4BIT)        ;50
.DUSR   ?CR75=  0B(?BR0BIT)+1.B(?BR4BIT)        ;75
.DUSR   ?CR110= 0B(?BR0BIT)+2.B(?BR4BIT)        ;110
.DUSR   ?CR134= 0B(?BR0BIT)+3.B(?BR4BIT)        ;134.5
.DUSR   ?CR150= 0B(?BR0BIT)+4.B(?BR4BIT)        ;150
.DUSR   ?CR300= 0B(?BR0BIT)+5.B(?BR4BIT)        ;300
.DUSR   ?CR600= 0B(?BR0BIT)+6.B(?BR4BIT)        ;600
.DUSR   ?CR12H= 0B(?BR0BIT)+7.B(?BR4BIT)        ;1200
.DUSR   ?CR18H= 0B(?BR0BIT)+8.B(?BR4BIT)        ;1800
.DUSR   ?CR20H= 0B(?BR0BIT)+9.B(?BR4BIT)        ;2000
.DUSR   ?CR24H= 0B(?BR0BIT)+10.B(?BR4BIT)       ;2400
.DUSR   ?CR36H= 0B(?BR0BIT)+11.B(?BR4BIT)       ;3600
.DUSR   ?CR48H= 0B(?BR0BIT)+12.B(?BR4BIT)       ;4800
.DUSR   ?CR72H= 0B(?BR0BIT)+13.B(?BR4BIT)       ;7200
.DUSR   ?CR96H= 0B(?BR0BIT)+14.B(?BR4BIT)       ;9600
.DUSR   ?CR19K= 0B(?BR0BIT)+15.B(?BR4BIT)       ;19200

.DUSR   ?CR45=  1B(?BR0BIT)+0.B(?BR4BIT)        ;45.5
.DUSR   ?CR38K= 1B(?BR0BIT)+1.B(?BR4BIT)        ;38400
;                           2. - 15.            ; - RESERVED


;       DATA LENGTH FIELD VALUES ARE:

.DUSR   ?CLMSK= 1B?CLT0+1B?CLT1         ;DATA LENGTH FIELD MASK

.DUSR   ?CLN5=  0B?CLT0+0B?CLT1         ;5 BITS
.DUSR   ?CLN6=  0B?CLT0+1B?CLT1         ;6 BITS
.DUSR   ?CLN7=  1B?CLT0+0B?CLT1         ;7 BITS
.DUSR   ?CLN8=  1B?CLT0+1B?CLT1         ;8 BITS



;       ?CH5 - offset 4

.DUSR   ?SHCO=0.        ;SHARED CONSOLE OWNERSHIP CHARACTERISTIC
.DUSR   ?XOFC=1.        ;XON XOFF OUTPUT FLOW CONTROL
.DUSR   ?XIFC=2.        ;XON XOFF INPUT  FLOW CONTROL
.DUSR   ?C16B=3.        ;Enable double byte handling (16 bit characters)
.DUSR   ?BMDEV=4.       ;BITMAP DEVICE
.DUSR   ?TRPE=5.        ;TERMINATE READ ON POINTER EVENT
.DUSR   ?CWIN=6.        ;WINDOW CHARACTERISTIC
.DUSR   ?CACC=7.        ;ENFORCE ACCESS CONTROL
.DUSR   ?CCTD=8.        ;PORT IS IN A CONTENDED ENVIRONMENT (PBX, TERMSERVER)
.DUSR   ?CSRDS=9.       ;SUPRESS RECEIVER DISABLE
.DUSR   ?CXLT=10.       ;TRANSLATE (ANSI TERMINAL)
.DUSR   ?CABD=11.       ;[1] DO AUTOBAUD MATCH IF SET
.DUSR   ?CALLOUT=12.    ;CALL OUT (PBX SUPPORT)
.DUSR   ?CBK0=13.       ;BREAK FUNCTION BIT 0
.DUSR   ?CBK1=14.       ;BREAK FUNCTION BIT 1
.DUSR   ?CBK2=15.       ;BREAK FUNCTION BIT 2

;BREAK FUNCTION FIELD DEFINITION:

.DUSR   ?CBKM=  1B?CBK0+1B?CBK1+1B?CBK2 ;MASK

.DUSR   ?CBBM=  0B(?CBK2)               ;BREAK BINARY MODE
.DUSR   ?CBDS=  1B(?CBK2)               ;FORCE DISCONNECT
.DUSR   ?CBCA=  2B(?CBK2)               ;SEND ^C^A SEQUENCE
.DUSR   ?CBCB=  3B(?CBK2)               ;SEND ^C^B SEQUENCE
.DUSR   ?CBCF=  4B(?CBK2)               ;SEND ^C^F SEQUENCE
;               5B(?CBK2)               ; - RESERVED
;               6B(?CBK2)               ; - RESERVED
;               7B(?CBK2)               ; - RESERVED



;       ?CH6 - offset 5
;       (MODEM ENHANCEMENTS)

.DUSR   ?CMDOP= ?CH6            ;Modem options

.DUSR   ?CDMC=   0.             ;RESERVED
.DUSR   ?CMDUA=  ?CDMC+1        ;DIRECT USER ACCESS TO MODEM
                                ;(DON'T PEND FIRST WRITE)
.DUSR   ?CHDPX=  ?CMDUA+1       ;HALF DUPLEX
.DUSR   ?CSMCD=  ?CHDPX+1       ;SUPPRESS MONITORING CD
                                ;(FOR MODEM CONNECTION)
.DUSR   ?CRTSCD= ?CSMCD+1       ;ON HALF DUPLEX, DON'T RAISE
                                ;RTS UNTIL CD DROPS
.DUSR   ?CHIFC=  ?CRTSCD+1      ;HARDWARE INPUT FLOW CONTROL



;       ?CH7 - offset 6

.DUSR   ?CTCC=  ?CH7            ;Time (in msec) to wait for CD on a modem
                                ;connect


;       ?CH8 - offset 7

.DUSR   ?CTCD=  ?CH8            ;Time (in msec) to wait for CD if it drops


;       ?CH9 - offset 8

.DUSR   ?CTDW=  ?CH9            ;Time (in msec) to wait after connection
                                ;before allowing I/O


;       ?CH10 - offset 9

.DUSR   ?CTHC=  ?CH10           ;Time (in msec) to wait after disconnect
                                ;for modem to settle


;       ?CH11 - offset 10

.DUSR   ?CTLT=  ?CH11           ;Time (in msec) to wait before turning
                                ;the line around (from XMIT to REC) for
                                ;half duplex



;       ?CH12 - offset 11
;       (Console Type)
;
;       HIGH BYTE IS RESERVED (=0)
;       LOW  BYTE IS CONSOLE TYPE

.DUSR   ?CCTYPE=    ?CH12       ;Console type

;       Mask for accessing just console type

.DUSR   ?CCTYPMSK=  377         ;mask for just console type

;       These are the current values for console types

.DUSR   ?CDCC=  0               ;Direct Connect
.DUSR   ?CLNC=  ?CDCC+1         ;Term Server
.DUSR   ?CTNC=  ?CLNC+1         ;TELNET Consoles
.DUSR   ?CPDC=  ?CTNC+1         ;PAD Consoles
.DUSR   ?CVRC=  ?CPDC+1         ;Virtual (SVTA-like) Consoles
.DUSR   ?CPXC=  ?CVRC+1         ;PBX Consoles (PIM)
.DUSR   ?CPCC=  ?CPXC+1         ;PC/TS Consoles
.DUSR   ?CBMC=  ?CPCC+1         ;Bitmapped (Windowing) Console
.DUSR   ?CTPC=  ?CBMC+1         ;T1 Primary Rate Console(IIC)


;       ?CH13 - offset 12
;       (Language Front-end Processor)

.DUSR   ?CLFP= ?CH13            ;LFP options

.DUSR   ?CKG0=  0.              ;G1-G0 double-byte handling
.DUSR   ?CKHW=  1.              ;Kanji half-wide characters
.DUSR   ?CNLX=  2.              ;Native language translation

;       DEVICE TYPES : (FOR RUBOUT ECHO & CURSOR CONTROLS)
;
;       PIBC2   CHARACTERS TO :
;       DEVICE  MODEL   MOVE    MOVE    ERASE   RUBOUT
;       TYPE :  # :     LEFT:   RIGHT:  LINE:   ECHO:
;
;       0       4010A   (NONE)  (NONE)  (NONE)  SHIFT O
;       0       6040    (NONE)  (NONE)  (NONE)  SHIFT O
;       1       4010I   ^Z      ^Y      ^K      ^Z,SPACE,^Z
;       2       6012    ^Y      ^X      ^K      ^Y,SPACE,^Y
;       3       6052    ^Y      ^X      ^K      ^Y,SPACE,^Y
;       4       ----    ESC,D   ESC,C   ESC,K   ESC,D,SPACE,ESC,D
;       5       ----
;       6       6130    ^Y      ^X      ^K      ^Z,SPACE,^Z
;       7-15.   (FOR FUTURE EXPANSION)


;       MISC CONSTANTS

.DUSR   ?LDEL=  "U-100  ; LINE DELETE CHARACTER
.DUSR   ?EOFC=  "D-100  ; END-OF-FILE CHARACTER


; ACCESS CONTROL SPECIFICATIONS

; ACCESS PRIVILEGE BIT POSITIONS

.DUSR   ?FAOB=  11.     ; OWNER ACCESS
.DUSR   ?FAWB=  12.     ; WRITE ACCESS
.DUSR   ?FAAB=  13.     ; APPEND ACCESS
.DUSR   ?FARB=  14.     ; READ ACCESS
.DUSR   ?FAEB=  15.     ; EXECUTE ACCESS

; DEFINITIONS FOR USE WITH WSKBN/WSKBZ EAGLE INSTRUCTIONS

.DUSR   ?FAOBB= 16.+?FAOB       ; OWNER ACCESS
.DUSR   ?FAWBB= 16.+?FAWB       ; WRITE ACCESS
.DUSR   ?FAABB= 16.+?FAAB       ; APPEND ACCESS
.DUSR   ?FARBB= 16.+?FARB       ; READ ACCESS
.DUSR   ?FAEBB= 16.+?FAEB       ; EXECUTE ACCESS


; ACCESS PRIVILEGE MASKS

.DUSR   ?FACO=  1B(?FAOB)       ; OWNER
.DUSR   ?FACW=  1B(?FAWB)       ; WRITE
.DUSR   ?FACA=  1B(?FAAB)       ; APPEND
.DUSR   ?FACR=  1B(?FARB)       ; READ
.DUSR   ?FACE=  1B(?FAEB)       ; EXECUTE



; LOGICAL RECORD FORMAT TYPES

.DUSR   ?ORDY=  1               ;DYNAMIC
.DUSR   ?ORDS=  2               ;DATA SENSITIVE
.DUSR   ?ORFX=  3               ;FIXED LENGTH
.DUSR   ?ORVR=  4               ;VARIABLE LENGTH
.DUSR   ?ORUN=  5               ;UNDEFINED
.DUSR   ?ORVB=  6       ;IBM VARIABLE BLOCK - VARIABLE RECORD




; ?GOPEN PACKET

.DUSR   ?OPFL=  0       ;FLAGS IN TO ?GOPEN
.DUSR   ?OPCH=  ?OPFL   ;CHANNEL NUMBER
.DUSR   ?OPTY=  1       ;FORMAT (LH) AND FILE TYPE (RH)
.DUSR   ?OPFC=  2       ;FILE CONTROL PARAMETERS
.DUSR   ?OPEW=  3       ;RESERVED
.DUSR   ?OPEH=  4       ;FILE EOF (HIGH)
.DUSR   ?OPEL=  5       ;FILE EOF (LOW)

.DUSR   ?OPPH=  2       ;PORT NUMBER (HIGH)
.DUSR   ?OPPL=  3       ;PORT NUMBER (LOW)

.DUSR   ?OPLT=  ?OPEL+1 ;LENGTH OF PACKET


; FLAGS IN BIT POINTERS

.DUSR   ?OPBE=  0.              ;EXCLUSIVE OPEN
.DUSR   ?OPDF=  1.              ;INHIBIT INITIAL FORM FEED
.DUSR   ?OPD0=  2.              ;DENSITY BITS.
.DUSR   ?OPD1=  3.              ;
.DUSR   ?OPD2=  4.              ;
.DUSR   ?OPBX=  7.              ; EXTENDED PACKET
.DUSR   ?OPBF=  8.              ; USE BUFFERED MODE ON TAPE I/O
.DUSR   ?OPST=  9.              ; USE STREAMING MODE ON TAPE I/O

; DEFINITIONS FOR USE WITH WSKBN/WSKBZ EAGLE INSTRUCTIONS

.DUSR   ?OPBEB= 16.+?OPBE       ;EXCLUSIVE OPEN
.DUSR   ?OPDFB= 16.+?OPDF       ;INHIBIT INITIAL FORM FEED



; FLAGS IN MASKS

.DUSR   ?OPME=  1B(?OPBE)       ;EXCLUSIVE OPEN
.DUSR   ?OPMD=  1B(?OPDF)       ;INHIBIT INITIAL FORM FEED

.DUSR   ?OPDL=  1B(?OPD2)       ;800 DENSITY MODE.
.DUSR   ?OPDM=  2B(?OPD2)       ;1600 DENSITY MODE.
.DUSR   ?OPDH=  4B(?OPD2)       ;6250 DENSITY MODE.
.DUSR   ?OPAM=  3B(?OPD2)       ;AUTO DENSITY MATCHING MODE.
.DUSR   ?OPD5=  5B(?OPD2)       ; LOW DENSITY MODE
.DUSR   ?OPD6=  6B(?OPD2)       ; MEDIUM DENSITY MODE
.DUSR   ?OPD7=  7B(?OPD2)       ; HIGH DENSITY MODE
.DUSR   ?OPDEN= 7B(?OPD2)       ; DENSITY BITS MASK

.DUSR   ?OPXP=  1B(?OPBX)       ;EXTENDED PACKET
.DUSR   ?OPMBF= 1B?OPBF         ; MASK FOR BUFFERED TAPE I/O
.DUSR   ?OPMST= 1B?OPST         ; MASK FOR STREAMING TAPE I/O

; ?GOPEN PACKET EXTENSION

.DUSR   ?OPXS=  ?OPLT           ; USER SPECIFIED PACKET
                                ; EXTENSION SIZE (MUST = ?OPXL)

; DISK PARAMETER SPECIFICATION FIELDS

.DUSR   ?ODF1= ?OPXS+1          ; OPTION FLAGS (WORD 1)
.DUSR   ?ODBY= ?ODF1+1          ; BYTES PER SECTOR
.DUSR   ?ODSEC= ?ODBY+1         ; SECTORS PER TRACK
.DUSR   ?ODTRK= ?ODSEC+1        ; TRACKS PER SURFACE
.DUSR   ?ODHD=  ?ODTRK+1        ; HEADS (SURFACES)

; PACKET EXTENSION SIZES

.DUSR   ?OPXL= ?ODHD-?OPLT      ; EXTENSION SIZE
.DUSR   ?OPXT= ?OPLT+?OPXL+1    ; EXTENDED PACKET LENGTH

; MASKS FOR ?GOPEN EXTENSION OPTION FLAGS (IN ?ODF1)

.DUSR   ?ODHS=  1B15.           ;HEAD SWAP      (DPM ONLY)
.DUSR   ?ODBS=  1B14.           ;BYTE SWAP      (DPM ONLY)
.DUSR   ?ODP0=  1B13.           ;FIRST PHYSICAL SECTOR IS 0 (DEF=1)
                                ; (DPM ONLY)
.DUSR   ?ODND=  1B12.           ;ALLOW WRITING WITHOUT MODIFIED BITS
                                ; (DPJ ONLY)
.DUSR   ?ODMB=  1B11.           ;ALLOW MODIFIED BIT MAP I/O (DPJ ONLY)
.DUSR   ?ODTP=  1B10.           ;TRESPASS ON DUAL PORTED DISK(DPJ ONLY)
.DUSR   ?ODST=  1B9.            ;CHOOSE STREAMING MODE FOR TAPE (MTJ ONLY)
.DUSR   ?ODTL=  1B8.            ;SUPPRESS TLA CHANGE

.DUSR   ?ODTEO= 1B7.            ; 9-TRACK TAPE EMULATION OVERRIDE
.DUSR   ?ODCOF= 1B6.            ; DATA COMPRESSION OFF

;       GENERIC FILE TYPE INDICES (IF TYPE = ?FGFN)

.DUSR   ?GIN=1                  ;GENERIC INPUT
.DUSR   ?GOUT=2                 ;GENERIC OUTPUT
.DUSR   ?GLST=3                 ;GENERIC LIST
.DUSR   ?GDATA=4                ;GENERIC DATA
.DUSR   ?GNULL=5                ;NULL

;       CHANNEL ASSIGNMENTS

.DUSR   ?LOCHN=0                ;LOWEST ASSIGNABLE CHANNEL NO.
.DUSR   ?HICHN=254.             ;HIGHEST ASSIGNABLE CHANNEL NO.
.DUSR   ?NULL=?HICHN+1          ;NULL CHANNEL ASSIGNMENT

;
; SYSTEM RECORD I/O PACKET FOR ALL DISK AND MAG. TAPE
; AND MCA REQUESTS FROM EITHER THE AGENT OR USER CONTEXTS.
;       USED FOR ?RDB/?WRB, ?PRDB/PWRB, ?SPAGE AND ?ALLOCATE
;
.DUSR   ?PSTI=  0               ; RECORD COUNT (RIGHT), STATUS IN (LEFT)
.DUSR   ?PSTO=  ?PSTI+1         ; RESERVED (LEFT) PRIORITY (RIGHT)
.DUSR   ?PCAD=  ?PSTO+1         ; WORD ADDRESS FOR DATA
.DUSR   ?PCDL=  ?PCAD+1         ; LOW ORDER PORTION OF ?PCAD
.DUSR   ?PRNH=  ?PCDL+1         ; RECORD NUMBER (HIGH)
                                ; LINK # (MCA)
.DUSR   ?PRNL=  ?PRNH+1         ; RECORD NUMBER (LOW)
                                ; RETRY COUNT (MCA)
.DUSR   ?PRCL=  ?PRNL+1         ; MAX LENGTH OF EACH RECORD (MAG TAPE)
                                ; BYTE COUNT IN LAST BLOCK (DISK WRITES)
                                ; BYTE COUNT (MCA)
.DUSR   ?PRES=  ?PRCL+1         ; RESERVED WORD
.DUSR   ?PBLT=  ?PRES+1         ; PACKET SIZE
;
; PACKET EXTENSIONS FOR ?PRDB/?PWRB:
;
; NOTE: THESE OFFSETS DUPLICATE THOSE IN THE PIO ERROR STATUS PACKET
;       FOR ?BLKIO. ANY CHANGE HERE MUST BE MADE THERE AS WELL.
;

.DUSR   ?PRBB=  ?PRCL+1         ;RELATIVE BLOCK NUMER OF LAST
                                ;  BLOCK TRANSFERED
.DUSR   ?PCS1=  ?PRBB+1         ;CONTROLLER STATUS WORD 1
.DUSR   ?PCS2=  ?PCS1+1         ;CONTROLLER STATUS WORD 2
.DUSR   ?PCS3=  ?PCS2+1         ;CONTROLLER STATUS WORD 3
.DUSR   ?PCS4=  ?PCS3+1         ;CONTROLLER STATUS WORD 4
.DUSR   ?PCS5=  ?PCS4+1         ;CONTROLLER STATUS WORD 5
.DUSR   ?PCS6=  ?PCS5+1         ;CONTROLLER STATUS WORD 6
.DUSR   ?PCS7=  ?PCS6+1         ;CONTROLLER STATUS WORD 7
.DUSR   ?PCS8=  ?PCS7+1         ;CONTROLLER STATUS WORD 8

.DUSR   ?PPBLT= ?PCS8+1         ;LENGTH OF ?PRDB/?PWRB PACKET
;
; STATUS IN
;
.DUSR   ?IDIO=  0               ; MCA PROTOCOL
.DUSR   ?ENOR=  1               ; ENABLE VFU LOAD / OVERRIDE LEOT LOGIC
.DUSR   ?SAFE=  2               ; THIS IS A SAFE WRITE.
;
; DEFINITIONS FOR USE WITH WSKBN/WSKBZ EAGLE INSTRUCTIONS
;
.DUSR   ?IDIOB= 16.+?IDIO       ; MCA PROTOCOL
.DUSR   ?ENORB= 16.+?ENOR       ; ENABLE VFU LOAD / OVERRIDE LEOT LOGIC
.DUSR   ?SAFB=  16.+?SAFE       ; SAFE WRITE BIT DISPLACEMENT
;
; STATUS IN MASKS
;
.DUSR   ?IMIO=  1B?IDIO         ; SUSPEND MCA PROTOCOL
.DUSR   ?ENOV=  1B?ENOR         ; ENABLE VFU / OVERRIDE LEOT
.DUSR   ?SAFM=  1B?SAFE         ; SAFE WRITE MASK
.DUSR   ?SPRO=  1S0             ; READ ONLY ACCESS (?SPAGE)
;
; BIT DISPLACEMENTS
;
.DUSR   ?DIO=   ?PSTI*16.+?IDIO ; SUSPEND MCA PROTOCOL (SET)
.DUSR   ?ENVR=  ?PSTI*16.+?ENOR ; ENABLE VFU / OVERRIDE LEOT

;
; SYSTEM PACKET FOR ?BLKIO FOR DISK, MAG TAPE, MCA, AND LPB.
; NOTE: 'RNA' MEANS READ NEXT ALLOCATED BLOCK AND PIO MEANS
; 'PHYSICAL I/O'.
;
.DUSR   ?BPVB=  0               ; RESERVED
.DUSR   ?BSTS=  ?BPVB+1         ; STATUS
.DUSR   ?BCHN=  ?BSTS+1         ; CHANNEL NUMBER
.DUSR   ?BERR=  ?BCHN+1         ; ERROR CODE
.DUSR   ?BADR=  ?BERR+1         ; DATA BUFFER ADDRESS
.DUSR   ?BADL=  ?BADR+1         ; (LOW)
.DUSR   ?BBLN=  ?BADL+1         ; DESIRED FILE BLOCK #
.DUSR   ?BBLL=  ?BBLN+1         ; (LOW)
.DUSR   ?BBLC=  ?BBLL+1         ; BLOCK COUNT
.DUSR   ?BLBB=  ?BBLC+1         ; LAST BLOCK BYTE COUNT
.DUSR   ?BTBC=  ?BLBB+1         ; NUMBER OF BYTES TRANSFERRED
.DUSR   ?BTBL=  ?BTBC+1         ; (LOW)
.DUSR   ?BBAN=  ?BTBL+1         ; RNA - 1ST BLOCK # TRULY XFERED
.DUSR   ?BBAL=  ?BBAN+1         ; (LOW)
.DUSR   ?BBAC=  ?BBAL+1         ; RNA - # BLOCKS TRULY XFERED
.DUSR   ?BPER=  ?BBAC+1         ; PIO - ERROR STATUS PACKET ADDRESS
.DUSR   ?BPEL=  ?BPER+1         ; (LOW)
.DUSR   ?B32N=  ?BPEL+2         ; 32 BIT RECORD NUMBER FOR TAPE
.DUSR   ?BLTH=  ?B32N+2+2       ; LENGTH OF ?BLKIO PACKET

;
; REDEFINITIONS.
;
.DUSR   ?BFLN=  ?BBLL           ; FILE # (MAG TAPE), RETRIES (MCA)

;
; ?BSTS - STATUS WORD BIT DEFINITIONS.
;
; NOTE THAT THE HIGH BYTE OF THIS WORD IS IDENTICAL TO THE
; HIGH BYTE OF ?PSTI IN THE ?RDB/?WRB PACKET.
;
.DUSR   ?BDIO=  ?IDIO           ; DIRECT I/O FOR MCA
.DUSR   ?BEOR=  ?ENOR           ; ENABLE VFU LOAD/OVERRIDE LEOT LOGIC
.DUSR   ?BAFE=  ?SAFE           ; SAFE WRITE FOR MAG TAPE
.DUSR   ?B32R=  11.             ; 32 BIT RECORD # IN ?B32N FIELD
.DUSR   ?BNMB=  12.             ; MODIFIED BIT MAP I/O;  0=NO, 1=YES
.DUSR   ?BNA=   13.             ; READ NEXT ALLOCATED BLOCK; 0=NO, 1=YES
.DUSR   ?BPIO=  14.             ; PHYSICAL I/O; 0=NO, 1=YES
.DUSR   ?BIO=   15.             ; STYLE OF I/O; 0=READ, 1=WRITE
;
; DEFINITIONS FOR USE WITH WSBBZ/WSKBO EAGLE INSTRUCTIONS
;
.DUSR   ?BDIOB= 16.+?BDIO       ; DIRECT I/O FOR MCA
.DUSR   ?BEORB= 16.+?BEOR       ; ENABLE VFU LOAD/OVERRIDE LEOT LOGIC
.DUSR   ?BAFEB= 16.+?BAFE       ; SAFE WRITE FOR MAG TAPE
.DUSR   ?BNMBB= 16.+?BNMB       ; MODIFIED BIT MAP I/O; 0=NO, 1=YES
.DUSR   ?BNAB=  16.+?BNA        ; READ NEXT ALLOCATED BLOCK
.DUSR   ?BPIOB= 16.+?BPIO       ; PHYSICAL I/O; 0=NO, 1=YES
.DUSR   ?BIOB=  16.+?BIO        ; STYLE OF I/O; 0=READ, 1=WRITE
.DUSR   ?BM32RB=16.+?B32R       ; 32-BIT RECORD NO. FOR TAPES
;
; DEFINITIONS OF ?BSTS MASKS
;
.DUSR   ?BMDIO= 1B(?BDIO)       ; DIRECT I/O FOR MCA
.DUSR   ?BMEOR= 1B(?BEOR)       ; ENABLE VFU LOAD/OVERRIDE LEOT LOGIC
.DUSR   ?BMAFE= 1B(?BAFE)       ; SAFE WRITE FOR MAG TAPE
.DUSR   ?BMNMB= 1B(?BNMB)       ; MODIFIED BIT MAP I/O; 0=NO, 1=YES
.DUSR   ?BMNAB= 1B(?BNA)        ; READ NEXT ALLOCATED BLOCK
.DUSR   ?BMPIO= 1B(?BPIO)       ; PHYSICAL I/O; 0=NO, 1=YES
.DUSR   ?BMIO=  1B(?BIO)        ; STYLE OF I/O; 0=READ, 1=WRITE
.DUSR   ?BM32R= 1B(?B32R)       ; 32-BIT RECORD NUMBER FOR TAPES


;
; PHYSICAL I/O ERROR STATUS PACKET DEFINITIONS
;
; NOTE: THESE OFFSETS ARE EXACTLY THE SAME AS THOSE IN THE
;       ?PRDB/?PWRB PACKET. ANY ADDITION HERE MUST BE MADE
;       THERE ALSO.
;

.DUSR   ?BRBB=  0               ; RELATIVE BLOCK NUMER OF LAST
                                ; BLOCK TRANSFERED
.DUSR   ?BCS1=  ?BRBB+1         ; CONTROLLER STATUS WORD 1
.DUSR   ?BCS2=  ?BCS1+1         ; CONTROLLER STATUS WORD 2
.DUSR   ?BCS3=  ?BCS2+1         ; CONTROLLER STATUS WORD 3
.DUSR   ?BCS4=  ?BCS3+1         ; CONTROLLER STATUS WORD 4
.DUSR   ?BCS5=  ?BCS4+1         ; CONTROLLER STATUS WORD 5
.DUSR   ?BCS6=  ?BCS5+1         ; CONTROLLER STATUS WORD 6
.DUSR   ?BCS7=  ?BCS6+1         ; CONTROLLER STATUS WORD 7
.DUSR   ?BCS8=  ?BCS7+1         ; CONTROLLER STATUS WORD 8

.DUSR   ?BPBLT= ?BCS8+1         ; LENGTH OF ERROR STATUS PACKET


;
; GENERAL USER I/O PACKET
;
;       USED FOR ?OPEN/?READ/?WRITE/?CLOSE
;

.DUSR   ?ICH=   0       ;CHANNEL NUMBER
.DUSR   ?ISTI=  ?ICH+1  ;STATUS WORD (IN)
.DUSR   ?ISTO=  ?ISTI+1 ;RIGHT=FILE TYPE, LEFT=RESERVED
.DUSR   ?IMRS=  ?ISTO+1 ;PHYSICAL RECORD SIZE - 1 (BYTES)
.DUSR   ?IBAD=  ?IMRS+1 ;BYTE POINTER TO BUFFER
.DUSR   ?IBAL=  ?IBAD+1 ;LOW ORDER BITS OF ?IBAD
.DUSR   ?IRES=  ?IBAL+1 ;RESERVED
.DUSR   ?IRCL=  ?IRES+1 ;RECORD LENGTH
.DUSR   ?IRLR=  ?IRCL+1 ;RECORD LENGTH (RETURNED)
.DUSR   ?IRNW=  ?IRLR+1 ;RESERVED
.DUSR   ?IRNH=  ?IRNW+1 ;RECORD NUMBER (HIGH)
.DUSR   ?IRNL=  ?IRNH+1 ;RECORD NUMBER (LOW)
.DUSR   ?IFNP=  ?IRNL+1 ;BYTE POINTER TO FILE NAME
.DUSR   ?IFNL=  ?IFNP+1 ;LOW ORDER BITS OF ?IFNP
.DUSR   ?IDEL=  ?IFNL+1 ;DELIMITER TABLE ADDRESS
.DUSR   ?IDLL=  ?IDEL+1 ;LOWER BITS OF ?IDEL

.DUSR   ?IOSZ=  ?IDLL+1 ;LENGTH OF STANDARD I/O PACKET

.DUSR   ?ETSP=  ?IDLL+1 ;SCREEN MANAGEMENT PACKET
.DUSR   ?ETSL=  ?ETSP+1 ;LOWER PORTION OF ?ETSP
.DUSR   ?ETFT=  ?ETSL+1 ;SELECTED FIELD TRANSLATION PACKET
.DUSR   ?ETFL=  ?ETFT+1 ;LOWER PORTION OF ?ETFT
.DUSR   ?ETLT=  ?ETFL+1 ;LABELED TAPE PACKET
.DUSR   ?ETLL=  ?ETLT+1 ;LOWER PORTION OF ?ETLT
.DUSR   ?ENET=  ?ETLL+1 ;RESERVED
.DUSR   ?ENEL=  ?ENET+1 ;RESERVED

.DUSR   ?IBLT=  ?ENEL+1 ;LENGTH OF EXTENDED PACKET

;LONG EXTENDED PACKET VALID ONLY IF ?IBP2 SET.
.DUSR   ?ETER=  ?ENEL+1 ;EDITREAD PACKET
.DUSR   ?ETEL=  ?ETER+1 ;LOW BITS OF ?ETER
.DUSR   ?ETSN=  ?ETEL+1 ;NEW SCREEN MANAGEMENT PACKET
.DUSR   ?ETNL=  ?ETSN+1 ;LOW BITS OF ?ETSN
.DUSR   ?EPIP=  ?ETNL+1 ;PIPE I/O PACKET
.DUSR   ?EPLL=  ?EPIP+1 ;LOWER PORTION OF ?EPIP

.DUSR   ?ETMX=  ?IOSZ+32.;LENGTH OF LONG EXTENDED I/O PACKET



; ?ISTI FLAGS: BIT DEFINITIONS

.DUSR   ?IPLB=  0       ;PACKET LENGTH BIT (0 => SHORT PACKET)
.DUSR   ?ICFB=  1       ;CHANGE FORMAT BIT (0 => DEFAULT)
.DUSR   ?ICDM=  1       ;DUMP MODE BIT (ON ?CLOSE ONLY)
.DUSR   ?IPTB=  2       ;POSITIONING TYPE (0 => RELATIVE)
.DUSR   ?IBIB=  3       ;BINARY I/O
.DUSR   ?IFOB=  4       ;FORCE OUTPUT
.DUSR   ?IOEX=  5       ;EXCLUSIVE OPEN
.DUSR   ?IIPS=  6       ;IPC NO WAIT BIT
.DUSR   ?PDLM=  7       ;PRIORITY REQUEST
.DUSR   ?APBT=  8.      ;OPEN FILE FOR APPENDING
.DUSR   ?OF1B=  9.      ;OPEN TYPE BIT 1
.DUSR   ?OF2B=  10.     ;OPEN TYPE BIT 2
.DUSR   ?OPIB=  11.     ;OPEN FOR INPUT
.DUSR   ?OPOB=  12.     ;OPEN FOR OUTPUT
.DUSR   ?RF1B=  13.     ;RECORD FORMAT BIT 1
.DUSR   ?RF2B=  14.     ;RECORD FORMAT BIT 2
.DUSR   ?RF3B=  15.     ;RECORD FORMAT BIT 3

; ?ISTI FLAGS: MASK DEFINITIONS

.DUSR   ?IPKL=  1B?IPLB ;EXTENDED PACKET (IF SET)
.DUSR   ?ICRF=  1B?ICFB ;CHANGE RECORD FORMAT (IF SET)
.DUSR   ?CDMP=  1B?ICDM ;SET DUMP BIT (ONLY ON ?CLOSE)
.DUSR   ?IPST=  1B?IPTB ;RECORD POSITIONING TYPE (1 - ABSOLUTE)
.DUSR   ?IBIN=  1B?IBIB ;BINARY I/O
.DUSR   ?IFOP=  1B?IFOB ;FORCE OUTPUT
.DUSR   ?IEXO=  1B?IOEX ;EXCLUSIVE OPEN
.DUSR   ?IIPC=  1B?IIPS ;IPC NO WAIT BIT
.DUSR   ?PDEL=  1B?PDLM ;PRIORITY OPEN-I/O
.DUSR   ?APND=  1B?APBT ;OPEN FILE FOR APPENDING
.DUSR   ?OFCR=  1B?OF1B ;ATTEMPT CREATE BEFORE OPEN
.DUSR   ?OFCE=  1B?OF2B ;CORRECT ERROR ON CREATE OR OPEN
.DUSR   ?OFIN=  1B?OPIB ;OPEN FOR INPUT
.DUSR   ?OFOT=  1B?OPOB ;OPEN FOR OUTPUT
.DUSR   ?OFIO=  ?OFIN+?OFOT     ;OPEN FOR INPUT AND OUTPUT



; ?ISTO FLAGS: BIT DEFINITIONS

.DUSR   ?IBP2=  4       ;LONG EXTENDED PACKET
.DUSR   ?IBFF=  5       ;SUPPRESS INITIAL FORM FEED FOR LINE PRINTERS
.DUSR   ?IBHN=  6       ;HOLD NON-PRIORITY READS
.DUSR   ?SHAP=  7       ;SHARED OPEN REQUEST

; ?ISTO FLAGS: MASK DEFINITIONS

.DUSR   ?IMP2=  1B?IBP2 ;LONG EXTENDED PACKET
.DUSR   ?IMFF=  1B?IBFF ;SUPPRESS INITIAL FORM FEED FOR LINE PRINTERS
.DUSR   ?IMHN=  1B?IBHN ;HOLD NON-PRIORITY READS
.DUSR   ?SHOP=  1B?SHAP ;SHARED OPEN


; ?IRES FLAGS: BIT DEFINITIONS FOR DENSITY MODE / MABELLED LAG TAPE

.DUSR   ?OIBM=  1B0.    ;OPEN AS AN IBM LABELED TAPE
.DUSR   ?OANS=  1B1.    ;OPEN AS AN ANSI LABELED TAPE
.DUSR   ?IDD0=  ?OPD0   ;RESERVED FOR DENSITY SETTING.
.DUSR   ?IDD1=  ?OPD1
.DUSR   ?IDD2=  ?OPD2
;               5       ;RESERVED BY AOS
;               6       ;RESERVED BY AOS
.DUSR   ?OBFM=  8.      ; USE BUFFERED TAPE I/O
.DUSR   ?OSTR=  9.      ; USE STREAMING TAPE I/O
.DUSR   ?INTEO= 10.     ; 9-TRACK TAPE EMULATION OVERRIDE
.DUSR   ?ICOFF= 11.     ; DATA COMPRESSION OFF

; ?IRES FLAGS: MASK DEFINITIONS FOR DENSITY MODE

.DUSR   ?IDAM=  ?OPAM           ;DENSITY AUTOMATICLY SELECTED
.DUSR   ?ID8=   ?OPDL           ;DENSITY 800 BPI
.DUSR   ?ID16=  ?OPDM           ;DENSITY 1600 BPI
.DUSR   ?ID62=  ?OPDH           ;DENSITY 6250 BPI
.DUSR   ?ID5=   ?OPD5           ; DENSITY LOW
.DUSR   ?ID6=   ?OPD6           ; DENSITY MEDIUM
.DUSR   ?ID7=   ?OPD7           ; DENSITY HIGH
;               1B5             ;RESERVED BY AOS
;               1B6             ;RESERVED BY AOS
.DUSR   ?OMBFM= 1B?OBFM         ; USE BUFFERED TAPE I/O
.DUSR   ?OMSTR= 1B?OSTR         ; USE STREAMING TAPE I/O
.DUSR   ?IMNTE= 1B?INTEO        ; 9-TRACK TAPE EMULATION MODE
.DUSR   ?IMCOF= 1B?ICOFF        ; DATA COMPRESSION OFF

;
; GENERAL PACKET FOR SYSTEM CALLS WHICH ACCEPT CHANNEL NUMBERS
;
;       USED FOR ?CRUDA/?DELETE/?GACL/?GLINK/?RENAME/?SACL/?SATR
;

.DUSR   ?GCPFW= 0               ;PACKET VERSION NUMBER
.DUSR   ?GCPCN= ?GCPFW+1        ;CHANNEL NUMBER

.DUSR   ?GCPLT= ?GCPCN+1        ;PACKET LENGTH


; ?RDUDA/?WRUDA PACKET

.DUSR   ?PUDFW= 0               ;PACKET VERSION NUMBER
.DUSR   ?PUDCN= ?PUDFW+1        ;CHANNEL NUMBER
.DUSR   ?PUDAH= ?PUDCN+1        ;UDA BUFFER ADDRESS (HIGH)
.DUSR   ?PUDAL= ?PUDAH+1        ;UDA BUFFER ADDRESS (LOW)

.DUSR   ?PUDLT= ?PUDAL+1        ;LENGTH OF PACKET

; ?CPMAX PACKET

.DUSR   ?CPMFW= 0               ;PACKET VERSION NUMBER
.DUSR   ?CPMCN= ?CPMFW+1        ;CHANNEL NUMBER
.DUSR   ?CPMHS= ?CPMCN+1        ;NEW MAX SIZE (HIGH)
.DUSR   ?CPMLS= ?CPMHS+1        ;NEW MAX SIZE (LOW)

.DUSR   ?CPMPL= ?CPMLS+1        ;LENGTH OF PACKET

.DUSR   ?RFBS=  1B?RF1B+1B?RF2B+1B?RF3B ;RECORD FORMAT MASK

; RECORD FORMAT FIELD DEFINITIONS

.DUSR   ?RTDY=  (?ORDY)B?RF3B           ;DYNAMIC
.DUSR   ?RTDS=  (?ORDS)B?RF3B           ;DATA SENSITIVE
.DUSR   ?RTFX=  (?ORFX)B?RF3B           ;FIXED LENGTH
.DUSR   ?RTVR=  (?ORVR)B?RF3B           ;VARIABLE LENGTH
.DUSR   ?RTUN=  (?ORUN)B?RF3B           ;UNDEFINED
.DUSR   ?RTVB=  (?ORVB)B?RF3B           ;IBM VARIABLE BLOCK VARIABLE RECORD




;SCREEN MANAGEMENT PACKET OFFSETS

.DUSR   ?ESFC=  0               ;STATUS/FUNCTION
.DUSR   ?ESEP=  1               ;EDIT POSITION
.DUSR   ?ESCR=  2               ;<COLUMN><ROW> FOR CURSOR POS.
.DUSR   ?ESLN=  3               ;LENGTH SCREEN MANAGEMENT PACKET

;STATUS/FUNCTION BITS

.DUSR   ?ESSE=  1B0             ;SCREEN EDIT
.DUSR   ?ESRD=  1B1             ;REDISPLAY
.DUSR   ?ESNR=  1B2             ;DROP TYPE-AHEAD
.DUSR   ?ESED=  1B3             ;NO ECHO FOR DELIMITERS
.DUSR   ?ESCP=  1B4             ;CURSOR POSITIONING
.DUSR   ?ESDD=  1B5             ;READ ENDED IN DOUBLE DELIMITER
.DUSR   ?ESRP=  1B6             ;RETURN CURSOR POSITION AFTER I/O
.DUSR   ?ESNE=  1B7             ;NO ECHO ON INPUT
.DUSR   ?ESGT=  1B8.            ;GET TYPED AHEAD CHARACTERS
.DUSR   ?ESBE=  1B9.            ;READ TERMED ON INPUT BUFFER EMPTY
.DUSR   ?ESPE=  1B10.           ;ACCEPT POINTER INPUT
.DUSR   ?ESBB=  1B11.           ;NO ECHO ON PREDISPLAY

;SELECTED FIELD TRANSLATION PACKET OFFSETS

.DUSR   ?EFNF=  0               ;RIGHT BYTE - NUMBER OF FIELDS
                                ;LEFT BYTE - RESERVED
;THE FOLLOWING THREE WORD PACKET IS DUPLICATED FOLLOWING ?EFNF
;FOR EACH FIELD TO BE TRANSLATED

.DUSR   ?EFFP=  0               ;BYTE OFFSET TO FIELD
.DUSR   ?EFLN=  1               ;FIELD LENGTH
.DUSR   ?EFTY=  2               ;TRANSLATION TYPE (SEE BELOW)
.DUSR   ?EFTL=  3               ;LOW ORDER OF ?EFTY
.DUSR   ?EFMAX= ?EFTL+1         ;# OF ENTRIES IN PACKET - MUST
                                ;BE UPDATED IF PACKET SIZE CHANGES

;TRANSLATION TYPES FOR SELECTED TRANSLATION

.DUSR   ?ASEB=  0               ;ASCII TO EBCDIC
.DUSR   ?EBAS=  1               ;EBCDIC TO ASCII
.DUSR   ?ALAU=  2               ;ASCII LOWER TO ASCII UPPER
.DUSR   ?AUAL=  3               ;ASCII UPPER TO ASCII LOWER
.DUSR   ?SPAR=  4               ;STRIP PARITY
.DUSR   ?AEPR=  5               ;ADD EVEN PARITY
.DUSR   ?AOPR=  6               ;ADD ODD PARITY
.DUSR   ?TRMAX= ?AOPR+1         ;NUMBER OF TRANSLATION TYPES

;CODES 7-17 ARE RESERVED.  ANY VALUE > 17 IS ASSUMED TO BE THE
;ADDRESS OF A USER SUPPLIED TRANSLATION TABLE.

;LABELED TAPE EXTENSION PACKET OFFSETS

.DUSR   ?ELVL=  0               ;VOLUME IDENTIFIER
.DUSR   ?ELGN=  3               ;GENERATION NUMBER
.DUSR   ?ELVR=  4               ;VERSION NUMBER
.DUSR   ?ELCR=  5               ;CREATION DATE
.DUSR   ?ELRE=  6               ;RETENTION PERIOD
.DUSR   ?ELCT=  7               ;LEFT BYTE - # USER TRAILER LABELS
                                ;RIGHT BYTE - # USER HEADER LABELS
                                ;?ELEP - LONG EXTENDED PACKET
.DUSR   ?ELUH=  10              ;BYTE ADDRESS OF USER HEADER LABEL AREA
.DUSR   ?ELUL=  ?ELUH+1         ;LOWER PORTION OF ?ELUH
.DUSR   ?ELUT=  ?ELUL+1         ;BYTE ADDRESS OF USER TRAILER LABEL AREA
.DUSR   ?ELLL=  ?ELUT+1         ;LOWER PORTION OF ?ELUT
.DUSR   ?ELFS=  ?ELLL+1         ;BYTE PTR TO FILE SET IDENTIFER
.DUSR   ?ELFL=  ?ELFS+1         ;LOWER PORTION OF ?ELFS
.DUSR   ?ELAC=  ?ELFL+1         ;RIGHT BYTE = ACCESS CODE
                                ;LEFT BYTE = LEVEL OF LABELLING
.DUSR   ?ELLN=  ?ELAC+1         ;LENGTH OF LABEL PACKET

;DEFINE LONG EXTENDED PACKET

.DUSR   ?ELFG   = ?ELAC+1       ;FLAGS WORD
.DUSR   ?ELSN   = ?ELFG+1       ;FILE SECTION NUMBER
.DUSR   ?ELLX   = ?ELSN+1       ;LENGTH OF LONG EXTENDED PACKET

;MASKS TO BE USED IN LABELLED TAPE EXTENSION

.DUSR   ?ELEP=  1B0.            ;LONG (EXTENDED) EXTENDED PACKET
.DUSR   ?ELL1=  1B7.            ;LEVEL 1
.DUSR   ?ELL2=  2B7.            ;LEVEL 2
.DUSR   ?ELL3=  3B7.            ;LEVEL 3

;BIT POSITIONS IN ?ELFG

.DUSR   ?ELMS   = 0             ;MAINTAIN FILE SECTION NUMBER
.DUSR   ?ELSP   = 1             ;SPECIFIC VOLUME REFERENCED
.DUSR   ?ELSQ   = 2             ;/SEQuence LMT switch
.DUSR   ?ELSMI  = 9.            ;SMI is global operator

; PIPE I/O PACKET OFFSETS

.DUSR   ?PIRV   = 0             ;REVISION OF PACKET
.DUSR   ?PIRS   = ?PIRV+1       ;RESERVED
.DUSR   ?PIFG   = ?PIRS+1       ;FLAGS WORD
.DUSR   ?PIPD   = ?PIFG+2       ;PENDING BEHAVIOR CODE
.DUSR   ?PITI   = ?PIPD+1       ;UNIQUE TASK ID
.DUSR   ?PIPI   = ?PITI+1       ;UNIQUE PROCESS ID OF WRITER
.DUSR   ?PILN   = ?PIPI+2       ;LENGTH OF PACKET

; ?PIPD BIT OFFSETS (PENDING BEHAVIOR)

.DUSR   ?PALW   = 0             ;ALWAYS PEND
.DUSR   ?PTWO   = 1             ;PEND ONLY IF PIPE IS TWO-ENDED
.DUSR   ?PNVR   = 2             ;NEVER PEND
.DUSR   ?PGRE   = 3             ;READ COMES HOME WHEN ANY DATA
                                ; HAS BEEN WRITTEN TO PIPE.(GREEDY
                                ; READ FUNCTIONALITY). OPTION VALID
                                ; ONLY ON READS FROM PIPE.


;EDITREAD PACKET OFFSETS

.DUSR   ?EPIB=  0               ;INSERTION BUFFER ADDRESS
.DUSR   ?EPIL=  ?EPIB+1         ;LOW ORDER BITS OF ?EPIB
.DUSR   ?EPIS=  ?EPIL+1         ;INSERTION BUFFER SIZE
.DUSR   ?EPUA=  ?EPIS+1         ;USER ARRAY ADDRESS
.DUSR   ?EPUL=  ?EPUA+1         ;LOW ORDER BITS OF ?EPUA
.DUSR   ?EPUS=  ?EPUL+1         ;USER ARRAY WORD SIZE
.DUSR   ?EPV0=  ?EPUS+1         ;V0 - USER VARIABLE
.DUSR   ?EPIM=  ?EPV0+1         ;INSERT MODE (0 = REPLACE)
.DUSR   ?EPDL=  ?EPIM+1         ;DELIMITER LENGTH (0,1,2)
.DUSR   ?EPDE=  ?EPDL+1         ;DELIMITER - <FIRST><SECOND>
.DUSR   ?EPST=  ?EPDE+1         ;INTERPRETER STATE
.DUSR   ?EPSC=  ?EPST+1         ;STATUS CODE
.DUSR   ?EPBI=  ?EPSC+1         ;BUFFER INDEX
.DUSR   ?EPR1=  ?EPBI+1         ;- RESERVED -
.DUSR   ?EPFS=  ?EPR1+1         ;FIELD SIZE
.DUSR   ?EPSF=  ?EPFS+1         ;STATUS/FUNCTION WORD
.DUSR   ?EPAS=  ?EPSF+1         ;ATTRIBUTE STATE
.DUSR   ?EPBL=  ?EPAS+1         ;BUFFER LENGTH (BYTES)
.DUSR   ?EPCP=  ?EPBL+1         ;LOGICAL COLUMN OF THE CURSOR
.DUSR   ?EPCH=  ?EPCP+1         ;CURRENT/LAST INPUT CHARACTER
.DUSR   ?EPEI=  ?EPCH+1         ;ECHO INDEX
.DUSR   ?EPVE=  ?EPEI+1         ;VISIBLE END OF LINE
.DUSR   ?EPFV=  ?EPVE+1         ;FIELD VERTICAL (ROW)
.DUSR   ?EPFH=  ?EPFV+1         ;FIELD HORIZONTAL (COLUMN)
.DUSR   ?EPOF=  ?EPFH+1         ;OFFSET OF LAST OPCODE EXECUTED
.DUSR   ?EPOP=  ?EPOF+1         ;CURRENT/LAST OPCODE EXECUTED
.DUSR   ?EPLN=  ?EPOP+1         ;LENGTH OF EDITREAD PACKET

;********************************************************************

        ;INTERPRETER STATES - ?EPST
.DUSR   ?ESNS=  59.             ;HIGHEST NUMBERED USER STATE
.DUSR   ?ESIS=  ?ESNS+1         ;INITIAL STATE
.DUSR   ?ESES=  ?ESIS+1         ;ECHO STATE
.DUSR   ?ESFS=  ?ESES+1         ;FINAL STATE
.DUSR   ?ESTS=  ?ESFS+1         ;TERMINATE STATE

        ;STATUS CODES RETURNED IN ?EPSC
.DUSR   ?ERDT=  0               ;DELIMITER TYPED
.DUSR   ?ERAO=  ?ERDT+1         ;ARGUMENT STACK OVERFLOW
.DUSR   ?ERAU=  ?ERAO+1         ;ARUGMENT STACK UNDERFLOW
.DUSR   ?ERBO=  ?ERAU+1         ;BUFFER OVERFLOW
.DUSR   ?EREC=  ?ERBO+1         ;ECHO PRINTABLE ONLY
.DUSR   ?ERCV=  ?EREC+1         ;CONFINEMENT VIOLATION
.DUSR   ?ERDO=  ?ERCV+1         ;DATA OUT OF RANGE
.DUSR   ?ERFT=  ?ERDO+1         ;FIELD TOO LARGE
.DUSR   ?ERIB=  ?ERFT+1         ;UNDEFINED INSERTION BUFFER
.DUSR   ?ERIE=  ?ERIB+1         ;INVALID EDIT PROGRAM
.DUSR   ?ERIP=  ?ERIE+1         ;INVALID INITIAL POSITION
.DUSR   ?ERTI=  ?ERIP+1         ;INVALID TAB INDEX
.DUSR   ?ERME=  ?ERTI+1         ;INSUFFICIENT PMGR MEMORY
.DUSR   ?ERTM=  ?ERME+1         ;MAXIMUM ITERATION COUNT EXCEEDED
.DUSR   ?ERUA=  ?ERTM+1         ;UNDEFINED USER ARRAY
.DUSR   ?ERUO=  ?ERUA+1         ;UNDEFINED OP_CODE
.DUSR   ?ERUV=  ?ERUO+1         ;ILLEGAL USER VARIABLE
.DUSR   ?ERUX=  ?ERUV+1         ;ILLEGAL XEQ
.DUSR   ?ERSF=  ?ERUX+1         ;INVALID ?EPSF SPECIFICATION

        ;BIT DEFINITIONS FOR STATUS/FUNCTION WORD ?EPSF
.DUSR   ?EBAD=  0               ;DATA ALREADY DISPLAYED
.DUSR   ?EBDT=  1               ;DROP TYPED AHEAD CHARACTERS

        ;BIT DEFINITIONS FOR ATTRIBUTE STATE WORD ?EPAS
.DUSR   ?EBBL=  13.             ;BLINK
.DUSR   ?EBDM=  14.             ;DIM
.DUSR   ?EBUL=  15.             ;UNDERLINE

;**************************************************************************

;
; PACKET FOR DISK FILE TRUNCATION (?GTRUNC)
;

.DUSR   ?TEFW=  0               ;RESERVED
.DUSR   ?TEFH=?TEFW+1           ;RESERVED
.DUSR   ?TEFM=?TEFH+1           ;FILE SIZE BYTES (HIGH)
.DUSR   ?TEFL=?TEFM+1           ;FILE SIZE BYTES (LOW)
.DUSR   ?TLTH=?TEFL+1           ;?GTRUNC PACKET SIZE


;
; PACKET FOR PROTECTED SHARED FILE OPEN AND PERMIT ACCESS TO A
; PROTECTED SHARED FILE (?SOPPF/?PMTPF)
;

.DUSR   ?PFFLG= 0               ; FLAG WORD
.DUSR   ?PFRNG= ?PFFLG+1        ; RING # OF TARGET SEGMENT (RESERVED
                                ; ON ?SOPPF CALL)
.DUSR   ?PFPID= ?PFRNG+1        ; PID OF TARGET SEGMENT (RESERVED ON
                                ; ?SOPPF CALL)
.DUSR   ?PFADW= ?PFPID+1        ; RESERVED
.DUSR   ?PFIH=  ?PFADW+1        ; PROTECTED FILE ID (HIGH)
.DUSR   ?PFIL=  ?PFIH+1         ; PROTECTED FILE ID (LOW)

.DUSR   ?PFLNG= ?PFIL+1         ; PACKET LENGTH

;
; ?PFFLG FLAGS: BIT DEFINITIONS
;

.DUSR   ?PFFB=  0       ; FIRST OPEN
.DUSR   ?PRWB=  1       ; OPEN FOR READ AND WRITE

; NOTE:  BITS 11. - 15. ARE DEFINED AS THE ACCESS PRIVILEGE BITS
;        ?FAC<O,W,A,R,E>.

;
; ?PFFLG FLAGS: MASK DEFINITIONS
;

.DUSR   ?PFFO=  1B?PFFB ; FIRST OPEN
.DUSR   ?PFRW=  1B?PRWB ; OPEN FOR READ AND WRITE


;
; PACKET FOR DIRECTORY ENTRY CREATION (?CREATE)
;


.DUSR   ?CFTYP= 0               ;ENTRY TYPE (RH) AND RECORD FORMAT (LH)
.DUSR   ?CPOR=  1               ;PORT NUMBER (IPC TYPES ONLY)
.DUSR   ?CHFS=  1               ;HASH FRAME SIZE (DIRECTORY TYPES ONLY)
.DUSR   ?CHID=  1               ;HOST ID (?FREM TYPE FILES ONLY )
.DUSR   ?CCPS=  1               ;FILE CONTROL PARAMETER (OTHERS)
.DUSR   ?CTIM=  2               ;POINTER TO TIME BLOCK
.DUSR   ?CTIL=  ?CTIM+1         ;LOWER PORTION OF ?CTIM
.DUSR   ?CACP=  ?CTIL+1         ;POINTER TO INITIAL ACL
.DUSR   ?CACL=  ?CACP+1         ;LOWER PORTION OF ?CACP
.DUSR   ?CMSH=  ?CACL+1         ;MAX SPACE ALLOCATED (?FCPD)
.DUSR   ?CMSL=  ?CMSH+1         ;MAX SPACE ALLOCATED (LOW)
.DUSR   ?CDEH=  ?CACL+1         ;RESERVED
.DUSR   ?CDEL=  ?CDEH+1         ;FILE ELEMENT SIZE
.DUSR   ?CMIL=  ?CDEL+1         ;MAXIMUM INDEX LEVEL DEPTH
.DUSR   ?CMRS=  ?CMIL+1         ;RESERVED

.DUSR   ?CLTH=  ?CMRS+1         ;LENGTH OF THE PARAMETER BLOCK

;
; TIME BLOCK
;

.DUSR   ?TCTH=  0               ;FILE CREATION TIME (HIGH)
.DUSR   ?TCTL=  1               ;FILE CREATION TIME (LOW)
.DUSR   ?TATH=  2               ;TIME LAST ACCESSED (HIGH)
.DUSR   ?TATL=  3               ;TIME LAST ACCESSED (LOW)
.DUSR   ?TMTH=  4               ;TIME LAST MODIFIED (HIGH)
.DUSR   ?TMTL=  5               ;TIME LAST MODIFIED (LOW)

.DUSR   ?TBLT=  ?TMTL+1         ;LENGTH OF TIME BLOCK

;
; LENGTH OF A USER DATA AREA
;
.DUSR   ?LNUD=  128.            ;LENGTH OF UDA



;
; PACKET OFFSETS FOR LOGICAL DISK INITIALIZATION (?INIT)
;

.DUSR   ?INPU=  0               ;BITS 0 - 7 = RESERVED, MUST BE
                                ;      SET TO ZERO ON INPUT.
                                ;      1B0 (OUTPUT) = FIXUP RECOMMENDED
                                ;      ON THE INITIALIZED DISK.
                                ;BITS 8 - 15 = NUMBER OF PHYSICAL
                                ;      UNITS IN THE LD.

;
; BIT POINTERS
;

.DUSR   ?INFR = 0.              ;FIXUP RECOMMENDED FLAG BIT

;
; MASKS
;

.DUSR   ?INFX = 1B(?INFR)       ;FIXUP RECOMMENDED MASK
.DUSR   ?INNM = 377             ;# OF PHYSICAL UNITS MASK


;
; PACKET FOR PROCESS CREATION (?PROC)
;      WARNING: DON'T CHANGE SEQUENCE ?PPCR THROUGH
;               ?PDFP WITHOUT CHANGING ?PROC CODE
;               IN AGENT

.DUSR   ?PFLG=  0       ;FLAGS (SEE BELOW)
.DUSR   ?PPRI=  1       ;PRIORITY
.DUSR   ?PSNM=  2       ;PROGRAM FILE BYTE POINTER
.DUSR   ?PSNL=  ?PSNM+1 ;LOWER PORTION OF ?PSNM
.DUSR   ?PIPC=  ?PSNL+1 ;MESSAGE HEADER POINTER
.DUSR   ?PIPL=  ?PIPC+1 ;LOWER PORTION OF ?PIPC
.DUSR   ?PNM=   ?PIPL+1 ;PROCESS NAME BYTE POINTER
.DUSR   ?PNML=  ?PNM+1  ;LOWER PORTION OF ?PNM
.DUSR   ?PMEM=  ?PNML+1 ;MAXIMUM SIZE IN BLOCKS
.DUSR   ?PMEL=  ?PMEM+1 ;LOWER PORTION OF ?PMEM
.DUSR   ?PDIR=  ?PMEL+1 ;DEFAULT DIRECTORY BYTE POINTER
.DUSR   ?PDIL=  ?PDIR+1 ;LOWER PORTION OF ?PDIR
.DUSR   ?PCON=  ?PDIL+1 ;CONSOLE DEVICE
.DUSR   ?PCOL=  ?PCON+1 ;LOWER PORTION OF ?PCON
.DUSR   ?PCAL=  ?PCOL+1 ;MAX # MULTIPLEXED .SYSTM CALLS
.DUSR   ?PWSS=  ?PCAL+1 ;MAX WORKING SET SIZE
.DUSR   ?PUNM=  ?PWSS+1 ;USER NAME BYTE POINTER
.DUSR   ?PUNL=  ?PUNM+1 ;LOWER PORTION OF ?PUNM
.DUSR   ?PPRV=  ?PUNL+1 ;PRIV BITS
.DUSR   ?PPCR=  ?PPRV+1 ;MAXIMUM NUMBER OF SONS OR BROTHERS THAT
                        ;CAN BE CREATED
.DUSR   ?PWMI=  ?PPCR+1 ;RESERVED FOR WORKING SET MINIMUM
                        ;PLUS 1 WORD TO KEEP EVEN WORD ALIGNMENT
.DUSR   ?PIFP=  ?PWMI+2 ;POINTER TO INPUT FILE
.DUSR   ?PIFL=  ?PIFP+1 ;LOWER PORTION OF ?PIFP
.DUSR   ?POFP=  ?PIFL+1 ;POINTER TO OUTPUT FILE
.DUSR   ?POFL=  ?POFP+1 ;LOWER PORTION OF ?POFP
.DUSR   ?PLFP=  ?POFL+1 ;POINTER TO LIST FILE
.DUSR   ?PLFL=  ?PLFP+1 ;LOWER PORTION OF ?PLFP
.DUSR   ?PDFP=  ?PLFL+1 ;POINTER TO DATA FILE
.DUSR   ?PDFL=  ?PDFP+1 ;LOWER PORTION OF ?PFDP
.DUSR   ?SMCH=  ?PDFL+1 ;MAX CPU TIME LIMIT (HIGH)
.DUSR   ?SMCL=  ?SMCH+1 ;MAX CPU TIME LIMIT (LOW)

.DUSR   ?PLTH= ?SMCL+1  ;LENGTH OF ?PROC PACKET (WITHOUT THE EXTENDER)

; ?PROC PACKET EXTENSION

.DUSR   ?PXSPI= ?PLTH  ;SUBPACKET INDICATOR
.DUSR   ?PXCPU= ?PXSPI+2 ;CPU NUMBER
.DUSR   ?PXULOC=?PXCPU+1 ; USER LOCALITY
.DUSR   ?PXLLOC=?PXULOC+1 ; LEGAL LOCALITIES BIT MAP
.DUSR   ?PXFLG= ?PXLLOC+1  ; EXTENDER FLAGS
.DUSR   ?PXPGN= ?PXFLG+1   ; B.P. TO PROCESS GROUP NAME
.DUSR   ?PXPUN= ?PXPGN+2   ; B.P. TO PROC'D USER NAME
.DUSR   ?PXUPID=?PXPUN+2  ; 128-BIT UNIQUE PID

.DUSR   ?PXLE=  ?PXUPID+8. ; LENGTH OF ?PROC PACKET WITH THE EXTENDER

; PROCESS CREATE FLAGS

.DUSR   ?PFPP=  1B0     ;PARALLEL PROC
.DUSR   ?PFDB=  1B1     ;ENTER AT DEBUGGER
.DUSR   ?PFEX=  1B2     ;BLOCK ON THIS PROCESS EXECUTION
.DUSR   ?PFPM=  1B3     ;PRIV BITS ARE A MASK OF CALLER'S BITS
.DUSR   ?PFDA=  1B5     ;DON'T PASS ?DACL
.DUSR   ?PBRK=  1B6     ;CREATE A BREAKFILE ON TRAPS & FATAL TERMS
.DUSR   ?PFBS=  1B7     ;PROC AND BLOCK SON
.DUSR   ?PDMP=  1B8     ;DUMP IF TRAP
.DUSR   ?PFXP=  1B10    ;EXTENDED PACKET FLAG
.DUSR   ?PFRS=  1B14    ;RES PROC
.DUSR   ?PFRP=  1B15    ;RES PREEMPTIBLE PROCESS


; DEFINE PROC PRIV BITS

.DUSR   ?PVPC=  1B15    ;CAN CREATE AN UNLIMITED NO OF PROCESSES
.DUSR   ?PVTY=  1B14    ;CAN CREATE PROC OF ANY TYPE
.DUSR   ?PVSU=  1B13    ;CAN BECOME SUPERUSER
.DUSR   ?PVPR=  1B12    ;CAN CREATE/CHANGE PRI AT ANY VALUE
.DUSR   ?PVPP=  1B11    ;PERIPHERAL PROC PRIV
.DUSR   ?PVEX=  1B10    ;CAN CREATE PROC AND NOT BLK
.DUSR   ?PVUI=  1B9     ;CAN SPECIFY A NEW USER NAME ON .PROC
.DUSR   ?PVDV=  1B8     ;CAN ACCESS DEVICES
.DUSR   ?PVIP=  1B7     ;CAN USE IPC PRIMITIVES
.DUSR   ?PVSM=  1B6     ;CAN BECOME SYSTEM MANAGER
.DUSR   ?PVSP=  1B5     ;SUPERUSER PROCESS PRIV
.DUSR   ?PVWS=  1B4     ;USER MAY CREATE A WIDE SON
.DUSR   ?PVWM=  1B3     ;RESERVED FOR WORKING SET MIN

; EXTENDER FLAG WORD BIT DEFINITIONS (?PXFLG)

.DUSR   ?PFLL=  1B0     ;DEFAULT LEGAL LOCALITIES

;
; PACKET TO OBTAIN PROCESS STATISTICS (?RUNTM)

; **** WARNING ****
; THIS PACKET'S DISPLACEMENT ORDER DUPLICATED IN ?PSTAT CALL PARAMETERS
;

;

;       ?RUNTM
;       <ERROR RTN>
;       <GOOD RTN>

;       AC2= ADDR OF PACKET TO RECEIVE THE STATISTICS

.DUSR   ?GRRH=  0               ;ELAPSED TIME IN SEC (HIGH)
.DUSR   ?GRRL=  1               ;ELAPSED TIME (LOW)
.DUSR   ?GRCH=  2               ;CPU TIME IN MSECS (HIGH)
.DUSR   ?GRCL=  3               ;CPU TIME (LOW)
.DUSR   ?GRIH=  4               ;I/O USAGE (HIGH)
.DUSR   ?GRIL=  5               ;I/O USAGE (LOW)
.DUSR   ?GRPH=  6               ;PAGE-MSECS HIGH
.DUSR   ?GRPL=  7               ;PAGE-MSECS LOW

.DUSR   ?GRLTH= ?GRPL+1         ;PACKET SIZE


; DEFINE PARAM PACKET FOR HISTOGRAM INIT


;       ?WHIST
;       <ERROR RTN>
;       <GOOD RTN>

; AC0= POINTER TO PROCESS HISTOGRAM
; AC1= FLAG TO DESCRIBE TYPE POINTER IN AC0
; AC2= PARAM PACKET ADDR

.DUSR   ?HWST=  0               ;START OF HISTOGRAM RANGE
.DUSR   ?HWSL=  ?HWST+1         ;LOWER PORTION OF ?HIST
.DUSR   ?HWEND= ?HWSL+1         ;END OF HISTOGRAM RANGE
.DUSR   ?HWEL=  ?HWEND+1        ;LOWER PORTION OF ?HIEND
.DUSR   ?HWWDS= ?HWEL+1         ;WORD GROUPING FOR HISTOGRAM
.DUSR   ?HWWL=  ?HWWDS+1        ;LOWER PORTION OF ?HIWDS
.DUSR   ?HWBUF= ?HWWL+1         ;ARRAY TO RECEIVE HISTOGRAM
.DUSR   ?HWBL=  ?HWBUF+1        ;LOWER PORTION OF ?HIBUF

.DUSR   ?HWLTH= ?HWBL+1         ;PACKET SIZE

; DEFINE ARRAY OFFSETS FOR HISTOGRAM
; ARRAY CONSISTS OF FIXED PREFACE CONTAINING GLOBAL INFO
; FOLLOWED BY THE ACTUAL HISTOGRAM ARRAY

.DUSR   ?HTTH=  0               ;TOTAL INTERVALS HIGH
.DUSR   ?HTTL=  1               ;TOTAL INTERVALS LOW
.DUSR   ?HPRH=  2               ;INTERVALS WITHIN TARGET PROC,
                                ; BUT OUTSIDE RANGE (HIGH)
.DUSR   ?HPRL=  3               ; " (LOW)
.DUSR   ?HAPH=  4               ;INTERVALS IN ANOTHER PROC (HIGH)
.DUSR   ?HAPL=  5               ; " LOW
.DUSR   ?HSBH=  6               ;INTERVALS WITHIN SYSTEM ,
                                ;BUT NOT SYSTEM IDLE LOOP (HIGH)
.DUSR   ?HSBL=  7               ; " LOW
.DUSR   ?HSIH=  10              ;INTERVALS IN IDLE LOOP (HIGH)
.DUSR   ?HSIL=  11              ; " LOW

.DUSR   ?HARAY= 12              ; ARRAY START

;
; USER PACKET DEFINITION FOR ?SWST
; --WORKING SET TRACE
;

.DUSR   ?WBAH = 0       ;BUFFER STARTING ADDRESS--HIGH
.DUSR   ?WBAL = ?WBAH+1 ;                         LOW
.DUSR   ?WBLH = ?WBAL+1 ;BUFFER LENGTH--HIGH
.DUSR   ?WBLL = ?WBLH+1 ;               LOW
.DUSR   ?WOPT = ?WBLL+1 ;OPTIONS
.DUSR   ?WINF = 1       ;MONITOR ONLY PAGES COMING IN
.DUSR   ?WOTF = 2       ;MONITOR ONLY PAGES GOING OUT
.DUSR   ?WPLN = 5       ;PACKET LENGTH
;
;BUFFER HEADER OFFSETS
;
.DUSR   ?WTRM = 0       ;TERMINTATION FLAGS
.DUSR   ?WTFH = ?WTRM+1 ;TOTAL # OF PAGE FAULTS--HIGH
.DUSR   ?WTFL = ?WTFH+1 ;                        LOW
.DUSR   ?WLFH = ?WTFL+1 ;# OF LOGICAL PAGE FAULTS--HIGH
.DUSR   ?WLFL = ?WLFH+1 ;                          LOW
.DUSR   ?WCTH = ?WLFL+1 ;TOTAL CPU TIME DURING TRACE--HIGH
.DUSR   ?WCTL = ?WCTH+1 ;                             LOW
.DUSR   ?WPFH = ?WCTL+1 ;# PAGES REMOVED BY PAGING ALGORITHM--HIGH
.DUSR   ?WPFL = ?WPFH+1 ;                                     LOW
.DUSR   ?WPSH = ?WPFL+1 ;#PAGES STOLEN BY OTHER PROCESSES--HIGH
.DUSR   ?WPSL = ?WPSH+1 ;                                  LOW
.DUSR   ?WTTT = 1       ;TARGET TERMINATION
.DUSR   ?WTCT = 2       ;CALLER TERMINATION
.DUSR   ?WTNB = 3       ;NO ROOM IN BUFFER
.DUSR   ?WTKT = 4       ;?KWST CALLED TO TERMINATE
.DUSR   ?WTBB = 5       ;INVALID BUFFER
                        ;RESERVE 8. WORDS
.DUSR   ?WLTH = 19.     ;LENGTH OF BUFFER HEADER


;
; USER PACKET DEFINITION FOR ?PSTAT
; RETURNS INTERESTING ITEMS FROM PROCESS TABLE
;

.DUSR   ?PSFP = 0       ;PROCESS ID OF FATHER
.DUSR   ?PSSN = ?PSFP+1 ;PROCESS ID'S OF SONS AS BIT ARRAY
                        ;IF BIT I = 1, THEN A SON HAS
                        ;PROCESS ID OF I
.DUSR   ?PSEN = ?PSSN+15. ;END OF BIT ARRAY
.DUSR   ?PSAL = 16. ;LENGTH OF BIT ARRAY IN WORDS
.DUSR   ?PSNR = ?PSSN+?PSAL ;# OF PROC'S TASKS SUSPENDED ON ?IREC
.DUSR   ?PSNS = ?PSNR+1 ;# OF TASKS BLOCKED AWAITING STACKS
.DUSR   ?PSST = ?PSNS+1 ;PROCESS STATUS WORD
.DUSR   ?PSQF = ?PSST+1 ;PROCESS PRIORITY ENQUEUE FACTOR
.DUSR   ?PSFL = ?PSQF+1 ;PROCESS FLAG WORD
.DUSR   ?PSF2 = ?PSFL+1 ;2ND FLAG WORD
.DUSR   ?PSF3 = ?PSF2+1 ;3RD FLAG WORD
.DUSR   ?PSF4 = ?PSF3+1 ;4TH FLAG WORD
.DUSR   ?PSF5 = ?PSF4+1 ;5TH FLAG WORD
;
;       PROCESS FLAG WORD BIT DEFINITIONS
;       IF NEITHER ?PSSB NOR ?PSPB IS SET, THEN THE PROCESS IS RESIDENT.
;
.DUSR   ?PSSP=  1B14.   ;SWAPPABLE PROCESS
.DUSR   ?PSSB=  ?PSFL*16.+14. ; BIT ADDR FOR SWAPPABLE PROCESS FLAG
.DUSR   ?PSPP=  1B1     ;PREEMPTIBLE PROCESS
.DUSR   ?PSPB=  ?PSFL*16.+1   ; BIT ADDR FOR PREEMPTIBLE FLAG
;
;       PROCESS TYPE BIT DEFINITIONS IN ?PSF5
; PROCESS       1B14.           1B15.
;  TYPE         XPT             HRP
;   A      =     0               0
;   B      =     1               0
;   C      =     1               1

.DUSR   ?PSXPT= 1B14.           ;EXTENDED PROCESS TYPE
.DUSR   ?PSBXP= ?PSF5*16.+14.   ;BIT ADDR FOR EXTENDED PROCESS TYPE BIT
.DUSR   ?PSHRP= 1B15.           ;HIGH RANGE PID
.DUSR   ?PSBHR= ?PSF5*16.+15.   ;BIT ADDR FOR HIGH RANGE PID BIT
.DUSR   ?PTMSK=  1B14.+1B15.    ;16-BIT WORD MASK FOR PROCESS TYPE

.DUSR   ?PSPR = ?PSF5+1 ;PRIORITY
.DUSR   ?PSCW = ?PSPR+1 ;CURRENT WORKING SET SIZE
.DUSR   ?PSPV = ?PSCW+1 ;PROCESS'S PRIVILEGE BITS
.DUSR   ?PSEX = ?PSPV+1 ;TIME SLICE EXPONENT FOR THE PROC
.DUSR   ?PSPD = ?PSEX+1 ;PROCESS ID

;THE FOLLOWING DUPLICATE THE ?RUNTM PARAMETER PACKET
.DUSR   ?PSRH = ?PSPD+1 ;ELAPSED TIME IN SEC (HIGH)
.DUSR   ?PSRL = ?PSRH+1 ;ELAPSED TIME (LOW)
.DUSR   ?PSCH = ?PSRL+1 ;CPU TIME IN MILLISECS (HIGH)
.DUSR   ?PSCL = ?PSCH+1 ;CPU TIME (LOW)
.DUSR   ?PSCPL = ?PSCL+1 ;MAX CPU TIME (HIGH)
.DUSR   ?PSCPLL = ?PSCPL+1 ;MAX CPU TIME (LOW)
.DUSR   ?PSPH = ?PSCPLL+1       ;PAGE-SECS (HIGH)
.DUSR   ?PSPL = ?PSPH+1 ;PAGE-SECS (LOW)

.DUSR   ?PSSL = ?PSPL+1 ;# OF SUB-SLICES IN TIME SLICE
.DUSR   ?PSMX = ?PSSL+1 ;MAX # OF LOGICAL PAGES ALLOWED, USER RING ONLY
.DUSR   ?PSMXL= ?PSMX+1 ;LOWER HALF OF ?PSMX
.DUSR   ?PSWS=  ?PSMXL+1        ; MAXIMUM WORKING SET SIZE
.DUSR   ?PSWM=  ?PSWS+1 ; MINIMUM WORKING SET SIZE
.DUSR   ?PSFA=  ?PSWM+1 ; # PAGE FAULTS SINCE PROC
.DUSR   ?PSFS=  ?PSFA+1 ; LOWER PORTION OF ?PSFA

;THE FOLLOWING ARE MEMORY DESCRIPTORS FOR RINGS 1 - 7
; THE BASE ADDRESS FOR THE MEMORY DESCRIPTOR FOR ANY RING
; CAN BE COMPUTED USING THE FOLLOWING FORMULA:
;       ?PMDIS + (?PDESLN * (RING # -1))

.DUSR   ?PMDIS= ?PSFS+1  ;MEMORY DESCRIPTORS
.DUSR   ?PMDSEN= ?PMDIS+(14*7)-1  ;END OF MEMORY AREA
.DUSR   ?PSIH  = ?PMDSEN+1 ;I/O USAGE (HIGH)
.DUSR   ?PSIL  = ?PSIH+1 ;I/O USAGE (LOW)
.DUSR   ?PSLFA = ?PSIL+1 ;# FAULTS WHICH DID NOT GO TO DISK
.DUSR   ?PSLFS = ?PSLFA+1 ;LOW HALF OF ?PSLFA

; THE FOLLOWING LOCATIONS ARE RESERVED FOR FUTURE USE
; AND THEIR CONTENTS MAY VARY WITHOUT NOTICE.


.DUSR   ?PSLTH = ?PSLFS+23 ;PACKET SIZE

; THE FOLLOWING IS THE DEFINITION OF EACH MEMORY DESCRIPTOR
; ENTRY. THERE ARE SEVEN, ONE FOR RINGS 1 - 7.

.DUSR   ?PUSPR= 0               ;# OF UNSHARED PAGES FROM
                                ; PROGRAM FILE
.DUSR   ?PBLKS= ?PUSPR+2        ; TOTAL # OF UNSHARED PAGES
.DUSR   ?PSHSZ= ?PBLKS+2        ; # OF SHARED PAGES
.DUSR   ?PSHST= ?PSHSZ+2        ; STARTING PAGE OF SHARED
.DUSR   ?PSPRST= ?PSHST+2       ; STARTING LOGICAL PAGE # OF
                                ;  COINCIDING START PAGE IN
                                ;  PROGRAM FILE
.DUSR   ?PSHSH= ?PSPRST+2       ; STARTING PAGE # OF SHARED
                                ;  AREA IN PROGRAM FILE
.DUSR   ?PDESLN= ?PSHSH+2       ; LENGTH OF SINGLE MEMORY DESC.

; THE FOLLOWING IS THE DEFINITION OF ?XPSTAT MEMORY DESCRIPTOR

.DUSR   ?XPUSPR= 0              ;# OF UNSHARED PAGES FROM
                                ; PROGRAM FILE
.DUSR   ?XPBLKS= ?XPUSPR+2      ; TOTAL # OF UNSHARED PAGES
.DUSR   ?XPSHSZ= ?XPBLKS+2      ; # OF SHARED PAGES
.DUSR   ?XPSHST= ?XPSHSZ+2      ; STARTING PAGE OF SHARED
.DUSR   ?XPSPRST= ?XPSHST+2     ; STARTING LOGICAL PAGE # OF
                                ;  COINCIDING START PAGE IN
                                ;  PROGRAM FILE
.DUSR   ?XPSHSH= ?XPSPRST+2     ; STARTING PAGE # OF SHARED
                                ;  AREA IN PROGRAM FILE
.DUSR   ?XPUWS=  ?XPSHSH+2      ; UNSHARED WORKING SET COUNT
.DUSR   ?XPSWS=  ?XPUWS+2       ; SHARED WORKING SET COUNT
.DUSR   ?XPDESLN= ?XPSWS+2      ; LENGTH OF SINGLE MEMORY DESC.


; USER PACKET DEFINITION FOR     ?XPSTAT     SYSTEM CALL
;
; RETURNS INTERESTING ITEMS FROM PROCESS TABLE, (AND MORE)
; THIS CALL SHOULD BE USED IN PLACE OF THE OLD ?PSTAT

.DUSR   ?XPSID  =(576*200000)+(0.*400)+0        ; ?XPSTAT PACKET ID(IE.(?XPSP)
.DUSR   ?XPSID1 =(576*200000)+(0.*400)+1        ; ?XPSTAT NEW PACKET ID

.DUSR   ?XPSP   = 0           ; SUB PACKET IDENTIFIER DWORD
.DUSR   ?XPSF   = ?XPSP+2     ; SUB FUNCTION ID
.DUSR   ?XPFP   = ?XPSF+1     ; PROCESS ID OF TARGET PID'S FATHER
.DUSR   ?XPNR   = ?XPFP+1     ; # OF TASKS SUSPENDED ON ?IREC
.DUSR   ?XPSNS  = ?XPNR+1     ; # OF TASKS BLOCKED AWAITING SYSTEM STACKS

; SEE ?PSTAT PACKET FOR THE DEFINITIONS OF THE BITS IN THE FOLLOWING WORDS

.DUSR   ?XPSW   = ?XPSNS+1    ; PROCESS STATUS WORD
.DUSR   ?XPSQF  = ?XPSW+1     ; PRIORITY QUEUE FACTOR
.DUSR   ?XPFL   = ?XPSQF+1    ; FIRST  PROCESS FLAG WORD
.DUSR   ?XPF2   = ?XPFL+1     ; SECOND PROCESS FLAG WORD
.DUSR   ?XPF3   = ?XPF2+1     ; THIRD  PROCESS FLAG WORD
.DUSR   ?XPF4   = ?XPF3+1     ; FOURTH PROCESS FLAG WORD
.DUSR   ?XPF5   = ?XPF4+1     ; FIFTH  PROCESS FLAG WORD

.DUSR   ?XPPR   = ?XPF5+1     ; PROCESS PRIORITY
.DUSR   ?XPCW   = ?XPPR+1     ; CURRENT WORKING SET SIZE IN PAGES (DWORD)
.DUSR   ?XPR1   = ?XPCW+2     ; RESERVED FOR FUTURE USE
.DUSR   ?XPPV   = ?XPR1+1     ; PROCESS PRIVILEGE BITS (SEE ?PSTAT DEFINITIONS)
.DUSR   ?XPEX   = ?XPPV+1     ; TIME SLICE EXPONENT
.DUSR   ?XPPD   = ?XPEX+1     ; PID OR VPID OF THE TARGET PROCESS
.DUSR   ?XPRH   = ?XPPD+1     ; # SECONDS ELAPSED SINCE PROCESS CREATION
.DUSR   ?XPCH   = ?XPRH+2     ; MILLISECONDS OF CPU TIME
.DUSR   ?XPCPL  = ?XPCH+2     ; MAXIMUM CPU TIME ALLOWED
.DUSR   ?XPPH   = ?XPCPL+2    ; PAGE USAGE OVER CPU TIME (PAGES/SEC)
.DUSR   ?XPMX   = ?XPPH+2     ; MAXIMUM LOGICAL PAGES FOR RING 7
.DUSR   ?XPWS   = ?XPMX+2     ; MAXIMUM WORKING SET SIZE
.DUSR   ?XPWM   = ?XPWS+2     ; MINIMUM WORKING SET SIZE
.DUSR   ?XPFA   = ?XPWM+2     ; NUMBER OF PAGE FAULTS SINCE PROCESS CREATION

.DUSR   ?XPDIS  = ?XPFA+2     ; WORD POINTER TO MEMORY DESCRIPTORS ARRAY BUFFER
.DUSR   ?XPDBS  = ?XPDIS+2    ; AVAILABLE BUFFER SIZE FOR MEMORY DESCRIPTORS
                              ;  (MUST BE AT LEAST 7*?PDESLN)
.DUSR   ?XPDRS  = ?XPDBS+1    ; ACTUAL NUMBER OF WORDS RETURNED IN BUFFER

.DUSR   ?XPIH   = ?XPDRS+1    ; # OF BLOCKS READ/WRITTEN
.DUSR   ?XPLFA  = ?XPIH+2     ; # OF PAGE FAULTS NOT REQUIRING I/O
.DUSR   ?XPSL   = ?XPLFA+2    ; # OF SUB-SLICES LEFT
.DUSR   ?XPCPU  = ?XPSL+1     ; CURRENT CPU NUMBER FOR THIS PROCESS

.DUSR   ?XPLL   = ?XPCPU+1    ; LEGAL LOCALITIES
.DUSR   ?XPULC  = ?XPLL+1     ; CURRENT USER LOCALITY
.DUSR   ?XPPL   = ?XPULC+1    ; PROGRAM LOCALITY
.DUSR   ?XPCID  = ?XPPL+1     ; CLASS ID OF THE PROCESS

.DUSR   ?XPPG   = ?XPCID+1    ; BYTE POINTER TO PROCESS GROUP NAME
.DUSR   ?XPGBS  = ?XPPG+2     ; AVAILABLE BUFFER SIZE FOR PROCESS GROUP NAME
.DUSR   ?XPGRS  = ?XPGBS+1    ; RETURNED PROCESS GROUP NAME SIZE IN BYTES

.DUSR   ?XPUN   = ?XPGRS+1    ; BYTE POINTER TO USER NAME
.DUSR   ?XPNBS  = ?XPUN+2     ; AVAILABLE BUFFER SIZE FOR USER NAME
.DUSR   ?XPNRS  = ?XPNBS+1    ; RETURNED USER NAME SIZE IN BYTES

.DUSR   ?XPPU   = ?XPNRS+1    ; BYTE POINTER TO PROC'D USER NAME
.DUSR   ?XPUBS  = ?XPPU+2     ; AVAILABLE BUFFER SIZE FOR PROC'D USER NAME
.DUSR   ?XPURS  = ?XPUBS+1    ; RETURNED PROC'D USER NAME SIZE IN BYTES

.DUSR   ?XPUPD  = ?XPURS+1    ; 128 BIT UNIQUE PROCESS ID (UPID)
                              ; (128. BITS = EIGHT WORDS)

.DUSR   ?XPGLT  = ?XPURS+1    ; RESERVED FOR GROUP ACLS
.DUSR   ?XPGAB  = ?XPGLT+2    ; RESERVED FOR GROUP ACLS
.DUSR   ?XPGRB  = ?XPGAB+1    ; RESERVED FOR GORUP ACLS
.DUSR   ?XPUQSH = ?XPGRB+1    ; UNIQUE SHARED PAGES
.DUSR   ?XPRS1  = ?XPUQSH+2   ; RESERVED FOR FUTURE USE

.DUSR   ?XPLTH  = ?XPRS1+2.   ; PACKET LENGTH


;               END OF   ?XPSTAT    PACKET DEFINITION


; USER PACKET DEFINITION FOR     ?SYLOG      SYSTEM CALL
;
; CODES IN AC0
.DUSR   ?SLRE   = -2
.DUSR   ?SLRS   = -1
.DUSR   ?SLSP   = 0
.DUSR   ?SLST   = 1
.DUSR   ?SLDS   = 2
.DUSR   ?SLES   = 3
.DUSR   ?SLTE   = 4
.DUSR   ?SLRF   = 5
.DUSR   ?SLSF   = 6
.DUSR   ?SLBC   = 7
.DUSR   ?SLEC   = 10
.DUSR   ?SLCSU  = 11
;
; EXTENDED STATUS RETURN BITS
.DUSR   ?SLON   = 1S31.
.DUSR   ?SLFL   = 1S30.
.DUSR   ?SLEX   = 1S29.
.DUSR   ?SLSU   = 1S28.
.DUSR   ?SLSEX  = 1S27.
;
; USED WHEN SETTING OR RETRIEVING A FILTER

.DUSR   ?SYLID  =(103*200000)+(0.*400)+0        ; ?SYLOG PACKET ID(IE.(?SYFBM)
.DUSR   ?SYSUID =?SYLID+1                       ; ?SYLOG SUPERUSER FILTER ID

.DUSR   ?SYFBM  = 0           ; PACKET IDENTIFIER DWORD
.DUSR   ?SYFLT  = ?SYFBM+2    ; EXCLUSION BIT MAP STARTS HERE
.DUSR   ?SYLEN  = ?SYFLT+((?LUMAX-?LSMI)/16.)+1
.DUSR   ?SYSULEN= ?SYFLT+((?LSMA-?LSMI)/16.)+1

;               END OF   ?SYLOG    PACKET DEFINITION


; FILE STATUS PACKET (?FSTAT)

.DUSR   ?STYP=  0       ;RECORD FORMAT (LEFT), FILE TYPE (RIGHT)
.DUSR   ?STIM=  1       ;-1
.DUSR   ?SACP=  2       ;-1
.DUSR   ?SPNH=  3       ;PORT NUMBER (HIGH) (IPC)
.DUSR   ?SHFS=  3       ;HASH FRAME SIZE (DIRECTORIES)
.DUSR   ?SDCU=  3       ;DEV CODE (LEFT), UNIT # (RIGHT) (UNIT)
.DUSR   ?SCPS=  3       ;FILE CONTROL PARAMETERS (OTHERS)
.DUSR   ?SLAU=  4       ;RESERVED
.DUSR   ?SPNL=  4       ;PORT NUMBER (LOW) (IPC)
.DUSR   ?SMSH=  5       ;MAX SPACE AVAILABLE (DP) (?FCPD AND
.DUSR   ?SMSL=  6       ; ?FLDU ONLY)
.DUSR   ?SDEH=  5       ;FILE ELEMENT SIZE (HIGH)
.DUSR   ?SDEL=  6       ;FILE ELEMENT SIZE (LOW)
.DUSR   ?SMIL=  7       ;MAX NUMBER OF INDEX LEVELS
.DUSR   ?STCH=  10      ;DATE OF FILE CREATION
.DUSR   ?STCL=  11      ;TIME OF FILE CREATION
.DUSR   ?STAH=  12      ;DATE OF LAST FILE ACCESS
.DUSR   ?STAL=  13      ;TIME OF LAST FILE ACCESS
.DUSR   ?STMH=  14      ;DATE OF LAST FILE MODIFICATION
.DUSR   ?STML=  15      ;TIME OF LAST FILE MODIFICATION
.DUSR   ?SSTS=  16      ;FILE STATUS WORD
.DUSR   ?SEFW=  17      ;RESERVED
.DUSR   ?SEFH=  ?SEFW+1 ;RESERVED
.DUSR   ?SEFM=  ?SEFH+1 ;FILE SIZE (BYTES) HIGH
.DUSR   ?SEFL=  ?SEFM+1 ;FILE SIZE (BYTES) (LOW)
.DUSR   ?SFAH=  ?SEFL+1 ;FIRST LOGICAL DISK ADDRESS (HIGH)
.DUSR   ?SFAL=  ?SFAH+1 ;FIRST LOGICAL DISK ADDRESS (LOW)
.DUSR   ?SIDX=  ?SFAL+1 ;CURRENT NUMBER OF INDEX LEVELS
.DUSR   ?SOPN=  ?SIDX+1 ;OPEN COUNT
.DUSR   ?SCSH=  ?SOPN+1 ;SPACE CURRENTLY ALLOCATED (DP) (?FCPD
.DUSR   ?SCSL=  ?SCSH+1 ; AND ?FLDU ONLY)
.DUSR   ?SLTH=  ?SCSL+1 ;LENGTH OF PACKET


;
; ?SSTS BITS
;

.DUSR   ?FSHB=  1B0     ; FILE IS SHARED
.DUSR   ?FMDB=  1B1     ; FILE HAS BEEN MODIFIED
.DUSR   ?FPRM=  1B5     ; FILE IS PERMANENT
.DUSR   ?FDLE=  1B6     ; DELETE FILE ON LAST CLOSE
.DUSR   ?FUDA=  1B7     ; FILE HAS A USER DATA AREA
.DUSR   ?FARA=  1B14.   ; ALL USERS HAVE READ ACCESS
.DUSR   ?FAEA=  1B15.   ; ALL USERS HAVE EXECUTE ACCESS

;
; ?SSTS BIT POINTERS
;

.DUSR   ?BSHB=  ?SSTS*16.+0
.DUSR   ?BMDB=  ?SSTS*16.+1
.DUSR   ?BPRM=  ?SSTS*16.+5
.DUSR   ?BDLE=  ?SSTS*16.+6
.DUSR   ?BUDA=  ?SSTS*16.+7
.DUSR   ?BARA=  ?SSTS*16.+14.
.DUSR   ?BAEA=  ?SSTS*16.+15.


; DIRECTORY SEARCH PACKET (FOR ?GNFN -- GET NEXT FILE NAME)

.DUSR   ?NFKY = 0       ; KEY -- ZERO TO INITIALIZE, OTHERWISE
                        ; SET BY SYSTEM ON PREVIOUS CALL
.DUSR   ?NFRS = ?NFKY+1 ; RESERVED
.DUSR   ?NFNM = ?NFRS+1 ; BYTE POINTER TO AREA TO RECEIVE NAME
.DUSR   ?NFNL = ?NFNM+1 ; LOWER PORTION OF ?NFNM
.DUSR   ?NFTP = ?NFNL+1 ; BYTE POINTER TO TEMPLATE OR -1
.DUSR   ?NFTL = ?NFTP+1 ; LOWER PORTION OF ?NFTP

.DUSR   ?NFLN = ?NFTL+1 ; LENGTH OF PACKET

;
; PACKET TO GET INITIAL MESSAGE (?GTMES)
;


.DUSR   ?GREQ=  0               ; REQUEST TYPE (SEE BELOW)
.DUSR   ?GNUM=  ?GREQ+1         ; ARGUMENT NUMBER
.DUSR   ?GSW=   ?GNUM+1         ; BYTE PTR TO POSSIBLE SWITCH
.DUSR   ?GSW1=  ?GSW+1          ; LOWER PORTION OF ?GSW
.DUSR   ?GRES=  ?GSW1+1         ; BYTE PTR TO AREA TO RECEIVE
.DUSR   ?GREL=  ?GRES+1         ; LOWER PORTION OF ?GRES
                                ; SWITCH
.DUSR   ?GTLN=  ?GREL+1         ; PACKET LENGTH

; REQUEST TYPES (?GREQ)

.DUSR   ?GMES=  0               ; GET ENTIRE MESSAGE
.DUSR   ?GCMD=  ?GMES+1         ; GET CLI COMMAND
.DUSR   ?GCNT=  ?GCMD+1         ; GET ARGUMENT COUNT
.DUSR   ?GARG=  ?GCNT+1         ; GET ARGUMENT
.DUSR   ?GTSW=  ?GARG+1         ; TEST SWITCH
.DUSR   ?GSWS=  ?GTSW+1         ; TEST SWITCHES
.DUSR   ?GDLC=  1B0             ; DISABLE LOWER TO UPPERCASE CONVERSION


; FLAGS RETURNED ON ?GFLG TYPE CALLS

.DUSR   ?GFCF=  1B0             ; CLI FORMAT

; BY CONVENTION, PROGRAMS CALLABLE FROM EXEC USE BITS 1 & 2
; IF ?GFCF IS 0.

.DUSR   ?GFEX=  1B1             ; FROM EXEC IF ON

;IF ?GFEX IS ON, ?GFXB GIVES JOB'S BATCH/INTERACTIVE STATUS

.DUSR   ?GFXB=  1B2             ; ON=BATCH, OFF=INTERACTIVE

; IN ADDITION, IF CLI IS INVOKED WITH ?GFCF 0, BOTH ?GFXB & ?GFEX
; EQUAL TO ZERO => EXECUTE COMMAND PASSED IN MESSAGE AND RETURN.


;
; TERMINATION MESSAGE FORMAT
;
;       BITS 0-4        RETURN FLAGS
;       BITS 5-7        TERMINATION CODE
;       BITS 8-15       PID TERMINATING PROCESS
;

;
; MASKS TO OBTAIN VARIOUS FIELDS FROM TERM MSG,
; OFFSET ?IUFL
;

.DUSR   ?RMSK=  37B4    ; MASK FOR RETURN FLAGS
.DUSR   ?TMSK=  7B7     ; MASK FOR TERM/OBIT CODE
.DUSR   ?PMSK=  377  ; MASK FOR PID

;
; SHIFT CODES TO MOVE FIELDS IN TERM MSG, OFFSET ?IUFL,
; TO LOW ORDER WORD AREA
;

.DUSR   ?RCFA=  -11.    ; RETURN CODE FIELD ALIGNMENT
.DUSR   ?TCFA=  -8.     ; TERM CODE FIELD ALIGNMENT

;
; TERMINATION/OBITUARY DEFINITIONS
;

.DUSR   ?TSELF= 0B7     ; 16 BIT SELF TERMINATION OCCURRED
.DUSR   ?TRAP=  1B7     ; 16 BIT USER TRAP OCCURRED
.DUSR   ?TCIN=  2B7     ; TERMINATED BY CONSOLE INTERRUPT
.DUSR   ?TSUP=  3B7     ; TERMINATED BY SUPERIOR PROCESS
.DUSR   ?TAOS=  4B7     ; TERMINATED BY AOS
.DUSR   ?TBCX=  5B7     ; CUSTOMER CONNECTION BROKEN
.DUSR   ?TCCX=  6B7     ; CUSTOMER CHAINED
.DUSR   ?TEXT=  7B7     ; EXTENDED TERMINATION CODE

;
; EXTENDED CODES
;

.DUSR   ?TABR=  8.      ; CUSTOMER DID ?TABT

.DUSR   ?T32T=  100     ; 32 BIT SELF TERMINATION OCCURRED
.DUSR   ?TR32=  101     ; 32 BIT USER TRAP OCCURRED

;
; DEFINITIONS OF FIELDS IN THE 32 BIT TRAP MESSAGE
;

.DUSR   ?TPET=  0       ;TRAP MSG EXTENDED TYPE WORD
.DUSR   ?TPA0=  ?TPET+1 ;AC0 AT TIME OF TRAP
.DUSR   ?TPA1=  ?TPA0+2 ;AC1 AT TIME OF TRAP
.DUSR   ?TPA2=  ?TPA1+2 ;AC2 AT TIME OF TRAP
.DUSR   ?TPA3=  ?TPA2+2 ;AC3 AT TIME OF TRAP
.DUSR   ?TPPC=  ?TPA3+2 ;PC AT TIME OF TRAP
.DUSR   ?TPTC=  ?TPPC+2 ;TRAP CODE WORD
.DUSR   ?TPLN=  ?TPTC+1 ;LENGTH OF IPC MESSAGE

;
; ?TABT MESSAGE LAYOUT
;

.DUSR   ?ABCD=  0       ; CODE (?TABR)
.DUSR   ?ABPH=  1       ; GLOBAL PORT FROM IREC ENTRY
.DUSR   ?ABPL=  2       ; LOW GLOBAL PORT
.DUSR   ?ABLP=  3       ; LOCAL PORT FROM IREC ENTRY

.DUSR   ?ABPD=  ?ABLP+1 ; CUSTOMER PID (NEW STYLE MESSAGE)

.DUSR   ?ABLN=  ?ABLP-?ABCD+1   ; ABORT MESSAGE LENGTH

.DUSR   ?ABNL=  ?ABPD-?ABCD+1   ; NEW ABORT MESSAGE LENGTH

;
; THESE ARE DEFINITIONS FOR THE NEW TERMINATION MESSAGE FORMAT
; FOR AUGMENTED AND EXTENDED PROGRAMS

.DUSR   ?TMXTC=         0               ;EXTENDED TERMINATION CODE
.DUSR   ?TMPRV=         ?TMXTC+1        ;PACKET REVISION NUMBER
.DUSR   ?TMRS=          ?TMPRV+1        ;RESERVED
.DUSR   ?TMPID=         ?TMRS+1         ;PID NUMBER
.DUSR   ?TMUPD=         ?TMPID+1        ;UNIQUE PROCESS ID
.DUSR   ?TMR2=          ?TMUPD+8.       ;RESERVED
.DUSR   ?TMR3=          ?TMR2+1         ;RESERVED
.DUSR   ?TMAC0=         ?TMR3+1         ;CONTENTS OF AC0 AT TERMINATION
.DUSR   ?TMAC1=         ?TMAC0+2        ;CONTENTS OF AC1 AT TERMINATION
.DUSR   ?TMAC2=         ?TMAC1+2        ;CONTENTS OF AC2 AT TERMINATION
.DUSR   ?TMAC3=         ?TMAC2+2        ;CONTENTS OF AC3 AT TERMINATION
.DUSR   ?TMCPC=         ?TMAC3+2        ;CARRY AND PC AT TERMINATION
.DUSR   ?TMSEC=         ?TMCPC+2        ;ELAPSED TIME SINCE CREATION
.DUSR   ?TMCPU=         ?TMSEC+2        ;MILLISECONDS OF CPU TIME USED
.DUSR   ?TMBLK=         ?TMCPU+2        ;NUMBER OF BLOCKS READ OR WRITTEN
.DUSR   ?TMPGS=         ?TMBLK+2        ;PAGE USAGE OVER CPU TIME (PAGE/SEC)
.DUSR   ?TMPGD=         ?TMPGS+2        ;NUMBER OF PAGE FAULTS SINCE CREATION
.DUSR   ?TMPGF=         ?TMPGD+2        ;NUMBER OF PAGE FAULTS NO DISK I/O
.DUSR   ?TMR4=          ?TMPGF+2        ;RESERVED
.DUSR   ?TMR5=          ?TMR4+1         ;RESERVED
.DUSR   ?TMR6=          ?TMR5+1         ;RESERVED
.DUSR   ?TMR7=          ?TMR6+1         ;RESERVED
.DUSR   ?TMR8=          ?TMR7+1         ;RESERVED
.DUSR   ?TMR9=          ?TMR8+1         ;RESERVED
.DUSR   ?TMTCD=         ?TMR9+1         ;TRAP CODE
.DUSR   ?TMMLG=         ?TMTCD+1        ;MESSAGE LENGTH OF SUBSEQUENT INFO
.DUSR   ?TMMSG=         ?TMMLG+1        ;MESSAGE AREA.

.DUSR   ?TDFL=          ?TMMSG+2        ;DEFAULT LENGTH OF TERMINATION
                                        ;MESSAGE


; EXTENDED TERMINATION CODES FOR ?TMXTC

.DUSR   ?XT16T=         ?TSELF          ;16 BIT SELF TERMINATION
.DUSR   ?XTR16=         ?TRAP           ;16 BIT TRAP OCCURRED
.DUSR   ?XTCIN=         ?TCIN           ;TERMINATED BY CONSOLE INTERRUPT
.DUSR   ?XTSUP=         ?TSUP           ;TERMINATED BY SUPERIOR PROCESS
.DUSR   ?XTAOS=         ?TAOS           ;TERMINATED BY AOS
.DUSR   ?XTBCX=         ?TBCX           ;CUSTOMER CONNECTION BROKEN
.DUSR   ?XTCCX=         ?TCCX           ;CUSTOMER CHAINED
.DUSR   ?XTABR=         ?TABR           ;CUSTOMER DID ?TABT
.DUSR   ?XT32T=         ?T32T           ;32 BIT SELF TERMINATION
.DUSR   ?XTR32=         ?TR32           ;32 BIT USER TRAP

;PACKET REVISION CODES

.DUSR   ?TM6=           0               ;REV 6 PACKET FORMAT



; FLAGS FOR RETURN TO CLI (?RETURN)


.DUSR   ?RFCF=  1B0             ; CLI FORMAT
.DUSR   ?RFWA=  1B2             ; WARNING (SEVERITY=1)
.DUSR   ?RFER=  2B2             ; ERROR   (SEVERITY=2)
.DUSR   ?RFAB=  3B2             ; ABORT   (SEVERITY=3)
.DUSR   ?RFEC=  1B3             ; ERROR CODE FLAG. IF SET,
                                ; AC0 CONTAINS ERROR CODE


;
; PACKET TO GET SYSTEM INFORMATION (?SINFO)
;

.DUSR   ?SIRN=  0       ; SYSTEM REV, LEFT BYTE=MAJOR,RIGHT BYTE=MINOR
.DUSR   ?SIRS=  ?SIRN+1 ; RESERVED
.DUSR   ?SIMM=  ?SIRS+1 ; LENGTH OF PHYSICAL MEMORY (HPAGE)
.DUSR   ?SIML=  ?SIMM+1 ; LOWER PORTION OF ?SIMM
.DUSR   ?SILN=  ?SIML+1 ; BYTE POINTER TO RECEIVE MASTER LDU NAME
.DUSR   ?SILL=  ?SILN+1 ; LOWER PORTION OF ?SILN
.DUSR   ?SIID=  ?SILL+1 ; BYTE POINTER TO RECEIVE SYSTEM IDENTIFIER
.DUSR   ?SIIL=  ?SIID+1 ; LOWER PORTION OF ?SIID
.DUSR   ?SIPL=  ?SIIL+1 ; UNEXTENDED PACKET LENGTH
.DUSR   ?SIOS=  ?SIIL+1 ; BYTE POINTER TO EXECUTING OP SYS PATHNAME
.DUSR   ?SIOL=  ?SIOS+1 ; LOWER PORTION OF ?SIOS
.DUSR   ?SSIN=  ?SIOL+1 ; SYSTEM IMPLEMENTATION NUMBER (?SAVS FOR AOSVS)

.DUSR   ?SIEX=  ?SSIN+6 ; EXTENDED PACKET LENGTH (INCLUDE 3 DOUBLE
                        ;        WORDS FOR FUTURE EXPANSIONS)


;
; FLAGS FOR ?SDLM CALL
;

.DUSR   ?SDDN=  0S0     ; AC0 = BYTE POINTER TO DEVICE NAME
.DUSR   ?SDCN=  1S0     ; AC0 = CHANNEL NUMBER
.DUSR   ?SDTO=  1S8.    ; SET DELIMITER TABLE FOR OUTPUT
.DUSR   ?SDTI=  1S9.    ; SET DELIMITER TABLE FOR INPUT
.DUSR   ?SDTP=  1S10.   ; SET DELIMITER TABLE FOR PRIORITY READ

;
; FLAGS FOR ?LOGCALLS
;

.DUSR   ?LSTART= 1B15.  ;START LOGGING
.DUSR   ?LSTOP=  0B15.  ;STOP LOGGING
.DUSR   ?LFOP=   1B14.  ;START FORCED OUTPUT

;
; PACKET FOR ?UIDSTAT CALL
;

.DUSR   ?UUID=          0               ;UNIQUE TASK IDENTIFIER
.DUSR   ?UTSTAT=        ?UUID+1         ;TASK STATUS WORD
.DUSR   ?UTID=          ?UTSTAT+1       ;STANDARD TASK ID
.DUSR   ?UTPRI=         ?UTID+1         ;TASK PRIORITY
.DUSR   ?UTLEN=         ?UTPRI+1        ;LENGTH OF PACKET

;
; PACKET TO SET/CLEAR/CHECK EXECUTE PROTECTION (?EXPO)
;

.DUSR   ?EWPNT= 0        ; WORD POINTER TO START OF BIT MAP
.DUSR   ?EBPNT= ?EWPNT+2 ; BIT OFFSET TO START OF BIT MAP

.DUSR   ?EPPL = ?EBPNT+2 ; PACKET LENGTH

;
; AC1 FLAG DEFINITIONS FOR ?CISND CALL
;

.DUSR   ?CSPNM = 1S0    ; FLAG AC0 AS A BYTE POINTER TO PROCESS NAME
.DUSR   ?CSPID = 0S0    ; FLAG AC0 AS A PROCESS ID ( PID )

.DUSR   ?CSFWD = 1S1    ; FORWARD ?CISND TO SON IF FATHER BLOCKED
.DUSR   ?CSDRP = 0S0    ; NO FORWARDING

;
; OPTIONS FOR CLEAR DEVICE SYSTEM CALL (?CLRDV)
;

.DUSR   ?CDRXON= 0              ;SIMULATE RECEIVING X-ON (CTRL-Q) --
                                ;I.E., CLEAR X-OFF (CTRL-S)
.DUSR   ?CDSBRK= ?CDRXON+1      ;TRANSMIT A BREAK

;
;       ?OPER CALL FLAGS
;

.DUSR   ?MFWT=  1B0             ;WAIT FOR RESPONSE IF SET



; DEFINE USER DEVICE DCT OFFSETS

.DUSR   ?UDVXM= 0               ;TCB ADDR OF IMSG WAITER
.DUSR   ?UDVL=  ?UDVXM+1        ;LOWER PORTION OF ?UDVXM
.DUSR   ?UDVIS= ?UDVL+1         ;INTERRUPT SERVICE ROUTINE ADDR
.DUSR   ?UDVSL= ?UDVIS+1        ;LOWER PORTION OF ?UDVIS
.DUSR   ?UDVBX= ?UDVSL+1        ;IXMT/IMSG MAILBOX
.DUSR   ?UDVX=  ?UDVBX+1        ;LOWER PORTION OF ?UDVBX
.DUSR   ?UDDRS= ?UDVX+1         ;POINTER TO POWERFAIL ROUTINE(UPPER)
.DUSR   ?UDDLS= ?UDDRS+1        ;POINTER TO POWERFAIL ROUTINE(LOWER)
.DUSR   ?UDVMS= ?UDDLS+1        ;DEVICE MASK
.DUSR   ?UDRS=  ?UDVMS+1        ;LENGTH OF EXTENSION ( ?UDLX or 0 = none)
.DUSR   ?UDLN=  ?UDRS+1         ;LENGTH OF SHORT USER DCT

; DEFINE EXTENDED USER DCT ?UDLX WORDS

.DUSR   ?UDDTR= 0               ;DEVICE TERMINATION ROUTINE(UPPER)
.DUSR   ?UDDLR= ?UDDTR+1        ;DEVICE TERMINATION ROUTINE(LOWER)
.DUSR   ?UDLX=  ?UDDLR+1        ;LENGTH OF EXTENDED USER DCT

.DUSR   ?UDLE=  ?UDLN+?UDLX     ;TOTAL LENGTH OF USER DCT


; DEFINE THE SECOND EXTENSION OF USER DCT (?FIDEF - AOS/RT32 ONLY)

.DUSR   ?UDIRL= ?UDDLR+1        ; ISR LENGTH (UPPER)
.DUSR   ?UDILR= ?UDIRL+1        ; ISR LENGTH (LOWER)
.DUSR   ?UDFX = ?UDILR+1        ; TOTAL LENGTH OF DCT EXTENSION
.DUSR   ?UDFE = ?UDLN+?UDFX     ; TOTAL LENGTH OF USER DCT


; DEFINE USER DEVICE MAP DEFINITION TABLE PARAMETERS

;   MAP DEFINITION TABLE ENTRY OFFSETS:
.DUSR   ?UDID=  0               ;MAP IDENTIFICATION WORD
.DUSR   ?UDNS=  1               ;# OF SLOTS TO BE ALLOCATED IN
                                ;  THIS MAP (0-37)
.DUSR   ?UDELTH= 2              ;LENGTH OF MAP DEFINITION TABLE
                                ;  ENTRY
.DUSR   ?UDMNE= 8.              ;MAXIMUM NUMBER OF TABLE ENTRIES


;   BIT PATTERNS USED TO DESCRIBE TYPE OF REQUEST IN MAP
;     IDENTIFICATION WORD:
.DUSR   ?UDBM=  0               ;BMC MAP REQUEST
.DUSR   ?UDDA=  1B5+0B10.       ;DCH A MAP REQUEST
.DUSR   ?UDDB=  1B5+1B10.       ;DCH B MAP REQUEST
.DUSR   ?UDDC=  1B5+2B10.       ;DCH C MAP REQUEST
.DUSR   ?UDDD=  1B5+3B10.       ;DCH D MAP REQUEST
.DUSR   ?UDDE=  1B5+4B10.       ;DCH E MAP REQUEST
.DUSR   ?UDDF=  1B5+5B10.       ;DCH F MAP REQUEST
.DUSR   ?UDDG=  1B5+6B10.       ;DCH G MAP REQUEST
.DUSR   ?UDDH=  1B5+7B10.       ;DCH H MAP REQUEST
.DUSR   ?UDDI=  1B5+10B10.      ;DCH I MAP REQUEST
.DUSR   ?UDDJ=  1B5+11B10.      ;DCH J MAP REQUEST
.DUSR   ?UDDK=  1B5+12B10.      ;DCH K MAP REQUEST
.DUSR   ?UDDL=  1B5+13B10.      ;DCH L MAP REQUEST
.DUSR   ?UDDM=  1B5+14B10.      ;DCH M MAP REQUEST
.DUSR   ?UDDN=  1B5+15B10.      ;DCH N MAP REQUEST
.DUSR   ?UDDO=  1B5+16B10.      ;DCH O MAP REQUEST
.DUSR   ?UDDP=  1B5+17B10.      ;DCH P MAP REQUEST

;   LENGTH OF MAP DEFINITION TABLE:
.DUSR   ?UDLTH= ?UDMNE*?UDELTH  ;LENGTH OF MAP DEFINITION TABLE

;:::EXEC PARAMETERS
;
;DEFINITIONS FOR ?EXEC (EXEC REQUEST)
;

;FUNCTION CODES


.DUSR ?XFMUN=   1       ;MOUNT A UNIT
.DUSR ?XFMLT=   2       ;MOUNT A LABELED TAPE
.DUSR ?XFDUN=   3       ;DISMOUNT A UNIT OR LABELED TAPE
.DUSR ?XFOTH=   4       ;SUBMIT A BATCH JOB FOR OTHER USER
.DUSR ?XFSUB=   5       ;SUBMIT A BATCH JOB
.DUSR ?XFLPT=   6       ;SUBMIT A PRINT FILE
.DUSR ?XFPTP=   7       ;SUBMIT A PAPER TAPE PUNCH FILE
.DUSR ?XFXTS=   10      ;Status report, Large PID
.DUSR ?XFPLT=   11      ;SUBMIT A PLOT FILE
.DUSR ?XFHAM=   12      ;SUBMIT A HAMLET FILE
.DUSR ?XFSNA=   13      ;SUBMIT AN SNA/RJE FILE
.DUSR ?XFFTA=   14      ;SUBMIT A FTA REQUEST
.DUSR ?XFXUN=   15      ;EXTENDED MOUNT A UNIT
.DUSR ?XFXML=   16      ;EXTENDED MOUNT A LABELED TAPE
.DUSR ?XFHOL=   17      ;HOLD A QUEUE ENTRY
.DUSR ?XFUNH=   20      ;UNHOLD A QUEUE ENTRY
.DUSR ?XFCAN=   21      ;CANCEL A QUEUE ENTRY
.DUSR ?XFSTS=   22      ;OBTAIN RELATIONSHIP TO EXEC
.DUSR ?XFQST=   23      ;GET QUEUE TYPE FROM QUEUE NAME

;THE FOLLOWING FUNCTIONS ARE RESERVED FOR INTERNAL USE

.DUSR ?XFLO=    24      ;LABELED TAPE OPEN
.DUSR ?XFLC=    25      ;LABELED TAPE CLOSE
.DUSR ?XFME=    26      ;MOUNT ERROR
.DUSR ?XFNV=    27      ;MOUNT NEXT VOLUME
.DUSR ?XF30R =  30      ;Reserved
.DUSR ?XFSV=    31      ;MOUNT SPECIFIC VOLUME
.DUSR ?XFMNT =  32      ;Submit a job to a MOUNT queue
.DUSR ?XFBAT =  33      ;Submit a job to a BATCH queue
.DUSR ?XFMOD =  34      ;Modify parameters of a queued job
.DUSR ?XFSQT =  35      ;Get queue type by sequence number
.DUSR ?XFNQN =  36      ;Get list of queue names
.DUSR ?XFQDS =  37      ;Given a queuename,
                        ; get info on all jobs in queue
.DUSR ?XFXDU =  40      ;Extended Dismount

;END OF INTERNAL FUNCTIONS

.DUSR ?XFUSR =  41      ;SUBMIT A REQUEST TO A USER QUEUE

.DUSR ?XFMIN=   ?XFMUN  ;LOWEST  ASSIGNED FUNCTION CODE
.DUSR ?XFMAX=   ?XFUSR  ;HIGHEST ASSIGNED FUNCTION CODE


;---------------------------------------------------------------------
;                      Queue Types
;---------------------------------------------------------------------
;   ( note: any change to the queue types here must be changed in
;     PARXAG.SR and XPPARS.SR )

.DUSR   ?XQSUB = 1              ;SUBMIT for other user (batch)
                                ; must be superuser
.DUSR   ?XQLPT = 2              ;PRINT
.DUSR   ?XQPTP = 3              ;PUNCH
.DUSR   ?XQPLT = 4              ;PLOT
.DUSR   ?XQHAM = 5              ;HAMLET
.DUSR   ?XQSNA = 6              ;SNA/RJE
.DUSR   ?XQMNT = 7              ;Mount queue
.DUSR   ?XQFTA = 8.             ;FTA
.DUSR   ?XQUSR = 9.             ;User queue

.DUSR   ?XQMIN = ?XQSUB         ;Minimun queue type
.DUSR   ?XQMAX = ?XQUSR         ;Maximum queue type


;FIRST WORD OF PACKET IS ALWAYS THE FUNCTION

.DUSR ?XRFNC=   0       ;FUNCTION
.DUSR ?XRES=    1       ;PACKET REVISION FIELD
.DUSR ?XPRV=    ?XRES   ;PACKET REVISION FIELD

;HIGH BIT OF FUNCTION CODE BIT MEANS REMOTE ?EXEC CALL

.DUSR   ?XBRMA= ?XRFNC*20+0     ; DEFLECT TO RMA
.DUSR   ?XMRMA= 1B0             ;    "        "

;----------------------------------------------------------------
;      Packet for ?XFSQT , queue type given sequence #
;----------------------------------------------------------------

.DUSR   ?XXQT   = ?XPRV+1       ;Queue type
.DUSR   ?XXSN   = ?XXQT+1       ;Sequence number
.DUSR   ?XXKN   = ?XXSN+1       ;Key number (returned)


;REMAINDER OF PACKET FOR ?XFMUN

.DUSR ?XMUL=    2       ;BYTE POINTER TO LOGICAL NAME
.DUSR ?XMULL=   ?XMUL+1 ;LOWER PORTION OF ?XMUL
.DUSR ?XMUT=    ?XMULL+1        ;BYTE POINTER TO OPERATOR TEXT
.DUSR ?XMTL=    ?XMUT+1 ;LOWER PORTION OF ?XMUT


;REMAINDER OF PACKET FOR ?XFXUN
.DUSR ?XMUQ=    ?XMUT+2 ;- RESERVED
.DUSR ?XMUR=    ?XMUQ+2 ;- RESERVED
.DUSR ?XMUF=    ?XMUR+2 ;FLAG WORD
;DUSR ?????=    ?XMUF+1 ;- RESERVED (ALIGNMENT WORD FOLLOWING FLAGS)
.DUSR ?XMUS=    ?XMUF+2 ;- RESERVED
.DUSR ?XMUE=    ?XMUS+2 ;- RESERVED
.DUSR ?XMUX=    ?XMUE+2 ;LENGTH OF WIDE EXTENDED UNIT MOUNT PACKET

;REMAINDER OF PACKET FOR ?XFMLT

.DUSR ?XMLL=    2       ;BYTE POINTER TO LOGICAL NAME
.DUSR ?XMLLL=   ?XMLL+1 ;LOWER PORTION OF ?XMLL
.DUSR ?XMLT=    ?XMLLL+1        ;BYTE POINTER TO OPERATOR TEXT
.DUSR ?XMLTL=   ?XMLT+1 ;LOWER PORTION OF ?XMLT
.DUSR ?XMLV=    ?XMLTL+1        ;BYTE POINTER TO VOLIDS
.DUSR ?XMLU=    ?XMLV+1 ;LOWER PORTION OF ?XMLV

;REMAINDER OF PACKET FOR ?XFXML
.DUSR ?XMLR=    ?XMLV+2 ;- RESERVED
.DUSR ?XMLF=    ?XMUF   ;FLAG WORD
;DUSR ?????=    ?XMLF+1 ;- RESERVED (ALIGNMENT WORD FOLLOWING FLAGS)
.DUSR ?XMLS=    ?XMLF+2 ;- RESERVED
.DUSR ?XMLE=    ?XMLS+2 ;- RESERVED
.DUSR ?XMLX=    ?XMLE+2 ;LENGTH OF WIDE EXTENDED LABEL MOUNT PACKET

;MOUNT STATUS BITS (FOR RESERVED FUNCTIONS)
.DUSR ?XMFC=    0       ;CHECK VOLID
.DUSR ?XMFI=    1       ;IBM
;     ?OPD0=    2       ;DENSITY - SAME AS
;     ?OPD1=    3       ;DENSITY - ?OPEN DENSITY
;     ?OPD2=    4       ;DENSITY - BITS
.DUSR ?XMFR=    5       ;READ ONLY
.DUSR ?XMEL=    6       ;ALLOW VOLID LIST TO BE EXTENDED
.DUSR ?XMFS=    7       ;FIRST/SPECIFIC VOLID (RESERVED)
.DUSR ?XMSQB=   8.      ; THIS IS A /SEQUENTIAL ?CLOSE

;EXTENDED MOUNT PACKET FLAG BITS (WORDS ?XMLF AND ?XMUF)
.DUSR ?XMIBM=   1B(?XMFI)       ;IBM TAPE
.DUSR ?XMRO=    1B(?XMFR)       ;READ ONLY
.DUSR ?XMEX=    1B(?XMEL)       ;EXTEND VOLID LIST
.DUSR ?XMSEQ=   1B(?XMSQB)      ;SEQUENTIAL FLAG

;BIT POINTERS FOR FLAGS WORD IN EXTENDED MOUNT PACKETS
.DUSR ?BIBM=    (?XMUF*20)+?XMFI ;IBM
.DUSR ?BRDO=    (?XMUF*20)+?XMRO ;READ ONLY

;REMAINDER OF PACKET FOR ?XFDUN

.DUSR ?XDUL=    2       ;BYTE POINTER TO LOGICAL NAME
.DUSR ?XDLL=    ?XDUL+1 ;LOWER PORTION OF ?XDUL
.DUSR ?XDUT=    ?XDLL+1 ;BYTE POINTER TO OPERATOR TEXT
                        ;(0 IF NONE)
.DUSR ?XDTL=    ?XDUT+1 ;LOWER PORTION OF ?XDUT


;-------------------------------------------------------------------
;REMAINDER OF PACKET FOR ?XFXDU
;-------------------------------------------------------------------

.DUSR ?XXDL=    ?XPRV+1    ;BYTE POINTER TO LOGICAL NAME
.DUSR ?XXDT=    ?XXDL+2    ;BYTE POINTER TO OPERATOR TEXT
.DUSR ?XXDP=    ?XXDT+2    ;BYTE POINTER TO PATHNAME
.DUSR ?XXDQ=    ?XXDP+2    ;BYTE POINTER TO QUEUENAME

;-------------------------------------------------------------------
;Remainder of packet for Queue type requests
;Queue Type requests are function codes:
;       ?XFSUB, ?XFLPT, ?XFPTP, ?XFPLT, ?XFHAM, ?XFSNA, XFFTA,
;       ?XFMNT, ?XFOTH, ?XFMOD AND ?XFUSR.
;-------------------------------------------------------------------

.DUSR ?XTYP=    2       ;-1 IF BATCH, ELSE B.P. QUEUE NAME
.DUSR ?XTYL=    ?XTYP+1 ;LOWER PORTION OF ?XTYP
.DUSR ?XDAT=    ?XTYL+1 ;DATE ENQUEUED (RETURNED)
.DUSR ?XRES1=   ?XDAT+1 ;IS 2ND FLAGS WORD,USE NAME ?XFG2
.DUSR ?XFG2=    ?XRES1  ;2ND FLAGS WORD
.DUSR   ?XFCO =  1      ;BIT 1 IS PRINT OUTPUT IN 2 COLUMNS
.DUSR   ?XFNH =  2      ;BIT 2 IS PRINT W/O HEADER PAGE
.DUSR   ?XF8B =  3      ;BIT 3 IS INPUT FILE IN 8-BIT CODE
.DUSR   ?XFTB =  4      ;BIT 4 IS TRUE BINARY
.DUSR   ?XFEP =  5      ;BIT 5 IS ENCRYPTED PASSWORD
.DUSR ?XTIM=    ?XRES1+1;TIME ENQUEUED (RETURNED)
.DUSR ?XRES2=   ?XTIM+1 ;RESERVED - DO NOT USE !!!
.DUSR ?XLPN=    ?XRES2  ;LOCAL PORT NUMBER
.DUSR ?XLMT=    ?XRES2+1;LIMIT (PAGES, BI-SECONDS, ETC.)
.DUSR ?XPRI=    ?XLMT+1 ;PRIORITY (0-377) -1 TO DEFAULT
                        ; (RETURNED IF DEFAULTED)
.DUSR ?XFGS=    ?XPRI+1 ;FLAGS
.DUSR   ?XFSH=  0       ;HOLD THIS SEQUENCE NUMBER
.DUSR   ?XFOH=  1       ;ON HOLD BY OPERATOR
.DUSR   ?XFCN=  2       ;IPC-TYPE NOTIFY
.DUSR   ?XFPE=  3       ;Don't pend calling process
.DUSR   ?XFDA=  5       ;DELETE AFTER PROCESSING
.DUSR   ?XFNR=  6       ;NOT RESTARTABLE ON SYSTEM/EXEC FAILURE
.DUSR   ?XFRT=  7       ;JOB RESTARTED
.DUSR   ?XFOC=  8.      ;JOB CANCELLED BY OPERATOR
.DUSR   ?XFUC=  9.      ;JOB CANCELLED BY USER
.DUSR   ?XFBI=  10.     ;OUTPUT IS IN BINARY
.DUSR   ?XFOP=  11.     ;REQUIRES OPERATOR ON DUTY
.DUSR   ?XFNO=  12.     ;NOTIFY SUBMITTOR WHEN DONE
.DUSR   ?XFRA=  13.     ;INTERPRET ?XAFD AND ?XAFT
.DUSR   ?XFTI=  14.     ;TITLES OPTION
.DUSR   ?XFFO=  15.     ;FOLDING OPTION
.DUSR ?XSEQ=    ?XFGS+1 ;SEQUENCE NUMBER (RETURNED)
.DUSR ?XFBP=    ?XSEQ+1 ;BP JOBNAME IF BATCH, FORMSNAME IF OUTPUT
.DUSR ?XFBL=    ?XFBP+1 ;LOWER PORTION OF ?XFBP
.DUSR ?XPBP=    ?XFBL+1 ;BP PATHNAME OF FILE (MUST BE COMPLETE PATHNAME)
.DUSR ?XPBL=    ?XPBP+1 ;LOWER PORTION OF ?XPBP
.DUSR ?XAFD=    ?XPBL+1 ;AFTER DATE (0 IF NONE)
.DUSR ?XAFT=    ?XAFD+1 ;AFTER TIME (0 IF NONE)

;Extender words for ?XFSUB through ?XFSNA and ?XFUSR

.DUSR ?XXW0=    ?XAFT+1 ;
.DUSR ?XXW0L=   ?XXW0+1 ;LOWER PORTION OF ?XXW0
.DUSR ?XXW1=    ?XXW0L+1
.DUSR ?XXW1L=   ?XXW1+1 ;LOWER PORTION OF ?XXW1
.DUSR ?XXW2=    ?XXW1L+1
.DUSR ?XXW2L=   ?XXW2+1 ;LOWER PORTION OF ?XXW2
.DUSR ?XXW3=    ?XXW2L+1
.DUSR ?XXW3L=   ?XXW3+1 ;LOWER PORTION OF ?XXW3

.DUSR ?XLTH=    ?XXW3L+1        ;LENGTH OF PACKET, REV 0 PKT

;EXTENDED PORTION OF PACKET FOR ?XFOTH
.DUSR ?XUSR=    ?XXW3L+1        ;USERNAME, RESERVED IF NOT ?XFOTH
.DUSR ?XPWD=    ?XUSR+2         ;PASSWORD, RESERVED IN NOT ?XFOTH

;REVISON 1 EXTENDED PACKET FOR ?XFLPT  (?PKRV = ?PKR1)
.DUSR ?XHBP=    ?XPWD+2         ;BP TO HEADER TEXT STRING
.DUSR ?XMBP=    ?XHBP+2         ;BP TO MAPPER FILENAME

.DUSR ?X1LTH=   ?XMBP+2         ;LENGTH OF REV 1 PKT, ?XFLPT & ?XFOTH


;---------------------------------------------------------------------
;   Modify packet definitions - ?XFMOD
;    The beginning og the packet is the same as for ?XFSUB
;    through ?XFSNA.
;---------------------------------------------------------------------
.DUSR   ?XWM0 = ?XMBP+2         ;Modify flags, word 0
.DUSR     ?W0LMT=  4    ;/CPU= New CPU limit in ?XLMT
.DUSR     ?W0BP=   5    ;/BEGIN= New beginning page # in ?XWW0
.DUSR     ?W0END=  6    ;/END= New ending page # in ?XWW1
.DUSR     ?W0COP=  7    ;/COPIES= New # copies in ?XWW2
.DUSR     ?W0PG=   8.   ;/PAGES= New pages limit in ?XLMT
.DUSR     ?W0QPR=  9.   ;/QPRIORITY= New qpriority in ?XPRI
.DUSR     ?W0JN=   10.  ;/JOBNAME= New jobname in ?XFBP
.DUSR     ?W0FBP=  11.  ;/FORMS= New form  in ?XFBP
.DUSR     ?W0ADT=  12.  ;/AFTER= New /after date in ?XAFD
.DUSR     ?W0QOT=  13.  ;/QOUTPUT= B.P. to new output file in ?XWW0
.DUSR     ?W0QLT=  14.  ;/QLIST= B.P. new qlist file in ?XWW1
.DUSR     ?W0DES= 15.   ;/DEST= B.P.to new destination string in ?XWW3
                        ; batch, print and plot only
.DUSR   ?XWM1 = ?XWM0+1         ;Modify flags, word 1
.DUSR     ?W1SH=   0    ;/HOLD Examine bit ?XFSH in word ?XFGS
.DUSR     ?W1DA=   1    ;/DELETE Examine bit ?XFDA in word ?XFGS
.DUSR     ?W1NR=   2    ;/RESTART Examine bit ?XFNR in word ?XFGS
.DUSR     ?W1BI=   3    ;/BINARY Examine bit ?XFBI in word ?XFGS
.DUSR     ?W1OP=   4    ;/OPERATOR Examine bit ?XFOP in word ?XFGS
.DUSR     ?W1NO=   5    ;/NOTIFY Examine bit ?XFNO in word ?XFGS
.DUSR     ?W1TI=   7    ;/TITLES Examine bit ?XFTI in word ?XFGS
.DUSR     ?W1FO=   8.   ;/FOLDLONGLINES Examine bit ?XFFO in word ?XFGS
.DUSR   ?XWM2  = ?XWM1+1
.DUSR   ?XWM3  = ?XWM2+1

;BIT POINTERS FOR ?XFG2  (?XFLPT FUNCTION CODE)
.DUSR   ?BFCO=  ?XFG2*20+?XFCO  ;PRINT OUTPUT IN 2 COLUMNS
.DUSR   ?BFNH=  ?XFG2*20+?XFNH  ;PRINT W/O HEADER PAGE
.DUSR   ?BF8B=  ?XFG2*20+?XF8B  ;INPUT FILE IS IN 8-BIT CODE
.DUSR   ?BFTB=  ?XFG2*20+?XFTB  ;TRUE BINARY
.DUSR   ?BFEP=  ?XFG2*20+?XFEP  ;ENCRYPTED PASSWORD

;BIT MASKS FOR ?XFG2  (?XFLPT FUNCTION CODE)
.DUSR   ?BMCO=  1B(?XFCO)       ;PRINT OUTPUT IN 2 COLUMNS
.DUSR   ?BMNH=  1B(?XFNH)       ;PRINT W/O HEADER PAGE
.DUSR   ?BM8B=  1B(?XF8B)       ;INPUT IS IN 8-BIT CODE
.DUSR   ?BMTB=  1B(?XFTB)       ;TRUE BINARY
.DUSR   ?BMEP=  1B(?XFEP)       ;ENCRYPTED PASSWORD

;BIT POINTERS FOR ?XFGS
.DUSR   ?BFSH=  ?XFGS*20+?XFSH  ;HOLD SEQUENCE NUMBER
.DUSR   ?BFDA=  ?XFGS*20+?XFDA  ;DELETE AFTER PROCESSING
.DUSR   ?BFNR=  ?XFGS*20+?XFNR  ;NOT RESTARTABLE
.DUSR   ?BFPE=  ?XFGS*20+?XFPE  ;Don't pend calling process
.DUSR   ?BFBI=  ?XFGS*20+?XFBI  ;BINARY
.DUSR   ?BFOP=  ?XFGS*20+?XFOP  ;OPERATOR
.DUSR   ?BFNO=  ?XFGS*20+?XFNO  ;NOTIFY
.DUSR   ?BFRA=  ?XFGS*20+?XFRA  ;AFTER
.DUSR   ?BFTI=  ?XFGS*20+?XFTI  ;TITLES
.DUSR   ?BFFO=  ?XFGS*20+?XFFO  ;FOLD

;BIT MASKS FOR ?XFGS
.DUSR   ?BMSH=  1B(?XFSH)       ;HOLD SEQUENCE NUMBER
.DUSR   ?BMDA=  1B(?XFDA)       ;DELETE AFTER PROCESSING
.DUSR   ?BMNR=  1B(?XFNR)       ;NOT RESTARTABLE
.DUSR   ?BMPE=  1B(?XFPE)       ;Don't pend calling process
.DUSR   ?BMBI=  1B(?XFBI)       ;BINARY
.DUSR   ?BMOP=  1B(?XFOP)       ;OPERATOR
.DUSR   ?BMNO=  1B(?XFNO)       ;NOTIFY
.DUSR   ?BMRA=  1B(?XFRA)       ;AFTER
.DUSR   ?BMTI=  1B(?XFTI)       ;TITLES
.DUSR   ?BMFO=  1B(?XFFO)       ;FOLD

;  Bit Pointers for ?XWM0 word (for ?XFMOD modify function)

.DUSR   ?M0LMT= ?XWM0*20+?W0LMT ;New limit word specified in ?XLMT
.DUSR   ?M0BP=  ?XWM0*20+?W0BP  ;New beginning page in ?XWW0
.DUSR   ?M0END= ?XWM0*20+?W0END ;New ending page in ?XWW1
.DUSR   ?M0COP= ?XWM0*20+?W0COP ;New # copies in ?XWW2
.DUSR   ?M0PG = ?XWM0*20+?W0PG  ;New page limit in ?XLMT
.DUSR   ?M0QPR= ?XWM0*20+?W0QPR ;New qpriority in?XPRI
.DUSR   ?M0JN = ?XWM0*20+?W0JN  ;New jobname in ?XFBP
.DUSR   ?M0FBP= ?XWM0*20+?W0FBP ;New form  in ?XFBP
.DUSR   ?M0ADT= ?XWM0*20+?W0ADT ;New /after date or time in ?XAFD
.DUSR   ?M0QOT= ?XWM0*20+?W0QOT ;New output file in ?XWW0
.DUSR   ?M0QLT= ?XWM0*20+?W0QLT ;New qlist file in ?XWW1
.DUSR   ?M0DES= ?XWM0*20+?W0DES ;New destination string in ?XWW3

;  Bit Masks for ?XWM0 word (for ?XFMOD modify function)

.DUSR   ?B0LMT= 1B(?W0LMT)      ;New limit word specified in ?XLMT
.DUSR   ?B0BP=  1B(?W0BP)       ;New beginning page in ?XWW0
.DUSR   ?B0END= 1B(?W0END)      ;New ending page in ?XWW1
.DUSR   ?B0COP= 1B(?W0COP)      ;New # copies in ?XWW2
.DUSR   ?B0PG = 1B(?W0PG)       ; New pages limit in ?XLMT
.DUSR   ?B0QPR= 1B(?W0QPR)      ;New qpriority in?XPRI
.DUSR   ?B0JN = 1B(?W0JN)       ;New jobname in ?XFBP
.DUSR   ?B0FBP= 1B(?W0FBP)      ;New form in?XFBP
.DUSR   ?B0ADT= 1B(?W0ADT)      ;New /after date or time in ?XAFD
.DUSR   ?B0QOT= 1B(?W0QOT)      ;New output file in ?XWW0
.DUSR   ?B0QLT= 1B(?W0QLT)      ;New qlist file in ?XWW1
.DUSR   ?B0DES= 1B(?W0DES)      ;New destination string in ?XWW3

;   Bit Pointers for word ?XWM1 ( ?XFMOD function, Modify)

.DUSR   ?M1SH=  ?XWM1*20+?W1SH  ;Examine bit ?XFSH in word ?XFGS
.DUSR   ?M1DA=  ?XWM1*20+?W1DA  ;Examine bit ?XFDA in word ?XFGS
.DUSR   ?M1NR=  ?XWM1*20+?W1NR  ;Examine bit ?XFNR in word ?XFGS
.DUSR   ?M1BI=  ?XWM1*20+?W1BI  ;Examine bit ?XFBI in word ?XFGS
.DUSR   ?M1OP=  ?XWM1*20+?W1OP  ;Examine bit ?XFOP in word ?XFGS
.DUSR   ?M1NO=  ?XWM1*20+?W1NO  ;Examine bit ?XFNO in word ?XFGS
.DUSR   ?M1TI=  ?XWM1*20+?W1TI  ;Examine bit ?XFTI in word ?XFGS
.DUSR   ?M1FO=  ?XWM1*20+?W1FO  ;Examine bit ?XFFO in word ?XFGS

;   Bit Masks for word ?XWM1 ( ?XFMOD function, Modify)

.DUSR   ?B1SH=  1B(?W1SH)       ;Examine bit ?XFSH in word ?XFGS
.DUSR   ?B1DA=  1B(?W1DA)       ;Examine bit ?XFDA in word ?XFGS
.DUSR   ?B1NR=  1B(?W1NR)       ;Examine bit ?XFNR in word ?XFGS
.DUSR   ?B1BI=  1B(?W1BI)       ;Examine bit ?XFBI in word ?XFGS
.DUSR   ?B1OP=  1B(?W1OP)       ;Examine bit ?XFOP in word ?XFGS
.DUSR   ?B1NO=  1B(?W1NO)       ;Examine bit ?XFNO in word ?XFGS
.DUSR   ?B1TI=  1B(?W1TI)       ;Examine bit ?XFTI in word ?XFGS
.DUSR   ?B1FO=  1B(?W1FO)       ;Examine bit ?XFFO in word ?XFGS


;PACKET OFFSETS FOR ?XFHOL THRU ?XFSTS

.DUSR   ?XFP1=  2       ;FIRST PARAMETER
.DUSR   ?XFP2=  3       ;SECOND PARAMETER
.DUSR   ?XFP2L= ?XFP2+1 ;LOWER PORTION OF ?XFP2

;PACKET OFFSETS FOR ?XFXTS

;DUSR   ?XFP1=  2       ;FIRST PARAMETER
;DUSR   ?XFP2=  3       ;SECOND PARAMETER
;DUSR   ?XFP2L= ?XFP2+1 ;LOWER PORTION OF ?XFP2
.DUSR   ?XFP3= ?XFP2L+1 ;3RD PARAMETER - RESERVED
.DUSR   ?XFP4= ?XFP3+1 ;15-BIT PID

;PACKET OFFSETS FOR ?XFLO THRU ?XFSV

.DUSR   ?XMDF=  ?XPRV+1 ;MOUNT DESCRIPTOR FLAGS
.DUSR   ?XRES3= ?XMDF+1 ;RESERVED
.DUSR   ?XDEV=  ?XRES3+1;BA(DEVICE NAME)
.DUSR   ?XVOL=  ?XDEV+2 ;BA(VOLUME IDENTIFIER)
.DUSR   ?XMFN=  ?XVOL+2 ;VS FILE NUMBER(/SEQ SWITCH-?XMSQB)
.DUSR   ?XMSQ=  ?XMFN+1 ;FILE SEQUENCE NUMBER(/SEQ SWITCH-?XMSQB)
.DUSR   ?XMFG=  ?XMSQ+1 ;FLAG WORD
.DUSR     ?XMSMI = 9.   ;OPERATOR IS SMI BIT
.DUSR   ?XRES4= ?XMFG+1 ;RESERVED

;STATUS BIT DEFINITIONS FOR LABELED TAPE INTERNAL FUNCTIONS

.DUSR ?XSCV=    ?XMDF*20+0      ;VOLID NOT VERIFIED YET
.DUSR ?XSMT=    ?XMDF*20+1      ;LABELED TAPE WAS EXPLICITLY MOUNTED
.DUSR ?XSVU=    ?XMDF*20+2      ;LABELED TAPE VOLID IS UNKNOWN
.DUSR ?XSIBM=   ?XMDF*20+?XMFI  ;IBM TAPE
.DUSR ?XSDEN=   ?XMDF*20+?OPD0  ;DENSITY BITS
.DUSR ?XSD1=    ?XMDF*20+?OPD1  ;DENSITY BITS
.DUSR ?XSD2=    ?XMDF*20+?OPD2  ;DENSITY BITS
.DUSR ?XSRO=    ?XMDF*20+?XMFR  ;READONLY
.DUSR ?XSEL=    ?XMDF*20+?XMEL  ;EXTEND VOLID LIST

;Bit Mask for SMI operator in labeled tape functions, word ?XMFG

.DUSR ?XBSMI =  ?XMFG*20+?XMSMI ;Bit on = SMI is global operator


;------------------------------------------------------------------
;   ?XFQDS Qdisplay function packet definition
;       (almost the same definitions as ?XFNQN)
;------------------------------------------------------------------

.DUSR   ?XFHK   = ?XPRV+1       ;Get next key, high
.DUSR   ?XFLK   = ?XFHK+2       ;Get next key, low
.DUSR   ?XNRQ   = ?XFLK+2       ;Max # requested
.DUSR   ?XNRT   = ?XNRQ+1       ;Actual # returned
.DUSR   ?XFQN   = ?XNRT+1       ;B(queuename)
.DUSR   ?XFWP   = ?XFQN+2       ;(buffer to receive info)

;   Qdisplay information buffer definitions

.DUSR   ?XDSD   = 0             ;Submission date
.DUSR   ?XDST   = ?XDSD+1       ;Submission time
.DUSR   ?XDSQN  = ?XDST+1       ;Sequence #
.DUSR   ?XD3FG  = ?XDSQN+1      ;Status flags
.DUSR   ?XDSFG  = ?XD3FG+1      ;Flags (?XFGS)
.DUSR   ?XD2FG  = ?XDSFG+1      ;Flags (?XFG2)
.DUSR   ?XDQP   = ?XD2FG+1      ;Qpriority
.DUSR   ?XDAD   = ?XDQP+1       ;/after date
.DUSR   ?XDTA   = ?XDAD+1       ;/after time
.DUSR   ?XDLMT  = ?XDTA+1       ;Limit value
.DUSR   ?XDBP   = ?XDLMT+1      ;Begin Page
.DUSR   ?XDEP   = ?XDBP+1       ;End Page
.DUSR   ?XDCOP  = ?XDEP+1       ;/copies=
.DUSR   ?XDRSV  = ?XDCOP+1      ;Reserved
.DUSR   ?XDUN   = ?XDRSV+1      ;B(user name)
.DUSR   ?XDJN   = ?XDUN+2       ;B(Jobname or Formsname)
.DUSR   ?XDPN   = ?XDJN+2       ;B(Pathname)

.DUSR   ?XLFWP= ?XDPN+2         ; Length of Qdisplay info buffer

;------------------------------------------------------------------
;    ?QFNQN Request a list of queuenames function
;           Packet Definitions
;------------------------------------------------------------------

;DUSR   ?XFHK   = ?XPRV+1       ;Get next key, high
;DUSR   ?XFLK   = ?XFHK+2       ;Get next key,low
;DUSR   ?XNRQ   = ?XFLK+2       ;Max # requested
;DUSR   ?XNRT   = ?XNRQ+1       ;Actual # returned
.DUSR   ?XFQT   = ?XNRT+1       ;Queue Types requested
                                ; -1 = all
.DUSR   ?XFLG   = ?XFQT+1       ;Flags
.DUSR    ?XQNI  = 0.            ;Queuename is input bit
;DUSR   ?XFWP   = ?XFLG+1       ;W(queue name block)

;   Masks for ?XFLG word

.DUSR   ?XMQN   = 1B(?XQNI)     ;Mask for queuename is input bit

;   Buffer definitions for queue name block, ?XFNQN function

.DUSR   ?XQ1FG  = 0             ;Flags
.DUSR    ?XQSTAT= 0.            ;Open/Closed bit
.DUSR    ?XQMSRT= 1.            ;May/May Not Start bit
.DUSR    ?XQDEL = 2.            ;May delete/May not delete bit
.DUSR    ?XQSRT = 3.            ;Start/Not Started bit
.DUSR    ?XQ1RSV= 4.            ;Reserved bit 1
.DUSR    ?XQ2RSV= 5.            ;Reserved bit 2
.DUSR   ?XQQT   = ?XQ1FG+1      ;Queue type
.DUSR   ?XQNJ   = ?XQQT+1       ;# jobs in queue
.DUSR   ?XQRSV  = ?XQNJ+1       ;Reserved
.DUSR   ?XQQN   = ?XQRSV+1      ;B(nth queuename)

.DUSR   ?XLQNB  = ?XQQN+2       ;Length of one queuename record

;Bit Masks for ?XQ1FG word in ?XFNQN block

.DUSR    ?X1STAT= 1B(?XQSTAT)   ;Queue is OPEN
.DUSR    ?X2STAT= 0B(?XQSTAT)   ;Queue is CLOSED
.DUSR    ?X1MSRT= 1B(?XQMSRT)   ;MAY NOT START the queue
.DUSR    ?X2MSRT= 0B(?XQMSRT)   ;MAY START the queue
.DUSR    ?X1DEL = 1B(?XQDEL)    ;May NOT delete the queue
.DUSR    ?X0DEL = 0B(?XQDEL)    ;May delete the queue
.DUSR    ?X1SRT = 1B(?XQSRT)    ;Queue is STARTED
.DUSR    ?X0SRT = 0B(?XQSRT)    ;Queue is NOT STARTED

;     LENGTH OF 32-BIT ?EXEC PACKETS BY FUNCTION CODE.

.DUSR   ?XLMUN= ?XMTL+1         ; LENGTH OF ?XFMUN PACKET
.DUSR   ?XLMLT= ?XMLU+1         ; LENGTH OF ?XFMLT PACKET
.DUSR   ?XLDUN= ?XDTL+1         ; LENGTH OF ?XFDUN PACKET
.DUSR   ?XLXDU= ?XXDQ+2         ; LENGTH OF ?XFXDU PACKET
.DUSR   ?XLOTH= ?XPWD+2         ; LENGTH OF ?XFOTH PACKET
.DUSR   ?XLSUB= ?XXW3L+1        ; LENGTH OF ?XFSUB PACKET (SAME AS ?XLTH)
.DUSR   ?XLLPT= ?XXW3L+1        ; LENGTH OF ?XFLPT PACKET (SAME AS ?XLTH)
.DUSR   ?XLPTP= ?XXW3L+1        ; LENGTH OF ?XFPTP PACKET (SAME AS ?XLTH)
.DUSR   ?XLXTS= ?XFP4+1         ; LENGTH OF ?XFXTS PACKET
.DUSR   ?XLPLT= ?XXW3L+1        ; LENGTH OF ?XFPLT PACKET (SAME AS ?XLTH)
.DUSR   ?XLHAM= ?XXW3L+1        ; LENGTH OF ?XFHAM PACKET (SAME AS ?XLTH)
.DUSR   ?XLRJ8= 0               ; - RESERVED
.DUSR   ?XLFTA= ?XXW3L+1        ; LENGTH OF ?XFFTA PACKET (SAME AS ?XLTH)
.DUSR   ?XLSNA= ?XXW3L+1        ; LENGTH OF ?XFSNA PACKET (SAME AS ?XLTH)
.DUSR   ?XLXUN= ?XMUE+2         ; LENGTH OF ?XFXUN PACKET (SAME AS ?XMUX)
.DUSR   ?XLXML= ?XMLE+2         ; LENGTH OF ?XFXML PACKET (SAME AS ?XMLX)
.DUSR   ?XLHOL= ?XFP2L+1        ; LENGTH OF ?XFHOL PACKET
.DUSR   ?XLUNH= ?XFP2L+1        ; LENGTH OF ?XFUNH PACKET
.DUSR   ?XLCAN= ?XFP2L+1        ; LENGTH OF ?XFCAN PACKET
.DUSR   ?XLSTS= ?XFP2L+1        ; LENGTH OF ?XFSTS PACKET
.DUSR   ?XLQST= ?XFP2L+1        ; LENGTH OF ?XFQST PACKET
.DUSR   ?XLSQT= ?XXKN+2         ; Length of ?XFSQT packet
.DUSR   ?XLLO=  ?XRES4+1        ; LENGTH OF ?XFLO PACKET
.DUSR   ?XLLC=  ?XRES4+1        ; LENGTH OF ?XFLC PACKET
.DUSR   ?XLME=  ?XRES4+1        ; LENGTH OF ?XFME PACKET
.DUSR   ?XLNV=  ?XRES4+1        ; LENGTH OF ?XFNV PACKET
.DUSR   ?XLSV=  ?XRES4+1        ; LENGTH OF ?XFSV PACKET
.DUSR   ?XL1LPT=?XMBP+2         ; LENGTH OF ?XFLPT PKT, REV 1
.DUSR   ?XL1OTH=?XMBP+2         ; LENGTH OF ?XFOTH PKT, REV 1
.DUSR   ?XL1SUB =?XMBP+2        ; LENGTH OF ?XFSUB PKT, REV 1
.DUSR   ?XLMNT= ?XXW3L+1        ; LENGTH OF ?XFMNT  PACKET
.DUSR   ?XLBAT =?XXW3L+1        ; Length of ?XFBAT packet
.DUSR   ?XLMOD= ?XWM3+1         ; Length of ?XFMOD packet
.DUSR   ?XLQDS= ?XFWP+2         ; Length of ?XFQDS packet
.DUSR   ?XLNQN= ?XFWP+2         ; Length of ?XFNQN packet
.DUSR   ?XL30R= 0               ; Reserved
.DUSR   ?XL1CAN=?XFP4+2         ; Length of ?XFCAN, rev1
.DUSR   ?XL1HOL=?XFP4+2         ; Length of ?XFHOL, rev1
.DUSR   ?XL1UNH=?XFP4+2         ; Length of ?XFUNH, rev1
.DUSR   ?XLUSR= ?XXW3L+1        ; LENGTH OF ?XFUSR PACKET (SAME AS ?XLTH)


;FTA TRANSFER OPTIONS FLAGS (IN WORD ?XXW2)
.DUSR   ?X2CM=  0  ;COMPRESSION REQUESTED
.DUSR   ?X2RC=  1  ;PROCESS ONLY IF SOURCE MORE RECENT
.DUSR   ?X2AP=  2  ;APPEND SOURCE TO DESTINATION IF IT EXISTS
.DUSR   ?X2SD=  3  ;DELETE THE SOURCE AFTER TRANSFER
.DUSR   ?X2DD=  4  ;DELETE THE DESTINATION BEFORE TRANSFER
.DUSR   ?X2RM=  5  ;USE RECORD MODE TRANSFER
.DUSR   ?X2TO=  6  ;LET CONNECTION TIMEOUT AFTER TRANSFER
.DUSR   ?X2CP=  7  ;RESTART AT LAST CHECKPOINT AFTER FAILURE

;BIT POINTERS FOR ?XXW2 FTA FLAGS
.DUSR   ?B2CM=  ?XXW2*20+?X2CM  ;COMPRESS
.DUSR   ?B2RC=  ?XXW2*20+?X2RC  ;RECENT
.DUSR   ?B2AP=  ?XXW2*20+?X2AP  ;APPEND
.DUSR   ?B2SD=  ?XXW2*20+?X2SD  ;DELETE SOURCE AFTER TRANSFER
.DUSR   ?B2DD=  ?XXW2*20+?X2DD  ;DELETE DESTINATION BEFORE TRANSFER
.DUSR   ?B2RM=  ?XXW2*20+?X2RM  ;RECORD MODE
.DUSR   ?B2TO=  ?XXW2*20+?X2TO  ;TIMEOUT
.DUSR   ?B2CP=  ?XXW2*20+?X2CP  ;RESTART AT CHECK POINT

;SNA/RJE PARAMETER VALUES:

;TYPE - TYPE OF READ AND DATA TRANSLATION (WORD ?XXW2)
.DUSR   ?X2LN=  (0)B3           ;DATA SENSITIVE (LINE) READ
.DUSR   ?X2SE=  (1)B3           ;DYNAMIC (SEQUENTIAL) READ
.DUSR   ?X2EB=  (2)B3           ;DYNAMIC READ OF 80. CHAR
.DUSR   ?X2HO=  (3)B3           ;HOLLERITH TO EBCDIC TRANS.

;MEDIUM - CLASS OF DEVICE (WORD ?XXW2)
.DUSR   ?X2CD=  (0)B7           ;CARD
.DUSR   ?X2CN=  (1)B7           ;CONSOLE
.DUSR   ?X2EX=  (2)B7           ;EXHANGE

;TRANSPARENT TRANSMISSION FLAG (WORD ?XXW3)
.DUSR   ?X3TR=  0

;CONCATENATE FLAG (WORD ?XXW3)
.DUSR   ?X3CO=  1

;BIT POINTERS TO FLAGS IN WORD ?XXW3
.DUSR   ?B3TR=  ?XXW3*20+?X3TR  ;TRANSPARENT TRANSMISSION FLAG
.DUSR   ?B3CO=  ?XXW3*20+?X3CO  ;CONCATENATE FLAG

;MASKS FOR SNA/RJE FIELDS (ALL BITS IN FIELD SET)
.DUSR   ?M2TY=  (3)B3           ;TYPE (WORD ?XXW2)
.DUSR   ?M2ME=  (3)B7           ;MEDIUM (WORD ?XXW2)
.DUSR   ?M2SU=  17              ;SUBADDRESS (WORD ?XXW2)
.DUSR   ?M3TR=  (1)B(?X3TR)     ;TRANSPARENT FLAG (WORD ?XXW3)
.DUSR   ?M3CO=  (1)B(?X3CO)     ;CONCATENATE FLAG (WORD ?XXW3)
.DUSR   ?M3ER=  377             ;ERCL (WORD ?XXW3)


;
; INTERPROCESS COMMUNICATION SYSTEM (IPC) PARAMETERS
;

; HIGHEST LEGAL LOCAL PORT NUMBER

.DUSR   ?IMPRT= 2047.   ;MAX LEGAL USER LOCAL PORT #
.DUSR   ?MXLPN= 4095.   ;MAX LEGAL LOCAL PORT #


; IPC MESSAGE HEADER

.DUSR   ?ISFL=  0       ;SYSTEM FLAGS
.DUSR   ?IUFL=  1       ;USER FLAGS

; PORT NUMBERS FOR ?ISEND
.DUSR   ?IDPH=  2       ;DESTINATION PORT NUMBER (HIGH)
.DUSR   ?IDPL=  3       ;DESTINATION PORT NUMBER (LOW)
.DUSR   ?IOPN=  4       ;ORIGIN PORT NUMBER

; PORT NUMBERS FOR ?IREC
.DUSR   ?IOPH=  2       ;ORIGIN PORT NUMBER (HIGH)
.DUSR   ?IOPL=  3       ;ORIGIN PORT NUMBER (LOW)
.DUSR   ?IDPN=  4       ;DESTINATION PORT NUMBER

.DUSR   ?ILTH=  5       ;LENGTH OF MESSAGE OR BUFFER (IN WORDS)
.DUSR   ?IPTR=  6       ;POINTER TO MESSAGE/BUFFER
.DUSR   ?IPTL=  ?IPTR+1 ;LOWER PORTION OF ?IPTR

.DUSR   ?IPLTH= ?IPTL+1 ;LENGTH OF HEADER

.DUSR   ?IRSV=  ?IPTL+1 ;RESERVED
.DUSR   ?IRLT=  ?IRSV+1 ;?IS.R RECEIVE BUFFER LENGTH
.DUSR   ?IRPT=  ?IRLT+1 ;?IS.R RECEIVE BUFFER POINTER
.DUSR   ?IRPL=  ?IRPT+1 ;LOWER PORTION OF ?IRPT
.DUSR   ?IPRLTH= ?IRPL+1 ; LENGTH OF ?IS.R HEADER

; SYSTEM FLAG BIT MASKS

.DUSR   ?IFSTM= 1B0     ;SEND TO SELF
.DUSR   ?IFRFM= 1B0     ;RECEIVE FROM SELF
.DUSR   ?IFSOV= 1B1     ;=1 => SPOOL MESSAGE IF BUFFER TOO SMALL
.DUSR   ?IFNBK= 1B2     ;=1 => RETURN ERROR IF NO WAITING MESSAGE
.DUSR   ?IFNSP= 1B3     ;=1 => DO NOT SPOOL MESSAGE
.DUSR   ?IFRING= 7B15   ;IPC SOURCE RING IDENTIFIER
.DUSR   ?IFDTH=  1B11.  ;OBIT FROM ?ASSOC'D PROCESS
.DUSR   ?IFPR= 1B12     ;16. BIT CALLER
                        ;1B4 RESERVED FOR SYSTEM USE
                        ;7B9 RESERVED FOR SYSTEM USE

;SYSTEM FLAG BIT POINTERS

.DUSR   ?IBSTM= ?ISFL*16.+0
.DUSR   ?IBRFM= ?ISFL*16.+0
.DUSR   ?IBSOV= ?ISFL*16.+1
.DUSR   ?IBNBK= ?ISFL*16.+2
.DUSR   ?IBNSP= ?ISFL*16.+3
.DUSR   ?IBDTH= ?ISFL*16.+11.
.DUSR   ?IBPR=  ?ISFL*16.+12.

;
; SYSTEM PORT NUMBERS
;

.DUSR   ?SPTM=  10      ;PORT FOR TRAP MESSAGES TO FATHER
.DUSR   ?SPRM=  11      ;PORT FOR RUNTIME MESSAGES TO FATHER
.DUSR   ?SIGP=  ?IMPRT+1 ;DEST. PORT FOR INITIAL AGENT MESSAGE
.DUSR   ?SPPT=  12      ;PORT FOR TERMINATION OF SPECIAL ASSOCIATED PROC
.DUSR   ?SRIM=  13      ; PORT FOR SYSTEM/REMA INTERFACE MESSAGES

; PARAMETERS FOR CONNECTION BIT MAP PASSED IN ?IPTL WORD
; ON CUSTOMER DISCONNECTS, TERMINATIONS AND/OR CHAINS

.DUSR   ?CXBBM0= 8.     ;STARTING POSITION OF BIT MAP IN ?IPTL
.DUSR   ?CXBED=  ?CXBBM0+0 ; EXPLICIT DISCONNECT

.DUSR   ?CXMBM= 377B(?CXBBM0+7) ; MASK FOR THE BIT MAP
.DUSR   ?CXMED= 1B(?CXBED)      ; MASK FOR EXPLICIT DISCONNECT



;       LOCATIONS DEFINED IN PHYSICAL BLOCK 0 OF THE .PR FILE

.DUSR   ?PRESWSZ= 377   ; PAGE SIZE OF EXTENSIBLE SWAPFILE REQUESTED
                        ; FOR RUNNING THIS PROGRAM.  IF 0 ( DEFAULT )
                        ; DEFAULT SWAPFILE SIZE IS USED.


;       USER STATUS TABLE (UST) TEMPLATE

.DUSR   UST=    400     ; START OF USER STATUS AREA

.DUSR   USTEZ=  0       ; EXTENDED VARIABLE  WORD COUNT
.DUSR   USTES=  USTEZ+1 ; EXTENDED VARIABLE PAGE 0 START
.DUSR   USTSS=  USTES+1 ; SYMBOLS START
.DUSR   USTSE=  USTSS+2 ; SYMBOLS END
.DUSR   USTDA=  USTSE+2 ; DEB ADDR OR -1
.DUSR   USTRV=  USTDA+2 ; REVISION OF PROGRAM
.DUSR   USTTC=  USTRV+2 ; NUMBER OF TASKS (1 TO 32.)
.DUSR   USTBL=  USTTC+1 ; # IMPURE BLKS
.DUSR   USTST=  USTBL+3 ; SHARED STARTING BLK #
                        ; USTST IS USTBL+3 BECAUSE THE 16. BIT USER'S
                        ; USTOD IS HIDDEN UNDERNEATH
.DUSR   USTIT=  USTST+2 ; INTERRUPT ADDRESS
.DUSR   USTSZ=  USTIT+2 ; SHARED SIZE IN BLKS
.DUSR   USTPR=  USTSZ+2 ; PROGRAM FILE TYPE (16 OR 32 BIT)
.DUSR   USTSH=  USTPR+5 ; PHYSICAL STARTING PAGE OF SHARED AREA IN .PR
.DUSR   USTEN=  USTPR+21 ; END OF USER UST
.DUSR   USTPL=  USTEN+6 ; PROGRAM LOCALITY

        ;USTPR FLAGS
.DUSR   UST16=  1B0     ; 16 BIT PROGRAM TYPE
.DUSR   UST32=  0B0     ; 32 BIT PROGRAM TYPE

.DUSR   USTPA=  0B15    ; PID SIZE TYPE 'SMALLPID' (<256)
.DUSR   USTPB=  2B15    ; PID SIZE TYPE 'HYBRID' (<256)
.DUSR   USTPC=  3B15    ; PID SIZE TYPE 'ANYPID' (>256)


; TASK STATUS BITS (RETURNED BY ?TIDSTAT CALL)

.DUSR   ?TSPN=  1B0     ; TASK PENDED
.DUSR   ?TSSG=  1B1     ; WAITING FOR .XMTW/.REC
.DUSR   ?TSSP=  1B2     ; SUSPENDED
.DUSR   ?TSRC=  1B3     ; WAITING FOR TRCON
.DUSR   ?TSOV=  1B4     ; WAITING FOR OVERLAY
.DUSR   ?TSWP=  1B5     ; UNPEND TASK VIA WDPOP
.DUSR   ?TSGS=  1B6     ; TASK PENDED DUE TO AGENT SYNCHRONIZATION
.DUSR   ?TSAB=  1B7     ; PENDED AWAITING AGENT ABORT PROCESSING
.DUSR   ?TSTL=  1B8     ; PENDED AWAITING ?TUNLOCK FROM ANOTHER TASK
.DUSR   ?TSYG=  1B9     ; TASK HAS BEEN ?SIGNLED (NOT A PEND BIT)
.DUSR   ?TSDR=  1B10    ; TASK PENDED FROM ?DRSCH
.DUSR   ?TSLK=  1B11    ; TASK PENDED ON A ?FLOCK REQUEST
.DUSR   ?TSXR=  1B12    ; TASK PENDED ON XMT OR REC
.DUSR   ?TWSG=  1B13    ; TASK ?WTSIGNL PENDED
.DUSR   ?TSUT=  1B14    ; AWAITING RETURN FROM USER ?UTSK CODE
.DUSR   ?TSUK=  1B15    ; AWAITING RETURN FROM USER ?UKIL CODE


;PACKET FOR TASK DEFINITION (?TASK)

.DUSR   ?DLNK=  0       ;NON-ZERO = SHORT PACKET, ZERO = EXTENDED
.DUSR   ?DLNL=  ?DLNK+1 ;LOWER PORTION OF ?DLNK
.DUSR   ?DLNKB= ?DLNL+1 ;BACKWARDS LINK (UPPER PORTION)
.DUSR   ?DLNKBL= ?DLNKB+1 ; BACKWARDS LINK (LOWER PORTION)
.DUSR   ?DPRI=  ?DLNKBL+1 ;PRIORITY, ZERO TO USE CALLER'S
.DUSR   ?DID=   ?DPRI+1 ;I.D., ZERO FOR NONE
.DUSR   ?DPC=   ?DID+1  ;STARTING ADDRESS OR RESOURCE ENTRY
.DUSR   ?DPCL=  ?DPC+1  ;LOWER PORTION OF ?DPC
.DUSR   ?DAC2=  ?DPCL+1 ;INITIAL AC2 CONTENTS
.DUSR   ?DCL2=  ?DAC2+1 ;LOWER PORTION OF ?DAC2
.DUSR   ?DSTB=  ?DCL2+1 ;STACK BASE, MINUS ONE FOR NO STACK
.DUSR   ?DSTL=  ?DSTB+1 ;LOWER PORTION OF ?DSTB
.DUSR   ?DSFLT= ?DSTL+1 ;STACK FAULT ROUTINE ADDR OR -1 IF SAME AS CURRENT
.DUSR   ?DSSZ=  ?DSFLT+1;STACK SIZE, IGNORED IF NO STACK
.DUSR   ?DSSL=  ?DSSZ+1 ;LOWER PORTION OF ?DSSZ
.DUSR   ?DFLGS= ?DSSL+1 ;FLAGS
.DUSR   ?DFL0=  1B0     ;RESERVED FOR SYSTEM
.DUSR   ?DFLRC= 1B1     ;RESOURCE CALL TASK
.DUSR   ?DFL15= 1B15    ;RESERVED FOR SYSTEM
.DUSR   ?DRES=  ?DFLGS+1 ;RESERVED FOR SYSTEM
.DUSR   ?DNUM=  ?DRES+1 ;NUMBER OF TASKS TO CREATE

.DUSR   ?DSLTH= ?DNUM+1 ;LENGTH OF SHORT PACKET

.DUSR   ?DSH=   ?DNUM+1 ;STARTING HOUR, -1 IF IMMEDIATE
.DUSR   ?DSMS=  ?DSH+1  ;STARTING SECOND IN HOUR, IGNORED IF IMMEDIATE
.DUSR   ?DCC=   ?DSMS+1 ;NUMBER OF TIMES TO CREATE TASK(S)
.DUSR   ?DCI=   ?DCC+1  ;CREATION INCREMENT  IN SECONDS

.DUSR   ?DXLTH= ?DCI+1  ; LENGTH OF EXTENDED PACKET

;BIT POINTER TO TASK DEF BITS

.DUSR   ?DFBRC= ?DFLGS*16.+1    ;RESOURCE CALL


;?TLOCK/?TUNLOCK PARAMETERS

.DUSR   ?TBMYRING= 0            ; BIT NUMBER FOR PROTECTION FROM
                                ; REDIRECTION IN THE CALLER'S RING
.DUSR   ?TBALOCK=  1            ; BIT NUMBER OF SYSTEM'S INDICATION THAT
                                ; REDIRECTION PROTECTION ALREADY IN
                                ; EFFECT

.DUSR   ?TMYRING= 1B(?TBMYRING) ; MASK TO SET/TEST PROTECTION IN
                                ; CALLER'S RING (MY RING)
.DUSR   ?TALOCK=  1B(?TBALOCK)  ; MASK TO TEST FOR PROTECTION ALREADY
                                ; IN EFFECT (ALREADY LOCKED)

;?DFRSCH RETURN FLAG DEFINITIONS:

.DUSR   ?DSCH=  1B0             ; TASK SCHEDULING WAS DISABLED AT
                                ;   TIME OF THE ?DFRSCH CALL

;  ?ENBRK PARAMETER PACKET DEFINITIONS

.DUSR   ?ENBFL= 0               ;FLAG WORD
.DUSR   ?ENSUS= ?ENBFL+1        ;START OF UNSHARED
.DUSR   ?ENEUS= ?ENSUS+2        ;END OF UNSHARED
.DUSR   ?ENSSH= ?ENEUS+2        ;START OF SHARED
.DUSR   ?ENESH= ?ENSSH+2        ;END OF SHARED
.DUSR   ?ENFNP= ?ENESH+2        ;BYTE POINTER TO PATHNAME
.DUSR   ?ENBLN= ?ENFNP+2        ;LENGTH OF PARAMETER PACKET

;  ?ENBRK PARAMETER PACKET FLAG WORD DEFINITIONS (?ENBFL)

.DUSR   ?ENUS=  1B0             ;DUMP UNSHARED MEMORY
.DUSR   ?ENSH=  1B1             ;DUMP SHARED MEMORY
.DUSR   ?ENDIR= 1B2             ;PATHNAME IS A DIRECTORY
.DUSR   ?ENCST= 1B3             ;RETURN CURRENT STATUS
.DUSR   ?ENPRE= 1B4             ;DUMP PREAMBLE
.DUSR   ?ENR4=  4               ;ENABLE BREAKFILE FOR RING 4
.DUSR   ?ENR5=  5               ;ENABLE BREAKFILE FOR RING 5
.DUSR   ?ENR6=  6               ;ENABLE BREAKFILE FOR RING 6
.DUSR   ?ENR7=  7               ;ENABLE BREAKFILE FOR RING 7
.DUSR   ?ENRMSK=7B15.           ;MASK FOR RING FIELD


;  PARAMETER PACKET DEFINITIONS FOR ?UIDOST

.DUSR   ?UPSW=  0               ;PSW IN PREVIOUS STATE
.DUSR   ?UAC0=  ?UPSW+2         ;AC0 IN PREVIOUS STATE
.DUSR   ?UAC1=  ?UAC0+2         ;AC1 IN PREVIOUS STATE
.DUSR   ?UAC2=  ?UAC1+2         ;AC2 IN PREVIOUS STATE
.DUSR   ?UAC3=  ?UAC2+2         ;AC3 IN PREVIOUS STATE
.DUSR   ?UPC=   ?UAC3+2         ;PC IN PREVIOUS STATE
.DUSR   ?ULN=   ?UPC+2          ;LENGTH OF PACKET


;  PARAMETER DEFINITIONS FOR ?AWIRE SYSTEM CALL

.DUSR   ?AWENT= 0               ;WIRE THE ENTIRE AGENT
.DUSR   ?AWUDS= ?AWENT+1        ;WIRE MINIMUM NEEDED FOR USER DEVICE
                                ;   SUPPORT



;SYNC CALL PARAMETER PACKET OFFSET DEFINITIONS

        ;ENABLE CALL PACKET ENTRIES
        .DUSR   ?SCHN=0         ;CHANNEL NUMBER
        .DUSR   ?SSTI=?SCHN+1   ;INPUT LINE DESCRIPTOR
        .DUSR   ?STOC=?SSTI+1   ;CONNECT TIMEOUT COUNT
        .DUSR   ?SMDI=?STOC+1   ;MULTIDROP INFO
        .DUSR   ?SELN=  ?SMDI+1 ; ENABLE PACKET LENGTH

        ;ENABLE CALL LINE DESCRIPTOR FLAGS
        .DUSR   ?SDPP=0B0       ;POINT-TO-POINT LINE
        .DUSR   ?SDMD=1B0       ;MULTI-DROP LINE
        .DUSR   ?SDSC=0B1       ;SECONDARY/TRIBUTARY STATION
        .DUSR   ?SDPR=1B1       ;PRIMARY/CONTROL STATION
        .DUSR   ?SEBC=0B2       ;LINE CODE=EBCDIC
        .DUSR   ?SASC=1B2       ;LINE CODE=ASCII
        .DUSR   ?SNPR=0B5       ;PARITY=NONE
        .DUSR   ?SOPR=1B5       ;      =ODD
        .DUSR   ?SEPR=2B5       ;      =EVEN
        .DUSR   ?SCRC=0B7       ;BCC=CRC16
        .DUSR   ?SCIT=1B7       ;   =CCITT16
        .DUSR   ?SLRC=2B7       ;   =LRC
        .DUSR   ?SBSC=0B15      ;PROTOCOL=BSC
        .DUSR   ?SHSP=1B15      ;PROTOCOL=HASP MULTILEAVING

        ;SEND AND RECEIVE CALLS
        .DUSR   ?SSIS=0         ;I/O INPUT STATUS
        .DUSR   ?SSIL=?SSIS+1   ;I/O INPUT STATUS LOW(RESERVED)
        .DUSR   ?SBUP=?SSIL+1   ;DATA BUFFER POINTER
        .DUSR   ?SBUL=?SBUP+1   ;LOWER PORTION OF ?SBUP
        .DUSR   ?SBYC=?SBUL+1   ;DATA BYTE COUNT
        .DUSR   ?SDAD=?SBYC+1   ;DEVICE ADDRESS
        .DUSR   ?SIRL=?SDAD     ;INTERMEDIATE RECORD LENGTH
        .DUSR   ?SBYM=?SIRL+1   ;MAXIMUM BUFFER SIZE
        .DUSR   ?STOV=?SBYM+1   ;TIMEOUT OVERRIDE
        .DUSR   ?SSNL=?STOV+1   ;LENGTH OF ?SSND PKT

        ;?SSND CONTROL FIELD FORMATS
        ;---------------------------

        .DUSR   ?NTRN=0B0       ;NON-TRANSPARENT
        .DUSR   ?TRAN=1B0       ;TRANSPARENT

        .DUSR   ?STXB=0B1       ;STX BLOCK
        .DUSR   ?SOHB=1B1       ;SOH BLOCK

        .DUSR   ?ETBB=0B2       ;ETB BLOCK
        .DUSR   ?ETXB=1B2       ;ETX BLOCK

        .DUSR   ?SITB=1B3       ;ITB
        .DUSR   ?SCON=1B4       ;CONVERSATIONAL MODE

        .DUSR   ?CINT=0B15      ;INITIAL CALL
        .DUSR   ?CONT=1B15      ;CONTINUE CALL
        .DUSR   ?SWAK=2B15      ;SEND WACK
        .DUSR   ?SEOT=3B15      ;SEND EOT
        .DUSR   ?SDET=4B15      ;SEND DLE/EOT
        .DUSR   ?STTD=5B15      ;SEND TTD
        .DUSR   ?SINT=6B15      ;SEND RVI
        .DUSR   ?SDIS=7B15      ;PERFORM LOGICAL DISCONNECT

        ;SEND CONTROL FIELD MASK
        .DUSR   ?SCMK=?TRAN!?SOHB!?ETXB!?SITB!?SCON

        ;?SRCV CONTROL FIELD FORMATS
        ;---------------------------

        .DUSR   ?SAK1=1B12.     ;OVERRIDE ACK SEQ.& SEND ACK1
        .DUSR   ?SAK0=1B11.     ;OVERRIDE ACK SEQ.& SEND ACK0
        .DUSR   ?SDAC=1B10.     ;DEVICE ADDRESS CHARACTERS
        .DUSR   ?SSLR=1B9.      ;SELECT ADRS RECEIVED
        .DUSR   ?S8AS=1B9.      ;ALLOW RECEIVE OF 8 BIT ASCII
        .DUSR   ?SPLR=1B8.      ;POLL ADRS RECEIVED
        .DUSR   ?SACK=1B7       ;SEND ACK & RECV
        .DUSR   ?SNAK=1B6       ;SEND NAK & RECV
        .DUSR   ?SRVI=1B5       ;SEND RVI & RECV

        ;RECV CONTROL FIELD MASK
        .DUSR   ?RCMK=?SACK!?SNAK!?SRVI

        ;?SRCV INITIAL CALL TYPES(SPECIAL CASES FOR MULTIDROP TRIB.)
        .DUSR   ?SPWK=2B15      ;SEND WACK AND AWAIT POLL/SELECT
        .DUSR   ?SPET=5B15      ;SEND EOT AND AWAIT POLL/SELECT
        .DUSR   ?SPRV=6B15      ;SEND RVI AND AWAIT POLL/SELECT
        .DUSR   ?SPNK=7B15      ;SEND NAK AND AWAIT POLL/SELECT

        ;RECV INITIAL CALL TYPE MASK
        .DUSR   ?RTMK=?SPWK!?SPET!?SPRV!?SPNK

        ;'GET ERROR STATISTICS' CALL PACKET DEFINITIONS

        .DUSR   ?SNKC=0         ;TOTAL NAKS RECEIVED
        .DUSR   ?STTO=1         ;TOTAL TIMEOUTS WHILE RECEIVING
        .DUSR   ?SBER=2         ;TOTAL BCC ERRORS
        .DUSR   ?SGLN=3         ;LENGTH OF ?SGES PKT


;PARAMETERS FOR AOS FORMS CONTROL UTITLTY

        .DUSR   ?VFTYP  =0              ;CONTAINS "FC" FOR UDA
                                        ;TYPE 'FORMS CONTROL'
        .DUSR   ?VFREV  =?VFTYP+1       ;UDA FORMAT REV NO.
        .DUSR   ?VFCPL  =?VFREV+1       ;CHARS/LINE
        .DUSR   ?VFLPP  =?VFCPL+1       ;LINES/PAGE
        .DUSR   ?VFTOF  =?VFLPP+1       ;TOP OF FORM LINE #
        .DUSR   ?VFBOF  =?VFTOF+1       ;BOTTOM OF FORM LINE #
        .DUSR   ?VFTBS  =?VFBOF+1       ;TABS TABLE
                                        ;TABLE ENTRY
        .DUSR   ?VFWCH  =9.             ;WORDS/[TAB OR CHAN] AREA
        .DUSR   ?VF01   =?VFTBS+?VFWCH  ;CHAN 1 LINE # TBL

        ;LENGTH OF UDA USED FOR FORMS INFO
        .DUSR   ?VFLEN  =?VF01+(?VFWCH*12.)-?VFTYP+1

        ;DEFINE CURRENT UDA FORMAT REVISION NUMBER
        .DUSR   ?VFNO   =0              ;REV 0


;       DEFINITION OF THE LABEL DATA BLOCK - USED IN THE ?LABEL CALL
;
        ?LBFG=  0               ;STATUS BITS
        ?LBST=  ?LBFG+1         ;LEFT BYTE - LABEL LEVEL
                                ;RIGHT BYTE - NUMBER OF USER VOLUME LABELS
        ?LBDV=  ?LBST+1         ;BYTE POINTER TO THE MAG TAPE UNIT
        ?LBDL=  ?LBDV+1         ;LOW BITS OF ?LBDV
        ?LBVD=  ?LBDL+1         ;BYTE POINTER TO THE VOLUME IDENTIFIER
        ?LBVL=  ?LBVD+1         ;LOW BITS OF ?LBVD
        ?LBUV=  ?LBVL+1         ;BYTE POINTER TO USER VOLUME LABELS
        ?LBUL=  ?LBUV+1         ;LOW BITS OF ?LBUV
        ?LBOI=  ?LBUL+1         ;BYTE POINTER TO OWNER IDENTIFIER OR -1
        ?LBOL=  ?LBOI+1         ;LOW BITS OF ?LBOI
        ?LBAC=  ?LBOL+1         ;LEFT BYTE - RESERVED
                                ;RIGHT BYTE - ACCESSIBLITY
        ?LBLN=  ?LBAC+1         ;LENGTH OF THE PACKET


;       DEFINE THE STATUS BITS
;
.DUSR   ?LBIB=  0               ;IBM FORMAT
.DUSR   ?LBSB=  1               ;SCRATCH THIS TAPE
.DUSR   ?LBB0=  ?OPD0           ;DENSITY BIT 0
.DUSR   ?LBB1=  ?OPD1           ;DENSITY BIT 1
.DUSR   ?LBB2=  ?OPD2           ;DENSITY BIT 2
.DUSR   ?LBRM=  ?LBB2+1         ;DISKETTE REMAPPING
.DUSR   ?LBPF=  ?LBRM+1         ;DISKETTE PREFECT
.DUSR   ?LBBF=  ?OPBF           ;MAXCAP (BUFFERED I/O)
.DUSR   ?LBBS=  ?OPST           ;MAXCAP (STREAM I/O)
;
;       DEFINE BIT MASKS
;
.DUSR   ?LBIM=  1B(?LBIB)       ;IBM FORMAT
.DUSR   ?LBSC=  1B(?LBSB)       ;SCRATCH THIS TAPE
.DUSR   ?LB8=   ?OPDL           ;800 BPI
.DUSR   ?LB16=  ?OPDM           ;1600 BPI
.DUSR   ?LB62=  ?OPDH           ;6250 BPI
.DUSR   ?LBAM=  ?OPAM           ;AUTOMATIC MATCH

.DUSR   ?LB5  = ?OPD5           ; "LOW" DENSITY
.DUSR   ?LB6  = ?OPD6           ; "MED" DENSITY
.DUSR   ?LB7   =?OPD7           ; "HIGH" DENSITY

.DUSR   ?LBMR=  1B(?LBRM)       ;REMAPPING DISKETTES
.DUSR   ?LBMP=  1B(?LBPF)       ;PERFECT DISKETTES
.DUSR   ?LBMF=  ?OPMBF          ;MAXCAP (BUFFERED I/O)
.DUSR   ?LBMS=  ?OPMST          ;MAXCAP (STREAM I/O)


; ?IWKUP PACKET DEFINITIONS

        .DUSR   ?IPID=  0       ; TARGET PROCESS ID
        .DUSR   ?ITCB=  ?IPID+1 ; TARGET TCB ADDRESS
        .DUSR   ?IAC0=  ?ITCB+2 ; AC0 TO PASS TO TARGET
        .DUSR   ?IAC1=  ?IAC0+2 ; AC1 TO PASS TO TARGET
        .DUSR   ?IAC2=  ?IAC1+2 ; AC2 TO PASS TO TARGET
        .DUSR   ?IERR=  ?IAC2+2 ; ERROR INDICATOR
                                ;   -1 -> START TASK AT ERROR RETURN
                                ; ELSE -> START TASK AT GOOD RETURN
        ; ?IWKUP PACKET LENGTH
        .DUSR   ?IWLN=  ?IERR-?IPID+1


;
;
;
        .DUSR   ?RPID=  0               ; PID
        .DUSR   ?RTCB=  ?RPID+1         ; TCB ADDR
        ;
        ;
        .DUSR   ?RHID=  ?RTCB+2         ;RESERVED
        .DUSR   ?RSYS=  ?RHID+1         ; SYS CALL WORD
        .DUSR   ?RAC0=  ?RSYS+1         ; CONTENTS OF AC0
        .DUSR   ?RAC1=  ?RAC0+2         ; CONTENTS OF AC1
        .DUSR   ?RAC2=  ?RAC1+2         ; CONTENTS OF AC2
        .DUSR   ?RXTN=  ?RAC2+2         ; EXTENSION WORD

        .DUSR   ?RPLN=  ?RXTN-?RPID+1   ; PACKET LENGTH


;
; ?GREMA PACKET DEFINITION
;
        ; THESE MUST MATCH IN POSITION WITH THE
        ;  ACCESS REMOTE RESOURCE PACKET DEFINITIONS
        .DUSR   ?GHID=  0               ; HOST ID
        .DUSR   ?GSYS=  ?GHID+1         ; SYS CALL WORD
        .DUSR   ?GAC0=  ?GSYS+1         ; CONTENTS OF AC0
        .DUSR   ?GAC1=  ?GAC0+2         ; CONTENTS OF AC1
        .DUSR   ?GAC2=  ?GAC1+2         ; CONTENTS OF AC2
        .DUSR   ?GXTN=  ?GAC2+2         ; EXTENSION WORD

        .DUSR   ?GRLN=  ?GXTN-?GHID+1   ; PACKET LENGTH

;


        .DUSR   ?VTCH=  0               ;CHANNEL NUMBER OR BYTE POINTER


;
; PACKET DEFINITION FOR ?MBTU / ?MBFU 32 BIT MOVE BYTES CALLS
;

.DUSR   ?MBAH  =        0       ; ADDRESS IN TARGET PROCESS
.DUSR   ?MBAL=  ?MBAH+1         ; LOW ORDER OF ?MBAH
.DUSR   ?MBCH = ?MBAL+1         ; CALLER'S ADDRESS
.DUSR   ?MBCL=  ?MBCH+1         ; LOW ORDER OF ?MBCH
.DUSR   ?MBID=  ?MBCL+1         ; PID OF TARGET PROCESS
.DUSR   ?MBBC=  ?MBID+1         ; BYTE COUNT
.DUSR   ?MBLTH= ?MBBC-?MBAH+1   ; PACKET LENGTH



;
; CONNECTION MANAGER DEFINITIONS
;

;
; ?CONNECT AC1 BIT FLAGS
;

        .DUSR   ?CPID=  0               ; PID/PROCESS NAME FLAG
        .DUSR   ?COBIT= 1               ; OBITUARY NOTIFICATION FLAG
        .DUSR   ?CSIG=  3               ; OBITUARY ?SIGNL FLAG
        .DUSR   ?CRNG=  15              ; RING NUMBER IN AC2

;
; ?CONNECT BIT MASKS
;
        .DUSR   ?MCPID= 1S(?CPID)
        .DUSR   ?MCOBIT=1S(?COBIT)
        .DUSR   ?MCSIG= 1S(?CSIG)
        .DUSR   ?MCRNG=1S(?CRNG)

;
; ?RNGPR PACKET OFFSETS
;
        .DUSR   ?RNGBP= 0               ; BYTE POINTER TO BUFFER (2 WORDS)
        .DUSR   ?RNGNM= ?RNGBP+2        ; RING # OF RING TO CHECK
        .DUSR   ?RNGLB= ?RNGNM+1        ; BUFFER BYTE LENGTH
        .DUSR   ?RNGPL= ?RNGLB+1        ; PACKET LENGTH

;OFFSETS IN THE .ST FILE FOR SYMBOL ENTRIES

        .DUSR   ?STFG=  0       ;FLAGS, TYPE NAME LENGTH
        .DUSR   ?STV1=  1       ;FIRST WORD OF SYMBOL VALUE
        .DUSR   ?STV2=  2       ;SECOND WORD OF SYMBOL VALUE
        .DUSR   ?STOL=  3       ;OVERLAY AREA/NUMBER
        .DUSR   ?STNM=  12      ;START OF SYMBOL NAME (AOS/VS)

;?STFG FORMAT

        .DUSR   ?STDF=  1B2     ;DEFINED FLAG MASK
        .DUSR   ?STTY=  37B7    ;SYMBOL TYPE MASK
        .DUSR   ?STNL=  377B15  ;NAME LENGTH MASK

;SYMBOL TYPES IN ?STTY

        .DUSR   ?STEN=  0       ;ENTRY
        .DUSR   ?STEX=  1       ;EXTERNAL
        .DUSR   ?STCO=  2       ;COMMON
        .DUSR   ?STAS=  3       ;ACCUMULATED
        .DUSR   ?STEO=  4       ;OVERLAY ENTRY
        .DUSR   ?STTL=  5       ;TITLE
        .DUSR   ?STPE=  6       ;PROCEDURE ENTRY
        .DUSR   ?STES=  7       ;SUPRESSED EXTERNAL
        .DUSR   ?STLC=  8.      ;LOCAL
        .DUSR   ?STEC=  9.      ;CHAIN-LINK EXTERNAL
        .DUSR   ?STLM=  10.     ;LIMIT
        .DUSR   ?STBS=  11.     ;BOUND SHARED LIBRARY PENT (NOT USED)
        .DUSR   ?STSL=  12.     ;SHARED LIBRARY PENT
        .DUSR   ?STPT=  13.     ;PARTITION
        .DUSR   ?STSO=  14.     ;SYSTEM OVERLAY ENTRY

; DEFINE THE OFFSET FROM THE BEGINNING OF A HASH BUCKET TO THE
; OVERFLOW BUCKET NUMBER. IF THERE IS AN OVERFLOW BUCKET, THIS VALUE
; WILL BE NONZERO.

        .DUSR   ?STOB=  377     ;HASH BUCKET OVERFLOW BUCKET OFFSET

;       BREAKFILE DEFINITIONS

        .DUSR   ?BKFLG= 2       ;BREAKFILE TYPE
          .DUSR ?BCTLE= 1       ;CONTROL C CONTROL E TYPE
          .DUSR ?BTRAP= 2       ;PROGRAM TRAPPED TYPE
          .DUSR ?BBRKF= 3       ;PROGRAM DID ?BRKFL
        .DUSR   ?BTRCD= 3       ;TRAP CODE IF ?BTRAP
        .DUSR   ?BPSTAT= 4      ;STATUS WORD
        .DUSR   ?BPFLG1= 5      ;FLAG WORD 1
        .DUSR   ?BPFLG2= 6      ;FLAG WORD 2
        .DUSR   ?BPFLG3= 7      ;FLAG WORD 3
        .DUSR   ?BPFLG4= 8.     ;FLAG WORD 4
        .DUSR   ?BPFLG5= 9.     ;FLAG WORD 5


;       PARAMETER DEFINITIONS FOR ?VALAD

.DUSR   ?VLAC=  1S0             ;VALID ACCESS
.DUSR   ?RDAC=  1S2             ;READ ACCESS
.DUSR   ?WRAC=  1S3             ;WRITE ACCESS
.DUSR   ?EXAC=  1S4             ;EXECUTE ACCESS


;==================================================================
;=                                                                =
;=                     ?FEDFUNC PARAMETERS                        =
;=                                                                =
;==================================================================

;     FUNCTION CODES DEFINITIONS, FOR ?FRFNC

.DUSR   ?FREFS= 1               ; EVALUATE FED STRING
.DUSR   ?FRCR = 2               ; CHANGE RADIX
.DUSR   ?FROST= 3               ; OPEN A SYMBOL TABLE FILE
.DUSR   ?FRDIS= 4               ; DISASSEMBLE AN INSTR.
.DUSR   ?FRITS= 5               ; INSERT A TEMP SYMBOL
.DUSR   ?FRDTS= 6               ; DELETE A TEMP SYMBOL
.DUSR   ?FRMIN= ?FREFS          ; MINIMUM VALID FUNCTION CODE
.DUSR   ?FRMAX= ?FRDTS          ; MAXIMUM VALID FUNCTION CODE

;     NOTE: THE (S) AND (D) INDICATE WHETHER THE THE PARAMETER IS
;           A SINGLEWORD OR A DOUBLEWORD.

;     OFFSETS FOR ?FREFS (EVALUATE FED STRING) PACKET

.DUSR   ?FRFNC= 0               ; (S) ?FEDFUNC REQUEST FUNCTION CODE
.DUSR   ?FFLAG= ?FRFNC+1        ; (S) (RETURNED) FLAGS WORD
.DUSR   ?FBEX=  ?FFLAG+1        ; (D) BYTEPOINTER TO EXPRESSION TO BE
                                ;     EVALUATED
.DUSR   ?FLEX=  ?FBEX+2         ; (S) BYTE LENGTH OF EXPRESSION
.DUSR   ?FDBL=  ?FLEX+1         ; (S) (RETURNED) NBR OF WORDS RETURNED
                                ;     FOR THE EVALUATED EXPRESSION
.DUSR   ?FDBA=  ?FDBL+1         ; (D) ADDRESS OF DESTINATION BUFFER
.DUSR   ?FCPC=  ?FDBA+2         ; (D) CURRENT PC (USED FOR EVALUATING
                                ;     EXPRESSIONS LIKE .+3)
.DUSR   ?FERROR=?FCPC+2         ; (D) RETURN ERROR FLAGS FROM FED
.DUSR   ?FLEFS= ?FERROR+2       ; LENGTH OF ?FREFS PACKET

;     BIT DEFINITIONS FOR ?FFLAG FLAG WORD

.DUSR   ?FINST= 1B0             ; THE STRING CONTAINS AN INSTRUCTION
.DUSR   ?FFLPT= 1B1             ; THE STRING CONTAINS AN FLOATING POINT
                                ;     NUMBER
.DUSR   ?FEXPR= 1B2             ; THE STRING CONTAINS AN EXPRESSION

;     MISCELLANEOUS CONSTANTS FOR ?FREFS FUNCTION

.DUSR   ?FMEFS= 5               ; THE MAXIMUM NUMBER OF WORDS WHICH CAN
                                ; CURRENTLY BE RETURNED BY ?FREFS. THE
                                ; DESTINATION BUFFER YOU PROVIDE MUST
                                ; BE AT LEAST THIS LONG.

;     PARAMETER PACKET OFFSETS FOR ?FRCR (CHANGE RADIX)

;DUSR   ?FRFNC= 0               ; (S) ?FEDFUNC REQUEST FUNCTION CODE
;DUSR   ?FFLAG=?FRFNC+1         ; (S) RESERVED: MUST BE ZERO
.DUSR   ?FNIR= ?FFLAG+1         ; (S) NEW INPUT RADIX: 2 THRU 16.
.DUSR   ?FRESS=?FNIR+1          ; (S) RESERVED: MUST BE ZERO

;     MISCELLANEOUS CONSTANTS FOR ?FRCR FUNCTION

.DUSR   ?FLCR=  ?FRESS+1        ; LENGTH OF ?FRCR PACKET

;     PARAMETER PACKET OFFSETS FOR ?FROST (OPEN SYMBOL TABLE FILE)

;DUSR   ?FRFNC= 0               ; (S) ?FEDFUNC REQUEST FUNCTION CODE
;DUSR   ?FFLAG=?FRFNC+1         ; (S) RESERVED: MUST BE ZERO
.DUSR   ?FBSTF=?FFLAG+1         ; (D) BYTEPOINTER TO .ST FILE NAME
.DUSR   ?FLOST=?FBSTF+2         ; LENGTH OF ?FROST PACKET


;     OFFSETS FOR ?FRDIS (DISASSEMBLE IN INST) PACKET

;DUSR   ?FRFNC= 0               ; (S) ?FEDFUNC REQUEST FUNCTION CODE
;DUSR   ?FFLAG= ?FRFNC+1        ; (S) (RETURNED) FLAGS WORD
.DUSR   ?FDBFZ= ?FFLAG+1        ; (D) BYTEPOINTER TO DESTINATION
                                ;     BUFFER
.DUSR   ?FRRR=  ?FDBFZ+2        ; (S) RESERVED
.DUSR   ?FWFI=  ?FRRR+1         ; (S) (RETURNED) NBR OF WORDS USED
                                ;     FOR THE INSTRUCTION
.DUSR   ?FINA=  ?FWFI+1         ; (D) ADDRESS OF INSTRUCTION BUFFER
;DUSR   ?FCPC=  ?FINA+2         ; (D) CURRENT PC (USED FOR EVALUATING
                                ;     EXPRESSIONS LIKE .+3)

.DUSR   ?FLDIS= ?FCPC+2         ; LENGTH OF ?FRDIS PACKET

;     MISCELLANEOUS CONSTANTS FOR ?FRDIS

.DUSR   ?FMDIS= 80.             ; MIN LENGTH FOR ?FDBFZ BUFFER (BYTES)
.DUSR   ?FMWDS= 4               ;MAXIMUM # WDS USED BY AN INSTRUCTION



;     OFFSETS FOR ?FRITS & ?FRDTS

;DUSR   ?FRFNC= 0               ; (S) ?FEDFUNC REQUEST FUNCTION CODE
;DUSR   ?FFLAG= ?FRFNC+1        ; (S) (RETURNED) FLAGS WORD
.DUSR   ?FSVAL= ?FFLAG+1        ; (D) BYTEPOINTER TO EXPRESSION
                                ;     FOR SYMBOL VALUE
.DUSR   ?FSVLL= ?FSVAL+2        ; (S) BYTE LENGTH OF EXPRESSION
.DUSR   ?FSNL=  ?FSVLL+1        ; (S) BYTE LENGTH OF SYMBOL NAME

.DUSR   ?FSNM=  ?FSNL+1         ; (D) BYTEPOINTER TO SYMBOL NAME
;DUSR   ?FCPC=  ?FSNM+2         ; (D) CURRENT PC (USED FOR EVALUATING
                                ;     EXPRESSIONS LIKE .+3)

.DUSR   ?FLSYM= ?FCPC+2         ; LENGTH OF ?FRITS & ?FRDTS PACKET

;     MISCELLANEOUS CONSTANTS FOR ?FRITS & FRDTS

.DUSR   ?FMITS= 480.            ; MIN BYTE LENGTH OF ?FSVAL BUFFER
                                ; WHEN USING THE LIST OPTION
                                ; (?FSNL=0)
.DUSR   ?FMSYM= 8.              ; MAXIMUM LENGTH OF TEMP SYMBOL
                                ; NAME

; =====================================================================


; =====================================================================
; ===                                                               ===
; ===                    PARAMETERS FOR ?LTFNCC                     ===
; ===                (SPECIAL LABELED TAPE FUNCTIONS)               ===
; ===                                                               ===
; =====================================================================


; FIRST THE REQUEST FUNCTION CODE DEFINITIONS

.DUSR   ?LTFVS =0               ;FUNCTION CODE FOR "VOLUME STATUS"

.DUSR   ?LTMINF= ?LTFVS         ; MINIMUM VALID FUNCTION CODE
.DUSR   ?LTMAXF= ?LTFVS         ; MAXIMUM VALID FUNCTION CODE

; OFFSET DEFINITIONS FOR ?LTTAT PACKET

; FIRST WORD OF PACKET IS ALWAYS THE REQUEST FUNCTION CODE.

.DUSR   ?LTFNC= 0               ;REQUEST FUNCTION CODE

; REMAINDER OF PACKET FOR ?LTFVS "VOLUME STATUS" REQUEST

;.DUSR  ?LTFNC= 0               ;REQUEST FUNCTION CODE
.DUSR   ?LTCHAN= ?LTFNC+1       ;CHANNEL NUMBER
.DUSR   ?LTRES=  ?LTCHAN+1      ;RESERVED DOUBLEWORD FOR EXPANSION
.DUSR   ?LTFSN=  ?LTRES+2       ;FILE SECTION NUMBER SPECIFIES VOLUME
.DUSR   ?LTBCT=  ?LTFSN+2       ;BLOCK COUNT FOR THIS VOLUME
.DUSR   ?LTVOLID=?LTBCT+1       ;THREE WORD AREA TO RECEIVE VOLID TEXT

.DUSR   ?LTLVS=  ?LTVOLID+3     ;LENGTH OF PACKET FOR ?LTFVS FUNCTION


; =====================================================================
; ===                                                               ===
; ===                    PARAMETERS FOR ?VALIDATE                   ===
; ===                  (AREA VALIDATION SYSTEM CALL)                ===
; ===                                                               ===
; =====================================================================


; PARAMETERS FOR ?VALIDATE.

.DUSR   ?VFUNC=0                ;FIRST WORD OF PACKET IS FUNCTION CODE.
.DUSR   ?VRES =1                ;SECOND WORD OF PACKET IS RESERVED.
.DUSR   ?VPOINTER=2             ;POINTER TO AREA TO BE VALIDATED
.DUSR   ?VRING=4                ;THE RING OF THE CALLER
.DUSR   ?VLENGTH=6              ;ACTUAL LENGTH OF THE AREA, OR MAXIMUM
                                ;LENGTH TO BE VALIDATED FOR ?RVBPX.
.DUSR   ?VDELIM=10              ;ADDRESS OF DELIMITER TABLE (FOR ?RVBPX)
.DUSR   ?VERROR=12              ;RETURNS ZERO OR ERROR CODE
.DUSR   ?VRESD=14               ;A RESERVED DOUBLEWORD FOR EXPANSION
.DUSR   ?VPLTH=16               ;LENGTH OF PACKET FOR ?VALIDATE

; FUNCTION CODES AND FLAGS FOR OFFSET ?VFUNC

.DUSR   ?RVWPL=1                ;READ VALIDATE AREA DEFINED BY A
                                ;WORD POINTER AND WORD LENGTH
.DUSR   ?WVWPL=2                ;WRITE VALIDATE AREA DEFINED BY A
                                ;WORD POINTER AND WORD LENGTH
.DUSR   ?RVBPL=3                ;READ VALIDATE AREA DEFINED BY A
                                ;BYTE POINTER AND BYTE LENGTH
.DUSR   ?WVBPL=4                ;WRITE VALIDATE AREA DEFINED BY A
                                ;BYTE POINTER AND BYTE LENGTH
.DUSR   ?RVBPX=5                ;READ VALIDATE A STRING OF UNKNOWN
                                ;LENGTH BUT KNOWN MAXIMUM BYTE LENGTH

.DUSR   ?VFMIN=?RVWPL           ;MINIMUM VALID FUNCTION CODE
.DUSR   ?VFMAX=?RVBPX           ;MAXIMUM VALID FUNCTION CODE

.DUSR   ?VRNBR= 1B0             ;SET THIS FLAG TO INDICATE THAT THE
                                ;RING IN ?VRING IS AN INTEGER RING
                                ;NUMBER, NOT A RING FIELD (DEFAULT).
.DUSR   ?VFMSK= 077777          ;MASK TO ISOLATE THE FUNCTION CODE
                                ;IN OFFSET ?VFUN


; =====================================================================
; ===                                                               ===
; ===                    PARAMETERS FOR ?OPER                       ===
; ===                  (LOCAL OPERATOR SYSTEM CALL)                 ===
; ===                                                               ===
; =====================================================================


;       ?OPER PACKET:

.DUSR   ?OPRV=  0               ; REVISION OF PACKET
.DUSR   ?OPFN= ?OPRV+1          ; FUNCTION CODE (LOW BYTE) & FLAGS
.DUSR   ?OPRQ= ?OPFN+1          ; REQUEST CODE
.DUSR   ?OPSQ= ?OPRQ+1          ; SEQUENCE NUMBER
.DUSR   ?OPEC= ?OPSQ+1          ; ERROR CODE
.DUSR   ?OPLN= ?OPEC+1          ; LENGTH OF DATA BUFFER
.DUSR   ?OPRF= ?OPLN+1          ; HIGH RESOURCE FLAGS WORD
.DUSR   ?OPRL= ?OPRF+1          ; LOW RESOURCE FLAGS WORD
.DUSR   ?OPRS= ?OPRL+1          ; RESERVED DOUBLE WORD
.DUSR   ?OPDB= ?OPRS+2          ; POINTER TO DATA BUFFER

.DUSR   ?OPSZ= ?OPDB+2          ; SIZE OF ?OPER PACKET



;       LABELED DISKETTE REQUEST CODES:

.DUSR   ?ORLO=  1               ; LABELED DISKETTE OPEN
.DUSR   ?ORLC=  ?ORLO+1         ; LABELED DISKETTE CLOSE
.DUSR   ?ORMNV= ?ORLC+1         ; LABELED DISKETTE MOUNT NEXT VOLUME
.DUSR   ?ORMU=  ?ORMNV+1        ; UNLABELED DISKETTE MOUNTED
.DUSR   ?ORML=  ?ORMU+1         ; WRONG LABELED DISKETTE MOUNTED

;       LABELED DISKETTE ?OPER RESOURCE NUMBER:

.DUSR   ?BLFD=  0               ; BIT ZERO OF ?OPFG IS FOR DISKETTE

;       FLAG BIT'S IN HIGH WORD OF ?OPFN

.DUSR   ?OPIO=  ?OPFN*16.+1     ; WRITE OPERATION IF SET

;=======================================================================
;=                                                                     =
;=      MAP REGION PACKET -- USED BY ?MAPBM                            =
;=                                                                     =
;=======================================================================

.DUSR   ?MRPV=      0           ; PACKET REVISION NUMBER (ZERO)
.DUSR   ?MRRT=      ?MRPV+1     ; REGION CODE (SEE BELOW)
.DUSR   ?MROP=      ?MRRT+1     ; OPERATION CODE (SEE BELOW)
.DUSR   ?MROX=      ?MROP+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MRNP=      ?MROX+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MRNL=      ?MRNP+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MRID=      ?MRNL+1     ; ?MAPR TARGET ID (HIGH-ORDER PART)
.DUSR   ?MRIL=      ?MRID+1     ; ?MAPR TARGET ID (LOW-ORDER PART)
.DUSR   ?MRAC=      ?MRIL+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MRAL=      ?MRAC+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MRRP=      ?MRAL+1     ; FIRST PAGE IN TARGET TO MAP
                                ;       (HIGH-ORDER PART)
.DUSR   ?MRRL=      ?MRRP+1     ; FIRST PAGE IN TARGET TO MAP
                                ;       (LOW-ORDER PART)
.DUSR   ?MRPC=      ?MRRL+1     ; # PAGES IN MAPPING (HIGH-ORDER PART)
.DUSR   ?MRPL=      ?MRPC+1     ; # PAGES IN MAPPING (LOW-ORDER PART)
.DUSR   ?MRN0=      ?MRPL+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MRN1=      ?MRN0+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MRLA=      ?MRN1+1     ; ADDRESS WHERE MAPPING STARTS
                                ;       (HIGH-ORDER PART)
.DUSR   ?MRLL=      ?MRLA+1     ; ADDRESS WHERE MAPPING STARTS
                                ;       (LOW-ORDER PART)
.DUSR   ?MRDT=      ?MRLL+1     ; DEVICE TYPE INFO
.DUSR   ?MRDL=      ?MRDT+1     ; DEVICE TYPE INFO

.DUSR   ?MRP0=      ?MRDL+1     ; SIZE OF PACKET (WORDS)

;=======================================================================
;=                                                                     =
;=      MAP REGION PACKET -- USED BY ?MAPDV                            =
;=                                                                     =
;=======================================================================

.DUSR   ?MDPK=      0           ; PACKET ID (HIGH ORDER)
.DUSR   ?MDPL=      ?MDPK+1     ; PACKET ID (LOW ORDER)
.DUSR   ?MDRE=      ?MDPL+1     ; RESERVED (MUST BE ZERO)
.DUSR   ?MDRT=      ?MDRE+1     ; REGION CODE (SEE BELOW)
.DUSR   ?MDOP=      ?MDRT+1     ; OPERATION CODE (SEE BELOW)
.DUSR   ?MDOX=      ?MDOP+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MDNP=      ?MDOX+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MDNL=      ?MDNP+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MDID=      ?MDNL+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MDIL=      ?MDID+1     ; ?MAPR TARGET ID ( DEVICE CODE)
.DUSR   ?MDAC=      ?MDIL+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MDAL=      ?MDAC+1     ; RESERVED. MUST BE ZERO.
.DUSR   ?MDRP=      ?MDAL+1     ; FIRST PAGE IN TARGET TO MAP
                                ;       (HIGH-ORDER PART)
.DUSR   ?MDRL=      ?MDRP+1     ; FIRST PAGE IN TARGET TO MAP
                                ;       (LOW-ORDER PART)
.DUSR   ?MDPC=      ?MDRL+1     ; # PAGES IN MAPPING (HIGH-ORDER PART)
.DUSR   ?MDCL=      ?MDPC+1     ; # PAGES IN MAPPING (LOW-ORDER PART)
.DUSR   ?MDN0=      ?MDCL+1     ; PHYSICAL WORD ADDRESS RETURNED (HI)
.DUSR   ?MDN1=      ?MDN0+1     ; PHYSICAL WORD ADDRESS RETURNED (LOW)
.DUSR   ?MDLA=      ?MDN1+1     ; ADDRESS WHERE MAPPING STARTS
                                ;       (HIGH-ORDER PART)
.DUSR   ?MDLL=      ?MDLA+1     ; ADDRESS WHERE MAPPING STARTS
                                ;       (LOW-ORDER PART)
.DUSR   ?MDDT=      ?MDLL+1     ; DEVICE TYPE INFO RETURNED
.DUSR   ?MDDL=      ?MDDT+1     ; DEVICE TYPE INFO RETURNED

.DUSR   ?MDP0=      ?MDDL+1     ; SIZE OF PACKET (WORDS)

; REGION CODES DEFINED FOR USE IN ?MRRT AND ?MDRT ABOVE

.DUSR   ?BITM=      1           ; PHYSICAL VIDEO BITMAP MEMORY
.DUSR   ?VBITM=     ?BITM+1     ; VIRTUAL BITMAP MEMORY
.DUSR   ?MMAP=      ?VBITM+1    ; MEMORY MAPPED DEVICE MEMORY

; OPERATION CODES DEFINED FOR USE IN ?MROP AND ?MDOP ABOVE

.DUSR   ?MRDO=      1B15.       ; ADD REGION TO ADDRESS SPACE
.DUSR   ?MRROM=     1B14.       ; READ ONLY OPTION ON ?VBITM ADD
.DUSR   ?UNMR=      1B0         ; REMOVE REGION FROM ADDRESS SPACE

; MACHINE TYPE CODES DEFINED FOR USE IN ?MROX AND ?MCOX ABOVE

.DUSR   ?MLBS=      1B15.       ; LBUS TYPE MACHINE
.DUSR   ?MMPL=      1B14.       ; XBUS TYPE MACHINE(MAPPED LBUS)

;
;================================================================
;==                                                            ==
;== TASK CONTROL BLOCK INFORMATION PACKET(?TCBINFO)            ==
;==                                                            ==
;==                                                            ==
;================================================================
;
.DUSR   ?TIST=          0               ;TCB STATUS WORD
.DUSR   ?TIREV=         ?TIST+1         ;PACKET REVISION
.DUSR   ?TISO=          ?TIREV+1        ;RING SEVEN STACK OVERFLOW
                                        ;HANDLER
.DUSR   ?TIFP=          ?TISO+2         ;RING SEVEN FRAME POINTER
.DUSR   ?TISP=          ?TIFP+2         ;RING SEVEN STACK POINTER
.DUSR   ?TISL=          ?TISP+2         ;RING SEVEN STACK LIMIT
.DUSR   ?TISB=          ?TISL+2         ;RING SEVEN STACK BASE

.DUSR   ?TIPSR=         ?TISB+2         ;PROCESS STATUS REGISTER
.DUSR   ?TIAC0=         ?TIPSR+2        ;AC0
.DUSR   ?TIAC1=         ?TIAC0+2        ;AC1
.DUSR   ?TIAC2=         ?TIAC1+2        ;AC2
.DUSR   ?TIAC3=         ?TIAC2+2        ;AC3
.DUSR   ?TIPC=          ?TIAC3+2        ;PROGRAM COUNTER AND CARRY

.DUSR   ?TIFS=          ?TIPC+2         ;FLOATING POINT STATUS
.DUSR   ?TIFA0=         ?TIFS+4         ;FLOATING POINT AC0
.DUSR   ?TIFA1=         ?TIFA0+4        ;FLOATING POINT AC1
.DUSR   ?TIFA2=         ?TIFA1+4        ;FLOATING POINT AC2
.DUSR   ?TIFA3=         ?TIFA2+4        ;FLOATING POINT AC3

.DUSR   ?TILN=          ?TIFA3+4        ;LENGTH OF TCBINFO PACKET


;
;=======================================================================
;==                                                                   ==
;==         DEFINE THE TERMINATION MESSGE FORMAT - ?TMSG              ==
;==                     PARAMETERS                                    ==
;==                                                                   ==
;=======================================================================
;
.DUSR   ?TMR0   =  0            ;TERM MESSAGE REV LOWER LIMIT
.DUSR   ?TMR1   =  1            ;TERM MESSAGE CURRENT REV FORMAT #

;
;=======================================================================
;==                                                                   ==
;==         ?SONS - GET A LIST OF SON PROCESSES FOR TARGET PID        ==
;==                 PACKET DEFINITIONS                                ==
;==                                                                   ==
;=======================================================================
;
.DUSR   ?SORP   = 0             ;PACKET REVISION NUMBER
.DUSR   ?SOFW   = ?SORP+1       ;FLAGS WORD
.DUSR   ?SOSP   = ?SOFW+1       ;WORD PTR TO SON'S PIDS ARRAY
.DUSR   ?SOAL   = ?SOSP+2       ;SONS ARRAY LENGTH
.DUSR   ?SOFP   = ?SOAL+1       ;FATHER'S PID
.DUSR   ?SOKEY  = ?SOFP+1       ;KEY
.DUSR   ?SOSON  = ?SOKEY+2      ;NUMBER OF SONS
.DUSR   ?SONEN  = ?SOSON+1      ;NUMBER ENTRIES
.DUSR   ?SOLTH  = ?SONEN+1      ;PACKET LENGTH

;
;=======================================================================
;==                                                                   ==
;==         ?PIDS - GET INFO RELATED TO PIDS ON THE SYSTEM            ==
;==                 PACKET DEFINITIONS                                ==
;==                                                                   ==
;=======================================================================
;
.DUSR   ?PIPR   = 0             ;PACKET REVISION NUMBER
.DUSR   ?PILRP  = ?PIPR+1       ;NUMBER OF LOW RANGE PIDS
.DUSR   ?PITOT  = ?PILRP+1      ;TOTAL NUMBER PIDS USED
.DUSR   ?PIMXP  = ?PITOT+1      ;MAXIUM PIDS ALLOWED
.DUSR   ?PILTH  = ?PIMXP+1      ;PACKET LENGTH

;
;=======================================================================
;==                                                                   ==
;==         ?GNPID - GIVEN LOGICAL HOST, RETURN NEXT PID IN USE       ==
;==                 PACKET DEFINITIONS                                ==
;==                                                                   ==
;=======================================================================
;
.DUSR   ?NPPR   = 0             ;PACKET REVISION NUMBER
.DUSR   ?NPFW   = ?NPPR+1       ;FLAGS WORD
.DUSR   ?NPAP   = ?NPFW+1       ;WORD PTR. TO ARRAY OF PIDS
.DUSR   ?NPAL   = ?NPAP+2       ;PID ARRAY LENGTH
.DUSR   ?NPRS1  = ?NPAL+1       ;--RESERVED---
.DUSR   ?NPKEY  = ?NPRS1+1      ;KEY
.DUSR   ?NPNUM  = ?NPKEY+2      ;NUMBER PIDS ON HOST
.DUSR   ?NPNEN  = ?NPNUM+1      ;NUMBER OF ENTRIES
.DUSR   ?NPLTH  = ?NPNEN+1      ;PACKET LENGTH


; ======================================================================
; ===                                                                ===
; ===            ?PROFILE PACKET AND PARAMETER DEFINITIONS           ===
; ===                                                                ===
; ======================================================================

;       ?PROFILE PACKET:

.DUSR   ?PFR1   =       0        ;Reserved
.DUSR   ?PFRV   =       ?PFR1+1  ;Packet Revision
.DUSR   ?PFNF   =       ?PFRV+1  ;# Fld. Des. Pkt.
.DUSR   ?PFFC   =       ?PFNF+1  ;Function code
.DUSR   ?PFUN   =       ?PFFC+1  ;BP(User Name)
.DUSR   ?PFPR   =       ?PFUN+2  ;Beginning of Field Desc. packets

.DUSR   ?PFLB   =       ?PFUN+2  ;Length of packet (excl. desc.)

;       ?PROFILE FUNCTION CODES:

.DUSR   ?PFCRE  =       0        ;Create
.DUSR   ?PFREN  =       ?PFCRE+1 ;Rename
.DUSR   ?PFDEL  =       ?PFREN+1 ;Delete
.DUSR   ?PFIAC  =       ?PFDEL+1 ;Initiate Access
.DUSR   ?PFTAC  =       ?PFIAC+1 ;Terminate Access
.DUSR   ?PFRDF  =       ?PFTAC+1 ;Read Field
.DUSR   ?PFUFD  =       ?PFRDF+1 ;Update Field
.DUSR   ?PFGNP  =       ?PFUFD+1 ;Get next profile name

.DUSR   ?PFOP   =       ?PFGNP   ;Maximum function code value

;       ?PROFILE FIELD DESCRIPTOR PACKET DEFINITION:

.DUSR   ?PFFD   =       0       ;Field Descriptor
.DUSR   ?PFDP   =       ?PFFD+2 ;Data Address
.DUSR   ?PFDL   =       ?PFDP+2 ;Buffer Length
.DUSR   ?PFAL   =       ?PFDL+1 ;Actual data length
.DUSR   ?PFER   =       ?PFAL+1 ;Error Code
.DUSR   ?PFR3   =       ?PFER+1 ;Reserved
.DUSR   ?PFLE   =       ?PFR3+1 ;Length of Field Descriptor packet

;       ?PROFILE PARAMETER TYPE FIELD DEFINITIONS:

.DUSR   ?PFBY   =       100000000 ;?PFDP & ?PFDL are byte oriented.
.DUSR   ?PFBI   =       200000000 ;?PFDP contains value, ?PFDL ignored.
.DUSR   ?PFWD   =       300000000 ;?PFDP & ?PFDL are word oriented.
.DUSR   ?PFPTMSK=     37700000000 ;Mask for parameter type field

;       ?PROFILE ENTRY NUMBER FIELD DEFINITIONS:

.DUSR   ?PBASE  =       100000        ;Total entry number per group
.DUSR   ?PFSE   =       0             ;System entry # base
.DUSR   ?PCEO   =       ?PBASE+?PFSE  ;CEO entry # base
.DUSR   ?PTMPS  =       ?PBASE+?PCEO   ;TPMS entry # base
.DUSR   ?PHIPE  =       ?PBASE+?PTMPS ;HIPE entry # base
.DUSR   ?PXODIAC=       ?PBASE+?PHIPE ;XODIAC entry # base
.DUSR   ?PUNUSED=       ?PBASE+?PXODIAC ;Begin reserved entry #s
.DUSR   ?PUSEDEF=       77000000      ;Begin user defineable entry #s

;       ?PROFILE SYSTEM ENTRY NUMBER FIELD DEFINITIONS:

.DUSR   ?PPASSWD=       ?PFSE           ;System password
.DUSR   ?PICROG =       ?PPASSWD+1      ;Initial program
.DUSR   ?PICCFN =       ?PICROG+1       ;Initial IPC file name
.DUSR   ?PMXSONS=       ?PICCFN+1       ;Maximum number of sons
.DUSR   ?PSOPIO =       ?PMXSONS+1      ;Son's Priority
.DUSR   ?PDISKLM=       ?PSOPIO+1       ;User's CPD limit
.DUSR   ?PLOGON =       ?PDISKLM+1      ;Date/Time of last logon
.DUSR   ?PBATCHP=       ?PLOGON+1       ;Batch priority
.DUSR   ?PCNSPRV=       ?PBATCHP+1      ;Console usage privilege
.DUSR   ?PBCHPRV=       ?PCNSPRV+1      ;Batch usage privilege
.DUSR   ?PMODPRV=       ?PBCHPRV+1      ;Modem usage privilege
.DUSR   ?PVCNPRV=       ?PMODPRV+1      ;Virtual console usage privilege
.DUSR   ?PRRAPRV=       ?PVCNPRV+1      ;Remote resource access privilege
.DUSR   ?PPWDPRV=       ?PRRAPRV+1      ;Change password privilege
.DUSR   ?PNCRYPT=       ?PPWDPRV+1      ;System password encrypted indicator
;DUSR   ?PGDPRIV=       ?PNCRYPT+1      ;Global Daemon privilege
.DUSR   ?PMGSYS=        ?PNCRYPT+2      ;System Manager Privilege
.DUSR   ?PCOMMNT=       ?PMGSYS+1       ;User comment
.DUSR   ?PBWSS  =       ?PCOMMNT+1      ;Batch working set size
.DUSR   ?PBLMEM =       ?PBWSS+1        ;Batch logical memory
.DUSR   ?PNBWSS =       ?PBLMEM+1       ;Non-Batch working set size
.DUSR   ?PNBLMEM=       ?PNBWSS+1       ;Non-Batch logical memory
.DUSR   ?PMYSONS=       ?PNBLMEM+1      ;Many sons privilege
.DUSR   ?PCHTYP =       ?PMYSONS+1      ;Change type privilege
.DUSR   ?PCHPRI =       ?PCHTYP+1       ;Change priority privilege
.DUSR   ?PPDPMGR=       ?PCHPRI+1       ;Define PMGR privilege
.DUSR   ?PPRNBLK=       ?PPDPMGR+1      ;PROC no-block privilege
.DUSR   ?PCHUSER=       ?PPRNBLK+1      ;Change username privilege
.DUSR   ?PACDEV =       ?PCHUSER+1      ;Access devices privilege
.DUSR   ?PUIPCS =       ?PACDEV+1       ;Use IPC privilege
.DUSR   ?PSUSER =       ?PUIPCS+1       ;Superuser privilege
.DUSR   ?PPSUPP =       ?PSUSER+1       ;Superprocess privilege
.DUSR   ?PWSON  =       ?PPSUPP+1       ;Wide son privilege
.DUSR   ?PMCTS=         ?PWSON+1        ;Memory constraints
.DUSR   ?PHRDPRV=       ?PMCTS+1        ;Hard privileges
.DUSR   ?PSFTPRV=       ?PHRDPRV+1      ;Soft privileges
.DUSR   ?PPRCINF=       ?PSFTPRV+1      ;PROC information
.DUSR   ?PINTDIR=       ?PPRCINF+1      ;Initial directory
.DUSR   ?PCHWSSL=       ?PINTDIR+1      ;Change WSS limit privilege
.DUSR   ?PDLOCY =       ?PCHWSSL+1      ; DEFAULT LOCALITY
.DUSR   ?POLOCY =       ?PDLOCY+1       ; OTHER LOCALITIES
.DUSR   ?PQLOCY =       ?POLOCY+1       ; OTHER LOCALITIES ENABLE
.DUSR   ?PRCRYPT=       ?PQLOCY+1       ; REMOTE PASSWORD ENCRYPTED FLAG
.DUSR   ?PRPSSWD=       ?PRCRYPT+1      ; REMOTE PASSWORD
.DUSR   ?PFVER  =       ?PRPSSWD+1      ; SYSTEM PROFILE REVISION
.DUSR   ?PN1FLG =       ?PFVER+1        ; FLAG 1
.DUSR   ?PN2FLG =       ?PN1FLG+1       ; FLAG 2
.DUSR   ?PRHRDPR=       ?PN2FLG+1       ;Remote Hard privileges
.DUSR   ?PRSFTPR=       ?PRHRDPR+1      ;Remote Soft privileges
.DUSR   ?PDBLOCY=       ?PRSFTPR+1      ;Default batch locality
.DUSR   ?POBLOCY=       ?PDBLOCY+1      ;Other batch locality
.DUSR   ?PQBLOCY=       ?POBLOCY+1      ;Other batch locality enable

.DUSR   ?PFMX   =       ?PQBLOCY        ;Max system entry number

;=======================================================================
;==                                                                   ==
;==         ?CRYPT - ENCRYPT/DECRYPT USER DATA                        ==
;==                  PACKET DEFINITIONS                               ==
;==                                                                   ==
;=======================================================================

.DUSR   ?CRFW   = 0             ;FLAGS WORD
.DUSR   ?CRRV   = ?CRFW+1       ;PACKET REVISION NUMBER
.DUSR   ?CRBI   = ?CRRV+1       ;# OF 8 BYTE BLOCKS INPUT FOR CRYPT
.DUSR   ?CRBO   = ?CRBI+1       ;# OF 8 BYTE BLOCKS OUTPUT(PROCESSED)
.DUSR   ?CRKP   = ?CRBO+1       ;WORD POINTER TO A(KEY BUFFER)
.DUSR   ?CRTP   = ?CRKP+2       ;WORD POINTER TO A(TEXT BUFFER)

.DUSR   ?CRSZ   = ?CRTP+2       ;SIZE OF ?CRYPT PACKET



; ?CRFW FLAG WORD BIT MASKS:

.DUSR   ?CRDC   = 1B0           ; 1 = DATA DECRYPTION

; DEFINE THE REQUIRED KEY BUFFER LENGHTH TO BE 4 WORDS (VALIDATION)

.DUSR   ?CRKL   = 4             ; KEY BUFFER LENGTH = 4 WORDS

;
;=======================================================================
;==                                                                   ==
;==         ?PWDCRYP - ENCRYPT PASSWORD                               ==
;==                    PACKET DEFINITIONS                             ==
;==                                                                   ==
;=======================================================================

.DUSR   ?PWFW   = 0             ;FLAGS WORD
.DUSR   ?PWRV   = ?PWFW+1       ;PACKET REVISION NUMBER
.DUSR   ?PWBP   = ?PWRV+1       ;BYTE POINTER TO A(PASSWORD BUFFER)
.DUSR   ?PWLO   = ?PWBP+2       ;NULL TERMINATED OUTPUT PASSWORD LENGTH

.DUSR   ?PWSZ   = ?PWLO+1       ;SIZE OF ?PWDCRYP PACKET



; ?PWFW FLAG WORD BIT MASKS:

.DUSR   ?PWED   = 1B0           ; 1= PASSWORD DECRYPTION
.DUSR   ?PWOW   = 1B1           ; 1= ONE WAY PASSWORD ENCRYPTION

; DEFINE THE PASSWORD BUFFER LENGTH TO BE 33 BYTES (VALIDATION)

.DUSR   ?PWBL   = 33.           ; PASSWORD BUFFER LENGTH = 33 BYTES


;===================================================================
;
;               ?FLOCK and ?FUNLOCK Parameter Definitions
;
;===================================================================


;       Packet Definitions

.DUSR   ?FLREV  =       0               ;Revision field
.DUSR   ?FLTY   =       ?FLREV+1        ;Lock type
.DUSR   ?FLCHN  =       ?FLTY+1         ;Channel number
.DUSR   ?FLRSW  =       ?FLCHN+1        ;Reserved
.DUSR   ?FLSEL  =       ?FLRSW+1        ;Starting element number
.DUSR   ?FLPID  =       ?FLSEL+2        ;Ending element number
.DUSR   ?FLLEN  =       ?FLPID+2        ;Length of packet

;       ?FLOCK/?FUNLOCK lock type definitions

;       ?FLOCK and ?FUNLOCK will will share the same type bits to the
;       extent that they are meaningful for the respective calls.


.DUSR   ?FTCK   =       1B0             ;Lock check
.DUSR   ?FTER   =       1B1             ;Error return, lock ~ avail.
.DUSR   ?FTPN   =       0B1             ;Pend on lock ~ avail.
.DUSR   ?FULA   =       1B2             ;Release all locks (?FUNLOCK)

.DUSR   ?FWFL   =       1B8.            ;Whole file lock


.DUSR   ?FTSH   =       1B14.           ;Shared lock
.DUSR   ?FTEX   =       1B15.           ;Exclusive lock



;DEFINE PACKET OFFSETS FOR THE ?OPER MAIN PACKET

.DUSR   ?OPKT   =       0               ;PACKET IDENTIFIER
.DUSR   ?OSPI   =       ?OPKT+2         ;SUBPACKET INDICATOR
.DUSR   ?OREV   =       ?OSPI+1         ;RESERVED
.DUSR   ?ORES   =       ?OREV+1         ;RESOURCE FLAGS
.DUSR   ?OPSP   =       ?ORES+2         ;WORD ADDRESS OF SUBPACKET
.DUSR   ?OPNL   =       ?OPSP+2         ;LENGTH OF ?OPER MAIN PACKET

;DEFINE THE VARIOUS ?OPER FUNCTIONS

.DUSR   ?OPON   =       1               ;BECOME AN OPERATOR DAEMON
.DUSR   ?OPOFF  =       ?OPON+1         ;RESIGN AS AN OPERATOR DAEMON
.DUSR   ?OPSEND =       ?OPOFF+1        ;ISSUE AN OPERATOR REQUEST
.DUSR   ?OPRCV  =       ?OPSEND+1       ;RECEIVE AN OPERATOR REQUEST
.DUSR   ?OPRESP =       ?OPRCV+1        ;RESPOND TO A REQUEST
.DUSR   ?OPINFO =       ?OPRESP+1       ;GET OPERATOR INFORMATION


.DUSR   ?OPLO   =       ?OPON           ; LOW LIMIT OF FUNCTION CODES
.DUSR   ?OPHI   =       ?OPINFO         ; HI LIMIT OF FUNCTION CODES

;DEFINE PACKET ID'S FOR ?OPER PACKET AND ASSOCIATED SUBPACKETS

.DUSR   ?OPID   =       (325*200000)+(0*400)+0  ;MAIN PACKET ID
.DUSR   ?ONID   =       (325*200000)+(1*400)+0  ;OPON ID
.DUSR   ?OFID   =       (325*200000)+(2*400)+0  ;OPOFF ID
.DUSR   ?SEID   =       (325*200000)+(3*400)+0  ;OPSEND ID
.DUSR   ?RCID   =       (325*200000)+(4*400)+0  ;OPRCV ID
.DUSR   ?RSID   =       (325*200000)+(5*400)+0  ;OPRESP ID
.DUSR   ?INID   =       (325*200000)+(6*400)+0  ;OPINFO ID

;
;DEFINE RESOURCE FLAGS BIT POSITIONS

.DUSR   ?OBLD   =       0               ;LABELLED DISKETTE
.DUSR   ?OBUD   =       1               ;UNLABELLED DISKETTE
.DUSR   ?OBLT   =       2               ;LABELLED TAPES
.DUSR   ?OBUT   =       3               ;UNLABELLED TAPES
.DUSR   ?OBCO   =       4               ;CONSOLES
.DUSR   ?OBPR   =       5               ;PRINTERS
.DUSR   ?OBBQ   =       6               ;BATCH QUEUES
.DUSR   ?OBHD   =       7               ;HARD DISKS
.DUSR   ?OBQU   =       8.              ;QUEUES
.DUSR   ?OBCD   =       9.              ;OTHER COOPERATIVE DEVICES
.DUSR   ?OBGM   =       10.             ;GENERIC MEDIA
.DUSR   ?OBMI   =       11.             ;MISCELLANEOUS
.DUSR   ?OBMX   =       ?OBMI+1         ;NUMBER OF DEFINED RESOURCES


;DEFINE RESOURCE FLAGS BIT MASKS

.DUSR   ?OPLD   =       1S?OBLD         ;LABELLED DISKETTE
.DUSR   ?OPUD   =       1S?OBUD         ;UNLABELLED DISKETTE
.DUSR   ?OPLB   =       1S?OBLT         ;LABELLED TAPE
.DUSR   ?OPUT   =       1S?OBUT         ;UNLABELLED TAPE
.DUSR   ?OPCO   =       1S?OBCO         ;CONSOLES
.DUSR   ?OPPR   =       1S?OBPR         ;PRINTERS
.DUSR   ?OPBQ   =       1S?OBBQ         ;BATCH QUEUE
.DUSR   ?OPHD   =       1S?OBHD         ;HARD DISKS
.DUSR   ?OPQU   =       1S?OBQU         ;QUEUES
.DUSR   ?OPCD   =       1S?OBCD         ;COOPERATIVE DEVICES
.DUSR   ?OPGM   =       1S?OBGM         ;GENERIC MEDIA
.DUSR   ?OPMI   =       1S?OBMI         ;MISCELLANEOUS


;DEFINE BIT POINTERS FROM START OF PACKET FOR RESOURCE FLAGS

.DUSR   ?OSLD   =       (?ORES*16.)+?OBLD       ;LABELLED DISKETTE
.DUSR   ?OSUD   =       (?ORES*16.)+?OBUD       ;UNLABELLED DISKETTE
.DUSR   ?OSLT   =       (?ORES*16.)+?OBLT       ;LABELLED TAPE
.DUSR   ?OSUT   =       (?ORES*16.)+?OBUT       ;UNLABELLED TAPE
.DUSR   ?OSCO   =       (?ORES*16.)+?OBCO       ;CONSOLES
.DUSR   ?OSPR   =       (?ORES*16.)+?OBPR       ;PRINTERS
.DUSR   ?OSBQ   =       (?ORES*16.)+?OBBQ       ;BATCH QUEUES
.DUSR   ?OSHD   =       (?ORES*16.)+?OBHD       ;HARD DISKES
.DUSR   ?OSQU   =       (?ORES*16.)+?OBQU       ;QUEUES
.DUSR   ?OSCD   =       (?ORES*16.)+?OBCD       ;COOPERATIVE MEDIA
.DUSR   ?OSGM   =       (?ORES*16.)+?OBGM       ;GENERIC MEDIA
.DUSR   ?OSMI   =       (?ORES*16.)+?OBMI       ;MISCELLANEOUS


;OPERATOR ON SUBPACKET - FUNCTION ?OPON

.DUSR   ?OONT   =       0               ;PACKET IDENTIFIER
.DUSR   ?OONN   =       ?OONT+2         ;DAEMON NAME IDENTIFIER
.DUSR   ?OOGT   =       ?OONN+2         ;TYPE OF DAEMON FLAGS
.DUSR   ?ONER   =       ?OOGT+2         ;RESOURCE ERRORS
.DUSR   ?OONE   =       ?ONER+2         ;WORD ADDRESS OF ERROR BUFFER
.DUSR   ?ONEI   =       ?OONE+2         ;INPUT ERROR BUFFER LENGTH
.DUSR   ?ONEO   =       ?ONEI+1         ;OUTPUT ERROR BUFFER LENGTH
.DUSR   ?OONL   =       ?ONEO+1         ;SIZE OF ?OPEN SUBPACKET

;DEFINE OPERATOR OFF SUBPACKET - ?OPOFF FUNCTION

.DUSR   ?OOFT   =       0               ;PACKET IDENTIFIER
.DUSR   ?OOFN   =       ?OOFT+2         ;DAEMON NAME IDENTIFIER
.DUSR   ?OFER   =       ?OOFN+2         ;RESOURCE ERRORS
.DUSR   ?OOFE   =       ?OFER+2         ;WORD ADDRESS OF ERROR BUFFER
.DUSR   ?OFEI   =       ?OOFE+2         ;INPUT ERROR BUFFER LENGTH
.DUSR   ?OFEO   =       ?OFEI+1         ;OUTPUT ERROR BUFFER LENGTH
.DUSR   ?OOFL   =       ?OFEO+1         ;SIZE OF ?OPOFF SUBPACKET


;DEFINE OPERATOR SEND REQUEST SUBPACKET - ?OPSEND FUNCTION

.DUSR   ?OSNT   =       0               ;PACKET IDENTIFIER
.DUSR   ?OSNP   =       ?OSNT+2         ;WORD ADDRESS OF DATA BUFFER
.DUSR   ?OSIL   =       ?OSNP+2         ;INPUT DATA BUFFER LENGTH
.DUSR   ?OSOL   =       ?OSIL+1         ;RETURNED DATA LENGTH
.DUSR   ?OSID   =       ?OSOL+1         ;DATA INPUT LENGTH
.DUSR   ?OSNQ   =       ?OSID+1         ;REQUEST CODE
.DUSR   ?OSNN   =       ?OSNQ+1         ;DAEMON NAME IDENTIFIER
.DUSR   ?OSNF   =       ?OSNN+2         ;ROUTING FLAGS WORD
.DUSR   ?OSNR   =       ?OSNF+1         ;RESERVED
.DUSR   ?OSLN   =       ?OSNR+1         ;SIZE OF ?OPSEND SUBPACKET

;DEFINE ROUTING BIT FLAG MASKS

.DUSR   ?OSNL   =       1B0             ;SEND TO LOCAL DAEMON
.DUSR   ?OSNG   =       1B1             ;SEND TO GLOBAL DAEMON WITH
                                        ;NAME SPECIFIED
.DUSR   ?OSNO   =       1B2             ;SEND TO ANY GLOBAL DAEMON AND
                                        ;RETURN DAEMON NAME

;DEFINE OPERATOR RECEIVE REQUEST SUBPACKET - ?OPRCV FUNCTION

.DUSR   ?ORCT   =       0               ;PACKET IDENTIFIER
.DUSR   ?ORCP   =       ?ORCT+2         ;WORD ADDRESS OF DATA BUFFER
.DUSR   ?OCIL   =       ?ORCP+2         ;AVAILABLE INPUT BUFFER LENGTH
.DUSR   ?OCOL   =       ?OCIL+1         ;RETURNED BUFFER LENGTH
.DUSR   ?ORCS   =       ?OCOL+1         ;SEQUENCE NUMBER
.DUSR   ?ORCN   =       ?ORCS+2         ;DAEMON NAME IDENTIFIER
.DUSR   ?OCRD   =       ?ORCN+2         ;PID
.DUSR   ?OCR1   =       ?OCRD+1         ;RESERVED
.DUSR   ?OCR2   =       ?OCR1+1         ;RESERVED
.DUSR   ?OCR4   =       ?OCR2+2         ;RESERVED
.DUSR   ?OCR6   =       ?OCR4+2         ;RESERVED
.DUSR   ?ORCQ   =       ?OCR6+2         ;REQUEST CODE
.DUSR   ?ORSC   =       ?ORCQ+1         ;SYSTEM CALL
.DUSR   ?OCR8   =       ?ORSC+1         ;RESERVED
.DUSR   ?OCR9   =       ?OCR8+1         ;WAITER COUNT
.DUSR   ?ORCL   =       ?OCR9+1         ;SIZE OF ?OPRCV SUBPACKET

;DEFINE OPERATOR RESPOND TO REQUEST FUNCTION - ?OPRESP

.DUSR   ?ORPT   =       0               ;PACKET IDENTIFIER
.DUSR   ?ORPP   =       ?ORPT+2         ;WORD ADDRESS OF DATA BUFFER
.DUSR   ?OPIL   =       ?ORPP+2         ;INPUT BUFFER LENGTH
.DUSR   ?ORPE   =       ?OPIL+1         ;ERROR CODE
.DUSR   ?ORPS   =       ?ORPE+1         ;SEQUENCE NUMBER
.DUSR   ?ORPN   =       ?ORPS+2         ;DAEMON NAME IDENTIFIER
.DUSR   ?ORPL   =       ?ORPN+2         ;SIZE OF ?OPRESP SUBPACKET

; DEFINE OPERATOR INFORMATION SUBPACKET - ?OPINFO FUNCTION CODE

.DUSR   ?OINT   =       0               ;PACKET IDENTIFIER
.DUSR   ?OINP   =       ?OINT+2         ;WORD ADDRESS OF INFORMATION BUFFER
.DUSR   ?OIIL   =       ?OINP+2         ;INPUT BUFFER LENGTH
.DUSR   ?OIOL   =       ?OIIL+1         ;OUTPUT BUFFER LENGTH
.DUSR   ?OIND   =       ?OIOL+1         ;FUNCTION BITS
.DUSR   ?OINR   =       ?OIND+1         ;RESERVED FIELD
.DUSR   ?OINL   =       ?OINR+1         ;SIZE OF ?OPINFO SUBPACKET

;DEFINE FUNCTION BIT FLAGS FOR OFFSET ?OIND

.DUSR   ?OIGB   =       1B0
.DUSR   ?OIGN   =       1B1

;----------------------------------------------------------------------
;                       ?OPEX main packet definitions
;----------------------------------------------------------------------


.DUSR   ?ZXID   = 0             ; Packet Id
.DUSR   ?ZXFU   = ?ZXID+2       ; Function code
.DUSR   ?ZXTP   = ?ZXFU+1       ; Time prompt
.DUSR   ?ZXFG   = ?ZXTP+1       ; Flags, active field
.DUSR   ?ZXRS   = ?ZXFG+1       ; Reserved
.DUSR   ?ZXNA   = ?ZXRS+1       ; B( name buffer )
.DUSR   ?ZXNB   = ?ZXNA+2       ; Input size of name buffer
.DUSR   ?ZXNL   = ?ZXNB+1       ; Returned string length
.DUSR   ?ZXSP   = ?ZXNL+1       ; W( subpacket )

.DUSR   ?ZXLN   = ?ZXSP+2       ; ?OPEX main packet length

;----------------------------------------------------------------------
;    Bit and Bit Mask definitions, ?ZXFG flags word, Main packet
;----------------------------------------------------------------------

.DUSR   ?ZZA0   =  0.          ; (input bit)
.DUSR   ?ZYA0   =  1B(?ZZA0)   ; Bit mask
;  If set, this specifies that a byte pointer is being passed in
;   ?ZXNA.

;----------------------------------------------------------------------
;                       ?OPEX function codes
;----------------------------------------------------------------------

.DUSR   ?ZAC        =   1.       ;     (M) -- access command
.DUSR   ?ZAG        =   2.       ;     (P) -- align command
.DUSR   ?ZAL        =   3.       ;    (GM) -- allocate command
.DUSR   ?ZBL        =   4.       ;     (Q) -- batch_list command
.DUSR   ?ZBO        =   5.       ;     (Q) -- batch_output command
.DUSR   ?ZBI        =   6.       ;     (P) -- binary command
.DUSR   ?ZBR        =   7.       ;     (Q) -- brief command
.DUSR   ?ZCA        =   8.       ;     (Q) -- cancel command
.DUSR   ?ZCL        =   9.       ;     (Q) -- close
.DUSR   ?ZCS        =  10.       ;     (C) -- consolestatus
.DUSR   ?ZCO        =  11.       ;     (Q) -- continue
.DUSR   ?ZCP        =  12.       ;     (P) -- cpl
.DUSR   ?ZCR        =  13.       ;     (Q) -- create
.DUSR   ?ZDF        =  14.       ;     (P) -- defaultforms
.DUSR   ?ZDE        =  15.       ;     (Q) -- delete
.DUSR   ?ZDI        =  16.       ;     (C) -- disable
.DUSR   ?ZDS        =  17.       ;    (GM) -- dismount
.DUSR   ?ZEL        =  18.       ;     (P) -- elongate
.DUSR   ?ZEN        =  19.       ;     (C) -- enable
.DUSR   ?ZEV        =  20.       ;     (P) -- even
.DUSR   ?ZFL        =  21.       ;     (Q) -- flush
.DUSR   ?ZFN        =  22.       ;     (P) -- font
.DUSR   ?ZFO        =  23.       ;     (P) -- forms
.DUSR   ?ZHA        =  24.       ;     (M) -- halt
.DUSR   ?ZHE        =  25.       ;     (P) -- headers
.DUSR   ?ZHO        =  26.       ;     (Q) -- hold
.DUSR   ?ZLI        =  27.       ;     (Q) -- limit
.DUSR   ?ZLO        =  28.       ;     (M) -- logging
.DUSR   ?ZLP        =  29.       ;     (P) -- lpp
.DUSR   ?ZMP        =  30.       ;     (P) -- mapper
.DUSR   ?ZME        =  31.       ;     (M) -- message
.DUSR   ?ZMO        =  32.       ;    (GM) -- mounted
.DUSR   ?ZMS        =  33.       ;    (GM) -- mountstatus
.DUSR   ?ZON        =  34.       ;     (Q) -- open
.DUSR   ?ZOP        =  35.       ;    (GM) -- operator
.DUSR   ?ZPA        =  36.       ;     (Q) -- pause
.DUSR   ?ZPI        =  37.       ;     (Q) -- priority
.DUSR   ?ZPE        =  38.       ;    (GM) -- premount
.DUSR   ?ZPR        =  39.       ;     (M) -- prompts
.DUSR   ?ZPU        =  40.       ;     (Q) -- purge
.DUSR   ?ZMD        =  41.       ;     (Q) -- modify
.DUSR   ?ZQP        =  42.       ;     (Q) -- queuepriority
.DUSR   ?ZRF        =  43.       ;    (GM) -- refused
.DUSR   ?ZRE        =  44.       ;    (GM) -- release
.DUSR   ?ZRT        =  45.       ;     (P) -- restart
.DUSR   ?ZSI        =  46.       ;     (Q) -- silence
.DUSR   ?ZSP        =  47.       ;    (OC) -- spoolstatus
.DUSR   ?ZSK        =  48.       ;    (OC) -- stack
.DUSR   ?ZSR        =  49.       ;     (Q) -- start
.DUSR   ?ZSS        =  50.       ;     (Q) -- status
.DUSR   ?ZST        =  51.       ;     (Q) -- stop
.DUSR   ?ZTE        =  52.       ;     (M) -- terminate
.DUSR   ?ZTR        =  53.       ;     (P) -- trailers
.DUSR   ?ZUH        =  54.       ;     (Q) -- unhold
.DUSR   ?ZUS        =  55.       ;    (GM) -- unitstatus
.DUSR   ?ZUL        =  56.       ;     (Q) -- unlimit
.DUSR   ?ZUN        =  57.       ;     (Q) -- unsilence
.DUSR   ?ZVE        =  58.       ;     (Q) -- verbose
.DUSR   ?ZXB        =  59.       ;     (Q) -- xbias command

;      The following 4 function codes are NOT used for
;      AOS/VS. They are included here to reserve the slots.

.DUSR   ?ZAK        =  60.       ;     (M) -- autokey
.DUSR   ?ZRG        =  61.       ;     (Q) -- register
.DUSR   ?ZDG        =  62.       ;     (Q) -- deregister
.DUSR   ?ZRS        =  63.       ;     (Q) -- registerstatus
.DUSR   ?ZDM        =  64.       ;     ( ) -- memory dump
.DUSR   ?ZUC        =  65.       ;     (Q) -- user command

;----------------------------------------------------------------------
;                     ?OPEX packet Ids
;----------------------------------------------------------------------

.DUSR   ?ZXIZ  = (471*200000)+(0*400)+0     ; ?OPEX main packet id
.DUSR   ?ZCSZ  = (471*200000)+(?ZCS*400)+0  ; pkt id, CONSOLESTATUS
.DUSR   ?ZDIZ  = (471*200000)+(?ZDI*400)+0  ; pkt id, DISABLE
.DUSR   ?ZENZ  = (471*200000)+(?ZEN*400)+0  ; pkt id, ENABLE
.DUSR   ?ZAGZ  = (471*200000)+(?ZAG*400)+0  ; pkt id, ALIGN
.DUSR   ?ZBIZ  = (471*200000)+(?ZBI*400)+0  ; pkt id, BINARY
.DUSR   ?ZCPZ  = (471*200000)+(?ZCP*400)+0  ; pkt id, CPL
.DUSR   ?ZDFZ  = (471*200000)+(?ZDF*400)+0  ; pkt id, DEFAULTFORMS
.DUSR   ?ZELZ  = (471*200000)+(?ZEL*400)+0  ; pkt id, ELONGATE
.DUSR   ?ZEVZ  = (471*200000)+(?ZEV*400)+0  ; pkt id, EVEN
.DUSR   ?ZFOZ  = (471*200000)+(?ZFO*400)+0  ; pkt id, FORMS
.DUSR   ?ZHEZ  = (471*200000)+(?ZHE*400)+0  ; pkt id, HEADERS
.DUSR   ?ZLPZ  = (471*200000)+(?ZLP*400)+0  ; pkt id, LPP
.DUSR   ?ZMPZ  = (471*200000)+(?ZMP*400)+0  ; pkt id, MAPPER
.DUSR   ?ZRTZ  = (471*200000)+(?ZRT*400)+0  ; pkt id, RESTART
.DUSR   ?ZTRZ  = (471*200000)+(?ZTR*400)+0  ; pkt id, TRAILERS
.DUSR   ?ZSPZ  = (471*200000)+(?ZSP*400)+0  ; pkt id, SPOOLSTATUS
.DUSR   ?ZS1Z  = (471*200000)+(?ZSP*400)+1  ; pkt id, SPOOLSTATUS, rev 1
.DUSR   ?ZSKZ  = (471*200000)+(?ZSK*400)+0  ; pkt id, STACK
.DUSR   ?ZBLZ  = (471*200000)+(?ZBL*400)+0  ; pkt id, BATCH_LIST
.DUSR   ?ZBOZ  = (471*200000)+(?ZBO*400)+0  ; pkt id, BATCH_OUTPUT
.DUSR   ?ZBRZ  = (471*200000)+(?ZBR*400)+0  ; pkt id, BRIEF
.DUSR   ?ZCAZ  = (471*200000)+(?ZCA*400)+0  ; pkt id, CANCEL
.DUSR   ?ZCOZ  = (471*200000)+(?ZCO*400)+0  ; pkt id, CONTINUE
.DUSR   ?ZCRZ  = (471*200000)+(?ZCR*400)+0  ; pkt id, CREATE
.DUSR   ?ZFLZ  = (471*200000)+(?ZFL*400)+0  ; pkt id, FLUSH
.DUSR   ?ZHOZ  = (471*200000)+(?ZHO*400)+0  ; pkt id, HOLD
.DUSR   ?ZLIZ  = (471*200000)+(?ZLI*400)+0  ; pkt id, LIMIT
.DUSR   ?ZPAZ  = (471*200000)+(?ZPA*400)+0  ; pkt id, PAUSE
.DUSR   ?ZPIZ  = (471*200000)+(?ZPI*400)+0  ; pkt id, PRIORITY
.DUSR   ?ZQPZ  = (471*200000)+(?ZQP*400)+0  ; pkt id, QPRIORITY
.DUSR   ?ZSIZ  = (471*200000)+(?ZSI*400)+0  ; pkt id, SILENCE
.DUSR   ?ZSRZ  = (471*200000)+(?ZSR*400)+0  ; pkt id, START
.DUSR   ?ZQSS  = (471*200000)+(?ZSS*400)+0  ; pkt id, STATUS
.DUSR   ?ZSTZ  = (471*200000)+(?ZST*400)+0  ; pkt id, STOP
.DUSR   ?ZUHZ  = (471*200000)+(?ZUH*400)+0  ; pkt id, UNHOLD
.DUSR   ?ZULZ  = (471*200000)+(?ZUL*400)+0  ; pkt id, UNLIMIT
.DUSR   ?ZUNZ  = (471*200000)+(?ZUN*400)+0  ; pkt id, UNSILENCE
.DUSR   ?ZVEZ  = (471*200000)+(?ZVE*400)+0  ; pkt id, VERBOSE
.DUSR   ?ZXBZ  = (471*200000)+(?ZXB*400)+0  ; pkt id, XBIAS
.DUSR   ?ZDSZ  = (471*200000)+(?ZDS*400)+0  ; pkt id, DISMOUNTED
.DUSR   ?ZMOZ  = (471*200000)+(?ZMO*400)+0  ; pkt id, MOUNTED
.DUSR   ?ZMSQ  = (471*200000)+(?ZMS*400)+0  ; pkt id, MOUNTSTATUS
.DUSR   ?ZOPZ  = (471*200000)+(?ZOP*400)+0  ; pkt id, OPERATOR
.DUSR   ?ZPEZ  = (471*200000)+(?ZPE*400)+0  ; pkt id, PREMOUNT
.DUSR   ?ZRFZ  = (471*200000)+(?ZRF*400)+0  ; pkt id, REFUSED
.DUSR   ?ZREZ  = (471*200000)+(?ZRE*400)+0  ; pkt id, RELEASE
.DUSR   ?ZUSZ  = (471*200000)+(?ZUS*400)+0  ; pkt id, UNITSTATUS
.DUSR   ?ZHAZ  = (471*200000)+(?ZHA*400)+0  ; pkt id, HALT
.DUSR   ?ZLOZ  = (471*200000)+(?ZLO*400)+0  ; pkt id, LOGGING
.DUSR   ?ZPRZ  = (471*200000)+(?ZPR*400)+0  ; pkt id, PROMPTS
.DUSR   ?ZACZ  = (471*200000)+(?ZAC*400)+0  ; pkt id, ACCESS
.DUSR   ?ZAKZ  = (471*200000)+(?ZAK*400)+0  ; pkt id, AUTOKEY
.DUSR   ?ZRGZ  = (471*200000)+(?ZRG*400)+0  ; pkt id, REGISTER
.DUSR   ?ZRSZ  = (471*200000)+(?ZRS*400)+0  ; pkt id, REGISTERSTATUS
.DUSR   ?ZUCZ  = (471*200000)+(?ZUC*400)+0  ; pkt id, USER COMMAND


;----------------------------------------------------------------------
;                       ?OPEX Subpacket Definitions
;----------------------------------------------------------------------
;----------------------------------------------------------------------
;             ?OPEX,  Consolestatus,  function code = ?ZCS
;----------------------------------------------------------------------

.DUSR   ?ZCSI   = 0             ; Subpacket Id
.DUSR   ?ZCSF   = ?ZCSI+2       ; Flags
.DUSR   ?ZCSR   = ?ZCSF+1       ; Reserved
.DUSR   ?ZCSK   = ?ZCSR+1       ; Next key word 1
.DUSR   ?ZCS3   = ?ZCSK+2       ; Next key, word 2
.DUSR   ?ZCSU   = ?ZCS3+2       ; B( Username )
.DUSR   ?ZCSA   = ?ZCSU+2       ; Username buf size
.DUSR   ?ZCSB   = ?ZCSA+1       ; Username ret str len
.DUSR   ?ZCSN   = ?ZCSB+1       ; Number of tries
.DUSR   ?ZCSP   = ?ZCSN+1       ; PID

.DUSR   ?ZCSL   = ?ZCSP+1       ; Length of Consolestatus subpkt


;----------------------------------------------------------------------
;    Bit and Bit Mask definitions, ?ZCSF flags word, Consolestatus
;----------------------------------------------------------------------

.DUSR   ?ZZB0   =  0.          ; (input bit)
.DUSR   ?ZYB0   =  1B(?ZZB0)   ; Bit mask
;  This is the default. User wants status on all consoles.

.DUSR   ?ZZB1   =  1.         ; (output bit)
.DUSR   ?ZYB1   =  1B(?ZZB1)  ; Bit mask
;  Console is enabled.

.DUSR   ?ZZB2   =  2.          ; (output bit)
.DUSR   ?ZYB2   =  1B(?ZZB2)   ; Bit mask
;   Continue.

.DUSR   ?ZZB3   =  3.          ; (output bit)
.DUSR   ?ZYB3   =  1B(?ZZB3)   ; Bit mask
;   Stop.

.DUSR   ?ZZB4   =  4.          ; (output bit)
.DUSR   ?ZYB4   =  1B(?ZZB4)   ; Bit mask
;   Console is  logged on.

.DUSR   ?ZZB5   =  5.          ; (output bit)
.DUSR   ?ZYB5   =  1B(?ZZB5)  ; Bit mask
;   Console will be disabled.

.DUSR   ?ZZB6   =  6.          ; (output bit)
.DUSR   ?ZYB6   =  1B(?ZZB6)   ; Bit mask
;   Log on/off is in progress.

.DUSR   ?ZZB7   =  7.          ; (output bit)
.DUSR   ?ZYB7   =  1B(?ZZB7)   ; Bit mask
;   Console is in server died state.

.DUSR   ?ZZB8   =  8.          ; (output bit)
.DUSR   ?ZYB8   =  1B(?ZZB8)   ; Bit mask
;   Console is in error state.

.DUSR   ?ZZB9   =  9.          ; (output bit)
.DUSR   ?ZYB9   =  1B(?ZZB9)   ; Bit mask
;   Console is not logged on..

;----------------------------------------------------------------------
;             ?OPEX,  Disable,  function code = ?ZDI
;----------------------------------------------------------------------

.DUSR   ?ZDII   = 0             ; Subpkt Id
.DUSR   ?ZDIF   = ?ZDII+2       ; Flags
.DUSR   ?ZDIN   = ?ZDIF+1       ; Number of consoles

.DUSR   ?ZDIL   = ?ZDIN+1       ; Disable subpkt length

;----------------------------------------------------------------------
;    Bit and bit mask definitions for ?ZDIF word in Disble function
;----------------------------------------------------------------------

.DUSR   ?ZZC0   =  0.           ; (input bit)
.DUSR   ?ZYC0   =  1B(?ZZC0)
;   This is the default. User wants to disable all consoles.


.DUSR   ?ZZC1   =  1.           ; (output bit)
.DUSR   ?ZYC1   =  1B(?ZZC1)
;   Console will be disabled.

.DUSR   ?ZZC2   =  2.           ; (output bit)
.DUSR   ?ZYC2   =  1B(?ZZC2)
;   All consoles will be disabled.
;----------------------------------------------------------------------
;             ?OPEX,  Enable,  function code = ?ZEN
;----------------------------------------------------------------------

.DUSR   ?ZENI   = 0                     ; Subpkt Id
.DUSR   ?ZENF   = ?ZENI+2               ; Flags
.DUSR   ?ZENT   = ?ZENF+1               ; Number of tries
.DUSR   ?ZENK   = ?ZENT+1               ; Next key, word 1
.DUSR   ?ZEN3   = ?ZENK+2               ; Next key word 2
.DUSR   ?ZENC   = ?ZEN3+2               ; Number of consoles
.DUSR   ?ZENR   = ?ZENC+1               ; Reserved

.DUSR  ?ZENL   = ?ZENR+1               ; Enable subpkt length

;----------------------------------------------------------------------
;      Bit abd Bit mask definitions for ?ZENF, enable flags word
;----------------------------------------------------------------------

.DUSR   ?ZZD0   =  0.          ; (input bit)
.DUSR   ?ZYD0   =  1B(?ZZD0)
;   This is the default. User wants to enable all consoles.

.DUSR   ?ZZD1   =  1.          ; (input bit)
.DUSR   ?ZYD1   =  1B(?ZZD1)
;   Tries switch.

.DUSR   ?ZZD2   =  2.          ; (input bit)
.DUSR   ?ZYD2   =  1B(?ZZD2)
;   Stop switch.

.DUSR   ?ZZD3   =  3.           ; (input bit)
.DUSR   ?ZYD3   =  1B(?ZZD3)
;   Continue switch.

.DUSR   ?ZZD4   =  4.          ; (input bit)
.DUSR   ?ZYD4   =  1B(?ZZD4)
;   Force switch.

.DUSR   ?ZZD5   =  5.          ; (output bit)
.DUSR   ?ZYD5   =  1B(?ZZD5)
;   Console already enabled.

.DUSR   ?ZZD6   =  6.          ; (output bit)
.DUSR   ?ZYD6   =  1B(?ZZD6)
;   Cancelling disable, previous values in effect.

.DUSR   ?ZZD7   =  7.          ; (output bit)
.DUSR   ?ZYD7   =  1B(?ZZD7)
;   Cancelling disable, new logon values in effect.

.DUSR   ?ZZD8   =  8.          ; (output bit)
.DUSR   ?ZYD8   =  1B(?ZZD8)
;   New logon values in effect.

.DUSR   ?ZZD9   =  9.          ; (output bit)
.DUSR   ?ZYD9   =  1B(?ZZD9)
;   Console enabled.

.DUSR   ?ZZDA   =  10.         ; (output bit)
.DUSR   ?ZYDA   =  1B(?ZZDA)
;   Could not enable console.

.DUSR   ?ZZDB   =  11.         ; (output bit)
.DUSR   ?ZYDB   =  1B(?ZZDB)
;   Device already in use.

;----------------------------------------------------------------------
;             ?OPEX,  ALIGN,  function code = ?ZAG
;----------------------------------------------------------------------

.DUSR   ?ZAGI   = 0             ; Subpkt Id
.DUSR   ?ZAGF   = ?ZAGI+2       ; Flags
.DUSR   ?ZAGN   = ?ZAGF+1       ; # of pages

.DUSR   ?ZAGL   = ?ZAGN+1         ; ALIGN subpkt length

;----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZAGF word, Align function
;----------------------------------------------------------------------

.DUSR   ?ZZE0   =  0.         ; (input bit)
.DUSR   ?ZYE0   =  1B(?ZZE0)
;   Continue.
;----------------------------------------------------------------------
;             ?OPEX,  BINARY,  function code = ?ZBI
;----------------------------------------------------------------------

.DUSR   ?ZBII   = 0                     ; Subpkt Id
.DUSR   ?ZBIF   = ?ZBII+2               ; Flags
.DUSR   ?ZBIA   = ?ZBIF+1               ; Filename buffer size
.DUSR   ?ZBIB   = ?ZBIA+1               ; B(filename)

.DUSR   ?ZBIL   = ?ZBIB+2               ; Binary subpkt length

;----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZBIF word, Binary function
;----------------------------------------------------------------------

.DUSR   ?ZZF0   =  0.           ; (input bit)
.DUSR   ?ZYF0   =  1B(?ZZF0)    ; bit mask
;   if set, bytepointer to filename
;   buffer is passed in the field,  ?ZBIB.

.DUSR   ?ZZF1   =  1.           ; (input bit)
.DUSR   ?ZYF1   =  1B(?ZZF1)    ; bit mask
;   Binary mode is off.

.DUSR   ?ZJF1   =  0B(?ZZF1)    ; bit mask
;   Binary mode is on.


.DUSR   ?ZZF2   =  2.           ; (output bit)
.DUSR   ?ZYF2   =  1B(?ZZF2)    ; bit mask
;   Binary mode is enabled.

.DUSR   ?ZYJ2   =  0B(?ZZF2)    ; bit mask
;   Binary mode is disabled.

;----------------------------------------------------------------------
;             ?OPEX,  CPL,  function code = ?ZCP
;----------------------------------------------------------------------

.DUSR   ?ZCPI   = 0             ; Subpkt Id
.DUSR   ?ZCPN   = ?ZCPI+2       ; # of characters
.DUSR   ?ZCPR   = ?ZCPN+1       ; Reserved

.DUSR   ?ZCPL = ?ZCPR+1         ; CPL subpkt length

;----------------------------------------------------------------------
;             ?OPEX,  DEFAULTFORMS,  function code = ?ZDF
;----------------------------------------------------------------------

.DUSR   ?ZDFI   = 0             ; Subpkt Id
.DUSR   ?ZDFF   = ?ZDFI+2       ; Flags
.DUSR   ?ZDFA   = ?ZDFF+1       ; filename buffer size
.DUSR   ?ZDFB   = ?ZDFA+1       ; B(filename)

.DUSR   ?ZDFL = ?ZDFB+2         ; defaultforms subpkt length

;----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZDFF defaultforms function
;----------------------------------------------------------------------

.DUSR   ?ZZG0   =  0.           ;(input bit)
.DUSR   ?ZYG0   =  1B(?ZZG0)    ; bit mask
;   if set, bytepointer to filename buffer is passed in the field ?XDFB.
;   If not, the implicit default forms are used.


;----------------------------------------------------------------------
;             ?OPEX,  ELONGATE,  function code = ?ZEL
;----------------------------------------------------------------------

.DUSR   ?ZELI   = 0             ; Subpkt Id
.DUSR   ?ZELF   = ?ZELI+2       ; Flags
.DUSR   ?ZELR   = ?ZELF+1       ; Reserved

.DUSR   ?ZELN = ?ZELR+1         ; Elongate subpkt length

;----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZELF elongate function
;----------------------------------------------------------------------

.DUSR   ?ZZH0   =  0.           ; (input bit)
.DUSR   ?ZYH0   =  1B(?ZZH0)    ; bit mask
;   Elongate is turned on.

.DUSR   ?ZJH0   =  0B(?ZZH0)    ; bit mask
;    Elongate is turned off.


;----------------------------------------------------------------------
;             ?OPEX,  EVEN,  function code = ?ZEV
;----------------------------------------------------------------------

.DUSR   ?ZEVI   = 0                     ; Subpkt Id
.DUSR   ?ZEVF   = ?ZEVI+2               ; Flags
.DUSR   ?ZEVR   = ?ZEVF+1               ; Reserved

.DUSR   ?ZEVL   = ?ZEVR+1               ; Even subpkt length

;----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZEVF even function
;----------------------------------------------------------------------

.DUSR   ?ZZI0   =  0.           ; (input bit)
.DUSR   ?ZYI0   =  1B(?ZZI0)    ; bit mask
;   Even is turned on.

.DUSR   ?ZJI0   =  0B(?ZZI0)    ; bit mask
;   Even is turned off.
;----------------------------------------------------------------------
;             ?OPEX,  FORMS,  function code = ?ZFO
;----------------------------------------------------------------------

.DUSR   ?ZFOI   = 0                     ; Subpkt Id
.DUSR   ?ZFOF   = ?ZFOI+2               ; Flags
.DUSR   ?ZFOA   = ?ZFOF+1               ; filename buffer size
.DUSR   ?ZFOB   = ?ZFOA+1               ; B(filename)

.DUSR   ?ZFOL   = ?ZFOB+2               ; Forms subpkt length

;----------------------------------------------------------------------
;    Bit and bit mask definitions, ?ZFOF forms function
;----------------------------------------------------------------------

.DUSR   ?ZZJ0   =  0.           ; (input bit)
.DUSR   ?ZYJ0   =  1B(?ZZJ0)    ; bit mask
;   if set, bytepointer to filename buffer is passed in the field
;   ?ZFOB. If not set, the implicit default forms are used.


;----------------------------------------------------------------------
;             ?OPEX,  HEADERS,  function code = ?ZHE
;----------------------------------------------------------------------

.DUSR   ?ZHEI   = 0                     ; Subpkt Id
.DUSR   ?ZHEH   = ?ZHEI+2               ; # of sheets
.DUSR   ?ZHER   = ?ZHEH+1               ; Reserved

.DUSR   ?ZHEL   = ?ZHER+1               ; Headers subpkt length
;----------------------------------------------------------------------
;             ?OPEX,  LPP,  function code = ?ZLP
;----------------------------------------------------------------------

.DUSR   ?ZLPI   = 0                     ; Subpkt Id
.DUSR   ?ZLPN   = ?ZLPI+2               ; # of lines
.DUSR   ?ZLPR   = ?ZLPN+1               ; Reserved

.DUSR   ?ZLPL   = ?ZLPR+1               ; LPP subpkt length
;----------------------------------------------------------------------
;             ?OPEX,  MAPPER,  function code = ?ZMP
;----------------------------------------------------------------------

.DUSR   ?ZMPI   = 0                     ; subpacket identifier
.DUSR   ?ZMPF   = ?ZMPI+2               ; flags
.DUSR   ?ZMPA   = ?ZMPF+1               ; file name and buffer size
.DUSR   ?ZMPB   = ?ZMPA+1               ; byte address of file name

.DUSR   ?ZMPL   = ?ZMPB+2               ; mapper subpacket length

;----------------------------------------------------------------------
;     Bit and Bit mask definitions, Mapper function, ?ZMPF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZMF   = 0                     ; (input bit)
.DUSR   ?ZYMF   = 1B(?ZZMF)             ; bit mask
;   If set, bytepointer to filename buffer is passed in the field ?ZMPB

;----------------------------------------------------------------------
;             ?OPEX,  RESTART,  function code = ?ZRT
;----------------------------------------------------------------------

.DUSR   ?ZRTI   = 0                     ; Subpkt Id
.DUSR   ?ZRTA   = ?ZRTI+2               ; Argument 1
.DUSR   ?ZRTB   = ?ZRTA+1               ; Argument 2

.DUSR   ?ZRTL   = ?ZRTB+1               ; Restart subpkt length

;----------------------------------------------------------------------
;             ?OPEX,  TRAILERS,  function code = ?ZTR
;----------------------------------------------------------------------

.DUSR   ?ZTRI   = 0                     ; Subpkt Id
.DUSR   ?ZTRT   = ?ZTRI+2               ; # of trailer sheets
.DUSR   ?ZTRR   = ?ZTRT+1               ; Reserved

.DUSR   ?ZTRL   = ?ZTRR+1               ; Trailers subpkt length

;----------------------------------------------------------------------
;             ?OPEX,  SPOOLSTATUS,  function code = ?ZSP
;----------------------------------------------------------------------

.DUSR   ?ZSPI   = 0                   ; Subpkt Id
.DUSR   ?ZSPF   = ?ZSPI+2             ; Flags
.DUSR   ?ZSPV   = ?ZSPF+1             ; Limit value
.DUSR   ?ZSPC   = ?ZSPV+1             ; CPL
.DUSR   ?ZSPN   = ?ZSPC+1             ; LPP
.DUSR   ?ZSPH   = ?ZSPN+1             ; # of headers
.DUSR   ?ZSPT   = ?ZSPH+1             ; # of trailers
.DUSR   ?ZSPB   = ?ZSPT+1             ; Bias factor
.DUSR   ?ZSPP   = ?ZSPB+1             ; Priority
.DUSR   ?ZSPK   = ?ZSPP+1             ; Get next key
.DUSR   ?ZSP9   = ?ZSPK+2             ; Get next key
.DUSR   ?ZSPQ   = ?ZSP9+2             ; B(queuename)
.DUSR   ?ZSP3   = ?ZSPQ+2             ; Queuename buf size
.DUSR   ?ZSP4   = ?ZSP3+1             ; Queuename string length
.DUSR   ?ZSPD   = ?ZSP4+1             ; B(Default forms name)
.DUSR   ?ZSP5   = ?ZSPD+2             ; Forms buf size
.DUSR   ?ZSP6   = ?ZSP5+1             ; Forms string length
.DUSR   ?ZSPS   = ?ZSP6+1             ; B(Special forms)
.DUSR   ?ZSP7   = ?ZSPS+2             ; Special forms buf size
.DUSR   ?ZSP8   = ?ZSP7+1             ; Special forms string length
.DUSR   ?ZSPE   = ?ZSP8+1             ; Error code
.DUSR   ?ZSPR   = ?ZSPE+1             ; Reserved

.DUSR   ?ZSPL   = ?ZSPR+1             ; Spoolstatus subpkt length

.DUSR   ?ZS1C   = ?ZSPR+1             ; byte address of cleanup filename
.DUSR   ?ZS1B   = ?ZS1C+2             ; cleanup file name buffer size
.DUSR   ?ZS1S   = ?ZS1B+1             ; cleanup file name string length
.DUSR   ?ZS1M   = ?ZS1S+1             ; byte address of mapper file name
.DUSR   ?ZS1F   = ?ZS1M+2             ; mapper file name buffer size
.DUSR   ?ZS1P   = ?ZS1F+1             ; mapper file name string length

.DUSR   ?ZS1L   = ?ZS1P+1             ; new spoolstatus subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Spoolstatus function, ?ZSPF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZK0  =  0.           ; (input bit)
.DUSR   ?ZYK0   =  1B(?ZZK0)    ; bit mask
;   All devices.

.DUSR   ?ZZK1   =  1.           ; (output bit)
.DUSR   ?ZYK1   =  1B(?ZZK1)    ; bit mask
;   Even mode is enabled.

.DUSR   ?ZZK2   =  2.           ; (output bit)
.DUSR   ?ZYK2   =  1B(?ZZK2)    ; bit mask
;   Binary mode is enabled.

.DUSR   ?ZZK3   =  3.           ; (output bit)
.DUSR   ?ZYK3   =  1B(?ZZK3)    ; bit mask
;   Upper case is enabled.

.DUSR   ?ZZK4   =  4.           ; (output bit)
.DUSR   ?ZYK4   =  1B(?ZZK4)    ; bit mask
;   New line conversion is enabled.

.DUSR   ?ZZK5   =  5.           ; (output bit)
.DUSR   ?ZYK5   =  1B(?ZZK5)    ; bit mask
;   Process type is swappable.

.DUSR   ?ZZK6   =  6.           ; (output bit)
.DUSR   ?ZYK6   =  1B(?ZZK6)    ; bit mask
;   Process type is preemptable.

.DUSR   ?ZZK7   =  7.           ; (output bit)
.DUSR   ?ZYK7   =  1B(?ZZK7)    ; bit mask
;   Process type is resident.

.DUSR   ?ZZK8   =  8.           ; (output bit)
.DUSR   ?ZYK8   =  1B(?ZZK8)    ; bit mask
;   Default forms are specified.

.DUSR   ?ZZK9   =  9.           ; (output bit)
.DUSR   ?ZYK9   =  1B(?ZZK9)    ; bit mask
;   Special forms are specified.

.DUSR   ?ZZKA   =   10.          ; (output bit)
.DUSR   ?ZYKA   =  1B(?ZZKA)    ; bit mask
;   Limiting is  enabled (this is the default).

.DUSR   ?ZZKB   =   11.          ; (output bit)
.DUSR   ?ZYKB   =  1B(?ZZKB)    ; bit mask
;   Print or Plot device.

.DUSR   ?ZZKC   =   12.          ; (output bit)
.DUSR   ?ZYKC   =  1B(?ZZKC)    ; bit mask
;   8-bit mode is enabled

;----------------------------------------------------------------------
;             ?OPEX,  STACK,  function code = ?ZSK
;----------------------------------------------------------------------

.DUSR   ?ZSKI   = 0                     ; Subpkt Id
.DUSR   ?ZSKF   = ?ZSKI+2               ; Flags
.DUSR   ?ZSK3   = ?ZSKF+1               ; Reserved buffer size
.DUSR   ?ZSKR   = ?ZSK3+1               ; BP(reserved)

.DUSR   ?ZSKL   = ?ZSKR+2               ; Stack subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Stack function, ?ZSKF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZDF   =  0.                   ;(input bit)
.DUSR   ?ZYDF   =  1B(?ZZDF)            ; bit mask
;    Reserved.

;----------------------------------------------------------------------
;             ?OPEX,  BATCH_LIST,  function code = ?ZBL
;----------------------------------------------------------------------

.DUSR   ?ZBLI   = 0                     ; Subpkt Id
.DUSR   ?ZBLF   = ?ZBLI+2               ; Flags
.DUSR   ?ZBLA   = ?ZBLF+1               ; Queuename list buf size
.DUSR   ?ZBLB   = ?ZBLA+1               ; B(queuename list)

.DUSR   ?ZBLL   = ?ZBLB+2               ; Batch_list subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Batch_list function, ?ZBLF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZL0   =  0.                   ;(input bit)
.DUSR   ?ZYL0   =  1B(?ZZL0)            ; bit mask
;    The default switch is on.


;--------------------------------------------------------------------
;             ?OPEX,  BATCH_OUTPUT,  function code = ?ZBO
;----------------------------------------------------------------------

.DUSR   ?ZBOI   = 0                     ; Subpkt Id
.DUSR   ?ZBOF   = ?ZBOI+2               ; Flags
.DUSR   ?ZBOA   = ?ZBOF+1               ; Output queuename buf size
.DUSR   ?ZBOB   = ?ZBOA+1               ; B(Output queuename)

.DUSR   ?ZBOL   = ?ZBOB+2               ; Batch_output subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Batch_output function, ?ZBOF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZM0   =  0.                   ;(input bit)
.DUSR   ?ZYM0   =  1B(?ZZM0)            ;The default switch is on.
;----------------------------------------------------------------------
;             ?OPEX,  BRIEF,  function code = ?ZBR
;----------------------------------------------------------------------

.DUSR   ?ZBRI   = 0                     ; Subpkt Id
.DUSR   ?ZBRF   = ?ZBRI+2               ; Flags
.DUSR   ?ZBRS   = ?ZBRF+1               ; Stream #

.DUSR   ?ZBRL   = ?ZBRS+1               ; Brief subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Batch_list function, ?ZBLF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZN0   =  0.           ; (input bit)
.DUSR   ?ZYN0   =  1B(?ZZN0)    ; bit mask
;    All default batch input streams are specified.

;----------------------------------------------------------------------
;             ?OPEX,  CANCEL,  function code = ?ZCA
;----------------------------------------------------------------------

.DUSR   ?ZCAI   = 0                     ; Subpkt Id
.DUSR   ?ZCAS   = ?ZCAI+2               ; Sequence #
.DUSR   ?ZCAR   = ?ZCAS+1               ; Reserved

.DUSR   ?ZCAL   = ?ZCAR+1               ; Cancel subpkt length

;----------------------------------------------------------------------
;             ?OPEX,  CONTINUE,  function code = ?ZCO
;----------------------------------------------------------------------

.DUSR   ?ZCOI   = 0                     ; Subpkt Id
.DUSR   ?ZCOF   = ?ZCOI+2               ; Flags
.DUSR   ?ZCOS   = ?ZCOF+1               ; Stream #

.DUSR   ?ZCOL   = ?ZCOS+1               ; Continue subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Continue function, ?ZCOF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZO0   =  0.                   ;(input bit)
.DUSR   ?ZYO0   =  1B(?ZZO0)            ; Bit mask
;    Continue all default batch input streams.

;----------------------------------------------------------------------
;             ?OPEX,  CREATE,  function code = ?ZCR
;----------------------------------------------------------------------

.DUSR   ?ZCRI   = 0                     ; Subpkt Id
.DUSR   ?ZCRF   = ?ZCRI+2               ; Flags
.DUSR   ?ZCRN   = ?ZCRF+1               ; # of streams
.DUSR   ?ZCRQ   = ?ZCRN+1               ; Queue type
.DUSR   ?ZCRR   = ?ZCRQ+1               ; Reserved

.DUSR   ?ZCRL   = ?ZCRR+1               ; Create subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, CREATE function, ?ZCRF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZP0   =  0.                   ; (input bit)
.DUSR   ?ZYP0   =  1B(?ZZP0)            ; Bit mask
;    Streams switch.

;----------------------------------------------------------------------
;             ?OPEX,  FLUSH,  function code = ?ZFL
;----------------------------------------------------------------------

.DUSR   ?ZFLI  = 0                      ; Subpkt Id
.DUSR   ?ZFLF  = ?ZFLI+2                ; Flags
.DUSR   ?ZFLS  = ?ZFLF+1                ; # of streams

.DUSR   ?ZFLL   = ?ZFLS+1               ; Flush subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Flush function, ?ZFLF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZPG   =  0.                   ; (input bit)
.DUSR   ?ZYPG   =  1B(?ZZPG)            ; Bit mask
;    Flush all default batch input streams.


;----------------------------------------------------------------------
;             ?OPEX,  HOLD,  function code = ?ZHO
;----------------------------------------------------------------------

.DUSR   ?ZHOI   = 0                     ; Subpkt Id
.DUSR   ?ZHOS   = ?ZHOI+2               ; Sequence #
.DUSR   ?ZHOR   = ?ZHOS+1               ; Reserved

.DUSR   ?ZHOL   = ?ZHOR+1               ; Hold subpkt length

;----------------------------------------------------------------------
;             ?OPEX,  LIMIT,  function code = ?ZLI
;----------------------------------------------------------------------

.DUSR   ?ZLII  = 0                      ;Subpkt Id
.DUSR   ?ZLIA  = ?ZLII+2                ;Argument 1
.DUSR   ?ZLIB  = ?ZLIA+1                ;Argument 2

.DUSR   ?ZLIL = ?ZLIB+1                 ;Limit subpkt length

;----------------------------------------------------------------------
;             ?OPEX,  PAUSE,  function code = ?ZPA
;----------------------------------------------------------------------

.DUSR   ?ZPAI   = 0                     ; Subpkt Id
.DUSR   ?ZPAF   = ?ZPAI+2               ; Flags
.DUSR   ?ZPAS   = ?ZPAF+1               ; Stream #

.DUSR   ?ZPAL   = ?ZPAS+1               ; Pause subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Batch_list function, ?ZBLF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZQ0   =  0.                   ; (input bit)
.DUSR   ?ZYQ0   =  1B(?ZZQ0)            ; bit mask
;    Pause all default batch input streams.
;----------------------------------------------------------------------
;             ?OPEX,  PRIORITY,  function code = ?ZPI
;----------------------------------------------------------------------

.DUSR   ?ZPII   = 0                     ; Subpkt Id
.DUSR   ?ZPIF   = ?ZPII+2               ; Flags
.DUSR   ?ZPIA   = ?ZPIF+1               ; Argument 1
.DUSR   ?ZPIB   = ?ZPIA+1               ; Argument 2
.DUSR   ?ZPIR   = ?ZPIB+1               ; Reserved

.DUSR   ?ZPIL   = ?ZPIR+1               ; Priority subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Priority function, ?ZBIF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZR0   =  0.                   ; (input bit)
.DUSR   ?ZYR0   =  1B(?ZZR0)            ; bit mask
;    Process type is swappable.

.DUSR   ?ZZR1   =  1.                   ; (input bit)
.DUSR   ?ZYR1   =  1B(?ZZR1)            ; bit mask
;    Process type is preemptable.

.DUSR   ?ZZR2   =  2.                   ; (input bit)
.DUSR   ?ZYR2   =  1B(?ZZR2)            ; bit mask
;    Process type is resident.

;----------------------------------------------------------------------
;             ?OPEX,  QPRIORITY,  function code = ?ZQP
;----------------------------------------------------------------------

.DUSR   ?ZQPI   = 0                     ; Subpkt Id
.DUSR   ?ZQPF   = ?ZQPI+2               ; Flags
.DUSR   ?ZQPA   = ?ZQPF+1               ; Argument 1
.DUSR   ?ZQPB   = ?ZQPA+1               ; Argument 2
.DUSR   ?ZQPC   = ?ZQPB+1               ; Argument 3
.DUSR   ?ZQPN   = ?ZQPC+1               ; Available info blocks
.DUSR   ?ZQPU   = ?ZQPN+1               ; Return info blocks
.DUSR   ?ZQPP   = ?ZQPU+1               ; W( info blocks )

.DUSR   ?ZQPL   = ?ZQPP+2               ; Qpriority subpkt length

;     Info block field definitions

.DUSR   ?ZQPS   = 0                     ; Stream #
.DUSR   ?ZQPH   = ?ZQPS+1               ; High priority
.DUSR   ?ZQPO   = ?ZQPH+1               ; Low priority

.DUSR   ?ZQPX   = ?ZQPO+1               ; Length one info block

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, QPRIORITY function, ?ZBPF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZS0   =  0.                   ; (input bit)
.DUSR   ?ZYS0   =  1B(?ZZS0)            ; bit mask
;    All default batch input streams.

.DUSR   ?ZZS1   =  1.                   ; (input bit)
.DUSR   ?ZYS1   =  1B(?ZZS1)            ; bit mask
;    Set information.

.DUSR   ?ZJS1   =  0B(?ZZS1)            ; bit mask
;    Display information.

;----------------------------------------------------------------------
;             ?OPEX,  SILENCE,  function code = ?ZSI
;----------------------------------------------------------------------

.DUSR   ?ZSII   = 0                     ; Subpkt Id
.DUSR   ?ZSIF   = ?ZSII+2               ; Flags
.DUSR   ?ZSIS   = ?ZSIF+1               ; Stream #

.DUSR   ?ZSIL   = ?ZSIS+1               ; Silence subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Silence function, ?ZBIF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZT0   =  0.                   ; (input bit)
.DUSR   ?ZYT0   =  1B(?ZZT0)            ; bit mask
;    Silence all default batch input streams.


;----------------------------------------------------------------------
;             ?OPEX,  START,  function code = ?ZSR
;----------------------------------------------------------------------

.DUSR   ?ZSRI   = 0                     ; Subpkt Id
.DUSR   ?ZSRF   = ?ZSRI+2               ; Flags
.DUSR   ?ZSRS   = ?ZSRF+1               ; # of streams
.DUSR   ?ZSRQ   = ?ZSRS+1               ; B(queuename)
.DUSR   ?ZSR3   = ?ZSRQ+2               ; queuename buf size
.DUSR   ?ZSR4   = ?ZSR3+1               ; coop buf size
.DUSR   ?ZSRC   = ?ZSR4+1               ; B(coop)
.DUSR   ?ZSRB   = ?ZSRC+2               ; B(filename)
.DUSR   ?ZSR5   = ?ZSRB+2               ; filename buf size
.DUSR   ?ZSR6   = ?ZSR5+1               ; mapper buf size
.DUSR   ?ZSRM   = ?ZSR6+1               ; B(mapper filename)
.DUSR   ?ZSRX   = ?ZSRM+2               ; B(reserved)
.DUSR   ?ZSR7   = ?ZSRX+2               ; reserved buf size
.DUSR   ?ZSRR   = ?ZSR7+1               ; reserved

.DUSR   ?ZSRL   = ?ZSRR+1               ; Start subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Start function, ?ZSRF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZU0   =  0.           ; (input bit)
.DUSR   ?ZYU0   =  1B(?ZZU0)    ; bit mask
;   New line switch.

.DUSR   ?ZZU1   =  1.           ; (input bit)
.DUSR   ?ZYU1   =  1B(?ZZU1)    ; bit mask
;   8 bit switch.

.DUSR   ?ZZU2   =  2.           ; (input bit)
.DUSR   ?ZYU2   =  1B(?ZZU2)    ; bit mask
;   Proc switch.

.DUSR   ?ZZU3   =  3.           ; (input bit)
.DUSR   ?ZYU3   =  1B(?ZZU3)    ; bit mask
;   Streams switch.

.DUSR   ?ZZU4   =  4.           ; (input bit)
.DUSR   ?ZYU4   =  1B(?ZZU4)    ; bit mask
;   name switch.

.DUSR   ?ZZU5   =  5.           ; (input bit)
.DUSR   ?ZYU5   =  1B(?ZZU5)    ; bit mask
;   Upper argument specified.

.DUSR   ?ZZU6   =  6.           ; (input bit)
.DUSR   ?ZYU6   =  1B(?ZZU6)    ; bit mask
;   Reserved switch.

.DUSR   ?ZZU7   =  7.           ; (input bit)
.DUSR   ?ZYU7   =  1B(?ZZU7)    ; bit mask
;   IPC switch.

.DUSR   ?ZZU8   =  8.           ; (input bit)
.DUSR   ?ZYU8   =  1B(?ZZU8)    ; bit mask
;   7-bit mode is enabled

;----------------------------------------------------------------------
;             ?OPEX,  STATUS,  function code = ?ZSS
;----------------------------------------------------------------------

.DUSR   ?ZSSI   = 0                     ; Subpkt Id
.DUSR   ?ZSSF   = ?ZSSI+2               ; Flags
.DUSR   ?ZSSR   = ?ZSSF+1               ; Reserved
.DUSR   ?ZSSS   = ?ZSSR+1               ; # of streams
.DUSR   ?ZSSB   = ?ZSSS+1               ; Bias factor
.DUSR   ?ZSSO   = ?ZSSB+1               ; Queue priority
.DUSR   ?ZSSN   = ?ZSSO+1               ; sequence #
.DUSR   ?ZSSK   = ?ZSSN+1               ; Get next key word 1
.DUSR   ?ZSX0   = ?ZSSK+2               ; Next key word 2
.DUSR   ?ZSSV   = ?ZSX0+2               ; CPU limit value
.DUSR   ?ZSSE   = ?ZSSV+1               ; User CPU limit
.DUSR   ?ZSSG   = ?ZSSE+1               ; current page
.DUSR   ?ZSSY   = ?ZSSG+1               ; # of copies left
.DUSR   ?ZSSX   = ?ZSSY+1               ; Priority
.DUSR   ?ZSSD   = ?ZSSX+1               ; PID number
.DUSR   ?ZSSU   = ?ZSSD+1               ; B(Username)
.DUSR   ?ZSS5   = ?ZSSU+2               ; Username buf size
.DUSR   ?ZSS6   = ?ZSS5+1               ; Username string length
.DUSR   ?ZSSP   = ?ZSS6+1               ; B(pathname)
.DUSR   ?ZSS7   = ?ZSSP+2               ; pathname buf size
.DUSR   ?ZSS8   = ?ZSS7+1               ; pathname string length
.DUSR   ?ZSSC   = ?ZSS8+1               ; B(cleanup filename)
.DUSR   ?ZSS9   = ?ZSSC+2               ; cleanup buf size
.DUSR   ?ZSS0   = ?ZSS9+1               ; claenup string length
.DUSR   ?ZSST   = ?ZSS0+1               ; B(font filename)
.DUSR   ?ZSSA   = ?ZSST+2               ; Font filename buf size
.DUSR   ?ZSSH   = ?ZSSA+1               ; Font filename string length
.DUSR   ?ZSSM   = ?ZSSH+1               ; B(mapper filename)
.DUSR   ?ZSSJ   = ?ZSSM+2               ; Mapper buf size
.DUSR   ?ZSSZ   = ?ZSSJ+1               ; Mapper string length

.DUSR   ?ZSSL   = ?ZSSZ+1               ; Status subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Status function, ?ZSSF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZV0   =  0.           ; (input bit)
.DUSR   ?ZYV0   =  1B(?ZZV0)    ; bit mask
;   Want status on all default batch input streams.

.DUSR   ?ZZV1   =  1.           ; (output bit)
.DUSR   ?ZYV1   =  1B(?ZZV1)    ; bit mask
;   Stream/device is active.
.DUSR   ?ZJV1   =  0B(?ZZV1)    ; bit mask
;   Stream/device is idle.

.DUSR   ?ZZV2   =  2.           ; (output bit)
.DUSR   ?ZYV2   =  1B(?ZZV2)    ; bit mask
;   Process type is swappable.

.DUSR   ?ZZV3   =  3.           ; (output bit)
.DUSR   ?ZYV3   =  1B(?ZZV3)    ; bit mask
;   Process type is preemptable.

.DUSR   ?ZZV4   =  4.           ; (output bit)
.DUSR   ?ZYV4   =  1B(?ZZV4)    ; bit mask
;   Process type is resident.

.DUSR   ?ZZV5   =  5.           ; (output bit)
.DUSR   ?ZYV5   =  1B(?ZZV5)    ; bit mask
;   8-bit print mode.
.DUSR   ?ZJV5   =  0B(?ZZV5)    ; bit mask
;   7-bit print mode.

.DUSR   ?ZZV6   =  6.           ; (output bit)
.DUSR   ?ZYV6   =  1B(?ZZV6)    ; bit mask
;   Stream/device is ready.

.DUSR   ?ZJV6   =  0B(?ZZV6)    ; bit mask
 ;  Stream/device is not ready.

.DUSR   ?ZZV7   =  7.           ; (output bit)
.DUSR   ?ZYV7   =  1B(?ZZV7)    ; bit mask
;   Stream/device is paused. (note: if active bit is also set then
;   stream/device will be paused).

.DUSR   ?ZZV8   =  8.           ; (output bit)
.DUSR   ?ZYV8   =  1B(?ZZV8)    ; bit mask
;   Limiting is enabled.

.DUSR   ?ZZV9   =  9.           ; (output bit)
.DUSR   ?ZYV9   =  1B(?ZZV9)    ; bit mask
;   Device is being aligned.

.DUSR   ?ZZVA   =  10.          ; (output bit)
.DUSR   ?ZYVA   =  1B(?ZZVA)    ; bit mask
;   Batch job.

.DUSR   ?ZZVB   =  11.          ; (output bit)
.DUSR   ?ZYVB   =  1B(?ZZVB)    ; bit mask
;   Print or Plot device.

.DUSR   ?ZZVC   =  12.          ; (output bit)
.DUSR   ?ZYVC   =  1B(?ZZVC)    ; bit mask
;   Net coop.

.DUSR   ?ZZVD   =  13.          ; (output bit)
.DUSR   ?ZYVD   =  1B(?ZZVD)    ; bit mask
;   Net coop is ready.
.DUSR   ?ZJVD   =  0B(?ZZVD)    ; bit mask
;   Net coop is not ready.

.DUSR   ?ZZVE   =  14.          ; (output bit)
.DUSR   ?ZYVE   =  1B(?ZZVE)    ; bit mask
;   Net coop is active.
.DUSR   ?ZJVE   =  0B(?ZZVE)    ; bit mask
;   Net coop is idle.

;----------------------------------------------------------------------
;             ?OPEX,  STOP,  function code = ?ZST
;----------------------------------------------------------------------

.DUSR   ?ZSTI   = 0             ; Subpkt Id
.DUSR   ?ZSTF   = ?ZSTI+2       ; Flags
.DUSR   ?ZSTA   = ?ZSTF+1       ; Queuename buf size
.DUSR   ?ZSTB   = ?ZSTA+1       ; B(queuename)

.DUSR   ?ZSTL   = ?ZSTB+2       ; Stop subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Stop function, ?ZSTF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZW0   =  0.           ; (input bit)
.DUSR   ?ZYW0   =  1B(?ZZW0)    ; Bit mask
;    Queuename specified.

;----------------------------------------------------------------------
;             ?OPEX,  UNHOLD,  function code = ?ZUH
;----------------------------------------------------------------------

.DUSR   ?ZUHI   = 0             ; Subpkt Id
.DUSR   ?ZUHS   = ?ZUHI+2       ; Sequence #
.DUSR   ?ZUHR   = ?ZUHS+1       ; Reserved

.DUSR   ?ZUHL   = ?ZUHR+1       ; Unhold subpkt length

;----------------------------------------------------------------------
;             ?OPEX,  UNLIMIT,  function code = ?ZUL
;----------------------------------------------------------------------

.DUSR   ?ZULI   = 0             ; Subpkt Id
.DUSR   ?ZULF   = ?ZUHI+2       ; Flags
.DUSR   ?ZULS   = ?ZULF+1       ; Stream #

.DUSR   ?ZULL   = ?ZULS+1       ; Unlimit subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Unlimit function, ?ZULF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZX0   =  0.           ; (input bit)
.DUSR   ?ZYX0   =  1B(?ZZX0)    ; bit mask
;    Unlimit all default batch input streams.

;----------------------------------------------------------------------
;             ?OPEX,  UNSILENCE,  function code = ?ZUN
;----------------------------------------------------------------------

.DUSR   ?ZUNI   = 0             ; Subpkt Id
.DUSR   ?ZUNF   = ?ZUNI+2       ; Flags
.DUSR   ?ZUNS   = ?ZUNF+1       ; Stream #

.DUSR   ?ZUNL   = ?ZUNS+1       ; Unsilence subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Unsilence function, ?ZUNF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZY0   =  0.           ; (input bit)
.DUSR   ?ZYY0   =  1B(?ZZY0)    ; bit mask
;   Unsilence all default batch input streams.

;----------------------------------------------------------------------
;             ?OPEX,  VERBOSE,  function code = ?ZVE
;----------------------------------------------------------------------

.DUSR   ?ZVEI   = 0             ; Subpkt Id
.DUSR   ?ZVEF   = ?ZVEI+2       ; Flags
.DUSR   ?ZVES   = ?ZVEF+1       ; Stream #

.DUSR   ?ZVEL   = ?ZVES+1       ; Verbose subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Verbose function, ?ZVEF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZZ0   =  0.           ; (input bit)
.DUSR   ?ZYZ0   =  1B(?ZZZ0)    ; bit mask
;   Verbose on all default batch input streams.

;----------------------------------------------------------------------
;             ?OPEX,  XBIAS,  function code = ?ZXB
;----------------------------------------------------------------------

.DUSR   ?ZXBI   = 0             ; Subpkt Id
.DUSR   ?ZXBA   = ?ZXBI+2       ; Argument 1
.DUSR   ?ZXBB   = ?ZXBA+1       ; Argument 2

.DUSR   ?ZXBL   = ?ZXBB+1       ; Xbias subpkt length

;----------------------------------------------------------------------
;             ?OPEX,  DISMOUNTED,  function code = ?ZDS
;----------------------------------------------------------------------

.DUSR   ?ZDSI   = 0             ; Subpkt Id
.DUSR   ?ZDSF   = ?ZDSI+2       ; Flags
.DUSR   ?ZDSM   = ?ZDSF+1       ; Mount Id

.DUSR   ?ZDSL   = ?ZDSM+1       ; Dismounted subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, DISMOUNTED function, ?ZDSF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZ00   =  0.           ; (input bit)
.DUSR   ?ZY00   =  1B(?ZZ00)    ; bit mask
;    Default mount request.

;----------------------------------------------------------------------
;             ?OPEX,  MOUNTED,  function code = ?ZMO
;----------------------------------------------------------------------

.DUSR   ?ZMOI = 0               ; Subpkt Id
.DUSR   ?ZMOF = ?ZMOI+2         ; Flags
.DUSR   ?ZMOM = ?ZMOF+1         ; Mount Id
.DUSR   ?ZMOB = ?ZMOM+1         ; B(volid)
.DUSR   ?ZMOA = ?ZMOB+2         ; Volid buf size
.DUSR   ?ZMOR = ?ZMOA+1         ; Reserved

.DUSR   ?ZMOL = ?ZMOR+1         ; Mounted subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Mounted function, ?ZMOF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZ10   =  0.           ; (input bit)
.DUSR   ?ZY10   =  1B(?ZZ10)    ; bit mask
;    Default Mount ID

;----------------------------------------------------------------------
;             ?OPEX,  MOUNTSTATUS,  function code = ?ZMS
;----------------------------------------------------------------------

.DUSR   ?ZMSI   = 0             ; Subpkt Id
.DUSR   ?ZMSF   = ?ZMSI+2       ; Flags1
.DUSR   ?ZMSG   = ?ZMSF+1       ; Flags2
.DUSR   ?ZMSP   = ?ZMSG+1       ; Requester PID
.DUSR   ?ZMSE   = ?ZMSP+1       ; EXEC son PID
.DUSR   ?ZMSK   = ?ZMSE+1       ; Get next key, word 1
.DUSR   ?ZMSX   = ?ZMSK+2       ; Get next key, word 2
.DUSR   ?ZMSU   = ?ZMSX+2       ; B(username)
.DUSR   ?ZMS3   = ?ZMSU+2       ; Username buf size
.DUSR   ?ZMS4   = ?ZMS3+1       ; Username string length
.DUSR   ?ZMST   = ?ZMS4+1       ; B(text name buffer)
.DUSR   ?ZMS5   = ?ZMST+2       ; Text name buf size
.DUSR   ?ZMS6   = ?ZMS5+1       ; Text name string length
.DUSR   ?ZMSV   = ?ZMS6+1       ; B(volid)
.DUSR   ?ZMS7   = ?ZMSV+2       ; Volid buf size
.DUSR   ?ZMS8   = ?ZMS7+1       ; Volid string length
.DUSR   ?ZMSD   = ?ZMS8+1       ; B(devicename)
.DUSR   ?ZMS9   = ?ZMSD+2       ; Devicename buf size
.DUSR   ?ZMS0   = ?ZMS9+1       ; Devicename string length
.DUSR   ?ZMSS   = ?ZMS0+1       ; B(volid list)
.DUSR   ?ZMSA   = ?ZMSS+2       ; Volid list buf size
.DUSR   ?ZMSZ   = ?ZMSA+1       ; Volid list string length
.DUSR   ?ZMSM   = ?ZMSZ+1       ; Mount Id
.DUSR   ?ZMSR   = ?ZMSM+1       ; Mount error

.DUSR   ?ZMSL   = ?ZMSR+1       ; Mountstatus subpkt length

;----------------------------------------------------------------------
;  Bit and Bit mask definitions, Mountstatus function, ?ZMSF flags word 1
;----------------------------------------------------------------------

.DUSR   ?ZZ20   =  0.           ; (input bit)
.DUSR   ?ZY20   =  1B(?ZZ20)    ; bit mask
;   Want status of all  requests, inactive and active.

.DUSR   ?ZZ21   =  1.           ; (input bit)
.DUSR   ?ZY21   =  1B(?ZZ21)    ; bit mask
;   Want status by mount ID.

.DUSR   ?ZZ22   =  2.           ; (output bit)
.DUSR   ?ZJ22   =  0B(?ZZ22)    ; bit mask
;   Explicit labeled mount request.

.DUSR   ?ZY22   =  1B(?ZZ22)    ; bit mask
;   Implicit labeled mount request.

.DUSR   ?ZZ23   =  3.           ; (output bit)
.DUSR   ?ZY23   =  1B(?ZZ23)    ; bit mask
;   Unit mount request.

.DUSR   ?ZZ24   =  4.           ; (output bit)
.DUSR   ?ZY24   =  1B(?ZZ24)    ; bit mask
;   Waiting to be dismounted.

.DUSR   ?ZZ25   =  5.           ; (output bit)
.DUSR   ?ZY25   =  1B(?ZZ25)    ; bit mask
;   Next volume.

.DUSR   ?ZZ26   =  6.           ; (output bit)
.DUSR   ?ZY26   =  1B(?ZZ26)    ; bit mask
;   Mount error.

.DUSR   ?ZZ27   =  7.           ; (output bit)
.DUSR   ?ZY27   =  1B(?ZZ27)    ; bit mask
;   Specific volume.

.DUSR   ?ZZ28   =  8.           ; (output bit)
.DUSR   ?ZY28   =  1B(?ZZ28)    ; bit mask
;    Extend volid list.

.DUSR   ?ZZ29   =  9.           ; (output bit)
.DUSR   ?ZY29   =  1B(?ZZ29)    ; bit mask
;   Read only.

.DUSR   ?ZZ2A   =  10.          ; (output bit)
.DUSR   ?ZY2A   =  1B(?ZZ2A)    ; bit mask
;   IBM format.

;----------------------------------------------------------------------
; Bit and Bit mask definitions, Mountstatus function, ?ZMSG flags word 2
;----------------------------------------------------------------------


.DUSR   ?ZZ2G   = 0.         ; (output bit)
.DUSR   ?ZY2G   =  1B(?ZZ2G) ; bit mask
;   Density is 800 bpi.

.DUSR   ?ZZ2H   = 1.         ; (output bit)
.DUSR   ?ZY2H   =  1B(?ZZ2H) ; bit mask
;   Density is 1600 bpi.

.DUSR   ?ZZ2I   = 2.         ; (output bit)
.DUSR   ?ZY2I   =  1B(?ZZ2I) ; bit mask
;   Density is 6250 bpi.

.DUSR   ?ZZ2J   = 3.           ; (output bit)
.DUSR   ?ZY2J   =  1B(?ZZ2J) ; bit mask
;   Automatic density matching.

;----------------------------------------------------------------------
;             ?OPEX,  OPERATOR,  function code = ?ZOP
;----------------------------------------------------------------------

.DUSR   ?ZOPI   = 0             ; Subpkt Id
.DUSR   ?ZOPF   = ?ZOPI+2       ; Flags
.DUSR   ?ZOPR   = ?ZOPF+1       ; Reserved

.DUSR   ?ZOPL   = ?ZOPR+1       ; Operator subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Operator function, ?ZOPF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZ30 =  0.             ; (input bit)
.DUSR   ?ZJ30 =  0B(?ZZ30)      ; bit mask
;     There is no operator.

.DUSR   ?ZY30 =  1B(?ZZ30)      ; bit mask
;    There is an operator on duty.

;----------------------------------------------------------------------
;             ?OPEX,  Premount,  function code = ?ZPE
;----------------------------------------------------------------------

.DUSR   ?ZPEI = 0               ; Subpkt Id
.DUSR   ?ZPEF = ?ZPEI+2         ; Flags
.DUSR   ?ZPER = ?ZPEF+1         ; Reserved
.DUSR   ?ZPEU = ?ZPER+1         ; B(username)
.DUSR   ?ZPE3 = ?ZPEU+2         ; Username buf size
.DUSR   ?ZPE4 = ?ZPE3+1         ; Volid vuf size
.DUSR   ?ZPEV = ?ZPE4+1         ; B(volid)

.DUSR   ?ZPEL = ?ZPEV+2         ; Premount subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Premount function, ?ZPEF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZ40   = 0.            ; (input bit)
.DUSR   ?ZY40   =  1B(?ZZ40)    ; bit mask
;    IBM switch.


;----------------------------------------------------------------------
;             ?OPEX,  REFUSED,  function code = ?ZRF
;----------------------------------------------------------------------

.DUSR   ?ZRFI   = 0             ; Subpkt Id
.DUSR   ?ZRFF   = ?ZRFI+2       ; Flags
.DUSR   ?ZRFM   = ?ZRFF+1       ; Mount Id

.DUSR   ?ZRFL   = ?ZRFM+1       ; Refused subpkt length


;----------------------------------------------------------------------
