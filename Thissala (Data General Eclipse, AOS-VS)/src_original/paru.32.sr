;SYSLOG EVENT CODE      FUNCTION
;       ----------      --------
;       1.   - 37.      AOS/VS ADMINISTRATIVE
;       40.  - 899.     AOS/VS HARDWARE ERROR CODES
;       900. - 999.     AOS/VS SECURITY
;       1000.- 1023.    AOS/VS HARDWARE ERROR CODES
;       1024.- 1199.    DG USER (EXEC/CLI) ADMINISTRATIVE
;       1200.- 1299.    DG USER SECURITY EVENTS
;       1300.- 2047.    DG USER

.DUSR   ?LSMI=  0       ;SYSTEM LOWER LIMIT
.DUSR   ?LSMA=  1023.   ;SYSTEM UPPER LIMIT
.DUSR   ?LDMI=  1024.   ;DGC LOWER LIMIT
.DUSR   ?LDMA=  2047.   ;DGC UPPER LIMIT
.DUSR   ?LUMI=  2048.   ;USER LOWER LIMIT
.DUSR   ?LUMAX= 4096.   ;USER UPPER LIMIT

.DUSR   ?LHLT= 226      ;LENGTH OF THE LOGGING HEADER RECORD
.DUSR   ?LDLT= 20       ;LENGTH OF THE DETAILED RECORD



;       AOS/VS ADMINISTRATIVE CODES

.DUSR   ?LSTR=  1       ;START OF LOG FILE
.DUSR   ?LEND=  2       ;END OF LOG FILE
.DUSR   ?LACT=  3       ;RUN TIME INFORMATION
.DUSR   ?LDER=  4       ;DEVICE ERROR (MAG TAPE OR DISK)
.DUSR   ?LPAD=  5       ;PADDING (FILL FILE TO BLOCK BOUNDARY)
.DUSR   ?LERC=  6       ;ERCC (MEMORY ERROR CORRECTION)
.DUSR   ?LPFL=  7       ;POWER FAILURE
.DUSR   ?FSGF=  8.      ;SYSTEM/LOG REVISION
.DUSR   ?LCLK=  9.      ;CHANGE OF DAY/DATE
;          10 - 13      ;USED IN VSII
.DUSR   ?LSFT=  14.     ;SET EXCLUSION BIT MAP FOR LOGGING
.DUSR   ?LSUFT= 15.     ;SET SUPERUSER EBM FOR SUPERUSER LOGGING
.DUSR   ?LSUL=  16.     ;CHANGE PRIVILEGED LOGGING
;              16. - 39 ; - RESERVED

;       HARDWARE ERROR EVENTS

.DUSR   ?LPRE=  50      ;POWER RESTORE
.DUSR   ?LPAN=  51      ;SYSTEM PANIC LOGGED BY ESD
.DUSR   ?LHNG=  52      ;SYSTEM HANG LOGGED BY ESD

; SCP EVENT CODES (IN GENERAL THESE ARE DEFINED BY HARDWARE)

.DUSR   ?LNSR=  53      ;NEXUS CLASS SOFT ERCC ERROR
.DUSR   ?LNHR=  54      ;NEXUS CLASS HARD ERCC ERROR
.DUSR   ?LNSN=  55      ;NEXUS CLASS SNIFF/IO HARD ERCC ERROR

; DO NOT CHANGE THE ORDER OF THE FOLLOWING

.DUSR   ?LRES=  111     ;SCP RESET DETECTED (110 + ACTUAL SCP COMMAND)
.DUSR   ?LREC=  ?LRES+1 ;SCP FUNCTION REQUEST ACKNOWLEDGE
.DUSR   ?LRQE=  ?LREC+1 ;HOST TO SCP FUNCTION REQUEST ERROR
.DUSR   ?LRBF=  ?LRQE+1 ;HOST-SCP RING BUFFER IS FULL
.DUSR   ?LBTO=  ?LRBF+1 ;SCP HAS BEEN TIMED OUT
.DUSR   ?LNFB=  ?LBTO+1 ;SCP INTERFACE DEGRADE= NO FREE BUFFERS
.DUSR   ?LUNC=  ?LNFB+1 ;UNKNOWN DIB CODE FROM SCP
.DUSR   ?LBNC=  ?LUNC+1 ;1ST WORD OF HOST-SCP BUFFER NOT CLEARED
.DUSR   ?LHPE=  ?LBNC+1 ;HOST REQUEST PARAMETER ERROR
.DUSR   ?LPEC=  ?LHPE   ;LAST PSEUDO ERROR CODE

.DUSR   ?LSPE=  140     ;SCP ERROR LOGGING ENABLED
.DUSR   ?LSPD=  141     ;SCP ERROR LOGGING DISABLED
.DUSR   ?LPHT=  142     ;PROCESSOR HALTED
.DUSR   ?LXBT=  143     ;SCP BOOT COMMAND HAS BEEN EXECUTED
.DUSR   ?LPWD=  144     ;POWER DOWN
.DUSR   ?LPWU=  145     ;POWER UP
.DUSR   ?LAIR=  146     ;AIR FLOW ALARM
.DUSR   ?LTEM=  147     ;OVER TEMPERATURE ALARM

.DUSR   ?LBBC=  150     ;BATTERY BACKUP COMPLETE
.DUSR   ?LHRC=  151     ;HOST HARD ERCC MEMORY ERROR
.DUSR   ?LSRC=  152     ;SOFT ERCC MEMORY ERROR
.DUSR   ?LMSE=  153     ;MICRO SEQUENCER PARITY ERROR
.DUSR   ?LCPE=  154     ;CACHE PARITY ERROR
.DUSR   ?LCBE=  155     ;CACHE TO BANK CONTROLLER PARITY ERROR
.DUSR   ?LIOC=  156     ;IOC BUS SOFT PARITY ERROR
.DUSR   ?LSBT=  157     ;S-BUS TIMEOUT

.DUSR   ?LSBP=  160     ;S-BUS PARITY ERROR
.DUSR   ?LOSE=  161     ;OPERATING SYSTEM ERROR
.DUSR   ?LLDE=  162     ;SCP ERROR LOG DISK ERROR
.DUSR   ?LPRF=  163     ;INFINITE PROTECTION FAULT
.DUSR   ?LPGF=  164     ;INFINITE PAGE FAULT
.DUSR   ?LICE=  165     ;INSTRUCTION CACHE ENABLED
.DUSR   ?LICD=  166     ;INSTRUCTION CACHE DISABLED
.DUSR   ?LSCE=  167     ;SYSTEM CACHE ENABLED

.DUSR   ?LSCD=  170     ;SYSTEM CACHE DISABLED
.DUSR   ?LATE=  172     ;ATU ENABLED
.DUSR   ?LATD=  173     ;ATU DISABLED
.DUSR   ?LIOP=  174     ;ILLEGAL IOP COMMAND
.DUSR   ?LXDT=  175     ;SCP EXECUTE DTOS CMD HAS BEEN EXECUTED
.DUSR   ?LDTE=  176     ;ERROR RETURN FROM DTOS
.DUSR   ?LXHT=  177     ;SCP HALT COMMAND HAS BEEN EXECUTED

.DUSR   ?LXCN=  200     ;SCP CONTINUE CMD HAS BEEN EXECUTED
.DUSR   ?LXST=  201     ;SCP START CMD HAS BEEN EXECUTED
.DUSR   ?LXIN=  202     ;SCP INIT CMD HAS BEEN EXECUTED
.DUSR   ?LRCD=  203     ;SOFT ERCC ERRORS DISABLED
.DUSR   ?LDTG=  204     ;GOOD RETURN FROM DTOS
.DUSR   ?LHIN=  205     ;HARD INTERRUPT FROM AN UNKNOWN SOURCE
.DUSR   ?LDTC=  206     ;DATE/TIME HAS BEEN CHANGED THROUGH SCP-CLI
.DUSR   ?LGOC=  207     ;GMT OFFSET HAS BEEN CHANGED THRU SCP-CLI
.DUSR   ?LMPR=  210     ;SCP DETECTED A MEMORY PARITY ERROR
