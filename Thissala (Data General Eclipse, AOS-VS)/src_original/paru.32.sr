.DUSR   ?ZLO5   = ?ZLO4+1       ; Console Error
.DUSR   ?ZLO6   = ?ZLO5+1       ; Logfile Error

.DUSR   ?ZLOL   = ?ZLO6+1       ; Logging subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Logging function, ?ZLOF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZ80   =  0.           ; (input bit)
.DUSR   ?ZY80   =  1B(?ZZ80)    ; bit mask
;    Return status. This is the default.

.DUSR   ?ZZ81   =  1.           ; (input bit)
.DUSR   ?ZY81   =  1B(?ZZ81)    ; bit mask
;    Start switch.

.DUSR   ?ZZ82   =  2.           ; (input bit)
.DUSR   ?ZY82   =  1B(?ZZ82)    ; bit mask
;    Max switch.

.DUSR   ?ZZ83   =  3.           ; (input bit)
.DUSR   ?ZY83   =  1B(?ZZ83)    ; bit mask
;    Stop switch.

.DUSR   ?ZZ84   =  4.          ; (input bit)
.DUSR   ?ZY84   =  1B(?ZZ84)   ; bit mask
;    Console switch.

.DUSR   ?ZZ85   =  5.          ;(input Bit)
.DUSR   ?ZY85   =  1B(?ZZ85)   ; bit mask
;    No console switch.

.DUSR   ?ZZ86   =  6.           ; (output bit)
.DUSR   ?ZY86   =  1B(?ZZ86)    ; bit mask
;    Start logging.


.DUSR   ?ZZ87   =  7.           ; (output bit)
.DUSR   ?ZY87   =  1B(?ZZ87)    ; bit mask
;    Stop logging.

;----------------------------------------------------------------------
;             ?OPEX,  PROMPTS,  function code = ?ZPR
;----------------------------------------------------------------------

.DUSR   ?ZPRI   = 0             ; Subpkt Id
.DUSR   ?ZPRF   = ?ZPRI+2       ; Flags
.DUSR   ?ZPRR   = ?ZPRF+1       ; Reserved

.DUSR   ?ZPRL   = ?ZPRR+1       ; Prompts subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Prompts function, ?ZPRF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZ90   =  0.           ; (input bit)
.DUSR   ?ZJ90   =  0B(?ZZ90)    ; bit mask
;    Prompts off.

.DUSR   ?ZY90   =  1B(?ZZ90)    ; bit mask
;    Prompts on.

;----------------------------------------------------------------------
;             ?OPEX,  ACCESS,  function code = ?ZAC
;----------------------------------------------------------------------

.DUSR   ?ZACI   = 0             ; Subpkt Id
.DUSR   ?ZACF   = ?ZACI+2       ; Flags
.DUSR   ?ZACR   = ?ZACF+1       ; Reserved
.DUSR   ?ZACA   = ?ZACR+1       ; B(access list)
.DUSR   ?ZAC3   = ?ZACA+2       ; Access list buf size
.DUSR   ?ZAC4   = ?ZAC3+1       ; Access list string length

.DUSR   ?ZACL   = ?ZAC4+1       ; Access subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Access function, ?ZACF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZ9G   =  0.           ; (input bit)
.DUSR   ?ZY9G   =  1B(?ZZ9G)    ; bit mask
;    Default specified.

.DUSR   ?ZZ9H   =  1.           ; (input bit)
.DUSR   ?ZY9H   =  1B(?ZZ9H)    ; bit mask
;    Kill option specified.

.DUSR   ?ZZ9I   =  2.           ; (input bit)
.DUSR   ?ZY9I   =  1B(?ZZ9I)    ; bit mask
;    Op specified  ACL.

;----------------------------------------------------------------------
;             ?OPEX,  AUTOKEY,  function code = ?ZAK
;----------------------------------------------------------------------

.DUSR   ?ZAKI   = 0             ; Subpkt Id
.DUSR   ?ZAKF   = ?ZAKI+2       ; Flags
.DUSR   ?ZAKA   = ?ZAKF+1       ; Argument one
.DUSR   ?ZAKB   = ?ZAKA+1       ; Argument two
.DUSR   ?ZAKR   = ?ZAKB+1       ; Reserved

.DUSR   ?ZAKL   = ?ZAKR+1       ; Autokey subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Autokey function, ?ZAKF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZAF =  0.             ; (input bit)
.DUSR   ?ZYAF =  1B(?ZZAF)      ; bit mask
;     User wants status on current autokey setting.
.DUSR   ?ZJAF =  0B(?ZZAF)      ; bit mask
;    User wants to set the autokey sequence

.DUSR   ?ZZAG =  1.             ; (input bit)
.DUSR   ?ZYAG =  1B(?ZZAG)      ; bit mask
;     User wants a 2 char autokey sequence.
.DUSR   ?ZJAG =  0B(?ZZAG)      ; bit mask
;    User wants a single char autokey sequence.

.DUSR   ?ZZAH =  2.             ; (input bit)
.DUSR   ?ZYAH =  1B(?ZZAH)      ; bit mask
;     Current autokey status is two characters.
.DUSR   ?ZJAH =  0B(?ZZAH)      ; bit mask
;    Current autokey status is single character.

;----------------------------------------------------------------------
;             ?OPEX,  REGISTER,  function code = ?ZRG
;----------------------------------------------------------------------

.DUSR   ?ZRGI   = 0             ; Subpkt Id
.DUSR   ?ZRGF   = ?ZRGI+2       ; Flags
.DUSR   ?ZRG3   = ?ZRGF+1       ; Queuename buffer size
.DUSR   ?ZRGQ   = ?ZRG3+1       ; BP(Queuename)

.DUSR   ?ZRGL   = ?ZRGQ+2       ; Autokey subpkt length

;----------------------------------------------------------------------
;    Bit and Bit mask definitions, Register Function, ?ZRGF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZBF =  0.             ; (input bit)
.DUSR   ?ZYBF =  1B(?ZZBF)      ; bit mask
;     If set, bp(queuename) buffer is passed in ?ZRGQ.

;----------------------------------------------------------------------
;             ?OPEX,  REGISTERSTATUS,  function code = ?ZRS
;----------------------------------------------------------------------

.DUSR   ?ZRSI   = 0             ; Subpkt Id
.DUSR   ?ZRSF   = ?ZRSI+2       ; Flags
.DUSR   ?ZRSR   = ?ZRSF+1       ; Error code
.DUSR   ?ZRSK   = ?ZRSR+1       ; Get next key
.DUSR   ?ZRS3   = ?ZRSK+2       ; Get next key2
.DUSR   ?ZRSQ   = ?ZRS3+2       ; BP(queuename buffer)
.DUSR   ?ZRSA   = ?ZRSQ+2       ; Available RQB size
.DUSR   ?ZRSB   = ?ZRSA+1       ; Returned RQB size

.DUSR   ?ZRSL   = ?ZRSB+1       ; Registerstatus subpkt length

;----------------------------------------------------------------------
;Bit mask definitions, Registerstatus Function, ?ZRSF flags word
;----------------------------------------------------------------------

.DUSR   ?ZZCF =  0.             ; (input bit)
.DUSR   ?ZYCF =  1B(?ZZCF)      ; bit mask
;     User wants status on all local queues.

;----------------------------------------------------------------------------
;            ?OPEX,  USER COMMAND     function code = ?ZUC
;----------------------------------------------------------------------------

.DUSR   ?ZUCI=    0             ; subpacket identifier
.DUSR   ?ZUCS=    ?ZUCI+2       ; stream number
.DUSR   ?ZUCN=    ?ZUCS+1       ; command buffer byte length
.DUSR   ?ZUCB=    ?ZUCN+1       ; byte address of command buffer
.DUSR   ?ZUCR=    ?ZUCB+2       ; byte address of response buffer
.DUSR   ?ZUCM=    ?ZUCR+2       ; response buffer byte length (maximum)
.DUSR   ?ZUCD=    ?ZUCM+1       ; response buffer data length (returned)

.DUSR   ?ZUCL=    ?ZUCD+1       ; user command subpacket length

;=======================================================================
;===             ?ASSOC - Associate two processes                    ===
;===                                                                 ===
;===              Packet Definition and Packet Identifier            ===
;=======================================================================

.DUSR   ?ASPKT  = 0                     ; PACKET IDENTIFIER
.DUSR   ?ASSUB  = ?ASPKT+2              ; SUBPACKET INDICATOR
.DUSR   ?ASVPID = ?ASSUB+2              ; 16 BIT VPID
.DUSR   ?ASRSV  = ?ASVPID+1             ; RESERVED
.DUSR   ?ASLTH  = ?ASRSV+1              ; LENGTH OF PACKET

;       ?ASSOC Packet ID

.DUSR   ?ASID   = (577*200000)+(0.*400)+0

;=======================================================================
;===             ?DISSOC - Disassociate two processes                ===
;===                                                                 ===
;===              Packet Definition and Packet Identifier            ===
;=======================================================================

.DUSR   ?DIPKT  = 0                     ; PACKET IDENTIFIER
.DUSR   ?DISUB  = ?DIPKT+2              ; SUBPACKET INDICATOR
.DUSR   ?DIVPID = ?DISUB+2              ; 16 BIT VPID
.DUSR   ?DIRSV  = ?DIVPID+1             ; RESERVED
.DUSR   ?DILTH  = ?DIRSV+1              ; LENGTH OF PACKET

;       ?DISSOC Packet ID

.DUSR   ?DIID   = (600*200000)+(0.*400)+0

;=======================================================================
;===             ?GUHPI - Get Unique Hardware Processor ID           ===
;===                                                                 ===
;===              Packet Definition and Packet Identifier            ===
;=======================================================================

.DUSR   ?GUHID  = 0                     ; PACKET IDENTIFIER
.DUSR   ?GUHFN  = ?GUHID+2              ; SUBPACKET INDICATOR
.DUSR   ?GUHFL  = ?GUHFN+1              ; Reserved must be zero (Flags)
.DUSR   ?GUHBP  = ?GUHFL+1              ; Bytepointer to ID buffer
.DUSR   ?GUHLN  = ?GUHBP+2              ; ID buf bytelength
.DUSR   ?GUHLR  = ?GUHLN+1              ; ID buf bytelength returned

.DUSR   ?GUHP0  = ?GUHLR+1              ; LENGTH OF PACKET

;       ?GUHPI Packet ID

.DUSR   ?GUID   = (601*200000)+(0.*400)+0


; Parameters for ?VTFCREATE and ?VTFMODIFY packets
; Packet revision and ID constants

.DUSR ?VINIREV= 450*65546.+1*256.+1
.DUSR ?VTFMREV= 454*65546.+1*256.+1
.DUSR ?VTFKREV= 451*65546.+1*256.+1

; ?FIDEF flag for connecting VTF to user interrupt

.DUSR ?VTF_IDEF= 4000000000

; Status messages returned from ?WTVERR

.DUSR ?VTFERIOVR= 1     ; I-level code overrun
.DUSR ?VTFERSOVR= 2     ; Signal mode overrun
.DUSR ?VTFHUNG=   3     ; VTF driver is hung

.DUSR  ?VTFONESHOT= 010000     ; One shot mode
.DUSR  ?VTFSAVE= 020000        ; Stack Pointer save mode in i-level mode
.DUSR  ?VTFMODSUS= 040000      ; Modify without suspension flag (?VTFMOD)
.DUSR  ?VTFINISUS= 0100000     ; Timer initially suspended

.DUSR  ?VMODILV= 0400          ; I-level mode
.DUSR  ?VMODSIG= 01000         ; Signal mode
.DUSR  ?VMODNUL= 00000         ; Null mode (no action)
.DUSR  ?VMODMSK= 01400         ; Mode bits mask

.DUSR  ?VERRIGN= 02000          ; Ignore Overrun
.DUSR  ?VERRNTR= 04000          ; Terminate after N overruns
.DUSR  ?VERRTRM= 06000         ; Terminate Immediately on overrun
.DUSR  ?VERRMSK= 06000         ; Error mode mask

.DUSR  ?VNMSK= 000377       ; Mask for stripping of overrun count value

; following block defines the function codes for the ?VTFUNC field

.DUSR ?VTFCRE=  1           ; Create function
.DUSR ?VTFMOD=  2           ; Modify function
.DUSR ?VTFMOW=  3           ; Modify without suspension function
.DUSR ?VTFSUD=  4           ; Suspend function
.DUSR ?VTFRST=  5           ; Restart function

; following block defines the values for the ?VTFUNIT field

.DUSR ?VTFUSEC=  1          ; Micro-seconds
.DUSR ?VTFSEC=   2          ; Seconds
.DUSR ?VTFTICK=  3          ; Physical ticks


.DUSR ?VTFREV= 0                ; packet revision and ID
.DUSR ?VTFID= ?VTFREV+2         ; VTF ID
.DUSR ?VTFSET= ?VTFID+2         ; timer setpoint
.DUSR ?VTFENTR= ?VTFSET+2       ; code entry address for i-level code
.DUSR ?VTFSYNC= ?VTFENTR+2      ; VTF ID of sync timer
.DUSR ?VTFCAS= ?VTFSYNC+2       ; VTF ID of cascade timer
.DUSR ?VTFSKEW= ?VTFCAS+2       ; initial skew factor
.DUSR ?VTFPRI= ?VTFSKEW+2       ; Timer priority
.DUSR ?VTFPID= ?VTFPRI+1      ; PID
.DUSR ?VTFTID= ?VTFPID+1        ; TID
.DUSR ?VTFMODE= ?VTFTID+1       ; mode word
.DUSR ?VTFUNIT= ?VTFMODE+1      ; time units
.DUSR ?VTFIMSK= ?VTFUNIT+1      ; interrupt mask
.DUSR ?VTFMPLN= ?VTFIMSK+1      ; packet length

;  The following are the parameters for the ?VTFKILL system call.
;  Note that packet offsets are the same as the first two in ?VTFCREATE
;  and are defined above


.DUSR ?VTFKLEN = ?VTFID+2       ; Length of kill packet

        .EOF                    ; END OF PARU.32.SR