[!EQUAL,([!UNE,2,[!PID]]ERROR[!END]%/%%-%),()]
  SEARCHLIST :UTIL :
  PUSH
  SUPERUSER ON
  [!NEQUAL,[!PATH :UTIL:DOWN_DGVIEW.CLI],]
     :UTIL:DOWN_DGVIEW
  [!END]
  [!NEQUAL,[!PATHNAME :UTIL:CEO_DIR:DOWN.CEO.CLI],]
    :UTIL:CEO_DIR:DOWN.CEO
  [!ELSE]
    [!NEQUAL,[!PATHNAME :UTIL:DOWN_POA.CLI],]
       :UTIL:DOWN_POA
    [!END]
  [!END]
[!nequal,[!pathname :util:down_teo.cli],]
	:util:down_teo
[!end]
  [!NEQUAL,[!PATHNAME :INFOS:INFOS_DOWN.CLI],]
    :INFOS:INFOS_DOWN
  [!END]
  [!NEQUAL,[!PATHNAME :DOWN.NETWORK.CLI],]
    :DOWN.NETWORK
  [!ELSE]
    [!NEQUAL,[!PATHNAME :NET:UTIL:DOWN.NETWORK.CLI],]
      :NET:UTIL:DOWN.NETWORK
    [!END]
  [!END]
[!ELSE]
  WRITE *ERROR*
  WRITE %0\% IS VALID WHEN INVOKED BY THE ROOT CLI
  WRITE REQUIRED ARGUMENTS: NONE
  WRITE OPTIONAL SWITCHES:,,NONE
[!END]
