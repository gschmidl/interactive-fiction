        .TITLE  AOS.P           ; PANIC CODE DEFINITIONS
                                ; MUST BE A 5 CHAR TITLE FOR XREF

;
;  SYSTEM FATAL ERROR CODES
;
;  DOCUMENTED DEC,1978  -- J.R. GILGIS
;

.DUSR   PNCSO=  1000            ; AOS/VS STACK FAULT
        .DUSR   P01XA=300       ; AOS/VS INTERRUPT STACK FAULT
        .DUSR   P01XB=301       ; AOS/VS SYSTEM STACK FAULT
        .DUSR   P01XC=302       ; AOS/VS ECLIPSE STACK FAULT
.DUSR   PNMDD=  2000            ; MASTER DEVICE DISK ERROR
                                ; OR TIMEOUT

; AOS/VS SPECIFIC CODES

        .DUSR   P02XA=300       ; "READSY" DISK READ ERROR

.DUSR   PNMDT=  3000            ; ***DOES NOT EXIST***
.DUSR   PNCUI=  4000            ; UNCLEARABLE/UNDEFINED INTERRUPT
        .DUSR   P04AA=1         ; 65K INTERRUPTS DEVICE CODE 0
        .DUSR   P04AB=2         ; UNCLEARABLE + UNDEFINED INTRUPT
        .DUSR   P04AC=3         ; CNTRL-FULL TIME OUT AND NOT CLEARABLE

.DUSR   PNSFS=  6000            ; FATAL FILE SYSTEM DATA BASE ERROR
