                                VALUE #1= ADDRESS OF BUFFER HEADER
                                VALUE #2= 177400
                                VALUE #3= "PTBL" ADDRESS

14111           BLKIN           ATTEMPTING TO WAIT ON A BUFFER WITH A NON-
                                EXCLUSIVE WAIT COUNT WHICH IS TOO HIGH (377)
                                OR TOO LOW (0).

                                VALUE # 3 = BUFFER HEADER ADDRESS

14112           RELD            RELD ON LOCKED BUFFER OR BUFFER WITH WAITERS,
                                OR
                RELF/M/B        BUFFER`S USE COUNT IS ZERO BUT IS LOCKED
                                OR HAS WAITERS.

                                VALUE # 3 = BUFFER HEADER ADDRESS

14113           RELD/F/B/M      THE BUFFER BEING RELEASED HAS MORE WAITERS
                                THAN USERS; EVERY WAITER SHOULD BE A USER.

                                VALUE # 3 = BUFFER HEADER ADDRESS

14114           DQBCN           A BUFFER BEING DEQUEUED FROM THE LRU IS
                                LOCKED OR HAS WAITERS.

                                VALUE # 3 = BUFFER HEADER ADDRESS


14115           LKBH            ANY OF THE FOLLOWING HAPPENED:
                                1. THERE ARE MORE WAITERS FOR A BUFFER THAN
                                   USERS. (EVERY WAITER SHOULD BE A USER.)
                                2. THE BUFFER WASN`T LOCKED UPON RETURNING
                                   FROM PEND.
                                3. THE EXCLUSIVE WAIT COUNT IS TOO LARGE (377)
                                   OR NEGATIVE.

                                VALUE # 3 = BUFFER HEADER ADDRESS


14116           ULKBH           A CALLER TO UNLOCK A BUFFER MUST HAVE EXCLU-
                                SIVE ACCESS TO THE BUFFER.

                                VALUE # 3 = BUFFER HEADER ADDRESS

14117           CLOSE           A BUFFER IS IN USE AT LAST CLOSE TIME

                                VALUE # 3 = BUFFER HEADER ADDRESS

14120           DSKIO           ATTEMPTING TO WAIT ON A LOCKED BUFFER
                                WHICH HAS AN INVALID NON-EXCLUSIVE
                                WAIT COUNT.

                                VALUE # 1 = INVALID COUNT
                                VALUE # 3 = BUFFER HEADER ADDRESS

14121           FLBFW/D         ATTEMPT TO DESTROY A BUFFER WITH OTHER
                                USERS OR A BUFFER WITH NO OTHER USERS
                                HAS I/O IN PROGRESS.

                                VALUE # 3 = BUFFER HEADER ADDRESS

