FTN4,L
      PROGRAM MMM(3,100),23 JULY 81
C
C ******* THIS IS THE MAIN PART OF THE PROGRAM THAT GIVES IT IT'S NAME,
C      DEFINES ALL THE COMMON AREA, HAS THE SUBROUTINES AND ACTS AS AN
C      INDEX TO THE SEGMENTS.
C
C *** DEFINE COMMON AND SET VARIABLES ***
C
      COMMON/MMBC/IWRD(9,9),IPR(5),IVRB(4,89),IRNM(8,56),IROM(99),
     1IRSN(4,17),IRES(17),IPRP(4,17),IDTN(4,11),IVEN(107),
     2IXT(360),ICLS(4,12),ITST(40),NAME(3),RND,NTAG(10),IWP(4)
      CALL RMPAR(IPR)
      RND=2.
C
C     IWRD  IS USED TO STORE THE WORDS INPUT BY THE PLAYER
C     IVRB  CONTAINS THE VERBS USED IN THE GAME
C     IPRP  CONTAINS THE PREPPOSTIONS USED IN THE GAME
C     IDTN  CONTAINS THE DIRECTIONS
C     IRNM  CONTAINS THE ROOMS NAMES
C     IROM  CONTAINS THE ROOM DATA, SUCH AS THE NUMBER AND LIGHT CONDITION
C     IRSN  CONTAINS THE INHABITANTS NAMES
C     IRES  CONTAINS THE INHABITANTS DATA, SUCH AS ROOM THEY ARE IN
C     IVEN  CONTAINS THE DATA ON THE ITEMS USED IN THE GAME
C     IXT   CONTAINS THE EXIT DATA SUCH AS ROOM TO ROOM AND DOOR CONDITION
C     ICLS  CONTAINS THE CLASSES OF PLAYERS
C     ITST  CONTAINS A VARIETY OF TESTING DATA SUCH AS TURN AND ROOM
C     NAME  CONTAINS THE NAME OF THE SEGMENT BEING CALLED
C     IPR   CONTAINS THE DATA FROM RMPAR
C     RND   CONTAINS A RANDOM NUMBER
C     NTAG  CONTAINS THE NAME OF THE PLAYER
C     IWP   CONTAINS THE NAME OF THE MURDER WEAPON
C
C ****** INDEX ******
C
C  -MMBC - PAGES 2 TO 7       BLOCK COMMON 
C
C  -MMRI - PAGES 8 TO 10      SUBROUTINE THAT DISPLAYS ITEMS
C
C  -MMRL - PAGE 11            SUBROUTINE THAT CHECKS FOR LIGHT
C
C  -MMSA-  PAGES A-1 TO A-5   INITIALIZATION SEGMENT
C
C  -MMSB-  PAGES B-1 TO B-11  READ, TIME AND TRAP CHECK SEGMENT
C
C  -MMSC-  PAGES C-1 TO C-12  GO TYPE VERBS SEGMENT
C
C      GO  CLIMB  ENTER  MAGIC WORDS  DIG  FOLLOW
C
C  -MMSD-  PAGES D-1 TO D-8   CLOSING COMMENTS FOR MMSC SEGMENT
C
C  -MMSE-  PAGES E-1 TO E-11  ROOM DESCRIPTIONS SEGMENT
C
C  -MMSF-  PAGES F-1 TO F-16  LOW NUMBERED VERBS SEGMENT
C
C      QUIT  STOP  SCORE  GET  TAKE  DROP  GIVE  LOOK  READ  FIND
C      LIST  LIGHT  TURN  HELP  OPEN  CLOSE  SNUFF  BLOW
C
C  -MMSG-  PAGES G-1 TO G-12  CLOSING COMMENTS FOR MMSF SEGMENT
C
C  -MMSH-  PAGES H-1 TO H-11  HIGH NUMBERED VERBS SEGMENT
C
C      EAT  RUB  BEAM  SWEEP  CALL  MOVE  ANSWER  FEED  DISPLAY  ATTACK
C      KILL  SUSPEND  RESTORE  DRINK  MYSTERY  QUESTION  LISTEN
C
C  -MMSI-  PAGES I-1 TO I-10  CLOSING COMMENTS FOR MMSH SEGMENT
C
C  -MMSJ-  PAGES J-1 TO J-7   ROOM FOR FUTURE VERBS SEGMENT
C
C      UNLOCK  LOCK  SHOOT  OIL  RECORD  BREAK  PLACE  SLEEP
C
C  -MMSK-  PAGES K-1 TO K-4   CLOSING COMMENTS FOR MMSJ SEGMENT
C
C  -MMSL-  PAGES L-1 TO L-6   DISPLAY SEGMENT FOR THE CREATOR
C
C ***   CALL SEGMENT MMSA FOR START OF GAME
C
      CALL EXEC(8,NAME)
      END
C                             MM-1  (LINE 80)
C 2-M
C
      BLOCK DATA MMBC
C
      INTEGER IVRB(4,89),ICLS(4,12),IRNM(8,56),IRSN(4,17),IPRP(4,17),
     1IDTN(4,11)
C
      COMPLEX CVRB(89),CCLS(12),CRNM(2,56),CRSN(17),CPRP(17),CDTN(11)
C
      EQUIVALENCE (CVRB,IVRB),(CCLS,ICLS),(CRNM,IRNM),(CRSN,IRSN),
     1(CPRP,IPRP),(CDTN,IDTN)
C
      COMMON/MMBC/IWRD(9,9),IPR(5),CVRB,CRNM,IROM(99),CRSN,IRES(17),
     1CPRP,CDTN,IVEN(107),
     2IXT(360),CCLS,ITST(40),NAME(3),RND,NTAG(10),IWP(4)
C
