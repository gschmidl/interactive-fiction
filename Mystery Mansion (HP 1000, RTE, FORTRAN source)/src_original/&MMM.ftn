C
      IF(IPR(3).EQ.24184)WRITE(LU,24184)(IWP(L),L=1,4)
24184 FORMAT(" YOU HEAR THE LADY TELLING THE MAID ABOUT A ",
     1"MURDER WITH THE "4A2)
C
C
C
      IF(LU.NE.IPR(1).OR.ITST(21).EQ.0)GOTO 9999
      LU=ITST(21)
      GOTO 999
 9999 NAME(2)=2HSB
      IF(IRIT.EQ.12040)NAME(2)=2HSC
      IF(IRIT.EQ.12040)IWRD(6,1)=25
      CALL EXEC(8,NAME)
C
C
      END
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-I-10  (LINE 8560)
C 1-J
      PROGRAM MMSJ(5)
C
C ******* SEGMENT J *******
C
      COMMON/MMBC/IWRD(9,9),IPR(5),IVRB(4,89),IRNM(8,56),IROM(99),
     1IRSN(4,17),IRES(17),IPRP(4,17),IDTN(4,11),IVEN(107),
     2IXT(360),ICLS(4,12),ITST(40),NAME(3),RND,NTAG(10)
C
      DIMENSION KEYM(9)
C
C ***** THIS SEGMENT IS CALLED BY SEGMENT B TO PERFORM THE FUNCTION
C       OF THE HIGHER NUMBERED VERBS USED. THIS SEGMENT NORMALLY
C       COMPLETES BY CALLING SEGMENT K TO WRITE AN APPROPRIATE MESSAGE.
C
C
C *** FUNCTIONS ***
C
C * FIRST & SECOND DIGITS, THIRD & FOURTH DIGITS, THIRD DIGIT,
C   FOURTH DIGIT AND RANDOM NUMBER
C
      IFSD(I)=I-(I/100)*100
      ITFD(I)=I/100-(I/10000)*100
      ITD(I)=I/100-(I/1000)*10
      IFD(I)=I/1000-(I/10000)*10
      RN(R)=R*7.7-INT(R*7.7)
C
C *** SET UP VARIABLES ***
C
      NAME(2)=2HSK
      LU=IPR(1)
      LX=ITST(21)
      IR=ITST(1)
      R=RND
C
C ***** INDEX OF VERB ROUTINES *****
C
C       ROUTINE               PAGE
C
C       UNLOCK AND LOCK      2
C
C       SHOOT                3
C
C       OIL                  4
C
C       RECORD               5
C
C       BREAK                6
C
C       PLACE                6
C
C       SLEEP                7
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-J-1  (LINE 8640)
C 2-J
C
C ***** SELECT THE RIGHT VERB ROUTINE *****
C
      GOTO(1000,1000,2000,3000,4000,5000,6000,7000)IWRD(6,1)-53
C
C ****** UNLOCK AND LOCK ROUTINE ******
C
C *** CHECK FORMAT ***
C
 1000 IF(IWRD(7,1).EQ.1)CALL EXEC(8,NAME,LU,1000)
      IF(IWRD(7,1).NE.2.OR.IWRD(5,2).NE.3)CALL EXEC(8,NAME,LU,1000)
C
C *** DOOR ***
C
      IF(IWRD(6,2).NE.92) GOTO 15100
      IF((IR.GT.27.AND.IR.NE.36.AND.IR.NE.54.AND.IR.NE.91.AND.IR.NE.
     190).OR.IR.EQ.3.OR.IR.EQ.4.OR.IR.EQ.13.OR.IR.EQ.16.OR.IR.EQ.21
     2.OR.IR.EQ.22)CALL EXEC(8,NAME,LU,2030)
      DO 15010 J=1,240
      IF(IFSD(IXT(J)) .NE. IR) GOTO 15010
      IF((J-1)/60+1 .NE. ITST(4)/1000) GOTO 15010
      IC=ITFD(IXT(J))
      IF(IC.EQ.4.OR.IC.EQ.13.OR.IC.EQ.22.OR.J.EQ.62.OR.J.EQ.70.OR.J
     1.EQ.133.OR.J.EQ.182.OR.J.EQ.190)CALL EXEC(8,NAME,LU,15030)
      IF(IXT(J) .LT. 10000) CALL EXEC(8,NAME,LU,15020)
      IF(((IXT(J) .LT. 20000) .AND. (IWRD(6,1) .EQ. 54)) .OR.
     1((IXT(J) .GT. 20000) .AND. (IWRD(6,1) .EQ. 55)))
     2CALL EXEC(8,NAME,LU,8020)
      IF(IVEN(46).LT.20000.AND.J.EQ.64)CALL EXEC(8,NAME,LU,15041)
      IF(IVEN(2) .LT. 20000.AND.J.NE.64) CALL EXEC(8,NAME,LU,15040)
      IF(IWRD(6,1) .EQ. 54) IXT(J)=IXT(J)-10000
      IF(IWRD(6,1) .EQ. 55) IXT(J)=IXT(J)+10000
      IF((J.LT.121).AND.(IWRD(6,1).EQ.54))IXT(J+120)=IXT(J+120)-10000
      IF((J.GT.120).AND.(IWRD(6,1).EQ.54))IXT(J-120)=IXT(J-120)-10000
      IF((J.LT.121).AND.(IWRD(6,1).EQ.55))IXT(J+120)=IXT(J+120)+10000
      IF((J.GT.120).AND.(IWRD(6,1).EQ.55))IXT(J-120)=IXT(J-120)+10000
      CALL EXEC(8,NAME,LU,1040)
15010 CONTINUE
      CALL EXEC(8,NAME,LU,15030)
C
C *** CHEST ***
C
15100 IF(IWRD(6,2).NE.54.AND.IWRD(6,2).NE.35) GOTO 15200
      IF(IVEN(35).LT.20000.AND.IVEN(35).NE.600+IR)CALL EXEC(8,NAME,
     1LU,8030)
C
C ** LOCK CHEST **
C
      IF(IWRD(6,1).EQ.55.AND.IFD(IVEN(35)).EQ.0)
     1CALL EXEC(8,NAME,LU,8020)
      IF(IWRD(6,1).EQ.55)CALL EXEC(8,NAME,LU,2010)
C
C ** UNLOCK CHEST **
C
      IF(IVEN(2).LT.20000)CALL EXEC(8,NAME,LU,15040)
      CALL EXEC(8,NAME,LU,15110)
C
15200 CONTINUE
C
15900 CALL EXEC(8,NAME,LU,8010)
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-J-2  (LINE 8720)
C 3-J
C
C ****** SHOOT ROUTINE ******
C
 2000 IF(IWRD(7,1).EQ.1)CALL EXEC(8,NAME,LU,1000)
      IF(IWRD(7,1).NE.2.OR.(IWRD(5,2).NE.4.AND.IWRD(5,2).NE.3).OR.
     1(IWRD(5,2).EQ.3.AND.IWRD(6,2).NE.54))CALL EXEC(8,NAME,LU,320)
C
C *** DOES HE HAVE A GUN ***
C
      IF (IVEN(9) .LT. 20000) CALL EXEC(8,NAME,LU,16010)
C
C *** IS IT LIGHT HERE ***
C
      CALL MMRL
C
C
C *** IS INHABITANT OR PADLOCK HERE ***
C
16019 IF(IFSD(IRES(IWRD(6,2))).NE.IR.AND.IWRD(5,2).NE.3)
     1CALL EXEC(8,NAME,LU,2030)
      IF(IWRD(5,2).EQ.3.AND.IFD(IVEN(35)).NE.0)CALL EXEC(8,NAME,LU,2030)
C
C *** DOES HE HAVE BULLETS ***
C
      IC=0
      IF(IVEN(20).GT.20000)IC=1
      IF(IWRD(6,2).EQ.10)GOTO 16020
      IF((ITST(11) .EQ. 0) .AND. (IVEN(20) .LT. 20000))
     1CALL EXEC(8,NAME,LU,16020)
      IF((ITST(11).EQ.0.OR.IWRD(6,2).EQ.10).AND.IVEN(20).GT.20000)
     1IVEN(20)=0
      IF(((ITST(11).GT.0).AND.(IWRD(6,2).NE.10)) .OR. ((IWRD(6,2)
     1.EQ.10).AND.(IVEN(20).LT.20000)))ITST(11)=ITST(11)-1
C
C *** MISS AND WOUND ROUTINE ***
C
      R=RN(R)
      IF(R .LT. .2) CALL EXEC(8,NAME,LU,16030)
      IF(R.LT..4.AND.IRES(IWRD(6,2))/1000.EQ.0)IRES(IWRD(6,2))=
     1IRES(IWRD(6,2))+5000
      IF(R.LT..4.AND.IRES(IWRD(6,2))/1000.EQ.0)
     1CALL EXEC(8,NAME,LU,16031)
C
C *** PADLOCK ***
C
      IF(IWRD(5,2).EQ.3)CALL EXEC(8,NAME,LU,16035)
C
C *** CAN INHABITANT BE KILLED ***
C
      IF((IWRD(6,2) .EQ. 1) .OR. (IWRD(6,2)
     1.EQ. 5) .OR. ((IWRD(6,2) .EQ. 10) .AND. (IC .EQ. 0))
     2.OR.(IRES(IWRD(6,2)).GT.10000)) CALL EXEC(8,NAME,LU,16040)
C
C *** DWARF ROUTINE ***
C
      IF(IWRD(6,2).EQ.13.AND.IR.NE.33) IRES(13)=533
      IF(IWRD(6,2).EQ.13.AND.IR.EQ.33) IRES(13)=534
      IF(IWRD(6,2).EQ.13)CALL EXEC(8,NAME,LU,16045)
C
C *** WEREWOLF ***
C
16020 IF(IWRD(6,2).EQ.10)IRES(ITST(39))=10000+IR
      IF(IWRD(6,2).EQ.10)ITST(2)=ITST(2)+75
C
C *** WARRIOR ***
C
      IF(IWRD(6,2).EQ.16.AND.R.LT..8.AND.IVEN(45).EQ.14416.AND.
     1IRES(16)/1000.LT.4)CALL EXEC(8,NAME,LU,16046)
C
C *** KILL INHABITANT ***
C
      IRES(IWRD(6,2))=10000+IR
      IF(IWRD(6,2).EQ.10)IRES(10)=0
      CALL EXEC(8,NAME,LU,16050)
C
C
C
C
C                            MM-J-3  (LINE 8800)
C 4-J
C
C
C
C ****** OIL ROUTINE ******
C
C
C *** CHECK FORMAT ***
C
 3000 IF((IWRD(7,1).NE.2).OR.(IWRD(5,2).NE.3))CALL EXEC(8,NAME,LU,320)
C
C *** IS IT LIGHT ***
C
      CALL MMRL
C
C *** DOES HE HAVE THE OILCAN ***
C
      IF(IVEN(33) .LT. 20000) CALL EXEC(8,NAME,LU,20010)
C
C *** DOES CAN HAVE OIL ***
C
      IF(IVEN(33) .GT. 22000) CALL EXEC(8,NAME,LU,20020)
C
C *** DOES HE HAVE ITEM ***
C
      IF((IWRD(6,2) .LT. 54) .AND. (IVEN(IWRD(6,2)) .LT. 20000))
     1CALL EXEC(8,NAME,LU,3010)
C
C *** IS HE NEAR IT ***
C
      IF((IWRD(6,2) .GT. 47) .AND. (IFSD(IVEN(IWRD(6,2))) .NE. IR)
     1.AND. (IFSD(IVEN(IWRD(6,2))) .NE. 0)) CALL EXEC(8,NAME,LU,2030)
      IF((IWRD(6,2) .GT. 45) .AND. (IWRD(6,2) .LT. 51))
     1CALL EXEC(8,NAME,LU,20030)
      IF((IWRD(6,2) .EQ. 91) .AND. (IROM(IR) .LT. 10000))
     1CALL EXEC(8,NAME,LU,2030)
      IF((IWRD(6,2) .EQ. 92) .OR. (IWRD(6,2) .EQ. 93))
     1 CALL EXEC(8,NAME,LU,8020)
C
C * HINGE *
C
      IF((IWRD(6,2) .EQ. 74) .AND. (IR .EQ. 85)) IXT(322)=9185
      IF((IWRD(6,2) .EQ. 74) .AND. (IR .EQ. 86)) IXT(322)=8586
C
      IVEN(74)=IVEN(74)+1000
      CALL EXEC(8,NAME,LU,1040)
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-J-4  (LINE 8880)
C 5-J
C  ****** RECORD ROUTINE ******
C
 4000 IF(IWRD(7,1).GT.1)GOTO 21200
      WRITE(LU,21010)
21010 FORMAT(/" ENSURE UNIT IS READY TO RECORD AND ENTER THE LU #: _")
      READ(LU,*)IANS
      IF(LX.NE.0)WRITE(LX,21011)IANS
21011 FORMAT(/" ENSURE UNIT IS READY TO RECORD AND ENTER THE LU #: "I3)
      ITST(21)=IANS
      CALL EXEC(8,NAME,LU,21020)
C
C *** KEY ***
C
21200 IF(IWRD(7,1).EQ.3.AND.IWRD(5,2).EQ.5.AND.(IWRD(6,2).EQ.7.OR.
     1IWRD(6,2).EQ.2).AND.IWRD(6,3).EQ.105)GOTO 22000
      IF(IWRD(7,1).EQ.3.AND.IWRD(5,2).EQ.5.AND.IWRD(6,2).EQ.2.AND.
     1IWRD(6,3).EQ.104)ITST(21)=6
      IF(IWRD(7,1).EQ.3.AND.IWRD(5,2).EQ.5.AND.IWRD(6,2).EQ.2.AND.
     1IWRD(6,3).EQ.104)CALL EXEC(8,NAME,LU,21020)
      IF(IWRD(7,1).NE.2.OR.IWRD(5,2).NE.3.OR.(IWRD(6,2).NE.2.AND.
     1IWRD(6,2).NE.46))CALL EXEC(8,NAME,LU,320)
21205 WRITE(LU,21210)
21210 FORMAT(/" JENTER 0 TO END, 9 TO CLEAR OR KEY # AND MESSAGE_")
      READ(LU,21220)IANS,KEYM
21220 FORMAT(10A2)
      IANS=IANS/256-60B
      IF(IANS.EQ.0)CALL EXEC(8,NAME,LU,1040)
      IF(IANS.EQ.9)GOTO 21260
      IF(IANS.LT.1.OR.IANS.GT.8)GOTO 21205
      WRITE(LU,21230)
21230 FORMAT("hmh_")
      DO 21245 J=1,8
      IF(J.NE.IANS)WRITE(LU,21236)
21236 FORMAT("CCCCCCCCCCCCCCCCCCCC_")
      IF(IANS.EQ.J.AND.J.LT.4)WRITE(LU,21240)KEYM
21240 FORMAT("&dF ",9A2,"&d@ ")
      IF(IANS.EQ.J.AND.J.GT.4.AND.J.LT.8)WRITE(LU,21241)KEYM
21241 FORMAT("&dB ",9A2,"&d@ ")
      IF(IANS.EQ.J.AND.J.EQ.4)WRITE(LU,21242)KEYM
21242 FORMAT("&dF ",9A2,"&d@")
      IF(IANS.EQ.J.AND.J.EQ.8)WRITE(LU,21243)KEYM
21243 FORMAT("&dB ",9A2,"&d@")
21245 CONTINUE
      WRITE(LU,21250)
21250 FORMAT("Bl")
      IANX=2Ha0+IANS
      WRITE(LU,21251)IANX,KEYM
21251 FORMAT("&f2"A2"k18L"9A2)
      WRITE(LU,21252)
21252 FORMAT("hA")
      GOTO 21205
21260 WRITE(LU,21261)
21261 FORMAT("mhJ_")
      DO 21265 I=1,11
      IF(I.LT.5)WRITE(LU,21262)
      IF(I.GT.4.AND.I.LT.9)WRITE(LU,21263)
21262 FORMAT("&dF                   &d@ _")
21263 FORMAT("&dB                   &d@ _")
      IF(I.GT.8)WRITE(LU,21264)
21264 FORMAT("                    _")
21265 CONTINUE
      WRITE(LU,21266)
21266 FORMAT("                   ")
      DO 21268 I=1,8
      IANX=2Ha0+I
      IANY=2Ho+I
      WRITE(LU,21267)IANX,IANY
21267 FORMAT("&f2"A2"k 2L"A2)
21268 CONTINUE
      GOTO 21205
C
C
C
C
C
C
C
C
C                            MM-J-5  (LINE 8960)
C 6-J
C
C *** CASSETTE RECORD ***
C
22000 WRITE(LU,22010)
22010 FORMAT(/" ENTER 0 TO ABORT OR LU OF TAPE UNIT."//"?_")
      READ(LU,*)LA
      IF(IWRD(6,2).EQ.7)ITST(36)=LA
      IF(IWRD(6,2).EQ.7)ITST(37)=0
      IF(IWRD(6,2).EQ.2)ITST(37)=LA
      IF(IWRD(6,2).EQ.2)ITST(36)=0
      CALL EXEC(8,NAME,LU,1040)
C
C
C ****** BREAK ROUTINE ******
C
 5000 IF(IWRD(7,1).NE.2.OR.IWRD(5,2).NE.3.OR.IWRD(6,2).NE.54)
     1CALL EXEC(8,NAME,LU,320)
C
C *** IS IT LIGHT ***
C
      CALL MMRL
C
C *** IS IT ALREADY BROKEN ***
C
      IF(IFD(IVEN(35)).EQ.1)CALL EXEC(8,NAME,LU,8020)
C
C *** ARE CONDITIONS RIGHT ***
C
      IF(IFSD(IVEN(35)).NE.IR.OR.IVEN(35).GT.10000)
     1CALL EXEC(8,NAME,LU,22010)
C
      IF(IVEN(11).LT.20000.AND.IVEN(12).LT.20000.AND.IVEN(14).LT.
     120000.AND.IVEN(32).LT.20000.AND.IVEN(34).LT.20000)
     2CALL EXEC(8,NAME,LU,22020)
      CALL EXEC(8,NAME,LU,16035)
C
C ******* PLACE ROUTINE *******
C
 6000 IF(IWRD(7,1).NE.4.OR.IWRD(5,2).NE.3.OR.IWRD(5,3).NE.5.OR.
     1IWRD(5,4).NE.3)CALL EXEC(8,NAME,LU,320)
C
C *** AMULET ***
C
      IF(IWRD(6,2).NE.17.OR.IWRD(6,3).NE.1.OR.IWRD(6,4).NE.66)GOTO 6100
      IF(IVEN(17).LT.20000)CALL EXEC(8,NAME,LU,3010)
      IF(IR.NE.41)CALL EXEC(8,NAME,LU,6010)
      IVEN(17)=1141
      CALL EXEC(8,NAME,LU,6020)
C
C *** KEY ***
C
 6100 IF(IWRD(6,2).NE.46.OR.IWRD(6,3).NE.2.OR.IWRD(6,4).NE.85)GOTO 6200
      IF(IVEN(46).LT.20000)CALL EXEC(8,NAME,LU,3010)
      IF(IR.NE.1)CALL EXEC(8,NAME,LU,6010)
      IVEN(46)=1101
      CALL EXEC(8,NAME,LU,1040)
C
C *** CROSS ***
C
 6200 IF(IWRD(6,2).NE.5.OR.IWRD(6,3).NE.2.OR.IWRD(6,4).NE.77)GOTO 6300
      IF(IVEN(5).LT.20000)CALL EXEC(8,NAME,LU,3010)
      IF(IR.NE.16)CALL EXEC(8,NAME,LU,6010)
      IVEN(5)=1316
      CALL EXEC(8,NAME,LU,1040)
C
C *** LANTERN ***
C
 6300 IF(IWRD(6,2).NE.4.OR.IWRD(6,3).NE.2.OR.IWRD(6,4).NE.85)GOTO 6900
      IF(IVEN(4).LT.20000)CALL EXEC(8,NAME,LU,3010)
      IF(IR.NE.93)CALL EXEC(8,NAME,LU,6010)
      IF(IFD(IVEN(4)).EQ.1)IVEN(4)=1493
      IF(IFD(IVEN(4)).NE.1)IVEN(4)=493
      CALL EXEC(8,NAME,LU,1040)
C
 6900 CALL EXEC(8,NAME,LU,320)
C
C
C
C                            MM-J-6  (LINE 9040)
C 7-J
C
C ****** SLEEP ROUTINE ******
C
 7000 IF(IWRD(7,1).EQ.1)GOTO 7500
C
C **** WITH SOMEONE ****
C
      IF(IWRD(7,1).NE.3.OR.IWRD(5,2).NE.5.OR.IWRD(6,2).NE.13.OR.
     1IWRD(5,3).NE.4)CALL EXEC(8,NAME,LU,320)
C
C *** IS THE INHABITANT HERE ***
C
      IF(IFSD(IRES(IWRD(6,3))).NE.IR)CALLEXEC(8,NAME,LU,8031)
C
C *** IS IT PERVERTED ***
C
      IF(IWRD(6,3).EQ.1.OR.IWRD(6,3).EQ.15.OR.IWRD(6,3).EQ.4)
     1CALL EXEC(8,NAME,LU,7010)
C
C *** IS IT THE RIGHT PLACE ***
C
      IF(IR.NE.1.AND.IR.NE.20.AND.IR.NE.24.AND.IR.NE.25)
     1CALL EXEC(8,NAME,LU,7020)
C
C *** IS THE INHABITANT IN THE MOOD ***
C
      IF(ITST(32).NE.1.OR.(IR.EQ.1.AND.IXT(61).LT.20000).OR.
     1(IR.EQ.20.AND.(IXT(12).LT.20000.OR.IROM(20).GT.20000)).OR.
     2(IR.EQ.25.AND.(IXT(73).LT.20000.OR.IROM(25).GT.20000)).OR.
     3IR.EQ.24)CALL EXEC(8,NAME,LU,7030)
      DO 7035 I=1,53
      IF(IVEN(I).GE.20000)CALL EXEC(8,NAME,LU,7030)
 7035 CONTINUE
      DO 7050 I=1,17
      IF(IFSD(IRES(I)).EQ.IR.AND.IWRD(6,3).NE.I)
     1CALL EXEC(8,NAME,LU,7030)
 7050 CONTINUE
C
C *** DO IT ***
C
      IF(IWRD(6,3).EQ.3.OR.IWRD(6,3).EQ.7.OR.IWRD(6,3).EQ.14)ITST(32)=2
      IF(IWRD(6,3).EQ.2.OR.IWRD(6,3).EQ.8.OR.IWRD(6,3).EQ.9)ITST(32)=3
      ITST(5)=ITST(5)+25
      CALL EXEC(8,NAME,LU,7040)
C
C **** BY SELF ****
C
C *** IS HE COMFORTABLE ***
C
 7500 IF (IR.NE.1.AND.IR.NE.10.AND.IR.NE.20.AND.IR.NE.24.AND.IR.
     1NE.25)CALL EXEC(8,NAME,LU,7510)
C
C *** IS SOMEONE NEARBY ***
C
      DO 7520 I=2,17
      IF(IFSD(IRES(I)).EQ.IR)CALL EXEC(8,NAME,LU,7530)
 7520 CONTINUE
C
C *** SLEEP ***
C
      ITST(5)=ITST(5)+25
      CALL EXEC(8,NAME,LU,7540)
C
C
C
C
C
C
C
C
C
C
      END
C
C
C
C
C
C                            MM-J-7  (LINE 9120)
C 1-K
      PROGRAM MMSK(5)
C
      COMMON/MMBC/IWRD(9,9),IPR(5),IVRB(4,89),IRNM(8,56),IROM(99),
     1IRSN(4,17),IRES(17),IPRP(4,17),IDTN(4,11),IVEN(107),
     2IXT(360),ICLS(4,12),ITST(40),NAME(3),RND,NTAG(10)
C
C ******* SEGMENT K *******
C
C  THIS PROGRAM WRITES A MESSAGE FOR SEGMENT MMSJ AND RETURNS TO
C  THE READ SEGMENT MMSB
C
C *** FUNCTIONS ***
C
      IFSD(I)=I-(I/100)*100
      ITFD(I)=I/100-(I/10000)*100
      ITD(I)=I/100-(I/1000)*10
      IFD(I)=I/1000-(I/10000)*10
C
      CALL RMPAR(IPR)
      LU=IPR(1)
      IRIT=IPR(2)
      IW63=IWRD(6,3)
C
C * SET DIRECTIONS *
C
      IFC=ITST(4)/1000
      IDN=1
      IDE=2
      IDS=3
      IDW=4
      IF(IVEN(6).LT.20000)IDN=10-IFC
      IF(IDN.EQ.6)IDN=10
      IF(IVEN(6).LT.20000)IDE=11-IFC
      IF(IVEN(6).LT.20000)IDS=12-IFC
      IF(IDS.EQ.11)IDS=7
      IF(IVEN(6).LT.20000)IDW=13-IFC
      IF(IDW.GT.10)IDW=IDW-4
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-K-1  (LINE 9200)
C 2-K
C *** CLOSING COMMENTS ***
C
  999 IF (IRIT .EQ. 320) WRITE(LU,320)
  320 FORMAT(/" I CANNOT FIGURE OUT WHAT YOU ARE TRYING TO SAY")
C
      IF (IRIT .EQ. 520) WRITE(LU,520)
  520 FORMAT(/" NOTHING HAPPENS")
C
      IF(IRIT.EQ.1000)WRITE(LU,1000)(IWRD(L,1),L=1,4)
 1000 FORMAT(/" I AM NOT A MIND READER, YOU WILL HAVE TO TELL ME ",
     1"WHAT TO "4A2)
C
      IF (IRIT .EQ. 1040) WRITE(LU,1040)
 1040 FORMAT(/" OKAY")
C
      IF(IRIT .EQ. 1065) WRITE(LU,1065) IPR(3)
 1065 FORMAT(/" PROGRAM ERROR AT LINE"I6)
C
      IF(IPR(3).EQ.7.OR.IPR(3).EQ.16.OR.IPR(3).EQ.25)IC=IDS
      IF(IPR(3).EQ.5.OR.IPR(3).EQ.14.OR.IPR(3).EQ.23)IC=IDW
      IF(IPR(3).EQ.1.OR.IPR(3).EQ.10.OR.IPR(3).EQ.19)IC=IDN
      IF(IRIT .EQ. 1095) WRITE(LU,1095)(IDTN(I,IC),I=1,4)
 1095 FORMAT(/" YOUR ACTION OPENED A PANEL INTO THE SECRET PASSAGE ",
     1"THAT YOU CAN"/" ENTER BY GOING "4A2)
C
      IF (IRIT .EQ. 2010) WRITE (LU,2010)(IWRD(L,1),L=1,2),
     1(IWRD(L,2),L=1,4)
 2010 FORMAT(/" YOU CANNOT "2A2" THE "4A2)
C
      IF (IRIT .EQ. 2020) WRITE(LU,2020)(IWRD(L,2),L=1,4)
 2020 FORMAT(/" YOU ALREADY HAVE THE "4A2)
C
      IF (IRIT .EQ. 2025) WRITE(LU,2025)(IWRD(L,4),L=1,4)
 2025 FORMAT(/"  IT IS NOT IN THE POSSESSION OF THE "4A2)
C
      IF (IRIT .EQ. 2030) WRITE(LU,2030)(IWRD(L,2),L=1,4)
 2030 FORMAT(/" I DON'T SEE THE "4A2)
C
      IF (IRIT .EQ. 3010) WRITE(LU,3010)(IWRD(L,2),L=1,4)
 3010 FORMAT(/" YOU DO NOT HAVE THE "4A2)
C
      IF (IRIT .EQ. 3110) WRITE(LU,3110)(IWRD(L,2),L=1,4)
 3110 FORMAT(/" YOU NO LONGER HAVE THE "4A2)
C
      IF (IRIT .EQ. 4010) WRITE(LU,4010)(IWRD(L,4),L=1,4)
 4010 FORMAT(/" FIRST YOU HAVE TO FIND THE "4A2)
C
      IF(IRIT.EQ.4050)WRITE(LU,4050)
 4050 FORMAT(/" THANKS. IT NEEDS THAT AROUND HERE.")
C
      IF (IRIT .EQ. 5020) WRITE(LU,5020)(IWRD(L,3),L=1,4)
 5020 FORMAT(/" I DO NOT SEE THE "4A2)
C
      IF(IRIT.EQ.6010)WRITE(LU,6010)
 6010 FORMAT(/" YOU MUST NOT BE PAYING ATTENTION.")
C
      IF(IRIT.EQ.6020)WRITE(LU,6020)
 6020 FORMAT(/" THE FLOOR UNDER YOU MOVED SLIGHTLY AS IF THE AMULET ",
     1"ACTIVATED SOMETHING.")
C
      IF(IRIT.EQ.7010)WRITE(LU,7010)
 7010 FORMAT(/" YOU MUST BE SOME KIND OF PERVERT.")
C
      IF(IRIT.EQ.7020)WRITE(LU,7020)(IWRD(L,3),L=1,4)
 7020 FORMAT(/" 'THIS IS NOT THE TIME OR PLACE.' SAYS THE "4A2)
C
      IF(IRIT.EQ.7030)WRITE(LU,7030)(IWRD(L,3),L=1,4)
 7030 FORMAT(/" 'NOT NOW. SOMETHING IS NOT RIGHT.' SAYS THE "4A2)
C
      IF(IRIT.EQ.7040)WRITE(LU,7040)(IWRD(L,3),L=1,4),(IWRD(L,3),L=1,4)
 7040 FORMAT(/" YOU FEEL YOURSELF GETTING AROUSED AS YOU WATCH ",
     1"A SEXY STRIP BY THE "4A2/" BEFORE PULLING YOU INTO BED. ",
     2"EAGERLY, YOU CARESS EACH OTHER AND ........."//" AN HOUR ",
     3"LATER, AFTER MANY SEXUAL DELIGHTS AND A NAP; YOU SEE THE "4A2/
     4" FINISH DRESSING, GIVING YOU A THANKFUL SMILE AS YOU WAKE UP.")
C
C
C
C                            MM-K-2  (LINE 9280)
C 3-K
C
      IF (IRIT .EQ. 7050) WRITE(LU,7050)
 7050 FORMAT(" NOTHING")
C
      IF(IRIT.EQ.7510)WRITE(LU,7510)
 7510 FORMAT(/" YOU CANNOT GET COMFORTABLE HERE.")
C
      IF(IRIT.EQ.7530)WRITE(LU,7530)
 7530 FORMAT(/" SOMEONE IN THE ROOM IS KEEPING YOU AWAKE.")
C
      IF(IRIT.EQ.7540)WRITE(LU,7540)
 7540 FORMAT(/" YOU SLEEP FOR AN HOUR AND WAKE-UP REFRESHED.")
C
      IF (IRIT .EQ. 8010 ) WRITE(LU,8010)
 8010 FORMAT(/" I DON'T KNOW WHAT YOU EXPECT TO HAPPEN")
C
      IF(IRIT .EQ. 8015) WRITE(LU,8015)(IWRD(L,2),L=1,4)
 8015 FORMAT(/" YOUR FOOD HAS BEEN EATEN BY THE "4A2)
C
      IF (IRIT .EQ. 8020) WRITE(LU,8020)
 8020 FORMAT(/" IT ALREADY IS")
C
      IF (IRIT .EQ. 8030) WRITE(LU,8030)(IWRD(L,2),L=1,4)
      IF (IRIT .EQ. 8031) WRITE(LU,8030)(IWRD(L,3),L=1,4)
 8030 FORMAT(/" I DON'T SEE THE "4A2)
C
      IF(IRIT .EQ. 15030) WRITE(LU,15030)
      IF(IRIT.EQ.15020)WRITE(LU,15020)
15020 FORMAT(/" THE DOOR YOU ARE FACING HAS NO LOCK")
C
15030 FORMAT(/" YOU ARE NOT FACING A DOOR")
C
      IF(IRIT .EQ. 15040) WRITE(LU,15040)
15040 FORMAT(/" YOU NEED A DOOR KEY")
C
      IF(IRIT.EQ.15041)WRITE(LU,15041)
15041 FORMAT(/" YOU NEED A DUNGEON KEY")
C
      IF(IRIT.EQ.15110)WRITE(LU,15110)
15110 FORMAT(/" YOUR KEY WILL NOT FIT THE PADLOCK")
C
      IF (IRIT .EQ. 16010) WRITE(LU,16010)
16010 FORMAT(/" YOU NEED A GUN TO SHOOT ANYONE")
C
      IF(IRIT .EQ. 16020) WRITE(LU,16020)
16020 FORMAT(/" YOUR GUN IS OUT OF BULLETS")
C
      IF(IRIT .EQ. 16030) WRITE(LU,16030)
16030 FORMAT(/" YOU MISSED")
C
      IF(IRIT.EQ.16031)WRITE(LU,16031)(IWRD(L,2),L=1,4)
16031 FORMAT(/" YOU WOUNDED THE "4A2)
C
      IF(IRIT.EQ.16035)WRITE(LU,16035)
16035 FORMAT(/" YOU JUST SMASHED THE PADLOCK TO PIECES")
      IF(IRIT.EQ.16035)IVEN(35)=IVEN(35)+1000
C
      IF(IRIT .EQ. 16040) WRITE(LU,16040)(IWRD(L,2),L=1,4)
16040 FORMAT(/" YOU JUST WASTED A SHOT. IT DID YOU NO GOOD TO SHOOT ",
     1"THE "4A2)
C
      IF(IRIT.EQ.16045)WRITE(LU,16045)
16045 FORMAT(/" YOU KILLED THE DWARF AND HE DISAPPEARED IN A CLOUD OF ",
     1"GREASY BLACK SMOKE")
C
      IF(IRIT.EQ.16046)WRITE(LU,16046)
16046 FORMAT(/" THE BULLET BOUNCED OFF THE WARRIOR'S SHIELD.")
      IF(IRIT.EQ.16045)IRES(13)=IRES(13)+100
C
      IF(IRIT .EQ. 16050) WRITE(LU,16050)(IWRD(L,2),L=1,4)
16050 FORMAT(/" YOU JUST SHOT AND KILLED THE "4A2)
C
      IF(IRIT .EQ. 20010) WRITE(LU,20010)
20010 FORMAT(/" YOU NEED AN OILCAN OR SOMETHING")
C
      IF(IRIT .EQ. 20020) WRITE(LU,20020)
20020 FORMAT(/" YOUR OILCAN IS EMPTY")
C
C                            MM-K-3  (LINE 9360)
C 4-K
C
      IF(IRIT .EQ. 20030) WRITE(LU,20030)
20030 FORMAT(/" DON'T BE SILLY")
C
      IF(IRIT.EQ.21020)WRITE(LU,21020)ITST(21)
21020 FORMAT(/" THIS LINE AND EVERY LINE WILL BE RECORDED ON LU #"I3,
     1" FOR THE REST OF THE GAME.")
C
      IF(IRIT.EQ.22010)WRITE(LU,22010)
22010 FORMAT(/" THE CHEST IS NOT WHERE YOU CAN BREAK THE PADLOCK")
C
      IF(IRIT.EQ.22020)WRITE(LU,22020)
22020 FORMAT(/" YOU DO NOT HAVE ANYTHING THAT WILL BREAK THE PADLOCK")
C
      IF(LU.NE.IPR(1).OR.ITST(21).EQ.0)GOTO 9999
      LU=ITST(21)
      GOTO 999
 9999 NAME(2)=2HSB
      CALL EXEC(8,NAME)
C
C
      END
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-K-4  (LINE 9440))
C 1-L
      PROGRAM MMSL(5)
C
C ******* SEGMENT L *******
C
C ***** THIS SEGMENT IS DESIGNED MOSTLY AS A DEBUG ROUTINE BUT CAN
C       OBVIOUSLY BE USED TO CHEAT.
C
C ****** DISPLAY IS ENTERED BY ENTERING YES XX, WHERE XX = 99-CODE #
C
      COMMON/MMBC/IWRD(9,9),IPR(5),IVRB(4,89),IRNM(8,56),IROM(99),
     1IRSN(4,17),IRES(17),IPRP(4,17),IDTN(4,11),IVEN(107),
     2IXT(360),ICLS(4,12),ITST(40),NAME(3),RND,NTAG(10)
C
      DIMENSION IDCB(144),NAMF(3),ITIM(5),IDTL(18,32),NAMT(3),
     1ICOM(64,30),IRM(8)
C
C *** FUNCTIONS ***
C
C * FIRST & SECOND, THIRD & FOURTH , THIRD AND FOURTH DIGITS
C
      IFSD(I)=I-(I/100)*100
      ITFD(I)=I/100-(I/10000)*100
      ITD(I)=I/100-(I/1000)*10
      IFD(I)=I/1000-(I/10000)*10
C
C *** SET UP VARIABLES ***
C
      NAME(2)=2HSB
      LU=IPR(1)
      LX=ITST(21)
      IR=ITST(1)
      DATA NAMT/2HMM,2HTL,2HDA/
      IF(ITST(25).EQ.-1)GOTO 9805
      ITST(25)=0
C
C ****** DISPLAY ROUTINE ******
C
      WRITE(LU,1000)
 1000 FORMAT("AAA ")
 9035 WRITE(LU,9040)
      IF(LX.NE.0)WRITE(LX,9040)
 9040 FORMAT(/" 0   DONE           1   ITEMS          2   ROOMS 1-33"/
     1" 3   ROOMS 34-66    4   ROOMS 67-99    5   EXITS NORTH"/
     2" 6   EXITS EAST     7   EXITS SOUTH    8   EXITS WEST "/
     3" 9   EXITS UP       10  EXITS DOWN     11  INHABITANTS"/
     4" 12  VERBS          13  TEST DATA      14  GAME DATA"/
     5" 15  ROOM DSCRPTN   16  WORDS          17  NOT USED")
      WRITE(LU,9041)
 9041 FORMAT(/" ENTER NUMBER FROM ABOVE: _")
      READ(LU,*) IANS
      IF(LX.NE.0)WRITE(LX,9042)IANS
 9042 FORMAT(/" ENTER NUMBER FROM ABOVE:"I3)
      IF(IANS.EQ.0)CALL EXEC(8,NAME)
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-L-1  (LINE 9520)
C 2-L
C
C ** INHABITANTS **
C
 9045 IF (IANS .NE. 11) GOTO 9080
      WRITE(LU,9050)
      IF(LX.NE.0)WRITE(LX,9050)
 9050 FORMAT(/ "  #  ",3"WHO      DATA  "/)
      DO 9070 J=1,5
      J1=3*J-2
      WRITE(LU,9060)J1,(IRSN(L,J1),L=1,4),IRES(J1),(IRSN(L,
     13*J-1),L=1,4),IRES(3*J-1),(IRSN(L,3*J),L=1,4),IRES(3*J)
      IF(LX.NE.0)WRITE(LX,9060)J1,(IRSN(L,J1),L=1,4),IRES(J1),(IRSN(L,
     13*J-1),L=1,4),IRES(3*J-1),(IRSN(L,3*J),L=1,4),IRES(3*J)
 9060 FORMAT(X,I2,2X,4A2,I5,2X,4A2,I5,2X,4A2,I5)
 9070 CONTINUE
      IX=16
      WRITE(LU,9071)IX,(IRSN(L,16),L=1,4),IRES(16),(IRSN(L,17),L=1,4),
     1IRES(17)
      IF(LX.NE.0)WRITE(LX,9071)IX,(IRSN(L,16),L=1,4),IRES(16),
     1(IRSN(L,17),L=1,4),IRES(17)
 9071 FORMAT(X,I2,2X,4A2,I5,2X,4A2,I5)
      WRITE(LU,9075)
      IF(LX.NE.0)WRITE(LX,9075)
 9075 FORMAT(/" ENTER 0 IF NO CHANGE OR INHABITANTS, NEW DATA"//" ?_")
      READ(LU,*) INH,NDAT
      IF(INH.EQ.0) GOTO 9035
      IRES(INH)=NDAT
C
C ** ITEMS **
C
 9080 IF (IANS .NE. 1) GOTO 9120
      WRITE(LU,9081)
 9081 FORMAT(/"  #  DATA  NAME"15X"DATA  NAME"15X"DATA  NAME"/)
      CALL MMRI(5,0)
      WRITE(LU,9115)
 9115 FORMAT(//" ENTER 0 IF NO CHANGE OR ITEM, NEW DATA"//"?_")
      READ(LU,*) ITM,NDAT
      IF (ITM.EQ.0) GOTO 9035
      IVEN(ITM)=NDAT
      GOTO 9080
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-L-2  (LINE 9600)
C 3-L
C
C ** ROOMS **
C
 9120 IF (IANS .GT. 4) GOTO 9250
      WRITE(LU,9130)
      IF(LX.NE.0)WRITE(LX,9130)
 9130 FORMAT(/"  #  "3"ROOM NAME          DATA  "/)
      DO 9150 J=11*(IANS-2)+1,11*(IANS-1)
      J1=3*J-2
      WRITE(LU,9140) J1,(IRNM(L,IROM(J1)-(IROM(J1)/100)*100),
     1L=1,8),IROM(3*J-2),(IRNM(L,IROM(3*J-1)-(IROM(3*J-1)/100)*100),
     2L=1,8),IROM(3*J-1),(IRNM(L,IROM(3*J)-(IROM(3*J)/100)*100),
     3L=1,8),IROM(3*J)
      IF(LX.NE.0)WRITE(LX,9140) J1,(IRNM(L,IROM(J1)-(IROM(J1)/100)*100
     1),L=1,8),IROM(3*J-2),(IRNM(L,IROM(3*J-1)-(IROM(3*J-1)/100)*100),
     2L=1,8),IROM(3*J-1),(IRNM(L,IROM(3*J)-(IROM(3*J)/100)*100),
     3L=1,8),IROM(3*J)
 9140 FORMAT(X,I2,2X,8A2,I7,2X,8A2,I7,2X,8A2,I7)
 9150 CONTINUE
      WRITE(LU,9160)
      IF(LX.NE.0)WRITE(LX,9160)
 9160 FORMAT(/" ENTER 0 IF NO CHANGE OR ROOM #, NEW DATA"//" ?_")
      READ(LU,*) IRMN,NDAT
      IF (IRMN.EQ.0) GOTO 9170
      IROM(IRMN)=NDAT
      GOTO 9120
 9170 WRITE(LU,9180)
      IF(LX.NE.0)WRITE(LX,9180)
 9180 FORMAT(/" DISPLAY ROOM EXITS?  ENTER ROOM #"//" ?_")
      READ(LU,*)IRMN
      IF(IRMN .EQ. 0) GOTO 9035
      WRITE(LU,9190) IRMN,(IRNM(L,IFSD(IROM(IRMN))),L=1,8)
      IF(LX.NE.0)WRITE(LX,9190) IRMN,(IRNM(L,IFSD(IROM(IRMN))),L=1,8)
 9190 FORMAT(/" EXITS FOR"I3,2X,8A2/)
      DO 9210 J=1,360
      IF(IXT(J)-(IXT(J)/100)*100 .EQ. IRMN) WRITE(LU,9200)(IDTN(L,
     1(J+59)/60),L=1,4),(IRNM(L,IROM(IXT(J)/100-(IXT(J)/10000)*100)-
     2(IROM(IXT(J)/100-(IXT(J)/10000)*100)/100)*100),
     3L=1,8),J,IXT(J)
      IF(IXT(J)-(IXT(J)/100)*100.EQ.IRMN.AND.LX.NE.0) WRITE(LX,9200)
     1(IDTN(L,(J+59)/60),L=1,4),(IRNM(L,IROM(IXT(J)/100-(IXT(J)/10000)
     2*100)-(IROM(IXT(J)/100-(IXT(J)/10000)*100)/100)*100),
     2L=1,8),J,IXT(J)
 9200 FORMAT(X,4A2" TO "8A2,I4,I7)
 9210 CONTINUE
      WRITE(LU,9220)
      IF(LX.NE.0)WRITE(LX,9220)
 9220 FORMAT(/" ENTRANCES"/)
      DO 9240 J=1,360
      IF(IXT(J)/100-(IXT(J)/10000)*100 .EQ. IRMN) WRITE(LU,9230)
     1(IDTN(L,(J+59)/60),L=1,4),(IRNM(L,IROM(IXT(J)-(IXT(J)/100)*
     2100)-(IROM(IXT(J)-(IXT(J)/100)*100)/100)*100),
     2L=1,8),J,IXT(J)
      IF(ITFD(IXT(J)).EQ.IRMN.AND.LX.NE.0) WRITE(LX,9230)
     1(IDTN(L,(J+59)/60),L=1,4),(IRNM(L,IROM(IXT(J)-(IXT(J)/100)*
     1100)-(IROM(IXT(J)-(IXT(J)/100)*100)/100)*100),
     2L=1,8),J,IXT(J)
 9230 FORMAT(X,4A2" FROM "8A2,I4,I7)
 9240 CONTINUE
      GOTO 9170
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-L-3  (LINE 9680)
C 4-L
C
C ** EXITS **
C
 9250 IF(IANS .GT. 10) GOTO 9310
      WRITE(LU,9260)(IDTN(L,IANS-4),L=1,4)
      IF(LX.NE.0)WRITE(LX,9260)(IDTN(L,IANS-4),L=1,4)
 9260 FORMAT(/" EXITS "4A2//" ROOM #  ",6"  EXIT   "/)
      DO 9280 J=1,10
      IC=(IANS-5)*60+6*J-5
      WRITE(LU,9270)IC,IXT(IC),IXT(IC+1),IXT(IC+2),
     1IXT(IC+3),IXT(IC+4),IXT(IC+5)
      IF(LX.NE.0)WRITE(LX,9270)IC,IXT(IC),IXT(IC+1),IXT(IC+2),
     1IXT(IC+3),IXT(IC+4),IXT(IC+5)
 9270 FORMAT(X,I3,2X,6I9)
 9280 CONTINUE
      WRITE(LU,9290)
 9290 FORMAT(/" ENTER 0 IF NO CHANGE OR EXIT #, NEW DATA "//" ?_")
      READ(LU,*) IXIT,NDAT
      IF(LX.NE.0)WRITE(LX,9291)IXIT,NDAT
 9291 FORMAT(/" ENTER 0 IF NO CHANGE OR EXIT #, NEW DATA "//" ?"I4","I6)
      IF (IXIT.EQ.0) GOTO 9035
      IXT(IXIT)=NDAT
      GOTO 9250
C
C ** VERBS **
C
 9310 IF (IANS .NE. 12) GOTO 9340
      WRITE(LU,9320)
      IF(LX.NE.0)WRITE(LX,9320)
 9320 FORMAT(/" VERBS:"/)
      DO 9335 J=1,18
      IC=5*J-4
      WRITE(LU,9330) IC,(IVRB(L,IC),L=1,4),(IVRB(L,5*J-3),L=1,4),
     1(IVRB(L,5*J-2),L=1,4),(IVRB(L,5*J-1),L=1,4),(IVRB(L,5*J),L=1,4)
      IF(LX.NE.0)WRITE(LX,9330)IC,(IVRB(L,IC),L=1,4),(IVRB(L,5*J-3)
     1,L=1,4),(IVRB(L,5*J-2),L=1,4),(IVRB(L,5*J-1),L=1,4),(IVRB(L,5*J)
     2,L=1,4)
 9330 FORMAT(X,I2,3X,4A2,3X,4A2,3X,4A2,3X,4A2,3X,4A2)
 9335 CONTINUE
      GOTO 9035
C
C ** TEST DATA **
C
 9340 IF (IANS .NE. 13) GOTO 9500
      WRITE(LU,9350) (ITST(L),L=1,10),RND,(ITST(L),L=11,20),(ITST(L),
     1L=21,30),(ITST(L),L=31,40)
      IF(LX.NE.0)WRITE(LX,9350) (ITST(L),L=1,10),RND,(ITST(L),L=11,20),
     1(ITST(L),L=21,30),(ITST(L),L=31,40)
 9350 FORMAT(/"    ROOM SCORE  POSS  FACE  TURN  BAT1  BAT2 MROOM  ",
     1"MWHO  MWEP   RND"//X,10I6,3X,F7.6//"  SHOTS  ICOR  ITNB  IRB  ",
     2"IREV  IBOOK IHWAY  RTIM  STIM  REVC"//X,10I6//"   IRLU IRESP  ",
     3"MYST  KILL  IDSP  ITND  ITNL ICODE  IDS1  IDS2"//X,10I6//"   ",
     4"HEAL  TIDE  DSET  DCHK DBUGR  IALU  IOLU   SYS  WERE"//X,10I6)
      WRITE(LU,9400)
 9400 FORMAT(/" ENTER 0 IF NO CHANGE OR TEST #, NEW DATA"//" ?_")
      READ(LU,*) ITS,NDAT
      IF(LX.NE.0)WRITE(LX,9401)ITS,NDAT
 9401 FORMAT(/" ENTER 0 IF NO CHANGE OR TEST #, NEW DATA"//" ?"I3","I6)
      IF(ITS.EQ.0) GOTO 9035
      ITST(ITS)=NDAT
      GOTO 9340
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-L-4  (LINE 9760))
C 5-L
C
C ** GAME DATA **
C
 9500 IF(IANS.NE.14)GOTO 9800
      IF(ITST(38).NE.2HMM)WRITE(LU,9505)
      IF(ITST(38).NE.2HMM)GOTO 9035
 9505 FORMAT(/"CARTRIDGE MM NOT SET UP.")
      CALL OPEN(IDCB,IERR,NAMT,0,-44,2HMM)
      IF(IERR.LT.0)GOTO 9530
      CALL READF(IDCB,IERR,IDTL,576)
      IF(IERR.LT.0)GOTO 9530
      CALL READF(IDCB,IERR,ICOM,1920)
      IF(IERR.LT.0)GOTO 9530
      CALL CLOSE(IDCB)
      WRITE(LU,9510)
 9510 FORMAT(/" LU? _")
      READ(LU,*)IANS
      IF(LX.NE.0)WRITE(LX,9501)IANS
 9501 FORMAT(/" LU?"I3)
      IF(IANS.EQ.0)GOTO 9035
      WRITE(IANS,9520)IDTL
 9520 FORMAT(//4X"MYSTERY MANSION DATA"//4X"DAY START  STOP  TURN",
     1" SCORE    OF  ROOM  CODE  NAME"//33(" "8I6,2X,10A2/))
      WRITE(IANS,9526)
 9526 FORMAT(/"  TAG   COMMENTS:"/)
      DO 9527 I=1,30
      IF(ICOM(1,I).EQ.2H  )GOTO 9529
 9527 WRITE(IANS,9528)(ICOM(J,I),J=1,37)
 9528 FORMAT(I6,2X,36A2)
 9529 IF(IANS.EQ.6.OR.IANS.EQ.15)WRITE(IANS,9525)
 9525 FORMAT("1"/"1")
      GOTO 9035
 9530 WRITE(LU,9540)IERR
      IF(LX.NE.0)WRITE(LX,9540)IERR
 9540 FORMAT(/" DISC ERROR"I6)
      CALL CLOSE(IDCB)
      GOTO 9035
C
C
C
C
C
C
C
C
