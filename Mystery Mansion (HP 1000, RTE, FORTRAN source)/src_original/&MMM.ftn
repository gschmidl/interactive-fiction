C
      IF(IRIT.EQ.16035)WRITE(LU,16035)
16035 FORMAT(/" YOU JUST SMASHED THE PADLOCK TO PIECES")
      IF(IRIT.EQ.16035)IVEN(35)=IVEN(35)+1000
C
      IF(IRIT .EQ. 16040) WRITE(LU,16040)(IWRD(L,2),L=1,4)
16040 FORMAT(/" YOU JUST WASTED A SHOT. IT DID YOU NO GOOD TO SHOOT ",
     1"THE "4A2)
      IF(IRIT.EQ.16045)WRITE(LU,16045)
16045 FORMAT(/" YOU KILLED THE DWARF AND HE DISAPPEARED IN A CLOUD OF ",
     1"GREASY BLACK SMOKE")
      IF(IRIT.EQ.16045)IRES(13)=IRES(13)+100
      IF(IRIT .EQ. 16050) WRITE(LU,16050)(IWRD(L,2),L=1,4)
16050 FORMAT(/" YOU JUST SHOT AND KILLED THE "4A2)
      IF(IRIT .EQ. 20030) WRITE(LU,20030)
20030 FORMAT(/" DON'T BE SILLY")
C
      IF(LU.NE.IPR(1).OR.ITST(21).EQ.0)GOTO 9999
      LU=ITST(21)
      GOTO 999
 9999 NAME(2)=2HSB
      CALL EXEC(8,NAME)
      END
C
C
C
C                            MM-G-12  (LINE 6880)
C 1-H
      PROGRAM MMSH(5)
C
C ******* SEGMENT H *******
C
C ******* THIS SEGMENT IS CALLED BY SEGMENT B TO PERFORM THE FUNCTION
C         OF THE MIDDLE NUMBER VERB USED. THIS SEGMENT NORMALLY
C         COMPLETES BY CALLING SEGMENT I TO WRITE AN APPRORIATE MESSAGE.
C
      COMMON/MMBC/IWRD(9,9),IPR(5),IVRB(4,89),IRNM(8,56),IROM(99),
     1IRSN(4,17),IRES(17),IPRP(4,17),IDTN(4,11),IVEN(107),
     2IXT(360),ICLS(4,12),ITST(40),NAME(3),RND,NTAG(10)
      DIMENSION IDCB(144),NAMF(3),ITIM(5),IDTL(8,16),NAMT(3),
     1ICOM(64,15),IVRBX(4,8),KEYM(9)
C
C *** FUNCTIONS ***
C
C * FIRST & SECOND DIGIT, THRID & FOURTH DIGIT, THIRD DIGIT AND FOURTH
C   DIGIT
C
      IFSD(I)=I-(I/100)*100
      ITFD(I)=I/100-(I/10000)*100
      ITD(I)=I/100-(I/1000)*10
      IFD(I)=I/1000-(I/10000)*10
      RN(R)=R*7.7-INT(R*7.7)
C
C *** SET UP VARIABLES ***
C
      NAME(2)=2HSI
      LU=IPR(1)
      LX=ITST(21)
      LA=ITST(36)
      LO=ITST(37)
      IR=ITST(1)
      DATA NAMT/2HMM,2HTL,2HDA/
      DATA KEYM/2H  ,2H  ,2H  ,2H  ,2H  ,2H  ,2H  ,2H  ,2H  /
      IW71=IWRD(7,1)
      IW52=IWRD(5,2)
      IW62=IWRD(6,2)
      R=RND
C
C ***** INDEX OF VERB ROUTINES *****
C
C       ROUTINE               PAGE
C
C       EAT, RUB              2
C
C       BEAM, SWEEP, CALL     3
C
C       MOVE                  4
C
C       ANSWER, FEED, DISPLAY 5
C
C       ATTACK AND KILL       6
C
C       SUSPEND, RESTORE      7
C
C       DRINK, MYSTERY        8
C
C       BRIBE                 9
C
C       QUESTION             10
C
C       LISTEN               11
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-H-1  (LINE 6960)
C 2-H
C
C ****** SELECT THE RIGHT VERB ******
C
      GOTO(1000,2000,3000,4000,5000,6000,7000,8000,9000,10000,
     A10000,11000,12000,13000,14000,15000,16000,17000)IWRD(6,1)-35
C
C ****** EAT ROUTINE ******
C
 1000 IF(IW71.NE.1.AND.(IW52.NE.3.OR.IW62.GT.35))
     1CALL EXEC(8,NAME,LU,320)
      IF(IW71.EQ.1)IW62=24
C
C *** DOES HE HAVE IT ***
C
      IF(IVEN(IW62).LT.20000)CALL EXEC(8,NAME,LU,3010)
C
C *** CAN HE EAT IT ***
C
      IF(IW62.NE.22.AND.IW62.NE.24.AND.IW62.NE.28.AND.
     1IW62.NE.29.AND.IW62.NE.31)CALL EXEC(8,NAME,LU,2010)
C
C *** EAT IT ***
C
      IVEN(IW62)=0
      IF(IW62.EQ.24)CALL EXEC(8,NAME,LU,1010)
      CALL EXEC(8,NAME,LU,1020)
C
C ****** RUB ROUTINE ******
C
 2000 IF((IW52.NE.3.AND.IW52.NE.4).OR.(IW52.EQ.4.AND.
     1IW62.NE.8).OR.(IW52.EQ.3.AND.IVEN(IW62).EQ.0))
     2CALL EXEC(8,NAME,LU,320)
C
C *** IS IT LIGHT ***
C
      CALL MMRL
C
C *** SCROLL ***
C
      IF(IWRD(6,2).EQ.88.AND.IR.EQ.17)CALL EXEC(8,NAME,LU,2037)
C
C *** MAID ***
C
      IF((IW52.EQ.4.AND.IFSD(IRES(8)).NE.IR).OR.(IW52.EQ.3
     1.AND.IW62.GT.35.AND.IVEN(IW62).NE.IR))CALL EXEC
     2(8,NAME,LU,2030)
      IF(IW52.EQ.4.AND.IR.NE.25)CALL EXEC(8,NAME,LU,2080)
      IF(IW52.EQ.4)IXT(134)=2225
      IF(IW52.EQ.4)CALL EXEC(8,NAME,LU,1095,IR)
C
C *** ITEMS ***
C
      IF(IW62.LT.36.AND.IVEN(IW62).LT.20000)
     1CALL EXEC(8,NAME,LU,3010)
      IF(IW62.NE.45)CALL EXEC(8,NAME,LU,520)
      CALL EXEC(8,NAME,LU,2090)
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-H-2  (LINE 7040)
C 3-H
C
C ****** BEAM ROUTINE ******
C
 3000 IF(IW71.NE.2.OR.IW52.NE.2.OR.(IW62.NE.5.AND.
     1IW62.NE.6))CALL EXEC(8,NAME,LU,320)
C
C *** BEAM UP ***
C
      IF(IW62.EQ.5.AND.IVEN(23).LT.20000)CALL EXEC(8,NAME,LU,3050)
      IF(IW62.EQ.5)ITST(1)=89
      IF(IW62.EQ.5)CALL EXEC(8,NAME,LU,3060)
C
C *** BEAM DOWN ***
C
      IF(IR.NE.89)CALL EXEC(8,NAME,LU,3070)
      IC=IFSD(IVEN(26))
      IF(IVEN(26).EQ.789.OR.IVEN(26).GT.20000.OR.(IVEN(26).LT.20000
     1.AND.IVEN(26).GT.10000.AND.IFSD(IRES(IC)).EQ.89))
     2CALL EXEC(8,NAME,LU,3080)
      IF(IVEN(26).GT.10000)IC=IFSD(IRES(IC))
      IF(IC.EQ.0)CALL EXEC(8,NAME,LU,520)
      ITST(1)=IC
      CALL EXEC(8,NAME,LU,3090,IC)
C
C ****** SWEEP ROUTINE ******
C
 4000 IF(IW71.NE.1)CALL EXEC(8,NAME,LU,320)
      IF(IVEN(25).LT.20000)CALL EXEC(8,NAME,LU,4055)
C
C *** IS IT LIGHT ***
C
      CALL MMRL
      IF(IR.NE.23)CALL EXEC(8,NAME,LU,4050)
      IXT(191)=2223
      CALL EXEC(8,NAME,LU,1095,IR)
C
C
C ****** CALL ROUTINE ******
C
C
C *** CHECK FORMAT ***
C
 5000 IF(IW52.NE.3.OR.IW62.LT.55.OR.IW62.GT.58)
     1CALL EXEC(8,NAME,LU,320)
C
C *** CAN HE CALL ***
C
      IF(IR.NE.11) CALL EXEC(8,NAME,LU,8032)
C
C *** POLICE ***
C
      IC=0
      IF(IW62.EQ.55.AND.ITST(8).EQ.0.AND.IXT(54).LT.20000
     1.AND.IFSD(IRES(ITST(9))).EQ.IR)IC=1
      IF(IC.EQ.1) IRES(ITST(9))=0
      IF(IC.EQ.1)ITST(2)=ITST(2)+50
      IF(IC.EQ.1) CALL EXEC(8,NAME,LU,5001)
C
C *** TAXI ***
C
      IF(IW62.EQ.58.AND.IXT(52).NE.0.AND.ITST(5).GT.400)IXT(52)=0
      IF(IXT(52).EQ.0.AND.IW62.EQ.58)CALL EXEC(8,NAME,LU,5002)
C
C *** NO RESPONSE ***
C
      CALL EXEC(8,NAME,LU,5009)
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-H-3  (LINE 7120)
C 4-H
C    ****** MOVE ROUTINE ******
C
C *** CHECK FORMAT ***
C
 6000 IF(IW71.NE.2.OR.IW52.NE.3.OR.IVEN(IW62).EQ.0)
     1CALL EXEC(8,NAME,LU,320)
C
C *** IS IT LIGHT ***
C
      CALL MMRL
C
C *** TABLES ***
C
      IF((IW62.EQ.94.OR.IW62.EQ.97.OR.IW62.EQ.98).AND.IR.EQ.15)
     1CALL EXEC(8,NAME,LU,6005)
      IF(IW62.EQ.95.AND.IR.EQ.15.AND.IVEN(48).EQ.0)
     1CALL EXEC(8,NAME,LU,6015)
C
C *** SCROLL ***
C
      IF(IWRD(6,2).EQ.88.AND.IR.EQ.17)CALL EXEC(8,NAME,LU,2037)
C
C *** RAGS ***
C
      IF(IW62.EQ.68.AND.IR.EQ.27)CALL EXEC(8,NAME,LU,6030)
      IF(IW62.EQ.68.AND.IR.EQ.88)CALL EXEC(8,NAME,LU,6040)
C
C *** ROCKS ***
C
      IF(IW62.EQ.84.AND.(IR.LT.42.OR.IR.GT.50))CALL EXEC(8,NAME,LU,8031)
      IF(IW62.EQ.84.AND.IXT(320).NE.0)CALL EXEC(8,NAME,LU,1040)
      R=RN(R)
      IF(IW62.EQ.84.AND.R.LT..333.AND.IR.GT.42.AND.IR.LT.47)IVEN(38)=
     1100+IR
      IF(IW62.EQ.84.AND.R.LT..333.AND.IR.GT.42.AND.IR.LT.47)
     1CALL EXEC(8,NAME,LU,6010)
      IF(IW62.EQ.84)CALL EXEC(8,NAME,LU,1040)
C
C *** BOULDERS ***
C
      IF(IW62.EQ.83.AND.(IXT(320).NE.0.OR.IR.NE.52))
     1CALL EXEC(8,NAME,LU,8031)
      IF(IW62.EQ.83.AND.IVEN(48).LT.20000)CALL EXEC(8,NAME,LU,6041)
      IF(IW62.EQ.83.AND.IVEN(36).NE.0.AND.IXT(319).EQ.4952)
     1CALL EXEC(8,NAME,LU,6042)
      IF(IW62.EQ.83.AND.R.GT..67.AND.IXT(319).NE.0)IVEN(36)=152
      IF(IW62.EQ.83.AND.R.GT..67.AND.IXT(319).NE.0)
     1CALL EXEC(8,NAME,LU,6043)
      IF(IW62.EQ.83)CALL EXEC(8,NAME,LU,6044)
C
C *** IS HE NEAR IT ***
C
      IF(IVEN(IW62).NE.IR.AND.IW62.GT.47)
     1CALL EXEC(8,NAME,LU,8031)
C
C *** DOES HE HAVE IT ***
C
      IF(IW62.LT.54.AND.IVEN(IW62).LT.20000)
     1CALL EXEC(8,NAME,LU,8005)
C
C *** WOOD ***
C
      IF(IW62.EQ.67)IXT(187)=1314
      IF(IW62.EQ.67)CALL EXEC(8,NAME,LU,1095,IR)
C
      CALL EXEC(8,NAME,LU,8010)
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-H-4  (LINE 7200)
C 5-H
C  ****** ANSWER ROUTINE ******
C
 7000 IF(IW52 .NE. 3.OR.IW62.NE.73.OR.IW71.NE.2)
     1CALL EXEC(8,NAME,LU,320)
C
C *** IS IT LIGHT ***
C
      CALL MMRL
C
C *** SAY MESSAGE ***
C
      IF(IR .NE. 11) CALL EXEC(8,NAME,LU,8031)
      IC=ITD(IVEN(73))
      IF(IC.NE.0)IVEN(73)=1000
      IF(IC.NE.0)CALL EXEC(8,NAME,LU,7010,IC)
      CALL EXEC(8,NAME,LU,7090)
C
C ****** FEED ROUTINE ******
 8000 IF(IW71.NE.2.OR.(IW52.NE.4.AND.IW62.NE.63))CALL
     1EXEC(8,NAME,LU,320)
C
C *** IS IT LIGHT ***
C
      CALL MMRL
C
C *** FEED MONKEY ***
C
      IF(IR.NE.1.AND.IW62.EQ.63)CALL EXEC(8,NAME,LU,2030)
      IF((IR .EQ. 1) .AND. (IW62 .EQ. 63)) IXT(1)=401
      IF((IR.EQ.1).AND.(IW62.EQ.63)) CALL EXEC(8,NAME,LU,1095,IR)
C
C *** DOES HE HAVE FOOD ***
C
      IF(IVEN(24).LT.20000)CALL EXEC(8,NAME,LU,8006)
C
C *** IS INHABITANT HERE ***
C
      IF(IFSD(IRES(IW62)) .NE. IR) CALL EXEC(8,NAME,LU,2030)
      IVEN(24)=309
      CALL EXEC(8,NAME,LU,8015)
C
C ****** DISPLAY ROUTINE ******
C
C *** CHECK FOR DEBUGGER IN CASE ANYBODY SHOULD TRY TO USE IT ***
C
C
 9000 IF (IW71 .GT. 1) CALL EXEC(8,NAME,LU,320)
      IF(ITST(30).EQ.0)NAME(2)=2HSL
      IF(ITST(30).EQ.0)CALL EXEC(8,NAME)
      R=RN(R)
      IC=INT(R*57)+10
      WRITE(LU,9010) IC
 9010 FORMAT(/X,I2" ARE YOU THE CREATOR?"//" ?_")
      READ(LU,9020)IANS,IAN,ID
C
C *** ANSWER IN THE FORM 'YES XX' WHERE XX =(99-IC)
C
C *** ONCE YOU ENTER DISPLAY SET ITST(30)=0 FOR EASY ACCESS.
C
      IF(LX.NE.0)WRITE(LX,9011)IC,IANS
 9011 FORMAT(I3," ARE YOU THE CREATOR?"//" ?",I3)
 9020 FORMAT(2A2,I2)
      WRITE(LU,9032)
 9032 FORMAT("A            DDDDDDDDDDDDAAAA")
      IF(IANS.EQ.2HNO)CALL EXEC(8,NAME,LU,9040)
      IF(IANS.NE.2HYE.OR.99-IC.NE.ID)CALL EXEC(8,NAME,LU,9030)
      NAME(2)=2HSL
      CALL EXEC(8,NAME)
C
C
C
C
C
C
C
C
C
C
C                            MM-H-5  (LINE 7280)
C 6-H
C
C ****** ATTACK AND KILL ROUTINE ******
C
10000 IF(IWRD(7,1).EQ.1)CALL EXEC(8,NAME,LU,1000)
      IF(IW71.NE.2.OR.IW52.NE.4)CALL EXEC(8,NAME,LU,320)
C
C *** IS IT LIGHT ***
C
      CALL MMRL
C
C *** IS INHABITANT HERE AND ALIVE ***
C
      IC=IW62
      IF(IFSD(IRES(IC)).NE.IR)CALL EXEC(8,NAME,LU,2030)
      IF(IRES(IC).GT.10000)CALL EXEC(8,NAME,LU,20030)
C
C **** CAN INHABITANT BE KILLED ****
C
C *** VAMPIRE ***
C
      IF(IC.EQ.5.AND.IR.EQ.5.AND.IRES(5).EQ.5.AND.IVEN(29).GE.20000.
     1AND.(IVEN(11).GT.20000.OR.IVEN(14).GT.20000).AND.ITST(5).LT.50
     2.AND.IXT(183).EQ.405) CALL EXEC(8,NAME,LU,10011)
C
      IF(IC.EQ.5.OR.IC.EQ.10)CALL EXEC(8,NAME,LU,10020)
C
C *** WOLF OR WEREWOLF ***
C
      IF(IC.EQ.15.OR.IC.EQ.10)CALL EXEC(8,NAME,LU,10030)
C
C *** FIGHT ***
C
      IP=IRES(IC)/1000-ITST(31)
      DO 10010 I=1,89
      IF(I.NE.10.AND.I.NE.11.AND.I.NE.12.AND.I.NE.14.AND.I.NE.34.AND.
     1I.NE.45.AND.I.NE.48.AND.I.NE.49)GOTO 10010
      IF(IVEN(I).GT.20000)IP=IP+IFD(IVEN(I))
      IF(IFSD(IVEN(I)).EQ.IC.AND.IVEN(I).GT.10000.AND.IVEN(I).LT.
     120000) IP=IP-IFD(IVEN(J))
10010 CONTINUE
      R=RN(R)
      IP=IP+5*R-2
      IF(IP.EQ.6)IP=8
      IF(IP.EQ.7)IP=9
      IF(IP.EQ.-6)IP=-8
      IF(IP.EQ.-7)IP=-9
      IF(IP.GT.9)IP=10
      IF(IP.LT.-9)IP=-10
      IF(IP.LT.0)ITST(31)=-1*IP
      IF(IP.GT.0)IRES(IC)=IRES(IC)-1000*(IRES(IC)/1000)+1000*IP
      IF(IABS(IP).LT.2.AND.IC.NE.16)GOTO 10050
      IF(IP.LT.-9)CALL EXEC(8,NAME,LU,10030)
      IF(IP.GT.9.AND.IC.EQ.13.AND.IR.EQ.33)IRES(13)=934
      IF(IP.GT.9.AND.IC.EQ.13.AND.IR.NE.33)IRES(13)=933
      IF(IP.GT.9.AND.IC.EQ.13)CALL EXEC(8,NAME,LU,16045)
      IF(IP.GT.9)CALL EXEC(8,NAME,LU,10040)
      IF(IP.GT.0)CALL EXEC(8,NAME,LU,10041)
      CALL EXEC(8,NAME,LU,10031)
C
C *** ESCAPE ***
C
10050 DO 10070 J=1,360
      IF(IFSD(IXT(J)).NE.IR.OR.IXT(J).GT.20000)GOTO 10070
      IRES(IC)=IRES(IC)-IR+ITFD(IXT(J))
      CALL EXEC(8,NAME,LU,10060)
10070 CONTINUE
      R=RN(R)
      IF(R.LT..3)CALL EXEC(8,NAME,LU,10030)
      IRES(IC)=10000+IR
      CALL EXEC(8,NAME,LU,10040)
C
C
C
C
C
C
C
C
C                            MM-H-6  (LINE 7360)
C 7-H
C *** THE REVISION IS CHANGED WHENEVER OLD SUSPENDED GAMES WILL
C     NOT WORK CORRECTLY OR WHENEVER THE GAME MIGHT NOT APPEAR TO BE
C     THE SAME AS BEFORE. OTHERWISE ONLY THE DATE IS CHANGED.
C
C ****** SUSPEND ROUTINE ******
C
11000 IF(IW71 .GT. 1) CALL EXEC(8,NAME,LU,320)
      IC=-1
11010 WRITE(LU,11020)
11020 FORMAT(/" ENTER CARTRIDGE # OR 0 TO ABORT SUSPEND"//"?_")
      READ(LU,*) IC
      IF(LX.NE.0)WRITE(LX,11021)IC
11021 FORMAT(/" ENTER CARTRIDGE # OR 0 TO ABORT SUSPEND"//" ?"I3)
      IF(IC.LT.0)GOTO 11010
      IF(IC .EQ. 0) CALL EXEC(8,NAME,LU,1040)
11050 WRITE(LU,11060)
11060 FORMAT(/" ENTER 4 CHARACTER NAME TO STORE IT UNDER."//"?_")
      READ(LU,11070)(NAMF(I),I=2,3)
      IF(LX.NE.0)WRITE(LX,11061)(NAMF(I),I=2,3)
11061 FORMAT(/" ENTER 4 CHARACTER NAME TO STORE IT UNDER."//" ?"2A2)
11070 FORMAT(2A2)
      NAMF(1)=2HMM
      CALL OPEN(IDCB,IERR,NAMF,0,0,IC)
      IF(IERR .EQ. -6) CALL CREAT(IDCB,IERR,NAMF,10,3,0,IC)
      IF(IERR .LT. 0) CALL EXEC(8,NAME,LU,11075,IERR)
      DO 11080 I=1,8
      DO 11080 J=1,4
11080 IVRBX(J,I)=IVRB(J,3+I)
      CALL WRITF(IDCB,IERR,IVRBX,32)
      IF(IERR.LT.0)CALL EXEC(8,NAME,LU,11075,IERR)
      CALL WRITF(IDCB,IERR,IROM,99)
      CALL WRITF(IDCB,IERR,IRES,17)
      CALL WRITF(IDCB,IERR,IVEN,107)
      CALL WRITF(IDCB,IERR,IXT,360)
      CALL WRITF(IDCB,IERR,ITST,40)
      CALL CLOSE(IDCB)
      CALL EXEC(8,NAME,LU,11040,NAMF(1),NAMF(2),NAMF(3))
C
C
C
C ****** RESTORE ROUTINE ******
C
12000 IF(IW71 .GT. 1) CALL EXEC(8,NAME,LU,320)
      IC=-1
12010 WRITE(LU,12020)
12020 FORMAT(/" ENTER CARTRIDGE # OR 0 TO ABORT RESTORE"//"?_")
      READ(LU,*) IC
      IF(LX.NE.0)WRITE(LX,12021)IC
12021 FORMAT(/" ENTER CARTRIDGE # OR 0 TO ABORT RESTORE"//" ?"I3)
      IF(IC.LT.0)GOTO 12010
      IF(IC .EQ. 0) CALL EXEC(8,NAME,LU,1040)
12050 WRITE(LU,12060)
12060 FORMAT(/" ENTER 4 CHARACTER NAME IT WAS SUSPENDED UNDER."//"?_")
      READ(LU,11070)(NAMF(I),I=2,3)
      IF(LX.NE.0)WRITE(LX,12061)(NAMF(I),I=2,3)
12061 FORMAT(/" ENTER 4 CHARACTER NAME IT WAS SUSPENDED UNDER."//" ?"
     12A2)
      NAMF(1)=2HMM
      CALL OPEN(IDCB,IERR,NAMF,0,0,IC)
      IF(IERR .LT. 0) CALL EXEC(8,NAME,LU,11075,IERR)
      CALL READF(IDCB,IERR,IVRBX,32)
      IF(IERR.LT.0)CALL EXEC(8,NAME,LU,11075,IERR)
      DO 12080 I=1,8
      DO 12080 J=1,4
12080 IVRB(J,3+I)=IVRBX(J,I)
      IXX=ITST(19)
      CALL READF(IDCB,IERR,IROM,99)
      CALL READF(IDCB,IERR,IRES,17)
      CALL READF(IDCB,IERR,IVEN,107)
      CALL READF(IDCB,IERR,IXT,360)
      CALL READF(IDCB,IERR,ITST,40)
      CALL CLOSE(IDCB)
      CALL EXEC(11,ITIM)
      ITST(19)=IXX
      ITST(18)=ITIM(4)*1200+ITIM(3)*20+ITIM(2)/3
      ITST(20)=ITST(20)+1
      CALL EXEC(8,NAME,LU,12040,NAMF(1),NAMF(2),NAMF(3))
C
C                            MM-H-7  (LINE 7440)
C 8-H
C
C
C ****** DRINK ROUTINE ******
C
13000 IF(IW71.NE.1.AND.IW62.NE.13.AND.IW62.NE.60.AND.IW62.NE.62)
     1CALL EXEC(8,NAME,LU,320)
      IF(IW71.GT.2)CALL EXEC(8,NAME,LU,320)
      IF(IW71.EQ.1)IW62=62
C
C *** WINE ***
C
      IF(IW62.EQ.60.AND.IR.NE.16)CALL EXEC(8,NAME,LU,2030)
      IF(IW62.EQ.60)IXT(128)=1316
      IF(IW62.EQ.60)CALL EXEC(8,NAME,LU,1095,IR)
C
C *** POISON ***
C
      IF(IW62.EQ.13.AND.(IVEN(13).LT.20000.OR.ITST(10).EQ.13))
     1CALL EXEC(8,NAME,LU,2030)
      IF(IW62.EQ.13)NAME(2)=2HSD
      IF(IW62.EQ.13)CALL EXEC(8,NAME,LU,13010)
C
C *** WATER ***
C
      IF(IW62.EQ.62.AND.(IR.LT.68.OR.IR.GT.83).AND.IR.NE.99)
     1CALL EXEC(8,NAME,LU,2030)
      IF(IW62.EQ.62)CALL EXEC(8,NAME,LU,1010)
      CALL EXEC(8,NAME,LU,320)
C
C ****** MYSTERY CHANGE ******
C
14000 IF(IW71.GT.1)GOTO 14100
C
C *** IS IT THE FIRST TURN ***
C
      IF(ITST(5).GT.2)CALL EXEC(8,NAME,LU,14010)
C
C *** GET THE MYSTERY NUMBER ***
C
14020 WRITE(LU,14030)
14030 FORMAT(/"MYSTERY #? _")
      IF(LA.EQ.0)READ(LU,*)IC
      IF(LA.NE.0)READ(LA,14032)IC
      IF(LO.NE.0)WRITE(LO,14032)IC
      IF(LX.NE.0)WRITE(LX,14031)IC
14031 FORMAT(/" MYSTERY #? "I4)
14032 FORMAT(I6)
      IF(IC.LT.1.OR.IC.GT.999)GOTO 14020
      RND=.001*IC
      WRITE(LU,14035)IC
      IF(LX.NE.0)WRITE(LX,14035)IC
14035 FORMAT(/" THIS GAME IS NOW SET UP FOR MYSTERY #"I4)
      ITST(23)=IC
      NAME(2)=2HSA
      CALL EXEC(8,NAME)
C
C *** MYSTERY MANSION ***
C
14100 IF(IWRD(7,1).GT.2.OR.IWRD(6,2).NE.107)CALL EXEC(8,NAME,LU,320)
      CALL EXEC(8,NAME,LU,14110)
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-H-8  (LINE 7520)
C 9-H
C
C
C ****** BRIBE ROUTINE ******
C
C
C *** CHECK FORMAT ***
C
15000 IF(IW71.NE.2.OR.IW52.NE.4)CALL EXEC(8,NAME,LU,320)
C
C *** IS THE PLAYER WITH THE INHABITANT ***
C
      IF(IFSD(IRES(IW62)).NE.IR) CALL EXEC(8,NAME,LU,2030)
C
C *** DOES THE PLAYER HAVE THE TREASURE ***
C
      IF(IVEN(7).LT.20000)CALL EXEC(8,NAME,LU,15200)
C
C *** IS THE INHABITANT ALIVE ***
C
      IF(IRES(IW62).GT.10000)CALL EXEC(8,NAME,LU,15400)
C
C *** DOES THE INHABITANT KNOW ANYTHING ***
C
      IC=0
      IG=IW62
      IM=ITST(9)
      IR=ITST(8)
      IF(IM.EQ.2.AND.IR.GT.53.AND.(IG.EQ.7.OR.IG.EQ.8.OR.IG.EQ.9))IC=1
      IF(IM.EQ.2.AND.IR.LT.28.AND.(IG.EQ.3.OR.IG.EQ.8.OR.IG.EQ.14))IC=1
      IF(IM.EQ.3.AND.IR.GT.18.AND.(IG.EQ.2.OR.IG.EQ.8.OR.IG.EQ.14))IC=1
      IF(IM.EQ.3.AND.IR.LT.10.AND.(IG.EQ.7.OR.IG.EQ.9.OR.IG.EQ.14))IC=1
      IF(IM.EQ.7.AND.IR.GT.53.AND.(IG.EQ.2.OR.IG.EQ.8.OR.IG.EQ.9))IC=1
      IF(IM.EQ.7.AND.IR.LT.10.AND.(IG.EQ.3.OR.IG.EQ.9.OR.IG.EQ.14))IC=1
      IF(IM.EQ.8.AND.IR.GT.53.AND.(IG.EQ.2.OR.IG.EQ.7.OR.IG.EQ.9))IC=1
      IF(IM.EQ.8.AND.IR.LT.28.AND.(IG.EQ.2.OR.IG.EQ.3.OR.IG.EQ.14))IC=1
      IF(IM.EQ.9.AND.IR.GT.53.AND.(IG.EQ.2.OR.IG.EQ.7.OR.IG.EQ.8))IC=1
      IF(IM.EQ.9.AND.IR.LT.10.AND.(IG.EQ.3.OR.IG.EQ.7.OR.IG.EQ.14))IC=1
      IF(IM.EQ.14.AND.IR.GT.9.AND.(IG.EQ.2.OR.IG.EQ.3.OR.IG.EQ.8))IC=1
      IF(IM.EQ.14.AND.IR.LT.10.AND.(IG.EQ.3.OR.IG.EQ.7.OR.IG.EQ.9))IC=1
      IF(IC.EQ.0)CALL EXEC(8,NAME,LU,15400)
      IVEN(7)=0
      IRES(IG)=0
      CALL EXEC(8,NAME,LU,15500)
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-H-9  (LINE 7600)
C 10-H
C ****** QUESTION ROUTINE ******
C
16000 IF(IWRD(7,1).EQ.1) CALL EXEC(8,NAME,LU,1000)
      IF(IWRD(7,1).NE.2.OR.IWRD(5,2).NE.4)CALL EXEC(8,NAME,LU,320)
C
C
C *** IS HE WITH INHABITANT ***
C
      IF(IFSD(IRES(IWRD(6,2))).NE.IR)CALL EXEC(8,NAME,LU,2030)
C
C *** IS INHABITANT ALIVE AND VOCAL ***
C
      IF(IRES(IWRD(6,2)).GE.1000.OR.IWRD(6,2).EQ.4.OR.IWRD(6,2).EQ.15)
     1CALL EXEC(8,NAME,LU,20030)
C
C *** IRRITATE ***
C
      R=RN(R)
      IF(ITST(5)-2.GT.ITST(13).AND.R.LT..5)CALL EXEC(8,NAME,LU,23120)
      IF(ITST(5)-4.GT.ITST(13))CALL EXEC(8,NAME,LU,23145)
      IF(ITST(5)-2.GT.ITST(13))CALL EXEC(8,NAME,LU,23140)
C
C *** VAMPIRE ***
C
      IF(IWRD(6,2).EQ.5)CALL EXEC (8,NAME,LU,23010)
C
C *** WEREWOLF ***
C
      IF(IWRD(6,2).EQ.10)CALL EXEC (8,NAME,LU,23015)
C
C *** ELF AND DWARF ***
C
      IF(IWRD(6,2).EQ.11.OR.IWRD(6,2).EQ.13)CALL EXEC(8,NAME,LU,23020)
C
C *** WOODSMAN AND HUNTER ***
C
      IF(IWRD(6,2).NE.6.AND.IWRD(6,2).NE.12)GOTO 23130
      IF(IXT(54).GT.20000.AND.IR.NE.93.AND.R.LT..3)CALL EXEC(8,NAME,
     1LU,23030)
      IF(IXT(54).GT.20000.AND.IR.EQ.93.AND.RDN.LT..3)CALL EXEC(8,NAME,
     1LU,23040)
      IF(IXT(54).LT.20000.AND.R.LT..3)CALL EXEC(8,NAME,LU,23050)
      IF(R.LT..4)CALL EXEC(8,NAME,LU,23060)
      IF(R.LT..5)CALL EXEC(8,NAME,LU,23070)
      IF(R.LT..58)CALL EXEC(8,NAME,LU,23080)
      IF(R.LT..66)CALL EXEC(8,NAME,LU,23090)
      IF(R.LT..74)CALL EXEC(8,NAME,LU,23100)
      IF(R.LT..82)CALL EXEC(8,NAME,LU,23110)
      CALL EXEC(8,NAME,LU,23120)
C
C *** MURDERER ***
C
23130 IF(IWRD(6,2).NE.ITST(9))GOTO 23160
      IF(R.LT..33)CALL EXEC(8,NAME,LU,23120)
      IF(R.LT..67)CALL EXEC(8,NAME,LU,23140)
      CALL EXEC(8,NAME,LU,23150)
C
C *** MASTER AND BUTLER ***
C
23160 IF(IWRD(6,2).NE.3.AND.IWRD(6,2).NE.14)GOTO 23250
      IF(R.LT..3)GOTO 23200
      IF(ITST(8).LT.28.AND.R.LT..15)CALL EXEC(8,NAME,LU,23170)
      IF(ITST(8).LT.28)CALL EXEC(8,NAME,LU,23180)
      IF(IVEN(ITST(10)).LT.10000.AND.IFSD(IVEN(ITST(10))).LT.28)
     1CALL EXEC(8,NAME,LU,23190)
      CALL EXEC(8,NAME,LU,23150)
23200 IF(R.LT..4)CALL EXEC(8,NAME,LU,23210)
      IF(R.LT..5)CALL EXEC(8,NAME,LU,23220)
      IF(R.LT..6)CALL EXEC(8,NAME,LU,23230)
      IF(R.LT..7)CALL EXEC(8,NAME,LU,23240)
      IF(R.LT..8)CALL EXEC(8,NAME,LU,23140)
      CALL EXEC(8,NAME,LU,23120)
C
C
C
C
C
C
C                            MM-H-10  (LINE 7680)
C 11-H
C
C *** LADY AND MAID ***
C
23250 IF(IWRD(6,2).NE.8.AND.IWRD(6,2).NE.2)GOTO 23310
      IF(R.LT..3)GOTO 23260
      IF(ITST(8).GT.9.AND.R.LT..15)CALL EXEC(8,NAME,LU,23170)
      IF(ITST(8).GT.9)CALL EXEC(8,NAME,LU,23180)
      IF(IVEN(ITST(10)).LT.10000.AND.IFSD(IVEN(ITST(10))).GT.9)
     1CALL EXEC(8,NAME,LU,23190)
      CALL EXEC(8,NAME,LU,23150)
23260 IF(R.LT..4)CALL EXEC(8,NAME,LU,23270)
      IF(R.LT..5)CALL EXEC(8,NAME,LU,23280)
      IF(R.LT..6)CALL EXEC(8,NAME,LU,23290)
      IF(R.LT..7)CALL EXEC(8,NAME,LU,23300)
      IF(R.LT..8)CALL EXEC(8,NAME,LU,23140)
      CALL EXEC(8,NAME,LU,23150)
C
C *** COOK AND GARDENER ***
C
23310 IF(R.LT..3)GOTO 23320
      IF(ITST(8).LT.10.OR.ITST(8).GT.27.AND.R.LT..15)
     1CALL EXEC(8,NAME,LU,23170)
      IF(ITST(8).LT.10.OR.ITST(8).GT.27)CALL EXEC(8,NAME,LU,23180)
      IF(IVEN(ITST(10)).LT.10000.AND.IFSD(IVEN(ITST(10))).GT.9)
     1CALL EXEC(8,NAME,LU,23190)
      CALL EXEC(8,NAME,LU,23150)
23320 IF(R.LT..4)CALL EXEC(8,NAME,LU,23330)
      IF(R.LT..5)CALL EXEC(8,NAME,LU,23340)
      IF(R.LT..6)CALL EXEC(8,NAME,LU,23350)
      IF(R.LT..7)CALL EXEC(8,NAME,LU,23360)
      IF(R.LT..8)CALL EXEC(8,NAME,LU,23140)
      CALL EXEC(8,NAME,LU,23150)
C
C ****** LISTEN ROUTINE ******
C
17000 IF(IWRD(7,1).NE.1)CALL EXEC(8,NAME,LU,320)
      IX=0
      IC=0
      ID=24000+IR
      IF(IR.GT.53)ID=24100
      IF(IVEN(3).GT.20000.OR.IVEN(3).EQ.200+IR.OR.(IVEN(3).GT.10000.
     1AND.IFSD(IVEN(3)).EQ.IR))IX=24108
      DO 24010 I=2,15
      IF(IRES(I).GT.10000.OR.IFSD(IRES(I)).NE.IR)GOTO 24010
      IX=24110
      IF(I.NE.4.AND.I.NE.10.AND.I.NE.15)IC=IC+1
      IF(IC.EQ.1)IX=24120
      IF(IC.LT.2)GOTO 24010
      IF(IC.EQ.2)IX=24130
      IF(IC.EQ.3)IX=24140
24010 CONTINUE
      IF(IRES(6)+IRES(12).LT.10000.AND.IFSD(IRES(6)).EQ.IR.AND.
     1IFSD(IRES(12)).EQ.IR)IX=24150
      IF(IRES(3)+IRES(14).LT.10000.AND.IFSD(IRES(3)).EQ.IR.AND.
     1IFSD(IRES(14)).EQ.IR.AND.ITST(9).NE.3.AND.ITST(9).NE.14.
     2AND.ITST(8).LT.28)IX=24160
      RNX=77.7*IR/253.-INT(77.7*IR/253.)
      IF(IX.EQ.24160.AND.RNX.GT..8)IX=24164
      IF(IX.EQ.24160.AND.RNX.GT..6)IX=24162
      IF(IRES(7)+IRES(9).LT.10000.AND.IFSD(IRES(7)).EQ.IR.AND.
     1IFSD(IRES(9)).EQ.IR.AND.ITST(9).NE.7.AND.ITST(9).NE.9.AND.
     2(ITST(8).LT.10.OR.ITST(8).GT.27))IX=24170
      IF(IX.EQ.24170.AND.RNX.GT..8)IX=24174
      IF(IX.EQ.24170.AND.RNX.GT..6)IX=24172
      IF(IRES(2)+IRES(8).LT.10000.AND.IFSD(IRES(2)).EQ.IR.AND.
     1IFSD(IRES(8)).EQ.IR.AND.ITST(9).NE.2.AND.ITST(9).NE.8.AND.
     2ITST(8).GT.27)IX=24180
      IF(IX.EQ.24180.AND.RNX.GT..8)IX=24184
      IF(IX.EQ.24180.AND.RNX.GT..6)IX=24182
      IF(ID.EQ.24100.AND.IX.NE.0)ID=24105
      CALL EXEC(8,NAME,LU,ID,IX)
C
C
      END
C
C
C
C
C                            MM-H-11  (LINE 7760)
C 1-I
      PROGRAM MMSI(5)
C
      COMMON/MMBC/IWRD(9,9),IPR(5),IVRB(4,89),IRNM(8,56),IROM(99),
     1IRSN(4,17),IRES(17),IPRP(4,17),IDTN(4,11),IVEN(107),
     2IXT(360),ICLS(4,12),ITST(40),NAME(3),RND,NTAG(10),IWP(4)
C
C ******* SEGMENT I *******
C
C  THIS PROGRAM WRITES A MESSAGE FOR SEGMENT MMSH AND RETURNS TO
C  THE READ SEGMENT MMSB
C *** FUNCTIONS ***
C
      IFSD(I)=I-(I/100)*100
      ITFD(I)=I/100-(I/10000)*100
      ITD(I)=I/100-(I/1000)*10
      IFD(I)=I/1000-(I/10000)*10
C
      CALL RMPAR(IPR)
      LU=IPR(1)
      IRIT=IPR(2)
      IW63=IWRD(6,3)
C
C * SET DIRECTIONS *
C
      IFC=ITST(4)/1000
      IDN=1
      IDE=2
      IDS=3
      IDW=4
      IF(IVEN(6).LT.20000)IDN=10-IFC
      IF(IDN.EQ.6)IDN=10
      IF(IVEN(6).LT.20000)IDE=11-IFC
      IF(IVEN(6).LT.20000)IDS=12-IFC
      IF(IDS.EQ.11)IDS=7
      IF(IVEN(6).LT.20000)IDW=13-IFC
      IF(IDW.GT.10)IDW=IDW-4
C
C
C
C
C
C
C
C
C
C
C
C   *** CLOSING COMMENTS ***
C
  999 IF (IRIT .EQ. 320) WRITE(LU,320)
  320 FORMAT(/" I CANNOT FIGURE OUT WHAT YOU ARE TRYING TO SAY")
C
      IF (IRIT .EQ. 520) WRITE(LU,520)
  520 FORMAT(/" NOTHING HAPPENS")
C
      IF(IRIT.EQ.1000)WRITE(LU,1000)(IWRD(L,1),L=1,4)
 1000 FORMAT(/" PLEASE TRY AGAIN. I NEED TO KNOW WHO OR WHAT TO "4A2)
C
      IF(IRIT.EQ.1010)WRITE(LU,1010)
 1010 FORMAT(/" THANKS. THAT TASTED GOOD.")
C
      IF(IRIT.EQ.1020)WRITE(LU,1020)
 1020 FORMAT(/" UGH! THAT TASTED AWFUL.")
C
      IF (IRIT .EQ. 1040) WRITE(LU,1040)
 1040 FORMAT(/" OKAY")
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-I-1  (LINE 7840)
C 2-I
C
      IF(IRIT .EQ. 1065) WRITE(LU,1065) IPR(3)
 1065 FORMAT(/" PROGRAM ERROR AT LINE"I6)
C
      IF(IPR(3).EQ.7.OR.IPR(3).EQ.16.OR.IPR(3).EQ.25)IC=IDS
      IF(IPR(3).EQ.5.OR.IPR(3).EQ.14.OR.IPR(3).EQ.23)IC=IDW
      IF(IPR(3).EQ.1.OR.IPR(3).EQ.10.OR.IPR(3).EQ.19)IC=IDN
      IF(IRIT .EQ. 1095) WRITE(LU,1095)(IDTN(I,IC),I=1,4)
 1095 FORMAT(/" YOUR ACTION OPENED A PANEL INTO THE SECRET PASSAGE ",
     1"THAT YOU CAN"/" ENTER BY GOING "4A2)
C
C
      IF (IRIT .EQ. 1150) WRITE(LU,1150)
 1150 FORMAT(/" IT IS DARK HERE")
C
      IF ((IRIT .EQ. 1150) .AND. (IPR(3) .EQ. 1)) WRITE(LU,1151)
 1151 FORMAT(/" IT IS AFTER SUNSET")
C
      IF ((IRIT .EQ. 1150) .AND. (IPR(3) .EQ. 2)) WRITE(LU,1152)
 1152 FORMAT(/" A CURTAIN BLOCKS THE LIGHT")
C
C
      IF (IRIT .EQ. 2010) WRITE (LU,2010)(IWRD(L,1),L=1,2),
     1(IWRD(L,2),L=1,4)
 2010 FORMAT(/" YOU CANNOT "2A2" THE "4A2)
C
      IF(IRIT.EQ.2030)WRITE(LU,2030)(IWRD(L,2),L=1,4)
 2030 FORMAT(/" I DON'T SEE THE "4A2)
C
      IF(IRIT.EQ.2037)WRITE(LU,2037)
 2037 FORMAT(/" YOU MUST REALIZE BY NOW THAT THE DELICATE PAPYRUS ",
     1"WILL CRUMBLE WHEN"/" YOU SO MUCH AS EVEN BLOW ON IT.")
C
      IF(IRIT.EQ.2080)WRITE(LU,2080)
 2080 FORMAT(/" YOU JUST GOT SLAPPED BY THE MAID")
C
      IF(IRIT.EQ.2090)WRITE(LU,2090)
 2090 FORMAT(/" YOU ARE NOT ALLADIN. BESIDES, YOU KNOW HOW MUCH ",
     1"TROUBLE HE GOT INTO")
C
      IF (IRIT .EQ. 3010) WRITE(LU,3010)(IWRD(L,2),L=1,4)
 3010 FORMAT(/" YOU DO NOT HAVE THE "4A2)
      IF(IRIT.EQ.9040)ITST(34)=INT(500.1*RND)
C
      IF(IRIT.EQ.3050)WRITE(LU,3050)
 3050 FORMAT(/" YOU NEED A MATTER TRANSMITTER TO BEAM UP")
C Cu
      IF(IRIT.EQ.3060)WRITE(LU,3060)
 3060 FORMAT(/" YOU DEMATERIALIZE IN SECONDS AND REMATERIALIZE ",
     1"IN THE LABORATORY")
C
      IF(IRIT.EQ.3070)WRITE(LU,3070)
 3070 FORMAT(/" YOU HAVE TO BE IN THE LABORATORY TO BEAM DOWN")
C
      IF(IRIT.EQ.3080)WRITE(LU,3080)
 3080 FORMAT(/" THE MATTER RECEIVER HAS TO BE SOMEWHERE ELSE TO BEAM ",
     1"DOWN")
C
      IF(IRIT.EQ.3090)WRITE(LU,3090)(IRNM(L,IFSD(IROM(IPR(3))))
     1,L=1,8)
 3090 FORMAT(/" YOU DEMATERIALIZE IN SECONDS AND REMATERIALIZE IN THE "
     18A2)
C
      IF (IRIT .EQ. 3110) WRITE(LU,3110)(IWRD(L,2),L=1,4)
 3110 FORMAT(/" YOU NO LONGER HAVE THE "4A2)
C
C
C
C
C
C
C
C
C
C
C
C
C
C                            MM-I-2  (LINE 7920)
C 3-I
C
      IF(IRIT.EQ.4010)WRITE(LU,4010)(IWRD(L,4),L=1,4)
 4010 FORMAT(/" FIRST YOU HAVE TO FIND THE "4A2)
C
      IF(IRIT.EQ.4050)WRITE(LU,4050)
 4050 FORMAT(/" THANKS. IT NEEDS THAT AROUND HERE.")
C
      IF(IRIT.EQ.4055)WRITE(LU,4055)
 4055 FORMAT(/" YOU DON'T HAVE A BROOM OR ANYTHING TO SWEEP WITH")
C
      IF (IRIT .EQ. 5020) WRITE(LU,5020)(IWRD(L,3),L=1,4)
 5020 FORMAT(/" I DO NOT SEE THE "4A2)
C
      IF(IRIT.EQ.5001) WRITE(LU,5001)
 5001 FORMAT(/" THE POLICE CAME AND ARRESTED THE MURDERER")
      IF(ITST(24).NE.0.AND.IRIT.EQ.5001)ITST(1)=8
      IF(ITST(24).NE.0.AND.IRIT.EQ.5001.AND.IVEN(2).GT.20000)IVEN(2)=0
      IF(ITST(24).NE.0.AND.IRIT.EQ.5001.AND.IVEN(9).GT.20000)IVEN(9)=0
      IF(ITST(24).NE.0.AND.IRIT.EQ.5001)WRITE(LU,5003)
 5003 FORMAT(/" SINCE YOU KILLED AN INNOCENT BYSTANDER, THE POLICE ",
     1"LOCKED YOU IN"/" THE DUNGEON.")
C
      IF(IRIT.EQ.5002)WRITE(LU,5002)
 5002 FORMAT(/" THE DISPATCHER SAID THAT A TAXI WOULD BE THERE IN ",
     1"ABOUT 2 HOURS.")
C
      IF(IRIT.EQ.5009)WRITE(LU,5009)
 5009 FORMAT(/" ALL YOU CAN GET IS A BUSY SIGNAL")
C
      IF(IRIT.EQ.6005)WRITE(LU,6005)
 6005 FORMAT(/" A DOZEN OR SO OF THE INDIANS AIMING IN YOUR ",
     1"DIRECTION, SHOT THEIR"/" ARROWS AND YOU WERE HIT BY ",
     2"SEVERAL OF THEM AND DIED A PAINFUL DEATH.")
      IF(IRIT.EQ.6005)NAME(2)=2HSD
      IF(IRIT.EQ.6005)CALL EXEC(8,NAME,LU,6005)
C
      IF(IRIT.EQ.6010)WRITE(LU,6010)
 6010 FORMAT(/" YOU JUST UNCOVERED SOME GOLD COINS.")
C
      IF(IRIT.EQ.6015)WRITE(LU,6015)
 6015 FORMAT(/" AFTER MOVING THE TABLE, A TRAP DOOR OPENED REVEALING ",
     1"A GAUDY GAUNTLET.")
      IF(IRIT.EQ.6015)IVEN(48)=9115
C
      IF(IRIT.EQ.6030)WRITE(LU,6030)
 6030 FORMAT(/" UNDER THE RAGS IS A STRANGE DRAWING OF A COMPASS WITH ",
     1"THE NEEDLE BENT"/" IN A U-SHAPE AND A CLOCK WITH TWO MINUTE ",
     2"HANDS, ONE ON THE 10 AND THE OTHER"/" ON THE 12")
C
      IF(IRIT.EQ.6040)WRITE(LU,6040)
 6040 FORMAT(/" UNDER THE RAGS IS A STRANGE DRAWING OF A COMPASS WITH ",
     1"THE NEEDLE"/" POINTING NORTH AND A CLOCK WITH ONLY A MINUTE ",
     2"HAND WHICH IS ON THE 12")
C
      IF(IRIT.EQ.6041)WRITE(LU,6041)
 6041 FORMAT(/" YOU CANNOT QUITE MOVE ANY OF THE BOULDERS.")
C
      IF(IRIT.EQ.6042)WRITE(LU,6042)
 6042 FORMAT(/" IN YOUR GREED TO FIND MORE LOOT, YOU MANAGED TO ",
     1"MOVE ONE OF THE BOULDERS"/" IN THE WRONG DIRECTION AND IT ",
     2"ROLLED INTO AND BLOCKED THE ONLY EXIT.")
      IF(IRIT.EQ.6042)IXT(319)=0
C
      IF(IRIT.EQ.6043)WRITE(LU,6043)
 6043 FORMAT(/" WITH A HEAVY PUSH, YOU MOVED ONE OF THE BOULDERS ",
     1"A FEW FEET AND"/" UNCOVERED A BAG OF PEARLS IN ONE OF THE ",
     2"CRATERS THAT WAS UNDER IT.")
C
      IF(IRIT.EQ.6044)WRITE(LU,6044)
 6044 FORMAT(/" THANKS TO THE GAUNTLET, YOU WERE ABLE TO MOVE A ",
     1"BOULDER A FEW FEET"/" BUT THERE WAS NOTHING UNDER IT.")
C
C
C
C
C
C
C
C                            MM-I-3  (LINE 8000)
C 4-I
C
      IF(IRIT .EQ. 7010) WRITE(LU,7010)
 7010 FORMAT(/" A VOICE ON THE LINE SAYS:")
      IF(IRIT .EQ. 7010) IVEN(42)=1000
      IF(IRIT .EQ. 7010.AND.IPR(3).EQ.1) WRITE(LU,7015)
 7015 FORMAT(" WHY DON'T YOU DROP THE NOTE? YOU DON'T NEED IT ANYMORE.")
      IF(IRIT.EQ.7010.AND.IPR(3).EQ.2)WRITE(LU,7020)
