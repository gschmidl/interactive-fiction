    16 C  I/O ROUTINES (SPEK, PSPEK, RSPEK, GETIN, ECHO, YES, SAVE, RESTORE)
    17 C
    18 C
    19       SUBROUTINE SPEK(WORD),Print a Message <250929.1142>
    20 C
    21 C  PRINT THE MESSAGE IN WORD N OF LINES ARRAY. 
    22 C  PRECEED IT WITH A BLANK LINE UNLESS BLKLIN IS FALSE.
    23 C
    24       IMPLICIT NONE
    25 C
    26       INTEGER*2 WORD,I,N,L,PNT,OLDPNT
    27 C
    28 $INCLUDE ALPHAS.INCL 
     1+C
     2+      INTEGER*2 BLANK,EOF,CYE,CY,CNO,CN,CPO,CUR,CWE,CST,CEN,CTE
     3+C
     4+      COMMON /ALPHAS/ BLANK,EOF,CYE,CY,CNO,CN,CPO,CUR,CWE,CST,CEN,CTE
     5+C
    29 $INCLUDE IOCCOM.INCL 
     1+C
     2+      LOGICAL*2 BLKLIN,NOINPT,RESTART,WIZARD 
     3+C
     4+      INTEGER*2 CRT,LU 
     5+C
     6+      REAL*4 REVISION
     7+C
     8+      COMMON /IOCCOM/ CRT,LU,BLKLIN,NOINPT,REVISION,RESTART,WIZARD 
     9+C
    30 $INCLUDE LINCOM.INCL 
     1+C
     2+      INTEGER*2 LINES
     3+C
     4+      COMMON /LINCOM/ LINES(28000) 
     5+C
    31 C
    32       N=WORD 
    33 D     WRITE(CRT,1000) N
    34 D1000 FORMAT("Subroutine 'SPEK' entered with N = ",I5) 
    35       IF(N.EQ.0) RETURN
    36       IF(BLKLIN.AND.NOINPT) WRITE(CRT,'(" ")') 
    37       NOINPT=.TRUE.
1 
 Page 2   SPEK              Opts: 77/LYI         Mon, Sep 29, 2025, 11:43 AM  
                                                  AIOSUB.FTN::ADVEN425
  
    38       PNT=LINES(N) 
    39       OLDPNT = PNT 
    40  1010 N=N+1
    41       L=LINES(N)+N 
    42       IF(LINES(N).LT.1 .OR. LINES(N).GT.44) CALL BUG(28) 
    43       N=N+1
    44       IF(LINES(N).NE.EOF) WRITE(CRT,1020) (LINES(I),I=N,L) 
    45       N=L+1
    46       PNT=LINES(N) 
    47       IF(PNT .EQ. OLDPNT) GO TO 1010 
    48  1020 FORMAT(44A2) 
    49       RETURN 
    50       END
  
