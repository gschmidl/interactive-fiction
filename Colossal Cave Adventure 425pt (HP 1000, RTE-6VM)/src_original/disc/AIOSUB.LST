    51 $EMA /TRVCOM/, /LINCOM/, /VOCCOM/
    52       SUBROUTINE PSPEK(MSG,SKIP),Skip and Print Message <250929.1142>
    53 C
    54 C  FIND THE SKIP+1ST MESSAGE FOR OBJECT MSG AND PRINT IT.
    55 C  MSG SHOULD BE THE INDEX OF THE OBJECT.
    56 C  (INVEN+N+1 MESSAGE IS PROP=N MESSAGE).
    57 C
    58       IMPLICIT NONE
    59 C
    60 $INCLUDE TXTCOM.INCL 
     1+C
     2+      INTEGER*2 ASCVAR,MAXWORD,LTEXT,STEXT,RTEXT 
     3+      INTEGER*2 PTEXT,MTEXT
     4+C
     5+      COMMON /TXTCOM/ ASCVAR,MAXWORD,PTEXT(100),MTEXT(35), 
     6+     &                LTEXT(150),STEXT(150),RTEXT(230) 
     7+C
    61 $INCLUDE LINCOM.INCL 
     1+C
     2+      INTEGER*2 LINES
     3+C
     4+      COMMON /LINCOM/ LINES(28000) 
     5+C
    62 $INCLUDE IOCCOM.INCL 
     1+C
     2+      LOGICAL*2 BLKLIN,NOINPT,RESTART,WIZARD 
     3+C
     4+      INTEGER*2 CRT,LU 
     5+C
     6+      REAL*4 REVISION
     7+C
     8+      COMMON /IOCCOM/ CRT,LU,BLKLIN,NOINPT,REVISION,RESTART,WIZARD 
     9+C
    63 C
    64       INTEGER*2 I,J,L,M,MSG,SKIP,PNT,OLDPNT
    65 C
    66 D     WRITE(CRT,1000) MSG,SKIP 
    67 D1000 FORMAT("Subroutine 'PSPEK' entered with MSG = ",I5,
    68 D    &  "    SKIP = ",I5)
    69       M=PTEXT(MSG) 
    70       IF(SKIP.LT.0) GO TO 1020 
    71       OLDPNT=MSG 
    72       DO I=1,SKIP+1
    73  1010   M=M+1
    74         M=LINES(M)+M+1 
    75         PNT=LINES(M) 
    76         L=LINES(M+1) 
    77         IF(L.LT.1 .OR. L.GT.44) CALL BUG(28) 
    78 D       WRITE(CRT,2000) M,PNT,(LINES(J),J=M+2,M+L+1) 
    79 D2000   FORMAT("PSPEK: M=",I6,"  PNT=",I6,2X,44A2) 
    80         IF(PNT .EQ. OLDPNT) GO TO 1010 
    81         OLDPNT=PNT 
    82       ENDDO
    83 C
    84  1020 CALL SPEK(M) 
1 
