PROBE4.
$USER,INSTALL,INSTALL.
$NORERUN.
$SETTL,7777.
$SETJSL,7777.
$SETASL,7777.
$RFL,140000.
$FTN(I=INPUT,L=0)
LGO.
***
*** PROBE4 COMPLETE
***
EXIT.
***
*** PROBE4 FAILED
***
~eor
      PROGRAM PROBE4(OUTPUT)
      IMPLICIT INTEGER(A-Z)
      DIMENSION FRST(20)
C  JDATE AND CLOCK, WHICH DATIME TAKES APART
      CALL JDATE(J)
      PRINT 1,J
1     FORMAT(" JDATE ",O20)
      PRINT 2,J
2     FORMAT(" JDATE R10 [",R10,"]")
      CALL CLOCK(K)
      PRINT 3,K
3     FORMAT(" CLOCK ",O20)
      PRINT 4,K
4     FORMAT(" CLOCK R10 [",R10,"]")
      I=SHIFT(J,42).AND.77777700000000000000B
      DECODE(3,10,I)D
10    FORMAT(I3)
      PRINT 5,D
5     FORMAT(" DAY OF YEAR ",I6)
C  ONES COMPLEMENT: WHAT DOES UNARY MINUS DO TO A MASK
      MASKC=MASK(18)
      PRINT 6,MASKC
6     FORMAT(" MASK18   ",O20)
      MASKC=-MASKC
      PRINT 7,MASKC
7     FORMAT(" -MASK18  ",O20)
      L=1
      PRINT 8,-L
8     FORMAT(" -1       ",O20)
C  THE LIBRARY BIT FUNCTIONS
      A=7777777777B
      B=77B
      PRINT 9,OR(A,B),AND(A,B),XOR(A,B),COMPL(A)
9     FORMAT(" OR ",O20,/," AND ",O20,/," XOR ",O20,/," COMPL ",O20)
C  A QUOTED CONSTANT, AND AN nH WITH NOTHING AFTER IT
      W1="BEG"
      W2=3HBEG
      W3=10H
      PRINT 11,W1,W2,W3
11    FORMAT(" QUOTED ",O20,/," HOLL ",O20,/," 10H ",O20)
C  X WITHOUT A REPEAT COUNT, AND 8A10 OUTPUT
      PRINT 12,W1,W2
12    FORMAT(" ",X,2A10,"|")
C  LIST DIRECTED OUTPUT, WHICH THE PROGRAM USES FOR TWO MESSAGES
      PRINT*,"IT WILL BLOW^*^*^*"
      PRINT*,123,456
      END
