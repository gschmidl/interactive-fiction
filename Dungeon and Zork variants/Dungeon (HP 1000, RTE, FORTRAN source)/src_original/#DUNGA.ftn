FTN4X,L
C
C DUNGEON-- MAIN PROGRAM
C
        PROGRAM DUNGN (4,90)
C
C DECLARATIONS
C
        IMPLICIT INTEGER (A-Z)
C
C 1) CHECK FOR PROTECTION VIOLATION (INCL. IN INIT)
C 2) INITIALIZE DATA STRUCTURES
C 3) PLAY GAME
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INLINE(78),INLNT
C
C SEGMENTATION PARAMETERS & RESULT
C
      LOGICAL IZRESZ
      COMMON /SEG/ IZP1,IZP2,IZP3,IZRESZ
C
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
        INTEGER IPRAM(5)
        EQUIVALENCE (IPRAM(1),LU)
        INTEGER DUNGB(3)
        DATA DUNGB / 'DUNGB ' /
        CALL RMPAR (IPRAM)
        IF (LU .LE. 0) LU = 1
        OUTCH = LU
        INPCH = LU
C
C INIT
        CALL DLINK(DUNGB ,0,0,0)        !INITIALIZATION FAILURE?
        IF (IZRESZ) CALL GAME
        CALL EXEC(6)
        END
        BLOCK DATA A
        IMPLICIT INTEGER (A-Z)
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INLINE(78),INLNT
C
C SEGMENTATION PARAMETERS & RESULT
C
      LOGICAL IZRESZ
      COMMON /SEG/ IZP1,IZP2,IZP3,IZRESZ
C
C PARSER STATE
C
        COMMON /ORPHS/ OFLAG,OACT,OSLOT,OPREP,ONAME
        COMMON /LAST/ LASTIT
        COMMON /PV/ ACT,OBJ1,OBJ2,PREP1,PREP2
        COMMON /SYNTX/ SYN(11)
        COMMON /SYNFG/ SDIR,SIND,SSTD,SFLIP,SDRIV,SVMASK
        COMMON /OBJFG/ VABIT,VRBIT,VTBIT,VCBIT,VEBIT,VPMASK
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,
     1       LTSHFT,BLOC,MUNGRM,HS
C
C MESSAGE INDEX
C
        COMMON /RMSG/ MLNT,RTEXT(800)
C
C MISCELLANEOUS VARIABLES
C
        COMMON /STAR/ MBASE,STRBIT
        COMMON /VERS/ VMAJ,VMIN,VEDIT
        COMMON /TIME/ PLTIME,SHOUR,SMIN,SSEC
        COMMON /BATS/ BATDRP(9)
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
        COMMON /DEBUG/ DBGFLG,PRSFLG
C
C ROOMS
C
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
C
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE
C
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA
C
        COMMON /RINDX/ WHOUS,LROOM,CELLA
        COMMON /RINDX/ MTROL,MAZE1
        COMMON /RINDX/ MGRAT,MAZ15
        COMMON /RINDX/ FORE1,CLEAR,RESER
        COMMON /RINDX/ STREA,EGYPT,ECHOR
        COMMON /RINDX/ TSHAF
        COMMON /RINDX/ BSHAF,MMACH,DOME,MTORC
        COMMON /RINDX/ CAROU
        COMMON /RINDX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT
        COMMON /RINDX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL
        COMMON /RINDX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR
        COMMON /RINDX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4
        COMMON /RINDX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER
        COMMON /RINDX/ CAGED,TWELL,BWELL,ALICE,ALISM,ALITR
C
C EXITS
C
        COMMON /EXITS/ XLNT,TRAVEL(600)
C
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ
        EQUIVALENCE (XFLAG,XOBJ)
C
        COMMON /XPARS/ XRMASK,XDMASK,XFMASK,XFSHFT,XASHFT,
     1       XELNT(4),XNORM,XNO,XCOND,XDOOR,XLFLAG
C
        COMMON /XSRCH/ XMIN,XMAX,XDOWN
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)

        COMMON /OROM2/ R2LNT,O2(6),R2(6)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
        COMMON /OINDX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL
        COMMON /OINDX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG
        COMMON /OINDX/ LEAVE,TROLL,AXE
        COMMON /OINDX/ RKNIF,KEYS,ICE,BAR
        COMMON /OINDX/ COFFI,TORCH,TBASK,FBASK,IRBOX
        COMMON /OINDX/ GHOST,TRUNK,BELL,BOOK,CANDL
        COMMON /OINDX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI
        COMMON /OINDX/ THIEF,STILL,WINDO,GRATE,DOOR
        COMMON /OINDX/ HPOLE,LEAK,RBUTT,RAILI
        COMMON /OINDX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT
        COMMON /OINDX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO
        COMMON /OINDX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE
        COMMON /OINDX/ GNOME,BLABE,DBALL
        COMMON /OINDX/ LCASE,CAGE,RCAGE,SPHER,SQBUT
        COMMON /OINDX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE
        COMMON /OINDX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH
        COMMON /OINDX/ ITOBJ,EVERY,VALUA,OPLAY
C
C CLOCK INTERRUPTS
C
        LOGICAL CFLAG
        COMMON /CEVNT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)
C
        COMMON /CINDX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH
C
C VILLAINS AND DEMONS
C
        LOGICAL THFFLG,SWDACT,THFACT
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA
        COMMON /VILL/ VLNT,VILLNS(5),VPROB(5),VOPPS(5)
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
        COMMON /AFLGS/ ASTAG
C
        COMMON /AINDX/ PLAYER,AROBOT
C
C VERBS
C
        COMMON /VINDX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW
        COMMON /VINDX/ WALKIW,FIGHTW,FOOW
        COMMON /VINDX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW
        COMMON /VINDX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW
        COMMON /VINDX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW
        COMMON /VINDX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW
        COMMON /VINDX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW
        COMMON /VINDX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW
        COMMON /VINDX/ MUNGW,KILLW,ATTACW,SWINGW
        COMMON /VINDX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW
        COMMON /VINDX/ DIGW,LEAPW
C
C FLAGS
C
        LOGICAL FLAGS(33)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF
        LOGICAL GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,
     5       GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ BTIEF,BINFF
        EQUIVALENCE (FLAGS(1),TROLLF)
C
C RADIX-50 VOCABULARIES
C
        COMMON /BUZVC/ BVOC(20)
        COMMON /PRPVC/ PVOC(47)
        COMMON /DIRVC/ DVOC(90)
        INTEGER AVOC(264)
        COMMON /ADJVC/ AVOC1(158),AVOC2(105),AVOCND
        INTEGER VVOC(818)
        COMMON /VRBVC/ VVOC1(94),VVOC1A(100),VVOC2(80),VVOC3(119),
     1          VVOC4(118),VVOC5(116),VVOC6(107),VVOC7(83),VVOCND
        INTEGER OVOC(797)
        COMMON /OBJVC/ OVOC1(150),OVOC2(135),OVOC3(140),OVOC4(117),
     1          OVOC5(106),OVOC6(97),OVOC7(51),OVOCND
C
        EQUIVALENCE (VVOC(1),VVOC1(1))
        EQUIVALENCE (AVOC(1),AVOC1(1))
        EQUIVALENCE (OVOC(1),OVOC1(1))
C
C DATA STATEMENTS FOR CONSTANT ARRAYS
C
        DATA VMAJ/3/,VMIN/0/,VEDIT/'A'/
C
        DATA SDIR/40000B/,SIND/20000B/,SSTD/10000B/,
     1       SFLIP/4000B/,SDRIV/2000B/,SVMASK/777B/
        DATA VABIT/40000B/,VRBIT/20000B/,VTBIT/10000B/,
     1       VCBIT/4000B/,VEBIT/2000B/,VPMASK/777B/
C
        DATA BATDRP/66,67,68,69,70,71,72,65,73/
C
        DATA CEVCUR/1/,CEVMNT/2/,CEVLNT/3/,CEVMAT/4/,
     1       CEVCND/5/,CEVBAL/6/,CEVBRN/7/,CEVFUS/8/,
     2       CEVLED/9/,CEVSAF/10/,CEVVLG/11/,CEVGNO/12/,
     3       CEVBUC/13/,CEVSPH/14/,CEVEGH/15/
C
        DATA XRMASK/377B/,XDMASK/76000B/,XFMASK/3/
        DATA XFSHFT/256/,XASHFT/256/
        DATA XNORM/1/,XNO/2/,XCOND/3/,XDOOR/4/
        DATA XELNT/1,2,3,3/,XLFLAG/100000B/
        DATA XMIN/2000B/,XMAX/40000B/,XDOWN/24000B/
C
        DATA PLAYER/1/,AROBOT/2/
        DATA ASTAG/100000B/
C
        DATA RSEEN/100000B/,RLIGHT/40000B/,RLAND/20000B/
        DATA RWATER/10000B/,RAIR/4000B/,RSACRD/2000B/,RFILL/1000B/
        DATA RMUNG/400B/,RBUCK/200B/,RHOUSE/100B/
C
        DATA WHOUS/2/,LROOM/8/,CELLA/9/
        DATA MTROL/10/,MAZE1/11/
        DATA MGRAT/25/,MAZ15/30/
        DATA FORE1/31/,CLEAR/36/,RESER/40/
        DATA STREA/42/,EGYPT/44/,ECHOR/49/
        DATA TSHAF/61/
        DATA BSHAF/76/,MMACH/77/,DOME/79/,MTORC/80/
        DATA CAROU/83/
        DATA RIDDL/91/,LLD2/94/,TEMP1/96/,TEMP2/97/,MAINT/100/
        DATA MCYCL/101/,BLROO/102/,TREAS/103/,RIVR1/107/,RIVR2/108/
        DATA    RIVR3/109/
        DATA RIVR4/112/,RIVR5/113/,FCHMP/114/,MBARR/119/,FALLS/120/
        DATA MRAIN/121/,POG/122/,VLBOT/126/,VAIR1/127/,VAIR2/128/
        DATA    VAIR3/129/,VAIR4/130/
        DATA LEDG2/131/,LEDG3/132/,LEDG4/133/,MSAFE/135/,CAGER/140/
        DATA CAGED/141/,TWELL/142/,BWELL/143/,ALICE/144/,ALISM/145/
        DATA    ALITR/146/
C
        DATA CINTW/1/,DEADXW/2/,FRSTQW/3/,INXW/4/
        DATA OUTXW/5/,WALKIW/6/,FIGHTW/7/,FOOW/8/
C
        DATA READW/100/,MELTW/101/
        DATA INFLAW/102/,DEFLAW/103/,ALARMW/104/,EXORCW/105/
        DATA PLUGW/106/,KICKW/107/,WAVEW/108/,RAISEW/109/,LOWERW/110/
        DATA RUBW/111/,PUSHW/112/,UNTIEW/113/,TIEW/114/,TIEUPW/115/
        DATA TURNW/116/,BREATW/117/,KNOCKW/118/,LOOKW/119/
        DATA EXAMIW/120/,SHAKEW/121/,MOVEW/122/,TRNONW/123/,TRNOFW/124/
        DATA OPENW/125/,CLOSEW/126/,FINDW/127/,WAITW/128/,SPINW/129/
        DATA BOARDW/130/,UNBOAW/131/,TAKEW/132/,INVENW/133/
        DATA FILLW/134/,EATW/135/,DRINKW/136/,BURNW/137/
        DATA MUNGW/138/,KILLW/139/,ATTACW/141/
        DATA SWINGW/140/,WALKW/142/,TELLW/143/,PUTW/144/
        DATA DROPW/145/,GIVEW/146/,POURW/147/,THROWW/148/
C
        DATA DIGW/89/,LEAPW/91/
C
      DATA VISIBT/100000B/,READBT/40000B/,TAKEBT/20000B/,
     1 DOORBT/10000B/,
     1   TRANBT/4000B/,FOODBT/2000B/,NDSCBT/1000B/,DRNKBT/400B/,
     2       CONTBT/200B/,LITEBT/100B/,VICTBT/40B/,BURNBT/20B/,
     3       FLAMBT/10B/,TOOLBT/4B/,TURNBT/2B/,ONBT/1B/
C
        DATA FINDBT/100000B/,SLEPBT/40000B/,SCRDBT/20000B/,
     1 TIEBT/10000B/,
     1    ECHOBT/4000B/,ACTRBT/2000B/,WEAPBT/1000B/,FITEBT/400B/,
     2       VILLBT/200B/,STAGBT/100B/,TRYBT/40B/,NOCHBT/20B/,
     3       OPENBT/10B/,TCHBT/4B/,VEHBT/2B/,SCHBT/1B/
C
        DATA GARLI/2/,FOOD/3/,GUNK/4/,COAL/5/,MACHI/7/,DIAMO/8/
        DATA    TCASE/9/,BOTTL/10/
        DATA WATER/11/,ROPE/12/,KNIFE/13/,SWORD/14/,LAMP/15/,BLAMP/16/
        DATA    RUG/17/,LEAVE/18/,TROLL/19/,AXE/20/
        DATA RKNIF/21/,KEYS/23/,BAR/26/,ICE/30/
        DATA COFFI/33/,TORCH/34/,TBASK/35/,FBASK/36/,IRBOX/39/
        DATA GHOST/42/,TRUNK/45/,BELL/46/,BOOK/47/,CANDL/48/
        DATA MATCH/51/,TUBE/54/,PUTTY/55/,WRENC/56/,SCREW/57/
        DATA    CYCLO/58/,CHALI/59/
        DATA THIEF/61/,STILL/62/,WINDO/63/,GRATE/65/,DOOR/66/
        DATA HPOLE/71/,RBUTT/79/,LEAK/78/,RAILI/75/
        DATA POT/85/,STATU/86/,IBOAT/87/,DBOAT/88/,PUMP/89/,RBOAT/90/
        DATA STICK/92/,BUOY/94/,SHOVE/96/,GUANO/97/,BALLO/98/,RECEP/99/
        DATA BROPE/101/,HOOK1/102/,HOOK2/103/,SAFE/105/,SSLOT/107/
        DATA    BRICK/109/,FUSE/110/
        DATA GNOME/111/,BLABE/112/,DBALL/113/
        DATA LCASE/123/,CAGE/124/,RCAGE/125/,SPHER/126/,SQBUT/127/
        DATA FLASK/132/,POOL/133/,SAFFR/134/,BUCKE/137/,ORICE/139/
        DATA    ECAKE/138/,RDICE/140/
        DATA BLICE/141/,ROBOT/142/,ITOBJ/144/,OPLAY/145/,EVERY/146/
        DATA    VALUA/147/,SAILO/148/,TEETH/149/
        DATA LUNGS/153/,AVIAT/154/
         END
C GAME- MAIN COMMAND LOOP FOR DUNGEON
C
C DECLARATIONS
C
        SUBROUTINE GAME
        IMPLICIT INTEGER (A-Z)
        LOGICAL F
        INTEGER SECHO(4),GRDSTR(6),DUNGC(3),DUNGD(3),DUNGF(3)
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INLINE(78),INLNT
C
C SEGMENTATION PARAMETERS & RESULT
C
      LOGICAL IZRESZ
      COMMON /SEG/ IZP1,IZP2,IZP3,IZRESZ
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,
     1       LTSHFT,BLOC,MUNGRM,HS
C
C MISCELLANEOUS VARIABLES
C
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
C
C ROOMS
C
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
C
        COMMON /RINDX/ WHOUS,LROOM,CELLA
        COMMON /RINDX/ MTROL,MAZE1
        COMMON /RINDX/ MGRAT,MAZ15
        COMMON /RINDX/ FORE1,CLEAR,RESER
        COMMON /RINDX/ STREA,EGYPT,ECHOR
        COMMON /RINDX/ TSHAF
        COMMON /RINDX/ BSHAF,MMACH,DOME,MTORC
        COMMON /RINDX/ CAROU
        COMMON /RINDX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT
        COMMON /RINDX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL
        COMMON /RINDX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR
        COMMON /RINDX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4
        COMMON /RINDX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER
        COMMON /RINDX/ CAGED,TWELL,BWELL,ALICE,ALISM,ALITR
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
        COMMON /OINDX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL
        COMMON /OINDX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG
        COMMON /OINDX/ LEAVE,TROLL,AXE
        COMMON /OINDX/ RKNIF,KEYS,ICE,BAR
        COMMON /OINDX/ COFFI,TORCH,TBASK,FBASK,IRBOX
        COMMON /OINDX/ GHOST,TRUNK,BELL,BOOK,CANDL
        COMMON /OINDX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI
        COMMON /OINDX/ THIEF,STILL,WINDO,GRATE,DOOR
        COMMON /OINDX/ HPOLE,LEAK,RBUTT,RAILI
        COMMON /OINDX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT
        COMMON /OINDX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO
        COMMON /OINDX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE
        COMMON /OINDX/ GNOME,BLABE,DBALL
        COMMON /OINDX/ LCASE,CAGE,RCAGE,SPHER,SQBUT
        COMMON /OINDX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE
        COMMON /OINDX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH
        COMMON /OINDX/ ITOBJ,EVERY,VALUA,OPLAY
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
        COMMON /AINDX/ PLAYER,AROBOT
C
C VERBS
C
        COMMON /VINDX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW
        COMMON /VINDX/ WALKIW,FIGHTW,FOOW
        COMMON /VINDX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW
        COMMON /VINDX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW
        COMMON /VINDX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW
        COMMON /VINDX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW
        COMMON /VINDX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW
        COMMON /VINDX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW
        COMMON /VINDX/ MUNGW,KILLW,ATTACW,SWINGW
        COMMON /VINDX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW
        COMMON /VINDX/ DIGW,LEAPW
C
C FLAGS
C
        LOGICAL FLAGS(33)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF
        LOGICAL GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,
     5       GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ BTIEF,BINFF
        EQUIVALENCE (FLAGS(1),TROLLF)
C
        DATA SECHO/'E','C','H','O'/
        DATA GRDSTR/'G','U','A','R','D','I'/
        DATA DUNGC /'DUNGC '/
        DATA DUNGD /'DUNGD '/
        DATA DUNGF /'DUNGF '/
C
C START UP, DESCRIBE CURRENT LOCATION.
C
        CALL RSPEK(1)                           !WELCOME ABOARD.
C RINFO
        CALL DLINK(DUNGF ,2HRI,.TRUE.,0)     !START GAME.
        F=IZRESZ
C
C NOW LOOP, READING AND EXECUTING COMMANDS.
C
100     WINNER=PLAYER                           !PLAYER MOVING.
        TELFLG=.FALSE.                          !ASSUME NOTHING TOLD.
        CALL RDLIN(1)                          !READ COMMAND.
C
        DO 150 I=1,6                            !CALL ON GUARDIAN?
          IF(INLINE(I).NE.GRDSTR(I)) GO TO 200
150     CONTINUE
C GUARD
        CALL DLINK(DUNGD ,0,0,0)              !YES, INVOKE.
        GO TO 100                               !ONWARD.
C
200     MOVES=MOVES+1
C PARSE
        CALL DLINK(DUNGC ,0,0,0)              !PARSE INPUT.
        PRSWON=IZRESZ
        IF(.NOT.PRSWON) GO TO 400               !PARSE LOSES?
C VEHIC
        CALL DLINK(DUNGF ,2HVE,1,0)           !VEHICLE HANDLE?
        IF(IZRESZ) GO TO 400
C
        F=(PRSA.EQ.LOOKW)
        IF(PRSA.EQ.TELLW) GO TO 2000            !TELL?
300     IF((PRSO.EQ.VALUA).OR.(PRSO.EQ.EVERY)) GO TO 900
C VAPPL
        CALL DLINK(DUNGF ,2HVA,PRSA,0)        !VERB OK?
        IF(.NOT. IZRESZ) GO TO 400
350     IF(.NOT.ECHOF.AND.(HERE.EQ.ECHOR)) GO TO 1000
C
C       IF(.NOT.F.AND.RACTIO(HERE).NE.0) F=RAPPL(RACTIO(HERE))
        IF ((F) .OR. (RACTIO(HERE).EQ.0)) GO TO 400
        CALL DLINK(DUNGF ,2HRA,RACTIO(HERE),0)
        F = IZRESZ
C
C ENDMV
400     CALL DLINK(DUNGF ,2HEN,TELFLG,0)      !DO END OF MOVE.
        GO TO 100
C
C VALUC
900     CALL DLINK(DUNGF ,2HVC,VALUA,0)       !SPECIAL OBJECT.
        GO TO 350
C
C SPECIAL CASE-- ECHO ROOM.
C IF INPUT IS NOT "ECHO" OR A DIRECTION, JUST ECHO.
C
1000    CALL RDLIN(0)                           !READ LINE.
        MOVES=MOVES+1                           !CHARGE FOR MOVES.
        DO 1100 I=1,4                           !INPUT = ECHO?
          IF(INLINE(I).NE.SECHO(I)) GO TO 1300
1100    CONTINUE
C
        DO 1200 I=5,78                          !REST BLANK?
          IF(INLINE(I).NE.2H  ) GO TO 1300
1200    CONTINUE
C
        CALL RSPEK(571)                         !KILL THE ECHO.
        ECHOF=.TRUE.
        OFLAG2(BAR)=AND(OFLAG2(BAR),COMPL(SCRDBT)) !LET THIEF STEAL BAR.
        PRSWON=.TRUE.                           !FAKE OUT PARSER.
        GO TO 400
C
1300    CALL DLINK(DUNGC ,0,0,0)              !PARSE INPUT.
        PRSWON = IZRESZ
        IF(.NOT.PRSWON .OR. (PRSA.NE.WALKW) .OR. (PRSO.EQ.0))
     1       GO TO 1400                         !WALK?
C FNDXT
        CALL DLINK(DUNGF ,2HFN,PRSO,HERE)     !VALID EXIT?
        IF(IZRESZ) GO TO 300
C
C1400   WRITE(OUTCH,1410) (INLINE(J),J=1,INLNT) !ECHO INPUT
C1410   FORMAT(1X,78A1)
 1400   CALL A1A2(INLINE,78)
        CALL REIO(2,OUTCH,INLINE,39)
        TELFLG=.TRUE.                           !INDICATE OUTPUT.
        GO TO 1000                              !MORE ECHO ROOM.
C
C SPECIAL CASE-- TELL <ACTOR> "NEW COMMAND"
C NOTE THAT WE CANNOT BE IN THE ECHO ROOM.
C
2000    IF(AND(OFLAG2(PRSO),ACTRBT).NE.0) GO TO 2100 !ACTOR?
        CALL RSPEK(602)                         !CANT DO IT.
        GO TO 350                               !VAPPL SUCCEEDS.
C
2100    WINNER=ORAND(PRSO)                      !NEW PLAYER.
        HERE=AROOM(WINNER)                      !NEW LOCATION.
        CALL RDLIN (WINNER)                     !GET NEW COMMAND.
C PARSE
        CALL DLINK(DUNGC ,0,0,0)              !PARSE COMMAND.
        IF(IZRESZ) GO TO 2150
2700    I=341                                   !FAILS.
        IF(TELFLG) I=604                        !GIVE RESPONSE.
        CALL RSPEK(I)
2600    WINNER=PLAYER                           !RESTORE STATE.
        HERE=AROOM(WINNER)
        GO TO 350
C
2150    RA=AACTIO(WINNER)                       !GET ACTOR'S ACTION.
        IF(RA.EQ.0) GO TO 2175
C AAPPL
        CALL DLINK(DUNGF ,2HAA,RA,0)          !ACTOR HANDLE?
        IF(IZRESZ) GO TO 2400
C VEHIC
2175    CALL DLINK(DUNGF ,2HVE,1,0)           !VEHICLE HANDLE?
        IF (IZRESZ) GO TO 2400
        IF((PRSO.EQ.VALUA).OR.(PRSO.EQ.EVERY)) GO TO 2900
C VAPPL
        CALL DLINK(DUNGF ,2HVA,PRSA,0)        !VERB HANDLE?
        IF (.NOT. IZRESZ) GO TO 2400
C350    IF(RACTIO(HERE).NE.0) F=RAPPL(RACTIO(HERE))
2350    IF(RACTIO(HERE).EQ.0) GO TO 2400
        CALL DLINK(DUNGF ,2HRA,RACTIO(HERE),0)
        F=IZRESZ
C
C ENDMV
2400    CALL DLINK(DUNGF ,2HEN,TELFLG,0)      !DO END OF MOVE.
        GO TO 2600                              !DONE.
C
C VALUC
2900    CALL DLINK(DUNGF ,2HVC,VALUA,0)
        GO TO 2350
C
        END
C RDLIN-       READ INPUT LINE
C
C DECLARATIONS
C
        SUBROUTINE RDLIN (WHO)
        IMPLICIT INTEGER(A-Z)
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INLINE(78),INLNT
C
        GO TO (90,10,20),WHO+1                  !SEE WHO TO PROMPT FOR.
10      CALL REIO (2,OUTCH,4H >_ ,-3)           !PROMPT FOR GAME.
        GO TO 90
C
20      CALL REIO (2,OUTCH,14H Yes, master>_,-14)  !PROMPT FOR ROBOT.
C
C90     READ(INPCH,100) INLINE                  !GET INPUT.
C100    FORMAT(78A1)
 90     DO 100 INLNT=1,78
100     INLINE(INLNT)=2H
        CALL REIO(1,INPCH+400B,INLINE,39)
        CALL A2A1(INLINE,78)
        DO 200 INLNT=0,77
          IF(INLINE(78-INLNT).NE.2H  ) GO TO 300     !NOT BLANK?
200     CONTINUE
        GO TO 10                                !TRY AGAIN.
C
300     INLNT=78-INLNT
        RETURN
        END
C RSPEAK-- OUTPUT RANDOM MESSAGE ROUTINE
C
C CALLED BY--
C
C       CALL RSPEK(MSGNUM)
C
        SUBROUTINE RSPEK(N)
        IMPLICIT INTEGER(A-Z)
C
        CALL RSPS2(N,0,0)
        RETURN
        END
C RSPSUB-- OUTPUT RANDOM MESSAGE WITH SUBSTITUTABLE ARGUMENT
C
C CALLED BY--
C
C       CALL RSPSB(MSGNUM,SUBNUM)
C
        SUBROUTINE RSPSB(N,S1)
        IMPLICIT INTEGER(A-Z)
C
        CALL RSPS2(N,S1,0)
        RETURN
        END
C RSPSB2-- OUTPUT RANDOM MESSAGE WITH SUBSTITUTABLE ARGUMENTS
C
C CALLED BY--
C
C       CALL RSPS2(MSGNUM,S1,S2)
C
        SUBROUTINE RSPS2(A,B,C)
        IMPLICIT INTEGER(A-Z)
C
C DECLARATIONS
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
C
        COMMON /RMSG/ MLNT,RTEXT(800)
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
        INTEGER B1(78),B2(78),IBUFZ(79)
C
C CONVERT ALL ARGUMENTS FROM DICTIONARY NUMBERS (IF POSITIVE)
C TO ABSOLUTE RECORD NUMBERS.
C
        X=A                                     !SET UP WORK VARIABLES.
        Y=B
        Z=C
        IF(X.GT.0) X=RTEXT(X)                   !IF >0, LOOK UP IN RTEXT
        IF(Y.GT.0) Y=RTEXT(Y)
        IF(Z.GT.0) Z=RTEXT(Z)
        X=IABS(X)                               !TAKE ABS VALUE.
        Y=IABS(Y)
        Z=IABS(Z)
        IF(X.EQ.0) RETURN                       !ANYTHING TO DO?
        TELFLG=.TRUE.                           !SAID SOMETHING.
C
        CALL READF (IDCBT,IERR,IBUFZ,79,IL,X)   !READ FIRST LINE.
        OLDREC=IBUFZ(1)
        DO 99873 IL=2,79
99873   B1(IL-1)=IBUFZ(IL)
200     IF(Y.EQ.0) GO TO 400                    !ANY SUBSTITUTABLE?
        DO 300 I=1,78                           !YES, LOOK FOR #.
          IF(B1(I).EQ.2H# ) GO TO 1000
300     CONTINUE
C
400     DO 500 I=0,77                           !BACKSCAN FOR BLANKS.
          IF(B1(78-I).NE.2H  ) GO TO 600
500     CONTINUE
600    I=78-I
C       WRITE(OUTCH,650) B1                     !OUTPUT LINE.
C650    FORMAT(1X,78A1)
        CALL A1A2 (B1,78)
        CALL REIO (2,OUTCH,B1,39)
675     X=X+1                                   !ON TO NEXT RECORD.
        CALL READF(IDCBT,IERR,IBUFZ,79,IL,X)    !READ NEXT RECORD.
        NEWREC=IBUFZ(1)
        DO 99872 IL=2,79
99872   B1(IL-1)=IBUFZ(IL)
        IF(OLDREC.NE.NEWREC) RETURN             !CONTINUATION?
        IF (B1(1).NE.2H\ ) GO TO 200
        CALL REIO (2,OUTCH,24HHIT RETURN TO CONTINUE_ ,-23)
        CALL REIO (1,OUTCH,IDUMMY,1)
        GO TO 675
C
C SUBSTITUTION WITH SUBSTITUTABLE AVAILABLE.
C I IS INDEX OF # IN B1.
C Y IS NUMBER OF RECORD TO SUBSTITUTE.
C
C PROCEDURE:
C   1) COPY REST OF B1 TO B2
C   2) READ SUBSTITUTABLE OVER B1
C   3) RESTORE TAIL OF ORIGINAL B1
C
C THE IMPLICIT ASSUMPTION HERE IS THAT THE SUBSTITUTABLE STRING
C IS VERY SHORT.
C
1000    K2=1                                    !TO
        DO 1100 K1=I+1,78                       !COPY REST OF B1.
          B2(K2)=B1(K1)
          K2=K2+1
1100    CONTINUE
C
        CALL READF(IDCBT,IERR,IBUFZ,79,IL,Y) !READ SUB RECORD.
        J=IBUFZ(1)
        IL=I-2
        DO 99871 K1=I,78
99871   B1(K1)=IBUFZ(K1-IL)
C
        DO 1200 J=0,77                       !ELIM TRAILING BLANKS.
          IF(B1(78-J).NE.2H  ) GO TO 1300
1200    CONTINUE
1300   J=78-J
        K1=1                                    !FROM
        DO 1400 K2=J+1,78                       !COPY REST OF B1 BACK.
          B1(K2)=B2(K1)
          K1=K1+1
1400    CONTINUE
C
        Y=Z                                     !SET UP FOR NEXT
        Z=0                                     !SUBSTITUTION AND
        GO TO 200                               !RECHECK LINE.
C
        END
        INTEGER FUNCTION RND(X)
C
C GENERATES RANDOM INTEGER FROM 0 TO X-1 INCLUSIVE.
C
        INTEGER X
C
        RND = INT(FLOAT(X) * URAN(1))
        END
$
