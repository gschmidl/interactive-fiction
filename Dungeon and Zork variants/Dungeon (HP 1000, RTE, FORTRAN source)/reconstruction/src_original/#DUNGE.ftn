FTN4X,L
      PROGRAM DUNGE(5)
C
C SEGMENTATION PARAMETERS & RESULT
C
      LOGICAL IZRESZ
      COMMON /SEG/ IZP1,IZP2,IZP3,IZRESZ
C
      IF(IZP1 .EQ. 2HSA) CALL SAVGM
      IF(IZP1 .EQ. 2HRS) CALL RSTGM
C
C WE WERE CALLED BY SEGMENT F, BUT RETURN TO THE MAIN DIRECTLY.
C
      CALL RETRN
      END
C SAVGM- SAVE GAME STATE
C
C DECLARATIONS
C
        SUBROUTINE SAVGM
        IMPLICIT INTEGER (A-Z)
        INTEGER IDCBF (144)
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,
     1       LTSHFT,BLOC,MUNGRM,HS
C
C MISCELLANEOUS VARIABLES
C
        COMMON /VERS/ VMAJ,VMIN,VEDIT
        COMMON /TIME/ PLTIME,SHOUR,SMIN,SSEC
C
C ROOMS
C
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
C
C EXITS
C
        COMMON /EXITS/ XLNT,TRAVEL(600)
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
C
C CLOCK INTERRUPTS
C
        LOGICAL CFLAG
        COMMON /CEVNT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)
C
C
C VILLAINS AND DEMONS
C
        LOGICAL THFFLG,SWDACT,THFACT
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA
        COMMON /VILL/ VLNT,VILLNS(5),VPROB(5),VOPPS(5)
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
C FLAGS
C
        LOGICAL FLAGS(33)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF
        LOGICAL GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,
     5       GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ BTIEF,BINFF
        EQUIVALENCE (FLAGS(1),TROLLF)
C
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
C
        INTEGER FILEN (3)
C
        PRSWON=.FALSE.                          !DISABLE GAME.
        WRITE (OUTCH,10)
  10    FORMAT ("ENTER FILE NAME: _")
        READ (INPCH,20) FILEN
  20    FORMAT (3A2)
        CALL CREAT (IDCBF,IERR,FILEN,20,4,0,-13)
        IF (IERR.LT.0) GO TO 100
C
        CALL WRITF(IDCBF,IERR,VMAJ,3)
        CALL WRITF (IDCBF,IERR,WINNER,3)
        CALL WRITF (IDCBF,IERR,THFPOS,5)
        CALL WRITF (IDCBF,IERR,PLTIME,1)
        CALL WRITF(IDCBF,IERR,MOVES,9)
        CALL WRITF (IDCBF,IERR,ODESC1,320)
        CALL WRITF (IDCBF,IERR,OFLAG1,1440)
        CALL WRITF (IDCBF,IERR,ORAND,160)
        CALL WRITF (IDCBF,IERR,RVAL,450)
        CALL WRITF(IDCBF,IERR,AROOM,12)
        CALL WRITF(IDCBF,IERR,ASTREN,8)
        CALL WRITF(IDCBF,IERR,FLAGS,35)
        CALL WRITF(IDCBF,IERR,VPROB,5)
        CALL WRITF(IDCBF,IERR,CFLAG,20)
        CALL WRITF(IDCBF,IERR,CTICK,20)
C
        CALL CLOSE(IDCBF)
        CALL RSPEK(597)
        RETURN
C
100     CALL RSPEK(598)                         !CANT DO IT.
        RETURN
        END
C RESTORE- RESTORE GAME STATE
C
C DECLARATIONS
C
        SUBROUTINE RSTGM
        IMPLICIT INTEGER (A-Z)
        INTEGER IDCBF(144)
        INTEGER IJK(3)
        EQUIVALENCE(IJK(1),I)
        EQUIVALENCE(IJK(2),J)
        EQUIVALENCE(IJK(3),K)
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,
     1       LTSHFT,BLOC,MUNGRM,HS
C
C MISCELLANEOUS VARIABLES
C
        COMMON /VERS/ VMAJ,VMIN,VEDIT
        COMMON /TIME/ PLTIME,SHOUR,SMIN,SSEC
C
C ROOMS
C
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)
C
C EXITS
C
        COMMON /EXITS/ XLNT,TRAVEL(600)
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
C
C CLOCK INTERRUPTS
C
        LOGICAL CFLAG
        COMMON /CEVNT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)
C
C
C VILLAINS AND DEMONS
C
        LOGICAL THFFLG,SWDACT,THFACT
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA
        COMMON /VILL/ VLNT,VILLNS(5),VPROB(5),VOPPS(5)
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
C FLAGS
C
        LOGICAL FLAGS(33)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF
        LOGICAL GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,
     5       GLACMF,FROBZF,ENDGMF
        COMMON /FINDX/ BTIEF,BINFF
        EQUIVALENCE (FLAGS(1),TROLLF)
C
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
C
        INTEGER FILEN (3)
C
        PRSWON=.FALSE.                  !DISABLE GAME.
        WRITE (OUTCH,10)
  10    FORMAT ("ENTER FILE NAME: _")
        READ (INPCH,20) FILEN
  20    FORMAT (3A2)
        CALL OPEN(IDCBF,IERR,FILEN,0,0,-13)
        IF(IERR.LT.0) GO TO 100
C
        CALL READF (IDCBF,IERR,IJK,3)
        IF((I.NE.VMAJ).OR.(J.NE.VMIN)) GO TO 200
C
        CALL READF (IDCBF,IERR,WINNER,3)
        CALL READF (IDCBF,IERR,THFPOS,5)
        CALL READF (IDCBF,IERR,PLTIME,1)
        CALL READF(IDCBF,IERR,MOVES,9)
        CALL READF (IDCBF,IERR,ODESC1,320)
        CALL READF (IDCBF,IERR,OFLAG1,1440)
        CALL READF (IDCBF,IERR,ORAND,160)
        CALL READF (IDCBF,IERR,RVAL,450)
        CALL READF(IDCBF,IERR,AROOM,12)
        CALL READF(IDCBF,IERR,ASTREN,8)
        CALL READF(IDCBF,IERR,FLAGS,35)
        CALL READF(IDCBF,IERR,VPROB,5)
        CALL READF(IDCBF,IERR,CFLAG,20)
        CALL READF(IDCBF,IERR,CTICK,20)
C
        CALL CLOSE(IDCBF)
        CALL RSPEK(599)
        RETURN
C
100     CALL RSPEK(598)                         !CANT DO IT.
        RETURN
C
200     CALL RSPEK(600)                         !OBSOLETE VERSION
        CALL CLOSE(IDCBF)
        RETURN
        END
$
