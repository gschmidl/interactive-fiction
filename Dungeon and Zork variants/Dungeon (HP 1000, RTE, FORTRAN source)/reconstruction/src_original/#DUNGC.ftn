FTN4X,L
      PROGRAM DUNGC(5)
      IMPLICIT INTEGER(A-Z)
C
        LOGICAL PARSE
C
C SEGMENTATION PARAMETERS & RESULT
C
      LOGICAL IZRESZ
      COMMON /SEG/ IZP1,IZP2,IZP3,IZRESZ
C
      IZRESZ = PARSE(IZP1)
      CALL RETRN
      END
C PARSE-       TOP LEVEL PARSE ROUTINE
C
C DECLARATIONS
C
C THIS ROUTINE DETAILS ON BIT 0 OF PRSFLG
C
        LOGICAL FUNCTION PARSE(IDUM)
C
        IMPLICIT INTEGER(A-Z)
        LOGICAL LEX,SYMCH,DFLAG
        INTEGER OUTBUF(40)
        COMMON /DEBUG/ DBGFLG,PRSFLG
      COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C
        DFLAG=(PRSFLG.AND.1B).NE.0
        PARSE=.FALSE.                           !ASSUME FAILS.
        PRSA=0                                  !ZERO OUTPUTS.
        PRSI=0
        PRSO=0
C
        IF(.NOT.LEX(INBUF,INLNT,OUTBUF,OUTLNT)) GO TO 100
        IF(SPARS(OUTBUF,OUTLNT)) 100,200,300    !DO SYN SCAN.
C
C PARSE REQUIRES VALIDATION
C
200     IF(.NOT.SYMCH(X)) GO TO 100             !DO SYN MATCH.
C
C SUCCESSFUL PARSE OR SUCCESSFUL VALIDATION
C
300     CALL ORPHN(0,0,0,0,0)                   !CLEAR ORPHANS.
        PARSE=.TRUE.
100     CONTINUE
         IF (DFLAG) WRITE (OUTCH,10) PARSE,PRSA,PRSO,PRSI
 10     FORMAT(" PARSE RESULTS- ",L7,3I7)
        RETURN
        END
C ORPHAN- SET UP NEW ORPHANS
C
C DECLARATIONS
C
        SUBROUTINE ORPHN(O1,O2,O3,O4,O5)
        IMPLICIT INTEGER(A-Z)
        COMMON /ORPHS/ A,B,C,D,E
C
        A=O1                                    !SET UP NEW ORPHANS.
        B=O2
        C=O3
        D=O4
        E=O5
        RETURN
        END
C LEX- LEXICAL ANALYZER
C
C DECLARATIONS
C
C THIS ROUTINE DETAILS ON BIT 1 OF PRSFLG
C
        LOGICAL FUNCTION LEX(INBUF,INLNT,OUTBUF,OP)
        IMPLICIT INTEGER(A-Z)
        INTEGER INBUF(78),J
        INTEGER OUTBUF(40)
        LOGICAL DFLAG
        COMMON /DEBUG/ DBGFLG,PRSFLG
      COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
C
        DO 100 I=1,40                           !CLEAR OUTPUT BUF.
          OUTBUF(I)=0
100     CONTINUE
C
        DFLAG=(PRSFLG.AND.2B).NE.0
        LEX=.FALSE.                             !ASSUME LEX FAILS.
        OP=-1                                   !OUTPUT PTR.
        IP=0                                    !INPUT PTR.
50      OP=OP+2                                 !ADV OUTPUT PTR.
        CP=0                                    !CHAR PTR=0.
C
200     IP=IP+1                                 !ADV INPUT PTR,
        IF(IP.GT.INLNT) GO TO 1000              !END OF INPUT?
        J=INBUF(IP)                             !GET NEXT CHAR.
        IF(J.EQ.2H. ) GO TO 1000                 !END OF SENTENCE?
        IF(J.EQ.2H  ) GO TO 6000                         !SPACE?
        J1=G50(J)                                      !CONVERT TO R50
        IF(J1.NE.0) GO TO 4000
C
        CALL RSPEK(601)                         !GREEK TO ME, FAIL.
        RETURN
C
C END OF INPUT, SEE IF PARTIAL WORD AVAILABLE.
C
1000    IF((CP.EQ.0).AND.(OP.EQ.1)) RETURN      !ANY RESULTS?
        IF(CP.EQ.0) OP=OP-2                     !ANY LAST WORD?
        LEX=.TRUE.
        IF(DFLAG) WRITE (OUTCH,10) CP,OP,(OUTBUF(I),I=1,OP+1)
 10     FORMAT(" LEX RESULTS- ",2I7/1X,10I7)
        RETURN
C
C LEGITIMATE CHARACTERS: LETTER, DIGIT, OR HYPHEN.
C
4000    CONTINUE
        IF(DFLAG) WRITE (OUTCH,20) J,J1,CP
 20     FORMAT(" LEX- CHAR= ",3I7)
        IF(CP.GE.6) GO TO 200                   !IGNORE IF TOO MANY CHAR
        K=OP+(CP/3)                             !COMPUTE WORD INDEX.
        GO TO (4100,4200,4300),(MOD(CP,3)+1)    !BRANCH ON CHAR.
4100    J2=J1*780                               !CHAR 1... *780
        OUTBUF(K)=OUTBUF(K)+J2+J2               !*1560 (40 ADDED BELOW).
4200    OUTBUF(K)=OUTBUF(K)+(J1*39)             !*39 (1 ADDED BELOW).
4300    OUTBUF(K)=OUTBUF(K)+J1                  !*1.
        CP=CP+1
        GO TO 200                               !GET NEXT CHAR.
C
C SPACE
C
6000    IF(CP.EQ.0) GO TO 200                   !ANY WORD YET?
        GO TO 50                                !YES, ADV OP.
C
        END
C SPARS-       START OF PARSE
C
C DECLARATIONS
C
C THIS ROUTINE DETAILS ON BIT 2 OF PRSFLG
C
        INTEGER FUNCTION SPARS(LBUF,LLNT)
        IMPLICIT INTEGER(A-Z)
        INTEGER LBUF(40)
        LOGICAL LIT,OTEST,DFLAG
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
      COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
C
C PARSER STATE
C
        COMMON /ORPHS/ OFLAG,OACT,OSLOT,OPREP,ONAME
        COMMON /LAST/ LASTIT
        COMMON /PV/ ACT,O1,O2,P1,P2
        INTEGER OBJVEC(2),PRPVEC(2)
        EQUIVALENCE (OBJVEC(1),O1),(PRPVEC(1),P1)
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
        COMMON /DEBUG/ DBGFLG,PRSFLG
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1          OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2          OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3          OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OINDX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL
        COMMON /OINDX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG
        COMMON /OINDX/ LEAVE,TROLL,AXE
        COMMON /OINDX/ RKNIF,KEYS,ICE,BAR
        COMMON /OINDX/ COFFI,TORCH,TBASK,FBASK,IRBOX
        COMMON /OINDX/ GHOST,TRUNK,BELL,BOOK,CANDL
        COMMON /OINDX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI
        COMMON /OINDX/ THIEF,STILL,WINDO,GRATE,DOOR
        COMMON /OINDX/ HPOLE,LEAK,RBUTT,RAILI
        COMMON /OINDX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT
        COMMON /OINDX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO
        COMMON /OINDX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE
        COMMON /OINDX/ GNOME,BLABE,DBALL
        COMMON /OINDX/ LCASE,CAGE,RCAGE,SPHER,SQBUT
        COMMON /OINDX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE
        COMMON /OINDX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH
        COMMON /OINDX/ ITOBJ,EVERY,VALUA,OPLAY
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1          AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
C VERBS
C
        COMMON /VINDX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW
        COMMON /VINDX/ WALKIW,FIGHTW,FOOW
        COMMON /VINDX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW
        COMMON /VINDX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW
        COMMON /VINDX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW
        COMMON /VINDX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW
        COMMON /VINDX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW
        COMMON /VINDX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW
        COMMON /VINDX/ MUNGW,KILLW,ATTACW,SWINGW
        COMMON /VINDX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW
        COMMON /VINDX/ DIGW,LEAPW
C
C VOCABULARIES
C
        COMMON /BUZVC/ BVOC(20)
        COMMON /PRPVC/ PVOC(47)
        COMMON /DIRVC/ DVOC(90)
        COMMON /ADJVC/ AVOC(264)
        COMMON /VRBVC/ VVOC(818)
        COMMON /OBJVC/ OVOC(797)
C
        OTEST(R)=(R.GT.0).AND.(R.LT.1600)
C
C SET UP FOR PARSING
C
        SPARS=-1                                !ASSUME PARSE FAILS.
        ADJ=0                                   !CLEAR PARTS HOLDERS.
        ACT=0
        PREP=0
        PPTR=0
        O1=0
        O2=0
        P1=0
        P2=0
        DFLAG=(PRSFLG.AND.4B).NE.0
C
        BUZLNT=20
        PRPLNT=48
        DIRLNT=90
C
C NOW LOOP OVER INPUT BUFFER OF LEXICAL TOKENS.
C
        DO 1000 I=1,LLNT,2                      !TWO WORDS/TOKEN.
          LBUF1=LBUF(I)                         !GET CURRENT TOKEN.
          LBUF2=LBUF(I+1)
          IF(LBUF1.EQ.0) GO TO 1500             !END OF BUFFER?
C
C CHECK FOR BUZZ WORD
C
          DO 50 J=1,BUZLNT,2
            IF((LBUF1.EQ.BVOC(J)).AND.(LBUF2.EQ.BVOC(J+1)))
     1       GO TO 1000                      !IGNORE BUZZ WORDS.
50        CONTINUE
C
C CHECK FOR ACTION OR DIRECTION
C
          IF(ACT.NE.0) GO TO 200                !GOT ACTION ALREADY?
          DO 100 J=1,DIRLNT,3                   !CHECK FOR DIRECTION.
            IF((LBUF1.EQ.DVOC(J)).AND.(LBUF2.EQ.DVOC(J+1)))
     1       GO TO 2000
100       CONTINUE
C
          J=1                                   !CHECK FOR ACTION.
125       IF((LBUF1.EQ.VVOC(J)).AND.(LBUF2.EQ.VVOC(J+1)))
     1       GO TO 3000
150       J=J+2                                 !ADV TO NEXT SYNONYM.
          IF(.NOT.OTEST(VVOC(J))) GO TO 125     !ANOTHER VERB?
          J=J+VVOC(J)+1                        !NO, ADVANCE OVER SYNTAX
          IF(VVOC(J).NE.-1) GO TO 125           !TABLE DONE?
C
C NOT AN ACTION, CHECK FOR PREPOSITION, ADJECTIVE, OR OBJECT.
C
200       DO 250 J=1,PRPLNT,3                   !LOOK FOR PREPOSITION.
            IF((LBUF1.EQ.PVOC(J)).AND.(LBUF2.EQ.PVOC(J+1)))
     1       GO TO 4000
250       CONTINUE
C
          J=1                                   !LOOK FOR ADJECTIVE.
300       IF((LBUF1.EQ.AVOC(J)).AND.(LBUF2.EQ.AVOC(J+1)))
     1       GO TO 5000
          J=J+1
325       J=J+1                                 !ADVANCE TO NEXT ENTRY.
          IF(OTEST(AVOC(J))) GO TO 325  !A RADIX 50 CONSTANT?
          IF(AVOC(J).NE.-1) GO TO 300           !POSSIBLY, END TABLE?
C
          J=1                                   !LOOK FOR OBJECT.
450       IF((LBUF1.EQ.OVOC(J)).AND.(LBUF2.EQ.OVOC(J+1)))
     1       GO TO 600
          J=J+1
500       J=J+1
          IF(OTEST(OVOC(J))) GO TO 500
          IF(OVOC(J).NE.-1) GO TO 450
C
C NOT RECOGNIZABLE
C
          CALL RSPEK(601)
          RETURN
C
C OBJECT PROCESSING (CONTINUATION OF DO LOOP ON PREV PAGE)
C
600       OBJ=GTOBJ(J,ADJ)                      !IDENTIFY OBJECT.
          IF(DFLAG) WRITE (OUTCH,60) J,OBJ
 60       FORMAT(" SPARS- OBJ AT ",I6,"  OBJ= ",I6)
          IF(OBJ.LE.0) GO TO 6000               !IF LE, COULDNT.
          IF(OBJ.EQ.ITOBJ) OBJ=LASTIT           !IF 'IT', USE LAST.
          LASTIT=OBJ                            !UPDATE LAST.
C
          IF(PREP.EQ.9) GO TO 8000              !'OF' OBJ?
          IF(PPTR.EQ.2) GO TO 7000              !TOO MANY OBJS?
          PPTR=PPTR+1
          OBJVEC(PPTR)=OBJ                      !STUFF INTO VECTOR.
          PRPVEC(PPTR)=PREP
700       PREP=0
          ADJ=0
1000    CONTINUE                                !AT LAST.
C
C NOW SOME MISC CLEANUP
C
1500    IF(ACT.EQ.0) ACT=AND(OFLAG,OACT) !IF NO ACT, STEAL ORPHAN.
        IF(ACT.EQ.0) GO TO 9000                 !IF STILL NONE, PUNT.
        IF(ADJ.NE.0) GO TO 10000                !IF DANGLING ADJ, PUNT.
C
        IF((OFLAG.NE.0).AND.(OPREP.NE.0).AND.(PREP.EQ.0).AND.
     1       (O1.NE.0).AND.(O2.EQ.0).AND.(ACT.EQ.OACT))
     2       GO TO 11000
C
        IF(PREP.EQ.0) GO TO 1750                !IF DANGLING PREP,
        IF((PPTR.EQ.0).OR.(PRPVEC(PPTR).NE.0))
     1       RETURN                          !AND HAVE "PICK FROB UP"
        PRPVEC(PPTR)=PREP                       !CVT TO "PICK UP FROB".
1750    SPARS=0                                 !WIN.
         IF(DFLAG) WRITE (OUTCH,70) ACT,O1,O2,P1,P2
 70     FORMAT(" SPARS RESULTS- ",5I7)
        RETURN
C
C SPECIAL PARSE PROCESSORS
C
C 2000--        DIRECTION
C
2000    PRSA=WALKW                              !VERB IS WALK.
        PRSO=DVOC(J+2)                          !GET DIRECTION.
        SPARS=1                                 !WIN TOTALLY.
         IF(DFLAG) WRITE (OUTCH,10) J
 10     FORMAT(" SPARS- DIR AT ",I6)
        RETURN
C
C 3000--        ACTION
C
3000    ACT=J                                   !SAVE INDEX TO VERB.
         IF(DFLAG) WRITE (OUTCH,20) J
 20     FORMAT(" SPARS- ACT AT ",I6)
        GO TO 1000                              !DONE.
C
C 4000--        PREPOSITION
C
4000    IF(PREP.NE.0) GO TO 4500                !ALREADY HAVE ONE?
        PREP=PVOC(J+2)                  !NO, GET INDEX.
         IF(DFLAG) WRITE (OUTCH,30) J
 30     FORMAT(" SPARS- PREP AT ",I6)
        GO TO 1000
C
4500    CALL RSPEK(616)                         !YES, GAG AND LOSE.
        RETURN
C
C 5000--        ADJECTIVE
C
5000    ADJ=J                                   !SAVE ADJECTIVE.
        J=AND(ONAME,OFLAG)
         IF(DFLAG) WRITE (OUTCH,40) ADJ,J
 40     FORMAT(" SPARS- ADJ AT ",I6," ORPHAN= ",I6)
        IF((J.NE.0).AND.(I.GE.LLNT)) GO TO 600
        GO TO 1000
C
C 6000--        UNIDENTIFIABLE OBJECT (INDEX INTO OVOC IS J)
C
6000    IF(OBJ.LT.0) GO TO 6100                 !IF LT, AMBIGUOUS.
        I=579                                   !NOT HERE OR
        IF(LIT(HERE)) I=618                     !NOT LIT.
        CALL RSPEK(I)
        RETURN                                  !LOSE.
C
6100    IF(OBJ.NE.-10000) GO TO 6200            !INSIDE VEHICLE?
        CALL RSPSB(620,ODESC2(AVEHIC(WINNER)))  !YES, CANT REACH.
        RETURN
C
6200    CALL RSPSB(619,0)                 !CANT DISTINGUISH.
        IF(ACT.EQ.0) ACT=AND(OFLAG,OACT) !IF NO ACT, GET ORPHAN.
        CALL ORPHN(-1,ACT,O1,PREP,J)            !ORPHAN THE WORLD.
        RETURN
C
C 7000--        TOO MANY OBJECTS.
C
7000    CALL RSPEK(617)
        RETURN
C
C 8000--        RANDOMNESS FOR 'OF' WORDS
C
8000    IF(OBJVEC(PPTR).EQ.OBJ) GO TO 700       !IGNORE IF OK.
        CALL RSPEK(601)
        RETURN
C
C 9000--        NO ACTION, PUNT
C
9000    IF(O1.EQ.0) GO TO 10000                 !ANY DIRECT OBJECT?
        CALL RSPSB(621,ODESC2(O1))      !WHAT TO DO?
        CALL ORPHN(-1,0,O1,0,0)
        RETURN
C
C 10000--       TOTAL CHOMP
C
10000   CALL RSPEK(622)                         !HUH?
        RETURN
C
C 11000--       ORPHAN PREPOSITION.  CONDITIONS ARE
C               O1.NE.0, O2=0, PREP=0, ACT=OACT
C
11000   IF(OSLOT.NE.0) GO TO 11500              !ORPHAN OBJECT?
        P1=OPREP                                !NO, JUST USE PREP.
        GO TO 1750
C
11500   O2=O1                                   !YES, USE AS DIRECT OBJ.
        P2=OPREP
        O1=OSLOT
        P1=0
        GO TO 1750
       END
C GTOBJ--      FIND OBJ DESCRIBED BY ADJ, NAME PAIR
C
C DECLARATIONS
C
C THIS ROUTINE DETAILS ON BIT 3 OF PRSFLG
C
        INTEGER FUNCTION GTOBJ(OIDX,AIDX)
        IMPLICIT INTEGER(A-Z)
        LOGICAL LIT,CHOMP,DFLAG
C
        COMMON /OBJFG/ VABIT,VRBIT,VTBIT,VCBIT,VEBIT,VPMASK
      COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
C
C MISCELLANEOUS VARIABLES
C
        COMMON /STAR/ MBASE,STRBIT
        COMMON /DEBUG/ DBGFLG,PRSFLG
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
C VOCABULARIES
C
        COMMON /OBJVC/ OVOC(797)
C
        DFLAG=(PRSFLG.AND.10B).NE.0
        CHOMP=.FALSE.
        AV=AVEHIC(WINNER)
        OBJ=0                                   !ASSUME DARK.
        IF(.NOT.LIT(HERE)) GO TO 200            !LIT?
C
        OBJ=SCHLS(OIDX,AIDX,HERE,0,0,0)         !SEARCH ROOM.
        IF(DFLAG) WRITE (OUTCH,10) OBJ
 10     FORMAT(" SCHLS- ROOM SCH ",I6)
        IF(OBJ) 1000,200,100                    !TEST RESULT.
100     IF((AV.EQ.0).OR.(AV.EQ.OBJ).OR.
     1       ((OFLAG2(OBJ)*FINDBT).NE.0)) GO TO 200
        IF(OCAN(OBJ).EQ.AV) GO TO 200           !TEST IF REACHABLE.
        CHOMP=.TRUE.                            !PROBABLY NOT.
C
200     IF(AV.EQ.0) GO TO 400                   !IN VEHICLE?
        NOBJ=SCHLS(OIDX,AIDX,0,AV,0,0)          !SEARCH VEHICLE.
        IF(DFLAG) WRITE (OUTCH,20) NOBJ
 20     FORMAT(" SCHLS- VEH SCH  ",I6)
        IF(NOBJ) 1100,400,300                   !TEST RESULT.
300     CHOMP=.FALSE.                           !REACHABLE.
        IF(OBJ.EQ.NOBJ) GO TO 400               !SAME AS BEFORE?
        IF(OBJ.NE.0) NOBJ=-NOBJ                 !AMB RESULT?
        OBJ=NOBJ
C
400     NOBJ=SCHLS(OIDX,AIDX,0,0,WINNER,0)      !SEARCH ADVENTURER.
        IF(DFLAG) WRITE (OUTCH,30) NOBJ
 30     FORMAT(" SCHLS- ADV SCH  ",I6)
        IF(NOBJ) 1100,600,500                   !TEST RESULT
500     IF(OBJ.NE.0) NOBJ=-NOBJ                 !AMB RESULT?
1100    OBJ=NOBJ                                !RETURN NEW OBJECT.
600     IF(CHOMP) OBJ=-10000                    !UNREACHABLE.
1000    GTOBJ=OBJ
C
         IF((GTOBJ.EQ.0).AND.(OVOC(OIDX+2).GE.STRBIT))
     1       GTOBJ=OVOC(OIDX+2)              !STAR?
        IF(DFLAG) WRITE (OUTCH,40) GTOBJ
 40     FORMAT(" SCHLS- RESULT   ",I6)
        RETURN
        END
C SCHLS--     SEARCH FOR OBJECT
C
C DECLARATIONS
C
        INTEGER FUNCTION SCHLS(OIDX,AIDX,RM,CN,AD,SPCOBJ)
        IMPLICIT INTEGER(A-Z)
        LOGICAL THSIT,QHERE,NOTRAN,NOVIS
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
        NOTRAN(O)=(AND(OFLAG1(O),TRANBT).EQ.0).AND.
     1       (AND(OFLAG2(O),OPENBT).EQ.0)
        NOVIS(O)=(AND(OFLAG1(O),VISIBT).EQ.0)
C
        SCHLS=0                                        !NO RESULT.
        DO 1000 I=1,OLNT                        !SEARCH OBJECTS.
          IF(NOVIS(I).OR.
     1       (((RM.EQ.0).OR.(.NOT.QHERE(I,RM))).AND.
     2        ((CN.EQ.0).OR.(OCAN(I).NE.CN)).AND.
     3        ((AD.EQ.0).OR.(OADV(I).NE.AD)))) GO TO 1000
          IF(.NOT.THSIT(OIDX,AIDX,I,SPCOBJ)) GO TO 200
          IF(SCHLS.NE.0) GO TO 2000             !GOT ONE ALREADY?
          SCHLS=I                                       !NO.
C
C IF OPEN OR TRANSPARENT, SEARCH THE OBJECT ITSELF.
C
200       IF(NOTRAN(I)) GO TO 1000
C
C SEARCH IS CONDUCTED IN REVERSE.  ALL OBJECTS ARE CHECKED TO
C SEE IF THEY ARE AT SOME LEVEL OF CONTAINMENT INSIDE OBJECT "I".
C IF THEY ARE AT LEVEL 1, OR IF ALL LINKS IN THE CONTAINMENT
C CHAIN ARE OPEN, VISIBLE, AND HAVE SEARCHME SET, THEY CAN QUALIFY
C AS A POTENTIAL MATCH.
C
          DO 500 J=1,OLNT                       !SEARCH OBJECTS.
            IF(NOVIS(J).OR. (.NOT.THSIT(OIDX,AIDX,J,SPCOBJ)))
     1       GO TO 500                       !VISIBLE & MATCH?
            X=OCAN(J)                           !GET CONTAINER.
300         IF(X.EQ.I) GO TO 400                !INSIDE TARGET?
            IF(X.EQ.0) GO TO 500                !INSIDE ANYTHING?
            IF(NOVIS(X).OR.NOTRAN(X).OR.
     1       (AND(OFLAG2(X),SCHBT).EQ.0)) GO TO 500
            X=OCAN(X)                           !GO ANOTHER LEVEL.
            GO TO 300
C
400         IF(SCHLS.NE.0) GO TO 2000           !ALREADY GOT ONE?
            SCHLS=J                             !NO.
500       CONTINUE
C
1000    CONTINUE
        RETURN
C
2000    SCHLS=-SCHLS                            !AMB RETURN.
        RETURN
C
        END
C THSIT--     VALIDATE OBJECT VS DESCRIPTION
C
C DECLARATIONS
C
        LOGICAL FUNCTION THSIT(OIDX,AIDX,OBJ,SPCOBJ)
        IMPLICIT INTEGER(A-Z)
        LOGICAL NOTEST
C
C VOCABULARIES
C
        COMMON /OBJVC/ OVOC(797)
        COMMON /ADJVC/ AVOC(264)
C
        DATA R50MIN/3100B/
        NOTEST(O)=(O.LE.0).OR.(O.GE.R50MIN)
C
        THSIT=.FALSE.                           !ASSUME NO MATCH.
        IF((SPCOBJ.NE.0).AND.(OBJ.EQ.SPCOBJ)) GO TO 500
C
C CHECK FOR OBJECT NAMES
C
        I=OIDX+1
100     I=I+1
        IF(NOTEST(OVOC(I))) RETURN              !IF DONE, LOSE.
        IF(OVOC(I).NE.OBJ) GO TO 100            !IF FAIL, CONT.
C
        IF(AIDX.EQ.0) GO TO 500                 !ANY ADJ?
        I=AIDX+1
200     I=I+1
        IF(NOTEST(AVOC(I))) RETURN              !IF DONE, LOSE.
        IF(AVOC(I).NE.OBJ) GO TO 200            !IF FAIL, CONT.
C
500     THSIT=.TRUE.
        RETURN
        END
C SYMCH--      SYNTAX MATCHER
C
C DECLARATIONS
C
C THIS ROUTINE DETAILS ON BIT 4 OF PRSFLG
C
        LOGICAL FUNCTION SYMCH     (X)
        IMPLICIT INTEGER(A-Z)
        LOGICAL SYNEQ,TAKIT,DFLAG
C
C PARSER OUTPUT
C
        LOGICAL PRSWON
        COMMON /PRSVC/ PRSA,PRSI,PRSO,PRSWON,PRSCON,
     +                 INBUF(78),INLNT
C
        COMMON /DEBUG/ DBGFLG,PRSFLG
C
        COMMON /CHAN/ INPCH,OUTCH,IDCBT(144)
C
        COMMON /ORPHS/ OFLAG,OACT,OSLOT,OPREP,ONAME
        COMMON /PV/ ACT,O1,O2,P1,P2
        COMMON /SYNTX/VFLAG,DOBJ,DFL1,DFL2,DFW1,DFW2,
     1       IOBJ,IFL1,IFL2,IFW1,IFW2
        COMMON /VRBVC/ VVOC(818)
        COMMON /SYNFG/ SDIR,SIND,SSTD,SFLIP,SDRIV,SVMASK
        DATA R50MIN/3100B/
C
        SYMCH=.FALSE.
        DFLAG=(PRSFLG.AND.20B).NE.0
        J=ACT                                   !SET UP PTR TO SYNTAX.
        DRIVE=0                                 !NO DEFAULT.
100     J=J+2                                   !FIND START OF SYNTAX.
        IF((VVOC(J).LE.0).OR.(VVOC(J).GE.R50MIN)) GO TO 100
        LIMIT=J+VVOC(J)+1                       !COMPUTE LIMIT.
        J=J+1                                   !ADVANCE TO NEXT.
C
200     CALL UNPAK(J,NEWJ)                      !UNPACK SYNTAX.
         IF(DFLAG) WRITE (OUTCH,60) O1,P1,DOBJ,DFL1,DFL2
 60     FORMAT(" SYMCH INPUTS TO SYNEQ- ",5I7)
        IF(.NOT.SYNEQ(P1,O1,DOBJ,DFL1,DFL2)) GO TO 1000
        IF(DFLAG) WRITE (OUTCH,60) O2,P2,IOBJ,IFL1,IFL2
        IF(SYNEQ(P2,O2,IOBJ,IFL1,IFL2)) GO TO 6000
C
C SYNTAX MATCH FAILS, TRY NEXT ONE.
C
        IF(O2) 3000,500,3000                    !IF O2=0, SET DFLT.
1000    IF(O1) 3000,500,3000                    !IF O1=0, SET DFLT.
500     IF(DRIVE.EQ.0) DRIVE=J                  !IF NO DFLT, RECORD.
        IF(AND(VFLAG,SDRIV).NE.0) DRIVE=J      !IF DRIVER, RECORD.
3000    J=NEWJ
        IF(J.LT.LIMIT) GO TO 200                !MORE TO DO?
C
C MATCH HAS FAILED.  IF DEFAULT SYNTAX EXISTS, TRY TO SNARF
C ORPHANS OR GWIMS, OR MAKE NEW ORPHANS.
C
        IF(DFLAG) WRITE (OUTCH,20) DRIVE
 20     FORMAT(" SYMCH, DRIVE=",I6)
        IF(DRIVE.EQ.0) GO TO 10000              !ANY DRIVER?
        CALL UNPAK(DRIVE,X)                       !UNPACK DFLT SYNTAX.
C
C TRY TO FILL DIRECT OBJECT SLOT IF THAT WAS THE PROBLEM.
C
        IF((AND(VFLAG,SDIR).EQ.0).OR.(O1.NE.0)) GO TO 4000
C
C FIRST TRY TO SNARF ORPHAN OBJECT.
C
        O1=AND(OFLAG,OSLOT)
        IF(O1.EQ.0) GO TO 3500                  !ANY ORPHAN?
        IF(SYNEQ(P1,O1,DOBJ,DFL1,DFL2)) GO TO 4000
C
C ORPHAN FAILS, TRY GWIM.
C
3500    O1=GWIM(DOBJ,DFW1,DFW2)                 !GET GWIM.
         IF(DFLAG) WRITE (OUTCH,30) O1
 30     FORMAT(" SYMCH- DO GWIM= ",I6)
        IF(O1.GT.0) GO TO 4000          !TEST RESULT.
        CALL ORPHN(-1,ACT,0,0,0)                !FAILS, ORPHAN.
        CALL RSPEK(623)
        RETURN
C
C TRY TO FILL INDIRECT OBJECT SLOT IF THAT WAS THE PROBLEM.
C
4000    IF((AND(VFLAG,SIND).EQ.0).OR.(O2.NE.0)) GO TO 6000
        O2=GWIM(IOBJ,IFW1,IFW2)                 !GWIM.
         IF(DFLAG) WRITE(OUTCH,40) O2
 40     FORMAT(" SYMCH- IO GWIM= ",I6)
        IF(O2.GT.0) GO TO 4000
        CALL ORPHN(-1,ACT,O1,0,0)
        CALL RSPEK(624)
        RETURN
C
C TOTAL CHOMP
C
10000   CALL RSPEK(601)                         !CANT DO ANYTHING.
        RETURN
C
C NOW TRY TO TAKE INDIVIDUAL OBJECTS AND
C IN GENERAL CLEAN UP THE PARSE VECTOR.
C
6000    IF(AND(VFLAG,SFLIP).EQ.0) GO TO 5000   !FLIP?
        J=O1                                    !YES.
        O1=O2
        O2=J
C
5000    PRSA=AND(VFLAG,SVMASK)                   !GET VERB.
        PRSO=O1                                 !GET DIR OBJ.
        PRSI=O2                                 !GET IND OBJ.
        IF(.NOT.TAKIT(PRSO,DOBJ)) RETURN        !TRY TAKE.
        IF(.NOT.TAKIT(PRSI,IOBJ)) RETURN        !TRY TAKE.
        SYMCH=.TRUE.
         IF(DFLAG) WRITE (OUTCH,50) SYMCH,PRSA,PRSO,PRSI,ACT,O1,O2
 50     FORMAT(" SYMCH- RESULTS ",L1,6I7)
        RETURN
C
        END
C UNPACK-      UNPACK SYNTAX SPECIFICATION, ADV POINTER
C
C DECLARATIONS
C
        SUBROUTINE UNPAK(OLDJ,J)
        IMPLICIT INTEGER(A-Z)
C
        COMMON /VRBVC/ VVOC(818)
C
        COMMON /SYNFG/ SDIR,SIND,SSTD,SFLIP,SDRIV,SVMASK
        COMMON /OBJFG/ VABIT,VRBIT,VTBIT,VCBIT,VEBIT,VPMASK
        COMMON /SYNTX/ VFLAG,DOBJ,DFL1,DFL2,DFW1,DFW2,
     1       IOBJ,IFL1,IFL2,IFW1,IFW2
        INTEGER SYN(11)
        EQUIVALENCE (SYN(1),VFLAG)
C
        DO 10 I=1,11                            !CLEAR SYNTAX.
          SYN(I)=0
10      CONTINUE
C
        VFLAG=VVOC(OLDJ)
        J=OLDJ+1
        IF(AND(VFLAG,SDIR).EQ.0) RETURN        !DIR OBJECT?
        DFL1=177777B                         !ASSUME STD.
        DFL2=177777B
        IF(AND(VFLAG,SSTD).EQ.0) GO TO 100     !STD OBJECT?
        DFW1=177777B                                  !YES.
        DFW2=177777B
        DOBJ=VABIT+VRBIT
        GO TO 200
C
100     DOBJ=VVOC(J)                            !NOT STD.
        DFW1=VVOC(J+1)
        DFW2=VVOC(J+2)
        J=J+3
        IF(AND(DOBJ,VEBIT).EQ.0) GO TO 200     !VBIT = VFWIM?
        DFL1=DFW1                               !YES.
        DFL2=DFW2
C
200     IF(AND(VFLAG,SIND).EQ.0) RETURN        !IND OBJECT?
        IFL1=177777B                                        !ASSUME STD.
        IFL2=177777B
        IOBJ=VVOC(J)
        IFW1=VVOC(J+1)
        IFW2=VVOC(J+2)
        J=J+3
        IF(AND(IOBJ,VEBIT).EQ.0) RETURN        !VBIT = VFWIM?
        IFL1=IFW1                               !YES.
        IFL2=IFW2
        RETURN
C
        END
C SYNEQ-      TEST FOR SYNTAX EQUALITY
C
C DECLARATIONS
C
        LOGICAL FUNCTION SYNEQ(PREP,OBJ,SPREP,SFL1,SFL2)
        IMPLICIT INTEGER(A-Z)
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OBJFG/ VABIT,VRBIT,VTBIT,VCBIT,VEBIT,VPMASK
C
        IF(OBJ.EQ.0) GO TO 100                  !ANY OBJECT?
        SYNEQ=(PREP.EQ.AND(SPREP,VPMASK)).AND.
     1       (OR(AND(SFL1,OFLAG1(OBJ)),
     2         AND(SFL2,OFLAG2(OBJ))).NE.0)
        RETURN
C
100     SYNEQ=(PREP.EQ.0).AND.(SFL1.EQ.0).AND.(SFL2.EQ.0)
        RETURN
C
        END
C TAKIT-      PARSER BASED TAKE OF OBJECT
C
C DECLARATIONS
C
        LOGICAL FUNCTION TAKIT(OBJ,SFLAG)
        IMPLICIT INTEGER(A-Z)
C
        COMMON /OBJFG/ VABIT,VRBIT,VTBIT,VCBIT,VEBIT,VPMASK
        COMMON /STAR/ MBASE,STRBIT
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,
     1       LTSHFT,BLOC,MUNGRM,HS
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OROM2/ R2LNT,O2(6),R2(6)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
        TAKIT=.TRUE.                            !ASSUME TRUE.
        IF((OBJ.EQ.0).OR.(OBJ.GE.STRBIT)) RETURN        !NULL/STARS WIN.
        IF(AND(SFLAG,VRBIT).EQ.0) GO TO 1000   !SHLD BE IN ROOM?
        IF(AND(SFLAG,VTBIT).EQ.0) GO TO 2000   !CAN BE TAKEN?
C
C SHOULD BE IN ROOM (VRBIT NE 0) AND CAN BE TAKEN (VTBIT NE 0)
C
        IF(SCHLS(0,0,HERE,0,0,OBJ).LE.0) RETURN !IF NOT, OK.
C
C ITS IN THE ROOM AND CAN BE TAKEN
C
        IF(AND(OFLAG1(OBJ),TAKEBT).NE.0) GO TO 3000
C
C NOT TAKEABLE.  IF WE CARE, FAIL.
C
        IF(AND(SFLAG,VCBIT).EQ.0) RETURN       !IF NO CARE, RETURN.
        CALL RSPSB(445,ODESC2(OBJ))
        TAKIT=.FALSE.
        RETURN
C
C 1000--        IT SHOULD NOT BE IN THE ROOM.
C 2000--        IT CANT BE TAKEN.
C
2000    IF(AND(SFLAG,VCBIT).EQ.0) RETURN       !IF NO CARE, RETURN
1000    TAKIT=SCHLS(0,0,HERE,0,0,OBJ).LE.0
        RETURN
C
C OBJECT IS IN THE ROOM, CAN BE TAKEN BY THE PARSER,
C AND IS TAKEABLE IN GENERAL.  IT IS NOT A STAR.
C IF IT IS INSIDE SOMETHING, THE CONTAINER IS OPEN OR
C TRANSPARENT.
C
C THE FOLLOWING CODE IS LIFTED FROM SUBROUTINE TAKE.
C
3000    TAKIT=.FALSE.                           !ASSUME TAKE FAILS.
        X=OCAN(OBJ)                             !GET CONTAINER.
        IF(X.EQ.0) GO TO 3200                   !NOT INSIDE?
        IF(AND(OFLAG2(X),OPENBT).NE.0) GO TO 3200
        CALL RSPEK(526)                         !NOT OPEN.
        RETURN
C
3200    IF(OBJ.NE.AVEHIC(WINNER)) GO TO 3500    !TAKE VEHICLE?
        CALL RSPEK(553)
        RETURN
C
3500    IF(((X.NE.0).AND.(OADV(X).EQ.WINNER)).OR.
     1 ((WEIGH(0,OBJ,WINNER)+OSIZE(OBJ)).LE.MXLOAD))
     2 GO TO 3700
        CALL RSPEK(558)                         !TOO BIG.
        RETURN
C
3700    TAKIT=.TRUE.
        CALL NEWST(OBJ,559,0,0,WINNER)          !DO TAKE.
        OFLAG2(OBJ)=OR(OFLAG2(OBJ),TCHBT)        !TOUCHED.
        CALL SCUPD(OFVAL(OBJ))
        OFVAL(OBJ)=0
        RETURN
C
        END
C GWIM- GET WHAT I MEAN IN AMBIGOUS SITUATIONS
C
C DECLARATIONS
C
        INTEGER FUNCTION GWIM(SFLAG,SFW1,SFW2)
        IMPLICIT INTEGER(A-Z)
        LOGICAL TAKIT,NOCARE
C
        COMMON /OBJFG/ VABIT,VRBIT,VTBIT,VCBIT,VEBIT,VPMASK
        COMMON /STAR/ MBASE,STRBIT
C
C GAME STATE
C
        LOGICAL TELFLG
        COMMON /PLAY/ WINNER,HERE,TELFLG
C
C OBJECTS
C
        COMMON /OBJXS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)
C
        COMMON /OROM2/ R2LNT,O2(6),R2(6)
C
        COMMON /OFLGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,
     2       TOOLBT,TURNBT,ONBT
        COMMON /OFLGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,
     2       TCHBT,VEHBT,SCHBT
C
C ADVENTURERS
C
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)
C
        GWIM=-1                                 !ASSUME LOSE.
        AV=AVEHIC(WINNER)
        NOBJ=0
        NOCARE=AND(SFLAG,VCBIT).EQ.0
C
C FIRST SEARCH ADVENTURER
C
        IF(AND(SFLAG,VABIT).NE.0)
     1       NOBJ=FWIM(SFW1,SFW2,0,0,WINNER,NOCARE)
        IF(AND(SFLAG,VRBIT).NE.0) GO TO 100
50      GWIM=NOBJ
        RETURN
C
C ALSO SEARCH ROOM
C
100     ROBJ=FWIM(SFW1,SFW2,HERE,0,0,NOCARE)
        IF(ROBJ) 500,50,200                     !TEST RESULT.
C
C ROBJ > 0
C
200     IF((AV.EQ.0).OR.(ROBJ.EQ.AV).OR.
     1       (AND(OFLAG2(ROBJ),FINDBT).NE.0)) GO TO 300
        IF(OCAN(ROBJ).NE.AV) GO TO 50           !UNREACHABLE? TRY NOBJ
300     IF(NOBJ.NE.0) RETURN                    !IF AMBIGUOUS, RETURN.
        IF(.NOT.TAKIT(ROBJ,SFLAG)) RETURN       !IF UNTAKEABLE, RETURN
        GWIM=ROBJ
500     RETURN
C
        END
$
