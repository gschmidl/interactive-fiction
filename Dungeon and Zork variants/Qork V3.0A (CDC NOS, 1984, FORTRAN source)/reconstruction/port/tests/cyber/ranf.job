RANFJ.
USER,INSTALL,INSTALL.
NORERUN.
SETTL,10.
COPYBR,INPUT,SOURCE,1.
REWIND,SOURCE.
FTN5(I=SOURCE,L=0)
LGO.
***
*** RANFJ COMPLETE
***
EXIT.
***
*** RANFJ FAILED
***
~eor
      PROGRAM RP(OUTPUT,TAPE6=OUTPUT)
      REAL R
      INTEGER I, S
      EQUIVALENCE (R, I)
      CALL RANGET(S)
      WRITE(6,10) S
      DO 20 K=1,6
      R = RANF()
      WRITE(6,10) I
   20 CONTINUE
      DO 30 K=1,12
      N = INT(FLOAT(100)*RANF())
      M = INT(FLOAT(7)*RANF())
      WRITE(6,11) N, M
   30 CONTINUE
   10 FORMAT(1X,O20)
   11 FORMAT(1X,2I5)
      END
