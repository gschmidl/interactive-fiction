        LOGICAL QEMPTY,RMINFO,CLOCKD                                    050720
        LOGICAL QOPEN,EDIBLE,DRKBLE                                     050730
        LOGICAL TAKE,PUT,DROP,WALK                                      050740
        LOGICAL QHERE,SVERBS,F,OAPPLI                                   050750
C                                                                       050760
C PARSER OUTPUT                                                         050770
C                                                                       050780
