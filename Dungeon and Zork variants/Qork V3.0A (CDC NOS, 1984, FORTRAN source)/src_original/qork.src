      PROGRAM QORK (INPUT=64/200, OUTPUT=64/200, TAPE5=INPUT,
     +TAPE6=OUTPUT, DATBAS=64/200, TAPE1=DATBAS, TAPE3=512)
C                                                                       000230
C       $RESET LIST                                                     000240
C       $RESET FREE                                                     000250
C       FILE  1(KIND=DISK,FLEXIBLE,FILETYPE=7)                          000260
C       FILE  5(KIND=REMOTE,MAXRECSIZE=100,MYUSE=IO)                    000270
C       FILE  20(KIND=DISK,FLEXIBLE,FILETYPE=7)                         000280
C DUNGEON-- MAIN PROGRAM                                                000290
C                                                                       000300
C       PROGRAM DUNGEON                                                 000310
C       ------- -------                                                 000320
C DECLARATIONS                                                          000330
        IMPLICIT INTEGER (A-Z)                                          000340
        LOGICAL INIT,PROTCT                                             000350
C                                                                       000360
C PARSER OUTPUT                                                         000370
C                                                                       000380
        LOGICAL PRSWON                                                  000390
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    000400
C                                                                       000410
C PARSER STATE                                                          000420
C                                                                       000430
        COMMON /ORPHS/ OFLAG,OACT,OSLOT,OPREP,ONAME                     000440
        COMMON /LAST/ LASTIT                                            000450
        COMMON /PV/ ACT,OBJ1,OBJ2,PREP1,PREP2                           000460
        COMMON /SYNTAX/ SYN(11)                                         000470
        COMMON /SYNFLG/ SDIR,SIND,SSTD,SFLIP,SDRIV,SVMASK               000480
        COMMON /OBJFLG/ VABIT,VRBIT,VTBIT,VCBIT,VEBIT,VPMASK            000490
C                                                                       000500
      COMMON /PRS/INIT                                                  000510
C                                                                       000520
C GAME STATE                                                            000530
C                                                                       000540
        LOGICAL TELFLG                                                  000550
        COMMON /PLAY/ WINNER,HERE,TELFLG                                000560
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               000570
     1       LTSHFT,BLOC,MUNGRM,HS                                      000580
C                                                                       000590
C MESSAGE INDEX                                                         000600
C                                                                       000610
        COMMON /RMSG/ MLNT,RTEXT(800)                                   000620
C                                                                       000630
C MISCELLANEOUS VARIABLES                                               000640
C                                                                       000650
        COMMON /STAR/ MBASE,STRBIT                                      000660
        COMMON /VERS/ VMAJ,VMIN,VEDIT                                   000670
        COMMON /TIME/ PLTIME,SHOUR,SMIN,SSEC                            000680
        COMMON /BATS/ BATDRP(9)                                         000690
        COMMON /CHAN/ INPCH,OUTCH,DBCH                                  000700
        COMMON /DEBUG/ DBGFLG,PRSFLG                                    000710
C                                                                       000720
C ROOMS                                                                 000730
C                                                                       000740
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         000750
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                000760
C                                                                       000770
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  000780
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            000790
C                                                                       000800
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                    000810
C                                                                       000820
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               000830
        COMMON /RINDEX/ MTROL,MAZE1                                     000840
        COMMON /RINDEX/ MGRAT,MAZ15                                     000850
        COMMON /RINDEX/ FORE1,CLEAR,RESER                               000860
        COMMON /RINDEX/ STREA,EGYPT,ECHOR                               000870
        COMMON /RINDEX/ TSHAF                                           000880
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          000890
        COMMON /RINDEX/ CAROU                                           000900
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    000910
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             000920
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   000930
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         000940
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   000950
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001150
C                                                                       000970
C EXITS                                                                 000980
C                                                                       000990
        COMMON /EXITS/ XLNT,TRAVEL(625)
C                                                                       001010
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ                  001020
        EQUIVALENCE (XFLAG,XOBJ)                                        001030
C                                                                       001040
        COMMON /XPARS/ XRMASK,XDMASK,XFMASK,XFSHFT,XASHFT,              001050
     1       XELNT(4),XNORM,XNO,XCOND,XDOOR,XLFLAG                      001060
C                                                                       001070
        COMMON /XSRCH/ XMIN,XMAX,XDOWN                                  001080
C                                                                       001090
C OBJECTS                                                               001100
C                                                                       001110
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       001120
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            001130
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              001140
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  001150
C                                                                       001160
        COMMON /OROOM2/ R2LNT,O2(6),R2(6)                               001170
C                                                                       001180
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      001190
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          001200
     2       TOOLBT,TURNBT,ONBT                                         001210
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       001220
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           001230
     2       TCHBT,VEHBT,SCHBT                                          001240
C                                                                       001250
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    001260
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           001270
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 001280
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              001290
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   001300
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     001310
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        001320
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    001330
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          001340
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                001350
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              001360
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         001370
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               001380
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    001390
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  001400
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   001410
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       001430
C CLOCK INTERRUPTS                                                      001440
C                                                                       001450
        LOGICAL CFLAG                                                   001460
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             001470
C                                                                       001480
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             001490
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 001500
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                001510
C                                                                       001520
C VILLAINS AND DEMONS                                                   001530
C                                                                       001540
        LOGICAL THFFLG,SWDACT,THFACT                                    001550
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA                001560
        COMMON /VILL/ VLNT,VILLNS(5),VPROB(5),VOPPS(5)                  001570
C                                                                       001580
C ADVENTURERS                                                           001590
C                                                                       001600
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                001610
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       001620
C                                                                       001630
        COMMON /AFLAGS/ ASTAG                                           001640
C                                                                       001650
        COMMON /AINDEX/ PLAYER,AROBOT                                   001660
C                                                                       001670
C VERBS                                                                 001680
C                                                                       001690
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  001700
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              001710
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         001720
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            001730
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           001740
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  001750
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    001760
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            001770
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       001780
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       001790
        COMMON /VINDEX/ DIGW,LEAPW                                      001800
C                                                                       001810
C FLAGS                                                                 001820
C                                                                       001830
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               001850
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   001860
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                001870
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 001880
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                001890
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      001910
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     001920
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  001930
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   001940
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  001950
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     001970
        EQUIVALENCE (FLAGS(1),TROLLF)                                   001980
C PAGE
C 1) CHECK FOR PROTECTION VIOLATION                                     002000
C 2) INITIALIZE DATA STRUCTURES                                         002010
C 3) PLAY GAME                                                          002020
C                                                                       002030
        IF(PROTCT(X)) GO TO 100                                         002040
        PRINT 10                                                        002050
10      FORMAT(' THERE APPEARS BEFORE YOU A THREATENING FIGURE CLAD'
     1,' ALL OVER'/' IN HEAVY BLACK ARMOR.  HIS LEGS SEEM LIKE THE'
     2 ,' MASSIVE TRUNK'/' OF THE OAK TREE.  HIS BROAD SHOULDERS AND'
     3  ,' HELMETED HEAD LOOM'/' HIGH OVER YOUR OWN PUNY FRAME, AND'
     4   ,' YOU REALIZE THAT HIS POWERFUL'/' ARMS COULD EASILY CRUSH THE
     5'   ,' VERY LIFE FROM YOUR BODY.  THERE'/' HANGS FROM HIS BELT A'
     6     ,' VERITABLE ARSENAL OF DEADLY WEAPONS:'/' SWORD, MACE, BALL'
     7      ,' AND CHAIN, DAGGER, LANCE, AND TRIDENT.'/' HE SPEAKS WITH
     8A'     ,' COMMANDING VOICE:'//20X,'''YOU SHALL NOT PASS.'''//' AS'
     9          ,' HE GRABS YOU BY THE NECK ALL GROWS DIM ABOUT YOU.')
        CALL EXIT                                                       002160
C                                                                       002170
  100 CALL PRS                                                          002180
      IF(INIT) GOTO 200                                                 002190
        PRINT 110                                                       002200
110     FORMAT(' SUDDENLY A SINISTER, WRAITHLIKE FIGURE APPEARS BEFORE'
     1,' YOU'/' SEEMING TO FLOAT IN THE AIR.  IN A LOW, SORROWFUL VOICE'
     2 ,' HE SAYS,'/' ''ALAS, THE VERY NATURE OF THE WORLD HAS CHANGED,'
     3   ,' AND THE DUNGEON'/' CANNOT BE FOUND.  ALL MUST NOW PASS AWAY.
     4'''  ,'  RAISING HIS OAKEN STAFF'/' IN FAREWELL, HE FADES INTO THE
     5'     ,' SPREADING DARKNESS.  IN HIS PLACE'/' APPEARS A TASTEFULLY
     6'      ,' LETTERED SIGN READING:'//23X,'INITIALIZATION FAILURE'//
     7        ' THE DARKNESS BECOMES ALL ENCOMPASSING, AND YOUR VISION F
     7AILS.')
        CALL EXIT                                                       002290
C                                                                       002300
200     CALL GAME                                                       002310
        CALL EXIT                                                       002320
        END                                                             002330
         BLOCK DATA
        IMPLICIT INTEGER (A-Z)                                          002350
        LOGICAL INIT,PROTCT                                             002360
C                                                                       002370
