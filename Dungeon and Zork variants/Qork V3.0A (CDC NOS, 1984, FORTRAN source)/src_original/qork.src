C                                                                       003440
        LOGICAL CFLAG                                                   003450
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             003460
C                                                                       003470
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             003480
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 003490
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                003500
C                                                                       003510
