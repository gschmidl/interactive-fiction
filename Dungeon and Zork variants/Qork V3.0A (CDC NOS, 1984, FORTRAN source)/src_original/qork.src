C                                                                       002760
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  002770
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            002780
C                                                                       002790
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                    002800
C                                                                       002810
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               002820
        COMMON /RINDEX/ MTROL,MAZE1                                     002830
