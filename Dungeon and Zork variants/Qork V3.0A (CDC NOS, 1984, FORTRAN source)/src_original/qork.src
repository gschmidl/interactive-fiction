     3    "BROKEN",16,92,113,"ORIENT",17,
     4    "BLOODY",20,"RUSTY",24,"BURNED",22,
     5   "DEAD",22,"BROKEN",22,"OLD",25,41,44,45,"LEATHE",25,
     5    "PLATIN",26,"PEARL",27,
     6    "MOBY",31,"CRYSTA",32,126,"GOLD",33,85,104,
     7    "IVORY",34,"SAPPHI",37,"WOODEN",38,67,136,137,
     7    "IRON",39,125,
