        COMMON /RINDEX/ TSHAF                                           002870
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          002880
        COMMON /RINDEX/ CAROU                                           002890
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    002900
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             002910
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   002920
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         002930
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   002940
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001170
C                                                                       002960
C EXITS                                                                 002970
C                                                                       002980
        COMMON /EXITS/ XLNT,TRAVEL(625)
C                                                                       003000
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ                  003010
        EQUIVALENCE (XFLAG,XOBJ)                                        003020
C                                                                       003030
        COMMON /XPARS/ XRMASK,XDMASK,XFMASK,XFSHFT,XASHFT,              003040
     1       XELNT(4),XNORM,XNO,XCOND,XDOOR,XLFLAG                      003050
C                                                                       003060
        COMMON /XSRCH/ XMIN,XMAX,XDOWN                                  003070
C                                                                       003080
C OBJECTS                                                               003090
C                                                                       003100
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       003110
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            003120
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              003130
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  003140
C                                                                       003150
        COMMON /OROOM2/ R2LNT,O2(6),R2(6)                               003160
C                                                                       003170
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      003180
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          003190
     2       TOOLBT,TURNBT,ONBT                                         003200
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       003210
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           003220
     2       TCHBT,VEHBT,SCHBT                                          003230
C                                                                       003240
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    003250
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           003260
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 003270
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              003280
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   003290
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     003300
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        003310
