        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              003350
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         003360
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               003370
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    003380
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  003390
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   003400
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
