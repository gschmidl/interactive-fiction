        END                                                             037800
        LOGICAL FUNCTION RMINFO(FULL)
        IMPLICIT INTEGER (A-Z)                                          037820
C RMINFO-- PRINT ROOM DESCRIPTION                                       037830
C                                                                       037840
C RMINFO PRINTS A DESCRIPTION OF THE CURRENT ROOM.                      037850
C IT IS ALSO THE PROCESSOR FOR VERBS "LOOK" AND "EXAMINE".              037860
C                                                                       037870
C                                                                       037880
C DECLARATIONS                                                          037890
C                                                                       037900
        LOGICAL FULL,PROB,LIT,RAPPLI                                    037910
C                                                                       037920
C PARSER OUTPUT                                                         037930
C                                                                       037940
        LOGICAL PRSWON                                                  037950
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    037960
C                                                                       037970
C GAME STATE                                                            037980
C                                                                       037990
        LOGICAL TELFLG                                                  038000
        COMMON /PLAY/ WINNER,HERE,TELFLG                                038010
C                                                                       038020
C ROOMS                                                                 038030
C                                                                       038040
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         038050
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                038060
C                                                                       038070
        COMMON /RFLAG/ RSEEN                                            038080
C                                                                       038090
        COMMON /XSRCH/ XMIN,XMAX,XDOWN                                  038100
C                                                                       038110
C OBJECTS                                                               038120
C                                                                       038130
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       038140
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            038150
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              038160
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  038170
C                                                                       038180
C ADVENTURERS                                                           038190
C                                                                       038200
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                038210
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       038220
C                                                                       038230
        COMMON /AINDEX/ PLAYER,AROBOT                                   038240
C                                                                       038250
C VERBS                                                                 038260
C                                                                       038270
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  038280
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              038290
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         038300
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            038310
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           038320
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  038330
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    038340
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            038350
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       038360
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       038370
        COMMON /VINDEX/ DIGW,LEAPW                                      038380
C                                                                       038390
C FLAGS                                                                 038400
C                                                                       038410
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               038430
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   038440
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                038450
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 038460
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                038470
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      038490
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     038500
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  038510
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   038520
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  038530
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     038550
        EQUIVALENCE (FLAGS(1),TROLLF)                                   038560
        PROB(X)=(RND(100).LT.X)
C RMINFO, PAGE 2                                                        038580
C                                                                       038590
        RMINFO=.TRUE.                                                   038600
        TELFLG=.TRUE.                                                   038610
        IF(PRSO.GE.XMIN) PRSO=0                                         038620
        IF(HERE.EQ.AROOM(PLAYER)) GO TO 100                             038630
        CALL RSPEAK(2)                                                  038640
        PRSA=WALKIW                                                     038650
        RETURN                                                          038660
C                                                                       038670
100     IF(LIT(HERE)) GO TO 300                                         038680
        CALL RSPEAK(430)                                                038690
        RMINFO=.FALSE.                                                  038700
        RETURN                                                          038710
C                                                                       038720
300     RA=RACTIO(HERE)                                                 038730
        I=RDESC2(HERE)                                                  038740
        IF(.NOT.FULL .AND. (SUPERF.OR.((AND(RFLAG(HERE),RSEEN).NE.0)    038750
     1       .AND. (BRIEFF.OR.PROB(80))))) GO TO 400                    038760
        I=RDESC1(HERE)                                                  038770
        IF((I.NE.0).OR.(RA.EQ.0)) GO TO 400                             038780
        PRSA=LOOKW                                                      038790
        IF(.NOT.RAPPLI(RA)) GO TO 100                                   038800
        PRSA=FOOW                                                       038810
        GO TO 500                                                       038820
C                                                                       038830
  400 CONTINUE                                                          038840
        CALL RSPEAK(I)                                                  038850
500     RFLAG(HERE)=OR(RFLAG(HERE),RSEEN)                               038860
        IF(AVEHIC(WINNER).NE.0) CALL RSPSUB(431,ODESC2(AVEHIC(WINNER))) 038870
        CALL PRINCR(FULL,HERE)                                          038880
        IF(FULL.OR.(RA.EQ.0)) RETURN                                    038890
        PRSA=WALKIW                                                     038900
        IF(.NOT.RAPPLI(RA)) GO TO 100                                   038910
        PRSA=FOOW                                                       038920
        RETURN                                                          038930
C                                                                       038940
        END
        LOGICAL FUNCTION RAPPLI(RI)
        IMPLICIT INTEGER (A-Z)                                          038970
C RAPPLI- SPECIAL PURPOSE ROOM ROUTINES                                 038980
C                                                                       038990
C DECLARATIONS                                                          039000
C                                                                       039010
        LOGICAL QOPEN,QON,QHERE,PROB,F                                  039020
        LOGICAL MOVETO,LIT                                              039030
C                                                                       039040
C PARSER OUTPUT                                                         039050
C                                                                       039060
        LOGICAL PRSWON                                                  039070
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    039080
C                                                                       039090
C GAME STATE                                                            039100
C                                                                       039110
        LOGICAL TELFLG                                                  039120
        COMMON /PLAY/ WINNER,HERE,TELFLG                                039130
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               039140
     1       LTSHFT,BLOC,MUNGRM,HS                                      039150
C                                                                       039160
C MISCELLANEOUS VARIABLES                                               039170
C                                                                       039180
        COMMON /BATS/ BATDRP(9)                                         039190
C                                                                       039200
C ROOMS                                                                 039210
C                                                                       039220
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         039230
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                039240
C                                                                       039250
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                    039260
C                                                                       039270
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  039280
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            039290
C                                                                       039300
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               039310
        COMMON /RINDEX/ MTROL,MAZE1                                     039320
        COMMON /RINDEX/ MGRAT,MAZ15                                     039330
        COMMON /RINDEX/ FORE1,CLEAR,RESER                               039340
        COMMON /RINDEX/ STREA,EGYPT,ECHOR                               039350
        COMMON /RINDEX/ TSHAF                                           039360
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          039370
        COMMON /RINDEX/ CAROU                                           039380
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    039390
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             039400
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   039410
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         039420
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   039430
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001250
C                                                                       039450
C OBJECTS                                                               039460
C                                                                       039470
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       039480
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            039490
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              039500
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  039510
C                                                                       039520
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      039530
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          039540
     2       TOOLBT,TURNBT,ONBT                                         039550
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       039560
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           039570
     2       TCHBT,VEHBT,SCHBT                                          039580
C                                                                       039590
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    039600
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           039610
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 039620
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              039630
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   039640
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     039650
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        039660
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    039670
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          039680
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                039690
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              039700
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         039710
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               039720
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    039730
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  039740
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   039750
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       039770
C CLOCK INTERRUPTS                                                      039780
C                                                                       039790
        LOGICAL CFLAG                                                   039800
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             039810
C                                                                       039820
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             039830
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 039840
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                039850
C                                                                       039860
        LOGICAL THFFLG,THFACT,SWDACT                                    039870
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT                       039880
C                                                                       039890
C ADVENTURERS                                                           039900
C                                                                       039910
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                039920
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       039930
C                                                                       039940
        COMMON /AINDEX/ PLAYER,AROBOT                                   039950
C                                                                       039960
C VERBS                                                                 039970
C                                                                       039980
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  039990
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              040000
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         040010
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            040020
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           040030
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  040040
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    040050
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            040060
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       040070
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       040080
        COMMON /VINDEX/ DIGW,LEAPW                                      040090
C                                                                       040100
C FLAGS                                                                 040110
C                                                                       040120
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               040140
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   040150
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                040160
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 040170
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                040180
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      040200
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     040210
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  040220
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   040230
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  040240
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     040260
        EQUIVALENCE (FLAGS(1),TROLLF)                                   040270
        QOPEN(R)=AND(OFLAG2(R),OPENBT).NE.0
        QON(R)=AND(OFLAG1(R),ONBT).NE.0
        PROB(R)=(RND(100).LT.R)
C RAPPLI, PAGE 2                                                        040310
C                                                                       040320
        RAPPLI=.TRUE.                                                   040330
C                                                SET TO FALSE FOR       040340
C                                                NEW DESC NEEDED.       040350
        GO TO (1000,2000,3000,4000,5000,6000,7000,8000,9000,10000,
     1 11000,12000,13000,14000,15000,16000,17000,18000,19000,20000,
     2 21000,22000,23000,24000,25000,26000,27000,28000,29000,30000,
     3 31000,32000,33000,34000,35000,36000,37000),RI
      CALL GOTOER
C        CALL BUG(1,RI)                                                 040400
C                                                                       040410
C R1--  EAST OF HOUSE.  DESCRIPTION DEPENDS ON STATE OF WINDOW          040420
C                                                                       040430
1000    IF(PRSA.NE.LOOKW) RETURN                                        040440
        I=13                                                            040450
        IF(QOPEN(WINDO)) I=12                                           040460
        CALL RSPSUB(11,I)                                               040470
 1001 CONTINUE
      IF (.NOT. ENDGMF) RETURN
C
C     ENDGAME IN PROGRESS.  PROCESS BOUNCING KANGAROOS.
C
      DO 1010 I = 16, 17
C
C     OBJECT 148-149 ARE THE KANGAROO TWINS....
C     CEVENT 16 = DARK COLORED KANG.
C     CEVENT 17 = LIGHT COLORED KANG.
C
      IF (.NOT. CFLAG(I)) GOTO 1010
C
 1005 IFROG = ((CTICK(I) * 2) ) / 3
      CALL RSPSUB((646+IFROG),ODESC2(148-16+I))
      OROOM(148-16+I) = 0
 1010 CONTINUE
      RETURN
C                                                                       040490
C R2--  KITCHEN.  SAME VIEW FROM INSIDE.                                040500
C                                                                       040510
2000    IF(PRSA.NE.LOOKW) RETURN                                        040520
        I=13                                                            040530
        IF(QOPEN(WINDO)) I=12                                           040540
        CALL RSPSUB(14,I)                                               040550
        RETURN                                                          040560
C                                                                       040570
C R3--  LIVING ROOM.  DESCRIPTION DEPENDS ON MAGICF (STATE OF           040580
C       DOOR TO CYCLOPS ROOM), RUG (MOVED OR NOT), DOOR (OPEN OR CLOSED)040590
C                                                                       040600
3000    IF(PRSA.NE.LOOKW) GO TO 3500                                    040610
        I=15                                                            040620
        IF(MAGICF) I=16                                                 040630
        CALL RSPEAK(I)                                                  040640
        I=17+ORAND(RUG)                                                 040650
        IF(QOPEN(DOOR)) I=I+2                                           040660
        CALL RSPEAK(I)                                                  040670
        RETURN                                                          040680
C                                                                       040690
C       NOT A LOOK WORD.  REEVALUATE TROPHY CASE.                       040700
C                                                                       040710
3500    IF((PRSA.NE.TAKEW).AND.((PRSA.NE.PUTW).OR.(PRSI.NE.TCASE)))     040720
     1       RETURN                                                     040730
        ASCORE(WINNER)=RWSCOR                                           040740
        DO 3600 I=1,OLNT                                                040750
          IF(OCAN(I).EQ.TCASE) ASCORE(WINNER)=ASCORE(WINNER)+OTVAL(I)   040760
3600    CONTINUE                                                        040770
        RETURN                                                          040780
C RAPPLI, PAGE 3                                                        040790
C                                                                       040800
C R4--  CELLAR.  SHUT DOOR AND BAR IT IF HE JUST WALKED IN.             040810
C                                                                       040820
4000    IF(PRSA.NE.LOOKW) GO TO 4500                                    040830
        CALL RSPEAK(21)                                                 040840
        RETURN                                                          040850
C                                                                       040860
4500    IF(PRSA.NE.WALKIW) RETURN                                       040870
        IF(AND(OFLAG2(DOOR),(OPENBT+TCHBT)).NE.OPENBT) RETURN           040880
        OFLAG2(DOOR)=AND(OR(OFLAG2(DOOR),TCHBT),COMPL(OPENBT))          040890
        CALL RSPEAK(22)                                                 040900
        RETURN                                                          040910
C                                                                       040920
C R5--  MAZE11.  DESCRIBE STATE OF GRATING.                             040930
C                                                                       040940
5000    IF(PRSA.NE.LOOKW) RETURN                                        040950
        CALL RSPEAK(23)                                                 040960
        I=24                                                            040970
        IF(GRUNLF) I=26                                                 040980
        IF(QOPEN(GRATE)) I=25                                           040990
        CALL RSPEAK(I)                                                  041000
        RETURN                                                          041010
C                                                                       041020
C R6--  CLEARING.  DESCRIBE CLEARING, MOVE LEAVES.                      041030
C                                                                       041040
6000    IF(PRSA.NE.LOOKW) GO TO 6500                                    041050
        CALL RSPEAK(27)                                                 041060
        IF(RVCLR.EQ.0) RETURN                                           041070
        I=28                                                            041080
        IF(QOPEN(GRATE)) I=29                                           041090
        CALL RSPEAK(I)                                                  041100
        RETURN                                                          041110
C                                                                       041120
6500    IF((RVCLR.NE.0).OR.(QHERE(LEAVE,CLEAR).AND.                     041130
     1       ((PRSA.NE.MOVEW).OR.(PRSO.NE.LEAVE)))) RETURN              041140
        CALL RSPEAK(30)                                                 041150
        RVCLR=1                                                         041160
        RETURN                                                          041170
C RAPPLI, PAGE 4                                                        041180
C                                                                       041190
C R7--  RESERVOIR SOUTH.  DESCRIPTION DEPENDS ON LOW TIDE FLAG.         041200
C                                                                       041210
7000    IF(PRSA.NE.LOOKW) RETURN                                        041220
        I=31                                                            041230
        IF(LWTIDF) I=32                                                 041240
        CALL RSPEAK(I)                                                  041250
        CALL RSPEAK(33)                                                 041260
        RETURN                                                          041270
C                                                                       041280
C R8--  RESERVOIR.  STATE DEPENDS ON LOW TIDE FLAG.                     041290
C                                                                       041300
8000    IF(PRSA.NE.LOOKW) RETURN                                        041310
        I=34                                                            041320
        IF(LWTIDF) I=35                                                 041330
        CALL RSPEAK(I)                                                  041340
        RETURN                                                          041350
C                                                                       041360
C R9--  RESERVOIR NORTH.  ALSO DEPENDS ON LOW TIDE FLAG.                041370
C                                                                       041380
9000    IF(PRSA.NE.LOOKW) RETURN                                        041390
        I=36                                                            041400
        IF(LWTIDF) I=37                                                 041410
        CALL RSPEAK(I)                                                  041420
        CALL RSPEAK(38)                                                 041430
        RETURN                                                          041440
C                                                                       041450
C R10-- GLACIER ROOM.  STATE DEPENDS ON MELTED, VANISHED FLAGS.         041460
C                                                                       041470
10000   IF(PRSA.NE.LOOKW) RETURN                                        041480
        CALL RSPEAK(39)                                                 041490
        I=0                                                             041500
        IF(GLACMF) I=40                                                 041510
        IF(GLACRF) I=41                                                 041520
        CALL RSPEAK(I)                                                  041530
        RETURN                                                          041540
C                                                                       041550
C R11-- WHITE CLIFF LAIR.  CYCLOPS IS THERE IFF CHASED FROM             001600
C       CYCLOPS ROOM (SINBAD).                                          001610
C                                                                       041570
11000 CONTINUE                                                          001470
      IF(PRSA .NE. LOOKW) RETURN                                        001480
      CALL RSPEAK(629)                                                  001490
      IF(.NOT. (QHERE(CYCLO,HERE))) RETURN                              001500
      I = 607                                                           001510
      IF(RVCYC .GT. 0) I = 608                                          001520
      IF(RVCYC .LT. 0) I = 609                                          001530
      IF(CYCLOF2) I = 610                                               001540
      CALL RSPEAK(I)                                                    001550
      IF(.NOT. CYCLOF2 .AND. (RVCYC .NE. 0))                            001560
     + CALL RSPEAK(193 + IABS(RVCYC))                                   001570
      RETURN                                                            001580
C                                                                       041590
C R12-- MIRROR ROOM.  STATE DEPENDS ON MIRROR INTACT.                   041600
C                                                                       041610
12000   IF(PRSA.NE.LOOKW) RETURN                                        041620
        CALL RSPEAK(42)                                                 041630
        IF(MIRRMF) CALL RSPEAK(43)                                      041640
        RETURN                                                          041650
C RAPPLI, PAGE 5                                                        041660
C                                                                       041670
C R13-- CAVE2 ROOM.  BLOW OUT CANDLES WITH 50  PROBABILITY.             041680
C                                                                       041690
13000   IF(PRSA.NE.WALKIW) RETURN                                       041700
        IF(PROB(50).OR.(OADV(CANDL).NE.WINNER).OR.                      041710
     1       .NOT.QON(CANDL)) RETURN                                    041720
        OFLAG1(CANDL)=AND(OFLAG1(CANDL),COMPL(ONBT))                    041730
        CALL RSPEAK(47)                                                 041740
        CFLAG(CEVCND)=.FALSE.                                           041750
        RETURN                                                          041760
C                                                                       041770
C R14-- BOOM ROOM.  BLOW HIM UP IF CARRYING FLAMING OBJECT.             041780
C                                                                       041790
14000   J=ODESC2(CANDL)                                                 041800
        IF((OADV(CANDL).EQ.WINNER).AND.QON(CANDL)) GO TO 14100          041810
        J=ODESC2(TORCH)                                                 041820
        IF((OADV(TORCH).EQ.WINNER).AND.QON(TORCH)) GO TO 14100          041830
        J=ODESC2(MATCH)                                                 041840
        IF((OADV(MATCH).EQ.WINNER).AND.QON(MATCH)) GO TO 14100          041850
        RETURN                                                          041860
C                                                                       041870
14100   IF(PRSA.NE.TRNONW) GO TO 14200                                  041880
        CALL RSPSUB(294,J)                                              041890
        CALL JIGSUP(44)                                                 041900
        RETURN                                                          041910
C                                                                       041920
14200   IF(PRSA.NE.WALKIW) RETURN                                       041930
        CALL RSPSUB(295,J)                                              041940
        CALL JIGSUP(44)                                                 041950
        RETURN                                                          041960
C                                                                       041970
C R15-- NO-OBJS.  SEE IF EMPTY HANDED, SCORE LIGHT SHAFT.               041980
C                                                                       041990
15000   EMPTHF=.TRUE.                                                   042000
        DO 15100 I=1,OLNT                                               042010
          IF(OADV(I).EQ.WINNER) EMPTHF=.FALSE.                          042020
15100   CONTINUE                                                        042030
C                                                                       042040
        IF((HERE.NE.BSHAF).OR.(.NOT.LIT(HERE))) RETURN                  042050
        CALL SCRUPD(LTSHFT)                                             042060
        LTSHFT=0                                                        042070
        RETURN                                                          042080
C RAPPLI, PAGE 6                                                        042090
C                                                                       042100
C R16-- MACHINE ROOM.  DESCRIBE MACHINE.                                042110
C                                                                       042120
16000   IF(PRSA.NE.LOOKW) RETURN                                        042130
        I=46                                                            042140
        IF(QOPEN(MACHI)) I=12                                           042150
        CALL RSPSUB(45,I)                                               042160
        RETURN                                                          042170
C                                                                       042180
C R17-- BAT ROOM.  UNLESS CARRYING GARLIC, FLY AWAY WITH ME...          042190
C                                                                       042200
17000   IF(PRSA.NE.LOOKW) GO TO 17500                                   042210
        CALL RSPEAK(48)                                                 042220
        IF(OADV(GARLI).EQ.WINNER) CALL RSPEAK(49)                       042230
        RETURN                                                          042240
C                                                                       042250
17500   IF((PRSA.NE.WALKIW).OR.(OADV(GARLI).EQ.WINNER)) RETURN          042260
        CALL RSPEAK(50)                                                 042270
        F=MOVETO(BATDRP(RND(9)+1))                                      042280
        RAPPLI=.FALSE.                                                  042290
        RETURN                                                          042300
C                                                                       042310
C R18-- DOME ROOM.  STATE DEPENDS ON WHETHER ROPE TIED TO RAILING.      042320
C                                                                       042330
18000   IF(PRSA.NE.LOOKW) GO TO 18500                                   042340
        CALL RSPEAK(51)                                                 042350
        IF(DOMEF) CALL RSPEAK(52)                                       042360
        RETURN                                                          042370
C                                                                       042380
18500   IF(PRSA.EQ.LEAPW) CALL JIGSUP(53)                               042390
        RETURN                                                          042400
C                                                                       042410
C R19-- TORCH ROOM.  ALSO DEPENDS ON WHETHER ROPE TIED TO RAILING.      042420
C                                                                       042430
19000   IF(PRSA.NE.LOOKW) RETURN                                        042440
        CALL RSPEAK(54)                                                 042450
        IF(DOMEF) CALL RSPEAK(55)                                       042460
        RETURN                                                          042470
C                                                                       042480
C R20-- CAROUSEL ROOM.  SPIN HIM OR KILL HIM.                           042490
C                                                                       042500
20000   IF(PRSA.NE.LOOKW) GO TO 20500                                   042510
        CALL RSPEAK(56)                                                 042520
        IF(.NOT.CAROFF) CALL RSPEAK(57)                                 042530
        RETURN                                                          042540
C                                                                       042550
20500   IF((PRSA.EQ.WALKIW).AND.CAROZF) CALL JIGSUP(58)                 042560
        RETURN                                                          042570
C RAPPLI, PAGE 7                                                        042580
C                                                                       042590
C R21-- LLD ROOM.  HANDLE EXORCISE, DESCRIPTIONS.                       042600
C                                                                       042610
21000   IF(PRSA.NE.LOOKW) GO TO 21500                                   042620
        CALL RSPEAK(59)                                                 042630
        IF(.NOT.LLDF) CALL RSPEAK(60)                                   042640
        RETURN                                                          042650
C                                                                       042660
21500   IF(PRSA.NE.EXORCW) RETURN                                       042670
        IF((OADV(BELL).EQ.WINNER).AND.(OADV(BOOK).EQ.WINNER).AND.       042680
     1       (OADV(CANDL).EQ.WINNER)) GO TO 21600                       042690
        CALL RSPEAK(62)                                                 042700
        RETURN                                                          042710
C                                                                       042720
21600   IF(QHERE(GHOST,HERE)) GO TO 21700                               042730
        CALL JIGSUP(61)                                                 042740
        RETURN                                                          042750
C                                                                       042760
21700   CALL NEWSTA(GHOST,63,0,0,0)                                     042770
        LLDF=.TRUE.                                                     042780
        RETURN                                                          042790
C                                                                       042800
C R22-- LLD2-ROOM.  IS HIS HEAD ON A POLE?                              042810
C                                                                       042820
22000   IF(PRSA.NE.LOOKW) RETURN                                        042830
        CALL RSPEAK(64)                                                 042840
        IF(ONPOLF) CALL RSPEAK(65)                                      042850
        RETURN                                                          042860
C                                                                       042870
C R23-- DAM ROOM.  DESCRIBE RESERVOIR, PANEL.                           042880
C                                                                       042890
23000   IF(PRSA.NE.LOOKW) RETURN                                        042900
        CALL RSPEAK(66)                                                 042910
        I=67                                                            042920
        IF(LWTIDF) I=68                                                 042930
        CALL RSPEAK(I)                                                  042940
        CALL RSPEAK(69)                                                 042950
        IF(GATEF) CALL RSPEAK(70)                                       042960
        RETURN                                                          042970
C                                                                       042980
C R24-- SPIDER ROOM.
C                                                                       043000
24000 CONTINUE
      BUGF = .FALSE.
      IF (PRSA .NE. LOOKW) GOTO 24020
      CALL RSPEAK(630)
      I = 631
      IF (OADV(FLASK) .NE. WINNER) GOTO 24010
      I = 632
      BUGF = .TRUE.

24010 CALL RSPEAK(I)
      RETURN

24020 IF (OADV(FLASK) .EQ. WINNER) BUGF = .TRUE.
      RETURN
C RAPPLI, PAGE 8                                                        043020
C                                                                       043030
C R25-- CYCLOPS-ROOM.  DEPENDS ON CYCLOPS STATE, ASLEEP FLAG, MAGIC FLAG043040
C                                                                       043050
25000   IF(PRSA.NE.LOOKW) RETURN                                        043060
        CALL RSPEAK(606)                                                043070
      IF(.NOT. (QHERE(CYCLO,HERE))) GOTO 25100                          001630
        I=607                                                           043080
        IF(RVCYC.GT.0) I=608                                            043090
        IF(RVCYC.LT.0) I=609                                            043100
        IF(CYCLOF) I=610                                                043110
        IF(MAGICF) I=611                                                043120
        CALL RSPEAK(I)                                                  043130
        IF(.NOT.CYCLOF .AND.(RVCYC.NE.0))                               043140
     1       CALL RSPEAK(193+IABS(RVCYC))                               043150
        RETURN                                                          043160
25100 CONTINUE                                                          001650
      IF(MAGICF) CALL RSPEAK(611)                                       001660
      RETURN                                                            001670
C                                                                       043170
C R26-- DECOMMITTED.                                                    043180
C                                                                       043190
26000   RETURN                                                          043200
C                                                                       043210
C R27-- TREASURE ROOM.                                                  043220
C                                                                       043230
27000   IF((PRSA.NE.WALKIW).OR. .NOT.THFACT)                            043240
     1       RETURN                                                     043250
        IF(OROOM(THIEF).NE.HERE)                                        043260
     1       CALL NEWSTA(THIEF,82,HERE,0,0)                             043270
        THFPOS=HERE                                                     043280
        OFLAG2(THIEF)=OR(OFLAG2(THIEF),FITEBT)                          043290
        IF(OROOM(CHALI).EQ.HERE)                                        043300
     1       OFLAG1(CHALI)=AND(OFLAG1(CHALI),COMPL(TAKEBT))             043310
C                                                                       043320
C       VANISH EVERYTHING IN ROOM                                       043330
C                                                                       043340
        J=0                                                             043350
        DO 27200 I=1,OLNT                                               043360
          IF((I.EQ.CHALI).OR.(I.EQ.THIEF).OR..NOT.QHERE(I,HERE))        043370
     1       GO TO 27200                                                043380
          J=83                                                          043390
          OFLAG1(I)=AND(OFLAG1(I),COMPL(VISIBT))                        043400
27200   CONTINUE                                                        043410
        CALL RSPEAK(J)                                                  043420
        RETURN                                                          043430
C                                                                       043440
C R28-- CLIFF FUNCTION.  SEE IF CARRYING INFLATED BOAT.                 043450
C                                                                       043460
28000   DEFLAF=OADV(RBOAT).NE.WINNER                                    043470
        RETURN                                                          043480
C RAPPLI, PAGE 9                                                        043490
C                                                                       043500
C R29-- RIVR4 ROOM.  PLAY WITH BUOY.                                    043510
C                                                                       043520
29000   IF(.NOT.BUOYF.OR.(OADV(BUOY).NE.WINNER)) RETURN                 043530
        CALL RSPEAK(84)                                                 043540
        BUOYF=.FALSE.                                                   043550
        RETURN                                                          043560
C                                                                       043570
C R30-- OVERFALLS.  DOOM.                                               043580
C                                                                       043590
30000   IF(PRSA.NE.LOOKW) CALL JIGSUP(85)                               043600
        RETURN                                                          043610
C                                                                       043620
C R31-- BEACH ROOM.  DIG A HOLE.                                        043630
C                                                                       043640
31000   IF((PRSA.NE.DIGW).OR.(PRSO.NE.SHOVE)) RETURN                    043650
        RVSND=RVSND+1                                                   043660
        GO TO (31100,31100,31100,31400,31500),RVSND
      CALL GOTOER
C        CALL BUG(2,RVSND)                                              043680
C                                                                       043690
31100   CALL RSPEAK(85+RVSND)                                           043700
        RETURN                                                          043710
C                                                                       043720
31400   I=89                                                            043730
        IF(AND(OFLAG1(STATU),VISIBT).NE.0) I=88                         043740
        CALL RSPEAK(I)                                                  043750
        OFLAG1(STATU)=OR(OFLAG1(STATU),VISIBT)                          043760
        RETURN                                                          043770
C                                                                       043780
31500   RVSND=0                                                         043790
        CALL JIGSUP(90)                                                 043800
        RETURN                                                          043810
C                                                                       043820
C R32-- TCAVE ROOM.  DIG A HOLE IN GUANO.                               043830
C                                                                       043840
32000   IF((PRSA.NE.DIGW).OR.(PRSO.NE.SHOVE)) RETURN                    043850
        I=91                                                            043860
        IF(.NOT. QHERE(GUANO,HERE)) GO TO 32100                         043870
        RVGUA=MIN0(4,RVGUA+1)                                           043880
        I=91+RVGUA                                                      043890
32100   CALL RSPEAK(I)                                                  043900
        RETURN                                                          043910
C                                                                       043920
C R33-- FALLS ROOM                                                      043930
C                                                                       043940
33000   IF(PRSA.NE.LOOKW) RETURN                                        043950
        CALL RSPEAK(96)                                                 043960
        I=97                                                            043970
        IF(RAINBF) I=98                                                 043980
        CALL RSPEAK(I)                                                  043990
        RETURN                                                          044000
C RAPPLI, PAGE 10                                                       044010
C                                                                       044020
C R34-- LEDGE FUNCTION.  LEDGE CAN COLLAPSE.                            044030
C                                                                       044040
34000   IF(PRSA.NE.LOOKW) RETURN                                        044050
        CALL RSPEAK(100)                                                044060
        I=102                                                           044070
        IF(AND(RFLAG(MSAFE),RMUNG).NE.0) I=101                          044080
        CALL RSPEAK(I)                                                  044090
        RETURN                                                          044100
C                                                                       044110
C R35-- SAFE ROOM.  STATE DEPENDS ON WHETHER SAFE BLOWN.                044120
C                                                                       044130
35000   IF(PRSA.NE.LOOKW) RETURN                                        044140
        CALL RSPEAK(104)                                                044150
        I=105                                                           044160
        IF(SAFEF) I=106                                                 044170
        CALL RSPEAK(I)                                                  044180
        RETURN                                                          044190
C                                                                       044200
C R36-- MAGNET ROOM.  DESCRIBE, CHECK FOR SPINDIZZY DOOM.               044210
C                                                                       044220
36000   IF(PRSA.NE.LOOKW) GO TO 36500                                   044230
        CALL RSPEAK(107)                                                044240
        RETURN                                                          044250
C                                                                       044260
36500   IF((PRSA.NE.WALKIW).OR. .NOT.CAROFF) RETURN                     044270
        IF(CAROZF) GO TO 36600                                          044280
        CALL RSPEAK(108)                                                044290
        RETURN                                                          044300
C                                                                       044310
36600   CALL JIGSUP(58)                                                 044320
        RETURN                                                          044330
C                                                                       044340
C R37-- CAGE ROOM.  IF SOLVED CAGE, MOVE TO OTHER CAGE ROOM.            044350
C                                                                       044360
37000   IF(CAGESF) F=MOVETO(CAGER)                                      044370
        RETURN                                                          044380
C                                                                       044390
        END                                                             044400
        LOGICAL FUNCTION SOBJS(RI,ARG)
        IMPLICIT INTEGER (A-Z)                                          044420
C SOBJS-        SIMPLE OBJECTS PROCESSOR                                044430
C       OBJECTS IN THIS MODULE CANNOT CALL RMINFO, JIGSUP,              044440
C       MAJOR VERBS, OR OTHER NON-RESIDENT SUBROUTINES                  044450
C                                                                       044460
C DECLARATIONS                                                          044470
C                                                                       044480
        LOGICAL QOPEN                                                   044490
        LOGICAL MOVETO,OPNCLS                                           044500
        LOGICAL QHERE,F                                                 044510
C                                                                       044520
C PARSER OUTPUT                                                         044530
C                                                                       044540
        LOGICAL PRSWON                                                  044550
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    044560
C                                                                       044570
C GAME STATE                                                            044580
C                                                                       044590
        LOGICAL TELFLG                                                  044600
        COMMON /PLAY/ WINNER,HERE,TELFLG                                044610
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               044620
     1       LTSHFT,BLOC,MUNGRM,HS                                      044630
C                                                                       044640
C ROOMS                                                                 044650
C                                                                       044660
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         044670
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                044680
C                                                                       044690
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                    044700
C                                                                       044710
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  044720
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            044730
C                                                                       044740
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               044750
        COMMON /RINDEX/ MTROL,MAZE1                                     044760
        COMMON /RINDEX/ MGRAT,MAZ15                                     044770
        COMMON /RINDEX/ FORE1,CLEAR,RESER                               044780
        COMMON /RINDEX/ STREA,EGYPT,ECHOR                               044790
        COMMON /RINDEX/ TSHAF                                           044800
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          044810
        COMMON /RINDEX/ CAROU                                           044820
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    044830
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             044840
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   044850
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         044860
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   044870
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001270
C                                                                       044890
C OBJECTS                                                               044900
C                                                                       044910
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       044920
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            044930
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              044940
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  044950
C                                                                       044960
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      044970
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          044980
     2       TOOLBT,TURNBT,ONBT                                         044990
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       045000
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           045010
     2       TCHBT,VEHBT,SCHBT                                          045020
C                                                                       045030
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    045040
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           045050
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 045060
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              045070
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   045080
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     045090
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        045100
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    045110
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          045120
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                045130
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              045140
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         045150
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               045160
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    045170
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  045180
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   045190
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       045210
C CLOCK INTERRUPTS                                                      045220
C                                                                       045230
        LOGICAL CFLAG                                                   045240
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             045250
C                                                                       045260
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             045270
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 045280
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                045290
C                                                                       045300
C VILLAINS AND DEMONS                                                   045310
C                                                                       045320
        LOGICAL THFFLG,SWDACT,THFACT                                    045330
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA                045340
C                                                                       045350
C ADVENTURERS                                                           045360
C                                                                       045370
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                045380
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       045390
C                                                                       045400
        COMMON /AINDEX/ PLAYER,AROBOT                                   045410
C                                                                       045420
C VERBS                                                                 045430
C                                                                       045440
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  045450
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              045460
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         045470
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            045480
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           045490
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  045500
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    045510
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            045520
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       045530
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       045540
        COMMON /VINDEX/ DIGW,LEAPW                                      045550
C                                                                       045560
C FLAGS                                                                 045570
C                                                                       045580
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               045600
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   045610
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                045620
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 045630
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                045640
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      045660
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     045670
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  045680
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   045690
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  045700
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     045720
        EQUIVALENCE (FLAGS(1),TROLLF)                                   045730
        QOPEN(R)=AND(OFLAG2(R),OPENBT).NE.0
C SOBJS, PAGE 2                                                         045750
C                                                                       045760
        IF(PRSO.NE.0.AND.PRSO.LE.160) ODO2=ODESC2(PRSO)                 045770
        IF(PRSI.NE.0.AND.PRSI.LE.160) ODI2=ODESC2(PRSI)                 045780
        AV=AVEHIC(WINNER)                                               045790
        SOBJS=.TRUE.                                                    045800
C                                                                       045810
        GO TO (1000,3000,4000,6000,7000,8000,9000,
     1 13000,14000,16000,17000,
     2 21000,23000,24000,27000,28000,29000,30000,
     3 31000,33000,34000,36000,37000,38000,
     4 41000,42000,43000,44000,46000,
     5 53000,56000),
     6       RI
      CALL GOTOER
C        CALL BUG(6,RI)                                                 045890
C                                                                       045900
C RETURN HERE TO DECLARE FALSE RESULT                                   045910
C                                                                       045920
10      SOBJS=.FALSE.                                                   045930
        RETURN                                                          045940
C SOBJS, PAGE 3                                                         045950
C                                                                       045960
C O1--  GUNK FUNCTION                                                   045970
C                                                                       045980
1000    IF(OCAN(GUNK).EQ.0) GO TO 10                                    045990
        CALL NEWSTA(GUNK,122,0,0,0)                                     046000
        RETURN                                                          046010
C                                                                       046020
C O2--  TROPHY CASE                                                     046030
C                                                                       046040
3000    IF(PRSA.NE.TAKEW) GO TO 10                                      046050
        CALL RSPEAK(128)                                                046060
        RETURN                                                          046070
C                                                                       046080
C O3--  BOTTLE FUNCTION                                                 046090
C                                                                       046100
4000    IF(PRSA.NE.THROWW) GO TO 4100                                   046110
        CALL NEWSTA(PRSO,129,0,0,0)                                     046120
        RETURN                                                          046130
C                                                                       046140
4100    IF(PRSA.NE.MUNGW) GO TO 10                                      046150
        IF(OADV(PRSO).NE.WINNER) GO TO 4150                             046160
        CALL NEWSTA(PRSO,130,0,0,0)                                     046170
        RETURN                                                          046180
C                                                                       046190
4150    IF(.NOT.QHERE(PRSO,HERE)) GO TO 10                              046200
        CALL NEWSTA(PRSO,131,0,0,0)                                     046210
        RETURN                                                          046220
C SOBJS, PAGE 4                                                         046230
C                                                                       046240
C O4--  ROPE FUNCTION                                                   046250
C                                                                       046260
6000    IF(HERE.EQ.DOME) GO TO 6100                                     046270
        DOMEF=.FALSE.                                                   046280
        IF(PRSA.NE.UNTIEW) GO TO 6050                                   046290
        CALL RSPEAK(134)                                                046300
        RETURN                                                          046310
C                                                                       046320
6050    IF(PRSA.NE.TIEW) GO TO 10                                       046330
        CALL RSPEAK(135)                                                046340
        RETURN                                                          046350
C                                                                       046360
6100    IF((PRSA.NE.TIEW).OR.(PRSI.NE.RAILI)) GO TO 6200                046370
        IF(DOMEF) GO TO 6150                                            046380
        DOMEF=.TRUE.                                                    046390
