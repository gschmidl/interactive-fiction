        IF(QHERE(J,HERE).OR.((AV.NE.0).AND.(OCAN(J).EQ.AV)))            056000
     1       GO TO 60200                                                056010
60150   CALL RSPEAK(461)                                                056020
        RETURN                                                          056030
C                                                                       056040
60200   CALL RSPSUB(462,ODO2)                                           056050
        CALL NEWSTA(PRSO,0,0,0,0)                                       056060
        RETURN                                                          056070
C                                                                       056080
60300   CALL RSPSUB(463,ODO2)                                           056090
        RETURN                                                          056100
C                                                                       056110
60400   CALL RSPSUB(301,ODI2)                                           056120
        RETURN                                                          056130
C VAPPLI, PAGE 9                                                        056140
C                                                                       056150
C V138--        MUNG.  GO TO COMMON ATTACK CODE.                        056160
C                                                                       056170
63000   I=466                                                           056180
        IF(AND(OFLAG2(PRSO),VILLBT).NE.0) GO TO 66300                   056190
        IF(.NOT.OBJACT(X)) CALL RSPSB2(466,ODO2,RMK)                    056200
        RETURN                                                          056210
C                                                                       056220
C V139--        KILL.  GO TO COMMON ATTACK CODE.                        056230
C                                                                       056240
64000   I=467                                                           056250
        GO TO 66100                                                     056260
C                                                                       056270
C V140--        SWING.  INVERT OBJECTS, FALL THRU TO ATTACK.            056280
C                                                                       056290
65000   J=PRSO                                                          056300
        PRSO=PRSI                                                       056310
        PRSI=J                                                          056320
        J=ODO2                                                          056330
        ODO2=ODI2                                                       056340
        ODI2=J                                                          056350
        PRSA=ATTACW                                                     056360
C                                                                       056370
C V141--        ATTACK.  FALL THRU TO ATTACK CODE.                      056380
C                                                                       056390
66000   I=468                                                           056400
C                                                                       056410
C COMMON MUNG/ATTACK/SWING/KILL CODE.                                   056420
C                                                                       056430
66100   IF(PRSO.NE.0) GO TO 66200                                       056440
        CALL RSPEAK(469)                                                056450
        RETURN                                                          056460
C                                                                       056470
66200   IF(AND(OFLAG2(PRSO),VILLBT).NE.0) GO TO 66300                   056480
        CALL RSPSUB(470,ODO2)                                           056490
        RETURN                                                          056500
C                                                                       056510
66300   J=471                                                           056520
        IF(PRSI.EQ.0) GO TO 66500                                       056530
        IF(AND(OFLAG2(PRSI),WEAPBT).EQ.0) GO TO 66400                   056540
        IF(.NOT.OBJACT(X))                                              056550
     1 I=BLOW(PLAYER,PRSO,ORAND(PRSI),.TRUE.,0)                         056560
        RETURN                                                          056570
C                                                                       056580
66400   J=472                                                           056590
66500   CALL RSPSB2(I,ODO2,J)                                           056600
        RETURN                                                          056610
C VAPPLI, PAGE 10                                                       056620
C                                                                       056630
C V142--        WALK.  PROCESSED EXTERNALLY.                            056640
C                                                                       056650
68000   VAPPLI=WALK(X)                                                  056660
        RETURN                                                          056670
C                                                                       056680
C V143--        TELL.  PROCESSED IN GAME.                               056690
C                                                                       056700
69000   CALL RSPEAK(603)                                                056710
        RETURN                                                          056720
C                                                                       056730
C V144--        PUT.  PROCESSED EXTERNALLY.                             056740
C                                                                       056750
70000   VAPPLI=PUT(.TRUE.)                                              056760
        RETURN                                                          056770
C                                                                       056780
C V145,V146,V147,V148-- DROP/GIVE/POUR/THROW                            056790
C                                                                       056800
71000   CONTINUE                                                        056810
72000   CONTINUE                                                        056820
73000   CONTINUE                                                        056830
74000   VAPPLI=DROP(.FALSE.)                                            056840
        RETURN                                                          056850
C                                                                       056860
C V149--        SAVE                                                    056870
C                                                                       056880
77000   CALL SAVEGM                                                     056890
        RETURN                                                          056900
C                                                                       056910
C V150--        RESTORE                                                 056920
C                                                                       056930
78000   CALL RSTRGM                                                     056940
        RETURN                                                          056950
C                                                                       056960
        END                                                             056970
        LOGICAL FUNCTION AAPPLI(RI)
        IMPLICIT INTEGER (A-Z)                                          056990
C AAPPLI- APPLICABLES FOR ADVENTURERS                                   057000
C                                                                       057010
C DECLARATIONS                                                          057020
C                                                                       057030
        LOGICAL F,MOVETO                                                057040
C                                                                       057050
C PARSER OUTPUT                                                         057060
C                                                                       057070
        LOGICAL PRSWON                                                  057080
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    057090
C                                                                       057100
C GAME STATE                                                            057110
C                                                                       057120
        LOGICAL TELFLG                                                  057130
        COMMON /PLAY/ WINNER,HERE,TELFLG                                057140
C                                                                       057150
C ROOMS                                                                 057160
C                                                                       057170
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         057180
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                057190
C                                                                       057200
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  057210
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            057220
C                                                                       057230
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               057240
        COMMON /RINDEX/ MTROL,MAZE1                                     057250
        COMMON /RINDEX/ MGRAT,MAZ15                                     057260
        COMMON /RINDEX/ FORE1,CLEAR,RESER                               057270
        COMMON /RINDEX/ STREA,EGYPT,ECHOR                               057280
        COMMON /RINDEX/ TSHAF                                           057290
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          057300
        COMMON /RINDEX/ CAROU                                           057310
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    057320
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             057330
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   057340
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         057350
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   057360
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001290
C                                                                       057380
C OBJECTS                                                               057390
C                                                                       057400
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       057410
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            057420
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              057430
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  057440
C                                                                       057450
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      057460
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          057470
     2       TOOLBT,TURNBT,ONBT                                         057480
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       057490
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           057500
     2       TCHBT,VEHBT,SCHBT                                          057510
C                                                                       057520
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    057530
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           057540
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 057550
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              057560
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   057570
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     057580
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        057590
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    057600
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          057610
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                057620
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              057630
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         057640
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               057650
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    057660
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  057670
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   057680
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       057700
C CLOCK INTERRUPTS                                                      057710
C                                                                       057720
        LOGICAL CFLAG                                                   057730
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             057740
C                                                                       057750
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             057760
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 057770
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                057780
C                                                                       057790
C ADVENTURERS                                                           057800
C                                                                       057810
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                057820
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       057830
C                                                                       057840
        COMMON /AINDEX/ PLAYER,AROBOT                                   057850
C                                                                       057860
C VERBS                                                                 057870
C                                                                       057880
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  057890
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              057900
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         057910
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            057920
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           057930
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  057940
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    057950
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            057960
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       057970
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       057980
        COMMON /VINDEX/ DIGW,LEAPW                                      057990
C                                                                       058000
C FLAGS                                                                 058010
C                                                                       058020
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               058040
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   058050
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                058060
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 058070
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                058080
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      058100
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     058110
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  058120
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   058130
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  058140
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     058160
        EQUIVALENCE (FLAGS(1),TROLLF)                                   058170
C AAPPLI, PAGE 2                                                        058180
C                                                                       058190
        AAPPLI=.TRUE.                                                   058200
        GO TO (1000),RI
      CALL GOTOER
C        CALL BUG(11,RI)                                                058220
C                                                                       058230
C A1--  ROBOT.  PROCESS MOST COMMANDS GIVEN TO ROBOT.                   058240
C                                                                       058250
1000    IF((PRSA.NE.RAISEW).OR.(PRSO.NE.CAGE)) GO TO 1200               058260
        CFLAG(CEVSPH)=.FALSE.                                           058270
        WINNER=PLAYER                                                   058280
        F=MOVETO(CAGER)                                                 058290
        CALL NEWSTA(CAGE,567,CAGER,0,0)                                 058300
        CALL NEWSTA(ROBOT,0,CAGER,0,0)                                  058310
        AROOM(AROBOT)=CAGER                                             058320
        CAGESF=.TRUE.                                                   058330
        OFLAG1(CAGE)=AND(OR(OFLAG1(CAGE),TAKEBT) ,COMPL(NDSCBT))        058340
        OFLAG1(ROBOT)=AND(OFLAG1(ROBOT),COMPL(NDSCBT))                  058350
        OFLAG1(SPHER)=OR(OFLAG1(SPHER),TAKEBT)                          058360
        RETURN                                                          058370
C                                                                       058380
1200    IF((PRSA.NE.DRINKW).AND.(PRSA.NE.EATW)) GO TO 1300              058390
        CALL RSPEAK(568)                                                058400
        RETURN                                                          058410
C                                                                       058420
1300    IF(PRSA.NE.READW) GO TO 1400                                    058430
        CALL RSPEAK(569)                                                058440
        RETURN                                                          058450
C                                                                       058460
1400    AAPPLI=.FALSE.                                                  058470
        IF((PRSA.EQ.WALKW).OR.(PRSA.EQ.TAKEW).OR.(PRSA.EQ.DROPW)        058480
     1 .OR.(PRSA.EQ.PUTW).OR.(PRSA.EQ.PUSHW).OR.(PRSA.EQ.THROWW)        058490
     2 .OR.(PRSA.EQ.TURNW).OR.(PRSA.EQ.LEAPW)) RETURN                   058500
        AAPPLI=.TRUE.                                                   058510
        CALL RSPEAK(570)                                                058520
        RETURN                                                          058530
C                                                                       058540
        END                                                             058550
        SUBROUTINE THIEFD
        IMPLICIT INTEGER (A-Z)                                          058570
C THIEFD-      INTERMOVE THIEF DEMON                                    058580
C                                                                       058590
C DECLARATIONS                                                          058600
C                                                                       058610
        LOGICAL DFLAG,ONCE,PROB,QHERE,QSTILL,WINNIN                     058620
C                                                                       058630
C GAME STATE                                                            058640
C                                                                       058650
        LOGICAL TELFLG                                                  058660
        COMMON /PLAY/ WINNER,HERE,TELFLG                                058670
C                                                                       058680
        COMMON /DEBUG/ DBGFLG,PRSFLG                                    058690
C                                                                       058700
C ROOMS                                                                 058710
C                                                                       058720
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         058730
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                058740
C                                                                       058750
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  058760
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            058770
C                                                                       058780
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               058790
        COMMON /RINDEX/ MTROL,MAZE1                                     058800
        COMMON /RINDEX/ MGRAT,MAZ15                                     058810
        COMMON /RINDEX/ FORE1,CLEAR,RESER                               058820
        COMMON /RINDEX/ STREA,EGYPT,ECHOR                               058830
        COMMON /RINDEX/ TSHAF                                           058840
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          058850
        COMMON /RINDEX/ CAROU                                           058860
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    058870
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             058880
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   058890
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         058900
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   058910
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001310
C                                                                       058930
C OBJECTS                                                               058940
C                                                                       058950
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       058960
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            058970
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              058980
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  058990
C                                                                       059000
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      059010
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          059020
     2       TOOLBT,TURNBT,ONBT                                         059030
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       059040
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           059050
     2       TCHBT,VEHBT,SCHBT                                          059060
C                                                                       059070
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    059080
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           059090
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 059100
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              059110
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   059120
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     059130
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        059140
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    059150
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          059160
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                059170
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              059180
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         059190
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               059200
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    059210
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  059220
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   059230
C                                                                       059240
C VILLAINS AND DEMONS                                                   059250
C                                                                       059260
        LOGICAL THFFLG,SWDACT,THFACT                                    059270
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA                059280
C                                                                       059290
C FLAGS                                                                 059300
C                                                                       059310
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               059330
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   059340
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                059350
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 059360
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                059370
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      059390
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     059400
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  059410
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   059420
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  059430
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     059450
        EQUIVALENCE (FLAGS(1),TROLLF)                                   059460
                                                                        059470
        QSTILL(R)=(QHERE(STILL,R).OR.(OADV(STILL).EQ.-THIEF))
        PROB(R)=(RND(100).LT.R)
C THIEFD, PAGE 2                                                        059500
C                                                                       059510
C       DFLAG=(PRSFLG.AND.100000B).NE.0          SET UP DETAIL FLAG.    059520
        ONCE=.FALSE.                                                    059530
1025    RHERE=OROOM(THIEF)                                              059540
        IF(RHERE.NE.0) THFPOS=RHERE                                     059550
C                                                                       059560
        IF(THFPOS.EQ.HERE) GO TO 1100                                   059570
        IF(THFPOS.NE.TREAS) GO TO 1400                                  059580
C                                                                       059590
C THIEF IS IN TREASURE ROOM, AND WINNER IS NOT.                         059600
C                                                                       059610
C       IF(DFLAG) PRINT 10                                              059620
C10     FORMAT(" THIEFD-- IN TREASURE ROOM")                            059630
        IF(RHERE.EQ.0) GO TO 1050                                       059640
        CALL NEWSTA(THIEF,0,0,0,0)                                      059650
        RHERE=0                                                         059660
        IF(QSTILL(TREAS)) CALL NEWSTA(STILL,0,0,THIEF,0)                059670
1050    I=ROBADV(-THIEF,THFPOS,0,0)                                     059680
        GO TO 1700                                                      059690
C                                                                       059700
C THIEF AND WINNER IN SAME ROOM.                                        059710
C                                                                       059720
1100    IF(THFPOS.EQ.TREAS) GO TO 1700                                  059730
C       IF(DFLAG) PRINT 20                                              059740
C20     FORMAT(" THIEFD-- IN ADV ROOM")                                 059750
        IF(THFFLG) GO TO 1300                                           059760
        IF((RHERE.NE.0).OR.PROB(70)) GO TO 1150                         059770
        IF(OCAN(STILL).NE.THIEF) GO TO 1700                             059780
        CALL NEWSTA(THIEF,583,THFPOS,0,0)                               059790
        THFFLG=.TRUE.                                                   059800
        RETURN                                                          059810
C                                                                       059820
1150    IF((RHERE.EQ.0).OR.(AND(OFLAG2(THIEF),FITEBT).EQ.0))            059830
     1       GO TO 1200                                                 059840
       IF(WINNIN(THIEF,WINNER)) GO TO 1175                              059850
        CALL NEWSTA(THIEF,584,0,0,0)                                    059860
        OFLAG2(THIEF)=AND(OFLAG2(THIEF),COMPL(FITEBT))                  059870
        IF(QSTILL(THFPOS)) CALL NEWSTA(STILL,0,0,THIEF,0)               059880
        RETURN                                                          059890
C                                                                       059900
1175    IF(PROB(90)) GO TO 1700                                         059910
C                                                                       059920
1200    IF((RHERE.EQ.0).OR.PROB(70)) GO TO 1250                         059930
        CALL NEWSTA(THIEF,585,0,0,0)                                    059940
        IF(QSTILL(THFPOS)) CALL NEWSTA(STILL,0,0,THIEF,0)               059950
        RETURN                                                          059960
C                                                                       059970
1300    IF(RHERE.EQ.0) GO TO 1700                                       059980
1250    IF(PROB(70)) RETURN                                             059990
        THFFLG=.TRUE.                                                   060000
        NR=ROBRM(THFPOS,100,0,0,-THIEF)+ROBADV(WINNER,0,0,-THIEF)       060010
        I=586                                                           060020
        IF(RHERE.NE.0) I=588                                            060030
        IF(NR.NE.0) I=I+1                                               060040
        CALL NEWSTA(THIEF,I,0,0,0)                                      060050
        IF(QSTILL(THFPOS))                                              060060
     1       CALL NEWSTA(STILL,0,0,THIEF,0)                             060070
        RHERE=0                                                         060080
        GO TO 1700                                                      060090
C                                                                       060100
C NOT IN ADVENTURERS ROOM.                                              060110
C                                                                       060120
1400    CALL NEWSTA(THIEF,0,0,0,0)                                      060130
        RHERE=0                                                         060140
C       IF(DFLAG) PRINT 30,THFPOS                                       060150
C30     FORMAT(" THIEFD-- IN ROOM ",I4)                                 060160
        IF(QSTILL(THFPOS))                                              060170
     1       CALL NEWSTA(STILL,0,0,THIEF,0)                             060180
        IF(AND(RFLAG(THFPOS),RSEEN).EQ.0) GO TO 1700                    060190
        I=ROBRM(THFPOS,75,0,0,-THIEF)                                   060200
        IF((THFPOS.LT.MAZE1).OR.(THFPOS.GT.MAZ15).OR.                   060210
     1       (HERE.LT.MAZE1).OR.(HERE.GT.MAZ15)) GO TO 1500             060220
        DO 1450 I=1,OLNT                                                060230
          IF(.NOT.QHERE(I,THFPOS).OR.PROB(60).OR.                       060240
     1       (AND(OFLAG1(I),(VISIBT+TAKEBT)).NE.(VISIBT+TAKEBT)))       060250
     2       GOTO 1450                                                  060260
          CALL RSPSUB(590,ODESC2(I))                                    060270
          IF(PROB(40)) GO TO 1700                                       060280
          CALL NEWSTA(I,0,0,0,-THIEF)                                   060290
          OFLAG2(I)=OR(OFLAG2(I),TCHBT)                                 060300
          GO TO 1700                                                    060310
1450    CONTINUE                                                        060320
        GO TO 1700                                                      060330
C                                                                       060340
1500    DO 1550 I=1,OLNT                                                060350
          IF(.NOT.QHERE(I,THFPOS).OR.(OTVAL(I).NE.0).OR.PROB(80).OR.    060360
     1       (AND(OFLAG1(I),(VISIBT+TAKEBT)).NE.(VISIBT+TAKEBT)))       060370
     2       GOTO 1550                                                  060380
          CALL NEWSTA(I,0,0,0,-THIEF)                                   060390
          OFLAG2(I)=OR(OFLAG2(I),TCHBT)                                 060400
          GO TO 1700                                                    060410
1550    CONTINUE                                                        060420
C                                                                       060430
C NOW MOVE TO NEW ROOM.                                                 060440
C                                                                       060450
1700    IF(OADV(ROPE).EQ.-THIEF) DOMEF=.FALSE.                          060460
        IF(ONCE) GO TO 1800                                             060470
        ONCE=.NOT.ONCE                                                  060480
1750    THFPOS=THFPOS-1                                                 060490
        IF(THFPOS.LE.0) THFPOS=RLNT                                     060500
        IF(AND(RFLAG(THFPOS),(RLAND+RSACRD)).NE.RLAND)                  060510
     1       GO TO 1750                                                 060520
        THFFLG=.FALSE.                                                  060530
        GO TO 1025                                                      060540
C                                                                       060550
C ALL DONE.                                                             060560
C                                                                       060570
1800    IF(THFPOS.EQ.TREAS) RETURN                                      060580
        J=591                                                           060590
        IF(THFPOS.NE.HERE) J=0                                          060600
        DO 1850 I=1,OLNT                                                060610
          IF((OADV(I).NE.-THIEF).OR.PROB(70).OR.                        060620
     1       (OTVAL(I).GT.0)) GO TO 1850                                060630
          CALL NEWSTA(I,J,THFPOS,0,0)                                   060640
          J=0                                                           060650
1850    CONTINUE                                                        060660
        RETURN                                                          060670
C                                                                       060680
        END
        LOGICAL FUNCTION BALLOP(ARG)
        IMPLICIT INTEGER (A-Z)                                          060710
C BALLOP-       BALLOON FUNCTION                                        060720
C                                                                       060730
C DECLARATIONS                                                          060740
C                                                                       060750
        LOGICAL FINDXT,QEMPTY                                           060760
C                                                                       060770
C PARSER OUTPUT                                                         060780
C                                                                       060790
        LOGICAL PRSWON                                                  060800
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    060810
C                                                                       060820
C GAME STATE                                                            060830
C                                                                       060840
        LOGICAL TELFLG                                                  060850
        COMMON /PLAY/ WINNER,HERE,TELFLG                                060860
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               060870
     1       LTSHFT,BLOC,MUNGRM,HS                                      060880
C                                                                       060890
C ROOMS                                                                 060900
C                                                                       060910
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         060920
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                060930
C                                                                       060940
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  060950
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            060960
C                                                                       060970
C EXITS                                                                 060980
C                                                                       060990
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ                  061000
        EQUIVALENCE (XFLAG,XOBJ)                                        061010
C                                                                       061020
        COMMON /XPARS/ XRMASK,XDMASK,XFMASK,XFSHFT,XASHFT,              061030
     1       XELNT(4),XNORM,XNO,XCOND,XDOOR,XLFLAG                      061040
C                                                                       061050
C OBJECTS                                                               061060
C                                                                       061070
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       061080
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            061090
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              061100
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  061110
C                                                                       061120
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      061130
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          061140
     2       TOOLBT,TURNBT,ONBT                                         061150
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       061160
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           061170
     2       TCHBT,VEHBT,SCHBT                                          061180
C                                                                       061190
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    061200
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           061210
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 061220
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              061230
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   061240
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     061250
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        061260
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    061270
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          061280
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                061290
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              061300
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         061310
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               061320
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    061330
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  061340
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   061350
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       061370
C CLOCK INTERRUPTS                                                      061380
C                                                                       061390
        LOGICAL CFLAG                                                   061400
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             061410
C                                                                       061420
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             061430
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 061440
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                061450
C                                                                       061460
C VERBS                                                                 061470
C                                                                       061480
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  061490
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              061500
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         061510
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            061520
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           061530
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  061540
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    061550
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            061560
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       061570
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       061580
        COMMON /VINDEX/ DIGW,LEAPW                                      061590
C                                                                       061600
C FLAGS                                                                 061610
C                                                                       061620
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               061640
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   061650
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                061660
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 061670
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                061680
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      061700
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     061710
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  061720
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   061730
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  061740
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     061760
        EQUIVALENCE (FLAGS(1),TROLLF)                                   061770
C BALLOP, PAGE 2                                                        061780
C                                                                       061790
        BALLOP=.TRUE.                                                   061800
        IF(ARG.NE.2) GO TO 200                                          061810
        IF(PRSA.NE.LOOKW) GO TO 10                                      061820
        IF(BINFF.NE.0) GO TO 50                                         061830
        CALL RSPEAK(543)                                                061840
        GO TO 100                                                       061850
50      CALL RSPSUB(544,ODESC2(BINFF))                                  061860
100     IF(BTIEF.NE.0) CALL RSPEAK(545)                                 061870
        RETURN                                                          061880
C                                                                       061890
200     IF(ARG.NE.1) GO TO 500                                          061900
        IF(PRSA.NE.WALKW) GO TO 300                                     061910
        IF(FINDXT(PRSO,HERE)) GO TO 250                                 061920
        CALL RSPEAK(546)                                                061930
        RETURN                                                          061940
C                                                                       061950
250     IF(BTIEF.EQ.0) GO TO 275                                        061960
        CALL RSPEAK(547)                                                061970
        RETURN                                                          061980
C                                                                       061990
275     IF(XTYPE.NE.XNORM) GO TO 10                                     062000
        IF(AND(RFLAG(XROOM1),RMUNG).EQ.0) BLOC=XROOM1                   062010
10      BALLOP=.FALSE.                                                  062020
        RETURN                                                          062030
C                                                                       062040
300     IF((PRSA.NE.TAKEW).OR.(PRSO.NE.BINFF)) GO TO 350                062050
        CALL RSPSUB(548,ODESC2(BINFF))                                  062060
        RETURN                                                          062070
C                                                                       062080
350     IF((PRSA.NE.PUTW).OR.(PRSI.NE.RECEP).OR.QEMPTY(RECEP))          062090
     1       GO TO 10                                                   062100
        CALL RSPEAK(549)                                                062110
        RETURN                                                          062120
C                                                                       062130
500     IF((PRSA.NE.UNBOAW).OR.(AND(RFLAG(HERE),RLAND).EQ.0))           062140
     1       GO TO 600                                                  062150
        IF(BINFF.NE.0) CTICK(CEVBAL)=3                                  062160
        GO TO 10                                                        062170
C                                                                       062180
600     IF((PRSA.NE.BURNW).OR.(OCAN(PRSO).NE.RECEP)) GO TO 10           062190
        CALL RSPSUB(550,ODESC2(PRSO))                                   062200
        CTICK(CEVBRN)=OSIZE(PRSO)*20                                    062210
        OFLAG1(PRSO)=AND(OR(OFLAG1(PRSO),(ONBT+FLAMBT+LITEBT)),         062220
     1       COMPL(TAKEBT+READBT))                                      062230
        IF(BINFF.NE.0) RETURN                                           062240
        CALL NEWSTA(BLABE,0,0,BALLO,0)                                  062250
        BINFF=PRSO                                                      062260
        CTICK(CEVBAL)=3                                                 062270
        CALL RSPEAK(551)                                                062280
        RETURN                                                          062290
C                                                                       062300
        END
        LOGICAL FUNCTION CLOCKD(X)
        IMPLICIT INTEGER (A-Z)                                          062330
C CLOCKD- CLOCK DEMON FOR INTERMOVE CLOCK EVENTS                        062340
C                                                                       062350
C DECLARATIONS                                                          062360
C                                                                       062370
C                                                                       062380
C CLOCK INTERRUPTS                                                      062390
C                                                                       062400
        LOGICAL CFLAG                                                   062410
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             062420
C                                                                       062430
        DO 100 I=1,CLNT                                                 062440
          IF(.NOT.CFLAG(I) .OR.(CTICK(I).EQ.0)) GO TO 100               062450
          IF(CTICK(I).LT.0) GO TO 50                                    062460
          CTICK(I)=CTICK(I)-1                                           062470
          IF(CTICK(I).NE.0) GO TO 100                                   062480
          CLOCKD=.TRUE.                                                 062490
50        CALL CEVAPP(CACTIO(I))                                        062500
100     CONTINUE                                                        062510
        RETURN                                                          062520
C                                                                       062530
        END
        SUBROUTINE CEVAPP(RI)
        IMPLICIT INTEGER (A-Z)                                          062560
C CEVAPP- CLOCK EVENT APPLICABLES                                       062570
C                                                                       062580
C DECLARATIONS                                                          062590
C                                                                       062600
        INTEGER CNDTCK(10),LMPTCK(12)                                   062610
        LOGICAL RMINFO,QOPEN,F,QLEDGE,QVAIR,QHERE,MOVETO                062620
C                                                                       062630
C GAME STATE                                                            062640
C                                                                       062650
        LOGICAL TELFLG                                                  062660
        COMMON /PLAY/ WINNER,HERE,TELFLG                                062670
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               062680
     1       LTSHFT,BLOC,MUNGRM,HS                                      062690
C                                                                       062700
C ROOMS                                                                 062710
C                                                                       062720
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         062730
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                062740
C                                                                       062750
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                    062760
C                                                                       062770
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  062780
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            062790
C                                                                       062800
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               062810
        COMMON /RINDEX/ MTROL,MAZE1                                     062820
        COMMON /RINDEX/ MGRAT,MAZ15                                     062830
        COMMON /RINDEX/ FORE1,CLEAR,RESER                               062840
        COMMON /RINDEX/ STREA,EGYPT,ECHOR                               062850
        COMMON /RINDEX/ TSHAF                                           062860
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          062870
        COMMON /RINDEX/ CAROU                                           062880
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    062890
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             062900
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   062910
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         062920
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   062930
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001330
C                                                                       062950
C OBJECTS                                                               062960
C                                                                       062970
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       062980
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            062990
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              063000
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  063010
C                                                                       063020
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      063030
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          063040
     2       TOOLBT,TURNBT,ONBT                                         063050
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       063060
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           063070
     2       TCHBT,VEHBT,SCHBT                                          063080
C                                                                       063090
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    063100
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           063110
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 063120
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              063130
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   063140
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     063150
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        063160
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    063170
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          063180
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                063190
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              063200
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         063210
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               063220
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    063230
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  063240
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   063250
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       063270
C CLOCK INTERRUPTS                                                      063280
C                                                                       063290
        LOGICAL CFLAG                                                   063300
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             063310
C                                                                       063320
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             063330
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 063340
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                063350
C                                                                       063360
C VILLAINS AND DEMONS                                                   063370
C                                                                       063380
        LOGICAL THFFLG,SWDACT,THFACT                                    063390
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA                063400
C                                                                       063410
C ADVENTURERS                                                           063420
C                                                                       063430
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                063440
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       063450
C                                                                       063460
        COMMON /AINDEX/ PLAYER,AROBOT                                   063470
C                                                                       063480
C FLAGS                                                                 063490
C                                                                       063500
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               063520
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   063530
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                063540
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 063550
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                063560
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      063580
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     063590
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  063600
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   063610
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  063620
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     063640
        EQUIVALENCE (FLAGS(1),TROLLF)                                   063650
                                                                        063660
        QOPEN(R)=AND(OFLAG2(R),OPENBT).NE.0
        QLEDGE(R)=(R.EQ.LEDG2).OR.(R.EQ.LEDG3).OR.(R.EQ.LEDG4).OR.
     1       (R.EQ.VLBOT)
        QVAIR(R)=(R.EQ.VAIR1).OR.(R.EQ.VAIR2).OR.(R.EQ.VAIR3).OR.
     1        (R.EQ.VAIR4)
        DATA CNDTCK/50,20,10,5,0,156,156,156,157,0/                     063720
        DATA LMPTCK/50,30,20,10,4,0,154,154,154,154,155,0/              063730
C CEVAPP, PAGE 2                                                        063740
C                                                                       063750
        IF(RI.EQ.0) RETURN                                              063760
        GO TO (1000,2000,3000,4000,5000,6000,7000,8000,9000,10000,
     +11000,12000,13000,14000,15000,16000,17000),RI
      CALL GOTOER
C        CALL BUG(3,RI)                                                 063790
C                                                                       063800
C CEV1--        CURE CLOCK.  LET PLAYER SLOWLY RECOVER.                 063810
C                                                                       063820
1000    ASTREN(PLAYER)=MIN0(0,ASTREN(PLAYER)+1)                         063830
        IF(ASTREN(PLAYER).GE.0) RETURN                                  063840
        CTICK(CEVCUR)=30                                                063850
        RETURN                                                          063860
C                                                                       063870
C CEV2--        MAINT-ROOM WITH LEAK.  RAISE THE WATER LEVEL.           063880
C                                                                       063890
2000    IF(HERE.EQ.MAINT) CALL RSPEAK(71+(RVMNT/2))                     063900
        RVMNT=RVMNT+1                                                   063910
        IF(RVMNT.LE.16) RETURN                                          063920
        CTICK(CEVMNT)=0                                                 063930
        RFLAG(MAINT)=OR(RFLAG(MAINT),RMUNG)                             063940
        RRAND(MAINT)=80                                                 063950
        IF(HERE.EQ.MAINT) CALL JIGSUP(81)                               063960
        RETURN                                                          063970
C                                                                       063980
C CEV3--        LANTERN.  DESCRIBE GROWING DIMNESS.                     063990
C                                                                       064000
3000    CALL LITINT(LAMP,CEVLNT,LMPTCK,12)                              064010
        RETURN                                                          064020
C                                                                       064030
C CEV4--        MATCH.  OUT IT GOES.                                    064040
C                                                                       064050
4000    CALL RSPEAK(153)                                                064060
        OFLAG1(MATCH)=AND(OFLAG1(MATCH),COMPL(ONBT))                    064070
        RETURN                                                          064080
C                                                                       064090
C CEV5--        CANDLE.  DESCRIBE GROWING DIMNESS.                      064100
C                                                                       064110
5000    CALL LITINT(CANDL,CEVCND,CNDTCK,10)                             064120
        RETURN                                                          064130
C CEVAPP, PAGE 3                                                        064140
C                                                                       064150
C CEV6--        BALLOON                                                 064160
C                                                                       064170
6000    CTICK(CEVBAL)=3                                                 064180
        F=AVEHIC(WINNER).EQ.BALLO                                       064190
        IF(BLOC.EQ.VLBOT) GO TO 6800                                    064200
        IF(QLEDGE(BLOC)) GO TO 6700                                     064210
        IF(QOPEN(RECEP).AND.(BINFF.NE.0))                               064220
     1       GO TO 6500                                                 064230
C                                                                       064240
C BALLOON IS IN MIDAIR AND IS DEFLATED (OR HAS RECEPTACLE CLOSED).      064250
C FALL TO NEXT ROOM.                                                    064260
C                                                                       064270
        IF(BLOC.NE.VAIR1) GO TO 6300                                    064280
        BLOC=VLBOT                                                      064290
        CALL NEWSTA(BALLO,0,BLOC,0,0)                                   064300
        IF(F) GO TO 6200                                                064310
        IF(QLEDGE(HERE)) CALL RSPEAK(530)                               064320
        RETURN                                                          064330
C                                                                       064340
6200    F=MOVETO(BLOC)                                                  064350
        IF(BINFF.EQ.0) GO TO 6250                                       064360
        CALL RSPEAK(531)                                                064370
        F=RMINFO(.FALSE.)                                               064380
        RETURN                                                          064390
C                                                                       064400
6250    CALL NEWSTA(BALLO,532,0,0,0)                                    064410
        CALL NEWSTA(DBALL,0,BLOC,0,0)                                   064420
        AVEHIC(WINNER)=0                                                064430
        CFLAG(CEVBAL)=.FALSE.                                           064440
        CFLAG(CEVBRN)=.FALSE.                                           064450
        BINFF=0                                                         064460
        BTIEF=0                                                         064470
        RETURN                                                          064480
C                                                                       064490
6300    BLOC=BLOC-1                                                     064500
        CALL NEWSTA(BALLO,0,BLOC,0,0)                                   064510
        IF(F) GO TO 6400                                                064520
        IF(QLEDGE(HERE)) CALL RSPEAK(533)                               064530
        RETURN                                                          064540
C                                                                       064550
6400    F=MOVETO(BLOC)                                                  064560
        CALL RSPEAK(534)                                                064570
        F=RMINFO(.FALSE.)                                               064580
        RETURN                                                          064590
C                                                                       064600
C BALLOON IS IN MIDAIR AND IS INFLATED, UP-UP-AND-AWAY                  064610
C                                                                       064620
6500    IF(BLOC.NE.VAIR4) GO TO 6600                                    064630
        CTICK(CEVBRN)=0                                                 064640
        CTICK(CEVBAL)=0                                                 064650
        BINFF=0                                                         064660
        BTIEF=0                                                         064670
        BLOC=VLBOT                                                      064680
        CALL NEWSTA(BALLO,0,0,0,0)                                      064690
        CALL NEWSTA(DBALL,0,BLOC,0,0)                                   064700
        IF(F) GO TO 6550                                                064710
        IF(QLEDGE(HERE)) CALL RSPEAK(535)                               064720
        RETURN                                                          064730
C                                                                       064740
6550    CALL JIGSUP(536)                                                064750
        RETURN                                                          064760
C                                                                       064770
6600    BLOC=BLOC+1                                                     064780
        CALL NEWSTA(BALLO,0,BLOC,0,0)                                   064790
        IF(F) GO TO 6650                                                064800
        IF(QLEDGE(HERE)) CALL RSPEAK(537)                               064810
        RETURN                                                          064820
C                                                                       064830
6650    F=MOVETO(BLOC)                                                  064840
        CALL RSPEAK(538)                                                064850
        F=RMINFO(.FALSE.)                                               064860
        RETURN                                                          064870
C                                                                       064880
C ON LEDGE, GOES TO MIDAIR ROOM WHETHER INFLATED OR NOT.                064890
C                                                                       064900
6700    BLOC=BLOC+(VAIR2-LEDG2)                                         064910
        CALL NEWSTA(BALLO,0,BLOC,0,0)                                   064920
        IF(F) GO TO 6750                                                064930
        IF(QLEDGE(HERE)) CALL RSPEAK(539)                               064940
        CTICK(CEVVLG)=10                                                064950
        RETURN                                                          064960
C                                                                       064970
6750    F=MOVETO(BLOC)                                                  064980
        CALL RSPEAK(540)                                                064990
        F=RMINFO(.FALSE.)                                               065000
        RETURN                                                          065010
C                                                                       065020
C AT BOTTOM, GO UP IF INFLATED, DO NOTHING IF DEFLATED.                 065030
C                                                                       065040
6800    IF((BINFF.EQ.0).OR..NOT.QOPEN(RECEP)) RETURN                    065050
        BLOC=VAIR1                                                      065060
        CALL NEWSTA(BALLO,0,BLOC,0,0)                                   065070
        IF(F) GO TO 6850                                                065080
        IF(QLEDGE(HERE)) CALL RSPEAK(541)                               065090
        RETURN                                                          065100
C                                                                       065110
6850    F=MOVETO(BLOC)                                                  065120
        CALL RSPEAK(542)                                                065130
        F=RMINFO(.FALSE.)                                               065140
        RETURN                                                          065150
C CEVAPP, PAGE 4                                                        065160
C                                                                       065170
C CEV7--        BALLOON BURNUP                                          065180
C                                                                       065190
7000    DO 7100 I=1,OLNT                                                065200
          IF((RECEP.EQ.OCAN(I)).AND.(AND(OFLAG1(I),FLAMBT).NE.0))       065210
     1       GO TO 7200                                                 065220
7100    CONTINUE                                                        065230
C        CALL BUG(4,0)                                                  065240
C                                                                       065250
7200    CALL NEWSTA(I,0,0,0,0)                                          065260
        BINFF=0                                                         065270
        IF(HERE.EQ.BLOC) CALL RSPSUB(292,ODESC2(I))                     065280
        RETURN                                                          065290
C                                                                       065300
C CEV8--        FUSE FUNCTION                                           065310
C                                                                       065320
8000    IF(OCAN(FUSE).NE.BRICK) GO TO 8500                              065330
        BR=OROOM(BRICK)                                                 065340
        BC=OCAN(BRICK)                                                  065350
        IF((BR.EQ.0).AND.(BC.NE.0)) BR=OROOM(BC)                        065360
        CALL NEWSTA(FUSE,0,0,0,0)                                       065370
        CALL NEWSTA(BRICK,0,0,0,0)                                      065380
        IF((BR.NE.0).AND.(BR.NE.HERE)) GO TO 8100                       065390
C                                                                       065400
        RFLAG(HERE)=OR(RFLAG(HERE),RMUNG)                               065410
        RRAND(HERE)=114                                                 065420
        CALL JIGSUP(150)                                                065430
        RETURN                                                          065440
C                                                                       065450
8100    CALL RSPEAK(151)                                                065460
        MUNGRM=BR                                                       065470
        CTICK(CEVSAF)=5                                                 065480
        IF(BR.NE.MSAFE) GO TO 8200                                      065490
        IF(BC.NE.SSLOT) RETURN                                          065500
        CALL NEWSTA(SSLOT,0,0,0,0)                                      065510
        OFLAG2(SAFE)=OR(OFLAG2(SAFE),OPENBT)                            065520
        SAFEF=.TRUE.                                                    065530
        RETURN                                                          065540
C                                                                       065550
8200    DO 8250 I=1,OLNT                                                065560
          IF(QHERE(I,BR) .AND. (AND(OFLAG1(I),TAKEBT).NE.0))            065570
     1       CALL NEWSTA(I,0,0,0,0)                                     065580
8250    CONTINUE                                                        065590
        IF(BR.NE.LROOM) RETURN                                          065600
        DO 8300 I=1,OLNT                                                065610
          IF(OCAN(I).EQ.TCASE) CALL NEWSTA(I,0,0,0,0)                   065620
8300    CONTINUE                                                        065630
        RETURN                                                          065640
C                                                                       065650
8500    IF(QHERE(FUSE,HERE).OR.(OADV(FUSE).EQ.WINNER))                  065660
     1       CALL RSPEAK(152)                                           065670
        CALL NEWSTA(FUSE,0,0,0,0)                                       065680
        RETURN                                                          065690
C CEVAPP, PAGE 5                                                        065700
C                                                                       065710
C CEV9--        LEDGE MUNGE.                                            065720
C                                                                       065730
9000    RFLAG(LEDG4)=OR(RFLAG(LEDG4),RMUNG)                             065740
        RRAND(LEDG4)=109                                                065750
        IF(HERE.EQ.LEDG4) GO TO 9100                                    065760
        CALL RSPEAK(110)                                                065770
        RETURN                                                          065780
C                                                                       065790
9100    IF(AVEHIC(WINNER).NE.0) GO TO 9200                              065800
        CALL JIGSUP(111)                                                065810
        RETURN                                                          065820
C                                                                       065830
9200    IF(BTIEF.NE.0) GO TO 9300                                       065840
        CALL RSPEAK(112)                                                065850
        RETURN                                                          065860
C                                                                       065870
9300    BLOC=VLBOT                                                      065880
        CALL NEWSTA(BALLO,0,0,0,0)                                      065890
        CALL NEWSTA(DBALL,0,BLOC,0,0)                                   065900
        BTIEF=0                                                         065910
        BINFF=0                                                         065920
        CFLAG(CEVBAL)=.FALSE.                                           065930
        CFLAG(CEVBRN)=.FALSE.                                           065940
        CALL JIGSUP(113)                                                065950
        RETURN                                                          065960
C                                                                       065970
C CEV10--       SAFE MUNG.                                              065980
C                                                                       065990
10000   RFLAG(MUNGRM)=OR(RFLAG(MUNGRM),RMUNG)                           066000
        RRAND(MUNGRM)=114                                               066010
        IF(HERE.EQ.MUNGRM) GO TO 10100                                  066020
        CALL RSPEAK(115)                                                066030
        IF(MUNGRM.EQ.MSAFE) CTICK(CEVLED)=8                             066040
        RETURN                                                          066050
C                                                                       066060
10100   I=116                                                           066070
        IF(AND(RFLAG(HERE),RHOUSE).NE.0) I=117                          066080
        CALL JIGSUP(I)                                                  066090
        RETURN                                                          066100
C CEVAPP, PAGE 6                                                        066110
C                                                                       066120
C CEV11--       VOLCANO GNOME                                           066130
C                                                                       066140
11000   IF(QLEDGE(HERE)) GO TO 11100                                    066150
        CTICK(CEVVLG)=1                                                 066160
        RETURN                                                          066170
C                                                                       066180
11100   CALL NEWSTA(GNOME,118,HERE,0,0)                                 066190
        RETURN                                                          066200
C                                                                       066210
C CEV12--       VOLCANO GNOME DISAPPEARS                                066220
C                                                                       066230
12000   CALL NEWSTA(GNOME,149,0,0,0)                                    066240
        RETURN                                                          066250
C                                                                       066260
C CEV13--       BUCKET.                                                 066270
C                                                                       066280
13000   IF(OCAN(WATER).EQ.BUCKE)                                        066290
     1       CALL NEWSTA(WATER,0,0,0,0)                                 066300
        RETURN                                                          066310
C                                                                       066320
C CEV14--       SPHERE.  IF EXPIRES, HE"S TRAPPED.                      066330
C                                                                       066340
14000   RFLAG(CAGER)=OR(RFLAG(CAGER),RMUNG)                             066350
        RRAND(CAGER)=147                                                066360
        CALL JIGSUP(148)                                                066370
        RETURN                                                          066380
C                                                                       066390
C CEV15--       END GAME HERALD.                                        066400
C                                                                       066410
15000   ENDGMF=.TRUE.                                                   066420
        CALL RSPEAK(119)                                                066430
        RETURN                                                          066450
C
C     CEV16 -- DARK KANGAROO.
C     MOVE KANG TO EAST SIDE OF HOUSE.
C
16000 CONTINUE
      CALL NEWSTA(148,0,5,0,0)
      CTICK(16) = 5
      RETURN
C
C     CEV17 -- LIGHT KANGAROO.
C     MOVE KANG TO EAST SIDE OF HOUSE.
C
17000 CONTINUE
      CALL NEWSTA(149,0,5,0,0)
      CTICK(17) = 5
      RETURN
C                                                                       066460
        END                                                             066470
        SUBROUTINE LITINT(OBJ,CEV,TICKS,TICKLN)
        IMPLICIT INTEGER (A-Z)                                          066490
C LITINT-      LIGHT INTERRUPT PROCESSOR                                066500
C                                                                       066510
C DECLARATIONS                                                          066520
C                                                                       066530
        INTEGER TICKS(TICKLN)                                           066540
C                                                                       066550
C GAME STATE                                                            066560
C                                                                       066570
        LOGICAL TELFLG                                                  066580
        COMMON /PLAY/ WINNER,HERE,TELFLG                                066590
C                                                                       066600
C OBJECTS                                                               066610
C                                                                       066620
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       066630
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            066640
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              066650
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  066660
C                                                                       066670
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      066680
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          066690
     2       TOOLBT,TURNBT,ONBT                                         066700
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       066710
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           066720
     2       TCHBT,VEHBT,SCHBT                                          066730
C                                                                       066740
C                                                                       066750
C CLOCK INTERRUPTS                                                      066760
C                                                                       066770
        LOGICAL CFLAG                                                   066780
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             066790
C                                                                       066800
        ORAND(OBJ)=ORAND(OBJ)+1                                         066810
        CTICK(CEV)=TICKS(ORAND(OBJ))                                    066820
        IF(CTICK(CEV).NE.0) GO TO 100                                   066830
        OFLAG1(OBJ)=AND(OFLAG1(OBJ),COMPL(LITEBT+FLAMBT+ONBT))          066840
        IF((OROOM(OBJ).EQ.HERE).OR.(OADV(OBJ).EQ.WINNER))               066850
     1       CALL RSPSUB(293,ODESC2(OBJ))                               066860
        RETURN                                                          066870
C                                                                       066880
100     IF((OROOM(OBJ).EQ.HERE).OR.(OADV(OBJ).EQ.WINNER))               066890
     1       CALL RSPEAK(TICKS(ORAND(OBJ)+(TICKLN/2)))                  066900
        RETURN                                                          066910
C                                                                       066920
        END
        SUBROUTINE FIGHTD
        IMPLICIT INTEGER (A-Z)                                          066950
C FIGHTD- INTERMOVE FIGHT DEMON                                         066960
C                                                                       066970
C DECLARATIONS                                                          066980
C                                                                       066990
        LOGICAL PROB,OAPPLI,F                                           067000
C                                                                       067010
C PARSER OUTPUT                                                         067020
C                                                                       067030
        LOGICAL PRSWON                                                  067040
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    067050
C                                                                       067060
C GAME STATE                                                            067070
C                                                                       067080
        LOGICAL TELFLG                                                  067090
        COMMON /PLAY/ WINNER,HERE,TELFLG                                067100
C                                                                       067110
C OBJECTS                                                               067120
C                                                                       067130
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       067140
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            067150
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              067160
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  067170
C                                                                       067180
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      067190
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          067200
     2       TOOLBT,TURNBT,ONBT                                         067210
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       067220
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           067230
     2       TCHBT,VEHBT,SCHBT                                          067240
C                                                                       067250
C VILLAINS AND DEMONS                                                   067260
C                                                                       067270
        COMMON /VILL/ VLNT,VILLNS(5),VPROB(5),VOPPS(5)                  067280
C                                                                       067290
C ADVENTURERS                                                           067300
C                                                                       067310
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                067320
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       067330
C                                                                       067340
        COMMON /AFLAGS/ ASTAG                                           067350
C                                                                       067360
        COMMON /AINDEX/ PLAYER,AROBOT                                   067370
C                                                                       067380
C VERBS                                                                 067390
C                                                                       067400
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  067410
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              067420
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         067430
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            067440
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           067450
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  067460
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    067470
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            067480
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       067490
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       067500
        COMMON /VINDEX/ DIGW,LEAPW                                      067510
                                                                        067520
        DATA ROUT/1/                                                    067530
        PROB(R)=(RND(100).LT.R)
C FIGHTD, PAGE 2                                                        067550
C                                                                       067560
        DO 2400 I=1,VLNT                                                067570
          VOPPS(I)=0                                                    067580
          OBJ=VILLNS(I)                                                 067590
          RA=OACTIO(OBJ)                                                067600
          IF(HERE.NE.OROOM(OBJ)) GO TO 2200                             067610
          IF(OCAPAC(OBJ).GE.0) GO TO 2050                               067620
          IF((VPROB(I).EQ.0).OR..NOT.PROB(VPROB(I)))                    067630
     1       GO TO 2025                                                 067640
          OCAPAC(OBJ)=IABS(OCAPAC(OBJ))                                 067650
          VPROB(I)=0                                                    067660
          IF(RA.EQ.0) GO TO 2400                                        067670
          PRSA=INXW                                                     067680
          F=OAPPLI(RA,0)                                                067690
          GO TO 2400                                                    067700
C                                                                       067710
2025      VPROB(I)=VPROB(I)+10                                          067720
          GO TO 2400                                                    067730
C                                                                       067740
2050      IF(AND(OFLAG2(OBJ),FITEBT).EQ.0) GO TO 2100                   067750
          VOPPS(I)=OBJ                                                  067760
          GO TO 2400                                                    067770
C                                                                       067780
2100      IF(RA.EQ.0) GO TO 2400                                        067790
          PRSA=FRSTQW                                                   067800
          IF(.NOT.OAPPLI(RA,0)) GO TO 2400                              067810
          OFLAG2(OBJ)=OR(OFLAG2(OBJ),FITEBT)                            067820
          VOPPS(I)=OBJ                                                  067830
          GO TO 2400                                                    067840
C                                                                       067850
2200      IF((AND(OFLAG2(OBJ),FITEBT).EQ.0).OR.(RA.EQ.0))               067860
     1       GO TO 2300                                                 067870
          PRSA=FIGHTW                                                   067880
          F=OAPPLI(RA,0)                                                067890
2300      AFLAG(PLAYER)=AND(AFLAG(PLAYER),COMPL(ASTAG))                 067900
          OFLAG2(OBJ)=AND(OFLAG2(OBJ),COMPL(STAGBT+FITEBT))             067910
          IF((OCAPAC(OBJ).GE.0).OR.(RA.EQ.0))                           067920
     1       GO TO 2400                                                 067930
          PRSA=INXW                                                     067940
          F=OAPPLI(RA,0)                                                067950
          OCAPAC(OBJ)=IABS(OCAPAC(OBJ))                                 067960
2400    CONTINUE                                                        067970
C FIGHTD, PAGE 3                                                        067980
C                                                                       067990
C NOW DO ACTUAL COUNTERBLOWS.                                           068000
C                                                                       068010
        OUT=0                                                           068020
2600    DO 2700 I=1,VLNT                                                068030
          J=VOPPS(I)                                                    068040
          IF(J.EQ.0) GO TO 2700                                         068050
          RA=OACTIO(J)                                                  068060
          IF(RA.EQ.0) GO TO 2650                                        068070
          PRSA=FIGHTW                                                   068080
          IF(OAPPLI(RA,0)) GO TO 2700                                   068090
2650      RES=BLOW(PLAYER,J,ORAND(J),.FALSE.,OUT)                       068100
          IF(RES.LT.0) RETURN                                           068110
          IF(RES.EQ.ROUT) OUT=2+RND(3)                                  068120
2700    CONTINUE                                                        068130
        OUT=OUT-1                                                       068140
        IF(OUT.GT.0) GO TO 2600                                         068150
        RETURN                                                          068160
C                                                                       068170
        END
        INTEGER FUNCTION BLOW(H,V,RMK,HFLG,OUT)
        IMPLICIT INTEGER (A-Z)                                          068200
C BLOW- STRIKE BLOW                                                     068210
C                                                                       068220
C DECLARATIONS                                                          068230
C                                                                       068240
        LOGICAL HFLG,OAPPLI,F                                           068250
        INTEGER DEF1R(3),DEF2R(4),DEF3R(5)                              068260
        INTEGER RVECTR(66),RSTATE(45)                                   068270
C BLOW, PAGE 2                                                          068280
C                                                                       068290
C GAME STATE                                                            068300
C                                                                       068310
        LOGICAL TELFLG                                                  068320
        COMMON /PLAY/ WINNER,HERE,TELFLG                                068330
C                                                                       068340
C PARSE VECTOR                                                          068350
C                                                                       068360
        LOGICAL PRSWON                                                  068370
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    068380
C                                                                       068390
C MISCELLANEOUS VARIABLES                                               068400
C                                                                       068410
        COMMON /STAR/ MBASE,STRBIT                                      068420
C                                                                       068430
C OBJECTS                                                               068440
C                                                                       068450
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       068460
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            068470
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              068480
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  068490
C                                                                       068500
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      068510
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          068520
     2       TOOLBT,TURNBT,ONBT                                         068530
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       068540
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           068550
     2       TCHBT,VEHBT,SCHBT                                          068560
C                                                                       068570
C                                                                       068580
C CLOCK INTERRUPTS                                                      068590
C                                                                       068600
        LOGICAL CFLAG                                                   068610
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             068620
C                                                                       068630
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             068640
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 068650
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                068660
C                                                                       068670
C ADVENTURERS                                                           068680
C                                                                       068690
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                068700
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       068710
C                                                                       068720
        COMMON /AFLAGS/ ASTAG                                           068730
C                                                                       068740
        COMMON /AINDEX/ PLAYER,AROBOT                                   068750
C                                                                       068760
C VERBS                                                                 068770
C                                                                       068780
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  068790
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              068800
C                                                                       068810
        DATA RMISS/0/,ROUT/1/,RKILL/2/,RLIGHT/3/                        068820
        DATA RSER/4/,RSTAG/5/,RLOSE/6/,RHES/7/,RSIT/8/                  068830
        DATA DEF1R/1,2,3/                                               068840
        DATA DEF2R/13,23,24,25/                                         068850
        DATA DEF3R/35,36,46,47,57/                                      068860
C                                                                       068870
        DATA RVECTR/0,0,0,0,5,5,1,1,2,2,2,2,                            068880
     1       0,0,0,0,0,5,5,3,3,1,                                       068890
     2       0,0,0,5,5,3,3,3,1,2,2,2,                                   068900
     3       0,0,0,0,0,5,5,3,3,4,4,                                     068910
     4       0,0,0,5,5,3,3,3,4,4,4,                                     068920
     5       0,5,5,3,3,3,3,4,4,4/                                       068930
        DATA RSTATE/5000,3005,3008,4011,3015,3018,1021,0,0,             068940
     1       5022,3027,3030,4033,3037,3040,1043,0,0,                    068950
     2       4044,2048,4050,4054,5058,4063,4067,3071,1074,              068960
     3       4075,1079,4080,4084,4088,4092,4096,4100,1104,              068970
     4       4105,2109,4111,4115,4119,4123,4127,3131,3134/              068980
C BLOW, PAGE 3                                                          068990
C                                                                       069000
        RA=OACTIO(V)                                                    069010
        DV=ODESC2(V)                                                    069020
        BLOW=RMISS                                                      069030
C       PRINT 10,H,V,RMK,HFLG,OUT                                       069040
C10     FORMAT(" BLOW 10-- ",3I7,L7,I7)                                 069050
        IF(.NOT.HFLG) GO TO 1000                                        069060
C                                                                       069070
C HERO IS ATTACKER, VILLAIN IS DEFENDER.                                069080
C                                                                       069090
        OFLAG2(V)=OR(OFLAG2(V),FITEBT)                                  069100
        IF(AND(AFLAG(H),ASTAG).EQ.0) GO TO 100                          069110
        CALL RSPEAK(591)                                                069120
        AFLAG(H)=AND(AFLAG(H),COMPL(ASTAG))                             069130
        RETURN                                                          069140
C                                                                       069150
100     ATT=FIGHTS(H,.TRUE.)                                            069160
        OA=ATT                                                          069170
        DEF=OCAPAC(V)                                                   069180
        OD=DEF                                                          069190
        DWEAP=0                                                         069200
        DO 200 I=1,OLNT                                                 069210
          IF((OCAN(I).EQ.V).AND.(AND(OFLAG2(I),WEAPBT).NE.0))           069220
     1       DWEAP=I                                                    069230
200     CONTINUE                                                        069240
        IF(V.EQ.AOBJ(PLAYER)) GO TO 300                                 069250
        IF(DEF.NE.0) GO TO 2000                                         069260
        CALL RSPSUB(592,DV)                                             069270
        RETURN                                                          069280
C                                                                       069290
300     CALL JIGSUP(593)                                                069300
        RETURN                                                          069310
C                                                                       069320
C VILLAIN IS ATTACKER, HERO IS DEFENDER.                                069330
C                                                                       069340
1000    AFLAG(H)=AND(AFLAG(H),COMPL(ASTAG))                             069350
        IF(AND(OFLAG2(V),STAGBT).EQ.0) GO TO 1200                       069360
        OFLAG2(V)=AND(OFLAG2(V),COMPL(STAGBT))                          069370
        CALL RSPSUB(594,DV)                                             069380
        RETURN                                                          069390
C                                                                       069400
1200    ATT=OCAPAC(V)                                                   069410
        OA=ATT                                                          069420
        DEF=FIGHTS(H,.TRUE.)                                            069430
        IF(DEF.LE.0) RETURN                                             069440
        OD=FIGHTS(H,.FALSE.)                                            069450
        DWEAP=IABS(FWIM(0,WEAPBT,0,0,H,.TRUE.))                         069460
C BLOW, PAGE 4                                                          069470
C                                                                       069480
C PARTIES ARE NOW EQUIPPED.  DEF CANNOT BE ZERO.                        069490
C ATT MUST BE > 0.                                                      069500
C                                                                       069510
2000    CONTINUE                                                        069520
C       PRINT 2050,ATT,OA,DEF,OD,DWEAP                                  069530
C2050   FORMAT(" BLOW 2050-- ",5I7)                                     069540
        IF(DEF.GT.0) GO TO 2100                                         069550
        RES=RKILL                                                       069560
        IF(HFLG) CALL RSPSUB(595,DV)                                    069570
        GO TO 3000                                                      069580
C                                                                       069590
2100    IF(DEF-2) 2200,2300,2400                                        069600
2200    ATT=MIN0(ATT,3)                                                 069610
        TBL=DEF1R(ATT)                                                  069620
        GO TO 2500                                                      069630
C                                                                       069640
2300    ATT=MIN0(ATT,4)                                                 069650
        TBL=DEF2R(ATT)                                                  069660
        GO TO 2500                                                      069670
C                                                                       069680
2400    ATT=ATT-DEF                                                     069690
        ATT=MIN0(2,MAX0(-2,ATT))+3                                      069700
        TBL=DEF3R(ATT)                                                  069710
C                                                                       069720
2500    RES=RVECTR(TBL+RND(10))                                         069730
        IF(OUT.EQ.0) GO TO 2600                                         069740
        IF(RES.EQ.RSTAG) GO TO 2550                                     069750
        RES=RSIT                                                        069760
        GO TO 2600                                                      069770
2550    RES=RHES                                                        069780
2600    IF((RES.EQ.RSTAG).AND.(DWEAP.NE.0).AND.(RND(100).LT.25))        069790
     1       RES=RLOSE                                                  069800
C                                                                       069810
        MI=RSTATE(((RMK-1)*9)+RES+1)                                    069820
        IF(MI.EQ.0) GO TO 3000                                          069830
        I=(MOD(MI,1000)+RND(MI/1000))+MBASE+1                           069840
        J=DV                                                            069850
        IF(.NOT.HFLG .AND.(DWEAP.NE.0)) J=ODESC2(DWEAP)                 069860
C       PRINT 2650,RES,MI,I,J,MBASE                                     069870
C2650   FORMAT(" BLOW 2650-- ",5I7)                                     069880
        CALL RSPSUB(I,J)                                                069890
C BLOW, PAGE 5                                                          069900
C                                                                       069910
C NOW APPLY RESULT                                                      069920
C                                                                       069930
3000    GO TO (4000,3100,3200,3300,3400,3500,3600,4000,3200),RES+1
      CALL GOTOER
C                                                                       069950
3100    IF(HFLG) DEF=-DEF                                               069960
        GO TO 4000                                                      069970
C                                                                       069980
3200    DEF=0                                                           069990
        GO TO 4000                                                      070000
C                                                                       070010
3300    DEF=MAX0(0,DEF-1)                                               070020
        GO TO 4000                                                      070030
C                                                                       070040
3400    DEF=MAX0(0,DEF-2)                                               070050
        GO TO 4000                                                      070060
C                                                                       070070
3500    IF(HFLG) GO TO 3550                                             070080
        AFLAG(H)=OR(AFLAG(H),ASTAG)                                     070090
        GO TO 4000                                                      070100
C                                                                       070110
3550    OFLAG2(V)=OR(OFLAG2(V),STAGBT)                                  070120
        GO TO 4000                                                      070130
C                                                                       070140
3600    CALL NEWSTA(DWEAP,0,HERE,0,0)                                   070150
        DWEAP=0                                                         070160
        IF(HFLG) GO TO 4000                                             070170
        DWEAP=IABS(FWIM(0,WEAPBT,0,0,H,.TRUE.))                         070180
        IF(DWEAP.NE.0) CALL RSPSUB(605,ODESC2(DWEAP))                   070190
C BLOW, PAGE 6                                                          070200
C                                                                       070210
4000    BLOW=RES                                                        070220
        IF(.NOT.HFLG) GO TO 4500                                        070230
        OCAPAC(V)=DEF                                                   070240
        IF(DEF.NE.0) GO TO 4100                                         070250
        OFLAG2(V)=AND(OFLAG2(V),COMPL(FITEBT))                          070260
        CALL RSPSUB(572,DV)                                             070270
        CALL NEWSTA(V,0,0,0,0)                                          070280
        IF(RA.EQ.0) RETURN                                              070290
        PRSA=DEADXW                                                     070300
        F=OAPPLI(RA,0)                                                  070310
        RETURN                                                          070320
C                                                                       070330
4100    IF((RES.NE.ROUT).OR.(RA.EQ.0)) RETURN                           070340
        PRSA=OUTXW                                                      070350
        F=OAPPLI(RA,0)                                                  070360
        RETURN                                                          070370
C                                                                       070380
4500    ASTREN(H)=-10000                                                070390
        IF(DEF.NE.0) ASTREN(H)=DEF-OD                                   070400
        IF(DEF.GE.OD) GO TO 4600                                        070410
        CTICK(CEVCUR)=30                                                070420
        CFLAG(CEVCUR)=.TRUE.                                            070430
4600    IF(FIGHTS(H,.TRUE.).GT.0) RETURN                                070440
        ASTREN(H)=1-FIGHTS(H,.FALSE.)                                   070450
        CALL JIGSUP(596)                                                070460
        BLOW=-1                                                         070470
        RETURN                                                          070480
C                                                                       070490
        END                                                             070500
        SUBROUTINE SWORDD
        IMPLICIT INTEGER(A-Z)                                           070520
C SWORDD- SWORD INTERMOVE DEMON                                         070530
C                                                                       070540
C DECLARATIONS                                                          070550
C                                                                       070560
        LOGICAL INFEST,FINDXT                                           070570
C                                                                       070580
C GAME STATE                                                            070590
C                                                                       070600
        LOGICAL TELFLG                                                  070610
        COMMON /PLAY/ WINNER,HERE,TELFLG                                070620
C                                                                       070630
C EXITS                                                                 070640
C                                                                       070650
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ                  070660
        EQUIVALENCE (XFLAG,XOBJ)                                        070670
C                                                                       070680
        COMMON /XSRCH/ XMIN,XMAX,XDOWN                                  070690
C                                                                       070700
C OBJECTS                                                               070710
C                                                                       070720
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       070730
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            070740
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              070750
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  070760
C                                                                       070770
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    070780
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           070790
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 070800
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              070810
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   070820
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     070830
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        070840
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    070850
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          070860
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                070870
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              070880
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         070890
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               070900
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    070910
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  070920
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   070930
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       070950
C VILLAINS AND DEMONS                                                   070960
C                                                                       070970
        LOGICAL THFFLG,SWDACT,THFACT                                    070980
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA                070990
C                                                                       071000
C ADVENTURERS                                                           071010
C                                                                       071020
        COMMON /AINDEX/ PLAYER,AROBOT                                   071030
        INFEST(R)=(OROOM(CYCLO).EQ.R).OR.(OROOM(TROLL).EQ.R)
     1       .OR.((OROOM(THIEF).EQ.R).AND.THFACT)
C SWORDD, PAGE 2                                                        071060
C                                                                       071070
        IF(OADV(SWORD).NE.PLAYER) GO TO 500                             071080
        NG=2                                                            071090
        IF(INFEST(HERE)) GO TO 300                                      071100
        NG=1                                                            071110
        DO 200 I=XMIN,XMAX,XMIN                                         071120
          IF(.NOT.FINDXT(I,HERE)) GO TO 200                             071130
          GO TO (50,200,50,50),XTYPE
      CALL GOTOER
50        IF(INFEST(XROOM1)) GO TO 300                                  071150
200     CONTINUE                                                        071160
        NG=0                                                            071170
C                                                                       071180
300     IF(NG.EQ.SWDSTA) RETURN                                         071190
        CALL RSPEAK(NG+495)                                             071200
        SWDSTA=NG                                                       071210
        RETURN                                                          071220
C                                                                       071230
500     SWDACT=.FALSE.                                                  071240
        RETURN                                                          071250
        END                                                             071260
        LOGICAL FUNCTION TAKE(FLG)
        IMPLICIT INTEGER (A-Z)                                          071280
C TAKE-- BASIC TAKE SEQUENCE                                            071290
C                                                                       071300
C TAKE AN OBJECT (FOR VERBS TAKE, PUT, DROP, READ, ETC.)                071310
C                                                                       071320
C                                                                       071330
C DECLARATIONS                                                          071340
C                                                                       071350
        LOGICAL FLG,OBJACT,OAPPLI,QOPEN,QHERE                           071360
C                                                                       071370
C PARSER OUTPUT                                                         071380
C                                                                       071390
        LOGICAL PRSWON                                                  071400
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    071410
C                                                                       071420
C GAME STATE                                                            071430
C                                                                       071440
        LOGICAL TELFLG                                                  071450
        COMMON /PLAY/ WINNER,HERE,TELFLG                                071460
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               071470
     1       LTSHFT,BLOC,MUNGRM,HS                                      071480
        COMMON /STAR/ MBASE,STRBIT                                      071490
C                                                                       071500
C OBJECTS                                                               071510
C                                                                       071520
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       071530
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            071540
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              071550
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  071560
C                                                                       071570
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      071580
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          071590
     2       TOOLBT,TURNBT,ONBT                                         071600
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       071610
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           071620
     2       TCHBT,VEHBT,SCHBT                                          071630
C                                                                       071640
C                                                                       071650
C ADVENTURERS                                                           071660
C                                                                       071670
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                071680
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       071690
C                                                                       071700
        COMMON /AINDEX/ PLAYER,AROBOT                                   071710
                                                                        071720
        QOPEN(O)=AND(OFLAG2(O),OPENBT).NE.0
C TAKE, PAGE 2                                                          071740
C                                                                       071750
        TAKE=.FALSE.                                                    071760
        OA=OACTIO(PRSO)                                                 071770
        IF(PRSO.LE.STRBIT) GO TO 100                                    071780
        TAKE=OBJACT(X)                                                  071790
        RETURN                                                          071800
C                                                                       071810
100     X=OCAN(PRSO)                                                    071820
        IF(X.EQ.0) GO TO 300                                            071830
        IF((AND(OFLAG1(X),VISIBT).NE.0) .AND. (QOPEN(X).OR.             071840
     1       (AND(OFLAG1(X),TRANBT).NE.0))) GO TO 200                   071850
        CALL RSPEAK(552)                                                071860
        RETURN                                                          071870
C                                                                       071880
200     IF(QOPEN(X)) GO TO 300                                          071890
        CALL RSPEAK(526)                                                071900
        RETURN                                                          071910
C                                                                       071920
300     IF(PRSO.NE.AVEHIC(WINNER)) GO TO 400                            071930
        CALL RSPEAK(553)                                                071940
        RETURN                                                          071950
C                                                                       071960
400     IF(AND(OFLAG1(PRSO),TAKEBT).NE.0) GO TO 500                     071970
        IF(OA.EQ.0) GO TO 450                                           071980
        IF(OAPPLI(OA,0)) RETURN                                         071990
450     CALL RSPEAK(554+RND(3))                                         072000
        RETURN                                                          072010
C                                                                       072020
C OBJECT IS TAKEABLE AND IN POSITION TO BE TAKEN.                       072030
C                                                                       072040
500     IF((X.NE.0).OR. QHERE(PRSO,HERE)) GO TO 600                     072050
        IF(OADV(PRSO).EQ.WINNER) CALL RSPEAK(557)                       072060
        RETURN                                                          072070
C                                                                       072080
600     MXLOAD=MXLOAD                                                   072090
        IF(((X.NE.0).AND.(OADV(X).EQ.WINNER)).OR.                       072100
     1       ((WEIGHT(0,PRSO,WINNER)+OSIZE(PRSO)).LE.MXLOAD))           072110
     2       GO TO 700                                                  072120
        CALL RSPEAK(558)                                                072130
        RETURN                                                          072140
C                                                                       072150
700     TAKE=.TRUE.                                                     072160
        IF(OA.EQ.0) GO TO 800                                           072170
        IF(OAPPLI(OA,0)) RETURN                                         072180
800     CALL NEWSTA(PRSO,0,0,0,WINNER)                                  072190
        OFLAG2(PRSO)=OR(OFLAG2(PRSO),TCHBT)                             072200
        CALL SCRUPD(OFVAL(PRSO))                                        072210
        OFVAL(PRSO)=0                                                   072220
        IF(FLG) CALL RSPEAK(559)                                        072230
        RETURN                                                          072240
C                                                                       072250
        END
        LOGICAL FUNCTION DROP(Z)
        IMPLICIT INTEGER (A-Z)                                          072280
C DROP- DROP VERB PROCESSOR                                             072290
C                                                                       072300
C DECLARATIONS                                                          072310
C                                                                       072320
        LOGICAL F,PUT,OBJACT,Z                                          072330
C                                                                       072340
C PARSER OUTPUT                                                         072350
C                                                                       072360
        LOGICAL PRSWON                                                  072370
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    072380
C                                                                       072390
C GAME STATE                                                            072400
C                                                                       072410
        LOGICAL TELFLG                                                  072420
        COMMON /PLAY/ WINNER,HERE,TELFLG                                072430
C                                                                       072440
C OBJECTS                                                               072450
C                                                                       072460
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       072470
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            072480
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              072490
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  072500
C                                                                       072510
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      072520
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          072530
     2       TOOLBT,TURNBT,ONBT                                         072540
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       072550
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           072560
     2       TCHBT,VEHBT,SCHBT                                          072570
C                                                                       072580
C                                                                       072590
C ADVENTURERS                                                           072600
C                                                                       072610
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                072620
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       072630
C                                                                       072640
C VERBS                                                                 072650
C                                                                       072660
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  072670
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              072680
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         072690
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            072700
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           072710
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  072720
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    072730
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            072740
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       072750
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       072760
        COMMON /VINDEX/ DIGW,LEAPW                                      072770
C DROP, PAGE 2                                                          072780
C                                                                       072790
        DROP=.TRUE.                                                     072800
        X=OCAN(PRSO)                                                    072810
        IF(X.EQ.0) GO TO 200                                            072820
        IF(OADV(X).NE.WINNER) GO TO 1000                                072830
        IF(AND(OFLAG2(X),OPENBT).NE.0) GO TO 300                        072840
        CALL RSPEAK(526)                                                072850
        RETURN                                                          072860
C                                                                       072870
200     IF(OADV(PRSO).NE.WINNER) GO TO 1000                             072880
300     IF(AVEHIC(WINNER).EQ.0) GO TO 400                               072890
        PRSI=AVEHIC(WINNER)                                             072900
        F=PUT(.FALSE.)                                                  072910
        GO TO 500                                                       072920
C                                                                       072930
400     CALL NEWSTA(PRSO,0,HERE,0,0)                                    072940
500     IF(OBJACT(X)) RETURN                                            072950
        I=0                                                             072960
        IF(PRSA.EQ.DROPW) I=528                                         072970
        IF(PRSA.EQ.THROWW) I=529                                        072980
        CALL RSPEAK(I)                                                  072990
        RETURN                                                          073000
C                                                                       073010
1000    CALL RSPEAK(527)                                                073020
        RETURN                                                          073030
C                                                                       073040
        END
        LOGICAL FUNCTION PUT(FLG)
        IMPLICIT INTEGER (A-Z)                                          073070
C PUT- PUT VERB PROCESSOR                                               073080
C                                                                       073090
C DECLARATIONS                                                          073100
C                                                                       073110
        LOGICAL QOPEN,QHERE,OBJACT,FLG,TAKE                             073120
C                                                                       073130
C PARSER OUTPUT                                                         073140
C                                                                       073150
        LOGICAL PRSWON                                                  073160
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    073170
C                                                                       073180
C GAME STATE                                                            073190
C                                                                       073200
        LOGICAL TELFLG                                                  073210
        COMMON /PLAY/ WINNER,HERE,TELFLG                                073220
C                                                                       073230
C MISCELLANEOUS VARIABLES                                               073240
C                                                                       073250
        COMMON /STAR/ MBASE,STRBIT                                      073260
C                                                                       073270
C OBJECTS                                                               073280
C                                                                       073290
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       073300
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            073310
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              073320
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  073330
C                                                                       073340
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      073350
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          073360
     2       TOOLBT,TURNBT,ONBT                                         073370
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       073380
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           073390
     2       TCHBT,VEHBT,SCHBT                                          073400
C                                                                       073410
C ADVENTURERS                                                           073420
C                                                                       073430
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                073440
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       073450
C                                                                       073460
C VERBS                                                                 073470
C                                                                       073480
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  073490
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              073500
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         073510
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            073520
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           073530
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  073540
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    073550
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            073560
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       073570
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       073580
        COMMON /VINDEX/ DIGW,LEAPW                                      073590
        QOPEN(R)=AND(OFLAG2(R),OPENBT).NE.0
C PUT, PAGE 2                                                           073610
C                                                                       073620
        PUT=.FALSE.                                                     073630
        IF((PRSO.LE.STRBIT).AND.(PRSI.LE.STRBIT)) GO TO 200             073640
        IF(.NOT.OBJACT(X)) CALL RSPEAK(560)                             073650
        PUT=.TRUE.                                                      073660
        RETURN                                                          073670
C                                                                       073680
200     IF(QOPEN(PRSI).OR.(AND(OFLAG1(PRSI),(DOORBT+CONTBT)).NE.0)      073690
     1       .OR.(AND(OFLAG2(PRSI),VEHBT).NE.0)) GO TO 300              073700
        CALL RSPEAK(561)                                                073710
        RETURN                                                          073720
C                                                                       073730
300     IF(QOPEN(PRSI)) GO TO 400                                       073740
        CALL RSPEAK(562)                                                073750
        RETURN                                                          073760
C                                                                       073770
400     IF(PRSO.NE.PRSI) GO TO 500                                      073780
        CALL RSPEAK(563)                                                073790
        RETURN                                                          073800
C                                                                       073810
500     IF(OCAN(PRSO).NE.PRSI) GO TO 600                                073820
        CALL RSPSB2(564,ODESC2(PRSO),ODESC2(PRSI))                      073830
        PUT=.TRUE.                                                      073840
        RETURN                                                          073850
C                                                                       073860
600     IF((WEIGHT(0,PRSO,0)+WEIGHT(0,PRSI,0)+OSIZE(PRSO))              073870
     1       .LE.OCAPAC(PRSI)) GO TO 700                                073880
        CALL RSPEAK(565)                                                073890
        RETURN                                                          073900
C                                                                       073910
C NOW SEE IF OBJECT (OR ITS CONTAINER) IS IN ROOM                       073920
C                                                                       073930
700     J=PRSO                                                          073940
725     IF(QHERE(J,HERE)) GO TO 750                                     073950
        J=OCAN(J)                                                       073960
        IF(J.NE.0) GO TO 725                                            073970
        GO TO 800                                                       073980
C                                                                       073990
750     SVO=PRSO                                                        074000
        SVI=PRSI                                                        074010
        PRSA=TAKEW                                                      074020
        PRSI=0                                                          074030
        IF(.NOT.TAKE(.FALSE.)) RETURN                                   074040
        PRSA=PUTW                                                       074050
        PRSO=SVO                                                        074060
        PRSI=SVI                                                        074070
        GO TO 1000                                                      074080
C                                                                       074090
C NOW SEE IF OBJECT IS ON PERSON.                                       074100
C                                                                       074110
800     IF(OCAN(PRSO).EQ.0) GO TO 1000                                  074120
        IF(QOPEN(OCAN(PRSO))) GO TO 900                                 074130
        CALL RSPSUB(566,ODESC2(PRSO))                                   074140
        RETURN                                                          074150
C                                                                       074160
900     CALL SCRUPD(OFVAL(PRSO))                                        074170
        OFVAL(PRSO)=0                                                   074180
        CALL NEWSTA(PRSO,0,0,0,WINNER)                                  074190
C                                                                       074200
1000    IF(.NOT.FLG) GO TO 1100                                         074210
        IF(OBJACT(X)) RETURN                                            074220
1100    CALL NEWSTA(PRSO,2,0,PRSI,0)                                    074230
        PUT=.TRUE.                                                      074240
        RETURN                                                          074250
C                                                                       074260
        END
        SUBROUTINE VALUAC(V)
        IMPLICIT INTEGER (A-Z)                                          074290
C VALUAC- HANDLES VALUABLES/EVERYTHING                                  074300
C                                                                       074310
C DECLARATIONS                                                          074320
C                                                                       074330
        LOGICAL LIT,F,F1,TAKE,PUT,DROP,NOTVAL,QHERE                     074340
C                                                                       074350
C PARSER OUTPUT                                                         074360
C                                                                       074370
        LOGICAL PRSWON                                                  074380
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    074390
C                                                                       074400
C GAME STATE                                                            074410
C                                                                       074420
        LOGICAL TELFLG                                                  074430
        COMMON /PLAY/ WINNER,HERE,TELFLG                                074440
C                                                                       074450
C OBJECTS                                                               074460
C                                                                       074470
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       074480
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            074490
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              074500
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  074510
C                                                                       074520
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      074530
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          074540
     2       TOOLBT,TURNBT,ONBT                                         074550
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       074560
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           074570
     2       TCHBT,VEHBT,SCHBT                                          074580
C                                                                       074590
C VERBS                                                                 074600
C                                                                       074610
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  074620
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              074630
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         074640
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            074650
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           074660
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  074670
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    074680
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            074690
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       074700
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       074710
        COMMON /VINDEX/ DIGW,LEAPW                                      074720
        NOTVAL(R)=(SAVEP.EQ.V).AND.(OTVAL(R).LE.0)
C VALUAC, PAGE 2                                                        074740
C                                                                       074750
        F=.TRUE.                                                        074760
        SAVEP=PRSO                                                      074770
        SAVEH=HERE                                                      074780
        IF(LIT(HERE)) GO TO 100                                         074790
        CALL RSPEAK(579)                                                074800
        RETURN                                                          074810
C                                                                       074820
100     IF(PRSA.NE.TAKEW) GO TO 1000                                    074830
        DO 500 PRSO=1,OLNT                                              074840
          IF(.NOT.QHERE(PRSO,HERE).OR.                                  074850
     1       (AND(OFLAG1(PRSO),VISIBT).EQ.0).OR.                        074860
     2       (AND(OFLAG2(PRSO),ACTRBT).NE.0).OR.                        074870
     3       NOTVAL(PRSO)) GO TO 500                                    074880
          IF((AND(OFLAG1(PRSO),TAKEBT).EQ.0).AND.                       074890
     1       (AND(OFLAG2(PRSO),TRYBT).EQ.0)) GO TO 500                  074900
          F=.FALSE.                                                     074910
          CALL RSPSUB(580,ODESC2(PRSO))                                 074920
          F1=TAKE(.TRUE.)                                               074930
          IF(SAVEH.NE.HERE) RETURN                                      074940
500     CONTINUE                                                        074950
        GO TO 3000                                                      074960
C                                                                       074970
1000    IF(PRSA.NE.DROPW) GO TO 2000                                    074980
        DO 1500 PRSO=1,OLNT                                             074990
          IF((OADV(PRSO).NE.WINNER).OR.NOTVAL(PRSO))                    075000
     1       GO TO 1500                                                 075010
          F=.FALSE.                                                     075020
          CALL RSPSUB(580,ODESC2(PRSO))                                 075030
          F1=DROP(.TRUE.)                                               075040
          IF(SAVEH.NE.HERE) RETURN                                      075050
1500    CONTINUE                                                        075060
        GO TO 3000                                                      075070
C                                                                       075080
2000    IF(PRSA.NE.PUTW) RETURN                                         075090
        DO 2500 PRSO=1,OLNT                                             075100
          IF((OADV(PRSO).NE.WINNER)                                     075110
     1       .OR.(PRSO.EQ.PRSI).OR.NOTVAL(PRSO).OR.                     075120
     2       (AND(OFLAG1(PRSO),VISIBT).EQ.0)) GO TO 2500                075130
          F=.FALSE.                                                     075140
          CALL RSPSUB(580,ODESC2(PRSO))                                 075150
          F1=PUT(.TRUE.)                                                075160
          IF(SAVEH.NE.HERE) RETURN                                      075170
2500    CONTINUE                                                        075180
C                                                                       075190
3000    I=581                                                           075200
        IF(SAVEP.EQ.V) I=582                                            075210
        IF(F) CALL RSPEAK(I)                                            075220
        RETURN                                                          075230
        END
        SUBROUTINE SAVEGM
        IMPLICIT INTEGER (A-Z)                                          075260
      COMMON /RMSG/MLNT,RTEXT(800)                                      075270
      COMMON /STAR/MBASE,STRBIT                                         075280
      COMMON /OROOM2/R2LNT,O2(6),R2(6)                                  075290
C SAVE- SAVE GAME STATE                                                 075300
C                                                                       075310
C DECLARATIONS                                                          075320
C                                                                       075330
C                                                                       075340
C PARSER OUTPUT                                                         075350
C                                                                       075360
        LOGICAL PRSWON                                                  075370
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    075380
C                                                                       075390
C GAME STATE                                                            075400
C                                                                       075410
        LOGICAL TELFLG                                                  075420
        COMMON /PLAY/ WINNER,HERE,TELFLG                                075430
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               075440
     1       LTSHFT,BLOC,MUNGRM,HS                                      075450
C                                                                       075460
C MISCELLANEOUS VARIABLES                                               075470
C                                                                       075480
        COMMON /VERS/ VMAJ,VMIN,VEDIT                                   075490
        COMMON /TIME/ PLTIME,SHOUR,SMIN,SSEC                            075500
C                                                                       075510
C ROOMS                                                                 075520
C                                                                       075530
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         075540
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                075550
C                                                                       075560
C EXITS                                                                 075570
C                                                                       075580
        COMMON /EXITS/ XLNT,TRAVEL(625)
C                                                                       075600
C OBJECTS                                                               075610
C                                                                       075620
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       075630
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            075640
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              075650
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  075660
C                                                                       075670
C                                                                       075680
C CLOCK INTERRUPTS                                                      075690
C                                                                       075700
        LOGICAL CFLAG                                                   075710
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             075720
C                                                                       075730
C                                                                       075740
C VILLAINS AND DEMONS                                                   075750
C                                                                       075760
        LOGICAL THFFLG,SWDACT,THFACT                                    075770
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA                075780
        COMMON /VILL/ VLNT,VILLNS(5),VPROB(5),VOPPS(5)                  075790
C                                                                       075800
C ADVENTURERS                                                           075810
C                                                                       075820
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                075830
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       075840
C                                                                       075850
C FLAGS                                                                 075860
C                                                                       075870
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               075890
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   075900
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                075910
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 075920
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                075930
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      075950
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     075960
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  075970
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   075980
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  075990
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     076010
      COMMON /LAIR/NTIMES                                               002990
      COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                      003000
        EQUIVALENCE (FLAGS(1),TROLLF)                                   076020
C B7700 CHANGE----                                                      076030
C       REAL GTITLE(4)/"DAT/SAVDATA."/                                  076040
C                                                                       076050
        PRSWON=.FALSE.                                                  076060
C       CHANGE (1,TITLE=GTITLE,MAXRECSIZE=3000,FLEXIBLE=.TRUE.,         076070
C    1  BLOCKSIZE=3000,AREASIZE=1,AREAS=7,UNITS=0,MYUSE=OUT)            076080
C     1       ACCESS="SEQOUT",MODE="IMAGE",ERR=100)                     076090
C                                                                       076100
      REWIND 3                                                          076110
        WRITE(3) VMAJ,VMIN,VEDIT                                        076120
        WRITE(3) WINNER,HERE,THFPOS,TELFLG,THFFLG,THFACT,               076130
     1       SWDACT,SWDSTA                                              076140
        WRITE(3) PLTIME,MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,              076150
     1       LTSHFT,BLOC,MUNGRM,HS                                      076160
        WRITE(3) ODESC1,ODESC2,OFLAG1,OFLAG2,OFVAL,OTVAL,               076170
     1       OSIZE,OCAPAC,OROOM,OADV,OCAN,ORAND                         076180
        WRITE(3) RVAL,RFLAG,RRAND                                       076190
        WRITE(3) AROOM,ASCORE,AVEHIC,ASTREN,AFLAG                       076200
        WRITE(3) FLAGS,BINFF,BTIEF,VPROB,CFLAG,CTICK                    076210
        WRITE(3) MXSCOR,STRBIT                                          076220
        WRITE(3) RLNT,RDESC1,RDESC2,REXIT,RACTIO,RVAL,RFLAG,RRAND       076230
        WRITE(3) XLNT,TRAVEL                                            076240
        WRITE(3) OLNT,ODESC1,ODESC2,ODESCO,OACTIO,OFLAG1,OFLAG2,        076250
     1       OFVAL,OTVAL,OSIZE,OCAPAC,OROOM,OADV,OCAN,                  076260
     2       OREAD,ORAND                                                076270
        WRITE(3) R2LNT,O2,R2                                            076280
        WRITE(3) CLNT,CTICK,CACTIO,CFLAG                                076290
        WRITE(3) VLNT,VILLNS,VPROB,VOPPS                                076300
        WRITE(3) ALNT,AROOM,ASCORE,AVEHIC,AOBJ,AACTIO,ASTREN,AFLAG      076310
        WRITE(3) MBASE,MLNT,RTEXT                                       076320
      WRITE(3) NTIMES,RVMNT,RVCLR,RVCYC,RVSND,RVGUA                     003020
      ENDFILE 3                                                         076330
C                                                                       076340
C       CLOSE(1,DISP=CRUNCH)                                            076350
        CALL RSPEAK(597)                                                076360
        RETURN                                                          076370
C                                                                       076380
100     CALL RSPEAK(598)                                                076390
        RETURN                                                          076400
        END
        SUBROUTINE RSTRGM
        IMPLICIT INTEGER (A-Z)                                          076430
      COMMON /RMSG/MLNT,RTEXT(800)                                      076440
      COMMON /STAR/MBASE,STRBIT                                         076450
      COMMON /OROOM2/R2LNT,O2(6),R2(6)                                  076460
C RESTORE- RESTORE GAME STATE                                           076470
C                                                                       076480
C DECLARATIONS                                                          076490
C                                                                       076500
C                                                                       076510
C PARSER OUTPUT                                                         076520
C                                                                       076530
        LOGICAL PRSWON                                                  076540
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    076550
C                                                                       076560
C GAME STATE                                                            076570
C                                                                       076580
        LOGICAL TELFLG                                                  076590
        COMMON /PLAY/ WINNER,HERE,TELFLG                                076600
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               076610
     1       LTSHFT,BLOC,MUNGRM,HS                                      076620
C                                                                       076630
C MISCELLANEOUS VARIABLES                                               076640
C                                                                       076650
        COMMON /VERS/ VMAJ,VMIN,VEDIT                                   076660
        COMMON /TIME/ PLTIME,SHOUR,SMIN,SSEC                            076670
C                                                                       076680
C ROOMS                                                                 076690
C                                                                       076700
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         076710
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                076720
C                                                                       076730
C EXITS                                                                 076740
C                                                                       076750
        COMMON /EXITS/ XLNT,TRAVEL(625)
C                                                                       076770
C OBJECTS                                                               076780
C                                                                       076790
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       076800
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            076810
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              076820
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  076830
C                                                                       076840
C                                                                       076850
C CLOCK INTERRUPTS                                                      076860
C                                                                       076870
        LOGICAL CFLAG                                                   076880
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             076890
C                                                                       076900
C                                                                       076910
C VILLAINS AND DEMONS                                                   076920
C                                                                       076930
        LOGICAL THFFLG,SWDACT,THFACT                                    076940
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT,SWDSTA                076950
        COMMON /VILL/ VLNT,VILLNS(5),VPROB(5),VOPPS(5)                  076960
C                                                                       076970
C ADVENTURERS                                                           076980
C                                                                       076990
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                077000
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       077010
C                                                                       077020
C FLAGS                                                                 077030
C                                                                       077040
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               077060
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   077070
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                077080
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 077090
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                077100
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      077120
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     077130
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  077140
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   077150
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  077160
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     077180
      COMMON /LAIR/NTIMES                                               003040
      COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                      003050
        EQUIVALENCE (FLAGS(1),TROLLF)                                   077190
C B7700 CHANGE--                                                        077200
        LOGICAL THERE                                                   077210
C       REAL GTITLE(4)/"DAT/SAVDATA."/                                  077220
C                                                                       077230
        PRSWON=.FALSE.                                                  077240
C       CHANGE (1,TITLE=GTITLE,FILETYPE=7,MYUSE=IN)                     077250
C     1       ACCESS="SEQIN",MODE="IMAGE",ERR=100)                      077260
C       INQUIRE(1,PRESENT=THERE)                                        077270
C       IF(.NOT.THERE)GO TO 100                                         077280
C                                                                       077290
      REWIND 3                                                          077300
        READ(3,END=10000) I,J,K
10000   IF((I.NE.VMAJ).OR.(J.NE.VMIN)) GO TO 200
C                                                                       077330
        READ(3,END=10001) WINNER,HERE,THFPOS,TELFLG,THFFLG,THFACT,
     1                 SWDACT,SWDSTA
10001   READ(3,END=10002) PLTIME,MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,
     1                 LTSHFT,BLOC,MUNGRM,HS
10002   READ(3,END=10003) ODESC1,ODESC2,OFLAG1,OFLAG2,OFVAL,OTVAL,
     1                 OSIZE,OCAPAC,OROOM,OADV,OCAN,ORAND
10003   READ(3,END=10004) RVAL,RFLAG,RRAND
10004   READ(3,END=10005) AROOM,ASCORE,AVEHIC,ASTREN,AFLAG
10005   READ(3,END=10006) FLAGS,BINFF,BTIEF,VPROB,CFLAG,CTICK
10006   READ(3,END=10007) MXSCOR,STRBIT
10007   READ(3,END=10008) RLNT,RDESC1,RDESC2,REXIT,RACTIO,RVAL,RFLAG,RRA
     +ND
10008   READ(3,END=10009) XLNT,TRAVEL
10009   READ(3,END=10010) OLNT,ODESC1,ODESC2,ODESCO,OACTIO,OFLAG1,OFLAG2
     1,                OFVAL,OTVAL,OSIZE,OCAPAC,OROOM,OADV,OCAN,
     2                 OREAD,ORAND
10010   READ(3,END=10011) R2LNT,O2,R2
10011   READ(3,END=10012) CLNT,CTICK,CACTIO,CFLAG
10012   READ(3,END=10013) VLNT,VILLNS,VPROB,VOPPS
10013   READ(3,END=10014) ALNT,AROOM,ASCORE,AVEHIC,AOBJ,AACTIO,ASTREN,AF
     +LAG
10014   READ(3,END=10015) MBASE,MLNT,RTEXT
10015 READ(3,END=10016) NTIMES,RVMNT,RVCLR,RVCYC,RVSND,RVGUA
C                                                                       077540
C       CLOSE(1)                                                        077550
10016   CALL RSPEAK(599)
        RETURN                                                          077570
C                                                                       077580
100     CALL RSPEAK(598)                                                077590
        RETURN                                                          077600
C                                                                       077610
200     CALL RSPEAK(600)                                                077620
C       CLOSE (1,DISP=DELETE)                                           077630
        RETURN                                                          077640
        END                                                             077650
        LOGICAL FUNCTION WALK(X)
        IMPLICIT INTEGER(A-Z)                                           077670
C WALK- MOVE IN SPECIFIED DIRECTION                                     077680
C                                                                       077690
C DECLARATIONS                                                          077700
C                                                                       077710
        LOGICAL FINDXT,QOPEN,LIT,PROB,MOVETO,RMINFO                     077720
C                                                                       077730
C PARSER OUTPUT                                                         077740
C                                                                       077750
        LOGICAL PRSWON                                                  077760
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    077770
C                                                                       077780
C GAME STATE                                                            077790
C                                                                       077800
        LOGICAL TELFLG                                                  077810
        COMMON /PLAY/ WINNER,HERE,TELFLG                                077820
C                                                                       077830
C EXITS                                                                 077840
C                                                                       077850
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ                  077860
        EQUIVALENCE (XFLAG,XOBJ)                                        077870
C                                                                       077880
C OBJECTS                                                               077890
C                                                                       077900
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       077910
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            077920
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              077930
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  077940
C                                                                       077950
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      077960
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          077970
     2       TOOLBT,TURNBT,ONBT                                         077980
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       077990
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           078000
     2       TCHBT,VEHBT,SCHBT                                          078010
C                                                                       078020
        LOGICAL CFLAG                                                   078030
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             078040
C                                                                       078050
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             078060
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 078070
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                078080
C                                                                       078090
C VILLAINS AND DEMONS                                                   078100
C                                                                       078110
        LOGICAL THFFLG,SWDACT,THFACT                                    078120
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT                       078130
        COMMON /VILL/ VLNT,VILLNS(5),VPROB(5),VOPPS(5)                  078140
C                                                                       078150
C ADVENTURERS                                                           078160
C                                                                       078170
        COMMON /AINDEX/ PLAYER,AROBOT                                   078180
C                                                                       078190
C FLAGS                                                                 078200
C                                                                       078210
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               078230
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   078240
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                078250
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 078260
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                078270
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      078290
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     078300
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  078310
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   078320
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  078330
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     078350
        EQUIVALENCE (FLAGS(1),TROLLF)                                   078360
        QOPEN(O)=AND(OFLAG2(O),OPENBT).NE.0
        PROB(O)=(RND(100).LT.O)
C WALK, PAGE 2                                                          078390
C                                                                       078400
        WALK=.TRUE.                                                     078410
        IF((WINNER.NE.PLAYER).OR.LIT(HERE).OR.PROB(25))                 078420
     1       GO TO 500                                                  078430
        IF(.NOT.FINDXT(PRSO,HERE)) GO TO 450                            078440
        GO TO (400,200,100,300),XTYPE
      CALL GOTOER
C        CALL BUG(9,XTYPE)                                              078460
C                                                                       078470
100     IF(XACTIO.EQ.0) GO TO 150                                       078480
        IF(CXAPPL(XACTIO).NE.0) GO TO 400                               078490
150     IF(FLAGS(XFLAG)) GO TO 400                                      078500
200     CALL JIGSUP(523)                                                078510
        RETURN                                                          078520
C                                                                       078530
300     IF(XACTIO.EQ.0) GO TO 350                                       078540
        IF(CXAPPL(XACTIO).NE.0) GO TO 400                               078550
350     IF(QOPEN(XOBJ)) GO TO 400                                       078560
        CALL JIGSUP(523)                                                078570
        RETURN                                                          078580
C                                                                       078590
400     IF(LIT(XROOM1)) GO TO 900                                       078600
450     CALL JIGSUP(522)                                                078610
        RETURN                                                          078620
C                                                                       078630
C ROOM IS LIT, OR WINNER IS NOT PLAYER (NO GRUE).                       078640
C                                                                       078650
500     IF(FINDXT(PRSO,HERE)) GO TO 550                                 078660
        CALL RSPEAK(524)                                                078670
        RETURN                                                          078680
C                                                                       078690
550     GO TO (900,600,700,800),XTYPE
      CALL GOTOER
C        CALL BUG(9,XTYPE)                                              078710
C                                                                       078720
600     CALL RSPEAK(XSTRNG)                                             078730
        RETURN                                                          078740
C                                                                       078750
700     IF(XACTIO.EQ.0) GO TO 750                                       078760
        IF(CXAPPL(XACTIO).NE.0) GO TO 900                               078770
750     IF(FLAGS(XFLAG)) GO TO 900                                      078780
        IF(XSTRNG.EQ.0) XSTRNG=524                                      078790
        CALL RSPEAK(XSTRNG)                                             078800
        RETURN                                                          078810
C                                                                       078820
800     IF(XACTIO.EQ.0) GO TO 850                                       078830
        IF(CXAPPL(XACTIO).NE.0) GO TO 900                               078840
850     IF(QOPEN(XOBJ)) GO TO 900                                       078850
        IF(XSTRNG.EQ.0) XSTRNG=525                                      078860
        CALL RSPSUB(XSTRNG,ODESC2(XOBJ))                                078870
        RETURN                                                          078880
C                                                                       078890
900     WALK=MOVETO(XROOM1)                                             078900
        IF(WALK) WALK=RMINFO(.FALSE.)                                   078910
        RETURN                                                          078920
        END                                                             078930
        INTEGER FUNCTION CXAPPL(RI)
        IMPLICIT INTEGER (A-Z)                                          078950
C CXAPPL- CONDITIONAL EXIT PROCESSORS                                   078960
C                                                                       078970
C DECLARATIONS                                                          078980
C                                                                       078990
C                                                                       079000
C GAME STATE                                                            079010
C                                                                       079020
        LOGICAL TELFLG                                                  079030
        COMMON /PLAY/ WINNER,HERE,TELFLG                                079040
C                                                                       079050
C ROOMS                                                                 079060
C                                                                       079070
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         079080
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                079090
C                                                                       079100
C EXITS                                                                 079110
C                                                                       079120
        COMMON /EXITS/ XLNT,TRAVEL(625)
C                                                                       079140
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ                  079150
        EQUIVALENCE (XFLAG,XOBJ)                                        079160
C                                                                       079170
        COMMON /XPARS/ XRMASK,XDMASK,XFMASK,XFSHFT,XASHFT,              079180
     1       XELNT(4),XNORM,XNO,XCOND,XDOOR,XLFLAG                      079190
C                                                                       079200
C OBJECTS                                                               079210
C                                                                       079220
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       079230
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            079240
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              079250
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  079260
C                                                                       079270
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      079280
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          079290
     2       TOOLBT,TURNBT,ONBT                                         079300
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       079310
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           079320
     2       TCHBT,VEHBT,SCHBT                                          079330
C                                                                       079340
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    079350
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           079360
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 079370
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              079380
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   079390
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     079400
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        079410
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    079420
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          079430
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                079440
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              079450
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         079460
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               079470
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    079480
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  079490
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   079500
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       079520
        COMMON /AINDEX/ PLAYER,AROBOT                                   079530
C                                                                       079540
C FLAGS                                                                 079550
C                                                                       079560
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               079580
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   079590
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                079600
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 079610
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                079620
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      079640
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     079650
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  079660
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   079670
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  079680
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     079700
        EQUIVALENCE (FLAGS(1),TROLLF)                                   079710
C CXAPPL, PAGE 2                                                        079720
C                                                                       079730
        CXAPPL=0                                                        079740
        GO TO (1000,2000,3000,4000,5000),RI
      CALL GOTOER
C        CALL BUG(5,RI)                                                 079760
C                                                                       079770
C C1- COFFIN-CURE                                                       079780
C                                                                       079790
1000    EGYPTF=OADV(COFFI).NE.WINNER                                    079800
        RETURN                                                          079810
C                                                                       079820
C C2- CAROUSEL EXIT                                                     079830
C C5- CAROUSEL OUT                                                      079840
C                                                                       079850
2000    IF(CAROFF) RETURN                                               079860
2500    CALL RSPEAK(121)                                                079870
5000    I=XELNT(XCOND)*RND(8)                                           079880
        XROOM1=AND((TRAVEL(REXIT(HERE)+I)),XRMASK)                      079890
        CXAPPL=XROOM1                                                   079900
        RETURN                                                          079910
C                                                                       079920
C C3- CHIMNEY FUNCTION                                                  079930
C                                                                       079940
3000    LITLDF=.FALSE.                                                  079950
        J=0                                                             079960
        DO 3100 I=1,OLNT                                                079970
          IF(OADV(I).EQ.WINNER) J=J+1                                   079980
3100    CONTINUE                                                        079990
C                                                                       080000
        IF((J.GT.2).OR.(OADV(LAMP).NE.WINNER)) RETURN                   080010
        LITLDF=.TRUE.                                                   080020
        IF(AND(OFLAG2(DOOR),OPENBT).EQ.0)                               080030
     1       OFLAG2(DOOR)=AND(OFLAG2(DOOR),COMPL(TCHBT))                080040
        RETURN                                                          080050
C                                                                       080060
C C4- FROBOZZ FLAG (MAGNET ROOM)                                        080070
C                                                                       080080
4000    FROBZF=(WINNER.NE.PLAYER).OR. .NOT.CAROFF                       080090
        IF(FROBZF) RETURN                                               080100
        GO TO 2500                                                      080110
C                                                                       080120
        END                                                             080130
        LOGICAL FUNCTION LIGHTP(OBJ)
        IMPLICIT INTEGER (A-Z)                                          080150
C LIGHTP-       LIGHT PROCESSOR                                         080160
C                                                                       080170
C DECLARATIONS                                                          080180
C                                                                       080190
        LOGICAL QON                                                     080200
C                                                                       080210
C PARSER OUTPUT                                                         080220
C                                                                       080230
        LOGICAL PRSWON                                                  080240
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    080250
C                                                                       080260
C GAME STATE                                                            080270
C                                                                       080280
        LOGICAL TELFLG                                                  080290
        COMMON /PLAY/ WINNER,HERE,TELFLG                                080300
C                                                                       080310
C OBJECTS                                                               080320
C                                                                       080330
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       080340
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            080350
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              080360
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  080370
C                                                                       080380
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      080390
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          080400
     2       TOOLBT,TURNBT,ONBT                                         080410
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       080420
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           080430
     2       TCHBT,VEHBT,SCHBT                                          080440
C                                                                       080450
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    080460
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           080470
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 080480
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              080490
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   080500
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     080510
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        080520
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    080530
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          080540
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                080550
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              080560
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         080570
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               080580
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    080590
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  080600
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   080610
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       080630
C CLOCK INTERRUPTS                                                      080640
C                                                                       080650
        LOGICAL CFLAG                                                   080660
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             080670
C                                                                       080680
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             080690
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 080700
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                080710
C                                                                       080720
C VERBS                                                                 080730
C                                                                       080740
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  080750
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              080760
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         080770
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            080780
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           080790
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  080800
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    080810
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            080820
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       080830
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       080840
        COMMON /VINDEX/ DIGW,LEAPW                                      080850
        QON(R)=AND(OFLAG1(R),ONBT).NE.0
C LIGHTP, PAGE 2                                                        080870
C                                                                       080880
        LIGHTP=.TRUE.                                                   080890
        FLOBTS=FLAMBT+LITEBT+ONBT                                       080900
        IF(OBJ.NE.CANDL) GO TO 20000                                    080910
        IF(ORAND(CANDL).NE.0) GO TO 19100                               080920
        ORAND(CANDL)=1                                                  080930
        CTICK(CEVCND)=50                                                080940
C                                                                       080950
19100   IF(PRSA.NE.TRNOFW) GO TO 19200                                  080960
        I=513                                                           080970
        IF(QON(CANDL)) I=514                                            080980
        CFLAG(CEVCND)=.FALSE.                                           080990
        OFLAG1(CANDL)=AND(OFLAG1(CANDL),COMPL(ONBT))                    081000
        CALL RSPEAK(I)                                                  081010
        RETURN                                                          081020
C                                                                       081030
19200   IF(((PRSA.NE.BURNW).OR.(PRSO.NE.CANDL)).AND.                    081040
     1       (PRSA.NE.TRNONW)) GO TO 10                                 081050
        IF(AND(OFLAG1(CANDL),LITEBT).NE.0) GO TO 19300                  081060
        CALL RSPEAK(515)                                                081070
        RETURN                                                          081080
C                                                                       081090
19300   IF(PRSI.NE.0) GO TO 19400                                       081100
        CALL RSPEAK(516)                                                081110
        PRSWON=.FALSE.                                                  081120
        RETURN                                                          081130
C                                                                       081140
19400   IF((PRSI.NE.MATCH).OR. .NOT.QON(MATCH)) GO TO 19500             081150
        I=517                                                           081160
        IF(QON(CANDL)) I=518                                            081170
        OFLAG1(CANDL)=OR(OFLAG1(CANDL),ONBT)                            081180
        CFLAG(CEVCND)=.TRUE.                                            081190
        CALL RSPEAK(I)                                                  081200
        RETURN                                                          081210
C                                                                       081220
19500   IF((PRSI.NE.TORCH).OR. .NOT.QON(TORCH)) GO TO 19600             081230
        IF(QON(CANDL)) GO TO 19700                                      081240
        CALL NEWSTA(CANDL,521,0,0,0)                                    081250
        RETURN                                                          081260
C                                                                       081270
19600   CALL RSPEAK(519)                                                081280
        RETURN                                                          081290
C                                                                       081300
19700   CALL RSPEAK(520)                                                081310
        RETURN                                                          081320
C                                                                       081330
C20000   IF(OBJ.NE.MATCH) CALL BUG(6,OBJ)                               081340
20000 CONTINUE                                                          081350
        IF((PRSA.NE.TRNONW).OR.(PRSO.NE.MATCH)) GO TO 20500             081360
        IF(ORAND(MATCH).NE.0) GO TO 20100                               081370
        CALL RSPEAK(183)                                                081380
        RETURN                                                          081390
C                                                                       081400
20100   ORAND(MATCH)=ORAND(MATCH)-1                                     081410
        OFLAG1(MATCH)=OR(OFLAG1(MATCH),FLOBTS)                          081420
        CTICK(CEVMAT)=2                                                 081430
        CALL RSPEAK(184)                                                081440
        RETURN                                                          081450
C                                                                       081460
20500   IF((PRSA.NE.TRNOFW).OR.(AND(OFLAG1(MATCH),ONBT).EQ.0))          081470
     1       GO TO 10                                                   081480
        OFLAG1(MATCH)=AND(OFLAG1(MATCH),COMPL(FLOBTS))                  081490
        CTICK(CEVMAT)=0                                                 081500
        CALL RSPEAK(185)                                                081510
        RETURN                                                          081520
C                                                                       081530
C HERE FOR FALSE RETURN                                                 081540
C                                                                       081550
10      LIGHTP=.FALSE.                                                  081560
        RETURN                                                          081570
        END
        LOGICAL FUNCTION OAPPLI(RI,ARG)
        IMPLICIT INTEGER (A-Z)                                          081600
C OAPPLI- OBJECT SPECIAL ACTION ROUTINES                                081610
C                                                                       081620
C DECLARATIONS                                                          081630
C                                                                       081640
        LOGICAL SOBJS                                                   081650
        LOGICAL QOPEN,QON,PROB,LIT                                      081660
        LOGICAL MOVETO,RMINFO                                           081670
        LOGICAL THIEFP,CYCLOP,TROLLP,BALLOP,LIGHTP                      081680
        LOGICAL QEMPTY,QHERE,F,OPNCLS                                   081690
C                                                                       081700
C PARSER OUTPUT                                                         081710
C                                                                       081720
        LOGICAL PRSWON                                                  081730
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    081740
C                                                                       081750
C GAME STATE                                                            081760
C                                                                       081770
        LOGICAL TELFLG                                                  081780
        COMMON /PLAY/ WINNER,HERE,TELFLG                                081790
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               081800
     1       LTSHFT,BLOC,MUNGRM,HS                                      081810
C                                                                       081820
        COMMON /BATS/ BATDRP(9)                                         081830
C                                                                       081840
C ROOMS                                                                 081850
C                                                                       081860
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         081870
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                081880
C                                                                       081890
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                    081900
C                                                                       081910
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  081920
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            081930
C                                                                       081940
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               081950
        COMMON /RINDEX/ MTROL,MAZE1                                     081960
        COMMON /RINDEX/ MGRAT,MAZ15                                     081970
        COMMON /RINDEX/ FORE1,CLEAR,RESER                               081980
        COMMON /RINDEX/ STREA,EGYPT,ECHOR                               081990
        COMMON /RINDEX/ TSHAF                                           082000
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          082010
        COMMON /RINDEX/ CAROU                                           082020
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    082030
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             082040
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   082050
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         082060
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   082070
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001350
C                                                                       082090
C OBJECTS                                                               082100
C                                                                       082110
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       082120
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            082130
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              082140
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  082150
C                                                                       082160
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      082170
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          082180
     2       TOOLBT,TURNBT,ONBT                                         082190
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       082200
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           082210
     2       TCHBT,VEHBT,SCHBT                                          082220
C                                                                       082230
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    082240
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           082250
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 082260
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              082270
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   082280
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     082290
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        082300
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    082310
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          082320
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                082330
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              082340
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         082350
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               082360
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    082370
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  082380
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   082390
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       082410
C CLOCK INTERRUPTS                                                      082420
C                                                                       082430
        LOGICAL CFLAG                                                   082440
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             082450
C                                                                       082460
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             082470
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 082480
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                082490
C                                                                       082500
C ADVENTURERS                                                           082510
C                                                                       082520
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                082530
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       082540
C                                                                       082550
        COMMON /AINDEX/ PLAYER,AROBOT                                   082560
C                                                                       082570
C VERBS                                                                 082580
C                                                                       082590
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  082600
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              082610
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         082620
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            082630
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           082640
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  082650
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    082660
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            082670
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       082680
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       082690
        COMMON /VINDEX/ DIGW,LEAPW                                      082700
C                                                                       082710
C FLAGS                                                                 082720
C                                                                       082730
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               082750
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   082760
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                082770
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 082780
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                082790
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      082810
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     082820
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  082830
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   082840
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  082850
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     082870
        EQUIVALENCE (FLAGS(1),TROLLF)                                   082880
                                                                        082890
        PROB(R)=(RND(100).LT.R)
        QOPEN(R)=AND(OFLAG2(R),OPENBT).NE.0
        QON(R)=AND(OFLAG1(R),ONBT).NE.0
        DATA MXSMP/99/                                                  082930
C OAPPLI, PAGE 2                                                        082940
C                                                                       082950
        IF(RI.LE.MXSMP) GO TO 100                                       082960
        IF(PRSO.NE.0.AND.PRSO.LE.160) ODO2=ODESC2(PRSO)                 082970
        IF(PRSI.NE.0.AND.PRSI.LE.160) ODI2=ODESC2(PRSI)                 082980
 1012   CONTINUE                                                        082990
        AV=AVEHIC(WINNER)                                               083000
        FLOBTS=FLAMBT+LITEBT+ONBT                                       083010
        OAPPLI=.TRUE.                                                   083020
C                                                                       083030
        GO TO (2000,5000,10000,11000,12000,15000,18000,
     1 19000,20000,22000,25000,26000,32000,35000,39000,40000,
     +45000,47000,48000,49000,50000,51000,52000,54000,55000,
     +56000,57000,58000,59000),
     3       (RI-MXSMP)
      CALL GOTOER
C        CALL BUG(6,RI)                                                 083080
C                                                                       083090
C RETURN HERE TO DECLARE FALSE RESULT                                   083100
C                                                                       083110
10      OAPPLI=.FALSE.                                                  083120
        RETURN                                                          083130
C                                                                       083140
C SIMPLE OBJECTS, PROCESSED EXTERNALLY.                                 083150
C                                                                       083160
100     OAPPLI=SOBJS(RI,ARG)                                            083170
        RETURN                                                          083180
C OAPPLI, PAGE 3                                                        083190
C                                                                       083200
C O100--        MACHINE FUNCTION                                        083210
C                                                                       083220
2000    IF(HERE.NE.MMACH) GO TO 10                                      083230
        OAPPLI=OPNCLS(MACHI,123,124)                                    083240
        RETURN                                                          083250
C                                                                       083260
C O101--        WATER FUNCTION                                          083270
C                                                                       083280
5000    IF(PRSA.NE.THROWW) GO TO 5100                                   083290
        CALL NEWSTA(PRSO,132,0,0,0)                                     083300
        RETURN                                                          083310
C                                                                       083320
5100    IF((PRSA.NE.DROPW).AND.(PRSA.NE.POURW).AND.(PRSA.NE.GIVEW))     083330
     1       GO TO 5200                                                 083340
        IF(AV.NE.0) GO TO 5150                                          083350
        CALL NEWSTA(PRSO,133,0,0,0)                                     083360
        RETURN                                                          083370
C                                                                       083380
5150    CALL NEWSTA(PRSO,0,0,AV,0)                                      083390
        CALL RSPSUB(296,ODESC2(AV))                                     083400
        RETURN                                                          083410
C                                                                       083420
5200    IF((PRSA.NE.TAKEW).AND.(PRSA.NE.PUTW)) GO TO 10                 083430
        IF((AV.EQ.PRSI).AND.(AV.NE.0)) GO TO 5150                       083440
        IF((PRSI.NE.0).AND.(PRSI.NE.BOTTL)) GO TO 5300                  083450
        IF(OADV(BOTTL).NE.WINNER) GO TO 5400                            083460
        I=612                                                           083470
        IF(.NOT.QOPEN(BOTTL)) GO TO 5250                                083480
        I=613                                                           083490
        IF(.NOT.QEMPTY(BOTTL)) GO TO 5250                               083500
        I=614                                                           083510
        CALL NEWSTA(PRSO,0,0,BOTTL,0)                                   083520
5250    CALL RSPEAK(I)                                                  083530
        RETURN                                                          083540
C                                                                       083550
5300    CALL RSPSUB(297,ODI2)                                           083560
        CALL NEWSTA(PRSO,0,0,0,0)                                       083570
        RETURN                                                          083580
C                                                                       083590
C BOTTLE NOT ON WINNER.                                                 083600
C                                                                       083610
5400    IF((OCAN(PRSO).EQ.BOTTL).AND.(PRSA.EQ.TAKEW).AND.               083620
     1       (PRSI.EQ.0)) GO TO 5500                                    083630
        CALL RSPEAK(615)                                                083640
        RETURN                                                          083650
C                                                                       083660
5500    IF(QHERE(BOTTL,HERE)) GO TO 5600                                083670
        CALL RSPSUB(566,ODESC2(BOTTL))                                  083680
        RETURN                                                          083690
C                                                                       083700
5600    CALL NEWSTA(BOTTL,559,0,0,WINNER)                               083710
        RETURN                                                          083720
C OAPPLI, PAGE 4                                                        083730
C                                                                       083740
C O102--        LEAF PILE                                               083750
C                                                                       083760
10000   IF(PRSA.NE.BURNW) GO TO 10500                                   083770
        IF(OROOM(PRSO).EQ.0) GO TO 10100                                083780
        CALL NEWSTA(PRSO,158,0,0,0)                                     083790
        RETURN                                                          083800
C                                                                       083810
10100   CALL NEWSTA(PRSO,0,HERE,0,0)                                    083820
        CALL JIGSUP(159)                                                083830
        RETURN                                                          083840
C                                                                       083850
10500   IF(PRSA.NE.MOVEW) GO TO 10                                      083860
        CALL RSPEAK(2)                                                  083870
        RETURN                                                          083880
C                                                                       083890
C O103--        TROLL, DONE EXTERNALLY.                                 083900
C                                                                       083910
11000   OAPPLI=TROLLP(ARG)                                              083920
        RETURN                                                          083930
C                                                                       083940
C O104--        RUSTY KNIFE.                                            083950
C                                                                       083960
12000   IF(PRSA.NE.TAKEW) GO TO 12100                                   083970
        IF(OADV(SWORD).EQ.WINNER) CALL RSPEAK(160)                      083980
      IF (.NOT. ENDGMF) GOTO 10
C
C     IF IN CRYPT WITH LENS, COMPLETE ENDGAME.
C
      IF (HERE .NE. 137) GOTO 10
      IF (OADV(141) .NE. WINNER) GOTO 10
      CALL SCRUPD(25)
      CALL RSPEAK(654)
      CALL SCORE (.FALSE.)
      CALL EXIT
C                                                                       084000
12100   IF((PRSA.NE.ATTACW).AND.(PRSA.NE.KILLW).AND.                    084010
     1       (PRSA.NE.SWINGW).AND.                                      084020
     2       ((PRSA.NE.THROWW).OR.(PRSI.EQ.0))) GO TO 10                084030
        CALL NEWSTA(RKNIF,0,0,0,0)                                      084040
        CALL JIGSUP(161)                                                084050
        RETURN                                                          084060
C OAPPLI, PAGE 5                                                        084070
C                                                                       084080
C O105--        GLACIER                                                 084090
C                                                                       084100
15000   IF(PRSA.NE.THROWW) GO TO 15500                                  084110
        IF(PRSO.NE.TORCH) GO TO 15400                                   084120
        CALL NEWSTA(ICE,169,0,0,0)                                      084130
        ODESC1(TORCH)=174                                               084140
        ODESC2(TORCH)=173                                               084150
        OFLAG1(TORCH)=AND(OFLAG1(TORCH),COMPL(FLOBTS))                  084160
        CALL NEWSTA(TORCH,0,STREA,0,0)                                  084170
        GLACRF=.TRUE.                                                   084180
        IF(.NOT.LIT(HERE)) CALL RSPEAK(170)                             084190
        RETURN                                                          084200
C                                                                       084210
15400   CALL RSPEAK(171)                                                084220
        RETURN                                                          084230
C                                                                       084240
15500   IF((PRSA.NE.MELTW).OR.(PRSO.NE.ICE)) GO TO 10                   084250
        IF(AND(OFLAG1(PRSI),FLOBTS).NE.FLOBTS) GO TO 15600              084260
        CALL RSPSUB(298,ODI2)                                           084270
        RETURN                                                          084280
C                                                                       084290
15600   GLACMF=.TRUE.                                                   084300
        IF(PRSI.NE.TORCH) GO TO 15700                                   084310
        ODESC1(TORCH)=174                                               084320
        ODESC2(TORCH)=173                                               084330
        OFLAG1(TORCH)=AND(OFLAG1(TORCH),COMPL(FLOBTS))                  084340
15700   CALL JIGSUP(172)                                                084350
        RETURN                                                          084360
C                                                                       084370
C O106--        BLACK BOOK                                              084380
C                                                                       084390
18000   IF(PRSA.NE.OPENW) GO TO 18100                                   084400
        CALL RSPEAK(180)                                                084410
        RETURN                                                          084420
C                                                                       084430
18100   IF(PRSA.NE.CLOSEW) GO TO 18200                                  084440
        CALL RSPEAK(181)                                                084450
        RETURN                                                          084460
C                                                                       084470
18200   IF(PRSA.NE.BURNW) GO TO 10                                      084480
        CALL NEWSTA(PRSO,0,0,0,0)                                       084490
        CALL JIGSUP(182)                                                084500
        RETURN                                                          084510
C OAPPLI, PAGE 6                                                        084520
C                                                                       084530
C O107--        CANDLES, PROCESSED EXTERNALLY                           084540
C                                                                       084550
19000   OAPPLI=LIGHTP(CANDL)                                            084560
        RETURN                                                          084570
C                                                                       084580
C O108--        MATCHES, PROCESSED EXTERNALLY                           084590
C                                                                       084600
20000   OAPPLI=LIGHTP(MATCH)                                            084610
        RETURN                                                          084620
C                                                                       084630
C O109--        CYCLOPS, PROCESSED EXTERNALLY.                          084640
C                                                                       084650
22000   OAPPLI=CYCLOP(ARG)                                              084660
        RETURN                                                          084670
C                                                                       084680
C O110--        THIEF, PROCESSED EXTERNALLY                             084690
C                                                                       084700
25000   OAPPLI=THIEFP(ARG)                                              084710
        RETURN                                                          084720
C                                                                       084730
C O111--        WINDOW                                                  084740
C                                                                       084750
26000   OAPPLI=OPNCLS(WINDO,208,209)                                    084760
        RETURN                                                          084770
C                                                                       084780
C O112--        PILE OF BODIES                                          084790
C                                                                       084800
32000   IF(PRSA.NE.TAKEW) GO TO 32500                                   084810
        CALL RSPEAK(228)                                                084820
        RETURN                                                          084830
C                                                                       084840
32500   IF((PRSA.NE.BURNW).AND.(PRSA.NE.MUNGW)) GO TO 10                084850
        IF(ONPOLF) RETURN                                               084860
        ONPOLF=.TRUE.                                                   084870
        CALL NEWSTA(HPOLE,0,LLD2,0,0)                                   084880
        CALL JIGSUP(229)                                                084890
        RETURN                                                          084900
C                                                                       084910
C O113--        VAMPIRE BAT                                             084920
C                                                                       084930
35000   CALL RSPEAK(50)                                                 084940
        F=MOVETO(BATDRP(RND(9)+1))                                      084950
        F=RMINFO(.FALSE.)                                               084960
        RETURN                                                          084970
C OAPPLI, PAGE 7                                                        084980
C                                                                       084990
C O114--        STICK                                                   085000
C                                                                       085010
39000   IF(PRSA.NE.WAVEW) GO TO 10                                      085020
        IF(HERE.EQ.MRAIN) GO TO 39500                                   085030
        IF((HERE.EQ.POG).OR.(HERE.EQ.FALLS)) GO TO 39200                085040
        CALL RSPEAK(244)                                                085050
        RETURN                                                          085060
C                                                                       085070
39200   OFLAG1(POT)=OR(OFLAG1(POT),VISIBT)                              085080
        RAINBF=.NOT. RAINBF                                             085090
        I=245                                                           085100
        IF(RAINBF) I=246                                                085110
        CALL RSPEAK(I)                                                  085120
        RETURN                                                          085130
C                                                                       085140
39500   RAINBF=.FALSE.                                                  085150
        CALL JIGSUP(247)                                                085160
        RETURN                                                          085170
C                                                                       085180
C O115--        BALLOON, HANDLED EXTERNALLY                             085190
C                                                                       085200
40000   OAPPLI=BALLOP(ARG)                                              085210
        RETURN                                                          085220
C                                                                       085230
C O116--        HEADS                                                   085240
C                                                                       085250
45000   IF(PRSA.EQ.READW) GO TO 10                                      085260
        CALL NEWSTA(LCASE,260,LROOM,0,0)                                085270
        I=ROBADV(WINNER,0,LCASE,0)+ROBRM(HERE,100,0,LCASE,0)            085280
        CALL JIGSUP(261)                                                085290
        RETURN                                                          085300
C OAPPLI, PAGE 8                                                        085310
C                                                                       085320
C O117--        SPHERE                                                  085330
C                                                                       085340
47000   IF(CAGESF.OR.(PRSA.NE.TAKEW)) GO TO 10                          085350
        IF(WINNER.NE.PLAYER) GO TO 47500                                085360
        CALL RSPEAK(263)                                                085370
        IF(OROOM(ROBOT).NE.HERE) GO TO 47200                            085380
        F=MOVETO(CAGED)                                                 085390
        CALL NEWSTA(ROBOT,0,CAGED,0,0)                                  085400
        AROOM(AROBOT)=CAGED                                             085410
        OFLAG1(ROBOT)=OR(OFLAG1(ROBOT),NDSCBT)                          085420
        CTICK(CEVSPH)=10                                                085430
        RETURN                                                          085440
C                                                                       085450
47200   CALL NEWSTA(SPHER,0,0,0,0)                                      085460
        RFLAG(CAGER)=OR(RFLAG(CAGER),RMUNG)                             085470
        RRAND(CAGER)=147                                                085480
        CALL JIGSUP(148)                                                085490
        RETURN                                                          085500
C                                                                       085510
47500   CALL NEWSTA(SPHER,0,0,0,0)                                      085520
        CALL NEWSTA(ROBOT,264,0,0,0)                                    085530
        CALL NEWSTA(RCAGE,0,HERE,0,0)                                   085540
        RETURN                                                          085550
C                                                                       085560
C O118--        GEOMETRICAL BUTTONS                                     085570
C                                                                       085580
48000   IF(PRSA.NE.PUSHW) GO TO 10                                      085590
        I=PRSO-SQBUT+1                                                  085600
        IF((I.LE.0).OR.(I.GE.4)) GO TO 10                               085610
        IF(WINNER.NE.PLAYER) THEN
      GO TO (48100,48200,48300),I
      CALL GOTOER
      ENDIF
        CALL JIGSUP(265)                                                085630
        RETURN                                                          085640
C                                                                       085650
48100   I=267                                                           085660
        IF(CAROZF) I=266                                                085670
        CAROZF=.TRUE.                                                   085680
        CALL RSPEAK(I)                                                  085690
        RETURN                                                          085700
C                                                                       085710
48200   I=266                                                           085720
        IF(CAROZF) I=268                                                085730
        CAROZF=.FALSE.                                                  085740
        CALL RSPEAK(I)                                                  085750
        RETURN                                                          085760
C                                                                       085770
48300   CAROFF=.NOT.CAROFF                                              085780
        IF(.NOT.QHERE(IRBOX,CAROU)) RETURN                              085790
        CALL RSPEAK(269)                                                085800
C COMPLEMENT VISIBILITY                                                 085810
        OFLAG1(IRBOX)=COMPL(EQUIV(OFLAG1(IRBOX),VISIBT))                085820
        RETURN                                                          085830
C                                                                       085840
C O119--        FLASK FUNCTION                                          085850
C                                                                       085860
49000   IF(PRSA.EQ.OPENW) GO TO 49100                                   085870
        IF((PRSA.NE.MUNGW).AND.(PRSA.NE.THROWW)) GO TO 10               085880
        CALL NEWSTA(FLASK,270,0,0,0)                                    085890
49100   RFLAG(HERE)=OR(RFLAG(HERE),RMUNG)                               085900
        RRAND(HERE)=271                                                 085910
        CALL JIGSUP(272)                                                085920
        RETURN                                                          085930
C                                                                       085940
C O120--        BUCKET FUNCTION                                         085950
C                                                                       085960
50000   IF(ARG.NE.2) GO TO 10                                           085970
        IF((OCAN(WATER).NE.BUCKE).OR.BUCKTF) GO TO 50500                085980
        BUCKTF=.TRUE.                                                   085990
        CTICK(CEVBUC)=100                                               086000
        CALL NEWSTA(BUCKE,290,TWELL,0,0)                                086010
        GO TO 50900                                                     086020
C                                                                       086030
50500   IF((OCAN(WATER).EQ.BUCKE).OR..NOT.BUCKTF) GO TO 10              086040
        BUCKTF=.FALSE.                                                  086050
        CALL NEWSTA(BUCKE,291,BWELL,0,0)                                086060
50900   IF(AV.NE.BUCKE) RETURN                                          086070
        F=MOVETO(OROOM(BUCKE))                                          086080
        F=RMINFO(.FALSE.)                                               086090
        RETURN                                                          086100
C OAPPLI, PAGE 9                                                        086110
C                                                                       086120
C O121--        EATME CAKE                                              086130
C                                                                       086140
51000   IF((PRSA.NE.EATW).OR.(PRSO.NE.ECAKE).OR.                        086150
     1       (HERE.NE.ALICE)) GO TO 10                                  086160
        CALL NEWSTA(ECAKE,273,0,0,0)                                    086170
        DO 51100 I=1,OLNT                                               086180
          IF(OROOM(I).NE.ALICE) GO TO 51100                             086190
          IF(OSIZE(I).NE.10000) OSIZE(I)=OSIZE(I)*64                    086200
          OROOM(I)=ALISM                                                086210
51100   CONTINUE                                                        086220
        OAPPLI=MOVETO(ALISM)                                            086230
        RETURN                                                          086240
C                                                                       086250
C O122--        ICINGS                                                  086260
C                                                                       086270
52000   IF(PRSA.NE.READW) GO TO 52200                                   086280
        I=274                                                           086290
        IF(PRSI.NE.0) I=275                                             086300
        IF(PRSI.EQ.BOTTL) I=276                                         086310
        IF(PRSI.EQ.FLASK) I=277+(PRSO-ORICE)                            086320
        CALL RSPEAK(I)                                                  086330
        RETURN                                                          086340
C                                                                       086350
52200   IF((PRSA.NE.THROWW).OR.(PRSO.NE.RDICE).OR.(PRSI.NE.POOL))       086360
     1       GO TO 52300                                                086370
        CALL NEWSTA(POOL,280,0,0,0)                                     086380
        OFLAG1(SAFFR)=OR(OFLAG1(SAFFR),VISIBT)                          086390
        RETURN                                                          086400
C                                                                       086410
52300   IF((HERE.NE.ALICE).AND.(HERE.NE.ALISM).AND.(HERE.NE.ALITR))     086420
     1       GO TO 10                                                   086430
        IF(((PRSA.NE.EATW).AND.(PRSA.NE.THROWW)).OR.                    086440
     1       (PRSO.NE.ORICE)) GO TO 52400                               086450
        CALL NEWSTA(ORICE,0,0,0,0)                                      086460
        RFLAG(HERE)=OR(RFLAG(HERE),RMUNG)                               086470
        RRAND(HERE)=281                                                 086480
        CALL JIGSUP(282)                                                086490
        RETURN                                                          086500
C                                                                       086510
52400   IF((PRSA.NE.EATW).OR.(PRSO.NE.BLICE))                           086520
     1       GO TO 10                                                   086530
        CALL NEWSTA(BLICE,283,0,0,0)                                    086540
        IF(HERE.NE.ALISM) GO TO 52500                                   086550
        DO 52450 I=1,OLNT                                               086560
          IF(OROOM(I).NE.HERE) GO TO 52450                              086570
          OROOM(I)=ALICE                                                086580
          IF(OSIZE(I).NE.10000) OSIZE(I)=OSIZE(I)/64                    086590
52450   CONTINUE                                                        086600
        OAPPLI=MOVETO(ALICE)                                            086610
        RETURN                                                          086620
C                                                                       086630
52500   CALL JIGSUP(284)                                                086640
        RETURN                                                          086650
C                                                                       086660
C O123--        BRICK                                                   086670
C                                                                       086680
54000   IF(PRSA.NE.BURNW) GO TO 10                                      086690
        CALL JIGSUP(150)                                                086700
        RETURN                                                          086710
C                                                                       086720
C O124--        MYSELF                                                  086730
C                                                                       086740
55000   IF(PRSA.NE.GIVEW) GO TO 55100                                   086750
        CALL NEWSTA(PRSO,2,0,0,PLAYER)                                  086760
        RETURN                                                          086770
C                                                                       086780
55100   IF(PRSA.NE.TAKEW) GO TO 55200                                   086790
        CALL RSPEAK(286)                                                086800
        RETURN                                                          086810
C                                                                       086820
55200   IF((PRSA.NE.KILLW).AND.(PRSA.NE.MUNGW)) GO TO 10                086830
        CALL JIGSUP(287)                                                086840
        RETURN                                                          086850
C                                                                       086860
56000 CONTINUE
C   - O125, SPIDER.
      IFROG = RND(3)
      CALL JIGSUP(633+IFROG)
      RETURN
C
57000 CONTINUE
C     0 126, SPIDER WEB.
C
C     DUE TO MY INHERENT LAZYNESS, I HAVE USED THE FOLLOWING
C     HARD-WIRED NUMBERS:
C
C     ROOM 150 = WEB ROOM.
C     OBJ  147 = SPIDER WEB.
C     OBJ  146 = SILK TAPESTRY.
C     OBJ   11 = H20 (DON*T ALLOW WATER TO STICK IN WEB).
C     OBJ   55 = VISCOUS MATERIAL (CAN*T STICK IN WEB AND MUST
C                BE IN TUBE TO GET TAPESTRY).
C
      IF (HERE .NE. 150) GOTO 10
      IF ( (PRSA .NE. THROWW) .OR. (PRSI .NE. 147) ) GOTO 57010
C
C     DON*T LET H20 OR PUTTY STICK IN WEB.
C
      IF ( (PRSO .EQ. 11) .OR. (PRSO .EQ. 55) ) GOTO 10
      OCAN(PRSO) = PRSI
      OROOM(PRSO) = 0
      CALL RSPSUB(637,ODESC2(PRSO))
      IF (PRSO .NE. TUBE)RETURN
C
C     PUTTY (VISCOUS MATERIAL) MUST BE IN TUBE.
C
      IF (OCAN(55) .NE. TUBE) RETURN
      OCAN(146) = 0
      OROOM(146) = HERE
      CALL RSPSUB(638,ODESC2(146))
      RETURN
C
57010 IF ( (PRSA .NE. RUBW) .OR. (PRSO .NE. 147) ) GOTO 10
      CALL JIGSUP(636)
      RETURN
C
58000 CONTINUE
C
C     O127 - KANGAROO PROCESSING.
C
C     DARK KANGAROO  = OBJ 148.
C     LIGHT KANGAROO = OBJ 149.
C     E. SIDE OF HOUSE = ROOM 5.
C     MYLAR NET = OBJ 138.
C     GLASS LENS = OBJ 141.
C     CEVENT 16 = DARK COLORED KANG (OBJ 148).
C     CEVENT 17 = LIGHT COLORED KANG (OBJ 149).
C
      IF (HERE .NE. 5) GOTO 10
      IF ( (PRSA .NE. THROWW) .OR. (PRSO .NE. 138) ) GOTO 58010
      I = 16
      IF (PRSI .EQ. 149) I = 17
      IF (OROOM(PRSI) .NE. HERE) GOTO 10
      CFLAG(I) = .FALSE.
      CALL RSPSUB(650,ODESC2(148-16+I))
C
C     PLACE NETTED KANG IN NET, MOVE IT OUT OF THE ROOM.
C
      OCAN(148-16+I) = 138
      OROOM(148-16+I) = 0
C
C     IF LIGHT KANGAROO NETTED, THEN LENS APPEARS.
C     BRING POUCH OUT OF LIMBO.
C
      OROOM(133) = HERE
      IF (I .NE. 17) RETURN
C
C     DON*T PUT LENS IN POUCH IF IT HAS ALREADY BEEN TAKEN.
C
      IF ( AND(OFLAG2(141),TCHBT) .NE. 0 ) RETURN
      OCAN(141) = 133
      RETURN
C
58010 CONTINUE
      IF (PRSA .NE. RUBW) GOTO 10
      CALL RSPEAK(653)
      RETURN
C
C     O 128 - NET.
C
59000 CONTINUE
      IF ( (PRSA.NE.TAKEW) .AND. (PRSA.NE.READW) ) GOTO 10
      I = 0
      IF ( (OCAN(148).NE.0) .OR. (OCAN(149).NE.0) ) I = 1
      OCAN(148) = 0
      OCAN(149) = 0
      CFLAG(16) = .TRUE.
      CFLAG(17) = .TRUE.
      IF (I .EQ. 0) GOTO 10
      CALL RSPEAK(651)
C
C     THE KANG HAS JUST ESCAPED FROM THE NET. TAKE THE LENS
C     OUT OF THE POUCH. CLOSE THE POUCH AND REMOVE IT.
C
      OCAN(141) = 0
      OROOM(133) = 0
      OFLAG2(133) = AND(OFLAG2(133),COMPL(OPENBT))
      GOTO 10
        END                                                             086870
        LOGICAL FUNCTION SVERBS(RI)
        IMPLICIT INTEGER (A-Z)                                          086890
C SVERBS-       SIMPLE VERBS PROCESSOR                                  086900
C       ALL VERBS IN THIS ROUTINE MUST BE INDEPENDANT                   086910
C       OF OBJECT ACTIONS                                               086920
C                                                                       086930
C DECLARATIONS                                                          086940
C                                                                       086950
        LOGICAL MOVETO,YESNO                                            086960
        LOGICAL RMINFO                                                  086970
        LOGICAL QOPEN                                                   086980
        LOGICAL FINDXT,QHERE,F                                          086990
        INTEGER JOKES(20)                                               087000
        REAL RSLT                                                       087010
C                                                                       087020
C PARSER OUTPUT                                                         087030
C                                                                       087040
        LOGICAL PRSWON                                                  087050
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    087060
C                                                                       087070
C GAME STATE                                                            087080
C                                                                       087090
        LOGICAL TELFLG                                                  087100
        COMMON /PLAY/ WINNER,HERE,TELFLG                                087110
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               087120
     1       LTSHFT,BLOC,MUNGRM,HS                                      087130
C                                                                       087140
C MISCELLANEOUS VARIABLES                                               087150
C                                                                       087160
        COMMON /VERS/ VMAJ,VMIN,VEDIT                                   087170
        COMMON /CHAN/ INPCH,OUTCH,DBCH                                  087180
C                                                                       087190
C ROOMS                                                                 087200
C                                                                       087210
        COMMON /ROOMS/ RLNT,RDESC1(150),RDESC2(150),REXIT(150),         087220
     1       RACTIO(150),RVAL(150),RFLAG(150),RRAND(150)                087230
C                                                                       087240
        COMMON /RFLAG/ RSEEN,RLIGHT,RLAND,RWATER,RAIR,                  087250
     1       RSACRD,RFILL,RMUNG,RBUCK,RHOUSE                            087260
C                                                                       087270
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                    087280
C                                                                       087290
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               087300
        COMMON /RINDEX/ MTROL,MAZE1                                     087310
        COMMON /RINDEX/ MGRAT,MAZ15                                     087320
        COMMON /RINDEX/ FORE1,CLEAR,RESER                               087330
        COMMON /RINDEX/ STREA,EGYPT,ECHOR                               087340
        COMMON /RINDEX/ TSHAF                                           087350
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          087360
        COMMON /RINDEX/ CAROU                                           087370
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    087380
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             087390
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   087400
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         087410
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   087420
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001370
C                                                                       087440
C EXITS                                                                 087450
C                                                                       087460
        COMMON /EXITS/ XLNT,TRAVEL(625)
C                                                                       087480
        COMMON /CURXT/ XTYPE,XROOM1,XSTRNG,XACTIO,XOBJ                  087490
        EQUIVALENCE (XFLAG,XOBJ)                                        087500
C                                                                       087510
        COMMON /XPARS/ XRMASK,XDMASK,XFMASK,XFSHFT,XASHFT,              087520
     1       XELNT(4),XNORM,XNO,XCOND,XDOOR,XLFLAG                      087530
C                                                                       087540
        COMMON /XSRCH/ XMIN,XMAX,XDOWN                                  087550
C                                                                       087560
C OBJECTS                                                               087570
C                                                                       087580
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       087590
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            087600
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              087610
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  087620
C                                                                       087630
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      087640
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          087650
     2       TOOLBT,TURNBT,ONBT                                         087660
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       087670
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           087680
     2       TCHBT,VEHBT,SCHBT                                          087690
C                                                                       087700
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    087710
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           087720
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 087730
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              087740
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   087750
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     087760
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        087770
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    087780
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          087790
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                087800
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              087810
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         087820
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               087830
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    087840
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  087850
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   087860
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       087880
C CLOCK INTERRUPTS                                                      087890
C                                                                       087900
        LOGICAL CFLAG                                                   087910
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             087920
C                                                                       087930
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             087940
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 087950
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                087960
C                                                                       087970
C ADVENTURERS                                                           087980
C                                                                       087990
        COMMON /ADVS/ ALNT,AROOM(4),ASCORE(4),AVEHIC(4),                088000
     1       AOBJ(4),AACTIO(4),ASTREN(4),AFLAG(4)                       088010
C                                                                       088020
        COMMON /AINDEX/ PLAYER,AROBOT                                   088030
C                                                                       088040
C VERBS                                                                 088050
C                                                                       088060
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  088070
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              088080
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         088090
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            088100
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           088110
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  088120
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    088130
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            088140
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       088150
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       088160
        COMMON /VINDEX/ DIGW,LEAPW                                      088170
C                                                                       088180
C FLAGS                                                                 088190
C                                                                       088200
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               088220
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   088230
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                088240
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 088250
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                088260
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      088280
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     088290
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  088300
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   088310
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  088320
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     088340
      COMMON /LAIR/NTIMES                                               003090
        EQUIVALENCE (FLAGS(1),TROLLF)                                   088350
        DATA MXNOP/49/,MXJOKE/69/                                       088360
        DATA JOKES/4,5,3,304,305,306,307,308,309,310,                   088370
     1       311,312,313,5314,5319,324,325,0,0,0/                       088380
        QOPEN(R)=AND(OFLAG2(R),OPENBT).NE.0
C SVERBS, PAGE 2                                                        088400
C                                                                       088410
        SVERBS=.TRUE.                                                   088420
        IF(PRSO.NE.0) ODO2=ODESC2(PRSO)                                 088430
        IF(PRSI.NE.0) ODI2=ODESC2(PRSI)                                 088440
C                                                                       088450
C        IF(RI.EQ.0) CALL BUG(7,RI)                                     088460
        IF(RI.LE.MXNOP) RETURN                                          088470
        IF(RI.LE.MXJOKE) GO TO 100                                      088480
        GO TO (1000,2000,3000,4000,5000,6000,7000,8000,9000,10000,
     1 11000,12000,13000,14000,15000,16000,17000,18000,19000,20000,
     3 21000,22000,23000,24000,25000),
     8       (RI-MXJOKE)
      CALL GOTOER
C        CALL BUG(7,RI)                                                 088530
C                                                                       088540
C ALL VERB PROCESSORS RETURN HERE TO DECLARE FAILURE.                   088550
C                                                                       088560
10      SVERBS=.FALSE.                                                  088570
        RETURN                                                          088580
C                                                                       088590
C JOKE PROCESSOR.                                                       088600
C FIND PROPER ENTRY IN JOKES, USE IT TO SELECT STRING TO PRINT.         088610
C                                                                       088620
100     I=JOKES(RI-MXNOP)                                               088630
        J=I/1000                                                        088640
        IF(J.NE.0) I=MOD(I,1000)+RND(J)                                 088650
        CALL RSPEAK(I)                                                  088660
        RETURN                                                          088670
C SVERBS, PAGE 3                                                        088680
C                                                                       088690
C V70-- BRIEF.  SET FLAG.                                               088700
C                                                                       088710
1000    BRIEFF=.TRUE.                                                   088720
        CALL RSPEAK(326)                                                088730
        RETURN                                                          088740
C                                                                       088750
C V71-- UNBRIEF.  CLEAR FLAG.                                           088760
C                                                                       088770
2000    BRIEFF=.FALSE.                                                  088780
        SUPERF=.FALSE.                                                  088790
        CALL RSPEAK(327)                                                088800
        RETURN                                                          088810
C                                                                       088820
C V72-- SUPERBRIEF.  SET FLAG.                                          088830
C                                                                       088840
3000    SUPERF=.TRUE.                                                   088850
        CALL RSPEAK(328)                                                088860
        RETURN                                                          088870
C                                                                       088880
C V73-- UNSUPERBRIEF.  CLEAR FLAG.                                      088890
C                                                                       088900
4000    SUPERF=.FALSE.                                                  088910
        CALL RSPEAK(329)                                                088920
        RETURN                                                          088930
C                                                                       088940
C V74-- VERSION.  PRINT INFO.                                           088950
C                                                                       088960
5000    WRITE(OUTCH,5010) VMAJ,VMIN,VEDIT                               088970
5010    FORMAT(' V',I1,'.',I2,A1)
        TELFLG=.TRUE.                                                   088990
        RETURN                                                          089000
C                                                                       089010
C V75-- SWIM.  ALWAYS A JOKE.                                           089020
C                                                                       089030
6000    I=330                                                           089040
        IF(AND(RFLAG(HERE),(RWATER+RFILL)).EQ.0)                        089050
     1       I=331+RND(3)                                               089060
        CALL RSPEAK(I)                                                  089070
        RETURN                                                          089080
C                                                                       089090
C V76-- GERONIMO.  IF IN BARREL, FATAL, ELSE JOKE.                      089100
C                                                                       089110
7000    IF(HERE.EQ.MBARR) GO TO 7100                                    089120
        CALL RSPEAK(334)                                                089130
        RETURN                                                          089140
C                                                                       089150
7100    CALL JIGSUP(335)                                                089160
        RETURN                                                          089170
C                                                                       089180
C V77-- SINBAD ET AL.  CHASE CYCLOPS, ELSE JOKE.                        089190
C                                                                       089200
8000    IF((HERE.EQ.MCYCL).AND.QHERE(CYCLO,HERE)) GO TO 8100            089210
      IF ((HERE.EQ.WHITEC2) .AND. QHERE(CYCLO,HERE)) GOTO 8200          000960
        CALL RSPEAK(336)                                                089220
        RETURN                                                          089230
C                                                                       089240
 8100 CONTINUE                                                          000980
      CALL NEWSTA(CYCLO,337,148,0,0)                                    000990
      CYCLOF2 = .FALSE.                                                 001000
        CYCLOF=.TRUE.                                                   089260
        MAGICF=.TRUE.                                                   089270
      RETURN                                                            001020
                                                                        001030
 8200 CONTINUE                                                          001040
      NTIMES = NTIMES + 1                                               001050
      IF ( NTIMES .GE. 4) GOTO 8300                                     001060
      CALL RSPEAK(625+NTIMES)                                           001070
      RETURN                                                            001080
                                                                        001090
 8300 CONTINUE                                                          001100
      CALL NEWSTA(CYCLO,625,0,0,0)                                      001110
      CYCLOF2 = .TRUE.                                                  001120
      CYCLOF = .TRUE.                                                   001130
        OFLAG2(CYCLO)=AND(OFLAG2(CYCLO),COMPL(FITEBT))                  089280
        RETURN                                                          089290
C                                                                       089300
C V78-- WELL.  OPEN DOOR, ELSE JOKE.                                    089310
C                                                                       089320
9000    IF(RIDDLF.OR.(HERE.NE.RIDDL)) GO TO 9100                        089330
        RIDDLF=.TRUE.                                                   089340
        CALL RSPEAK(338)                                                089350
        RETURN                                                          089360
C                                                                       089370
9100    CALL RSPEAK(339)                                                089380
        RETURN                                                          089390
C                                                                       089400
C V79-- PRAY.  IF IN TEMP2, POOF                                        089410
C                                                                       089420
10000   IF(HERE.NE.TEMP2) GO TO 10050                                   089430
        IF(MOVETO(FORE1)) GO TO 10100                                   089440
10050   CALL RSPEAK(340)                                                089450
        RETURN                                                          089460
C                                                                       089470
10100   F=RMINFO(.TRUE.)                                                089480
        RETURN                                                          089490
C                                                                       089500
C V80-- TREASURE.  IF IN TEMP1, POOF                                    089510
C                                                                       089520
11000   IF(HERE.NE.TEMP1) GO TO 11050                                   089530
        IF(MOVETO(TREAS)) GO TO 10100                                   089540
11050   CALL RSPEAK(341)                                                089550
        RETURN                                                          089560
C                                                                       089570
C V81-- TEMPLE.  IF IN TREAS, POOF                                      089580
C                                                                       089590
12000   IF(HERE.NE.TREAS) GO TO 12050                                   089600
        IF(MOVETO(TEMP1)) GO TO 10100                                   089610
12050   CALL RSPEAK(341)                                                089620
        RETURN                                                          089630
C                                                                       089640
C V82-- BLAST.  USUALLY A JOKE.                                         089650
C                                                                       089660
13000   I=342                                                           089670
        IF(PRSO.EQ.SAFE) I=252                                          089680
        CALL RSPEAK(I)                                                  089690
        RETURN                                                          089700
C                                                                       089710
C V83-- SCORE.  PRINT SCORE.                                            089720
C                                                                       089730
14000   CALL SCORE(.FALSE.)                                             089740
        RETURN                                                          089750
C                                                                       089760
C V84-- QUIT.  FINISH OUT THE GAME.                                     089770
C                                                                       089780
15000   CALL SCORE(.TRUE.)                                              089790
        IF(.NOT.YESNO(343,0,0)) RETURN                                  089800
C     CLOSE (DBCH,DISP=KEEP)                                            089810
        CALL EXIT                                                       089830
C SVERBS, PAGE 4                                                        089840
C                                                                       089850
C V85-- LOOK UNDER.  WORKS ONLY FOR RUG, LEAVES.                        089860
C                                                                       089870
16000   IF((PRSO.EQ.RUG).AND.(ORAND(PRSO).EQ.0).AND.                    089880
     1       .NOT.QOPEN(DOOR)) GO TO 16100                              089890
        IF((PRSO.NE.LEAVE).OR.(RVCLR.NE.0)) GO TO 10                    089900
        CALL RSPEAK(344)                                                089910
        RETURN                                                          089920
C                                                                       089930
16100   CALL RSPEAK(345)                                                089940
        RETURN                                                          089950
C                                                                       089960
C V86-- HELLO.  MANY NUANCES.                                           089970
C                                                                       089980
17000   IF(PRSO.NE.0) GO TO 17100                                       089990
        CALL RSPEAK(346+RND(4))                                         090000
        RETURN                                                          090010
C                                                                       090020
17100   IF(PRSO.NE.AVIAT) GO TO 17200                                   090030
        CALL RSPEAK(350)                                                090040
        RETURN                                                          090050
C                                                                       090060
17200   IF(PRSO.NE.SAILO) GO TO 17300                                   090070
        HS=HS+1                                                         090080
        I=351                                                           090090
        IF(MOD(HS,10).EQ.0) I=352                                       090100
        IF(MOD(HS,20).EQ.0) I=353                                       090110
        CALL RSPEAK(I)                                                  090120
        RETURN                                                          090130
C                                                                       090140
17300   I=354                                                           090150
        IF(AND(OFLAG2(PRSO),VILLBT).EQ.0) I=355                         090160
        CALL RSPSUB(I,ODO2)                                             090170
        RETURN                                                          090180
C                                                                       090190
C V87-- RING.  A JOKE.                                                  090200
C                                                                       090210
18000   I=359                                                           090220
        IF(PRSO.EQ.BELL) I=360                                          090230
        CALL RSPEAK(I)                                                  090240
        RETURN                                                          090250
C                                                                       090260
C V88-- BRUSH.  JOKE WITH OBSCURE TRAP.                                 090270
C                                                                       090280
19000   IF(PRSO.EQ.TEETH) GO TO 19100                                   090290
        CALL RSPEAK(362)                                                090300
        RETURN                                                          090310
C                                                                       090320
19100   IF(PRSI.NE.0) GO TO 19200                                       090330
        CALL RSPEAK(363)                                                090340
        RETURN                                                          090350
C                                                                       090360
19200   IF((PRSI.EQ.PUTTY).AND.(OADV(PUTTY).EQ.WINNER))                 090370
     1       GO TO 19300                                                090380
        CALL RSPSUB(364,ODI2)                                           090390
        RETURN                                                          090400
C                                                                       090410
19300   CALL JIGSUP(365)                                                090420
        RETURN                                                          090430
C SVERBS, PAGE 5                                                        090440
C                                                                       090450
C V89-- DIG.  UNLESS SHOVEL, A JOKE.                                    090460
C                                                                       090470
20000   IF(PRSO.EQ.SHOVE) RETURN                                        090480
        I=392                                                           090490
        IF(AND(OFLAG1(PRSO),TOOLBT).EQ.0) I=393                         090500
        CALL RSPSUB(I,ODO2)                                             090510
        RETURN                                                          090520
C                                                                       090530
C V90-- TIME.  PRINT OUT DURATION OF GAME.                              090540
C                                                                       090550
21000 CONTINUE                                                          090560
      WRITE(OUTCH,21005)                                                090570
        TELFLG=.TRUE.                                                   090580
        RETURN                                                          090590
C                                                                       090600
21005 FORMAT(' TIME IS AN ABSTRACTION OF THE HUMAN MIND WHICH HAS NO MEA
     +NING HERE.')
C                                                                       090630
C V91-- LEAP.  USUALLY A JOKE, WITH A CATCH.                            090640
C                                                                       090650
22000   IF(PRSO.EQ.0) GO TO 22200                                       090660
        IF(QHERE(PRSO,HERE)) GO TO 22100                                090670
        CALL RSPEAK(447)                                                090680
        RETURN                                                          090690
C                                                                       090700
22100   IF(AND(OFLAG2(PRSO),VILLBT).EQ.0) GO TO 22300                   090710
        CALL RSPSUB(448,ODO2)                                           090720
        RETURN                                                          090730
C                                                                       090740
22200   IF(.NOT.FINDXT(XDOWN,HERE)) GO TO 22300                         090750
        IF(XTYPE.EQ.XNO) GO TO 22400                                    090760
        IF(XTYPE.NE.XCOND) GO TO 22300                                  090770
        IF(.NOT.FLAGS(XFLAG)) GO TO 22400                               090780
22300   CALL RSPEAK(314+RND(5))                                         090790
        RETURN                                                          090800
C                                                                       090810
22400   CALL JIGSUP(449+RND(4))                                         090820
        RETURN                                                          090830
C SVERBS, PAGE 6                                                        090840
C                                                                       090850
C V92-- LOCK.                                                           090860
C                                                                       090870
23000   IF((PRSO.EQ.GRATE).AND.(HERE.EQ.MGRAT))                         090880
     1       GO TO 23200                                                090890
23100   CALL RSPEAK(464)                                                090900
        RETURN                                                          090910
C                                                                       090920
23200   GRUNLF=.FALSE.                                                  090930
        CALL RSPEAK(214)                                                090940
        TRAVEL(REXIT(HERE)+1)=214                                       090950
        RETURN                                                          090960
C                                                                       090970
C V93-- UNLOCK                                                          090980
C                                                                       090990
24000   IF((PRSO.NE.GRATE).OR.(HERE.NE.MGRAT))                          091000
     1       GO TO 23100                                                091010
        IF(PRSI.EQ.KEYS) GO TO 24200                                    091020
        CALL RSPSUB(465,ODI2)                                           091030
        RETURN                                                          091040
C                                                                       091050
24200   GRUNLF=.TRUE.                                                   091060
        CALL RSPEAK(217)                                                091070
        TRAVEL(REXIT(HERE)+1)=217                                       091080
        RETURN                                                          091090
C                                                                       091100
C V94-- DIAGNOSE.                                                       091110
C                                                                       091120
25000   I=FIGHTS(WINNER,.FALSE.)                                        091130
        J=ASTREN(WINNER)                                                091140
        K=MIN0(I+J,4)                                                   091150
        IF(.NOT.CFLAG(CEVCUR)) J=0                                      091160
        L=MIN0(4,IABS(J))                                               091170
        CALL RSPEAK(473+L)                                              091180
        I=(30*(-J-1))+CTICK(CEVCUR)                                     091190
        IF(J.NE.0) WRITE(OUTCH,25100) I                                 091200
25100   FORMAT(' YOU WILL BE CURED AFTER ',I3,' MOVES.')
        CALL RSPEAK(478+K)                                              091220
        IF(DEATHS.NE.0) CALL RSPEAK(482+DEATHS)                         091230
        RETURN                                                          091240
C                                                                       091250
        END                                                             091260
        LOGICAL FUNCTION TROLLP(ARG)
        IMPLICIT INTEGER (A-Z)                                          091280
C TROLLP-       TROLL FUNCTION                                          091290
C                                                                       091300
C DECLARATIONS                                                          091310
C                                                                       091320
        LOGICAL QHERE                                                   091330
C                                                                       091340
C PARSER OUTPUT                                                         091350
C                                                                       091360
        LOGICAL PRSWON                                                  091370
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    091380
C                                                                       091390
C GAME STATE                                                            091400
C                                                                       091410
        LOGICAL TELFLG                                                  091420
        COMMON /PLAY/ WINNER,HERE,TELFLG                                091430
C                                                                       091440
C OBJECTS                                                               091450
C                                                                       091460
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       091470
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            091480
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              091490
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  091500
C                                                                       091510
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      091520
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          091530
     2       TOOLBT,TURNBT,ONBT                                         091540
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       091550
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           091560
     2       TCHBT,VEHBT,SCHBT                                          091570
C                                                                       091580
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    091590
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           091600
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 091610
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              091620
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   091630
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     091640
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        091650
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    091660
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          091670
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                091680
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              091690
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         091700
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               091710
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    091720
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  091730
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   091740
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       091760
C VERBS                                                                 091770
C                                                                       091780
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  091790
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              091800
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         091810
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            091820
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           091830
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  091840
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    091850
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            091860
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       091870
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       091880
        COMMON /VINDEX/ DIGW,LEAPW                                      091890
C                                                                       091900
C FLAGS                                                                 091910
C                                                                       091920
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               091940
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   091950
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                091960
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 091970
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                091980
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      092000
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     092010
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  092020
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   092030
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  092040
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     092060
        EQUIVALENCE (FLAGS(1),TROLLF)                                   092070
C TROLLP, PAGE 2                                                        092080
C                                                                       092090
        TROLLP=.TRUE.                                                   092100
        IF(PRSA.NE.FIGHTW) GO TO 1100                                   092110
        IF(OCAN(AXE).EQ.TROLL) GO TO 10                                 092120
        I=433                                                           092130
        IF(.NOT.QHERE(AXE,HERE)) GO TO 1050                             092140
        I=434                                                           092150
        CALL NEWSTA(AXE,0,0,TROLL,0)                                    092160
1050    IF(QHERE(TROLL,HERE)) CALL RSPEAK(I)                            092170
        RETURN                                                          092180
C                                                                       092190
1100    IF(PRSA.NE.DEADXW) GO TO 1200                                   092200
        TROLLF=.TRUE.                                                   092210
        RETURN                                                          092220
C                                                                       092230
1200    IF(PRSA.NE.OUTXW) GO TO 1300                                    092240
        TROLLF=.TRUE.                                                   092250
        OFLAG1(AXE)=AND(OFLAG1(AXE),COMPL(VISIBT))                      092260
        ODESC1(TROLL)=435                                               092270
        RETURN                                                          092280
C                                                                       092290
1300    IF(PRSA.NE.INXW) GO TO 1400                                     092300
        TROLLF=.FALSE.                                                  092310
        OFLAG1(AXE)=OR(OFLAG1(AXE),VISIBT)                              092320
        ODESC1(TROLL)=436                                               092330
        IF(QHERE(TROLL,HERE)) CALL RSPEAK(437)                          092340
        RETURN                                                          092350
C                                                                       092360
1400    IF(PRSA.NE.FRSTQW) GO TO 1500                                   092370
        TROLLP=(RND(100).LT.33)                                         092380
        RETURN                                                          092390
C                                                                       092400
1500    IF((PRSA.NE.MOVEW).AND.(PRSA.NE.TAKEW).AND.(PRSA.NE.MUNGW)      092410
     1       .AND.(PRSA.NE.THROWW).AND.(PRSA.NE.GIVEW)) GO TO 10        092420
        IF(OCAPAC(TROLL).GE.0) GO TO 1550                               092430
        OCAPAC(TROLL)=-OCAPAC(TROLL)                                    092440
        OFLAG1(AXE)=OR(OFLAG1(AXE),VISIBT)                              092450
        TROLLF=.FALSE.                                                  092460
        ODESC1(TROLL)=436                                               092470
        CALL RSPEAK(437)                                                092480
C                                                                       092490
1550    IF((PRSA.NE.TAKEW).AND.(PRSA.NE.MOVEW)) GO TO 1600              092500
        CALL RSPEAK(438)                                                092510
        RETURN                                                          092520
C                                                                       092530
1600    IF(PRSA.NE.MUNGW) GO TO 1700                                    092540
        CALL RSPEAK(439)                                                092550
        RETURN                                                          092560
C                                                                       092570
1700    IF(PRSO.EQ.0) GO TO 10                                          092580
        I=440                                                           092590
        IF(PRSA.EQ.GIVEW) I=441                                         092600
        CALL RSPSUB(I,ODESC2(PRSO))                                     092610
        IF(PRSO.EQ.KNIFE) GO TO 1900                                    092620
        CALL NEWSTA(PRSO,442,0,0,0)                                     092630
        RETURN                                                          092640
C                                                                       092650
1900    CALL RSPEAK(443)                                                092660
        OFLAG2(TROLL)=OR(OFLAG2(TROLL),FITEBT)                          092670
        RETURN                                                          092680
C                                                                       092690
10      TROLLP=.FALSE.                                                  092700
        RETURN                                                          092710
        END
        LOGICAL FUNCTION CYCLOP(ARG)
        IMPLICIT INTEGER (A-Z)                                          092740
C CYCLOP-      CYCLOPS FUNCTION                                         092750
C                                                                       092760
C DECLARATIONS                                                          092770
C                                                                       092780
C                                                                       092790
C PARSER OUTPUT                                                         092800
C                                                                       092810
        LOGICAL PRSWON                                                  092820
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    092830
C                                                                       092840
C GAME STATE                                                            092850
C                                                                       092860
        LOGICAL TELFLG                                                  092870
        COMMON /PLAY/ WINNER,HERE,TELFLG                                092880
C                                                                       092890
        COMMON /RVARS/ RVMNT,RVCLR,RVCYC,RVSND,RVGUA                    092900
C                                                                       092910
C OBJECTS                                                               092920
C                                                                       092930
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       092940
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            092950
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              092960
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  092970
C                                                                       092980
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      092990
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          093000
     2       TOOLBT,TURNBT,ONBT                                         093010
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       093020
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           093030
     2       TCHBT,VEHBT,SCHBT                                          093040
C                                                                       093050
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    093060
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           093070
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 093080
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              093090
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   093100
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     093110
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        093120
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    093130
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          093140
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                093150
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              093160
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         093170
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               093180
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    093190
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  093200
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   093210
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       093230
C VERBS                                                                 093240
C                                                                       093250
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  093260
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              093270
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         093280
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            093290
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           093300
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  093310
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    093320
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            093330
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       093340
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       093350
        COMMON /VINDEX/ DIGW,LEAPW                                      093360
C                                                                       093370
C FLAGS                                                                 093380
C                                                                       093390
        LOGICAL FLAGS(35)
        LOGICAL TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF               093410
        LOGICAL DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF                   093420
        LOGICAL MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF                093430
        LOGICAL EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF                 093440
        LOGICAL GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF                093450
        LOGICAL GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ TROLLF,CAGESF,BUCKTF,CAROFF,CAROZF,LWTIDF,      093470
     1       DOMEF,GLACRF,ECHOF,RIDDLF,LLDF,CYCLOF,                     093480
     2       MAGICF,LITLDF,SAFEF,GNOMEF,GNODRF,MIRRMF,                  093490
     3       EGYPTF,ONPOLF,BLABF,BRIEFF,SUPERF,BUOYF,                   093500
     4       GRUNLF,GATEF,RAINBF,CAGETF,EMPTHF,DEFLAF,                  093510
     5       GLACMF,FROBZF,ENDGMF,CYCLOF2,BUGF
        COMMON /FINDEX/ BTIEF,BINFF                                     093530
        EQUIVALENCE (FLAGS(1),TROLLF)                                   093540
C CYCLOP, PAGE 2                                                        093550
C                                                                       093560
        CYCLOP=.TRUE.                                                   093570
        IF(.NOT.CYCLOF) GO TO 100                                       093580
      IF(.NOT. CYCLOF2) GOTO 100                                        001690
        IF((PRSA.NE.ALARMW).AND.(PRSA.NE.MUNGW).AND.                    093590
     1       (PRSA.NE.BURNW).AND.(PRSA.NE.FIGHTW)) GO TO 10             093600
        CYCLOF=.FALSE.                                                  093610
      CYCLOF2=.FALSE.                                                   003110
        CALL RSPEAK(187)                                                093620
        RVCYC=IABS(RVCYC)                                               093630
        OFLAG2(CYCLO)=AND(OR(OFLAG2(CYCLO),FITEBT),COMPL(SLEPBT))       093640
        RETURN                                                          093650
C                                                                       093660
100     IF((PRSA.EQ.FIGHTW).OR.(PRSA.EQ.FRSTQW)) GO TO 10               093670
        IF(IABS(RVCYC).LE.5) GO TO 200                                  093680
        RVCYC=0                                                         093690
        CALL JIGSUP(188)                                                093700
        RETURN                                                          093710
C                                                                       093720
200     IF(PRSA.NE.GIVEW) GO TO 500                                     093730
        IF((PRSO.NE.FOOD).OR.(RVCYC.LT.0)) GO TO 300                    093740
        CALL NEWSTA(FOOD,189,0,0,0)                                     093750
        RVCYC=MIN0(-1,-RVCYC)                                           093760
        RETURN                                                          093770
C                                                                       093780
300     IF(PRSO.NE.WATER) GO TO 400                                     093790
        IF(RVCYC.GE.0) GO TO 350                                        093800
        CALL NEWSTA(PRSO,190,0,0,0)                                     093810
        CYCLOF=.TRUE.                                                   093820
      CYCLOF2=.TRUE.                                                    003130
        OFLAG2(CYCLO)=AND(OR(OFLAG2(CYCLO),SLEPBT),COMPL(FITEBT))       093830
        RETURN                                                          093840
C                                                                       093850
350     CALL RSPEAK(191)                                                093860
10      CYCLOP=.FALSE.                                                  093870
        RETURN                                                          093880
C                                                                       093890
400     I=192                                                           093900
        IF(PRSO.EQ.GARLI) I=193                                         093910
450     CALL RSPEAK(I)                                                  093920
        IF(RVCYC.LT.0) RVCYC=RVCYC-1                                    093930
        IF(RVCYC.GE.0) RVCYC=RVCYC+1                                    093940
        IF(.NOT.CYCLOF) CALL RSPEAK(193+IABS(RVCYC))                    093950
        RETURN                                                          093960
C                                                                       093970
500     I=0                                                             093980
        IF((PRSA.EQ.THROWW).OR.(PRSA.EQ.MUNGW)) I=200+RND(2)            093990
        IF(PRSA.EQ.TAKEW) I=202                                         094000
        IF(PRSA.EQ.TIEW) I=203                                          094010
        IF(I) 10,10,450                                                 094020
C                                                                       094030
        END
        LOGICAL FUNCTION THIEFP(ARG)
        IMPLICIT INTEGER (A-Z)                                          094060
C THIEFP-      THIEF FUNCTION                                           094070
C                                                                       094080
C DECLARATIONS                                                          094090
C                                                                       094100
        LOGICAL QHERE,PROB                                              094110
C                                                                       094120
C PARSER OUTPUT                                                         094130
C                                                                       094140
        LOGICAL PRSWON                                                  094150
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    094160
C                                                                       094170
C GAME STATE                                                            094180
C                                                                       094190
        LOGICAL TELFLG                                                  094200
        COMMON /PLAY/ WINNER,HERE,TELFLG                                094210
C                                                                       094220
C ROOMS                                                                 094230
C                                                                       094240
        COMMON /RINDEX/ WHOUS,LROOM,CELLA                               094250
        COMMON /RINDEX/ MTROL,MAZE1                                     094260
        COMMON /RINDEX/ MGRAT,MAZ15                                     094270
        COMMON /RINDEX/ FORE1,CLEAR,RESER                               094280
        COMMON /RINDEX/ STREA,EGYPT,ECHOR                               094290
        COMMON /RINDEX/ TSHAF                                           094300
        COMMON /RINDEX/ BSHAF,MMACH,DOME,MTORC                          094310
        COMMON /RINDEX/ CAROU                                           094320
        COMMON /RINDEX/ RIDDL,LLD2,TEMP1,TEMP2,MAINT                    094330
        COMMON /RINDEX/ BLROO,TREAS,RIVR1,RIVR2,RIVR3,MCYCL             094340
        COMMON /RINDEX/ RIVR4,RIVR5,FCHMP,FALLS,MBARR                   094350
        COMMON /RINDEX/ MRAIN,POG,VLBOT,VAIR1,VAIR2,VAIR3,VAIR4         094360
        COMMON /RINDEX/ LEDG2,LEDG3,LEDG4,MSAFE,CAGER                   094370
      COMMON /RINDEX/CAGED,TWELL,BWELL,ALICE,ALISM,ALITR,WHITEC1,WHITEC2001390
C                                                                       094390
C OBJECTS                                                               094400
C                                                                       094410
        COMMON /OBJCTS/ OLNT,ODESC1(160),ODESC2(160),ODESCO(160),       094420
     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            094430
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              094440
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  094450
C                                                                       094460
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      094470
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          094480
     2       TOOLBT,TURNBT,ONBT                                         094490
        COMMON /OFLAGS/ FINDBT,SLEPBT,SCRDBT,TIEBT,ECHOBT,ACTRBT,       094500
     1       WEAPBT,FITEBT,VILLBT,STAGBT,TRYBT,NOCHBT,OPENBT,           094510
     2       TCHBT,VEHBT,SCHBT                                          094520
C                                                                       094530
        COMMON /OINDEX/ GARLI,FOOD,GUNK,COAL,MACHI,DIAMO,TCASE,BOTTL    094540
        COMMON /OINDEX/ WATER,ROPE,KNIFE,SWORD,LAMP,BLAMP,RUG           094550
        COMMON /OINDEX/ LEAVE,TROLL,AXE                                 094560
        COMMON /OINDEX/ RKNIF,KEYS,ICE,BAR                              094570
        COMMON /OINDEX/ COFFI,TORCH,TBASK,FBASK,IRBOX                   094580
        COMMON /OINDEX/ GHOST,TRUNK,BELL,BOOK,CANDL                     094590
        COMMON /OINDEX/ MATCH,TUBE,PUTTY,WRENC,SCREW,CYCLO,CHALI        094600
        COMMON /OINDEX/ THIEF,STILL,WINDO,GRATE,DOOR                    094610
        COMMON /OINDEX/ HPOLE,LEAK,RBUTT,RAILI                          094620
        COMMON /OINDEX/ POT,STATU,IBOAT,DBOAT,PUMP,RBOAT                094630
        COMMON /OINDEX/ STICK,BUOY,SHOVE,BALLO,RECEP,GUANO              094640
        COMMON /OINDEX/ BROPE,HOOK1,HOOK2,SAFE,SSLOT,BRICK,FUSE         094650
        COMMON /OINDEX/ GNOME,BLABE,DBALL                               094660
        COMMON /OINDEX/ LCASE,CAGE,RCAGE,SPHER,SQBUT                    094670
        COMMON /OINDEX/ FLASK,POOL,SAFFR,BUCKE,ECAKE,ORICE,RDICE,BLICE  094680
        COMMON /OINDEX/ ROBOT,LUNGS,SAILO,AVIAT,TEETH                   094690
        COMMON /OINDEX/ ITOBJ,EVERY,VALUA,OPLAY,STAFF,SPIDER,TAPEST,WEB
C                                                                       094710
C CLOCK INTERRUPTS                                                      094720
C                                                                       094730
        LOGICAL CFLAG                                                   094740
        COMMON /CEVENT/ CLNT,CTICK(20),CACTIO(20),CFLAG(20)             094750
C                                                                       094760
        COMMON /CINDEX/ CEVCUR,CEVMNT,CEVLNT,CEVMAT,CEVCND,             094770
     1       CEVBAL,CEVBRN,CEVFUS,CEVLED,CEVSAF,CEVVLG,                 094780
     2       CEVGNO,CEVBUC,CEVSPH,CEVEGH                                094790
C                                                                       094800
C VILLAINS AND DEMONS                                                   094810
C                                                                       094820
        LOGICAL THFFLG,SWDACT,THFACT                                    094830
        COMMON /HACK/ THFPOS,THFFLG,THFACT,SWDACT                       094840
C                                                                       094850
C VERBS                                                                 094860
C                                                                       094870
        COMMON /VINDEX/ CINTW,DEADXW,FRSTQW,INXW,OUTXW                  094880
        COMMON /VINDEX/ WALKIW,FIGHTW,FOOW                              094890
        COMMON /VINDEX/ MELTW,READW,INFLAW,DEFLAW,ALARMW,EXORCW         094900
        COMMON /VINDEX/ PLUGW,KICKW,WAVEW,RAISEW,LOWERW,RUBW            094910
        COMMON /VINDEX/ PUSHW,UNTIEW,TIEW,TIEUPW,TURNW,BREATW           094920
        COMMON /VINDEX/ KNOCKW,LOOKW,EXAMIW,SHAKEW,MOVEW,TRNONW,TRNOFW  094930
        COMMON /VINDEX/ OPENW,CLOSEW,FINDW,WAITW,SPINW,BOARDW,UNBOAW    094940
        COMMON /VINDEX/ TAKEW,INVENW,FILLW,EATW,DRINKW,BURNW            094950
        COMMON /VINDEX/ MUNGW,KILLW,ATTACW,SWINGW                       094960
        COMMON /VINDEX/ WALKW,TELLW,PUTW,DROPW,GIVEW,POURW,THROWW       094970
        COMMON /VINDEX/ DIGW,LEAPW                                      094980
        PROB(R)=(RND(100).LT.R)
C THIEFP, PAGE 2                                                        095000
C                                                                       095010
        THIEFP=.TRUE.                                                   095020
        IF(PRSA.NE.FIGHTW) GO TO 100                                    095030
        IF(OCAN(STILL).EQ.THIEF) GO TO 10                               095040
        IF(QHERE(STILL,THFPOS)) GO TO 50                                095050
        CALL NEWSTA(THIEF,0,0,0,0)                                      095060
        IF(QHERE(THIEF,HERE)) CALL RSPEAK(498)                          095070
        RETURN                                                          095080
C                                                                       095090
50      CALL NEWSTA(STILL,0,0,THIEF,0)                                  095100
        IF(QHERE(THIEF,HERE)) CALL RSPEAK(499)                          095110
        RETURN                                                          095120
C                                                                       095130
100     IF(PRSA.NE.DEADXW) GO TO 200                                    095140
        THFACT=.FALSE.                                                  095150
        OFLAG1(CHALI)=OR(OFLAG1(CHALI),TAKEBT)                          095160
        J=0                                                             095170
        DO 125 I=1,OLNT                                                 095180
125       IF(OADV(I).EQ.-THIEF) J=500                                   095190
        CALL RSPEAK(J)                                                  095200
C                                                                       095210
        J=501                                                           095220
        DO 150 I=1,OLNT                                                 095230
          IF((I.EQ.CHALI).OR.(I.EQ.THIEF).OR.(HERE.NE.TREAS)            095240
     1       .OR. .NOT.QHERE(I,HERE)) GO TO 135                         095250
          OFLAG1(I)=OR(OFLAG1(I),VISIBT)                                095260
          CALL RSPSUB(J,ODESC2(I))                                      095270
          J=502                                                         095280
          GO TO 150                                                     095290
C                                                                       095300
135       IF(OADV(I).EQ.-THIEF) CALL NEWSTA(I,0,HERE,0,0)               095310
150     CONTINUE                                                        095320
        RETURN                                                          095330
C                                                                       095340
200     IF(PRSA.NE.FRSTQW) GO TO 300                                    095350
        THIEFP=PROB(20)                                                 095360
        RETURN                                                          095370
C                                                                       095380
300     IF(PRSA.NE.OUTXW) GO TO 400                                     095390
        THFACT=.FALSE.                                                  095400
        ODESC1(THIEF)=504                                               095410
        OFLAG1(STILL)=AND(OFLAG1(STILL),COMPL(VISIBT))                  095420
        OFLAG1(CHALI)=OR(OFLAG1(CHALI),TAKEBT)                          095430
        RETURN                                                          095440
C                                                                       095450
400     IF(PRSA.NE.INXW) GO TO 500                                      095460
        IF(QHERE(THIEF,HERE)) CALL RSPEAK(505)                          095470
        THFACT=.TRUE.                                                   095480
        ODESC1(THIEF)=503                                               095490
        OFLAG1(STILL)=OR(OFLAG1(STILL),VISIBT)                          095500
        IF((HERE.EQ.TREAS).AND.QHERE(CHALI,HERE))                       095510
     1       OFLAG1(CHALI)=AND(OFLAG1(CHALI),COMPL(TAKEBT))             095520
        RETURN                                                          095530
C                                                                       095540
500     IF(PRSA.NE.TAKEW) GO TO 600                                     095550
        CALL RSPEAK(506)                                                095560
        RETURN                                                          095570
C                                                                       095580
600     IF((PRSA.NE.THROWW).OR.(PRSO.NE.KNIFE).OR.                      095590
     1       (AND(OFLAG2(THIEF),FITEBT).NE.0)) GO TO 700                095600
        IF(PROB(10)) GO TO 650                                          095610
        CALL RSPEAK(507)                                                095620
        OFLAG2(THIEF)=OR(OFLAG2(THIEF),FITEBT)                          095630
        RETURN                                                          095640
C                                                                       095650
650     J=508                                                           095660
        DO 675 I=1,OLNT                                                 095670
          IF(OADV(I).NE.-THIEF) GO TO 675                               095680
          J=509                                                         095690
          CALL NEWSTA(I,0,HERE,0,0)                                     095700
675     CONTINUE                                                        095710
        CALL NEWSTA(THIEF,J,0,0,0)                                      095720
        RETURN                                                          095730
C                                                                       095740
700     IF((PRSA.NE.THROWW).AND.(PRSA.NE.GIVEW).OR.                     095750
     1       (PRSO.EQ.THIEF)) GO TO 10                                  095760
        IF(OCAPAC(THIEF).GE.0) GO TO 750                                095770
        OCAPAC(THIEF)=-OCAPAC(THIEF)                                    095780
        THFACT=.TRUE.                                                   095790
        OFLAG1(STILL)=OR(OFLAG1(STILL),VISIBT)                          095800
        ODESC1(THIEF)=503                                               095810
        CALL RSPEAK(510)                                                095820
C                                                                       095830
750     IF((PRSO.NE.BRICK).OR.(OCAN(FUSE).NE.BRICK).OR.                 095840
     1       (CTICK(CEVFUS).EQ.0)) GO TO 800                            095850
        CALL RSPEAK(511)                                                095860
        RETURN                                                          095870
C                                                                       095880
800     CALL NEWSTA(PRSO,0,0,0,-THIEF)                                  095890
        CALL RSPSUB(512,ODESC2(PRSO))                                   095900
        RETURN                                                          095910
C                                                                       095920
10      THIEFP=.FALSE.                                                  095930
        RETURN                                                          095940
        END
          IDENT  RIO                                                    095960
          SYSCOM             DEFINE RA. SYMBOLS                         000120
          ENTRY  CLOSE       CLOSE RANDOM DATA BASE FILE                095970
          ENTRY  RDR         READ RANDOM RECORD FROM DATA BASE          095980
          ENTRY  OPEN        OPEN RANDOM DATA BASE FILE                 095990
          ENTRY  WRR         WRITE EOR AND SET ADDRESS OF INDEX         096000
          ENTRY  WRI         WRITE DATA TO RANDOM DATA BASE FILE        096010
          ENTRY  RNL         READ NEXT LINE FROM DATA BASE              096020
                                                                        096030
 TAPE2    RFILEC BUF,101B,FET=15                                        096040
 CLOSE    BSS    1           CALL CLOSE(UNIT)                           096050
          SX6    0                                                      096060
          EQ     COM                                                    096070
 OPEN     BSS    1           CALL OPEN(UNIT)                            096080
          SX6    1                                                      096090
          EQ     COM                                                    096100
 WRR      BSS    1           CALL WRR(UNIT,INDEX ADDRESS)               096110
          SX6    2                                                      096120
          EQ     COM                                                    096130
 WRI      BSS    1           CALL WRI(UNIT,FWA,LEN)                     096140
          SX6    3                                                      096150
          EQ     COM                                                    096160
 RDR      BSS    1           CALL RDR(UNIT,FWA,LEN,PRU,EOF)             096170
          SX6    4                                                      096180
          EQ     COM                                                    096190
 RNL      BSS    1           CALL RNL(UNIT,FWA,LEN,EOF)                 096200
          SX6    5                                                      096210
          EQ     COM                                                    096220
                                                                        096230
 COM      SA6    SAVO        SAVE ORDINAL                               096240
          SB1    1                                                      096250
          SX6    A1                                                     096260
          SA6    ARGP                                                   096270
          RECALL TAPE2                                                  096280
          SA1    SAVO                                                   096290
          SB7    X1                                                     096300
          JP     TBL+B7                                                 096310
                                                                        096320
 TBL      EQ     CLOP                                                   096330
          EQ     OPEP                                                   096340
          EQ     WRRP                                                   096350
          EQ     WRIP                                                   096360
          EQ     RDRP                                                   096370
          EQ     RNLP                                                   096380
                                                                        096390
 CLOP     BSS    0                                                      096400
          WRITER TAPE2,RCL
          EQ     CLOSE                                                  096420
 OPEP     OPEN   TAPE2,WRITE,R                                          096430
          SA1    TAPE2+1
          MX0    -1
          LX0    47-0
          BX6    -X0+X1      SET RANDOM BIT
          SA6    A1
          EQ     OPEN                                                   096440
 WRRP     BSS    0                                                      096450
          WRITER TAPE2,RCL
          SA1    TAPE2+1                                                096470
          SX6    X1                                                     096480
          SA6    A1+B1                                                  096490
          SA6    A6+B1       EMPTY BUFFER                               096500
          SA1    ARGP                                                   096510
          SA1    X1+B1                                                  096520
          BX6    X1                                                     096530
          SA6    TAPE2+6     SET ADDRESS FOR RETURN OF RSA              096540
          EQ     WRR                                                    096550
 WRIP     SA4    ARGP                                                   096560
          SA3    X4+B1                                                  096570
          SA5    X4+2                                                   096580
          SA5    X5                                                     096590
          WRITES TAPE2,X3,X5                                            096600
          EQ     WRI                                                    096610
 RDRP     SA1    ARGP                                                   096620
          SA2    X1+B1       (X2) = ADDR OF FWA                         096630
          SA3    A2+B1       (X3) = ADDR OF LEN                         096640
          SA4    A3+B1       (X4) = ADDR OF RECORD NUMBER               096650
          SA4    X4          (X4) = RECORD NUMBER                       096660
          BX6    X4                                                     096670
          SA6    TAPE2+6     SET RANDOM ADDRESS IN FET                  096680
          SA1    TAPE2+1                                                096690
          SX6    X1                                                     096700
          SA6    A1+B1       IN = FIRST                                 096710
          SA6    A6+B1       OUT = FIRST                                096720
          READ   TAPE2,R                                                096730
          SA1    ARGP                                                   096740
          SA2    X1+B1       (X2) ADDR OF FWA                           096750
          SA3    A2+B1       (X3) = ADDR OF LEN                         096760
          SA3    X3          (X3) = NUMBER OF CAHRS                     096770
          READS  TAPE2,X2,X3                                            096780
      SA2 ARGP                                                          096790
          SA2 X2+4   (X2) = ADDR OF IEOF                                096800
          BX6 X1                                                        096810
          SA6 X2     RETURN STATUS OF READ (EOF)                        096820
          EQ     RDR                                                    096830
 RNLP     SA1    ARGP        (X1) = ADDR OF UNIT NUMBER                 096840
          SA2    X1+B1       (X2) = ADDR OF ARRAY                       096850
          SA3    A2+B1       (X3) = ADDR OF LEN                         096860
          SA3    X3          (X3) = LEN                                 096870
          READS  TAPE2,X2,X3 READ NEXT LINE                             096880
          SA2    ARGP                                                   096890
          SA2    X2+3        (X2) = ADDR OF IEOF                        096900
          BX6    X1                                                     096910
          SA6    X2                                                     096920
          EQ     RNL                                                    096930
 BUF      BSS    101B                                                   096940
 SAVO     BSS    1                                                      096950
 ARGP     BSS    1                                                      096960
 COMCLIB  XTEXT  COMCRDS                                                096970
 COMCLIB  XTEXT  COMCWTS                                                096980
 COMCLIB  XTEXT  COMCRDW                                                096990
 COMCLIB  XTEXT  COMCWTW                                                097000
          END                                                           097010
          IDENT  CONCAT                                                 097020
          ENTRY  CONCAT                                                 097030
 CONCAT   BSS    1                                                      097040
      MX6 24                                                            097050
      BX6 -X6                                                           097060
          EQ     CONCAT                                                 097070
          END                                                           097080
      INTEGER FUNCTION EQUIV (A, B)
      IMPLICIT INTEGER (A-Z)                                            097100
      EQUIV = COMPL( XOR(A,B) )                                         097110
      RETURN                                                            097120
      END
      SUBROUTINE PRS
        IMPLICIT INTEGER (A-Z)                                          097150
      LOGICAL INIT                                                      097160
      COMMON /PRS/INIT                                                  097170
C INIT-- DUNGEON INITIALIZATION SUBROUTINE                              097180
C                                                                       097190
C DECLARATIONS                                                          097200
C                                                                       097210
        INTEGER LINE(170),SDIR(16),CDIR(16)                             000750
C                                                                       097230
C PARSER OUTPUT                                                         097240
C                                                                       097250
        LOGICAL PRSWON                                                  097260
        COMMON /PRSVEC/ PRSA,PRSI,PRSO,PRSWON,PRSCON                    097270
C                                                                       097280
C PARSER STATE                                                          097290
C                                                                       097300
        COMMON /ORPHS/ OFLAG,OACT,OSLOT,OPREP,ONAME                     097310
        COMMON /LAST/ LASTIT                                            097320
C                                                                       097330
C GAME STATE                                                            097340
C                                                                       097350
        LOGICAL TELFLG                                                  097360
        COMMON /PLAY/ WINNER,HERE,TELFLG                                097370
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               097380
     1       LTSHFT,BLOC,MUNGRM,HS                                      097390
C                                                                       097400
C MESSAGE INDEX                                                         097410
C                                                                       097420
        COMMON /RMSG/ MLNT,RTEXT(800)                                   097430
C                                                                       097440
C MISCELLANEOUS VARIABLES                                               097450
C                                                                       097460
        COMMON /STAR/ MBASE,STRBIT                                      097470
        COMMON /VERS/ VMAJ,VMIN,VEDIT                                   097480
