     5    "BRAIDE",101,
     6    "GAUDY",108,"SQUARE",109,127,"CLAY",109,
     7    "SHINY",110,"THIN",110,
     8    "GREEN",115,143,"PURPLE",116,"WHITE",117,
     9    "MARBLE",119,"COKE",121,
