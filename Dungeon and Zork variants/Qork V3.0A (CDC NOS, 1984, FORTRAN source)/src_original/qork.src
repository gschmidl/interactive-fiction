        READ (*,490,END=10011)CFLAG(J)
10011   GO TO 2000
C                                                                       037000
C AX-- ALTER EXITS                                                      037010
C                                                                       037020
36000   IF(.NOT.VALID1(J,XLNT)) GO TO 2200                              037030
        PRINT 610,TRAVEL(J)                                             037040
        READ (*,620,END=10012)TRAVEL(J)
10012   GO TO 2000
