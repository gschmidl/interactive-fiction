        DO 70 I=1,AMAX                                                  099580
          AROOM(I)=0                                                    099590
          ASCORE(I)=0                                                   099600
          AVEHIC(I)=0                                                   099610
          AOBJ(I)=0                                                     099620
          AACTIO(I)=0                                                   099630
          ASTREN(I)=0                                                   099640
          AFLAG(I)=0                                                    099650
70      CONTINUE                                                        099660
C                                                                       099670
        RVMNT=0                                                         099680
        RVCLR=0                                                         099690
        RVCYC=0                                                         099700
        RVSND=0                                                         099710
        RVGUA=0                                                         099720
C                                                                       099730
        DBGFLG=0                                                        099740
        PRSFLG=0                                                        099750
      CALL SSWTCH(1,I)                                                  099760
      GOTO (1600,75),I
      CALL GOTOER
C                                                                       099780
C       CALL SPINIT(EXTRA)                                              099790
C INIT, PAGE 3A                                                         099800
C                                                                       099810
C NOW SEE IF WE CAN RESTORE FROM EXISTING INDEX FILE.                   099820
C                                                                       099830
C       CHANGE(1,TITLE=IDAT,FILETYPE=7,MYUSE=IN)                        099840
C       INQUIRE(1,PRESENT=THERE)                                        099850
C       IF(.NOT.THERE)GO TO 75                                          099860
C     1       MODE="IMAGE",ERR=75)                                      099870
C       READ(1) I,J,K                                                   099880
C       IF((I.NE.VMAJ).OR.(J.NE.VMIN))                                  099890
C    1       GO TO 170                                                  099900
C                                                                       099910
C       CHANGE(DBCH,TITLE=IDDAT,FILETYPE=7,MYUSE=IN)                    099920
C       INQUIRE(DBCH,PRESENT=THERE)                                     099930
C       IF(.NOT.THERE)GO TO 170                                         099940
C     1       MODE="IMAGE",ACCESS="RANDIN",                             099950
C     2       RECORDSIZE=80,DISPOSE="SAVE",ERR=170)                     099960
C                                                                       099970
C       PRINT 150                                                       099980
C150    FORMAT(" RESTORING FROM 'DINDX.DAT'")                           099990
C       READ(1) MXSCOR,STRBIT                                           100000
C       READ(1) RLNT,RDESC1,RDESC2,REXIT,RACTIO,RVAL,RFLAG,RRAND        100010
C       READ(1) XLNT,TRAVEL                                             100020
C       READ(1) OLNT,ODESC1,ODESC2,ODESCO,OACTIO,OFLAG1,OFLAG2,         100030
C    1       OFVAL,OTVAL,OSIZE,OCAPAC,OROOM,OADV,OCAN,                  100040
C    2       OREAD,ORAND                                                100050
C       READ(1) R2LNT,O2,R2                                             100060
C       READ(1) CLNT,CTICK,CACTIO,CFLAG                                 100070
C       READ(1) VLNT,VILLNS,VPROB,VOPPS                                 100080
C       READ(1) ALNT,AROOM,ASCORE,AVEHIC,AOBJ,AACTIO,ASTREN,AFLAG       100090
C       READ(1) MBASE,MLNT,RTEXT                                        100100
C                                                                       100110
C       CLOSE(1,DISP=KEEP)                                              100120
C       GO TO 1025                                                      100130
C                                                                       100140
C INDEX FILE IS OBSOLETE, OR                                            100150
C DB FILE IS NOT AVAILABLE.                                             100160
C KILL INDEX FILE AND START AGAIN.                                      100170
C                                                                       100180
CC170     CLOSE(1,DISP=DELETE)                                          100190
CC INIT, PAGE 4                                                         100200
CC                                                                      100210
CC NOW START DATA BASE FILE PROCESSING.                                 100220
CC                                                                      100230
C75      CHANGE (1,TITLE=TXT,FILETYPE=7,MYUSE=IN)                       100240
C        INQUIRE(1,PRESENT=THERE)                                       100250
C        IF(.NOT.THERE)GO TO 1900                                       100260
C        CHANGE(DBCH,TITLE=DDAT,MAXRECSIZE=80,FLEXIBLE=.TRUE.,          100270
C     1  BLOCKSIZE=8000,AREASIZE=200,AREAS=5,MYUSE=OUT)                 100280
CC       OPEN (UNIT=DBCH,FILE="DTEXT.DAT",ACCESS="SEQOUT",              100290
CC       1       MODE="IMAGE")                                          100300
CC       CLOSE (UNIT=DBCH,DISPOSE="SAVE")                               100310
CC                                                                      100320
CC       OPEN (DBCH,TITLE=DDAT)                                         100330
CC     1       MODE="IMAGE",ACCESS="RANDOM",RECORDSIZE=80,              100340
CC     2       DISPOSE="SAVE",ERR=1950)                                 100350
CC                                                                      100360
   75 CONTINUE                                                          100370
        PRINT 185                                                       100380
 185    FORMAT(' CREATING NEW ''DTEXT.DAT''')
      CALL OPEN (2)                                                     100400
C                                                                       100410
C RETURN HERE TO READ NEXT SECTION HEADER.                              100420
C                                                                       100430
80      CALL READJL(I,LINE)                                             100440
C      PRINT 90,I,LINE                                                  100450
C90     FORMAT(I3,1X,78R1)                                              100460
C                                                                       100470
        IF(I.EQ.0) GO TO 80                                             100480
        IF(I.LT.0) GO TO 1000                                           100490
C       PRINT 125,I                                                     100500
C125    FORMAT(" INITIALIZING SECTION #",I4)                            100510
        IF(I.LE.8) GO TO 100                                            100520
        GO TO (400,500,600,700,800,900),(I-8)
      CALL GOTOER
C        CALL BUG(12,I)                                                 100540
C                                                                       100550
C TEXT SECTION.  WRITE TEXT OUT TO DB FILE, NOTE INITIAL RECORD         100560
C NUMBER IN APPROPRIATE ARRAY.                                          100570
C                                                                       100580
100     PREVJ=0                                                         100590
110     CALL READJL(J,LINE)                                             100600
C     PRINT 90,J,LINE                                                   100610
        IF(J.EQ.0) GO TO 110                                            100620
        IF(J.LT.0) GO TO 80                                             100630
        IF(J.EQ.PREVJ) GO TO 300                                        100640
        GO TO (210,220,230,240,250,260,270,280),I
      CALL GOTOER
C        CALL BUG(12,I)                                                 100660
C                                                                       100670
C SECTION 1-- RANDOM REMARKS.                                           100680
C                                                                       100690
C210     IF(J.GT.MMAX) CALL BUG(13,J)                                   100700
  210 CONTINUE                                                          100710
C        IF(RTEXT(J).NE.0) CALL BUG(14,J)                               100720
          CALL   WRR(2,RTEXT(J))                                        100730
        MBASE=MAX0(MBASE,J)                                             100740
        GO TO 300                                                       100750
C                                                                       100760
C SECTION 2-- MELEE MESSAGES                                            100770
C                                                                       100780
220     K=J+MBASE                                                       100790
C        IF(K.GT.MMAX) CALL BUG(13,K)                                   100800
C        IF(RTEXT(K).NE.0) CALL BUG(14,K)                               100810
          CALL   WRR(2,RTEXT(K))                                        100820
        MLNT=MAX0(MLNT,K)                                               100830
        GO TO 300                                                       100840
C                                                                       100850
C SECTION 3-- LONG ROOM DESCRIPTIONS                                    100860
C                                                                       100870
C230     IF(J.GT.RMAX) CALL BUG(15,J)                                   100880
  230 CONTINUE                                                          100890
C        IF(RDESC1(J).NE.0) CALL BUG(16,J)                              100900
      CALL WRR(2,RDESC1(J))                                             100910
        GO TO 300                                                       100920
C                                                                       100930
C SECTION 4-- SHORT ROOM DESCRIPTIONS                                   100940
C                                                                       100950
C240     IF(J.GT.RMAX) CALL BUG(17,J)                                   100960
  240 CONTINUE                                                          100970
C        IF(RDESC2(J).NE.0) CALL BUG(18,J)                              100980
      CALL WRR(2,RDESC2(J))                                             100990
        GO TO 300                                                       101000
C                                                                       101010
C SECTION 5-- LONG OBJECT DESCRIPTIONS                                  101020
C                                                                       101030
C250     IF(J.GT.OMAX) CALL BUG(19,J)                                   101040
  250 CONTINUE                                                          101050
C        IF(ODESC1(J).NE.0) CALL BUG(20,J)                              101060
      CALL WRR(2,ODESC1(J))                                             101070
        GO TO 300                                                       101080
C                                                                       101090
C SECTION 6-- SHORT OBJECT DESCRIPTIONS                                 101100
C                                                                       101110
C260     IF(J.GT.OMAX) CALL BUG(21,J)                                   101120
  260 CONTINUE                                                          101130
C        IF(ODESC2(J).NE.0) CALL BUG(22,J)                              101140
      CALL WRR(2,ODESC2(J))                                             101150
        GO TO 300                                                       101160
C                                                                       101170
C SECTION 7-- UNTOUCHED OBJECT DESCRIPTIONS                             101180
C                                                                       101190
C270     IF(J.GT.OMAX) CALL BUG(23,J)                                   101200
  270 CONTINUE                                                          101210
C        IF(ODESCO(J).NE.0) CALL BUG(24,J)                              101220
      CALL WRR(2,ODESCO(J))                                             101230
        GO TO 300                                                       101240
C                                                                       101250
C SECTION 8-- READING MATERIAL                                          101260
C                                                                       101270
C280     IF(J.GT.OMAX) CALL BUG(25,J)                                   101280
  280 CONTINUE                                                          101290
C        IF(OREAD(J).NE.0) CALL BUG(26,J)                               101300
      CALL WRR(2,OREAD(J))                                              101310
        GO TO 300                                                       101320
C                                                                       101330
C HERE TO WRITE OUT CURRENT LINE OF TEXT.                               101340
C                                                                       101350
  300 CONTINUE                                                          101360
      CALL WRI(2,LINE,170)                                              000770
        PREVJ=J                                                         101380
        GO TO 110                                                       101390
C INIT, PAGE 5                                                          101400
C                                                                       101410
C SECTION 9-- ROOM DATA                                                 101420
C                                                                       101430
400     CALL READJL(J,LINE)                                             101440
        IF(J.LT.0) GO TO 80                                             101450
        IF(J.EQ.0) GO TO 400                                            101460
C        IF(J.GT.RMAX) CALL BUG(28,J)                                   101470
        RLNT=MAX0(RLNT,J)                                               101480
C                                                                       101490
        CALL RDRMNM(RACTIO(J),RVAL(J),RFLAG(J))                         101500
C425    FORMAT(2(I3,1X),O5,1X,I3)                                       101510
        MXSCOR=MXSCOR+RVAL(J)                                           101520
        PREVX=0                                                         101530
C                                                                       101540
C HERE TO LOOP ON EXIT DESCRIPTIONS                                     101550
C                                                                       101560
405     CALL RDEXIT(DIR,XTYPE,XROOM1)                                   101570
C     PRINT 415 ,DIR,XTYPE,XROOM1                                       101580
C415    FORMAT(A2,2(I3,1X))                                             101590
        IF(DIR.EQ."  ") GO TO 400                                       101600
        DO 410 K=1,DIRMAX                                               101610
          IF(DIR.EQ.SDIR(K)) GO TO 420                                  101620
410     CONTINUE                                                        101630
C        CALL BUG(29,DIR)                                               101640
C                                                                       101650
C HAVE TRANSLATED DIRECTION, VALIDATE OTHER FIELDS.                     101660
C                                                                       101670
C420     IF((XTYPE.LE.0).OR.(XTYPE.GT.(XFMASK+1))) CALL BUG(30,XTYPE)   101680
  420 CONTINUE                                                          101690
C        IF(XROOM1.GT.RMAX) CALL BUG(31,XROOM1)                         101700
        IF(REXIT(J).EQ.0) REXIT(J)=XLNT                                 101710
C        IF((XLNT+XELNT(XTYPE)).GT.XMAX) CALL BUG(32,XLNT)              101720
        TRAVEL(XLNT)=-(CDIR(K)+((XTYPE-1)*XFSHFT)+XROOM1+XLFLAG)        101730
        IF(PREVX.NE.0) TRAVEL(PREVX)=(TRAVEL(PREVX)+XLFLAG)             101740
        GO TO (480,470,460,450),XTYPE
      CALL GOTOER
C        CALL BUG(30,XTYPE)                                             101760
C                                                                       101770
C DOOR ENTRY-- READ OBJECT,APPLICABLE,STRING                            101780
C                                                                       101790
450     CALL RDOAL(XOBJ,XACTIO,LINE)                                    101800
C455    FORMAT(2(I3,1X),78A1)                                           101810
C        IF((XOBJ.LE.0).OR.(XOBJ.GT.OMAX)) CALL BUG(34,XOBJ)            101820
        GO TO 468                                                       101830
C                                                                       101840
C CONDITIONAL EXIT ENTRY-- READ FLAG,APPLICABLE,STRING                  101850
C                                                                       101860
460     CALL RDOAL(XOBJ,XACTIO,LINE)                                    101870
C465    FORMAT(2(I3,1X),78A1)                                           101880
C        IF((XOBJ.LE.0).OR.(XOBJ.GT.FMAX)) CALL BUG(35,XOBJ)            101890
468     TRAVEL(XLNT+2)=-((XACTIO*XASHFT)+XOBJ)                          101900
        GO TO 478                                                       101910
C                                                                       101920
C NO EXIT ENTRY-- READ STRING                                           101930
C                                                                       101940
470     READ(1,475,END=  478) LINE
475     FORMAT(BZ,170R1)
  478 IF(LINE(1) .EQ. R" ")GOTO 480
      IFROG = XLNT+1                                                    101980
      CALL WRR(2,TRAVEL(IFROG))                                         101990
      CALL WRI(2,LINE,170)                                              000810
C                                                                       102010
C COMMON PROCESSING, ADVANCE OVER ENTRY.                                102020
C                                                                       102030
480     PREVX=XLNT                                                      102040
        XLNT=XLNT+XELNT(XTYPE)                                          102050
        GO TO 405                                                       102060
C INIT, PAGE 6                                                          102070
C SECTION 11-- GLOBAL OBJECTS                                           102080
C SECTION 10-- NORMAL OBJECTS                                           102090
C                                                                       102100
  600 CALL READJL(J,LINE)                                               000260
      STRBIT = J                                                        000270
      GOTO 505                                                          000280
500     CALL READJL(J,LINE)                                             102120
  505 IF (J .LT. 0) GOTO 80                                             000300
        IF(J.EQ.0) GO TO 500                                            102140
C        IF(J.GT.OMAX) CALL BUG(27,J)                                   102150
        OLNT=MAX0(OLNT,J)                                               102160
C                                                                       102170
        CALL RDOBJS(OROOM(J),K,OCAN(J),OACTIO(J),OFLAG1(J),             102180
     1       OFLAG2(J),OFVAL(J),OTVAL(J),OSIZE(J),OCAPAC(J),            102190
     2       ORAND(J))                                                  102200
C560    FORMAT(4(I8,1X),2(O8,1X),5(I8,1X))                              102210
C                                                                       102220
        MXSCOR=MXSCOR+OFVAL(J)+OTVAL(J)                                 102230
C                                                                       102240
        IF(K.EQ.0) GO TO 500                                            102250
        R2LNT=R2LNT+1                                                   102260
C        IF(R2LNT.GT.R2MAX) CALL BUG(33,R2LNT)                          102270
        O2(R2LNT)=J                                                     102280
        R2(R2LNT)=K                                                     102290
        GO TO 500                                                       102300
C                                                                       102310
C SECTION 12-- VILLAINS                                                 102320
C                                                                       102330
700     CALL READJL(J,LINE)                                             102340
        IF(J.LT.0) GO TO 80                                             102350
        IF(J.EQ.0) GO TO 700                                            102360
        VLNT=VLNT+1                                                     102370
C        IF(VLNT.GT.VMAX) CALL BUG(36,VLNT)                             102380
        VILLNS(VLNT)=J                                                  102390
        GO TO 700                                                       102400
C                                                                       102410
C SECTION 13-- CLOCK EVENTS                                             102420
C                                                                       102430
800     CALL READJL(J,LINE)                                             102440
        IF(J.LT.0) GO TO 80                                             102450
        IF(J.EQ.0) GO TO 800                                            102460
C        IF(J.GT.CMAX) CALL BUG(37,J)                                   102470
        CLNT=MAX0(CLNT,J)                                               102480
C                                                                       102490
        CALL RDCLOK(CACTIO(J),CTICK(J),CFLAG(J))                        102500
C890    FORMAT(2(I3,1X),L1)                                             102510
        GO TO 800                                                       102520
C                                                                       102530
C SECTION 14-- ADVENTURERS                                              102540
C                                                                       102550
900     CALL READJL(J,LINE)                                             102560
        IF(J.LT.0) GO TO 80                                             102570
        IF(J.EQ.0) GO TO 900                                            102580
C        IF(J.GT.AMAX) CALL BUG(38,J)                                   102590
        ALNT=MAX0(ALNT,J)                                               102600
C                                                                       102610
        CALL RDADVS(AROOM(J),AOBJ(J),AACTIO(J),ASTREN(J))               102620
C990    FORMAT(4(I3,1X))                                                102630
        GO TO 900                                                       102640
C INIT, PAGE 7                                                          102650
C                                                                       102660
C INITIALIZATION IS COMPLETE.                                           102670
C WRITE OUT NEW INDEX FILE FOR NEXT TIME AROUND.                        102680
C                                                                       102690
 1000 CALL CLOSE(2)                                                     102700
C       CLOSE(DBCH,DISP=CRUNCH)                                         102710
C       CHANGE (1,TITLE=DAT,MAXRECSIZE=3000,FLEXIBLE=.TRUE.,            102720
C     1 BLOCKSIZE=3000,AREASIZE=1,AREAS=9,UNITS=0,MYUSE=OUT)            102730
CC       INQUIRE(1,PRESENT=THERE)                                       102740
CC       IF(.NOT.THERE)GO TO 1025                                       102750
C       PRINT 1005                                                      102760
C1005   FORMAT(" CREATING NEW 'DINDX.DAT'")                             102770
CC                                                                      102780
C        WRITE(1,DATA=1900) VMAJ,VMIN,VEDIT                             102790
C        WRITE(1,DATA=1900) MXSCOR,STRBIT                               102800
C        WRITE(1,DATA=1900) RLNT,RDESC1,RDESC2,REXIT,RACTIO,RVAL,       102810
C     1 RFLAG,RRAND                                                     102820
C        WRITE(1,DATA=1900) XLNT,TRAVEL                                 102830
C        WRITE(1,DATA=1900) OLNT,ODESC1,ODESC2,ODESCO,OACTIO,           102840
C     1   OFLAG1,OFLAG2,OFVAL,OTVAL,OSIZE,OCAPAC,OROOM,OADV,OCAN,       102850
C     2       OREAD,ORAND                                               102860
C        WRITE(1,DATA=1900) R2LNT,O2,R2                                 102870
C        WRITE(1,DATA=1900) CLNT,CTICK,CACTIO,CFLAG                     102880
C        WRITE(1,DATA=1900) VLNT,VILLNS,VPROB,VOPPS                     102890
C        WRITE(1,DATA=1900) ALNT,AROOM,ASCORE,AVEHIC,AOBJ,AACTIO,ASTREN,102900
C     1 AFLAG                                                           102910
C        WRITE(1,DATA=1900) MBASE,MLNT,RTEXT                            102920
CC                                                                      102930
C        CLOSE (1,DISP=CRUNCH)                                          102940
1025    CONTINUE                                                        102950
C INIT, PAGE 8                                                          102960
C                                                                       102970
C THE INTERNAL DATA BASE IS NOW ESTABLISHED.                            102980
C SET UP TO PLAY THE GAME.                                              102990
C                                                                       103000
C       CALL IDATE(I,J,K)                                               103010
C       CALL SETRAN((I*J*K).XOR.(SHOUR*SMIN*SSEC))                      103020
C                                                                       103030
        WINNER=PLAYER                                                   103040
        THFPOS=OROOM(THIEF)                                             103050
        BLOC=OROOM(BALLO)                                               103060
        HERE=AROOM(WINNER)                                              103070
        LASTIT=AOBJ(PLAYER)                                             103080
        INIT=.TRUE.                                                     103090
C                                                                       103100
C       PRINT 1050,RLNT,RMAX,XLNT,XMAX,OLNT,OMAX,MLNT,MMAX,             103110
C       1       VLNT,VMAX,ALNT,AMAX,CLNT,CMAX,R2LNT,R2MAX               103120
C1050   FORMAT(" USED:"/1X,I5," OF",I5," ROOMS"/                        103130
C       11X,I5," OF",I5," EXITS"/                                       103140
C       21X,I5," OF",I5," OBJECTS"/                                     103150
C       31X,I5," OF",I5," MESSAGES"/                                    103160
C       41X,I5," OF",I5," VILLAINS"/                                    103170
C       51X,I5," OF",I5," ADVENTURERS"/                                 103180
C       61X,I5," OF",I5," CLOCK EVENTS"/                                103190
C       71X,I5," OF",I5," ROOM2 SLOTS")                                 103200
C       PRINT 1150,MXSCOR,RECNO,MBASE,STRBIT                            103210
C1150   FORMAT(" MAX SCORE=",I5/" MAX RECNO=",I5/                       103220
C       1" MELEE START=",I5/" STAR MASK=",I7)                           103230
C       PAUSE 1                                                         103240
C                                                                       103250
C     COMPLEMENT APPROPRIATE ARRAYS TO INDICATE TO *RSPEAK* THAT        103260
C     WE HAVE AN ACTUAL DISK ADDRESS (RSA) FOR HIM.  POSITIVE           103270
C     NUMBERS INDICATE AN ACTUAL MESSAGE NUMBER...                      103280
C                                                                       103290
      DO 1501 I = 1, MMAX                                               103300
 1501 RTEXT(I) = - RTEXT(I)                                             103310
      DO 1502 I = 1, RMAX                                               103320
      RDESC1(I) = - RDESC1(I)                                           103330
 1502 RDESC2(I) = - RDESC2(I)                                           103340
      DO 1503 I = 1, OMAX                                               103350
      ODESC1(I) = - ODESC1(I)                                           103360
      ODESC2(I) = - ODESC2(I)                                           103370
      ODESCO(I) = - ODESCO(I)                                           103380
 1503 OREAD(I) = - OREAD(I)                                             103390
      DO 1504 I = 1, XMAX                                               103400
      IF(TRAVEL(I) .EQ. 0) GOTO 1504                                    103410
      TRAVEL(I) = - TRAVEL(I)                                           103420
 1504 CONTINUE                                                          103430
C                                                                       103440
      CALL SAVEGM                                                       103450
      CALL EXIT                                                         103460
C                                                                       103470
 1600 CONTINUE                                                          103480
      CALL RSTRGM                                                       103490
      INIT = .TRUE.                                                     103500
        RETURN                                                          103510
C                                                                       103520
C ERRORS-- INIT FAILS.                                                  103530
C                                                                       103540
1900    PRINT 910                                                       103550
        RETURN                                                          103560
1950    PRINT 960                                                       103570
        RETURN                                                          103580
910     FORMAT(' I CAN"T OPEN ''DTEXT.TXT''.')
960     FORMAT(' I CAN"T OPEN ''DTEXT.DAT''.')
C                                                                       103610
        END                                                             103620
      INTEGER FUNCTION NUMBR(IN,I,BASE)
      INTEGER IN(172),I,BASE                                            000830
      INTEGER COMMA, BLANK                                              103650
      INTEGER NUMS(10)                                                  103660
      DATA NUMS/R"0",R"1",R"2",R"3",R"4",R"5",R"6",R"7",R"8",R"9"/
      DATA COMMA,BLANK/R",",R" "/
      NUMBR=0                                                           103690
      IF (I.GT.172) RETURN                                              000850
      DO 10 I=I,172                                                     000870
10    IF (IN(I).NE.BLANK) GO TO 20                                      103720
      RETURN                                                            103730
20    DO 40 I=I,172                                                     000890
      J=IN(I)                                                           103750
      DO 30 K=1,10                                                      103760
30    IF (J.EQ.NUMS(K)) GO TO 40                                        103770
      GO TO 50                                                          103780
40    NUMBR=NUMBR*BASE+K-1                                              103790
50    DO 60 I=I,172                                                     000910
60    IF (IN(I).EQ.COMMA) GO TO 70                                      103810
70    I=I+1                                                             103820
      RETURN                                                            103830
      END                                                               103840
      SUBROUTINE READJL(J,LINE)
      INTEGER J,LINE(170)                                               000930
      INTEGER IN(172)                                                   000950
      INTEGER BLANK, MINUS                                              103880
      DATA BLANK, MINUS/R" ", R"-"/
      READ(1,99,END=10000)IN
99    FORMAT(BZ,172R1)
10000 IF (IN(1).NE.MINUS) GO TO 10
      J=-1                                                              103930
      RETURN                                                            103940
10    I=1                                                               103950
      J=NUMBR(IN,I,10)                                                  103960
      DO 20 K=1,170                                                     000990
20    LINE(K)=BLANK                                                     103980
      IF (I.GT.172) RETURN                                              001010
      K=0                                                               104000
      DO 30 I=I,172                                                     001030
      K=K+1                                                             104020
      IF (K.GT.170) RETURN                                              001050
30    LINE(K)=IN(I)                                                     104040
      RETURN                                                            104050
      END                                                               104060
      SUBROUTINE RDRMNM(RACT,RVAL,RFLG)
      INTEGER RACT,RVAL,RFLG                                            104080
      INTEGER IN(172)                                                   001070
      INTEGER NUMBR                                                     104100
      READ(1,99,END=10000)IN
99    FORMAT(BZ,172R1)
10000 I=1
      RACT=NUMBR(IN(1),I,10)
      RVAL=NUMBR(IN(1),I,10)
      RFLG=NUMBR(IN(1),I,8)
      RETURN                                                            104170
      END                                                               104180
      SUBROUTINE RDEXIT(DIR,XTYPE,XROOM1)
      INTEGER DIR,XTYPE,XROOM1                                          104200
      INTEGER IN(172)                                                   001110
      INTEGER BLANK                                                     104220
      INTEGER NUMBR                                                     104230
      DATA BLANK /R" "/
      READ(1,99,END=10000)DIR,(IN(I),I=1,170)
99    FORMAT(BZ,A2,170R1)
10000 IN(171)=BLANK
      IN(172)=BLANK                                                     001190
      I=1                                                               104290
      XTYPE =NUMBR(IN(1),I,10)
      XROOM1=NUMBR(IN(1),I,10)
      RETURN                                                            104320
      END                                                               104330
      SUBROUTINE RDOAL(XOBJ,XACTIO,LINE)
      INTEGER XOBJ,XACTIO,LINE(170)                                     001210
      INTEGER IN(172)                                                   001230
      INTEGER BLANK                                                     104370
      DATA BLANK/R" "/
      READ(1,99,END=10000)IN
99    FORMAT(BZ,172R1)
10000 DO 10 I=1,170
10    LINE(I)=BLANK                                                     104420
      I=1                                                               104430
      XOBJ=NUMBR(IN,I,10)                                               104440
      XACTIO=NUMBR(IN,I,10)                                             104450
      IF (I.GT.172) RETURN                                              001290
      J=0                                                               104470
      DO 20 I=I,172                                                     001310
      J=J+1                                                             104490
20    LINE(J)=IN(I)                                                     104500
      RETURN                                                            104510
      END                                                               104520
      SUBROUTINE RDOBJS(A,B,C,D,O,P,V,W,X,Y,Z)
      INTEGER A,B,C,D,O,P,V,W,X,Y,Z                                     104540
      INTEGER IN(172)                                                   001330
      READ(1,99,END=10000)IN
99    FORMAT(BZ,172R1)
10000 I=1
      A=NUMBR(IN,I,10)                                                  104590
      B=NUMBR(IN,I,10)                                                  104600
      C=NUMBR(IN,I,10)                                                  104610
      D=NUMBR(IN,I,10)                                                  104620
      O=NUMBR(IN,I,8)                                                   104630
      P=NUMBR(IN,I,8)                                                   104640
      V=NUMBR(IN,I,10)                                                  104650
      W=NUMBR(IN,I,10)                                                  104660
      X=NUMBR(IN,I,10)                                                  104670
      Y=NUMBR(IN,I,10)                                                  104680
      Z=NUMBR(IN,I,10)                                                  104690
      RETURN                                                            104700
      END                                                               104710
      SUBROUTINE RDCLOK(CACTIO,CTICK,CFLAG)
      INTEGER CACTIO,CTICK                                              104730
      LOGICAL CFLAG                                                     104740
      INTEGER IN(172)                                                   001370
      INTEGER BLANK, TRUE                                               104760
      DATA BLANK, TRUE/R" ", R"T"/
      READ(1,99,END=10000)IN
99    FORMAT(BZ,172R1)
10000 I=1
      CACTIO=NUMBR(IN,I,10)                                             104810
      CTICK =NUMBR(IN,I,10)                                             104820
      CFLAG=.FALSE.                                                     104830
      IF (I.GT.172) RETURN                                              001410
      DO 10 I=I,172                                                     001430
10    IF (IN(I).NE.BLANK) GO TO 20                                      104860
      RETURN                                                            104870
20    IF (IN(I).EQ.TRUE) CFLAG=.TRUE.                                   104880
      RETURN                                                            104890
      END                                                               104900
      SUBROUTINE RDADVS(AROOM,AOBJ,AACTIO,ASTREN)
      INTEGER AROOM,AOBJ,AACTIO,ASTREN                                  104920
      INTEGER IN(172)                                                   001450
      READ(1,99,END=10000)IN
99    FORMAT(BZ,172R1)
10000 I=1
      AROOM =NUMBR(IN,I,10)                                             104970
      AOBJ=NUMBR(IN,I,10)                                               104980
      AACTIO=NUMBR(IN,I,10)                                             104990
      ASTREN=NUMBR(IN,I,10)                                             105000
      RETURN                                                            105010
      END                                                               105020