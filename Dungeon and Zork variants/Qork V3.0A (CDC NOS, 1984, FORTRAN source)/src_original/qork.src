          VPROB(I)=0                                                    099210
          VILLNS(I)=0                                                   099220
30      CONTINUE                                                        099230
C                                                                       099240
C                                                                       099250
        DO 40 I=1,OMAX                                                  099260
          ODESC1(I)=0                                                   099270
          ODESC2(I)=0                                                   099280
          ODESCO(I)=0                                                   099290
          OREAD(I)=0                                                    099300
          OACTIO(I)=0                                                   099310
          OFLAG1(I)=0                                                   099320
          OFLAG2(I)=0                                                   099330
          OFVAL(I)=0                                                    099340
          OTVAL(I)=0                                                    099350
          OSIZE(I)=0                                                    099360
          OCAPAC(I)=0                                                   099370
          OCAN(I)=0                                                     099380
          OADV(I)=0                                                     099390
          OROOM(I)=0                                                    099400
          ORAND(I)=0                                                    099410
40      CONTINUE                                                        099420
C                                                                       099430
        DO 50 I=1,RMAX                                                  099440
          RDESC1(I)=0                                                   099450
          RDESC2(I)=0                                                   099460
          RACTIO(I)=0                                                   099470
          RFLAG(I)=0                                                    099480
          RVAL(I)=0                                                     099490
          RRAND(I)=0                                                    099500
          REXIT(I)=0                                                    099510
50      CONTINUE                                                        099520
