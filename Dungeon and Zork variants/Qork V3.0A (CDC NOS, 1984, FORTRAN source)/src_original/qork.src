     1       OACTIO(160),OFLAG1(160),OFLAG2(160),OFVAL(160),            051000
     2       OTVAL(160),OSIZE(160),OCAPAC(160),OROOM(160),              051010
     3       OADV(160),OCAN(160),OREAD(160),ORAND(160)                  051020
C                                                                       051030
        COMMON /OFLAGS/ VISIBT,READBT,TAKEBT,DOORBT,TRANBT,FOODBT,      051040
     1       NDSCBT,DRNKBT,CONTBT,LITEBT,VICTBT,BURNBT,FLAMBT,          051050
     2       TOOLBT,TURNBT,ONBT                                         051060
