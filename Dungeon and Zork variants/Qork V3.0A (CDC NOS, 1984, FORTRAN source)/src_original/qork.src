        COMMON /PLAY/ WINNER,HERE,TELFLG                                050850
        COMMON /STATE/ MOVES,DEATHS,RWSCOR,MXSCOR,MXLOAD,               050860
     1       LTSHFT,BLOC,MUNGRM,HS                                      050870
C                                                                       050880
C ROOMS                                                                 050890
