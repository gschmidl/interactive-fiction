C      AA       DDDDDDDDD     VV        VV  XX        XX   2222222222  C
C     AAAA      DDDDDDDDDD    VV        VV  XX        XX  222222222222 C
C    AA  AA     DD       DD   VV        VV   XX      XX   22        22 C
C   AA    AA    DD        DD  VV        VV    XX    XX              22 C
C  AA      AA   DD        DD  VV        VV     XX  XX               22 C
C AA        AA  DD        DD  VV        VV      XXXX               22  C
C AAAAAAAAAAAA  DD        DD   VV      VV       XXXX             22    C
C AAAAAAAAAAAA  DD        DD   VV      VV      XX  XX          22      C
C AA        AA  DD        DD     VV  VV       XX    XX       22        C
C AA        AA  DD       DD      VV  VV      XX      XX    22          C
C AA        AA  DDDDDDDDDD         VV       XX        XX  222222222222 C
C AA        AA  DDDDDDDDD          VV       XX        XX  222222222222 C
C                                                                      C
