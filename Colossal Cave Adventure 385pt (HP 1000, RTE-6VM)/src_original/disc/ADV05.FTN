C      AA       DDDDDDDDD     VV        VV    00000000    555555555555 C
C     AAAA      DDDDDDDDDD    VV        VV   0000000000   555555555555 C
C    AA  AA     DD       DD   VV        VV  00        00  55           C
C   AA    AA    DD        DD  VV        VV  00        00  55           C
C  AA      AA   DD        DD  VV        VV  00        00  55           C
C AA        AA  DD        DD  VV        VV  00        00  555555555    C
C AAAAAAAAAAAA  DD        DD   VV      VV   00        00  5555555555   C
C AAAAAAAAAAAA  DD        DD   VV      VV   00        00           55  C
C AA        AA  DD        DD     VV  VV     00        00            55 C
C AA        AA  DD       DD      VV  VV     00        00            55 C
C AA        AA  DDDDDDDDDD         VV        0000000000   555555555555 C
C AA        AA  DDDDDDDDD          VV         00000000    55555555555  C
C                                                                      C
C======================================================================C
