FTN4
      FUNCTION READQ(LU,XQ,N,IERR)
C
C     ROUTINE TO READ AND ASSEMBLE STRING XQ FROM KEYBOARD OR
C        PAPER TAPE INPUT LU.
C     A MAXIMUM OF IABS(N) CHARACTERS WILL BE RETURNED IN XQ
C     IF N>0 AND THE DEVICE IS DRIVEN BY DVR00 OR DVR05,
C             A "?" IS FIRST TRANSMITTED TO LU, AND INPUT CHARACTERS
C             ARE ECHOED BACK TO LU (E.G. KEYBOARD)
C     IF N<0, CHARACTERS ARE NOT ECHOED BACK (E.G. PAPER TAPE READER).
C     ON RETURN:
C        IERR=0   NORMAL RETURN
C            =1   >N CHARACTER WERE ENTERED (ONLY N CHARACTERS ARE
C                 ASSEMBLED INTO XQ, HOWEVER)
C            =-1  EOF (CNTL D ON KEYBOARD INPUT)
C            A&B REGISTERS RETURN NORMAL EXEC CALL INFORMATION
C                A=WORD 5 OF EQT
C                B=NUMBER OF CHARACTERS TRANSMITTED
C
C     ARW 4/76 UPDATED 4/77,7/77
C
      INTEGER XQ(1),IREG(2),QUES(2)
      EQUIVALENCE (REG,IREG)
      DATA QUES/2H?,2H_ /
      IERR=0
      XQ=0
      N1=IABS(N)
C     GET DEVICE TYPE TO DETERMINE EOF STATUS BIT
      CALL EXEC(13,LU,IEQT5)
      IEOF=200B
      IDEV=IAND(IEQT5,37400B)/256
      IF (IDEV .LT. 10B) IEOF=40B
      IECHO=0
      IF (N.LT.0.OR.(IDEV.NE.0.AND.IDEV.NE.5)) GO TO 90
      IECHO=400B
      CALL EXEC(2,LU,QUES,-3)
C     CALL REIO TO READ MAXIMUM OF N1 CHARACTERS INTO XQ.
90    REG=REIO(1,IECHO+LU,XQ(2),-N1)
      READQ=REG
      IF (IAND(IREG,IEOF) .EQ. 0) GO TO 95
      IERR=-1
      RETURN
95    NCHAR=IREG(2)
      IF (NCHAR .EQ. 0) RETURN
      IF (NCHAR .LE. N1) GO TO 100
      NCHAR=N1
      IERR=1
100   XQ=NCHAR
C     TRUNCATE ANY SUFFIX NULL CHARACTER
      IF (JASCQ(XQ,XQ) .EQ. 0) XQ=XQ-1
      RETURN
      END
C     SUBROUTINE WRITQ(LU,XQ)
      SUBROUTINE WRITQ(LU,XQ)
C
C     SUBROUTINE TO WRITE STRING XQ TO LOGICAL UNIT LU.
C
C     ARW 6/76
C
      INTEGER XQ(1)
      NC=XQ(1)
      IF (NC .LE. 0) RETURN
C     IF ODD # OF CHARACTERS, ADD A TRAILING NULL CHARACTER TO KEEP
C     TAPES AND DISCS, WHICH CAN ONLY READ & WRITE AN INTEGRAL
C     # OF WORDS, HAPPY.
      IF (MOD(XQ,2) .EQ. 1) CALL PUTQ(XQ,XQ+1,0)
      CALL EXEC(2,LU,XQ(2),-NC)
      RETURN
      END
C     SUBROUTINE MOVEQ(XQ,I,YQ,J,N)
      SUBROUTINE MOVEQ(XQ,I,YQ,J,N)
C
C     MOVES N CHARACTERS FROM STRING XQ TO STRING YQ, STARTING
C        AT THE I-th CHARACTER OF XQ AND THE J-th CHARACTER OF YQ.
C     I AND J MAY HAVE ANY VALUES POSITIVE OR NEGATIVE.
C     IF N<=0, NO CHARACTERS WILL BE MOVED.
C     DOES NOT CHECK OR MODIFY STRING LENGTHS.
C     ALL CALLS OF THE FORM CALL MOVEQ(XQ,I,XQ,J,N) ARE VALID.
C     ARW 6/76
C
      INTEGER XQ,YQ
C
      IF (N .LE. 0) RETURN
C     COMPUTE RELATIVE STARTING CHARACTER ADDRESSES
      XLOC=2.*LCO(XQ)+I
      YLOC=2.*LCO(YQ)+J
      IDIF=YLOC-XLOC
      IF (IDIF .EQ. 0) RETURN
      IF (IDIF .GT. 0 .AND. IDIF .LT. N) GO TO 100
C     CALL MOVQQ TO MOVE CHARACTERS IN ORDER FROM LEFT TO RIGHT USING
C     THE HIGH-SPEED BYTE-MOVE INSTRUCTION.
      CALL MOVQQ(XQ,I,YQ,J,N)
      RETURN
C
C     MUST MOVE BYTES FROM RIGHT TO LEFT IN ORDER TO PREVENT OVERWRITING
C     INTO AREA YET TO BE MOVED.
100   DO 110 K=N-1,0,-1
      CALL PUTQ(YQ,J+K,JASCQ(XQ,I+K))
110   CONTINUE
      RETURN
      END
C     SUBROUTINE SEGQ(XQ,I,J,YQ)
      SUBROUTINE SEGQ(XQ,I,J,YQ)
C
C     EXTRACTS THE STRING OF CHARACTERS IN POSITIONS I THRU J
C     INCLUSIVE OF XQ AND RETURNS THEM AS STRING YQ.
C     CALLS OF THE FORM 'CALL SEGQ(XQ,I,J,XQ)' ARE VALID.
C     ARW 6/76
C
C     IF I<=0,         I=1 IS ASSUMED.
C     IF I>LENQ(XQ),   YQ IS RETURNED AS A NULL STRING.
C     IF J<=0,         YQ IS RETURNED AS A NULL STRING.
C     IF J>LENQ(XQ),   J=LENQ(XQ) IS ASSUMED.
C     IF J<I,          YQ IS RETURNED AS A NULL STRING.
C
      INTEGER XQ,YQ
C
      N=0
      IF (I .GT. XQ .OR. J .LE. 0 .OR. J .LT. I) GO TO 100
      IFIRST=I
      IF (IFIRST .LE. 0) IFIRST=1
      LAST=J
      IF (LAST .GT. XQ) LAST=XQ
      N=LAST-IFIRST+1
      IF (N .LT. 0) N=0
      CALL MOVEQ(XQ,IFIRST,YQ,1,N)
100   YQ=N
      RETURN
      END
C     SUBROUTINE DLETQ(XQ,I,N)
      SUBROUTINE DLETQ(XQ,I,N)
C
C     ROUTINE TO DELETE N CHARACTERS FROM STRING XQ, STARTING
C        AT CHARACTER I.
C     IF I<1 OR I>LENQ(XQ) OR N<=0, XQ IS RETURNED UNCHANGED.
C     IF XQ HAS FEWER THAN N CHARACTERS FROM CHARACTER I TO THE
C        END OF XQ, ALL CHARACTERS TO THE END OF XQ ARE DELETED.
C     ARW 6/76
C
      INTEGER XQ
C
      IF (I .LT. 1 .OR. I .GT. XQ .OR. N .LE. 0) RETURN
      IF (I+N .LE. XQ) GO TO 100
C     NEED TO TRUNCATE STRING ONLY
      XQ=I-1
      RETURN
C     MUST DELETE CHARACTERS IN MIDDLE OF STRING
100   I1=I+N
      NMOVE=XQ-I1+1
      CALL MOVEQ(XQ,I1,XQ,I,NMOVE)
      XQ=XQ-N
      RETURN
      END
C     SUBROUTINE NSRTQ(XQ,I,YQ)
      SUBROUTINE NSRTQ(XQ,I,YQ)
C
C     ROUTINE TO INSERT STRING YQ INTO STRING XQ STARTING AFTER CHARACTER I
C        OF XQ (I.E. THE POSITION OF THE I-th CHARACTER IS UNCHANGED).
C     IN TERMS OF PDP BASIC FUNCTIONS AND NOTATIONS:
C        IF 1<=I<=LEN(XQ),   XQ=SEG(XQ,1,I) & YQ & SEG(XQ,I+1,LEN(XQ))
C           I=0          ,   XQ=YQ & XQ
C           I<0          ,   XQ=YQ & (-I)" " & XQ
C           I=LEN(XQ)    ,   XQ=XQ & YQ
C           I>LEN(XQ)    ,   XQ=XQ & (I-LEN(XQ))" " & YQ
C
C     YQ MAY BE A NULL STRING.
C     CALLS OF THE FORM 'CALL NSRTQ(XQ,I,XQ)' ARE VALID ONLY IF I>=LEN(XQ).
C
C     ARW 6/76
C
      INTEGER XQ,YQ,MESS1(9)
      DATA MESS1/2HNS,2HRT,2HQ:,2HIL,2HLE,2HGA,2HL ,2HCA,2HLL/
C
      LENYQ=YQ
      IF (YQ .LT. 0) LENYQ=0
      IF (I .LT. XQ) GO TO 130
C     I>=LENQ(XQ) INDICATES ONLY A SUFFIX MUST BE ADDED TO XQ.
C     ADD SPACES AT END OF XQ AS NECESSARY.
      CALL CLRQ(XQ,XQ+1,I)
C     MOVE YQ INTO PROPER POSITION
      CALL MOVEQ(YQ,1,XQ,I+1,LENYQ)
      XQ=I+LENYQ
      RETURN
C
130   IF (LCO(XQ) .EQ. LCO(YQ) .AND. I .LT. XQ) GO TO 150
      IF (I .GT. 0) GO TO 140
C
C     I<=0 INDICATES XQ MUST BE MOVED TO THE RIGHT INTACT.
      CALL MOVEQ(XQ,1,XQ,LENYQ-I+1,XQ)
C     MOVE YQ INTO PLACE.
      CALL MOVEQ(YQ,1,XQ,1,LENYQ)
C     CLEAR SPACES AS NECESSARY.
      CALL CLRQ(XQ,LENYQ+1,LENYQ-I)
      XQ=XQ+LENYQ-I
      RETURN
C
C     XQ MUST BE SPLIT IN MIDDLE AND YQ INSERTED.
C     MOVE RIGHT-HAND SEGMENT OF XQ AS NECESSARY.
140   CALL MOVEQ(XQ,I+1,XQ,I+1+LENYQ,XQ-I)
C     INSERT YQ
      CALL MOVEQ(YQ,1,XQ,I+1,LENYQ)
      XQ=XQ+LENYQ
      RETURN
C
C     ILLEGAL CALL
150   CALL EXEC(2,1,MESS1,-18)
      RETURN
      END
C     SUBROUTINE CLRQ(XQ,I,J)
      SUBROUTINE CLRQ(XQ,I,J)
C
C     ROUTINE TO CLEAR (I.E. PUT SPACES) FROM POSITIONS I THRU J, INCLUSIVE.
C     DOES NOT CHECK OR CHANGE STRING LENGTH.
C     ARW 6/76
C
      IF (I .GT. J) RETURN
      DO 100 K=I,J
      CALL PUTQ(XQ,K,40B)
100   CONTINUE
      RETURN
      END
C     SUBROUTINE ANDQ(XQ,YQ,ZQ)
      SUBROUTINE ANDQ(XQ,YQ,ZQ)
C
C     ROUTINE TO CREATE ZQ, WHICH IS COMPOSED OF XQ FOLLOWED BY YQ.
C     ALL CALLS OF THE FORM 'CALL ANDQ(XQ,YQ,XQ)' OR
C        'CALL ANDQ(XQ,YQ,YQ)' OR 'CALL ANDQ(XQ,XQ,XQ)' ARE VALID.
C     ARW 6/76
C
      INTEGER XQ,YQ,ZQ
C
      CALL MOVEQ(YQ,1,ZQ,XQ+1,YQ)
      CALL MOVEQ(XQ,1,ZQ,1,XQ)
      ZQ=XQ+YQ
      RETURN
      END
C     FUNCTION IXQ(XQ,AQ,BQ,N)
      FUNCTION IXQ(XQ,AQ,BQ,N)
C
C     ROUTINE TO REPLACE, WITHIN XQ, STRING AQ WITH STRING BQ.
C     IF N<=0, ALL OCCURRENCES OF AQ ARE REPLACED WITH BQ AND
C        IXQ RETURNS THE NUMBER OF OCCURRENCES FOUND.
C        [NOTE THAT THE NUMBER OF OCCURENCES OF ANY STRING AQ
C        WITHIN XQ MAY BE FOUND BY SIMPLY CALLING IXQ(XQ,AQ,AQ,0)]
C     IF N>0, ONLY THE N-th OCCURRENCE OF AQ IS REPLACED BY BQ
C        AND IXQ RETURNS THE CHARACTER POSITION OF THE FIRST
C        CHARACTER EXCHANGED. IXQ IS RETURNED =0 IF NO N-th
C        OCCURRENCE OF AQ IS FOUND.
C     IF AQ IS A NULL STRING, AN IMMEDIATE RETURN IS MADE WITH IXQ=-1.
C     BQ MAY BE A NULL STRING.
C
C     ARW 6/76
C
      INTEGER XQ,AQ,BQ
C
      IXQ=-1
      IF (AQ .LE. 0) RETURN
      ICMPR=KMPRQ(AQ,BQ)
      IXQ=0
      NN=32767
      IF (N .GT. 0) NN=N
      J1=1
      DO 100 I=1,NN
      J=IPOSQ(XQ,AQ,J1)
      IF (J .EQ. 0) RETURN
      IF (N .EQ. 0 .OR. I .EQ. NN) GO TO 90
      J1=J+AQ
      GO TO 100
90    IF (ICMPR .EQ. 1) GO TO 95
C     DELETE AQ AND INSERT BQ
      CALL DLETQ(XQ,J,AQ)
      CALL NSRTQ(XQ,J-1,BQ)
95    J1=J+BQ
      IXQ=IXQ+1
100   CONTINUE
      IXQ=J
      RETURN
      END
C     FUNCTION NBLQ(XQ,ZQ,ISTRC)
      FUNCTION NBLQ(XQ,ZQ,ISTRC)
C
C     RETURNS THE SET OF CONTIGUOUS NON-BLANK CHARACTERS FROM STRING XQ
C     IN STRING ZQ STARTING AT CHARACTER ISTRC.  ISTRC IS RESET TO THE
C     POSITION OF THE NEXT BLANK CHARACTER OR LENQ(XQ)+1 IF THERE ARE
C     NO FOLLOWING BLANKS.  NBLQ IS SET TO THE NUMBER OF NON-BLANK
C     CHARACTERS RETURNED OR ZERO IF NO NON-BALNK CHARACTERS WERE FOUND.
C
      INTEGER XQ,ZQ
      DIMENSION LBL(2)
      DATA LBL /1,2H  /
C
      NBLQ=0
C-----FIND NEXT NON-BLANK CHARACTER
      JNB=NFNBQ(XQ,ZQ,1,ISTRC)
C-----IF NO NON-BLANK CHARACTERS, RETURN
      IF(JNB.EQ.0) GO TO 900
C-----LOOK FOR NEXT BLANK
      JB=IPOSQ(XQ,LBL,JNB)
C-----IF NON FOUND, RETURN REST OF LINE
      IF(JB.EQ.0) 100,200
100   CALL SEGQ(XQ,JNB,XQ,ZQ)
      NBLQ=XQ-JNB+1
      ISTRC=XQ+1
      GO TO 900
C-----OTHERWISE, RETURN NON-BLANKS AND SET ISTRC TO POSITION OF BLANK
200   CALL SEGQ(XQ,JNB,JB-1,ZQ)
      NBLQ=JB-JNB
      ISTRC=JB
900   RETURN
      END
C     FUNCTION NFNBQ(XQ,ZQ,N,ISTRC)
      FUNCTION NFNBQ(XQ,ZQ,N,ISTRC)
C
C     STARTING AT CHARACTER NUMBER ISTRC OF STRING XQ, FINDS FIRST N
C     NON-BLANK (AND NON-NULL) CHARACTERS IN XQ, STORES THEM INTO ZQ,
C     RETURNS NFNBQ WITH THE POSITION (IN XQ) OF THE FIRST NON-BLANK
C     CHARACTER, AND UPDATES ISTRC TO POINT ONE CHARACTER BEYOND THE
C     Nth NON-BLANK CHARACTER OF XQ. IF THE END OF XQ IS REACHED BEFORE
C     N NON-BLANK CHARACTERS HAVE BEEN FOUND, ZQ IS RETURNED WITH ANY
C     NON-BLANK CHARACTERS FOUND, ISTRC IS SET TO LENQ(XQ)+1,
C     AND NFNBQ IS RETURNED =0.
C     IF NFNBQ IS CALLED WITH ISTRC>LENQ(XQ), NFNBQ IS RETURNED =0
C     AND ZQ RETURNED NULL.
C     ALL CALLS OF FORM "CALL NFNBQ(XQ,XQ,N,ISTRC)" ARE VALID.
C
C     ARW 770427
C
      INTEGER XQ,ZQ
      IXQ=XQ
      ZQ=0
      NFNBQ=0
      IF (ISTRC .GT. XQ) RETURN
      DO 100 I=ISTRC,IXQ
      IASC=JASCQ(XQ,I)
      IF (IASC .EQ. 0 .OR. IASC .EQ. 40B) GO TO 100
      IF (ZQ .EQ. 0) NFNBQ=I
      ZQ=ZQ+1
      CALL PUTQ(ZQ,ZQ,IASC)
      IF (ZQ .GE. N) GO TO 110
100   CONTINUE
      ISTRC=IXQ+1
      RETURN
110   ISTRC=I+1
      RETURN
      END
C     SUBROUTINE EQUAT(XQ,YQ)
      SUBROUTINE EQUAT(XQ,YQ)
C
C     ROUTINE TO SET XQ EQUAL TO YQ.
C     ARW 6/76
C
      INTEGER XQ,YQ
C
      CALL MOVEQ(YQ,1,XQ,1,YQ)
      XQ=YQ
      RETURN
      END
C     FUNCTION KMPRQ(XQ,YQ)
      FUNCTION KMPRQ(XQ,YQ)
C
C     RETURNS KMPRQ=1 IF STRING XQ IS IDENTICAL TO STRING YQ,
C         OTHERWISE KMPRQ=0.
C     ARW 6/76
C
      INTEGER XQ,YQ
C
      KMPRQ=0
      IF (XQ .EQ. YQ .AND. IPOSQ(XQ,YQ,1) .EQ. 1) KMPRQ=1
      RETURN
      END
C     SUBROUTINE LTRMQ(XQ)
      SUBROUTINE LTRMQ(XQ)
C
C     TRIMS LEADING BLANKS FROM XQ.
C     ARW 6/76
C
      INTEGER SPACE(2),XQ
      DATA SPACE/1,2H  /
C
100   IF (XQ .LE. 0) RETURN
      IF (IPOSQ(XQ,SPACE,1) .NE. 1) RETURN
      CALL SEGQ(XQ,2,XQ,XQ)
      GO TO 100
      END
C     FUNCTION LENQ(XQ)
      FUNCTION LENQ(XQ)
C
C     RETURNS LENGTH OF STRING XQ
C     ARW 6/76
C
      INTEGER XQ
C
      LENQ=XQ
      IF (LENQ .LT. 0) LENQ=0
      RETURN
      END
C     SUBROUTINE CHARQ(IASC,XQ)
      SUBROUTINE CHARQ(IASC,XQ)
C
C     RETURNS ONE CHARACTER STRING XQ HAVING ASCII VALUE OF IASC.
C     FOR EXAMPLE: IF IASC=101B, XQ="A".
C     ONLY THE LOWER-ORDER 8 BITS OF IASC ARE USED.
C     ARW 6/76
C
      INTEGER XQ
C
      XQ=1
      CALL PUTQ(XQ,1,IASC)
      RETURN
      END
C     SUBROUTINE NULLQ(XQ)
      SUBROUTINE NULLQ(XQ)
C
C     ROUTINE TO SET XQ TO NULL STRING (I.E. SET LENGTH =0).
C     ARW 6/76
C
      INTEGER XQ
      XQ=0
      RETURN
      END
C     FUNCTION KSTRQ(IX,XQ,N,ISTRC)
      FUNCTION KSTRQ(IX,XQ,N,ISTRC)
C
C*****KSTRQ REPLACES THE OLD STRING FUNCTION "ISTRQ".
C
C     RETURNS THE STRING XQ WHICH REPRESENTS THE NUMERIC VALUE
C     OF IX AS IT WOULD BE PRINTED BY A PRINT STATEMENT, STARTING
C     AT CHARACTER ISTRC OF XQ.
C     IX MUST BE INTEGER AND MAY BE POSITIVE OR NEGATIVE.
C
C     IF N=0, XQ IS RETURNED WITH NO LEADING BLANKS.
C     IF N>0, XQ IS RETURNED WITH LEADING BLANKS TO FILL XQ TO N
C             CHARACTERS. IF MORE THAN N CHARACTERS ARE REQUIRED
C             TO REPRESENT IX, XQ IS FILLED WITH "$" CHARACTERS.
C     IF N<0, XQ IS RETURNED WITH LEADING ZEROES TO FILL XQ TO IABS(N)
C             CHARACTERS. IF MORE THAN IABS(N) CHARACTERS ARE REQUIRED
C             TO REPRESENT IX, XQ IS FILLED WITH "$" CHARACTERS.
C     MAX ABSOLUTE VALUE OF N IS 20.
C
C     IN ALL CASES:
C       IF LEN(XQ) ON ENTRY IS < RESULTING STRING LENGTH, LEN(XQ)
C       IS UPDATED AS NECESSARY.
C       IF LEN(XQ) ON ENTRY IS > RESULTING STRING LENGTH, LEN(XQ)
C       IS NOT MODIFIED (I.E. MAY BE INSERTION OF FORMATTED NUMBER
C       INTO MIDST OF LONGER STRING).
C     ALSO, IN ALL CASES:
C       ISTRC IS UPDATED TO POINT ONE CHARACTER BEYOND LAST CHARACTER
C       OF FORMATTED NUMBER.
C     NORMAL RETURN IS KSTRQ=0. IF FIELD OVERFLOW, KSTRQ=-1.
C
C----------------------CAUTION!!!!!----------------------------
C  NOTE THAT CALLING PARAMETER ISTRC IS UPDATED. BE CAREFUL!!!
C
C     ARW 770527
C
      INTEGER XQ,IBUF(11),CQ(2),MINUS(2)
      DATA CQ/1,0/,MINUS/1,2H- /
C
C     CALL RTE UTILITY ROUTINE TO CONVERT TO ASCII
      CALL CNUMD(IABS(IX),IBUF(2))
      IBUF=6
      KSTRQ=0
      CALL TRIMQ(IBUF)
      CALL LTRMQ(IBUF)
      IF (IX .LT. 0) CALL ANDQ(MINUS,IBUF,IBUF)
      IF (N .EQ. 0) GO TO 130
      IDIF=IBUF-IABS(N)
      IF (IDIF) 120,130,100
C     FILL FIELD WITH "$"
100   DO 110 I=1,N
110   CALL PUTQ(IBUF,I,44B)
      IBUF=N
      KSTRQ=-1
      GO TO 130
C     ADD LEADING SPACES OR ZEROES AS NECESSARY
120   CQ(2)=020000B
      IDIF=-IDIF
      IF (N .GE. 0) GO TO 122
      CQ(2)=030000B
      IF (IX .LT. 0) CALL PUTQ(IBUF,1,60B)
122   DO 125 I=1,IDIF
125   CALL ANDQ(CQ,IBUF,IBUF)
      IF (IX .LT. 0 .AND. N .LT. 0) CALL PUTQ(IBUF,1,55B)
130   CALL MOVEQ(IBUF,1,XQ,ISTRC,IBUF)
      NN=ISTRC+IBUF-1
      IF (XQ .LE. NN) XQ=NN
      ISTRC=ISTRC+IBUF
      RETURN
      END
C     FUNCTION ISTRQ(IX,XQ,N)
      FUNCTION ISTRQ(IX,XQ,N)
C
C     RETURNS THE STRING XQ WHICH REPRESENTS THE NUMERIC VALUE
C     OF IX AS IT WOULD BE PRINTED BY A PRINT STATEMENT.
C
C     IF N=0, XQ IS RETURNED WITH NO LEADING BLANKS.
C     IF N>0, XQ IS RETURNED WITH LEADING BLANKS TO FILL XQ TO N
C             CHARACTERS. IF MORE THAN N CHARACTERS ARE REQUIRED
C             TO REPRESENT IX, XQ IS FILLED WITH "$" CHARACTERS.
C     IF N<0, XQ IS RETURNED WITH LEADING ZEROES TO FILL XQ TO IABS(N)
C             CHARACTERS. IF MORE THAN IABS(N) CHARACTERS ARE REQUIRED
C             TO REPRESENT IX, XQ IS FILLED WITH "$" CHARACTERS.
C
C     NORMAL RETURN IS ISTRQ=0. IF FIELD OVERFLOW, ISTRQ=-1.
C     IX MUST BE INTEGER.
C
C     ARW 6/76
C
      INTEGER XQ,IBUF(4),CQ(2)
      DATA CQ/1,0/
C
C     CALL RTE UTILITY ROUTINE TO CONVERT TO ASCII
      CALL CNUMD(IX,IBUF(2))
      IBUF(1)=6
      CALL TRIMQ(IBUF)
      CALL LTRMQ(IBUF)
      IF (N .EQ. 0) GO TO 130
      IDIF=IBUF(1)-IABS(N)
      IF (IDIF) 120,130,100
C     FILL FIELD WITH "$"
100   DO 110 I=1,N
110   CALL PUTQ(XQ,I,44B)
      XQ=N
      GO TO 150
C     ADD LEADING SPACES OR ZEROES AS NECESSARY
120   CQ(2)=020000B
      IF (N .LT. 0) CQ(2)=030000B
      CALL EQUAT(XQ,IBUF)
      DO 125 I=1,IDIF
125   CALL ANDQ(CQ,XQ,XQ)
      GO TO 150
130   CALL EQUAT(XQ,IBUF)
150   ISTRQ=XQ
      RETURN
      END
C     FUNCTION KVALQ(XQ,IERR,ISTRC)
      FUNCTION KVALQ(XQ,IERR,ISTRC)
C
C*****KVALQ REPLACES THE OLD STRING FUNCTION "IVALQ".
C
C     RETURNS THE INTEGER NUMBER REPRESENTED BY THE FIRST
C          CONTIGUOUS SET OF NUMERIC CHARACTERS ENCOUNTERED IN XQ,
C          STARTING AT CHARACTER ISTRC.
C     AN IMMEDIATELY PRECEDING "-" OR IMMEDIATELY SUCCEEDING "B"
C          ARE MAINTAINED.
C     IERR IS RETURNED =0 IF A VALID NUMBER IS FOUND AND =1 IS
C          NONE IS FOUND.
C*****NOTE:ISTRC IS UPDATED TO POINT ONE CHARACTER BEYOND THE LAST
C          DIGIT OF THE NUMBER FOUND OR TO LENQ(XQ)+1 IF THE END
C          OF THE STRING IS ENCOUNTERED.
C
C     ARW 770527
C
      INTEGER XQ,IRBUF(33),AQ(5),NQ(2),SPACE(2),COMMA(2)
      DATA NQ/1/,SPACE/1,2H  /,COMMA/1,2H, /
C
      KVALQ=0
      IERR=1
C     FIND FIRST NUMERIC CHARACTER IN XQ
      LENX=XQ
      IF (ISTRC .GT. LENX) RETURN
      J1=LENX+1
      NQ(2)=030000B
      DO 90 I=1,10
      J=IPOSQ(XQ,NQ,ISTRC)
      NQ(2)=NQ(2)+400B
      IF (J .EQ. 0) GO TO 90
      IF (J .LT. J1) J1=J
90    CONTINUE
      ISTRC=J1
      IF (J1 .GT. LENX) RETURN
C     CHECK FOR LEADING MINUS SIGN
      IF (IASCQ(XQ,J1-1) .EQ. 55B) J1=J1-1
      J2=MIN0(J1+7,LENX)
      CALL SEGQ(XQ,J1,J2,AQ)
C     FIND FIRST NON-NUMERIC CHARACTER IN AQ
      LENA=AQ(1)
      IF (LENA .EQ. 1) GO TO 106
      DO 105 J=2,LENA
      IC=IASCQ(AQ,J)
      IF (IC .LT. 60B .OR. IC .GT. 71B) GO TO 107
105   CONTINUE
106   J=LENA+1
      NC=LENA
      GO TO 108
107   IF (IC .EQ. 102B) J=J+1
      NC=J-1
108   CALL PARSE(AQ(2),NC,IRBUF)
      KVALQ=IRBUF(2)
      ISTRC=J1+J-1
      IERR=0
      RETURN
      END
C     FUNCTION IVALQ(XQ)
      FUNCTION IVALQ(XQ)
C
C     RETURNS THE INTEGER NUMBER REPRESENTED BY THE FIRST
C     CONTIGUOUS SET OF NUMERIC CHARACTERS ENCOUNTERED IN XQ.
C     AN IMMEDIATELY PRECEDING "-" OR IMMEDIATELY SUCCEEDING "B"
C     ARE MAINTAINED.
C     IVALQ RETURNED =0 IF NO NUMERIC DATA FOUND.
C
C     ARW 6/76
C
      INTEGER XQ(1),IRBUF(33),AQ(5),NQ(2),SPACE(2),COMMA(2)
      DATA NQ/1/,SPACE/1,2H  /,COMMA/1,2H, /
C
      IVALQ=0
C     FIND FIRST NUMERIC CHARACTER IN XQ
      LENX=XQ(1)
      J1=LENX+1
      NQ(2)=030000B
      DO 90 I=1,10
      J=IPOSQ(XQ,NQ,1)
      NQ(2)=NQ(2)+400B
      IF (J .EQ. 0) GO TO 90
      IF (J .LT. J1) J1=J
90    CONTINUE
      IF (J1 .GT. LENX) RETURN
C     CHECK FOR LEADING MINUS SIGN
      IF (IASCQ(XQ,J1-1) .EQ. 55B) J1=J1-1
      J2=MIN0(J1+7,LENX)
      CALL SEGQ(XQ,J1,J2,AQ)
C     FIND FIRST NON-NUMERIC CHARACTER IN AQ
      LENA=AQ(1)
      IF (LENA .EQ. 1) GO TO 106
      DO 105 J=2,LENA
      IC=IASCQ(AQ,J)
      NQQ=60B
      DO 100 I=1,10
      IF (IC .EQ. NQQ) GO TO 105
      NQQ=NQQ+1
100   CONTINUE
      GO TO 107
105   CONTINUE
106   NC=LENA
      GO TO 108
107   IF (IC .EQ. 102B) J=J+1
      NC=J-1
108   CALL PARSE(AQ(2),NC,IRBUF)
      IVALQ=IRBUF(2)
      RETURN
110   CONTINUE
      RETURN
      END
C     FUNCTION IASCQ(XQ,I)
      FUNCTION IASCQ(XQ,I)
C
C     RETURNS ASCII VALUE OF I-th CHARACTER IN STRING XQ.
C     IDENTICAL TO FUNCTION JASCQ(XQ,I) EXCEPT RETURNS
C        IASCQ=-1 IF I<1 OR I>LENQ(XQ).
C     ARW 6/76
C
      INTEGER XQ
C
      IASCQ=-1
      IF (I .LT. 1 .OR. I .GT. XQ) RETURN
      IASCQ=JASCQ(XQ,I)
      RETURN
      END
C     SUBROUTINE UNPKQ(INQ,OUTQ)
      SUBROUTINE UNPKQ(INQ,OUTQ)
C
C     UNPACKS THE INPUT STRING INQ INTO THE OUTPUT STRING OUTQ ONE
C     CHARACTER TO A WORD (THE UPPER EIGHT BITS OF EACH WORD OF
C     OUTQ ARE SET TO ZERO).
C     ALL CALLS OF THE FORM "CALL UNPKQ(XQ,XQ)" ARE VALID.
C     ARW 770601
C
      INTEGER OUTQ(1)
C
      IF (INQ .GT. 0) GO TO 90
      OUTQ=0
      RETURN
90    DO 100 I=INQ,1,-1
100   OUTQ(I+1)=JASCQ(INQ,I)
      OUTQ=2*INQ
      RETURN
      END
C     SUBROUTINE PACKQ(INQ,OUTQ)
      SUBROUTINE PACKQ(INQ,OUTQ)
C
C     PACKS THE INPUT STRING INQ INTO THE OUTPUT STRING OUTQ BY
C     DELETING ALL ODD-NUMBERED CHARACTERS (E.G. THE UPPER 8 BITS
C     OF EACH WORD). AS USUAL, THE FIRST WORD OF INQ MUST CONTAIN
C     THE # OF CHARACTERS IN INQ.
C     ALL CALLS OF THE FORM "CALL PACKQ(XQ,XQ)" ARE VALID.
C     ARW 770601
C
      INTEGER INQ(1),OUTQ
C
      IF (INQ .GT. 0) GO TO 90
      OUTQ=0
      RETURN
90    DO 100 I=1,INQ
100   CALL PUTQ(OUTQ,I,INQ(I+1))
      OUTQ=INQ/2
      RETURN
      END
      INTEGER FUNCTION IPRSQ(XQ,ZQ,N,ISTRC,MODE)
C
C     A CHARACTER-STRING PARSING ROUTINE.
C
C     STARTING AT CHARACTER NUMBER ISTRC OF STRING XQ, SEARCHES FOR
C     FIRST NON-<SPACE> CHARACTER, THEN RETURNS
C     IN ZQ THAT CHARACTER PLUS ALL FOLLOWING CHARACTERS (N MAX) UP TO
C     THE NEXT <SPACE> CHARACTER OR END OF XQ, WHICHEVER OCCURS FIRST.
C     IPRSQ IS SET TO POSITION (IN XQ) OF FIRST NON-<SPACE> CHARACTER FOUND.
C
C     "MODE" CONTROLS THE MANNER IN WHICH ISTRC IS UPDATED ON RETURN:
C       MODE=0 - ISTRC IS UPDATED TO POINT TO EITHER THE FOLLOWING <SPACE>
C                CHARACTER OR LENQ(XQ)+1, WHICHEVER IS LESSER.
C       MODE=1 - ISTRC IS UPDATED TO POINT ONE CHARACTER POSITION BEYOND
C                THE LAST CHARACTER THAT WAS PLACED IN ZQ.
C
C     IF IPRSQ IS CALLED WITH ISTRC>LENQ(XQ) OR NO NON-<SPACE> CHARACTERS
C     ARE FOUND, IPRSQ IS RETURNED =0, ZQ RETURNED NULL, AND ISTRC
C     RETURNED >LENQ(XQ).
C
C     ARW 770824
C
      INTEGER XQ,ZQ,SPACQ(2)
      DATA SPACQ/1,2H  /
      IXQ=XQ
      ZQ=0
      IPRSQ=0
      IF (ISTRC .GT. XQ) RETURN
      DO 100 I=ISTRC,IXQ
      IF (JASCQ(XQ,I) .NE. 40B) GO TO 120
100   CONTINUE
      ISTRC=IXQ+1
      RETURN
C
120   IPRSQ=I
      J=IPOSQ(XQ,SPACQ,I)
      IF (J .EQ. 0) J=XQ+1
      ZQ=J-I
      IF (ZQ .GT. N) ZQ=N
      CALL MOVEQ(XQ,I,ZQ,1,ZQ)
      ISTRC=J
      IF (MODE .EQ. 1) ISTRC=I+ZQ
      RETURN
      END
      END$
