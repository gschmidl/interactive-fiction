         cfl = cf'.'k
         cr = value(cfl)
-        queue bl cr
+        queue cr
       end
     end
   end
@@ -2488,14 +2511,14 @@
     cb = word(books,i)
     queue '$ BOOK' cb
     do j = 0 to 2
-      queue bl book.cb.j
+      queue book.cb.j
     end
   end
   queue '$ NOTE'
