+# Port: in Multics BASIC the arrays a program declares with dim exist, with
+# those bounds and all elements 0 or "", from the moment control enters the
+# program; the bounds "do not change during execution", and a dim statement
+# "has no effect when executed" and may come after the array's first use
+# (AM82-01, 1-4, 2-4 and 5-9).  So they are declared here, on entry: the dims
+# from FROM to the end of that program (the next sub or subend).  (Explore's
+# -abbrev control argument loads x$() before line 460 dims it.)
+sub _predeclare {
+    my ($class, $ir, $from, $env) = @_;
+    for my $i ($from .. $#$ir) {
+        my $s = $ir->[$i];
+        last if $s->{op} eq 'sub' || $s->{op} eq 'subend';
+        next unless $s->{op} eq 'dim';
+        local $MBasic::Expr::LINE = $s->{line};
+        for my $d (@{$s->{decls}}) {
+            my @b = map { int(MBasic::Expr->eval($_, $env)) } @{$d->{bounds}};
+            $env->declare_array($d->{name}, \@b);
+        }
+    }
+    return;
+}
