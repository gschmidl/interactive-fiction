[inherit('[-.env]typedef', 'sys$library:starlet')]
module ifc$object_routines;

type	$longword = [unsafe, long] packed record
			case integer of
			1 : (long : unsigned);
			2 : (word0, word1 : $uword);
			3 : (byte0, byte1, byte2, byte3 : $ubyte);
			end;

var	object_file : text;
	byte_count : $longword;

[global]procedure ifc$open_object(
	object_filename : varying[$u1] of char);
begin
	open(object_file, object_filename, history:=new,
		carriage_control:=none);
	rewrite(object_file);
	byte_count.long:=0;
end;

[global]procedure ifc$close_object;
begin
	close(object_file);
end;

[global]procedure ifc$write_hdr_mhd(
	module_name : varying[$u1] of char;
	module_version : varying[$u2] of char);

var	timebuf : varying[23] of char;
begin
	$asctim(,timebuf.body); timebuf.length:=17;

	writeln(object_file,
		chr(obj$c_hdr),
		chr(mhd$c_mhd),
		chr(obj$c_strlvl),
		chr(132),
		chr(0),
		chr(module_name.length),
		module_name,
		chr(module_version.length),
		module_version,
		timebuf,
		'                 ');
end;

