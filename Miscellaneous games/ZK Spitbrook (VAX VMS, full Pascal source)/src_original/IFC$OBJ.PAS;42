begin
	writeln(object_file,
		chr(obj$c_tir),
		chr(241),
		chr(free.byte0), chr(free.byte1),
		chr(class.byte0),
		chr(link[1]), chr(link[2]), chr(link[3]), chr(link[4]),
		chr(link[5]), chr(link[6]), chr(link[7]), chr(link[8]),
		chr(link[9]), chr(link[10]), chr(link[11]), chr(link[12]) );
	byte_count.long:=byte_count.long + 15;
end;

[global] procedure ifc$write_tir_sti_object(
	free : $longword;
	flags : $longword;
	count : $longword;
	var initial : varying[$u1] of char;
	var info : packed array[$l2..$u2:integer] of $ubyte);
begin
	if (initial.length<>0) then
	  begin
		ifc$write_gsd_sym_ref_abs(initial);
		ifc$write_tir_sta_gbl(initial);
		writeln(object_file,
			chr(obj$c_tir),
			chr(251),
			chr(free.byte0), chr(free.byte1),
			chr(flags.byte0),
			chr(flags.byte1),
			chr(count.byte0),
			chr(tir$c_sto_usb),
			chr(241),
			chr(info[02]), chr(info[03]), chr(info[04]),
			chr(info[05]), chr(info[06]), chr(info[07]),
			chr(info[08]), chr(info[09]), chr(info[10]),
			chr(info[11]), chr(info[12]), chr(info[13]),
			chr(info[14]), chr(info[15]), chr(info[16]));
	  end
	else
		writeln(object_file,
			chr(obj$c_tir),
			chr(235),
			chr(free.byte0), chr(free.byte1),
			chr(flags.byte0),
			chr(flags.byte1),
			chr(count.byte0),
			chr(info[01]), chr(info[02]), chr(info[03]),
			chr(info[04]), chr(info[05]), chr(info[06]),
			chr(info[07]), chr(info[08]), chr(info[09]),
			chr(info[10]), chr(info[11]), chr(info[12]),
			chr(info[13]), chr(info[14]), chr(info[15]),
			chr(info[16]));

	byte_count.long:=byte_count.long + 21;
end;

