proc _moltenlava():
   if _tried = 0 then 
      output "Please do not attempt " 
         "to go that way.%nYou will burn yourself into a little piece of "
         "charcoal.%n";
      _tried := 1;
   elif _tried = 1 then 
      output "You have fallen into the molten lava.%n"
         "You are now a little piece of charcoal.%n";
      _die();
   fi;
corp;
 
