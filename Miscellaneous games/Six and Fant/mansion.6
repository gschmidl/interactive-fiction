      if _noun in _carrying
      then if _objloc = log
         then output "That was dumb, now it is at the bottom of"
               " the bottomless lake!%n";
            if _noun = candle then _candle_timeleft := 0 fi
         else if (_noun = candle or _noun = flash) and
                 (_verbstring = "drop" or _verbstring = "release" or
                  _verbstring = "let-go" or _verbstring = "letgo")
            then if _noun = candle
               then _objloc._contents <+ candlepiece;
                  _candle_timeleft := 0;
                  dict."candle" := candlepiece
               else _objloc._contents <+ brokenflash;
                  dict."flash" := brokenflash;
                  dict."flashlight" := brokenflash
               fi;
               output "Now you've broken it!%n";
               _carrying <- _noun;
               if _loc._darkflag isnt absent and
                     not flash in _carrying and not flash in _objloc._contents
                     and (not (candle in _carrying or candle in _objloc._contents) or
                     _candle_timeleft > CANDLETIME or _candle_timeleft <= 0)
               then _dark := true;
                  output "It is pitch dark.%n"
