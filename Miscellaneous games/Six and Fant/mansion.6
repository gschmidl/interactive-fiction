thing streamcave:
   _name "in the beautiful cave",
   _description ". The water is emerald green; the walls are red marble"
         " stippled with veins of blue. Minerals in the water have turned"
         " the bottom of the pool to a warm azure wonderland. A small beach"
         " of pure white sand stretches along the east wall.%n",
   _landing b8,
   exit streambycave,
   downstream streambycave,
   south streambycave;

