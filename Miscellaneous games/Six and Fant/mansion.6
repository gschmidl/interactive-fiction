proc _command():
   _noun := dict._nounstring;
   _word := _homonym._noun;
   if _word is table then _noun := _word fi;
   if _verb._nounstring is proc
   then _verb._nounstring()
   elif _verb._noun is proc
   then _verb._noun()
   else _verb.true()
   fi;
   if _winchon ~= 0
   then if _winchon = -1
      then if _winchpos = 3
         then if _loc = winchroom
            then output "%nThe automatic cutoff on the winch"
                  " has cut in and stopped the motor.%n"
            fi;
            _winchon := 0
         else _winchpos := _winchpos + 1
         fi
      else if _winchpos = 0
         then if _loc = winchroom
            then output "%nThe automatic cutoff on the winch"
                  " has cut in and stopped the motor.%n"
            fi;
            _winchon := 0
         else _winchpos := _winchpos - 1
         fi
      fi
   fi;
   if _missileflag
   then _missiletimer := _missiletimer - 1;
      if _missiletimer = 0
      then _missiletimer := 4;
         if _loc in _sublocs
         then output "%nWarning! Warning! Missile approaching."
               " Trajectory calculations indicate origin was ",
               _missiletargets._missilesender
         else output "A roaring sound can be heard far"
               " overhead! A missile is approaching"
         fi;
         output "! KA-BOOMPH-RUMBLE-RUMBLE!! Detonation at"
               " range ", 3 - _missilecount,
               if _missilecount = 2 then " kilometer.%n"
                                    else " kilometers.%n"
                                    fi;
         if _missilecount = 3
         then output "Need I say more?%n";
            _demerits := _demerits + 50;
            _missilecount := 0;
            _quitflag := true
         else _missilecount := _missilecount + 1
         fi
      fi
   fi;
   _thirstcount := _thirstcount - 1;
   if _thirstcount = 10
   then output "%nYou are starting to feel thirsty. It"
         " would perhaps be adviseable to have some water"
         " ready.%n"
   elif _thirstcount = 5
   then output "%nThe pangs of thirst are becoming desperate."
         " Water is now vital for survival.%n"
   elif _thirstcount = 1
   then output "%nCroak - Croak - Rasp! (Drink some"
         " water or die!)%n"
   elif _thirstcount = 0
   then output "%nYou have just died of thirst!%n";
      _quitflag := true;
      _thirstcount := _thirstmax
   fi;
   if not _preachergone and not _preachernear and ? > 9800
   then output "%nA darksuited man carrying a big black book leaps"
         " out at you, mumbles 'corrupt thief!' and hits you with"
         " his book. He then stands back and glares at you.%n%n";
      _preachernear := true
   fi;
   if _trogflag then _dotrog() fi;
   _candle_timeleft := _candle_timeleft - 1;
   if _candle_timeleft = 0
   then if candle in _carrying or candle in _objloc._contents
      then output "Your candle has burned completely away!%n%n";
      fi;
      if _loc._darkflag isnt absent and not flash in _carrying
      then _dark := true;
         output "It is pitch dark.%n"
      fi
   fi
corp;

/* The main program: */

start:
   channelbottom.hint := NH;
   whirlpool.hint := NH;
   channelbottomwater.hint := NH;
   whirlpoolwater.hint := NH;
   s1l1.hint := NH;
   s2l1.hint := NH;
   s3l1.hint := NH;
   b5.hint := NH;
   b6.hint := NH;
   _loc := outsidegate;
   _objloc := outsidegate;
   _carrying := emptylist;
   _carrycount := 0;
   _quitflag := false;
   _dark := false;
   _candle_timeleft := 8000000;
   _chestopen := false;
   _hatchoiled := 0;
   _hatchlocked := true;
   cellar._description := ". Stairs lead up and to the east. "
         "There is a rusty hatch set in the floor.%n";
   cave._description := ", a small, poorly lit secret chamber "
         "beneath the cellar. A ladder leads up to a closed hatch "
         "and a small dark tunnel slopes down and to the south.%n";
   _maindoorlocked := true;
   _backdoorlocked := true;
   _gatelocked := false;
   _casklocked := true;
   _caskopen := false;
   _terse := false;
   _score := 0;
   _movers := _.1;
   _caskopened := false;
   _surface := _.2;
   _preachernear := false;
   _preachergone := false;
   _bibleopen := false;
   _oncraft := false;
   _bibleopened := false;
   _knobinwater := true;
   _winchon := false;
   _winchpos := 0;
   _onhook := emptylist;
   _winchdoorlocked := true;
   _knobinplace := false;
   _cancontents := "oil";
   _potcontents := nil;
   sub._description := "in the conning tower of the Nautilus. At"
         " your feet is a closed hatch with a square ended shaft"
         " protruding from its center. The submarine is ";
   _wheelonshaft := false;
   _subhatchlocked := true;
   _sublocs := _.3;
   _safeopen := false;
   _safelocked := true;
   _combination := _combinations.(? / 1000 + 1);
   _stuffinsafe := true;
   _boathousedoorlocked := true;
   chest._name := "a small pine chest%n";
   oilcan._name := "a can of oil%n";
   coffeepot._name := "a battered old coffeepot%n";
   cask._name := "a small ornate casket%n";
   bible._name := "a large, heavy bible%n";
   _demerits := 0;
   _forwardtorpedosgone := emptylist;
   _afttorpedosgone := emptylist;
   _depth := 0;
   _engines := 0;
   _heading := 6;
   _rubblecount := 0;
   _whirlpools := _.4;
   _cratesmashed := false;
   _craters := _.5;
   _subout := false;
   _waron := false;
   _spiritgone := false;
   _trogloc := b4;
   _trogflag := false;
   _cavecount := 0;
   _missileflag := false;
   _thirstmax := 8000000;
   _thirstcount := 8000000;
   _missilesender := ? / 625 + 1;
   _nofish := _.6;
   _nils := _.7;
   _vaultclosed := true;
   vale._description := " hidden on the conical island. Set in the rock"
         " to the north is a huge vault door.%n";

   output "%nWelcome to Mansion. Would you like instructions?%n";
   if _yes()
   then output "%n%nMansion is a world written using the SIX/FANTASY"
         " system produced by Chris Gray and Alan Covington. It"
         " works something like ADVENTURE, but there are"
         " differences. The object of the game is to score ",
         MAXSCORE, " points without getting any demerits. This"
         " is done by retrieving all of the treasures, many of"
         " which are hidden in an underground cavern system. The"
         " user types in commands indicating what"
         " he/she wants to do. All characters in the command words"
         " (verb and noun(s) or just verb) are checked, but many"
         " abbreviations are available. Some of the more commonly"
         " used commands (there are hundreds possible) are:   "
         " take inventory (invent), go north (n), look, score,"
         " quit, god, get card (ge card), push down (p down),"
         " unlock door, wait (wa), navigate upstream (us), terse, read"
         " sign, etc.    Many verbs will accept multiple nouns."
         " Hints are available (hint) in some"
         " locations, but they cost you lots of demerits. If you"
         " can't get something to work, it could be because you are"
         " using words I never thought of, you can't do it or I"
         " won't let you do it yet. One little problem: You are the"
         " world's only sufferer of dehydratosis and must drink"
         " water regularly in order to stay alive. Good luck!%n"
   fi;
   while output newline;
      _see(false);
      while not _quitflag
      do _input := input;
         output newline;
         if _input is absent        /* i.e. EOF on input */
         then output "You have hit 'end-of-file'. Do you wish"
               " to continue the game?%n";
            if not _yes()
            then _quitflag := true;
               _verb := quit
            fi
         elif _input                /* i.e. it wasn't a blank line */
         then _nounstring := nil;   /* in case no noun was given */
            _count := 1;
            for _word in _input
            do if _count = 1
               then _verb := dict._word;
                  _verbstring := _word;
                  _input <- _word
               elif _count = 2
               then _nounstring := _word;
                  _input <- _word
               fi;
               _count := _count + 1
            od;
            if _verb is absent      /* wasn't found in dict */
            then output if ? < 5000
                        then "I don't know that word.%n"
                        else "Eh?%n"
                        fi
            elif _verb.true isnt proc       /* assume all verbs have a noun * */
            then output "That's not a verb.%n"
            else if _verb ~= push and not _verb in _nils and _engines ~= 0 then _movesub() fi;
               if _dark and _verb."_dark" is absent
               then output "You can't see to ", _verbstring, " anything.%n"
               elif not _input or _verb."_mult" is absent
               then _command()
               else _tersesave := _terse;
                  _terse := true;
                  _listerror := false;
                  _command();
                  for _nounstring in _input
                  do _input <- _nounstring;
                     if not _input then _terse := _tersesave fi;
                     if not _listerror then _command() fi
                  od
               fi;
               if _verb = say or _verb = shout then output newline fi;
            fi;
            for _word in _input
            do _input <- _word
            od
         fi
      od;
      if _verb = quit
      then false
      else output "%nYou seem to have gotten yourself killed. This would"
               " seem to prevent the continuation of our little adventure. It is"
               " possible, however, that I, being the almighty Creator, can do"
               " something to remedy the situation. It will cost you all of the"
               " treasures that you are carrying as payment, however. Do you"
               " wish me to re-incarnate you under these conditions?%n%n";
         _yes()
      fi
   do for _word in _carrying
      do if _word._value isnt absent
         then _carrying <- _word;
            td._contents <+ _word;
            _carrycount := _carrycount - 1;
            _score := _score - _word._value
         fi
      od;
      for _word in _objloc._contents
      do if _word._value isnt absent
         then _objloc._contents <- _word;
            td._contents <+ _word;
            _score := _score - _word._value;
            if _loc = trophyroom then _score := _score - _word._value fi
         fi
      od;
      _demerits := _demerits + 10;
      _quitflag := false
   od;
   output "You scored ", _score, " out of ", MAXSCORE,
          " points with ", _demerits, " demerit points.%n";
   output "See ya real soon!%n";

