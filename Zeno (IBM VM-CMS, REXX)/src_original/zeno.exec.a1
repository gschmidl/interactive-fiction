SAVEDATA: procedure expose disks disk files. file. lab. books book. ,
                           notes note. commsg iomodule
  arg fn ft;
  if fn = '' then
    fn = 'ZENO'
  else
    fn = substr(word(fn,1),1,8)
  if ft = '' then
    ft = 'ZENODATA'
  'STATE' fn ft 'A'
  if rc = 0 then 'ERASE' fn ft 'A'
  call delstack
  bl = ' '
 
  queue '*' time() date(W) date(E)
  queue bl disk
 
  nd = words(disks)
  do i = 1 to nd
    cd = word(disks,i)
    queue '$ DISK' cd
    nf = words(files.cd)
    do j = 1 to nf
      cf = word(files.cd,j)
      queue '$ FILE' cf
      cf = 'FILE.'cd'.$'cf
      cfn = value(cf)
      do k = 1 to cfn
        cfl = cf'.'k
        cr = value(cfl)
        queue bl cr
      end
    end
  end
 
  nb = words(books)
  do i = 1 to nb
    cb = word(books,i)
    queue '$ BOOK' cb
    do j = 0 to 2
      queue bl book.cb.j
    end
  end
  queue '$ NOTE'
  nn = words(notes)
  do i = 1 to nn
    cn = word(notes,i)
    queue bl cn note.cn
  end
 
  queue '$ EOF'
  nrecs = queued()
  iomodule nrecs 'DISKW' fn ft 'A 1 V 255 (FINIS'
  if rc ^= 0 then commsg = 'Bad Save'
  return
 
LOADDATA: procedure expose  disks disk files. file. lab. books book. ,
                            notes note. msg. commsg curclk iomodule
  arg fn ft
  if fn = '' then
    fn = 'ZENO'
  else
    fn = substr(word(fn,1),1,8)
  if ft = '' then
    ft = 'ZENODATA'
  'STATE' fn ft '*'
  if rc ^= 0 then
    do
      commsg = "Can't restore from" fn "- return code" rc
      return
    end
 
  call delstack
  drop files. file. lab. book. note.
  iomodule '* DISKR' fn ft '* 1 (FINIS'
  call readrec /* heading */
  call readrec
  disk = strip(line)
  call readrec
 
  disks = ''
  do while t2 = 'DISK'
    cd = t3
    disks = disks cd
    files.cd = ''
    call readrec
    do while t2 = 'FILE'
      cf = cd'.$'t3
      files.cd = files.cd t3
      nr = 0
      lab.cf = ''
      call readrec
      do while t1 ^= '$'
        nr = nr + 1
        file.cf.nr = line
        if t2 = ':' then
          lab.cf = lab.cf t1 nr
        call readrec
      end
      file.cf = nr
    end
  end
 
  books = ''
  do while t2 = 'BOOK'
    cb = t3
    books = books cb
    do i = 0 to 2
      call readrec
      book.cb.i = line
    end
    call readrec
  end
 
  notes = ''
  call readrec
  do while t1 ^= '$'
    notes = notes t1
    note.t1 = subword(line,2)
    call readrec
  end
 
  if ft = 'INITDATA' & curclk = 0 then
    do
      call readrec
      do while t1 ^= '$'
        msg.t1 = subword(line,2)
        call readrec
      end
    end
 
  call delstack
  return
 
DELSTACK:
  do while queued() > 0
    pull junk
  end
  return
 
READREC:
  parse pull line
  parse upper var line t1 t2 t3 trest
  return
