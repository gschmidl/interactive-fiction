/* advars.def -- the ADVARS structure of adventure.pli, as an X-macro
 * list.  Field order and initial values follow lines 208-393 of
 * adventure.pli exactly.
 *
 * The list is expanded three ways: to declare the variables (they are
 * ordinary globals here, so that an internal procedure declaring a
 * local of the same name shadows them the way it did in PL/I), and to
 * serialise and restore them for SUSPEND/RESTORE.
 *
 *   F_CHR(name, len)          CHARACTER(len)
 *   F_VCH(name, max)          CHARACTER(max) VARYING
 *   F_I32(name, init)         FIXED BINARY(31)
 *   F_I16(name, init)         FIXED BINARY(15)
 *   F_FLT(name, init)         FLOAT DECIMAL(6)
 *   F_BIT(name, init)         BIT(1)
 *   F_I32A(name, n, init...)  FIXED BINARY(31) array, PL/I 1..n
 *   F_BITA(name, n)           BIT(1) array, PL/I 1..n
 *   F_CHRA(name, n, len)      CHARACTER(len) array, PL/I 1..n
 *   F_I32M(name, r, c)        FIXED BINARY(31) matrix, PL/I 1..r,1..c
 *
 * Arrays are declared one element longer than the PL/I bound so that
 * subscripts stay 1-based and read like the original; element 0 is
 * never used and is not serialised.
 */

F_CHR (NAME,     8)
F_CHR (USERID,   8)
F_I32A(ABB,      150)
F_I32 (ABBNUM,   5)
F_I32A(ATLOC,    150)
