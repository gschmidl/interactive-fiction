Aug 31, 2026  16:33     /* Native Linux replacements for the MVS/TSO-specific external      */                          
1.4.1                                               Source Listing                                           Page 1     
    1  /* Native Linux replacements for the MVS/TSO-specific external      */
    2  /* routines used by the Adventure PL/I engine (TREAD/TWRITE/WHISPER */
    3  /* were originally WYLBUR/TSO terminal I/O; CLRSCRN/DECDATE were    */
    4  /* assembler; RANDU was Fortran; R062A10/WARNMSG were MVS dynamic   */
    5  /* allocation and broadcast-message helpers with no standalone      */
    6  /* equivalent).                                                     */
    7 
    8  /* TREAD mirrors the TREAD CSECT of the WELLPUT assembler module    */
    9  /* (tapecave/DECDATE.txt): TPUT the prompt if there is one, TGET a  */
   10  /* line of up to 133 bytes, then                                    */
   11  /*        GOTRTN   OC    0(133,R2),BLANKS   UPPER CASE THIS SUCKER  */
   12  /* i.e. OR the whole buffer with X'40', which in EBCDIC folds a-z   */
   13  /* to A-Z and leaves digits and punctuation alone.  The ASCII       */
   14  /* equivalent of that fold is done with TRANSLATE below; without it */
   15  /* the game only understands commands typed in capitals.            */
   16  /* CCODE returns the 3270 PF-key number; there is none here, so it  */
   17  /* is always 0 (a plain <ENTER>, which the engine treats as "just   */
   18  /* text").  End of file on stdin has no mainframe counterpart (TGET */
   19  /* on a dropped line loops forever in GETIN), so it ends the        */
   20  /* process rather than spinning.                                    */
   21 
   22  TREAD: PROCEDURE(PROMPT, PROMPTLEN, MSGAREA, OUTLEN, CCODE);
   23    DCL PROMPT    CHAR(133);
   24    DCL PROMPTLEN FIXED BIN(31);
   25    DCL MSGAREA   CHAR(133);
   26    DCL OUTLEN    FIXED BIN(31);
   27    DCL CCODE     FIXED BIN(31);
   28    DCL SYSCALL ENTRY RETURNS(FIXED BIN(31))
   29                  OPTIONS(ASM LINKAGE(SYSTEM)) EXT('_pli_Syscall');
   30    DCL (ADDR,TRANSLATE) BUILTIN;
   31    DCL CH CHAR(1);
   32    DCL RC FIXED BIN(31);
   33    DCL I FIXED BIN(31);
   34    DCL EOFHIT BIT(1);
   35    DCL DONE BIT(1);
   36    DCL NL CHAR(1) STATIC INIT('0A'X);
   37    DCL UPPER CHAR(26) STATIC INIT('ABCDEFGHIJKLMNOPQRSTUVWXYZ');
   38    DCL LOWER CHAR(26) STATIC INIT('abcdefghijklmnopqrstuvwxyz');
   39 
   40    IF PROMPTLEN > 0 THEN
   41      RC = SYSCALL(4, 1, ADDR(PROMPT), PROMPTLEN);
   42 
   43    MSGAREA = ' ';
   44    I = 0;
   45    EOFHIT = '0'B;
   46    DONE = '0'B;
   47  /* The loop is driven by DONE rather than by LEAVE on purpose.  Iron */
   48  /* Spring PL/I 1.4.1 mis-handles a LEAVE that sits inside a nested   */
   49  /* non-iterative "DO; ... END;" block: instead of leaving the        */
   50  /* enclosing iterative loop, as PL/I defines, it leaves only the     */
   51  /* inner block, so the LEAVE is a no-op.  Written the obvious way -  */
   52  /*     IF RC <= 0 THEN DO; EOFHIT = '1'B; LEAVE; END;                */
   53  /* - this loop spun forever on read() returning 0, and the game hung */
   54  /* at end of file instead of exiting.                                */
   55    DO WHILE(^DONE);
   56      RC = SYSCALL(3, 0, ADDR(CH), 1);
   57      IF RC <= 0
   58      THEN DO;
Aug 31, 2026  16:33     /* Native Linux replacements for the MVS/TSO-specific external      */                          
1.4.1                                               Source Listing                                           Page 2     
   59        EOFHIT = '1'B;
   60        DONE = '1'B;
   61        END;
   62      ELSE IF CH = '0A'X
   63      THEN DONE = '1'B;
   64      ELSE IF CH ^= '0D'X
   65      THEN IF I < 133 THEN DO;
   66          I = I + 1;
   67          SUBSTR(MSGAREA,I,1) = CH;
   68          END;
   69      END;
   70 
   71    IF EOFHIT & I = 0 THEN DO;             /* terminal went away */
   72      RC = SYSCALL(4, 1, ADDR(NL), 1);
   73      RC = SYSCALL(1, 0);                  /* _exit(0) */
   74      END;
   75 
   76    MSGAREA = TRANSLATE(MSGAREA, UPPER, LOWER);
   77    OUTLEN = I;
   78    CCODE = 0;
   79    END TREAD;

End of compilation. 
