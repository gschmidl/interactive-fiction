 3543  JUGGLE: PROCEDURE (OBJECT);                                            
 3544                                                                         
 3545          DCL OBJECT FIXED BIN(31);                                      
 3546          DCL (I,J)  FIXED BIN(31);                                      
 3547                                                                         
 3548  /*                                                                     
 3549     JUGGLE AN OBJECT BY PICKING IT UP AND PUTTING IT DOWN               
 3550     AGAIN, THE PURPOSE BEING TO GET THE OBJECT TO THE FRONT             
 3551     OF THE CHAIN OF THINGS AT ITS LOC.                                  
 3552  */                                                                     
 3553                                                                         
 3554          I=PLACE(OBJECT);                                               
 3555          J=FIXED(OBJECT);                                               
 3556          CALL MOVE(OBJECT,I);                                           
 3557          CALL MOVE(OBJECT+100,J);                                       
 3558          RETURN;                                                        
 3559          END JUGGLE;                                                    
 3560                                                                         
