 4469  GETMSGS: PROCEDURE (UID,X);                                            
 4470                                                                         
 4471          DCL UID   CHARACTER(8);                                        
 4472          DCL X     CHARACTER(1);                                        
 4473          DCL UPDTE CHARACTER(1);                                        
 4474                                                                         
 4475  /*                                                                     
 4476        UPDTE SAYS WHETHER THE MESSAGE RECORD HAS TO BE REWRITTEN.       
 4477        X: A - ALL MESSAGES                    (MAIL, NOTICES)           
 4478           B - BROADCAST MESSAGES ONLY         (NOMAIL, NOTICES)         
 4479           M - MAIL ONLY                       (MAIL, NONOTICES)         
 4480           W - WIZARD LISTING MSG USE  (EVERYBODY'S MAIL, NOTICES)       
 4481                                                                      */ 
 4482                                                                         
 4483          UPDTE = 'N';                                                   
 4484          OPEN FILE (STORAGE) UPDATE;                                    
 4485          DO J = 1 TO 2;                                                 
 4486               READ FILE (STORAGE) INTO (ADVREC);                        
 4487               IF NOSTG                                                  
 4488               THEN DO;                                                  
 4489                    NOSTG = '0'B;                                        
 4490                    CLOSE FILE (STORAGE);                                
 4491                    IF J = 1                                             
 4492                    THEN CALL MSPEAK(34);               /* EMPTY FILE */ 
 4493                    ELSE CALL MSPEAK(35);               /* NO STORAGE */ 
 4494                    RETURN;                                              
 4495                    END;                                                 
 4496          END;                                                           
 4497          DO J = 0 TO 59;                                                
 4498               CARD = SUBSTR(ADVREC,J*80+1,80);                          
 4499               IF SUBSTR(CARD,1,1) = ' ' THEN GO TO NOMAIL; /* NEXT J */ 
 4500               DO L = 1 TO 40;                                           
 4501                    COLS(L) = -COLS(L);                                  
 4502                    END;                                                 
 4503               IF X = 'M' THEN GO TO MAIL;                               
 4504               IF SUBSTR(CARD,80,1) = '*' |     /* BROADCAST MESSAGES */ 
 4505                 (X = 'W' & SUBSTR(CARD,73,1) ^= ' ')  /* ALL FOR WIZ */ 
 4506               THEN DO;                                                  
 4507                    OUTSTR = SUBSTR(CARD,1,79);                          
 4508                    CALL LINEOUT;                                        
 4509                    END;                                                 
 4510               IF X = 'B' THEN GO TO NOMAIL;       /* NOTICES, NOMAIL */ 
 4511  MAIL:        IF SUBSTR(CARD,73,7) = SUBSTR(UID,1,7)                    
 4512               THEN DO;                                                  
 4513                    OUTSTR = SUBSTR(CARD,1,72);                          
 4514                    CALL LINEOUT;                                        
 4515                    SUBSTR(ADVREC,J*80+1,80) = ' ';                      
 4516                    UPDTE = 'Y';                                         
 4517                    END;                                                 
 4518  NOMAIL:      END;                                                      
 4519          IF UPDTE = 'Y'                                                 
 4520          THEN REWRITE FILE (STORAGE) FROM (ADVREC);                     
 4521          CLOSE FILE (STORAGE);                                          
 4522          RETURN;                                                        
 4523                                                                         
 4524          END GETMSGS;                                                   
