 3442          IF Y < 0 THEN CALL MSPEAK(-Y);                                 
 3443          RETURN('1'B);                                                  
 3444  L20:    IF Z > 0 THEN CALL RSPEAK(Z);                                  
 3445          IF Z < 0 THEN CALL MSPEAK(-Z);                                 
 3446          RETURN('0'B);                                                  
 3447          END YES;                                                       
