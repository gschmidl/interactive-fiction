 4370  PUTBACK: PROCEDURE;                                                    
 4371                                                                         
 4372  /*                                                                     
 4373          RESTORE SUSPENDED GAME:                                        
 4374          CARD# IS USED TO COUNT NUMBER OF SAVED GAMES THIS USER HAS     
 4375          ADVREC IS USED AS A TEMPORARY STORAGE AREA                     
 4376            BYTES  1 -> 8      ENCODED USERID                            
 4377            BYTES  9 -> 16     NAME OF GAME                              
 4378            BYTES 17 -> 24     ENCODED NAME OF GAME                      
 4379  */                                                                     
 4380                                                                         
 4381          CARD# = 0;                                                     
 4382          SUBSTR(ADVREC,1,8) = USERID;                                   
 4383          SUBSTR(ADVREC,9,8) = WD2 || SUBSTR(WD2X,1,3);                  
 4384          IF WD2 = ' '                                                   
 4385          THEN SUBSTR(ADVREC,17,8) = LOW(8);                             
 4386          ELSE DO;                                                       
 4387               PW = SUBSTR(ADVREC,9,4);                                  
 4388               TEST_WORD = -TEST_WORD;                                   
 4389               SUBSTR(ADVREC,17,4) = PW;                                 
 4390               PW = SUBSTR(ADVREC,13,4);                                 
 4391               TEST_WORD = -TEST_WORD;                                   
 4392               SUBSTR(ADVREC,21,4) = PW;                                 
 4393               END;                                                      
 4394          OPEN FILE (STORAGE) UPDATE;                                    
 4395          STGREC = 0;
 4396  BRWSE:  READ FILE (STORAGE) INTO (ADVARS);                             
 4397          STGREC = STGREC + 1;
 4398          IF NOSTG                                                       
 4399          THEN DO;                                                       
 4400               CLOSE FILE (STORAGE);                                     
 4401               CALL CLRSCRN;                                             
 4402               CALL MSPEAK(47);           /* SUSPENDED GAME NOT FOUND */ 
 4403               INHIB = 'Y';                                              
 4404               CALL MSPEAK(49);       /* REPORT NUMBER OF GAMES FOUND */ 
 4405               SUBSTR(OUTSTR,1,4) = SEQ#;                                
 4406               SUBSTR(OUTSTR,22,8) = TSOID;                              
 4407               CALL LINEOUT;                                             
 4408               IF SUBSTR(ADVREC,9,1) ^= ' '         /* NAME WAS GIVEN */ 
Aug 31, 2026  16:33     /***              ADVENTURE  -  PL/1 VERSION 4.0                  ***/                          
1.4.1                                               Source Listing                                           Page 77    
 4409               THEN DO;                                                  
 4410                    INHIB = 'Y';                                         
 4411                    CALL MSPEAK(50);                /* GAME NOT SAVED */ 
 4412                    SUBSTR(OUTSTR,1,8) = SUBSTR(ADVREC,9,8);             
 4413                    SUBSTR(OUTSTR,29,8) = TSOID;                         
 4414                    INHIB = 'N';                                         
 4415                    CALL LINEOUT;                                        
 4416                    END;                                                 
 4417               CALL LINESKP;                                             
 4418               GOTO DEALLOC;                                             
 4419               END;                                                      
 4420          IF USERID ^= SUBSTR(ADVREC,1,8) THEN GO TO BRWSE;              
 4421          CARD# = CARD# + 1;                                             
 4422          IF NAME ^= SUBSTR(ADVREC,17,8) THEN GO TO BRWSE;               
 4423                                                                         
 4424          IF VERSION ^= 'V4.0'                      /*** FOUND GAME ***/ 
 4425          THEN DO;                            /** INCOMPATIBLE LEVEL **/ 
 4426               CLOSE FILE (STORAGE);                                     
 4427               CALL MSPEAK(46);                                          
 4428               CALL LINESKP;                                             
 4429               GOTO DEALLOC;                                             
 4430               END;                                                      
 4431          IF DATE_PIC = TODAY                                            
 4432          THEN DO;                        /* GAME WAS SUSPENDED TODAY */ 
 4433               IF PIC_HHMM - HHMM < 100                                  
 4434               THEN DO;                      /* LESS THAN AN HOUR AGO */ 
 4435                    CLOSE FILE (STORAGE);                                
 4436                    CALL CLRSCRN;                                        
 4437                    CALL MSPEAK(2);                                      
 4438                    CALL MSPEAK(9);                                      
 4439                    CALL LINESKP;                                        
 4440                    GOTO DEALLOC;                                        
 4441                    END;                                                 
 4442               IF PIC_HHMM - HHMM < 200 & ^ WIZARD                       
 4443               THEN DO;                      /* LESS THAN 2 HOURS AGO */ 
 4444                    CLOSE FILE (STORAGE);                                
 4445                    CALL CLRSCRN;                                        
 4446                    CALL MSPEAK(8);                                      
 4447                    CALL MSPEAK(9);                                      
 4448                    CALL LINESKP;                                        
 4449                    GOTO DEALLOC;                                        
 4450                    END;                                                 
 4451               END;                                                      
 4452          ADVREC = ' ';                                                  
 4453          CALL STGWR(STGREC, ADDR(ADVREC));
 4454          CLOSE FILE (STORAGE);                                          
 4455          INHIB = 'Y';                                                   
 4456          CALL MSPEAK(51);                    /* REPORT RESTORE STATS */ 
 4457          PUT STRING (INSTR) EDIT (SUSPEND#,TURNS,ELAPSED)               
 4458                                          (F(3),F(4),F(4));              
 4459          SUBSTR(OUTSTR,12,3) = SUBSTR(INSTR,1,3);                       
 4460          SUBSTR(OUTSTR,21,4) = SUBSTR(INSTR,4,4);                       
 4461          SUBSTR(OUTSTR,34,4) = SUBSTR(INSTR,8,4);                       
 4462          INHIB = 'N';                                                   
 4463          CALL LINEOUT;                                                  
 4464          CALL LINESKP;                                                  
 4465          CARD# = 0;                                                     
 4466          RETURN;                                                        
