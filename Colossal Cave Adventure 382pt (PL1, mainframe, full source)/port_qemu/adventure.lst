 3451  A5TOA1: PROCEDURE (A,B,CHARS,LENG);                                    
 3452                                                                         
 3453  /*                                                                     
 3454    A AND B CONTAIN A 1-10 CHARACTER WORD IN A5 FORMAT.                  
 3455    THEY ARE CONCATENATED AND MOVED INTO A CHAR(1)                       
 3456    ARRAY UNTIL A BLANK IS ENCOUNTERED.  THE TOTAL                       
 3457    LENGTH IS RETURNED IN LENG.                                          
 3458                                                                         
 3459  */                                                                     
 3460                                                                         
 3461          DCL (A,B) CHAR(5);                                             
 3462          DCL LENG FIXED BIN(31);                                        
 3463          DCL CHARS(10) CHAR(1) CONNECTED;                               
 3464                                                                         
 3465          DCL WORDS(2) CHAR(5);                                          
 3466                                                                         
 3467          WORDS(1)=TRANSLATE(A,XLATETO,                                  
 3468                               XLATEFR);                                 
 3469          WORDS(2)=TRANSLATE(B,XLATETO,                                  
 3470                               XLATEFR);                                 
 3471          LENG=0;                                                        
 3472          DO WORD=1 TO 2;                                                
 3473              DO CH=1 TO 5;                                              
 3474                  CHARS(LENG+1)=SUBSTR(WORDS(WORD),CH,1);                
 3475                  IF CHARS(LENG+1) = ' ' THEN RETURN;                    
 3476                  LENG=LENG+1;                                           
 3477                  END;                                                   
 3478              END;                                                       
 3479          RETURN;                                                        
 3480          END A5TOA1;                                                    
