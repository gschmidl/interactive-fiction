 3563  MOVE:   PROCEDURE (OBJECT,WHERE);                                      
 3564                                                                         
 3565          DCL (OBJECT,WHERE) FIXED BIN(31);                              
 3566                                                                         
 3567  /*                                                                     
 3568     PLACE ANY OBJECT ANYWHERE BY PICKING IT UP AND DROPPING             
 3569     IT.  MAY ALREADY BE TOTING, IN WHICH CASE THE CARRY IS A            
 3570     NO-OP.  MUSTN'T PICK UP OBJECTS WHICH ARE NOT AT ANY LOC,           
 3571     SINCE CARRY WANTS TO REMOVE OBJECTS FROM ATLOC CHAINS.              
 3572  */                                                                     
 3573                                                                         
 3574          IF OBJECT > 100 THEN GOTO L1;                                  
 3575          FROM=PLACE(OBJECT);                                            
 3576          GOTO L2;                                                       
 3577  L1:     FROM=FIXED(OBJECT-100);                                        
 3578  L2:     IF FROM > 0 & FROM <= 300 THEN CALL CARRY(OBJECT,FROM);        
 3579          CALL DROP(OBJECT,WHERE);                                       
 3580          RETURN;                                                        
 3581          END MOVE;                                                      
 3582                                                                         
 3583                                                                         
