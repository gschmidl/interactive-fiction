1.4.1                                               Source Listing                                           Page 79    
 4525                                                                         
 4526   /*  CONVERT THE SUPPLIED DATE TO AN EDCDIC STRING OF FORM:         */ 
 4527   /*  WWWWWW---  DD MMM------ YYYY    EX:  FRIDAY  31 DECEMBER 1999  */ 
 4528   /*  ZELLERS CONGRUENCE FORMULA IS USED TO DETERMINE THE DAY OF THE */ 
 4529   /*  WEEK: INDEX-INTO-WEEKDAY-NAME-TABLE (0-6) =                    */ 
 4530   /*    MOD((MM-2) * 2.6 - 0.2 + DD + YY + (CC/4) - (CC * 2)),7)     */ 
 4531   /*  NOTE: INTEGER ARITHMETIC IS USED IN ALL CALCULATIONS THUS      */ 
 4532   /*        DROPPING ANY FRACTIONS/REMAINDERS                        */ 
 4533                                                                         
 4534  THISDAY: PROCEDURE (RSTRING);                                          
 4535                                                                         
 4536     DCL RSTRING                  CHARACTER(133)  VARYING;               
 4537     DCL DAY                      FIXED DEC(3,0),                        
 4538         MONTH                    CHARACTER  (9)  VARYING,               
 4539         YEAR                     FIXED DEC(5,0),                        
 4540         (IM, MM, DD, CC, YY)     FIXED BIN(15,0);                       
 4541     DCL (WORKBIN1, WORKBIN2, WORKBIN3, WORKBIN4) FIXED BIN (15,0);      
 4542                                                                         
 4543     YY = PIC_YEAR;                                                      
 4544     IM = PIC_MONTH;                                                     
 4545     DAY = PIC_DAY;                                                      
 4546     MONTH = CMONTH(IM);          /* EBCDIC MONTH            */          
 4547                                                                         
 4548    /*   ZELLERS CONGRUENCE USED TO DETERMINE DAY OF WEEK            */  
 4549     DD = DAY;                                                           
 4550     CC = YY / 100;           /* CENTURY       */                        
 4551     YY = YY - (CC * 100);    /* YEAR IN CENTURY */                      
 4552     MM = IM - 2;                                                        
 4553     IF MM <= 0 THEN                                                     
 4554     DO;                                                                 
 4555       MM = MM + 12;          /* MONTHS + 12   */                        
 4556       YY = YY - 1;           /* YEAR - 1      */                        
 4557       IF YY < 0 THEN                                                    
 4558       DO;                                                               
 4559         YY = 99;                                                        
 4560         CC = CC - 1;         /* CENTURY - 1   */                        
 4561       END;                                                              
 4562     END;                                                                
 4563     WORKBIN1 = (((MM * 26) - 2) / 10);                                  
 4564     WORKBIN2 = (YY / 4);                                                
 4565     WORKBIN3 = (CC / 4);                                                
 4566     WORKBIN4 = (CC * 2);                                                
 4567     DAY# = MOD((WORKBIN1 + DD + YY + WORKBIN2 + WORKBIN3 - WORKBIN4),7);
 4568     PUT STRING(RSTRING) EDIT(WEEK_DAY(DAY#),DAY,MONTH,PIC_YEAR)         
 4569                             (A,P'Z9',X(1),A,X(1),A);                    
 4570                                                                         
 4571     END THISDAY;                                                        
