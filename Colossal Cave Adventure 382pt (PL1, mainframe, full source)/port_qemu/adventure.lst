 3368                        CALL CLRSCRN;                                    
 3369                        SELECT (CCODE);                                  
 3370                        WHEN (01) WD1 = 'H    ';                         
 3371                        WHEN (02) WD1 = 'I    ';                         
 3372                        WHEN (03) WD1 = 'Q    ';                         
 3373                        WHEN (04) WD1 = 'LOG  ';                         
 3374                        WHEN (09) IF WIZARD THEN WD1 = 'SWAP ';          
 3375                        WHEN (12) WD1 = 'EXIT ';                         
 3376                        WHEN (14) DO;               /* RESHOW FOR PA2 */ 
 3377                                  OUTSTR = RETRYSTR;                     
 3378                                  CALL LINEOUT;                          
 3379                                  GO TO RETRY;                           
 3380                                  END;                                   
 3381                        OTHERWISE GO TO ENTER;                           
 3382                        END;                                             
 3383                        RETURN;                                          
 3384                        END;                                             
 3385  ENTER:          OUTSTR=SUBSTR(INSTR,1,INLEN);                          
 3386                  WORDSTRT=VERIFY(OUTSTR,' ');                           
 3387                  END;                                                   
 3388              ELSE DO;                                                   
 3389                  IF BLKLIN THEN CALL LINESKP;                           
 3390                  PUT STRING (OUTSTR) EDIT                               
 3391                     ('Terminal error..reenter.') (A);                   
 3392                  CALL LINEOUT;                                          
 3393                  END;                                                   
 3394  RETRY:      END;                                 /* END OF DO WHILE */ 
 3395          IF LOGON THEN PUT SKIP EDIT (OUTSTR) (A);                      
 3396          OUTSTR=SUBSTR(OUTSTR,WORDSTRT);                                
 3397          WORDEND=INDEX(OUTSTR,' ')-1;                                   
 3398          IF WORDEND=-1 THEN WORDEND=LENGTH(OUTSTR);                     
 3399          WORDSIZE=MIN(WORDEND,5);                                       
 3400          WORD1=SUBSTR(OUTSTR,1,WORDSIZE);                               
 3401          IF WORDEND > 5 THEN DO;                                        
 3402              WORDSIZE=MIN(WORDEND-5,5);                                 
 3403              WORD1X=SUBSTR(OUTSTR,6,WORDSIZE);                          
 3404              END;                                                       
 3405          IF WORDEND=LENGTH(OUTSTR) THEN RETURN;                         
 3406          OUTSTR=SUBSTR(OUTSTR,WORDEND+1);                               
 3407          WORDSTRT=VERIFY(OUTSTR,' ');                                   
 3408          IF WORDSTRT = 0 THEN RETURN;                                   
 3409          OUTSTR=SUBSTR(OUTSTR,WORDSTRT);                                
 3410          WORDEND=INDEX(OUTSTR,' ')-1;                                   
 3411          IF WORDEND = -1 THEN WORDEND=LENGTH(OUTSTR);                   
 3412          WORDSIZE=MIN(WORDEND,5);                                       
 3413          WORD2=SUBSTR(OUTSTR,1,WORDSIZE);                               
 3414          IF WORDEND > 5 THEN DO;                                        
 3415              WORDSIZE=MIN(WORDEND-5,5);                                 
 3416              WORD2X=SUBSTR(OUTSTR,6,WORDSIZE);                          
 3417              END;                                                       
 3418          RETURN;                                                        
 3419          END GETIN;                                                     
