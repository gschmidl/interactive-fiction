 3601  CARRY:  PROCEDURE (OBJECT,WHERE);                                      
 3602                                                                         
 3603          DCL (OBJECT,WHERE) FIXED BIN(31);                              
 3604                                                                         
 3605  /*                                                                     
 3606     START TOTING AN OBJECT, REMOVING IT FROM THE LIST OF                
 3607     THINGS AT ITS FORMER LOCATION.  INCR HOLDNG UNLESS IT WAS           
 3608     ALREADY BEING TOTED.  IF OBJECT>100 (MOVING "FIXED"                 
 3609     SECOND LOC), DON'T CHANGE PLACE OR HOLDNG.                          
 3610  */                                                                     
 3611                                                                         
 3612                                                                         
 3613                                                                         
 3614          IF OBJECT > 100 THEN GOTO L5;                                  
 3615          IF PLACE(OBJECT) = -1 THEN RETURN;                             
 3616          PLACE(OBJECT)=-1;                                              
 3617          HOLDNG=HOLDNG+1;                                               
 3618  L5:     IF ATLOC(WHERE) ^= OBJECT THEN GOTO L6;                        
 3619          ATLOC(WHERE)=LINK(OBJECT);                                     
 3620          RETURN;                                                        
 3621  L6:     TEMP=ATLOC(WHERE);                                             
 3622  L7:     IF LINK(TEMP) = OBJECT THEN GOTO L8;                           
 3623          TEMP=LINK(TEMP);                                               
 3624          GOTO L7;                                                       
 3625  L8:     LINK(TEMP)=LINK(OBJECT);                                       
 3626          RETURN;                                                        
 3627          END CARRY;                                                     
 3628                                                                         
 3629                                                                         
 3630                                                                         
 3631  DROP:   PROCEDURE (OBJECT,WHERE);                                      
 3632                                                                         
 3633          DCL (OBJECT,WHERE) FIXED BIN(31);                              
 3634                                                                         
 3635  /*                                                                     
 3636     PLACE AN OBJECT AT A GIVEN LOC, PREFIXING IT ONTO THE               
 3637     ATLOC LIST.  DECR HOLDNG IF THE OBJECT WAS BEING TOTED.             
 3638  */                                                                     
 3639                                                                         
 3640          IF OBJECT > 100 THEN GOTO L1;                                  
 3641          IF PLACE(OBJECT) = -1 THEN HOLDNG=HOLDNG-1;                    
 3642          PLACE(OBJECT)=WHERE;                                           
 3643          GOTO L2;                                                       
 3644  L1:     FIXED(OBJECT-100)=WHERE;                                       
 3645  L2:     IF WHERE <= 0 THEN RETURN;                                     
 3646          LINK(OBJECT)=ATLOC(WHERE);                                     
 3647          ATLOC(WHERE)=OBJECT;                                           
 3648          RETURN;                                                        
 3649          END DROP;                                                      
