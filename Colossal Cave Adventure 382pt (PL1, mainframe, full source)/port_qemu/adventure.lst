 1001  /*                                                                     
 1002     TREASURES, AS NOTED EARLIER, ARE OBJECTS 50 THROUGH                 
 1003     MAXTRS (CURRENTLY 79).  THEIR PROPS ARE INITIALLY -1, AND           
 1004     ARE SET TO 0 THE FIRST TIME THEY ARE DESCRIBED.  TALLY              
 1005     KEEPS TRACK OF HOW MANY ARE NOT YET FOUND, SO WE KNOW               
 1006     WHEN TO CLOSE THE CAVE.  TALLY2 COUNTS HOW MANY CAN NEVER           
 1007     BE FOUND (E.G.  IF LOST BIRD OR BRIDGE).                            
 1008  */                                                                     
 1009                                                                         
 1010          DO I=50 TO MAXTRS;                                             
 1011              IF PTEXT(I) ^= 0 THEN PROP(I)=-1;                          
 1012              TALLY=TALLY-PROP(I);                                       
 1013              END;                                                       
