  113                                                                         
  114  /* The original declared the next seven as "DEFINED DATE_STG POS(n)"   
  115     overlays.  Iron Spring PL/I 1.4.1 ignores POS(n) completely - both  
  116     reads and writes land on POS(1) - so they are BASED on explicit     
Aug 31, 2026  16:33     /***              ADVENTURE  -  PL/1 VERSION 4.0                  ***/                          
1.4.1                                               Source Listing                                           Page 3     
  117     interior pointers instead.  That reproduces the overlay exactly,    
  118     including the two assignments the game makes THROUGH an overlay in  
  119     order to update DATE_STG itself ("TIME_CHR = TIME();" in the        
  120     scoring code and "PIC_HHMM = HHMM;" in SCANSTG).  DEFINED with no   
  121     POS is handled correctly, so DATE_PIC/PIC_YEAR are left alone.      
  122     DSPTR5/7/9/11 are anchored just before the first executable stmt. */
  123                                                                         
  124        DCL (DSPTR5,DSPTR7,DSPTR9,DSPTR11)   POINTER STATIC;             
  125                                                                         
  126        DCL TIME_CHR            CHARACTER (9)    BASED(DSPTR9);          
  127        DCL CHR_HHMM            CHARACTER (4)    BASED(DSPTR9);          
  128                                                                         
  129        DCL DATE_PIC            PICTURE'99999999' DEFINED DATE_STG;      
  130        DCL PIC_YEAR            PICTURE'9999' DEFINED DATE_STG;          
  131        DCL PIC_MONTH           PICTURE'99'   BASED(DSPTR5);             
  132        DCL PIC_DAY             PICTURE'99'   BASED(DSPTR7);             
  133        DCL PIC_HHMM            PICTURE'9999' BASED(DSPTR9);             
  134        DCL PIC_HH              PICTURE'99'   BASED(DSPTR9);             
  135        DCL PIC_MM              PICTURE'99'   BASED(DSPTR11);            
  136                                                                         
  137        DCL PUTDATE             CHAR (10) STATIC INIT('    /  /  ');     
  138                                                                         
  139        DCL PUTHHMM             CHARACTER (5) STATIC INIT('  :  ');      
  140                                                                         
