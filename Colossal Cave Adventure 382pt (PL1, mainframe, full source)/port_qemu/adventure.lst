  953                                                                         
  954  /*                                                                     
  955     FINISH CONSTRUCTING INTERNAL DATA FORMAT                            
  956                                                                         
  957     HAVING READ IN THE DATABASE, CERTAIN THINGS ARE NOW                 
  958     CONSTRUCTED.  PROPS ARE SET TO ZERO.  WE FINISH SETTING             
  959     UP COND BY CHECKING FOR FORCED-MOTION TRAVEL ENTRIES.               
  960     THE PLAC AND FIXD ARRAYS ARE USED TO SET UP ATLOC(N) AS             
  961     THE FIRST OBJECT AT LOCATION N, AND LINK(OBJ) AS THE NEXT           
  962     OBJECT AT THE SAME LOCATION AS OBJ.  (OBJ>100 INDICATES             
  963     THAT FIXED(OBJ-100)=LOC - LINK(OBJ) IS STILL THE CORRECT            
  964     LINK TO USE.) ABB IS ZEROED- IT CONTROLS WHETHER THE                
  965     ABBREVIATED DESCRIPTION IS PRINTED.  COUNTS MOD 5 UNLESS            
  966     "LOOK" IS USED.                                                     
  967  */                                                                     
  968                                                                         
  969  L1100:  CLOSE FILE (OBJECT);                        /* FREE BUFFERS */ 
  970          DO I=1 TO LOCSIZ;                                              
  971          IF LTEXT(I) = 0 | KEY(I) = 0 THEN GOTO L1102;                  
  972          K=KEY(I);                                                      
  973          IF MOD(ABS(TRAVEL(K)),1000) = 1 THEN COND(I)=2;                
  974  L1102:  END;                                                           
  975                                                                         
  976  /*                                                                     
  977     SET UP THE ATLOC AND LINK ARRAYS AS DESCRIBED ABOVE.                
  978     WE'LL USE THE DROP SUBROUTINE, WHICH PREFACES NEW OBJECTS           
  979     ON THE LISTS.  SINCE WE WANT THINGS IN THE OTHER ORDER,             
  980     WE'LL RUN THE LOOP BACKWARDS.  IF THE OBJECT IS IN TWO              
  981     LOCS, WE DROP IT TWICE.  THIS ALSO SETS UP "PLACE" AND              
  982     "FIXED" AS COPIES OF "PLAC" AND "FIXD".  ALSO, SINCE                
  983     TWO-PLACED OBJECTS ARE TYPICALLY BEST DESCRIBED LAST,               
  984     WE'LL DROP THEM FIRST.  (ZEROED IN DECLARATIONS.)                   
  985  */                                                                     
  986                                                                         
