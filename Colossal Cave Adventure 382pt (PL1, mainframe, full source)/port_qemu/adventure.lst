 3486  VOCAB: PROCEDURE (ID,INIT) RETURNS(FIXED BIN(31));                     
 3487                                                                         
 3488         DCL ID CHAR(5);                                                 
 3489         DCL INIT FIXED BIN(31);                                         
 3490         DCL I    FIXED BIN(31);                                         
 3491         DCL VOCRTN FIXED BIN(31);                                       
 3492         DCL IDB  BIT(40) BASED(ADDR(ID));                               
 3493                                                                         
 3494  /*                                                                     
 3495     LOOK UP ID IN THE VOCABULARY (ATAB) AND RETURN ITS                  
 3496     "DEFINITION" (KTAB), OR -1 IF NOT FOUND.  IF INIT IS NON-           
 3497     NEGATIVE, THIS IS AN INITIALISATION CALL SETTING UP A               
 3498     KEYWORD VARIABLE, AND NOT FINDING IT CONSTITUTES A BUG.             
 3499     IT ALSO MEANS THAT ONLY KTAB VALUES WHICH TAKEN OVER 1000           
 3500     EQUAL INIT MAY BE CONSIDERED.  (THUS "STEPS", WHICH IS A            
 3501     MOTION VERB AS WELL AS AN OBJECT, MAY BE LOCATED AS AN              
 3502     OBJECT.)  AND IT ALSO MEANS THE KTAB VALUE IS TAKEN MOD             
 3503     1000.                                                               
 3504  */                                                                     
 3505                                                                         
 3506                                                                         
 3507          IDB = ^IDB;                                                    
 3508          DO I=1 TO TABSIZ;                                              
 3509              IF KTAB(I) = -1 THEN GOTO L2;                              
 3510              IF INIT >= 0 & KTAB(I)/1000 ^= INIT THEN GOTO L1;          
 3511              IF ATAB(I) = ID THEN GOTO L3;                              
 3512  L1:         END;                                                       
 3513          CALL BUG(21);                                                  
 3514                                                                         
 3515  L2:     IDB = ^IDB;                                                    
 3516          IF INIT < 0 THEN RETURN(-1);                                   
 3517          CALL BUG(5);                                                   
 3518                                                                         
 3519  L3:     VOCRTN=KTAB(I);                                                
 3520          IF INIT >= 0 THEN VOCRTN=MOD(VOCRTN,1000);                     
 3521          IDB = ^IDB;                                                    
 3522          RETURN(VOCRTN);                                                
 3523          END VOCAB;                                                     
 3524                                                                         
 3525                                                                         
