  936  /* READ DATA FOR HINTS. */                                             
  937                                                                         
  938  L1080:  HNTMAX=0;                                                      
  939  L1081:  READ FILE (OBJECT) INTO (CARD);                                
  940          IF EOCARD THEN CALL BUG(10);                                   
  941          IF SUBSTR(CARD,1,1) = HEX02                                    
  942          THEN CALL REVERT;                                              
  943          GET STRING (CARD) EDIT (K,(TK(I) DO I=1 TO 4))                 
  944               (5 F(8));                                                 
  945          IF K = -1 THEN GOTO L1002;                                     
