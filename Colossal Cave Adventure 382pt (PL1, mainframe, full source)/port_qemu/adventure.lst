  922          IF EOCARD THEN CALL BUG(10);                                   
  923          IF SUBSTR(CARD,1,1) = HEX02                                    
  924          THEN CALL REVERT;                                              
  925          GET STRING (CARD) EDIT (K,(TK(I) DO I=1 TO 9))                 
  926               (10 F(8));                                                
  927          IF K = -1 THEN GOTO L1002;                                     
  928          DO I=1 TO 9;                                                   
