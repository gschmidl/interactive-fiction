  837  /*                                                                     
  838     THE STUFF FOR SECTION 3 IS ENCODED HERE.  EACH                      
  839     "FROM-LOCATION" GETS A CONTIGUOUS SECTION OF THE "TRAVEL"           
  840     ARRAY.  EACH ENTRY IN TRAVEL IS NEWLOC*1000 + KEYWORD               
  841     (FROM SECTION 4, MOTION VERBS), AND IS NEGATED IF THIS IS           
  842     THE LAST ENTRY FOR THIS LOCATION.  KEY(N) IS THE INDEX IN           
  843     TRAVEL OF THE FIRST OPTION AT LOCATION N.                           
  844  */                                                                     
  845                                                                         
  846  L1030:  READ FILE (OBJECT) INTO (CARD);                                
  847          IF EOCARD THEN CALL BUG(10);                                   
  848          IF SUBSTR(CARD,1,1) = HEX02                                    
  849          THEN CALL REVERT;                                              
  850          GET STRING (CARD) EDIT                                         
  851               (LOC,NEWLOC,(TK(I) DO I=1 TO 8)) (10 F(8));               
  852          IF LOC = -1 THEN GOTO L1002;                                   
  853          IF KEY(LOC) ^= 0 THEN GOTO L1033;                              
  854          KEY(LOC)=TRVS;                                                 
  855          GOTO L1035;                                                    
  856  L1033:  TRAVEL(TRVS-1)=-TRAVEL(TRVS-1);                                
  857  L1035:  DO L=1 TO 8;                                                   
  858              IF TK(L) = 0 THEN GOTO L1039;                              
  859              TRAVEL(TRVS)=NEWLOC*1000+TK(L);                            
  860              TRVS=TRVS+1;                                               
  861              IF TRVS = TRVSIZ THEN CALL BUG(3);                         
  862              END;                                                       
  863                                                                         
  864  L1039:  TRAVEL(TRVS-1)=-TRAVEL(TRVS-1);                                
  865          GOTO L1030;                                                    
  866                                                                         
  867  /*                                                                     
  868     HERE WE READ IN THE VOCABULARY.  KTAB(N) IS THE WORD                
  869     NUMBER, ATAB(N) IS THE CORRESPONDING WORD.  THE -1 AT THE           
  870     END OF SECTION 4 IS LEFT IN KTAB AS AN END-MARKER.  THE             
Aug 31, 2026  16:33     /***              ADVENTURE  -  PL/1 VERSION 4.0                  ***/                          
1.4.1                                               Source Listing                                           Page 16    
  871     WORDS ARE GIVEN A MINIMAL HASH TO MAKE READING THE                  
  872     CORE-IMAGE HARDER.  NOTE THAT '/7-08' HAD BETTER NOT BE             
  873     IN THE LIST, SINCE IT COULD HASH TO -1.  (HASHING REMOVED           
  874     IN PL/1 VERSION..BRD) (NEW HASH ADDED..GP)                          
  875  */                                                                     
  876                                                                         
  877  L1040:  DO TABNDX=1 TO TABSIZ;                                         
  878          READ FILE (OBJECT) INTO (CARD);                                
  879          IF EOCARD THEN CALL BUG(10);                                   
  880          IF SUBSTR(CARD,1,1) = HEX02                                    
  881          THEN CALL REVERT;                                              
  882          GET STRING (CARD) EDIT                                         
  883                (KTAB(TABNDX),ATAB(TABNDX)) (F(8),A (5));                
  884          IF KTAB(TABNDX) = -1 THEN GOTO L1002;                          
  885          ATABB(TABNDX) = ^ATABB(TABNDX);                                
  886          END;                                                           
  887          CALL BUG(4);                                                   
  888                                                                         
  889  /*                                                                     
  890     READ IN THE INITIAL LOCATIONS FOR EACH OBJECT.  ALSO THE            
  891     IMMOVABILITY INFO.  PLAC CONTAINS INITIAL LOCATIONS OF              
  892     OBJECTS.  FIXD IS -1 FOR IMMOVABLE OBJECTS (INCLUDING THE           
  893     SNAKE), OR = SECOND LOC FOR TWO-PLACED OBJECTS.                     
  894  */                                                                     
  895                                                                         
  896  L1050:  READ FILE (OBJECT) INTO (CARD);                                
  897          IF EOCARD THEN CALL BUG(10);                                   
  898          IF SUBSTR(CARD,1,1) = HEX02                                    
  899          THEN CALL REVERT;                                              
  900          GET STRING (CARD) EDIT (OBJ,J,K) (3 F(8));                     
  901          IF OBJ = -1 THEN GOTO L1002;                                   
  902          PLAC(OBJ)=J;                                                   
  903          FIXD(OBJ)=K;                                                   
  904          GOTO L1050;                                                    
  905                                                                         
  906  /* READ DEFAULT MESSAGE NUMBERS FOR ACTION VERBS, STORE IN             
  907     ACTSPK.  */                                                         
  908                                                                         
  909  L1060:  READ FILE (OBJECT) INTO (CARD);                                
  910          IF EOCARD THEN CALL BUG(10);                                   
  911          IF SUBSTR(CARD,1,1) = HEX02                                    
  912          THEN CALL REVERT;                                              
  913          GET STRING (CARD) EDIT (VERB,J) (2 F(8));                      
  914          IF VERB = -1 THEN GOTO L1002;                                  
  915          ACTSPK(VERB)=J;                                                
