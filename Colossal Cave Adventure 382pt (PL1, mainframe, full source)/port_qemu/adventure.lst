 3270  SPEAK:  PROCEDURE (N);                                                 
 3271                                                                         
 3272          DCL N FIXED BIN(31);                                           
 3273          DCL (I,K,L) FIXED BIN (31);                                    
 3274                                                                         
 3275  /*                                                                     
 3276     PRINT THE MESSAGE WHICH STARTS AT LINES(N).  PRECEDE IT             
 3277     WITH A BLANK LINE UNLESS BLKLIN IS FALSE.                           
 3278     INHERENT MESSAGE TEXT WORD LIMIT INCREASED FROM 9999 TO 49999 -     
 3279                                                (GP 12/82)               
 3280  */                                                                     
 3281                                                                         
 3282          IF N = 0 THEN RETURN;                                          
 3283          IF LINES(N+1) = '>$<' THEN RETURN;                             
 3284          IF (BLKLIN) THEN CALL LINESKP;                                 
 3285          K=N;                                                           
 3286  L1:     YDCHR=LINES(K);                                                
 3287          L=MOD(YDPIC,50000)-1;                                          
 3288          K=K+1;                                                         
 3289          PUT STRING (OUTSTR) EDIT ((LINES(I) DO I=K TO L)) (14 A(5));   
 3290          IF INHIB = 'Y' THEN RETURN;                                    
 3291          CALL LINEOUT;                                                  
 3292          K=L+1;                                                         
 3293          IF SUBSTR(LINES(K),1,1) < '5' THEN GOTO L1;                    
 3294          RETURN;                                                        
 3295          END SPEAK;                                                     
