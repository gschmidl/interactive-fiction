 3035  /*                                                                     
 3036     EXIT CODE.  WILL EVENTUALLY INCLUDE SCORING.  FOR NOW, HOWEVER, ... 
 3037                                                                         
 3038     THE PRESENT SCORING ALGORITHM IS AS FOLLOWS:                        
 3039        OBJECTIVE:          POINTS:        PRESENT TOTAL POSSIBLE:       
 3040     GETTING WELL INTO CAVE   25                    25                   
 3041     EACH TREASURE < CHEST    12                    60                   
 3042     TREASURE CHEST ITSELF    14                    14                   
 3043     EACH TREASURE > CHEST    16                   144                   
 3044     SURVIVING             (MAX-NUM)*10             30                   
 3045     NOT QUITTING              4                     4                   
 3046     REACHING "CLOSNG"        25                    25                   
 3047     "CLOSED": QUIT/KILLED    10                                         
 3048               KLUTZED        25                                         
 3049               WRONG WAY      30                                         
 3050               SUCCESS        45                    45                   
 3051     CAME TO WITT'S END        1                     1                   
 3052     ROUND OUT THE TOTAL       2                     2                   
 3053                                          TOTAL:   350                   
 3054     (POINTS CAN ALSO BE DEDUCTED FOR USING HINTS.)                      
 3055  */                                                                     
 3056                                                                         
 3057  L20000: SCORE=0;                                                       
 3058          MXSCOR=0;                                                      
 3059                                                                         
 3060  /*                                                                     
 3061     FIRST TALLY UP THE TREASURES.  MUST BE IN BUILDING AND              
 3062     NOT BROKEN.  GIVE THE POOR GUY 2 POINTS JUST FOR FINDING            
 3063     EACH TREASURE.                                                      
 3064  */                                                                     
 3065                                                                         
 3066          DO I=50 TO MAXTRS;                                             
 3067              IF PTEXT(I) ^= 0 THEN DO;                                  
 3068                  K=12;                                                  
 3069                  IF I = CHEST THEN K=14;                                
 3070                  IF I > CHEST THEN K=16;                                
 3071                  IF PROP(I) >= 0 THEN SCORE=SCORE+2;                    
 3072                  IF PLACE(I) = 3 & PROP(I) = 0 THEN SCORE=SCORE+K-2;    
 3073                  MXSCOR=MXSCOR+K;                                       
 3074                  END;                                                   
