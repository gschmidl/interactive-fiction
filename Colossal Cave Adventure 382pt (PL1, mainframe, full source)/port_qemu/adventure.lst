  142        DCL YDCHR               CHARACTER (5) STATIC INIT('00000');      
  143        DCL YDPIC               PICTURE '99999' DEFINED YDCHR;           
  144        DCL DIGIT               PICTURE '9' DEFINED YDCHR;               
