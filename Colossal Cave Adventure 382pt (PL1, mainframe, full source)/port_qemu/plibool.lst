  139  dcl   1 pli_ded_SDD         based,              /* Struct Descriptor*/
  140          5 SDD_id            char(1),            /* ID - '80'x       */
  141          5 SDD_flag          bit(8),             /* Flag bits   1.3,1*/
  142          /* 1... .... ('80'bx) - scalar reference to one array elem  */
  143          /* .1.. .... ('40'bx) - element of array of structures      */
  144          5 fil1              char(2),            /* (unused)    1.3.1*/
  145          5 SDD_pSED          ptr;                /* ->First SED      */
  146 
  147  /* Structure descriptors are placeholders for arrays of structures. */
  148  dcl   1 pli_ded_SD          based,              /* Struct Descriptor*/
  149          5 SD_id             char(1),            /* ID - '85'x       */
  150          5 fil1              char(3);            /* (unused)         */
  151 
  152  /* Structure element descriptors (SEDs) have an entry               */
  153  /* for each element and minor structure.                            */
  154  /* An entry following the last contains the offset of the byte      */
  155  /* following the structure (structure length)                       */
  156          /* SED format:                                              */
  157          /*    +0: Flag word                                         */
  158          /*    +4: Element offset in structure                       */
  159          /*    +8: Element Descriptor address                        */
  160  dcl   1 pli_ded_SED         based,              /* Struct Elem desc.*/
  161          5 fil1,                                 /* Flag byte        */
  162            10 SE_str         bit(1),             /*              00.0*/
