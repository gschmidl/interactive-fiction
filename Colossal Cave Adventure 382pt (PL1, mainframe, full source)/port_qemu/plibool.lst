1.4.1                                               Source Listing                                           Page 1     
    1  /* plibool.pli - patched copy of the Iron Spring PL/I runtime routine */
    2  /* _pli_Bool, taken verbatim from pli-1.4.1/lib/source/bool.pli (Iron */
    3  /* Spring PL/I Runtime Library, (c) Peter Flass, distributed under    */
    4  /* the GNU LGPL) with the four lines marked "PATCH" added below.      */
    5  /*                                                                    */
    6  /* Why this file exists:                                              */
    7  /*                                                                    */
    8  /*   plic calls _pli_Bool for AND/OR/NOT on bit strings longer than   */
    9  /*   32 bits.  For a unary NOT it passes the operand in the routine's */
   10  /*   "Y" argument slots and leaves the "X" slots - ptrarray(3) and    */
   11  /*   ptrarray(4) - uninitialised.  But _pli_Bool dereferences         */
   12  /*   ptrarray(4) before it ever looks at the function code, guarding  */
   13  /*   only against an exactly zero pointer:                            */
   14  /*                                                                    */
   15  /*       pDesc = ptrarray(4);                                         */
   16  /*       if pDesc =sysnull then do;                                   */
   17  /*         addr(descX)->ST_bo = pDesc->ST_bo;    <-- reads garbage    */
   18  /*                                                                    */
   19  /*   so every NOT of a bit string wider than 32 bits dereferences     */
   20  /*   whatever stack garbage happens to sit in that slot.  It is       */
   21  /*   usually a readable address, which is why the game mostly ran;    */
   22  /*   when it was not, the process took SIGSEGV and Adventure printed  */
   23  /*   "Fatal error # 99".                                              */
   24  /*                                                                    */
   25  /*   adventure.pli does exactly that in two places: it negates the    */
   26  /*   BIT(40) vocabulary overlay while loading the encoded database    */
   27  /*   ("ATABB(TABNDX) = ^ATABB(TABNDX);", 326 times at start-up) and   */
   28  /*   again on every word it looks up ("IDB = ^IDB;" in VOCAB, three   */
   29  /*   times per call).  The game was one unlucky stack layout away     */
   30  /*   from dying at any moment; it died reproducibly on entry to       */
   31  /*   wizard mode.                                                     */
   32  /*                                                                    */
   33  /*   The patch makes the routine ignore the operand its own function  */
   34  /*   code says is unused (10 is "NOT Y", 12 is "NOT X") and gives     */
   35  /*   lenX/lenY defined values when their setup block is skipped.      */
   36  /*   Nothing else changes.  Linked ahead of libprf.a so the archive   */
   37  /*   member is never pulled in; "diff -u <plidir>/lib/source/bool.pli */
   38  /*   plibool.pli" shows the whole change.                             */
   39 
   40  /* _pli_Bool                                                        */
   41  /********************************************************************/
   42  /*           Iron Spring PL/I Runtime Library Version 0.7           */
   43  /*              Distributed under the Gnu LGPL License              */
   44  /*                                                                  */
   45  /*      Module:        _pli_Bool (PL/I runtime)                     */
   46  /*      Version:       1.0                                          */
   47  /*      Date:          Jan, 2009                                    */
   48  /*      Author:        Peter Flass                                  */
   49  /*                                                                  */
   50  /*      Entry Points:  _pli_Bool Runtime BOOL builtin.              */
   51  /*                                                                  */
   52  /*      Function:      Perform one of 16 boolean functions          */
   53  /*                     on two bit strings.                          */
   54  /*                                                                  */
   55  /*                     Bool is called for the BOOL builtin, and     */
   56  /*                     from compiled code to perform AND, OR,       */
   57  /*                     and NOT operations on strings longer than    */
   58  /*                     32 bits or of indeterminate length.          */
Aug 31, 2026  16:34    /* plibool.pli - patched copy of the Iron Spring PL/I runtime routine */                         
1.4.1                                               Source Listing                                           Page 2     
   59  /*                                                                  */
   60  /*      Dependencices: PL/I Locator/Descriptor formats.             */
   61  /*                                                                  */
   62  /*      Calling sequence:                                           */
   63  /*                     DCL BOOL entry( ptr, ptr, ptr, ptr,          */
   64  /*                                     ptr, ptr, ptr, ptr )         */
   65  /*                                ext( '_pli_Bool' )                */
   66  /*                                options( LINKAGE(SYSTEM) );       */
   67  /*      Arguments:                                                  */
   68  /*        1. Address of function byte.  First 4 bits significant.   */
   69  /*        2. Address of function desc, VARYING or nonvarying bit.   */
   70  /*        3. Address of first source string value.                  */
   71  /*        4. Address of first source string descriptor.             */
   72  /*        5. Same for second source string.                         */
   73  /*        6.            "                                           */
   74  /*        7. Same for result string.  Result length is equal to     */
   75  /*        8.   the length of the longest source string.             */
   76  /*                                                                  */
   77  /*      The result string resides on the stack and is always        */
   78  /*      byte-aligned nonvarying.                                    */
   79  /*                                                                  */
   80  /*      To Do:                                                      */
   81  /*                                                                  */
   82  /*      Modifications:                                              */
   83  /*                                                                  */
   84  /********************************************************************/
   85 
   86  Bool: proc( args )
   87          options( LINKAGE(SYSTEM) )
   88          ext( '_pli_Bool' );
   89 
   90  /*-------------------------*/
   91  /* Parameters              */
   92  /*-------------------------*/
   93  dcl     args                ptr;
   94  dcl     pArgs               ptr;
   95  dcl     ptrarray         (8)ptr based(pArgs);          
   96 
   97  /*-------------------------*/
   98  /* Automatic Data          */
   99  /*-------------------------*/
  100  dcl     pData               ptr;
  101  dcl     pDesc               ptr;
  102  dcl    (srcX,srcY,srcTmp)   bit(32);
  103  dcl     resSize             fixed bin(31);
  104  dcl     j                   fixed bin(31);
  105  dcl     fun                 fixed bin(7);
  106          /* Common functions for BOOL:                               */
  107          /* 1:  AND                                                  */
  108          /* 6:  XOR                                                  */
  109          /* 7:  OR                                                   */
  110          /* See 
  111             <a href="http://members.dodo.com.au/robin51/pli-n11.htm" 
  112             PL/I Newsletter Issue 11</a> for complete list.
  113          /*                                                          */   
  114  dcl    (pX,pY,pRes)         ptr;
  115  dcl    (lenX,lenY,lenRes)   fixed bin(31);
  116  dcl   1 descriptors,
