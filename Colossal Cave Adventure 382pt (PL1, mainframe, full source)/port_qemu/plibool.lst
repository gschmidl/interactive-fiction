  131  /* Static Data             */
  132  /*-------------------------*/
  133 
  134  /*-------------------------*/
  135  /* External Declarations   */
  136  /*-------------------------*/
  137  dcl     MBS                 entry( ptr, ptr, ptr, ptr )
  138                              ext( '_pli_MBS' )
  139                              options( LINKAGE(SYSTEM) ); 
  140  dcl    (addr,length,max,min,null,plifill,plimove,stg,sysnull,substr)
  141                              builtin;
  142  %page;
  143  /*-----------------------------------*/
Aug 31, 2026  16:34    /* plibool.pli - patched copy of the Iron Spring PL/I runtime routine */                         
1.4.1                                               Source Listing                                           Page 8     
  144  /* Initialize Result                 */
  145  /*-----------------------------------*/
  146  pArgs = addr(args);                   /* Get argument list          */
  147  pRes  = ptrarray(7);                  /* ->Result string            */
  148  pDesc = ptrarray(8);                  /* ->Result descriptor        */
  149  lenRes = pDesc->ST_len;               /* Get result length          */
  150  resSize = (pDesc->ST_len+7)/8;        /* Result length in bytes     */
  151  call plifill(pRes,'00'x,resSize);     /* Initialize result string   */
  152 
  153  /*-----------------------------------*/
  154  /* Get function code                 */
  155  /*-----------------------------------*/
  156  srcX  = (4)'00'bx;                    /* Clear workarea             */
  157  pData = ptrarray(1);                  /* ->Function string          */
  158  pDesc = ptrarray(2);                  /* ->Function descriptor      */
  159  j     = pDesc->ST_len;                /* Get function [max] length  */
  160  if pDesc->ST_id = '21'x then do;      /* VARYING string?            */
  161    j     = length(pData->Varying_String);  /* Yes, get current length*/
  162    pData = pData+stg(null->Varying_String);/*      and ->Data        */
  163    end; /* varying */
  164  if j>=4                               /* Get function string        */
  165  then substr(srcX,29,4) = substr(pData->B8,1,4);
  166  else substr(srcX,32-j+1,j) = substr(pData->B8,1,j);
  167  fun = srcX;
  168 
  169  /*-----------------------------------*/
  170  /* Do some trivial operations        */
  171  /*-----------------------------------*/
  172  if fun=0  then return;                /* '0000'b = FALSE            */
  173  if fun=15 then do;                    /* '1111'b = TRUE             */
  174    call plifill(pRes,'FF'x,resSize);
  175    return;
  176    end;
  177  if fun=3 then do;                     /* '0011'b = X                */
  178    call MBS( ptrarray(3), ptrarray(4),
  179              ptrarray(7), ptrarray(8) );
  180    return;
  181    end;
  182  if fun=5 then do;                     /* '0101'b = Y                */
  183    call MBS( ptrarray(5), ptrarray(6),
  184              ptrarray(7), ptrarray(8) );
  185    return;
  186    end;
  187 
  188  /*-----------------------------------*/
  189  /* Set up Descriptors for data       */
  190  /*-----------------------------------*/
  191  call plifill( addr(descriptors), '00'x, stg(descriptors) );
  192  addr(descTmp)->ST_id  = '20'x;        /* Build descriptors          */
  193  addr(descTmp)->ST_len = 32;
  194  addr(descX)->ST_id    = '20'x;
  195  addr(descY)->ST_id    = '20'x;
  196  lenX,lenY = 0;                        /* PATCH: undefined if the  */
  197                                        /* operand block is skipped */
  198  pX = ptrarray(3);
  199  pDesc = ptrarray(4);                  /* Get X length               */
  200  if fun=10 then pDesc = sysnull;       /* PATCH: X unused for ªY   */
Aug 31, 2026  16:34    /* plibool.pli - patched copy of the Iron Spring PL/I runtime routine */                         
1.4.1                                               Source Listing                                           Page 9     
  201  if pDescª=sysnull then do;
  202    addr(descX)->ST_bo  = pDesc->ST_bo;
  203    lenX = pDesc->ST_len;
  204    if pDesc->ST_id = '21'x then do;
  205      lenX = length(pX->Varying_String);
  206      pX = pX + stg(null->Varying_String);
  207      end;
  208    addr(descX)->ST_len = lenX;
  209    end;
  210  pY = ptrarray(5);
  211  pDesc = ptrarray(6);                  /* Get Y length               */
  212  if fun=12 then pDesc = sysnull;       /* PATCH: Y unused for ªX   */
  213  if pDescª=sysnull then do;
  214    addr(descY)->ST_bo  = pDesc->ST_bo;
  215    lenY = pDesc->ST_len;
  216    if pDesc->ST_id = '21'x then do;
  217      lenY = length(pY->Varying_String);
  218      pY = pY + stg(null->Varying_String);
  219      end;
  220    addr(descY)->ST_len = lenY;
  221    end;
  222  if fun=10 then lenX=0;                /* ªY                         */
  223  if fun=12 then lenY=0;                /* ªX                         */
  224 
  225  /*-----------------------------------*/
  226  /* Loop to do everything else        */
  227  /*-----------------------------------*/
  228  do while( lenRes>0 );
  229    srcX,srcY = (4)'00'bx;
  230    if lenX>0 then do;                  /* Get 'X' source 32 bits     */
  231      call MBS( pX, addr(descX),
  232                addr(srcX), addr(descTmp) );
  233      lenX = lenX-32;
  234      pX   = pX+4;
  235      end;
  236    if lenY>0 then do;                  /* Get 'X' source 32 bits     */
  237      call MBS( pY, addr(descY),
  238                addr(srcY), addr(descTmp) );
  239      lenY = lenY-32;
  240      pY   = pY+4;
  241      end;
  242    select(fun);
  243      when( 1) do;                      /* X&Y                        */
  244        srcX = srcX & srcY;
  245        end; /*  1 */
  246      when( 2) do;                      /* X&ªY                       */
  247        srcY = ªsrcY;
  248        srcx = srcX & srcY;
  249        end; /*  2 */
  250      when( 4) do;                      /* ªX&Y                       */
  251        srcX = ªsrcX & srcY;
  252        end; /*  4 */
  253      when( 6) do;                      /* X <xor> Y                  */
  254        /* Some PL/Is use the symbol '^' to represent exclusive or    */
  255        /* X^Y = (ªX&Y) | (X&ªY)                                      */
  256        srcTmp = ªsrcX & srcY;
  257        srcX   = srcX & ªsrcY;
  258        srcX = srcX | srcTmp;
Aug 31, 2026  16:34    /* plibool.pli - patched copy of the Iron Spring PL/I runtime routine */                         
1.4.1                                               Source Listing                                           Page 10    
  259        end; /*  6 */
  260      when( 7) do;                      /* X|Y                        */
  261        srcX = srcX | srcY;
  262        end; /*  7 */
  263      when( 8) do;                      /* ª(X|Y)                     */
  264        srcx = ª( srcX | srcY );
  265        end; /*  8 */
  266      when( 9) do;                      /* (X&Y)|(ªX&ªY)              */
  267        srcTmp = ªsrcX & ªsrcY;
  268        srcx = (srcX & srcY) | srcTmp;
  269        end; /*  9 */
  270      when(10) do;                      /* ªY                         */
  271        srcX = ªsrcY;
  272        end; /* 10 */
  273      when(11) do;                      /* X|ªY                       */
  274        srcX = srcX | ªsrcY;
  275        end; /* 11 */
  276      when(12) do;                      /* ªX                         */
  277        srcX = ªsrcX;
  278        end; /* 12 */
  279      when(13) do;                      /* ªX|Y                       */
  280        srcX = ªsrcX | srcY;
  281        end; /* 13 */
  282      when(14) do;                      /* ª(X&Y)                     */
  283        srcX = ª( srcX & srcY );
  284        end; /* 14 */
  285      end; /* select */
  286    /* Since the output is always aligned, just move it.              */
  287    j = min( 4, (lenRes+7)/8 );
  288    call plimove( pRes, addr(srcX), j );
  289    lenRes = lenRes-32;
  290    pRes   = pRes+4;
  291    end; /* do while */   
  292 
  293  end Bool;
  294 

End of compilation. 
