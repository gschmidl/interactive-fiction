 00001                ASMB,R,L
 00002                      NAM LINK,7 Segment call and return  MCC 760101
 00003                      ENT LINK,RETRN
 00004                      EXT EXEC,.ENTR
 00005* 
 00006* CALLING SEQUENCE: 
 00007* 
 00008*     CALL LINK(ISEG) 
 00009* 
 00010*          WHERE ISEG IS THE ARRAY CONTAINING THE DESIRED SEGMENT 
 00011*                     NAME
 00012* 
 00013*    LINK SCHEDULES THE SEGMENT AND THE SEGMENT SHOULD THEN RETURN
 00014*       TO THE MAIN BY A
 00015* 
 00016*              CALL RETRN 
 00017* 
 00018*         WHERE RETRN IS AN ENTRY POINT IN LINK AND RETURNS CONTROL 
 00019*                     TO THE ORIGINAL CALLING POINT IN THE MAIN 
 00020* 
 00021  00000         NAMAD BSS 1 
 00022  00001 000000  LINK  NOP 
 00023  00002 014002X       JSB .ENTR    GET SEGMENT NAME 
 00024  00003 000000R       DEF NAMAD      ADDRESS
 00025  00004 060000R       LDA NAMAD 
 00026  00005 070011R       STA CALLP    STORE IN SEQUENCE BELOW
 00027  00006 014001X       JSB EXEC     PROGRAM SEGMENTLOADING 
 00028  00007 000012R       DEF *+3 
 00029  00010 000015R       DEF RCODE      SEQUENCE 
 00030  00011 000000  CALLP NOP 
 00031  00012 024012R       JMP * 
 00032* 
 00033  00013 000000  RETRN NOP 
 00034  00014 124001R       JMP LINK,I   RETURN TO MAIN PROGRAM 
 00035* 
