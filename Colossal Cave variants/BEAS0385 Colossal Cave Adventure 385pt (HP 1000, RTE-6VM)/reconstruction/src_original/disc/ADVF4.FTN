FTN5
C======================================================================C
C                                                                      C
C      AA       DDDDDDDDD     VV        VV    00000000          444    C
C     AAAA      DDDDDDDDDD    VV        VV   0000000000        4444    C
C    AA  AA     DD       DD   VV        VV  00        00      44 44    C
C   AA    AA    DD        DD  VV        VV  00        00     44  44    C
C  AA      AA   DD        DD  VV        VV  00        00    44   44    C
C AA        AA  DD        DD  VV        VV  00        00   44444444444 C
C AAAAAAAAAAAA  DD        DD   VV      VV   00        00  444444444444 C
C AAAAAAAAAAAA  DD        DD   VV      VV   00        00         44    C
C AA        AA  DD        DD     VV  VV     00        00         44    C
C AA        AA  DD       DD      VV  VV     00        00         44    C
C AA        AA  DDDDDDDDDD         VV        0000000000          44    C
C AA        AA  DDDDDDDDD          VV         00000000           44    C
C                                                                      C
C======================================================================C
C                                                                      C
C REVISION LIST:                                                       C
C                                                                      C
C --DATE-- --BY-- -- D E S C R I P T I O N --                          C
C                                                                      C
C  3/07/81 AW     -ORIGINAL VERSION-                                   C
C                                                                      C
C======================================================================C
C  I/O ROUTINES (SPEK, PSPEK, RSPEK, GETIN, YES, A5TO1)
C
C
      SUBROUTINE SPEK(N)
C
C  PRINT THE MESSAGE IN RECORD N OF THE RANDOM ACCESS MESSAGE FILE.
C  PRECEDE IT WITH A BLANK LINE UNLESS BLKLIN IS FALSE.
C
      IMPLICIT INTEGER (A-Z)
      LOGICAL BLKLIN,NOINPT
      COMMON /TXTCM/ RTEXT,LINES,ASCVAR,LU,ICNTRL
      COMMON /DCBCM/ IDCB2(144)
      COMMON /BLKCM/ BLKLIN,NOINPT
      COMMON /ALPHS/ BLANK,EOF
      DIMENSION RTEXT(215),LINES(40),IBUF(44)
C     FMPSETPOS NEEDS DOUBLE INT !-DWH
      INTEGER*4 POS
C
C     WRITE(LU,6900) N
C6900 FORMAT(" SUBROUTINE 'SPEK' ENTERED WITH N = ",I5)
      IF(N.EQ.0)RETURN
C     READ(2"N) LOC,LINES
      POS = N
      CALL FMPSETPOSITION(IDCB2,IERR,POS,-POS) !DWH-READF->SETPOS/FMPREAD
      LEN = FMPREAD(IDCB2,IERR,IBUF,44*2)
C     WRITE(LU,6906) IERR,LEN,(IBUF(LX),LX=1,10)
C6906 FORMAT(2I8,5X,10A2)
      CALL CODE
      READ(IBUF,1000) LOC,LINES
1000  FORMAT(I5,1X,40A2)
      IF(LEN.LT.0 .OR. IERR.LT.0)RETURN
      IF(BLKLIN.AND.NOINPT) WRITE(LU,2)
      NOINPT=.TRUE.
1     OLDLOC = LOC
      DO 3 I=40,1,-1
      L = I
      IF(LINES(I) .NE. BLANK) GO TO 5
3     CONTINUE
5     IF(LINES(1).NE.2H>$) WRITE(LU,2) (LINES(I),I=1,L)
2     FORMAT(" ",40A2)
C     READ(2"ASCVAR) LOC,LINES
      LEN=FMPREAD(IDCB2,IERR,IBUF,44*2,LEN)
      LEN=LEN/2
      IF(LEN.LT.0 .OR. IERR.LT.0) RETURN
      CALL CODE
      READ(IBUF,1000) LOC,LINES
      IF(LOC .EQ. OLDLOC) GO TO 1
      RETURN
      END
C
C
C
      SUBROUTINE PSPEK(MSG,SKIP)
C
C  FIND THE SKIP+1ST MESSAGE FOR OBJECT MSG AND PRINT IT.
C  MSG SHOULD BE THE INDEX OF
C  THE OBJECT.  (INVEN+N+1 MESSAGE IS PROP=N MESSAGE).
C
      IMPLICIT INTEGER (A-Z)
      COMMON /TXTCM/ RTEXT,LINES,ASCVAR,LU,ICNTRL
      COMMON /DCBCM/ IDCB2(144)
      COMMON /PTXCM/ PTEXT
      DIMENSION RTEXT(215),LINES(40),PTEXT(100),IBUF(44)
      INTEGER*4 POS
C
C     WRITE(LU,6900) MSG,SKIP
C6900 FORMAT(" SUBROUTINE 'PSPEK' ENTERED WITH MSG = ",I5,
C    A  "    SKIP = ",I5)
      M=PTEXT(MSG)
      IF(SKIP.LT.0)GOTO 9
      OLDLOC=MSG
      DO 3 I=1,SKIP+1
C1    READ(2"M)LOC,LINES
1     CONTINUE
      POS = M
      CALL FMPSETPOSITION(IDCB2,IERR,POS,-POS) !DWH-READF->SETPOS/FMPREAD
      LEN = FMPREAD(IDCB2,IERR,IBUF,44*2)
      CALL CODE
      READ(IBUF,1000) LOC,LINES
1000  FORMAT(I5,1X,40A2)
      ASCVAR=M+1
      M = ASCVAR
C     WRITE(LU,6901) PTEXT(MSG),M,LOC,OLDLOC,(LINES(KQ),KQ=1,10),ASCVAR
C6901 FORMAT(4I5,1X,10A2,I8)
      IF(LOC.EQ.OLDLOC) GO TO 1
      OLDLOC=LOC
3     CONTINUE
      M=M-1
9     CALL SPEK(M)
      RETURN
      END
C
C
C
      SUBROUTINE RSPEK(I)
C
C  PRINT THE I-TH "RANDOM" MESSAGE (SECTION 6 OF DATABASE).
C
      IMPLICIT INTEGER (A-Z)
      COMMON /TXTCM/ RTEXT,LINES(40),ASCVAR,LU,ICNTRL
      COMMON /DCBCM/ IDCB2(144)
      DIMENSION RTEXT(215)
C
C     WRITE(LU,6900) I
C6900 FORMAT(" SUBROUTINE 'RSPEK' ENTERED WITH I = ",I5)
      IF(I.NE.0)CALL SPEK(RTEXT(I))
      RETURN
      END
C
C
C
C
C     SUBROUTINE MSPEK(I)
C
C  PRINT THE I-TH "MAGIC" MESSAGE FROM SECTION 12 OF DATABASE
C
C     IMPLICIT INTEGER (A-Z)
C     COMMON /MTXCM/ MTEXT
C     DIMENSION MTEXT (35)
C
C     IF(I.NE.0) CALL SPEK(MTEXT(I))
C     RETURN
C     END
C
C
      SUBROUTINE GETIN(LU,WORD1,WORD1A,WORD1X,WORD2,WORD2A,WORD2X)
C
C  GET A COMMAND FROM THE ADVENTURER.  SNARF OUT THE FIRST WORD, PAD IT WITH
C  BLANKS, AND RETURN IT IN WORD1 AND WORD1A.
C  CHARS 5  AND 6 ARE RETURNED IN WORD1X, IN
C  CASE WE NEED TO PRINT OUT THE WHOLE WORD IN AN ERROR MESSAGE.  ANY NUMBER OF
C  BLANKS MAY FOLLOW THE WORD.  IF A SECOND WORD APPEARS, IT IS RETURNED IN
C  WORD2 AND WORD2A (CHARS 5 AND 68 IN WORD2X), ELSE WORD2 IS SET TO ZERO.
C
C     THIS ROUTINE IS ALMOST COMPLETELY DIFFERENT FROM THE PDP-11 VERSION.
C
      IMPLICIT INTEGER (A-Z)
      LOGICAL BLKLIN,NOINPT
      INTEGER  FRST(20),BLANK,BLANK1,QFRST(30),QBLANK(2),QB6(4)
      EQUIVALENCE (FRST,QFRST(2))
      COMMON /BLKCM/ BLKLIN,NOINPT
      DATA QBLANK/1,2H  /,QB6/6,2H  ,2H  ,2H  /
C
      NOINPT=.FALSE.
      IF(BLKLIN) WRITE(LU,1)
1     FORMAT(1X)
2     CALL CLRQ(QFRST,1,58)
      WRITE(LU,10)
10    FORMAT(">_")
      READ(LU,3) FRST
3     FORMAT(20A2)
      QFRST(1)=40
      J=0
      CALL NSRTQ(QFRST,J,QB6)
4     IF(IPOSQ(QFRST,QBLANK,1).NE.1 .OR. J.GE.10) GO TO 5
      CALL DLETQ(QFRST,1,1)
      J=J+1
      GO TO 4
5     CALL CODE
      READ(FRST,99) WORD1,WORD1A,WORD1X
99    FORMAT(3A2)
      WORD2 = 0
      WORD2A=0
      WORD2X=0
6     IF(IPOSQ(QFRST,QBLANK,1).EQ.1) GO TO 7
      CALL DLETQ(QFRST,1,1)
      GO TO 6
7     IF(IPOSQ(QFRST,QBLANK,1).NE.1) GO TO 8
      IF(QFRST(1).EQ.10) GO TO 100
      CALL DLETQ(QFRST,1,1)
      GO TO 7
8     CALL CODE
      READ(FRST,99) WORD2,WORD2A,WORD2X
C100  WRITE(LU,6902) WORD1,WORD1A,WORD1X,WORD2,WORD2A,WORD2X
C6902 FORMAT(" GETIN RETURNS: ",3A2,1X,3A2)
100   RETURN
C
      END
C
C
C
      LOGICAL FUNCTION YES(X,Y,Z)
C
C  CALL YESX (BELOW) WITH MESSAGES FROM SECTION 6.
C
      IMPLICIT INTEGER (A-Z)
      EXTERNAL RSPEK
      LOGICAL YESX
C
      YES=YESX(X,Y,Z,RSPEK)
      RETURN
      END
C
C
C
C     LOGICAL FUNCTION YESM(X,Y,Z)
C
C  CALL YESX (BELOW) WITH MESSAGES FROM SECTION 12.
C
C     IMPLICIT INTEGER (A-Z)
C     EXTERNAL MSPEK
C     LOGICAL YESX
C
C     YESM=YESX(X,Y,Z,MSPEK)
C     RETURN
C     END
C
C
C
      LOGICAL FUNCTION YESX(X,Y,Z,SPK)
C
C  PRINT MESSAGE X, WAIT FOR YES/NO ANSWER.  IF YES, PRINT Y AND LEAVE YEA
C  TRUE; IF NO, PRINT Z AND LEAVE YEA FALSE.  SPK IS EITHER RSPEK OR MSPEK.
C
      IMPLICIT INTEGER (A-Z)
      COMMON /TXTCM/ RTEXT(215),LINES(40),ASCVAR,LU,ICNTRL
      COMMON /ALPHS/ BLANK,EOF,CYE,CY,CNO,CN
C
1     CONTINUE
C     WRITE(LU,6900) X,Y,Z
C6900 FORMAT("YESX:",3I8)
      IF(X.NE.0)CALL SPK(X)
      CALL GETIN(LU,REPLY,JUNK1,JUNK2,JUNK3,JUNK4,JUNK5)
      IF(REPLY.EQ.CYE .OR. REPLY.EQ.CY)GOTO 10
      IF(REPLY.EQ.CNO .OR. REPLY.EQ.CN)GOTO 20
      WRITE(LU,9)
9     FORMAT(/" PLEASE ANSWER THE QUESTION.")
      GOTO 1
10    YESX=.TRUE.
      IF(Y.NE.0)CALL SPK(Y)
      RETURN
20    YESX=.FALSE.
      IF(Z.NE.0)CALL SPK(Z)
      RETURN
      END
      END$
