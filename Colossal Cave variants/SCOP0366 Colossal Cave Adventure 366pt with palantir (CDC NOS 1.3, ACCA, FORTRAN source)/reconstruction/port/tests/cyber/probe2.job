PROBE2.
$USER,INSTALL,INSTALL.
$NORERUN.
$SETTL,7777.
$SETJSL,7777.
$SETASL,7777.
$RFL,140000.
$FTN(I=INPUT,L=0)
LGO.
***
*** PROBE2 COMPLETE
***
EXIT.
***
*** PROBE2 FAILED
***
~eor
      PROGRAM PROBE2(OUTPUT)
      IMPLICIT INTEGER (A-Z)
      REAL X, S, A, RANF, SECOND
      DIMENSION A(12)
      DATA A/1.,2.,4.,1.5,0.25,0.6,0.075,100.,0.,0.5,3.,-1./
      CALL RANGET(S)
      PRINT 1, S
1     FORMAT(" START SEED ",O20)
      X = RANF(3.1415)
      PRINT 2, X
2     FORMAT(" FIRST RANF ",O20)
      DO 20 N=1,12
      CALL RANSET(A(N))
      CALL RANGET(S)
      X = RANF(3.1415)
      PRINT 10, N, A(N), S, X
10    FORMAT(" SET ",I3," X=",E15.7," SEED ",O20," RANF ",O20)
20    CONTINUE
      CALL RANSET(0.075)
      CALL RANGET(S)
      PRINT 11, S
11    FORMAT(" AGAIN 0.075 SEED ",O20)
      Y = SECOND(1.)
      PRINT 12, Y
12    FORMAT(" SECOND ",E20.10)
      CALL RANSET(Y)
      CALL RANGET(S)
      PRINT 13, S
13    FORMAT(" FROM SECOND SEED ",O20)
      END
