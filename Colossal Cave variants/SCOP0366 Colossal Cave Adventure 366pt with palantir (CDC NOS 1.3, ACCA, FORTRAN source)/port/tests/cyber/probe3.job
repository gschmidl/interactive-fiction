PROBE3.
$USER,INSTALL,INSTALL.
$NORERUN.
$SETTL,7777.
$SETJSL,7777.
$SETASL,7777.
$RFL,140000.
$FTN(I=INPUT,L=0)
LGO.
***
*** PROBE3 COMPLETE
***
EXIT.
***
*** PROBE3 FAILED
***
~eor
      PROGRAM PROBE3(OUTPUT)
      IMPLICIT INTEGER (A-Z)
      LOGICAL PCT, CLOSNG, WZDARK
      COMMON /CNT/ NC
      PCT(N)=RND(100).LT.N
      NC=0
      CLOSNG=.FALSE.
      WZDARK=.FALSE.
      K=0
      IF(K.EQ.1.AND.PCT(10))K=9
      PRINT 1,NC
1     FORMAT(" AND FALSE FIRST, RND CALLS ",I3)
      NC=0
      K=1
      IF(K.EQ.1.OR.PCT(10))K=9
      PRINT 2,NC
2     FORMAT(" OR TRUE FIRST, RND CALLS ",I3)
      NC=0
      LOC=1
      IF(LOC.LT.15.OR.PCT(80))K=9
      PRINT 3,NC
3     FORMAT(" LOC.LT.15.OR.PCT(80), RND CALLS ",I3)
      NC=0
      LOC=33
      IF(LOC.EQ.34.AND.PCT(25).AND..NOT.CLOSNG)K=9
      PRINT 4,NC
4     FORMAT(" THREE TERM, FIRST FALSE, RND CALLS ",I3)
      NC=0
      IF(WZDARK.AND.PCT(35))K=9
      PRINT 5,NC
5     FORMAT(" LOGICAL FALSE .AND. PCT, RND CALLS ",I3)
      NC=0
      NEWLOC=0
      IF(NEWLOC.NE.0.AND..NOT.PCT(NEWLOC))K=9
      PRINT 6,NC
6     FORMAT(" .AND..NOT.PCT, FIRST FALSE, RND CALLS ",I3)
      NC=0
      WD1=4RWEST
      IF(WD1.NE.4RWEST.AND.PCT(10))K=9
      PRINT 7,NC
7     FORMAT(" WD1.NE.WEST (FALSE) .AND.PCT(10), RND CALLS ",I3)
      NC=0
      IF(WD1.EQ.4RWEST.AND.PCT(10))K=9
      PRINT 8,NC
8     FORMAT(" WD1.EQ.WEST (TRUE) .AND.PCT(10), RND CALLS ",I3)
      END
      INTEGER FUNCTION RND(RANGE)
      IMPLICIT INTEGER (A-Z)
      REAL RAN, RANF
      COMMON /CNT/ NC
      NC=NC+1
      RAN=RANF(3.1415)*RANGE
      RND=RAN
      RETURN
      END
