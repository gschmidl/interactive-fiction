# ======================================================================
#  IFBackup — allowlist .gitignore
#
#  The working tree is ~12 GB, almost all of it emulator disk packs and
#  scratch working directories.  GitHub asks for repositories under 1 GB.
#  So this file ignores EVERYTHING by default and then re-admits only
#  what is worth publishing:
#
#      the ports, the documentation, the playable deliverables,
#      the original sources, and the scans they were recovered from.
#
#  Deliberately excluded: every emulator disk image, every work/ dir,
#  and the shared _HP3000_work / _VAX_VMS_work trees.  Those stay on
#  disk; they are simply not published.
#
#  Rule order matters — the LAST matching pattern wins.  Keep the four
#  sections in the order they appear.
# ======================================================================

# ---- 1. ignore everything -------------------------------------------
*

# ...but always descend into directories, or none of the rules below
# would ever get a chance to match.
!*/


# ---- 2. re-admit what we publish ------------------------------------

# repo metadata
!/.gitignore
!/.gitattributes

# documentation, wherever it lives
!**/*.md

# the ports themselves (port/, port_qemu/, port-fixed/, ...)
!**/port/**
!**/port_*/**
!**/port-*/**

# the original sources and the recovered/extracted material.  Small,
# irreplaceable, and what any future change has to be checked against.
# (Disk images inside these are re-excluded in section 3.)
!**/src_original/**
!**/src_its/**
!**/dump_original/**
!**/dump_1987/**
!**/archive_original/**
!**/recovered/**
!**/reference/**
!**/transcription/**
!**/doc/**
!**/docs/**
!**/notes/**

# how a scanned type-in was checked against the machine it was written for:
# the session drivers and the transcripts they recorded (the logs they wrote
# are not published)
!**/hp3000/*.py
!**/hp3000/moves_*.txt
!**/hp3000/reference_*.txt
# the script that fetches the page scans back from archive.org
!**/scans/fetch.sh

# games whose deliverable does not live in a port/ dir
!/ASCII-Ladden (C64)/**
!/Google Adventure (Browser)/**
!/Iroha Uta no Nazo (MZ-80B)/**
!/Kjempens Skatt (ZX Spectrum)/**
!/*Sescuballi*/**
!/Sacrifice to the Spider Queen (Coleco Adam)/**
!/Weird Wood 2 (C64)/**
!/Underground (Scans)/**
!/Mystery House T.S2 (Sharp MZ-80K, type-in)/**
!/The Sppy (NEC PC-6001, type-in)/**
!/House Adventure (Fujitsu FM-7, type-in)/**
!/M no Higeki (Sharp MZ-2200, type-in)/**
!/Burglar House (NEC PC-8001, type-in)/**
!/Memo Satsujin (Sharp MZ-80K, type-in)/**
!/Six and Fant/**

# ---- 3. ...except these, which are too big or purely derived --------

# Bulk working trees: scratch emulator runs, dirty packs, analysis dumps.
# The /_*_work/ form is deliberate — it covers _HP3000_work, _VAX_VMS_work,
# _HP1000_work and any future one without needing an edit.  Each port keeps
# its own tests/ and tools/, so nothing here is needed to build or verify.
/_*_work/
**/work/
# the OCR pipeline's intermediates: ink maps, cut glyph cells, proof sheets.
# 2.9 GB for the Adventure 3000 transcription alone, all of it regenerable
# from the scans by the tools in transcription/tools/.
**/work_*/
# the same folders under the dot names they carry since 2026-09-19 (the Synology
# Drive client skips dot-folders, so regenerable bulk is kept in them): the
# Adventure 3000 OCR intermediates are now transcription/.work, .work_data and
# .work_moving, which the !**/transcription/** rule above would otherwise admit.
**/.work/
**/.work_*/
**/.tmp/
**/.logs/
**/.build/

# Staged (not yet ported) projects: whole-system or whole-site media that hold
# far more than the game - an operating system kit, a site's disc save, a
# licensed source tape.  They stay on disk; the game files cut out of them and
# the READMEs are published.  All of them came from bitsavers.org/bits.
/(ANON0350) Abenteuer (Harris VULCAN, German Colossal Cave, full source)/archive_original/fast.tap
/(ANON0550) Colossal Cave Adventure 550pt (VAX VMS 1.5, 1979, exe only)/archive_original/
/(ANON0350) Colossal Cave Adventure 350pt (TI 990, DX10, binary)/archive_original/DX10_system_tapes/
/Dave's Dungeon - DAVESCAVE (PDP-11 TRAX, MITRE, FORTRAN source)/archive_original/
/Wander worlds + Dune + Beasts (Peter Langston, Usenix 80.1 and 85.1 tapes)/archive_original/
/ARNA0660 Colossal Cave Adventure 660pt Glaxo 4.3 (Prime 50-Series, A-code, 1984)/archive_original/
/Mystery Mansion (HP 1000, RTE, FORTRAN source)/archive_original/f1_dskup_f2_rte2250sys.tap.gz

# Fisk is not published: it was removed from the repository and its
# history.  The folder stays on disk.
/Fisk */

# Emulator disk images and save states (hundreds of MB each).  This list is
# by EXTENSION, so a new project using a format not named here would be
# published by accident — check `git status` before committing a new port.
# Note .img is intentionally absent: the only one is Misty Marsh's 308 KB
# original Wang disk, which we do want.
*.dsk
*.disc
*.rp06
*.sta
*.dmp
*.ext2
*.core

# ...but the Coleco Adam game IS a pair of 164 KB .dsk files
!/Sacrifice to the Spider Queen (Coleco Adam)/*.dsk

# the PL/I port's QEMU bundle: 167 MB of redistributed QEMU plus a
# 60 MB rootfs.  build/README.md documents the Buildroot rebuild, and
# the image belongs on a GitHub Release rather than in git.
**/port_qemu/build/qemu/
**/port_qemu/build/rootfs.ext2
**/port_qemu/build/bzImage


# Adventure 3000: the BASIC data files are built from the text records beside
# them the first time the game runs, and the test script writes its own copies
# and transcripts while replaying the recorded walkthroughs.
/MOSE0350 Adventure 3000 (HP 3000 BASIC, Creative Computing type-in)/port/data/*/*.dat
/MOSE0350 Adventure 3000 (HP 3000 BASIC, Creative Computing type-in)/port/tests/data/*.dat
/MOSE0350 Adventure 3000 (HP 3000 BASIC, Creative Computing type-in)/port/tests/out_*.txt
/MOSE0350 Adventure 3000 (HP 3000 BASIC, Creative Computing type-in)/port/tests/diff_*.txt
/MOSE0350 Adventure 3000 (HP 3000 BASIC, Creative Computing type-in)/transcription/tools/draft_data.txt


# ---- 4. ordinary build and editor litter ----------------------------
__pycache__/
*.py[cod]
.pytest_cache/
*.o
*.obj
# ...except Peter Langston's 1980/1985 objects: Wander's interpreter core, Dune and
# Beasts were only ever distributed as PDP-11, VAX and Sun .o files, so here the
# object IS the original.
!/Wander worlds + Dune + Beasts (Peter Langston, Usenix 80.1 and 85.1 tapes)/src_original/**/*.o
fisk.log
zeno.log
**/saves/
**/save/
# world files the Data General Quest emulator writes into the folder it was
# started from when it is not given a save folder with -s, and the folder an
# old played world was kept in
/Quest*(Data General MV, AOS-VS)/port/*_DATA_FILE
/Quest*(Data General MV, AOS-VS)/port/QUEST
/Quest*(Data General MV, AOS-VS)/port/run/
# the P7000 ADVENT's working pack (with a suspended game in it) when advent.exe
# is run in its own folder without play.bat's --pack=saves\advent.pack
/(ANON0350) Colossal Cave Adventure 350pt (Philips P7000, Four-Phase IDOS)/port/advent.pack
# games saved in Cave Fun (SAVE writes NAME.SYMB beside the game file); the
# game, the programs and the editor's adventures are .ADV and .PROG
/Cave Fun (ND-100, SINTRAN III)/port/data/*.SYMB
Thumbs.db
desktop.ini
.DS_Store
._*
*.swp
*~
.vscode/
.idea/
/BREE0350 Adventures in Pascal (PDP-11, RSX-11M, OMSI Pascal, full source)/port/build/*
