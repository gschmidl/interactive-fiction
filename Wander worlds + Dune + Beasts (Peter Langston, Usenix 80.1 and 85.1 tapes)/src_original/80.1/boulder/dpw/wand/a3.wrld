     buy\ tokens  m="Buy how many PLEASE! buy one? buy two? buy five?"
     how\ much|price  m="Tokens cost a credit each"
     buy  t~card  m="You can't buy anything without your credit card!"
     buy\ one  v>6.0  v-6.1  v+2.1  t+tokens  m="Okay"
     buy\ two  v>6.1  v-6.2  v+2.2  ,,,
     buy\ three  v>6.2  v-6.3  v+2.3  ,,,
